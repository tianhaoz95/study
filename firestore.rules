rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check if the authenticated user is an admin
    function isAdmin() {
      return request.auth != null 
        && request.auth.token.email != null 
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // Subscriptions: anyone can create their own doc; only owner can read/update
    match /subscriptions/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && request.auth.uid == id;
    }

    // Topic suggestions: anyone can submit; only admins can read
    match /topic-suggestions/{id} {
      allow create: if request.resource.data.keys().hasAll(['topic', 'createdAt'])
        && request.resource.data.topic is string
        && request.resource.data.topic.size() > 0
        && request.resource.data.topic.size() <= 500;
      allow read: if isAdmin();
    }

    // Bookmarks: each user owns their own subcollection
    match /users/{uid}/bookmarks/{slug} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Reading List: each user owns their own subcollection
    match /users/{uid}/readingList/{slug} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Contact messages: public write-only, validated inputs, only admins can read
    match /contact_messages/{id} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'message', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 254
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin();
    }

    // Feedback messages: public write-only, validated inputs, only admins can read
    match /feedback/{id} {
      allow create: if request.resource.data.keys().hasAll(['message', 'createdAt'])
        && request.resource.data.keys().hasOnly(['message', 'createdAt', 'email', 'rating', 'path'])
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 254))
        && (!('rating' in request.resource.data) || (request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5))
        && (!('path' in request.resource.data) || (request.resource.data.path is string && request.resource.data.path.size() <= 1000))
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin();
    }

    // Admin access control: users can read their own status; write-only via Admin SDK
    match /admins/{email} {
      allow read: if request.auth != null && (request.auth.token.email == email || isAdmin());
      allow write: if false;
    }

    // Upvotes: anyone can read; anyone can create (count > 0) or update (count > resource.data.count)
    match /upvotes/{slug} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count is int
        && request.resource.data.count > 0;
      allow update: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count is int
        && request.resource.data.count > resource.data.count;
    }
  }
}


rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Subscriptions: anyone can create their own doc; only owner can read/update
    match /subscriptions/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && request.auth.uid == id;
    }

    // Topic suggestions: anyone can submit; anyone can read (admin site is public)
    match /topic-suggestions/{id} {
      allow create: if request.resource.data.keys().hasAll(['topic', 'createdAt'])
        && request.resource.data.topic is string
        && request.resource.data.topic.size() > 0
        && request.resource.data.topic.size() <= 500;
      allow read: if true;
    }

    // Contact messages: public write-only, validated inputs, no public reads
    match /contact_messages/{id} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'message', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 254
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && request.resource.data.createdAt == request.time;
    }
  }
}

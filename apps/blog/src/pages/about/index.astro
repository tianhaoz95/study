---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="About — AI/ML Deep Dives" description="About AI/ML Deep Dives — a personal blog exploring frontier research in machine learning.">
<style is:global>
  .about-wrap {
    max-width: 720px;
    margin: 0 auto;
    padding: 7rem 2rem 6rem;
  }
  .about-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: .625rem;
    font-size: .72rem;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--purple-l);
    margin-bottom: 1.5rem;
    font-family: var(--ff-mono);
  }
  .about-eyebrow::before {
    content: '';
    width: 18px;
    height: 1px;
    background: var(--purple);
  }
  .about-wrap h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    letter-spacing: -.03em;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    background: linear-gradient(160deg, var(--text) 40%, var(--muted2));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .about-lead {
    font-size: 1.075rem;
    color: var(--muted2);
    line-height: 1.8;
    margin-bottom: 3rem;
    max-width: 620px;
  }
  .about-divider {
    display: flex;
    align-items: center;
    gap: .875rem;
    margin: 2.5rem 0 1.75rem;
  }
  .about-divider span {
    font-size: .72rem;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
    font-family: var(--ff-mono);
  }
  .about-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
  }
  .about-body {
    font-size: .95rem;
    color: var(--muted2);
    line-height: 1.8;
  }
  .about-body p { margin-bottom: 1.25rem; }
  .about-body strong { color: var(--text); font-weight: 600; }
  .about-body a { color: var(--purple-l); text-decoration: none; }
  .about-body a:hover { text-decoration: underline; }
  .topic-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: .75rem;
    margin: 1.5rem 0 2rem;
  }
  .topic-chip {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: .7rem 1rem;
    font-size: .82rem;
    color: var(--muted2);
    display: flex;
    align-items: flex-start;
    gap: .6rem;
  }
  .topic-chip .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    margin-top: .35em;
    flex-shrink: 0;
  }
  .dot-purple { background: var(--purple); }
  .dot-cyan   { background: var(--cyan); }
  .dot-green  { background: var(--green); }
  .dot-amber  { background: var(--amber); }
  .about-links {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem;
    margin-top: 2.5rem;
  }
  .about-link-btn {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    font-size: .83rem;
    font-weight: 500;
    color: var(--muted2);
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: .55rem 1rem;
    text-decoration: none;
    transition: border-color .15s, color .15s;
  }
  .about-link-btn:hover {
    border-color: var(--purple);
    color: var(--purple-l);
    text-decoration: none;
  }
  footer.about-footer {
    border-top: 1px solid var(--border);
    padding: 1.75rem 2rem;
    text-align: center;
    font-size: .775rem;
    color: var(--muted);
  }
  .about-link-btn {
    cursor: pointer;
  }
  
  /* ── Contact Modal Polished Styling ── */
  #contact-modal {
    background: rgba(9, 9, 15, 0.75);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition: opacity .25s cubic-bezier(0.4, 0, 0.2, 1);
  }
  #contact-modal .modal-box {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border-hi);
    border-radius: 16px;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.4), 0 0 40px rgba(139, 92, 246, 0.08);
    transform: scale(0.96) translateY(12px);
    transition: transform .3s cubic-bezier(0.34, 1.56, 0.64, 1), opacity .25s ease;
    opacity: 0;
    padding: 1.75rem;
    gap: 1.25rem;
  }
  #contact-modal.is-open .modal-box {
    transform: scale(1) translateY(0);
    opacity: 1;
  }
  #contact-modal .modal-box::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--purple), var(--cyan));
  }
  #contact-modal .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  #contact-modal .modal-title-wrap {
    display: flex;
    align-items: center;
    gap: .65rem;
  }
  #contact-modal .modal-title-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: var(--purple-dim);
    border: 1px solid rgba(139, 92, 246, 0.2);
    color: var(--purple-l);
    border-radius: 8px;
  }
  #contact-modal .modal-header h2 {
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -.02em;
    color: var(--text);
  }
  #contact-modal .modal-desc {
    font-size: .85rem;
    color: var(--muted2);
    line-height: 1.6;
    margin: -.25rem 0 0;
  }
  #contact-modal .form-group {
    display: flex;
    flex-direction: column;
    gap: .4rem;
  }
  #contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  #contact-modal .form-group label {
    font-size: .78rem;
    font-weight: 600;
    color: var(--text2);
    letter-spacing: .02em;
  }
  #contact-modal .form-group input,
  #contact-modal .form-textarea {
    background: var(--card);
    border: 1px solid var(--border-hi);
    border-radius: 10px;
    padding: .75rem 1rem;
    font-size: .9rem;
    color: var(--text);
    font-family: var(--ff-sans);
    outline: none;
    transition: all .2s cubic-bezier(0.4, 0, 0.2, 1);
    width: 100%;
  }
  #contact-modal .form-group input:hover,
  #contact-modal .form-textarea:hover {
    border-color: var(--purple-l);
  }
  #contact-modal .form-group input:focus,
  #contact-modal .form-textarea:focus {
    border-color: var(--purple);
    background: var(--card2);
    box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.15);
  }
  #contact-modal .form-textarea {
    resize: vertical;
    min-height: 120px;
    line-height: 1.5;
  }
  #contact-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .5rem;
    font-weight: 600;
    font-size: .9rem;
    padding: .8rem 1.5rem;
    border-radius: 10px;
    background: linear-gradient(135deg, var(--purple), #7c3aed);
    color: #fff;
    border: none;
    cursor: pointer;
    transition: all .25s ease;
    box-shadow: 0 4px 12px rgba(124, 58, 237, 0.25);
  }
  #contact-submit:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(124, 58, 237, 0.35);
    opacity: 0.95;
  }
  #contact-submit:active {
    transform: translateY(1px);
  }
  #contact-submit .btn-arrow {
    transition: transform .2s ease;
  }
  #contact-submit:hover .btn-arrow {
    transform: translateX(3px);
  }
  #contact-modal .suggest-feedback {
    font-size: .85rem;
    padding: .75rem 1rem;
    border-radius: 8px;
    margin-top: .5rem;
    line-height: 1.5;
  }
  #contact-modal .suggest-success {
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.2);
    color: var(--green);
    display: flex;
    align-items: center;
    gap: .5rem;
  }
  #contact-modal .suggest-error {
    background: rgba(239, 68, 68, 0.08);
    border: 1px solid rgba(239, 68, 68, 0.2);
    color: var(--red);
  }
</style>

<div class="about-wrap">
  <div class="about-eyebrow">About</div>
  <h1>AI/ML Deep Dives</h1>
  <p class="about-lead">
    A personal research blog dedicated to making frontier AI&nbsp;&amp;&nbsp;ML papers approachable —
    with interactive visualizations, annotated source code, and the kind of depth that connects
    the math to the implementation.
  </p>

  <div class="about-divider"><span>What this blog is</span></div>
  <div class="about-body">
    <p>
      Most research papers reward careful reading but punish first-time readers with unexplained
      notation and buried intuitions. This blog exists to close that gap. Each post picks a
      single paper or tightly related cluster of ideas, digs into the mechanism at the level of
      code and equations, and pairs the explanation with live, in-browser visualizations so you
      can build the right mental model rather than just follow the prose.
    </p>
    <p>
      Posts are written to be <strong>standalone and deep</strong> — not newsletter summaries.
      The goal is that after reading, you could reimplement the core idea from scratch.
    </p>
  </div>

  <div class="about-divider"><span>Topics covered</span></div>
  <div class="topic-grid">
    <div class="topic-chip"><span class="dot dot-purple"></span>Diffusion Language Models</div>
    <div class="topic-chip"><span class="dot dot-purple"></span>Speculative Decoding</div>
    <div class="topic-chip"><span class="dot dot-cyan"></span>Knowledge Distillation</div>
    <div class="topic-chip"><span class="dot dot-cyan"></span>LLM Post-Training &amp; RLVR</div>
    <div class="topic-chip"><span class="dot dot-green"></span>Inference Efficiency</div>
    <div class="topic-chip"><span class="dot dot-green"></span>KV-Cache &amp; Quantization</div>
    <div class="topic-chip"><span class="dot dot-amber"></span>Linear &amp; Recurrent Attention</div>
    <div class="topic-chip"><span class="dot dot-amber"></span>Pretraining &amp; Scaling Laws</div>
    <div class="topic-chip"><span class="dot dot-purple"></span>Multi-Token Prediction</div>
    <div class="topic-chip"><span class="dot dot-cyan"></span>LLM Serving &amp; Systems</div>
  </div>

  <div class="about-divider"><span>Who writes it</span></div>
  <div class="about-body">
    <p>
      I'm <a href="https://medium.com/@tianhaozhou" target="_blank" rel="noopener noreferrer"><strong>Jackson MZ</strong></a>. I read a lot of ML papers and write up the ones I find
      genuinely interesting or underexplained. My focus is on the intersection of model
      architecture, training efficiency, and inference speed — the things that determine what
      actually ships in production.
    </p>
    <p>
      If a post has an interactive component, it was written from scratch — no chart libraries,
      just SVG and a little JavaScript — so the visualization is exactly as precise as the
      explanation requires.
    </p>
  </div>

  <div class="about-links">
    <a class="about-link-btn" href="/" >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      All Posts
    </a>
    <a class="about-link-btn" href="https://heji-study-subscribe.web.app/" target="_blank" rel="noopener noreferrer">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
      Subscribe
    </a>
    <button class="about-link-btn" id="contact-btn">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      Get in touch
    </button>
  </div>
</div>

<div id="contact-modal" class="modal-backdrop" aria-hidden="true" role="presentation">
  <div class="modal-box" role="dialog" aria-modal="true" aria-labelledby="contact-modal-title">
    <div class="modal-header">
      <div class="modal-title-wrap">
        <div class="modal-title-icon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        </div>
        <h2 id="contact-modal-title">Get in Touch</h2>
      </div>
      <button class="btn-icon modal-close" id="contact-close" aria-label="Close">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <p class="modal-desc">Have a question or want to work together? Drop me a message and your email, and I'll get in touch with you.</p>
    <form id="contact-form" novalidate>
      <div class="form-group">
        <label for="contact-email">Your email</label>
        <input type="email" id="contact-email" name="email" required placeholder="you@example.com" />
      </div>
      <div class="form-group">
        <label for="contact-message">Message</label>
        <textarea id="contact-message" name="message" required placeholder="How can I help you?" rows="4" class="form-textarea"></textarea>
      </div>
      <button type="submit" class="btn-full" id="contact-submit">
        <span>Send message</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="btn-arrow"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </button>
    </form>
    <p id="contact-success" class="suggest-feedback suggest-success" style="display:none">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
      Thanks! Your message has been sent. I'll get back to you soon.
    </p>
    <p id="contact-error" class="suggest-feedback suggest-error" style="display:none"></p>
  </div>
</div>

<footer class="about-footer">Built with curiosity. Source on GitHub.</footer>
</BaseLayout>

<script>
  import { db, analytics } from '../../lib/firebase';
  import { collection, addDoc, serverTimestamp } from 'firebase/firestore';
  import { logEvent } from 'firebase/analytics';

  const modal         = document.getElementById('contact-modal')!;
  const form          = document.getElementById('contact-form') as HTMLFormElement;
  const success       = document.getElementById('contact-success')!;
  const errorEl       = document.getElementById('contact-error')!;
  const submitBtn     = document.getElementById('contact-submit') as HTMLButtonElement;
  const contactBtn    = document.getElementById('contact-btn');
  const closeBtn      = document.getElementById('contact-close');

  function openModal() {
    modal.setAttribute('aria-hidden', 'false');
    modal.classList.add('is-open');
    document.body.style.overflow = 'hidden';
    (document.getElementById('contact-email') as HTMLInputElement)?.focus();
    if (analytics) {
      logEvent(analytics, 'contact_open');
    }
  }

  function closeModal() {
    modal.setAttribute('aria-hidden', 'true');
    modal.classList.remove('is-open');
    document.body.style.overflow = '';
    form.reset();
    form.style.display = '';
    success.style.display = 'none';
    errorEl.style.display = 'none';
  }

  contactBtn?.addEventListener('click', openModal);
  closeBtn?.addEventListener('click', closeModal);
  modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const emailInput = document.getElementById('contact-email') as HTMLInputElement;
    const messageInput = document.getElementById('contact-message') as HTMLTextAreaElement;
    const email = emailInput.value.trim();
    const message = messageInput.value.trim();

    if (!email) {
      errorEl.textContent = 'Please enter your email.';
      errorEl.style.display = '';
      emailInput.focus();
      return;
    }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      errorEl.textContent = 'Please enter a valid email address.';
      errorEl.style.display = '';
      emailInput.focus();
      return;
    }
    if (!message) {
      errorEl.textContent = 'Please enter a message.';
      errorEl.style.display = '';
      messageInput.focus();
      return;
    }

    submitBtn.disabled = true;
    errorEl.style.display = 'none';

    try {
      await addDoc(collection(db, 'contact_messages'), {
        email,
        message,
        createdAt: serverTimestamp(),
      });
      form.style.display = 'none';
      success.style.display = '';
      if (analytics) {
        logEvent(analytics, 'contact_submit');
      }
    } catch (err) {
      errorEl.textContent = 'Something went wrong. Please try again.';
      errorEl.style.display = '';
      if (analytics) {
        logEvent(analytics, 'contact_error', {
          error_message: err instanceof Error ? err.message : 'Unknown'
        });
      }
    } finally {
      submitBtn.disabled = false;
    }
  });
</script>

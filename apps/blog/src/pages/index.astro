    href: '/posts/on-policy-distillation/',
    tags: [
      { text: 'Knowledge Distillation', cls: 'tag-purple' },
      { text: 'LLM Training', cls: 'tag-cyan' },
      { text: 'Survey', cls: 'tag-amber' },
      { text: 'Interactive', cls: 'tag-green' },

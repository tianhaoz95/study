  {
    href: '/posts/sparse-to-dense-reward/',
    tags: [
      { text: 'LLM Post-Training', cls: 'tag-purple' },
      { text: 'Distillation', cls: 'tag-cyan' },
      { text: 'RL', cls: 'tag-amber' },
      { text: 'Interactive', cls: 'tag-green' },

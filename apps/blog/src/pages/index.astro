  footer {
    border-top: 1px solid var(--border);
    padding: 1.75rem 2rem;
    text-align: center;
    font-size: .775rem;
    color: var(--muted);
  }
</style>

<section class="hero">
  <div class="hero-text">
    <div class="hero-eyebrow" data-i18n="hero-eyebrow">Personal Research Blog</div>
    <h1 data-i18n="hero-title">Exploring the frontier of AI &amp; ML</h1>
    <p data-i18n="hero-desc">Deep dives into research papers, model architectures, and open-source implementations — with interactive visualizations and annotated source code.</p>
  </div>
  <div class="hero-viz" id="hero-viz" aria-hidden="true"></div>
</section>

<section class="posts-section">
  <div class="section-rule"><h2>Featured</h2></div>

  <a class="post-card featured" href="/posts/gemma4-mtp/">
    <div class="post-featured-badge">★ Featured</div>
    <div class="tags">
      <span class="tag tag-purple">Gemma 4</span>
      <span class="tag tag-cyan">Multi-Token Prediction</span>
      <span class="tag tag-cyan">Speculative Decoding</span>
      <span class="tag tag-green">Interactive</span>
    </div>
    <h3>How Gemma 4's Multi-Token Prediction Works</h3>
    <p>A deep dive into the Gemma4 Assistant architecture: KV sharing between the backbone and draft model, centroid-based vocabulary prediction, and bidirectional attention masks — with animated visualizations and annotated source code.</p>
    <div class="post-meta">
      <span>May 24, 2026</span>
      <span data-i18n="post-read">{postReadTime('gemma4-mtp')}</span>
      <span class="post-arrow">→</span>
    </div>
  </a>

  <div class="section-rule" style="margin-top:2.5rem"><h2 data-i18n="section-latest">Latest Posts</h2></div>

  <div id="posts-list">
    {initialPosts.map(post => (
      <a class="post-card" href={post.href}>
        {post.badge && <div class="post-featured-badge" data-i18n="post-badge">{post.badge}</div>}
        <div class="tags">
          {post.tags.map(t => (
            <span class={`tag ${t.cls}`}>{t.text}</span>
          ))}
        </div>
        <h3>{post.title}</h3>
        <p>{post.desc}</p>
        <div class="post-meta">
          <span>{post.date}</span>
          <span data-i18n="post-read">{post.read}</span>
          <span class="post-arrow">→</span>
        </div>
      </a>
    ))}
    <div id="posts-sentinel"></div>
  </div>
</section>

{deferredPosts.length > 0 && (
  <script type="application/json" id="deferred-posts" set:html={JSON.stringify(deferredPosts)} />
)}

<footer data-i18n="blog-footer">Built with curiosity. Source on GitHub.</footer>
</BaseLayout>

<script>
  import { initViz } from '../lib/viz';
  initViz();
</script>

<script>
  function applyReadProgress() {
    document.querySelectorAll<HTMLAnchorElement>('.post-card[href]').forEach(card => {
      if (card.querySelector('.post-progress-bar')) return;
      const slug = card.getAttribute('href')?.match(/\/posts\/([^/]+)/)?.[1];
      if (!slug) return;
      const pct = parseInt(localStorage.getItem(`heji-read-${slug}`) ?? '0', 10);
      if (pct <= 0) return;
      const el = document.createElement('div');
      el.className = 'post-progress-bar';
      el.style.width = `${pct}%`;
      card.appendChild(el);
    });
  }

  applyReadProgress();

  const sentinel = document.getElementById('posts-sentinel');
  const dataEl   = document.getElementById('deferred-posts');
  if (!sentinel || !dataEl) {
    // nothing to lazy-load
  } else {
    const CHUNK = 20;
    const posts: Array<{
      href: string;
      badge?: string;
      tags: { text: string; cls: string }[];
      title: string;
      desc: string;
      date: string;
      read: string;
    }> = JSON.parse(dataEl.textContent!);
    const list = document.getElementById('posts-list')!;
    let idx = 0;

    function esc(s: string) {
      return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function buildCard(p: typeof posts[0]): string {
      const badge = p.badge
        ? `<div class="post-featured-badge" data-i18n="post-badge">${esc(p.badge)}</div>`
        : '';
      const tags = p.tags
        .map(t => `<span class="tag ${esc(t.cls)}">${esc(t.text)}</span>`)
        .join('');
      return `<a class="post-card" href="${esc(p.href)}">
        ${badge}
        <div class="tags">${tags}</div>
        <h3>${esc(p.title)}</h3>
        <p>${esc(p.desc)}</p>
        <div class="post-meta">
          <span>${esc(p.date)}</span>
          <span data-i18n="post-read">${esc(p.read)}</span>
          <span class="post-arrow">→</span>
        </div>
      </a>`;
    }

    function applyCurrentLang(container: HTMLElement) {
      const lang = localStorage.getItem('heji-lang') || 'en';
      if (lang !== 'zh') return;
      const zhRead = '~15 分钟阅读';
      const zhBadge = '★ 最新';
      container.querySelectorAll<HTMLElement>('[data-i18n="post-read"]').forEach(el => {
        el.textContent = zhRead;
      });
      container.querySelectorAll<HTMLElement>('[data-i18n="post-badge"]').forEach(el => {
        el.textContent = zhBadge;
      });
    }

    const observer = new IntersectionObserver(entries => {
      if (!entries[0].isIntersecting) return;
      const chunk = posts.slice(idx, idx + CHUNK);
      if (chunk.length === 0) { observer.disconnect(); return; }
      idx += chunk.length;

      const tmp = document.createElement('div');
      tmp.innerHTML = chunk.map(buildCard).join('');
      applyCurrentLang(tmp);
      const frag = document.createDocumentFragment();
      while (tmp.firstChild) frag.appendChild(tmp.firstChild);
      list.insertBefore(frag, sentinel);
      applyReadProgress();

      if (idx >= posts.length) observer.disconnect();
    }, { rootMargin: '300px' });

    observer.observe(sentinel);
  }
</script>

    desc: 'BLT-D adds block-wise diffusion to byte-level language models — instead of one byte at a time, the decoder unmasks an entire block in parallel, cutting memory bandwidth by up to 92%. BLT-S and BLT-DV add speculative verification for lossless or near-lossless quality at 52–77% lower bandwidth.',
    date: 'May 26, 2026',
    read: postReadTime('fast-blt'),
  },
  {
    href: '/posts/gated-deltanet-2/',
    tags: [
      { text: 'Linear Attention', cls: 'tag-purple' },
      { text: 'Recurrent LLMs', cls: 'tag-cyan' },
      { text: 'Delta Rule', cls: 'tag-cyan' },
      { text: 'Interactive', cls: 'tag-green' },
    ],
    title: 'Gated DeltaNet-2: Untying Erase and Write in Linear Attention',
    desc: 'Every delta-rule recurrent model (DeltaNet, KDA) uses a single scalar to control both erasing stale memory and writing new content. Gated DeltaNet-2 (NVIDIA, 2026) splits these into independent channel-wise gates, improving multi-key retrieval accuracy by 35% over KDA at 4K context while preserving efficient chunkwise training.',
    date: 'May 26, 2026',
    read: postReadTime('gated-deltanet-2'),
  },
  {
    href: '/posts/oscar-int2-kv-cache/',
    tags: [
      { text: 'Quantization', cls: 'tag-purple' },
      { text: 'LLM Serving', cls: 'tag-cyan' },
      { text: 'Interactive', cls: 'tag-green' },
    ],
    title: 'OSCAR: 2-bit KV Cache Without the Accuracy Cliff',
    desc: 'How attention-aware covariance rotations make INT2 KV-cache quantization both accurate and deployable — closing the BF16 accuracy gap to 3.78 points on Qwen3 while delivering 8× memory reduction and 3–7× throughput gains in production SGLang serving.',
    date: 'May 26, 2025',
    read: postReadTime('oscar-int2-kv-cache'),
  },
  {
    href: '/posts/cola-dlm/',
    tags: [
      { text: 'Diffusion Language Models', cls: 'tag-purple' },
      { text: 'Continuous Latent Space', cls: 'tag-cyan' },
      { text: 'Flow Matching', cls: 'tag-cyan' },
      { text: 'Interactive', cls: 'tag-green' },
    ],
    title: 'Cola DLM: When Diffusion Stops Recovering Tokens and Starts Thinking in Latents',
    desc: 'Cola DLM (ByteDance Seed, 2026) separates text generation into global semantic organization — a block-causal DiT running flow matching over compressed latent blocks — and local token realization via a conditional decoder. It outperforms matched 2B AR and LLaDA baselines at 2000 EFLOPs on reasoning tasks, while exposing a fundamental PPL-vs-generation mismatch in continuous latent models.',
    date: 'May 26, 2026',
    read: postReadTime('cola-dlm'),
  },
  {
    href: '/posts/ptrm/',
    tags: [
      { text: 'Tiny Recursive Model', cls: 'tag-purple' },
      { text: 'Test-Time Compute', cls: 'tag-cyan' },
      { text: 'Latent-Space Reasoning', cls: 'tag-cyan' },
      { text: 'Interactive', cls: 'tag-green' },
    ],
    title: 'A 7M-Param Model That Beats GPT-5 at Reasoning Puzzles',
    desc: 'PTRM (Probabilistic Tiny Recursive Model) injects Gaussian noise into a 7M-parameter model\'s hidden state, runs K parallel guesses, and lets the model pick its own best answer — scoring 91.2% on pencil puzzles vs 55.1% for a 7-LLM ensemble, at 0.0001× the cost. A visual deep-dive into latent basins, width vs depth scaling, and the Q-head trick.',
    date: 'May 26, 2026',
    read: postReadTime('ptrm'),
  },
  {
    href: '/posts/elf-continuous-dlm/',
    tags: [
      { text: 'Diffusion Language Models', cls: 'tag-purple' },
      { text: 'Flow Matching', cls: 'tag-cyan' },
      { text: 'Continuous Embeddings', cls: 'tag-cyan' },
      { text: 'Interactive', cls: 'tag-green' },
    ],
    title: 'ELF: Continuous Diffusion for Language Finally Works',
    desc: 'How Embedded Language Flows (MIT, 2026) beats leading discrete diffusion models using 10× fewer training tokens — by staying in continuous embedding space for the entire denoising trajectory and discretizing only at the final step. With animated flow visualizations and pseudocode walkthroughs.',
    date: 'May 26, 2026',
    read: postReadTime('elf-continuous-dlm'),
  },
  {
    href: '/posts/speculative-decoding-compare/',
    tags: [
      { text: 'Speculative Decoding', cls: 'tag-cyan' },
      { text: 'Interactive', cls: 'tag-green' },
      { text: 'Comparison', cls: 'tag-purple' },
    ],
    title: 'Speculative Decoding Methods Compared',
    desc: 'Side-by-side comparison of six speculative decoding systems — EAGLE-3, DeepSeek MTP, DFlash, P-EAGLE, DART, and Gemma 4 MTP. Pick any two to compare: backbone access signal, draft architecture, inference cost, and core tradeoffs.',
    date: 'May 26, 2026',
    read: postReadTime('speculative-decoding-compare'),
  },
  {
    href: '/posts/gemma4-mtp/',
    tags: [
      { text: 'Gemma 4', cls: 'tag-purple' },
      { text: 'Multi-Token Prediction', cls: 'tag-cyan' },
      { text: 'Speculative Decoding', cls: 'tag-cyan' },
      { text: 'Interactive', cls: 'tag-green' },
    ],
    title: "How Gemma 4's Multi-Token Prediction Works",
    desc: 'A deep dive into the Gemma4 Assistant architecture: KV sharing between the backbone and draft model, centroid-based vocabulary prediction, and bidirectional attention masks — with animated visualizations and annotated source code.',
    date: 'May 24, 2026',
    read: postReadTime('gemma4-mtp'),
  },
];

// Enrich every post with build-time GitHub / paper link detection so the
// listing can be filtered by link availability on the client.
const enrichedPosts: Post[] = latestPosts.map(p => {
  const slug = p.href.match(/\/posts\/([^/]+)/)?.[1] ?? '';
  return { ...p, ...postLinks(slug) };
});

const initialPosts = enrichedPosts.slice(0, BATCH);
const deferredPosts = enrichedPosts.slice(BATCH);
---
<BaseLayout title="Catpuccino.ai">
<style is:global>
  .hero {
    padding: 6.5rem 2rem 4rem;
    max-width: 1040px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 3rem;
    align-items: center;
  }
  .hero-text { display: flex; flex-direction: column; }
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: .625rem;
    font-size: .72rem;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--purple-l);
    margin-bottom: 1.5rem;
    font-family: var(--ff-mono);
  }
  .hero-eyebrow::before {
    content: '';
    width: 18px;
    height: 1px;
    background: var(--purple);
  }
  .hero-text h1 {
    font-size: clamp(2rem, 5vw, 3.4rem);
    font-weight: 800;
    letter-spacing: -.03em;
    line-height: 1.1;
    margin-bottom: 1.25rem;
    background: linear-gradient(160deg, var(--text) 40%, var(--muted2));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .hero-text p {
    font-size: 1.075rem;
    color: var(--muted2);
    max-width: 560px;
    line-height: 1.75;
  }
  /* Viz */
  .viz-panel {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.25rem;
    user-select: none;
  }
  .viz-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }
  .viz-label { font-family: var(--ff-mono); font-size: .72rem; color: var(--purple-l); }
  .viz-step  { font-family: var(--ff-mono); font-size: .68rem; color: var(--muted); }
  .viz-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 6px;
  }
  .viz-token {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    transition: border-color .4s;
  }
  .viz-mask {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity .35s ease;
  }
  .viz-mask::after {
    content: '';
    display: block;
    width: 56%;
    height: 7px;
    background: var(--border-hi);
    border-radius: 3px;
    animation: viz-shimmer 1.8s ease-in-out infinite;
  }
  @keyframes viz-shimmer {
    0%, 100% { opacity: .4; }
    50%       { opacity: .85; }
  }
  .viz-word {
    font-family: var(--ff-mono);
    font-size: .67rem;
    color: var(--purple-l);
    opacity: 0;
    transition: opacity .35s ease;
    position: relative;
    z-index: 1;
    white-space: nowrap;
  }
  .viz-token.revealed               { border-color: rgba(139,92,246,.38); }
  .viz-token.revealed .viz-mask     { opacity: 0; }
  .viz-token.revealed .viz-word     { opacity: 1; }
  .viz-token.flash                  { animation: viz-flash .4s ease; }
  @keyframes viz-flash {
    0%   { background: rgba(139,92,246,.22); }
    100% { background: var(--surface); }
  }
  .viz-footer { margin-top: 1rem; }
  .viz-progress { height: 2px; background: var(--border); border-radius: 1px; overflow: hidden; }
  .viz-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--purple), var(--cyan));
    border-radius: 1px;
    width: 0%;
    transition: width .2s ease;
  }
  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; }
    .hero-viz { display: none; }
  }
  @media (max-width: 640px) {
    .hero { padding: 5rem 1.25rem 3rem; }
    .posts-section { padding: 0 1.25rem 5rem; }
    .post-card { padding: 1.25rem; }
    .post-card.featured { padding: 1.5rem 1.25rem; }
    .post-card h3 { font-size: 1.05rem; }
    .post-card.featured h3 { font-size: 1.2rem; }
    .post-meta { flex-wrap: wrap; gap: .5rem; }
  }
  .posts-section {
    max-width: 860px;
    margin: 0 auto;
    padding: 0 2rem 7rem;
  }
  .section-rule {
    display: flex;
    align-items: center;
    gap: .875rem;
    margin-bottom: 2rem;
  }
  .section-rule h2 {
    font-size: .72rem;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
    font-family: var(--ff-mono);
  }
  .section-rule::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
  }
  .post-card {
    display: block;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.75rem 2rem;
    text-decoration: none;
    transition: border-color .2s, transform .2s, box-shadow .2s;
    margin-bottom: 1rem;
    position: relative;
    overflow: hidden;
  }
  .post-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--purple-dim) 0%, transparent 55%);
    opacity: 0;
    transition: opacity .3s;
    pointer-events: none;
  }
  /* Hover effects are gated to hover-capable (non-touch) devices. On touch
     screens, applying :hover styles makes the first tap apply the hover state
     instead of activating the card link, so the card appears unresponsive
     until a second tap. */
  @media (hover: hover) {
    .post-card:hover {
      border-color: rgba(139,92,246,.5);
      transform: translateY(-2px);
      box-shadow: 0 8px 40px rgba(139,92,246,.1);
      text-decoration: none;
    }
    .post-card:hover::before { opacity: 1; }
  }
  .post-featured-badge {

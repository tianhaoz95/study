---
import BaseLayout from '../layouts/BaseLayout.astro';
import { postReadTime } from '../lib/readTimes';

const BATCH = 20;

interface Post {
  href: string;
  badge?: string;
  tags: { text: string; cls: string }[];
  title: string;
  desc: string;
  date: string;
  read: string;
}

const latestPosts: Post[] = [
  {
    href: '/posts/nvfp4-pretraining/',
    badge: '★ Latest',
    tags: [
      { text: 'Low-Precision Training', cls: 'tag-purple' },
      { text: 'LLM Pretraining', cls: 'tag-cyan' },
      { text: 'Interactive', cls: 'tag-green' },
    ],
    title: 'FP4 at Scale: NVFP4 Pretraining for LLMs',
    desc: 'NVIDIA trained a 12B Mamba-Transformer on 10 trillion tokens in 4-bit NVFP4 precision—matching FP8 accuracy—using four targeted fixes: mixed precision layers, Hadamard outlier smoothing, 2D weight scaling, and stochastic gradient rounding. On Blackwell GB300 this unlocks 6× the BF16 arithmetic throughput.',
    date: 'May 27, 2026',
    read: postReadTime('nvfp4-pretraining'),
  },
  {
    href: '/posts/tide-dllm/',
    tags: [
      { text: 'Diffusion LLMs', cls: 'tag-purple' },
      { text: 'Knowledge Distillation', cls: 'tag-cyan' },
      { text: 'Cross-Architecture', cls: 'tag-amber' },
      { text: 'Interactive', cls: 'tag-green' },
    ],
    title: 'TIDE: Shrinking Diffusion LLMs 22× Without Losing the Code Superpower',
    desc: 'Cross-architecture distillation compresses a 16B MoE diffusion LLM into a 0.6B student with 22× less memory and a 16-point HumanEval advantage over same-size AR models. Three synergistic components — TIDAL for noise-adaptive scheduling, CompDemo for richer teacher context, and Reverse CALM for cross-tokenizer alignment — each address a unique barrier that AR distillation never had to solve.',
    date: 'May 27, 2026',
    read: postReadTime('tide-dllm'),
  },
  {
    href: '/posts/replaid/',
    tags: [
      { text: 'Diffusion LMs', cls: 'tag-purple' },
      { text: 'Scaling Laws', cls: 'tag-cyan' },
      { text: 'Continuous Diffusion', cls: 'tag-cyan' },
      { text: 'Interactive', cls: 'tag-green' },
    ],
    title: 'RePlaid: Continuous Diffusion Scales Competitively with Discrete',
    desc: 'Continuous diffusion was written off after Plaid reported a 64× compute gap vs AR. RePlaid closes it to 20× by aligning the architecture with modern discrete DLMs — and achieves 22.1 PPL on OpenWebText, better than MDLM\'s 23.1. Interactive visualizations show the structured token embedding geometry, the self-correcting noise schedule, and the unified scaling laws.',
    date: 'May 27, 2026',
    read: postReadTime('replaid'),
  },
  {
    href: '/posts/bitlm/',
    tags: [
      { text: 'Diffusion LM', cls: 'tag-purple' },
      { text: 'Tokenization', cls: 'tag-cyan' },
      { text: 'Architecture', cls: 'tag-amber' },
      { text: 'Interactive', cls: 'tag-green' },
    ],
    title: 'BitLM: Generating Phrases, Not Tokens, with Binary Diffusion',
    desc: 'BitLM replaces the vocabulary softmax with an 18-bit binary code and a diffusion head that jointly denoises a block of 4 tokens at once — making parallel block-level generation native to the model\'s output interface, not a post-hoc trick. Scales smoothly to 8B on FineWeb-350BT with interactive denoising and binary hypercube visualizations.',
    date: 'May 27, 2026',
    read: postReadTime('bitlm'),
  },
  {
    href: '/posts/orthrus/',
    tags: [
      { text: 'Inference', cls: 'tag-purple' },
      { text: 'Diffusion LM', cls: 'tag-cyan' },
      { text: 'Speculative Decoding', cls: 'tag-amber' },
      { text: 'Interactive', cls: 'tag-green' },
    ],
    title: 'Orthrus: Parallel Tokens, Zero Extra Memory',
    desc: 'Orthrus freezes a pre-trained LLM and injects a lightweight diffusion head that shares the exact same KV cache — enabling speculative-decoding-style parallel generation with zero memory overhead and provably lossless output. Up to 7.8× speedup on Qwen3-8B with 0-point accuracy drop on MATH-500.',
    date: 'May 27, 2026',
    read: postReadTime('orthrus'),
  },
  {
    href: '/posts/rrattention/',
    tags: [
      { text: 'Attention', cls: 'tag-purple' },
      { text: 'Long Context', cls: 'tag-cyan' },
      { text: 'Inference Efficiency', cls: 'tag-cyan' },
      { text: 'Interactive', cls: 'tag-green' },
    ],
    title: 'RRAttention: 2.4× Faster Long-Context Inference via Round-Robin Head Sampling',
    desc: 'Every dynamic sparse attention method trades off some desirable property to gain another — global coverage requires mixing queries, query independence requires local scope. RRAttention breaks this deadlock by rotating which position each head samples within a stride, recovering 99.7% of full-attention accuracy while computing only half the blocks.',
    date: 'May 27, 2026',
    read: postReadTime('rrattention'),
  },
  {
    href: '/posts/llm-benchmark-bias/',
    tags: [
      { text: 'LLM Inference', cls: 'tag-purple' },
      { text: 'Benchmarking', cls: 'tag-cyan' },
      { text: 'Systems', cls: 'tag-amber' },
      { text: 'Interactive', cls: 'tag-green' },
    ],
    title: 'Your LLM Benchmark Is Lying to You',
    desc: 'At 1,000 QPS, single-process asyncio tools achieve only 14–44% of their target request rate and inject up to 58 seconds of fake latency — all due to Python\'s GIL. A Google paper models this with M/G/1 queueing theory, formalizes the NTPOT metric, and fixes it with a multi-process architecture that cuts artificial overhead to 0.63ms.',
    date: 'May 27, 2026',
    read: postReadTime('llm-benchmark-bias'),
  },
  {
    href: '/posts/sparse-to-dense-reward/',
    tags: [
      { text: 'LLM Post-Training', cls: 'tag-purple' },
      { text: 'Distillation', cls: 'tag-cyan' },
      { text: 'RL', cls: 'tag-amber' },
      { text: 'Interactive', cls: 'tag-green' },
    ],
    title: 'Sparse-to-Dense Reward: Why Your Labeled Data Belongs on the Teacher',
    desc: 'Spending scarce verifiable training data on the small deployment model is a misallocation. Run RL on the teacher first, then bridge to the student with dense FKL-to-OPD supervision. A raw 14× larger teacher distilled without Stage 1 is worse than cold GRPO — scale alone doesn\'t satisfy the reward-shaping condition.',
    date: 'May 27, 2026',
    read: postReadTime('sparse-to-dense-reward'),
  },
  {
    href: '/posts/opd-spec-decoding/',
    tags: [
      { text: 'Speculative Decoding', cls: 'tag-purple' },
      { text: 'On-Policy Distillation', cls: 'tag-cyan' },
      { text: 'Ideas + Analysis', cls: 'tag-amber' },
      { text: 'Interactive', cls: 'tag-green' },
    ],
    title: 'On-Policy Training for Speculative Decoding: Disaggregated Rollout-Verify-Train',
    desc: 'Draft models have the same exposure bias as KD students — they train on clean target sequences but deploy into a mix of accepted and rejected tokens. On-policy training through the full accept/reject loop fixes this. A disaggregated RVT architecture — borrowing prefill/decode separation from serving infra — makes it scale.',
    date: 'May 27, 2026',
    read: postReadTime('opd-spec-decoding'),
  },
  {
    href: '/posts/on-policy-distillation/',
    tags: [
      { text: 'Knowledge Distillation', cls: 'tag-purple' },
      { text: 'LLM Training', cls: 'tag-cyan' },
      { text: 'Survey', cls: 'tag-amber' },
      { text: 'Interactive', cls: 'tag-green' },
    ],
    title: 'On-Policy Distillation: A 2026 Field Guide',
    desc: 'Exposure bias silently breaks knowledge distillation for long sequences. On-policy distillation fixes it — but which divergence objective, and can RL do better? An interactive survey mapping GKD, MiniLLM, DistiLLM, STILL, rStar-Math, and the 2025–2026 frontier including the RL-vs-distillation debate.',
    date: 'May 27, 2026',
    read: postReadTime('on-policy-distillation'),
  },
  {
    href: '/posts/validate-mtp-ideas/',
    tags: [
      { text: 'Multi-Token Prediction', cls: 'tag-purple' },
      { text: 'LLM Training', cls: 'tag-cyan' },
      { text: 'Interactive', cls: 'tag-green' },
    ],
    title: 'How to Validate a Multi-Token Prediction Idea Before Burning a Pre-Training Run',
    desc: 'Training a frontier model costs months and millions. Four targeted steps — proxy training on polynomial tasks, loss gap monitoring over 5K steps, speculative decoding scaling law estimation, and Little\'s Law serving simulation — de-risk a novel MTP architecture in hours using a 30M–100M sandbox.',
    date: 'May 27, 2026',
    read: postReadTime('validate-mtp-ideas'),
  },
  {
    href: '/posts/longcat-flash/',
    tags: [
      { text: 'MoE Architecture', cls: 'tag-purple' },
      { text: 'Dynamic Compute', cls: 'tag-cyan' },
      { text: 'LLM Training', cls: 'tag-cyan' },
      { text: 'Interactive', cls: 'tag-green' },
    ],
    title: 'LongCat-Flash: 560B MoE with Dynamic Compute per Token',
    desc: 'Meituan\'s LongCat-Flash adds zero-computation experts to MoE routing — identity functions that cost nothing — so easy tokens ("the", "and") skip FFN compute while hard tokens ("eigenvector", "backpropagation") get more. Combined with Shortcut-Connected MoE that halves inference TPOT to 16ms, the result is a 560B model that trains 20T tokens in 30 days and serves at 100+ TPS for $0.70/M output tokens.',
    date: 'May 27, 2026',
    read: postReadTime('longcat-flash'),
  },
  {
    href: '/posts/representation-autoencoders-v2/',
    tags: [
      { text: 'Diffusion Models', cls: 'tag-purple' },
      { text: 'Image Generation', cls: 'tag-cyan' },
      { text: 'Interactive', cls: 'tag-green' },
    ],
    title: 'RAEv2: 10× Faster Image Generation with Smarter Encoder Layers',
    desc: 'Three elegant insights — summing the last K encoder layers for a free reconstruction-generation trade-off, combining RAE with REPA (they\'re complementary, not redundant), and reusing the REPA head for internal guidance with no extra model or forward pass — cut diffusion training from 800 to 80 epochs while setting a new state-of-the-art gFID of 1.06.',
    date: 'May 26, 2026',
    read: postReadTime('representation-autoencoders-v2'),
  },
  {
    href: '/posts/bitter-lesson-data-filtering/',
    tags: [
      { text: 'Data Curation', cls: 'tag-purple' },
      { text: 'Scaling Laws', cls: 'tag-cyan' },
      { text: 'Pretraining', cls: 'tag-cyan' },
      { text: 'Interactive', cls: 'tag-green' },
    ],
    title: 'A Bitter Lesson for Data Filtering',
    desc: 'Filtering training data to keep only "high-quality" content is almost universally assumed to be necessary. Stanford researchers challenge this: with enough compute and large enough models, unfiltered Common Crawl outperforms every standard filter — and models even benefit from shuffled-word junk. Interactive crossover charts show exactly when and why the ranking flips.',
    date: 'May 26, 2026',
    read: postReadTime('bitter-lesson-data-filtering'),
  },
  {
    href: '/posts/dynamo-llm/',
    tags: [
      { text: 'LLM Serving', cls: 'tag-purple' },
      { text: 'Energy Efficiency', cls: 'tag-cyan' },
      { text: 'Systems', cls: 'tag-cyan' },
      { text: 'Interactive', cls: 'tag-green' },
    ],
    title: 'DynamoLLM: Cutting 53% of LLM Serving Energy Without Touching Accuracy',
    desc: 'Current LLM clusters run every request — from "Hello!" to a 4,000-token code review — at TP8 max-frequency, wasting 3× energy on short requests. DynamoLLM routes requests to per-type pools with tuned tensor parallelism and GPU frequency, saving 53% energy, 38% CO₂, and 61% cost while meeting all latency SLOs. Interactive energy landscape shows how the optimal config shifts completely across request types.',
    date: 'May 26, 2026',
    read: postReadTime('dynamo-llm'),
  },
  {
    href: '/posts/opd-failure-modes/',
    tags: [
      { text: 'LLM Training', cls: 'tag-purple' },
      { text: 'Distillation', cls: 'tag-cyan' },
      { text: 'RLVR', cls: 'tag-cyan' },
      { text: 'Interactive', cls: 'tag-green' },
    ],
    title: 'The Many Faces of On-Policy Distillation: Pitfalls, Mechanisms, and Fixes',
    desc: 'On-policy distillation can catastrophically collapse or silently fail depending on three subtle traps: prefix mismatch (teacher accuracy drops 62%→46%), biased TopK gradients (causes training collapse), and a structural OPSD limitation where instance-specific PI averages to a weak policy. Interactive visualizations show each failure mode and the fixes that resolve them.',
    date: 'May 26, 2026',
    read: postReadTime('opd-failure-modes'),
  },
  {
    href: '/posts/fast-blt/',
    tags: [
      { text: 'Byte-Level LMs', cls: 'tag-purple' },
      { text: 'Diffusion Generation', cls: 'tag-cyan' },
      { text: 'Speculative Decoding', cls: 'tag-cyan' },
      { text: 'Interactive', cls: 'tag-green' },
    ],
    title: 'Fast Byte Latent Transformer: Generating Multiple Bytes at Once',
    desc: 'BLT-D adds block-wise diffusion to byte-level language models — instead of one byte at a time, the decoder unmasks an entire block in parallel, cutting memory bandwidth by up to 92%. BLT-S and BLT-DV add speculative verification for lossless or near-lossless quality at 52–77% lower bandwidth.',
    date: 'May 26, 2026',
    read: postReadTime('fast-blt'),
  },
  {
    href: '/posts/gated-deltanet-2/',
    tags: [
      { text: 'Linear Attention', cls: 'tag-purple' },
      { text: 'Recurrent LLMs', cls: 'tag-cyan' },
      { text: 'Delta Rule', cls: 'tag-cyan' },
      { text: 'Interactive', cls: 'tag-green' },
    ],
    title: 'Gated DeltaNet-2: Untying Erase and Write in Linear Attention',
    desc: 'Every delta-rule recurrent model (DeltaNet, KDA) uses a single scalar to control both erasing stale memory and writing new content. Gated DeltaNet-2 (NVIDIA, 2026) splits these into independent channel-wise gates, improving multi-key retrieval accuracy by 35% over KDA at 4K context while preserving efficient chunkwise training.',
    date: 'May 26, 2026',
    read: postReadTime('gated-deltanet-2'),
  },
  {
    href: '/posts/oscar-int2-kv-cache/',
    tags: [
      { text: 'Quantization', cls: 'tag-purple' },
      { text: 'LLM Serving', cls: 'tag-cyan' },
      { text: 'Interactive', cls: 'tag-green' },
    ],
    title: 'OSCAR: 2-bit KV Cache Without the Accuracy Cliff',
    desc: 'How attention-aware covariance rotations make INT2 KV-cache quantization both accurate and deployable — closing the BF16 accuracy gap to 3.78 points on Qwen3 while delivering 8× memory reduction and 3–7× throughput gains in production SGLang serving.',
    date: 'May 26, 2025',
    read: postReadTime('oscar-int2-kv-cache'),
  },
  {
    href: '/posts/cola-dlm/',
    tags: [
      { text: 'Diffusion Language Models', cls: 'tag-purple' },
      { text: 'Continuous Latent Space', cls: 'tag-cyan' },
      { text: 'Flow Matching', cls: 'tag-cyan' },
      { text: 'Interactive', cls: 'tag-green' },
    ],
    title: 'Cola DLM: When Diffusion Stops Recovering Tokens and Starts Thinking in Latents',
    desc: 'Cola DLM (ByteDance Seed, 2026) separates text generation into global semantic organization — a block-causal DiT running flow matching over compressed latent blocks — and local token realization via a conditional decoder. It outperforms matched 2B AR and LLaDA baselines at 2000 EFLOPs on reasoning tasks, while exposing a fundamental PPL-vs-generation mismatch in continuous latent models.',
    date: 'May 26, 2026',
    read: postReadTime('cola-dlm'),
  },
  {
    href: '/posts/ptrm/',
    tags: [
      { text: 'Tiny Recursive Model', cls: 'tag-purple' },
      { text: 'Test-Time Compute', cls: 'tag-cyan' },
      { text: 'Latent-Space Reasoning', cls: 'tag-cyan' },
      { text: 'Interactive', cls: 'tag-green' },
    ],
    title: 'A 7M-Param Model That Beats GPT-5 at Reasoning Puzzles',
    desc: 'PTRM (Probabilistic Tiny Recursive Model) injects Gaussian noise into a 7M-parameter model\'s hidden state, runs K parallel guesses, and lets the model pick its own best answer — scoring 91.2% on pencil puzzles vs 55.1% for a 7-LLM ensemble, at 0.0001× the cost. A visual deep-dive into latent basins, width vs depth scaling, and the Q-head trick.',
    date: 'May 26, 2026',
    read: postReadTime('ptrm'),
  },
  {
    href: '/posts/elf-continuous-dlm/',
    tags: [
      { text: 'Diffusion Language Models', cls: 'tag-purple' },
      { text: 'Flow Matching', cls: 'tag-cyan' },
      { text: 'Continuous Embeddings', cls: 'tag-cyan' },
      { text: 'Interactive', cls: 'tag-green' },
    ],
    title: 'ELF: Continuous Diffusion for Language Finally Works',
    desc: 'How Embedded Language Flows (MIT, 2026) beats leading discrete diffusion models using 10× fewer training tokens — by staying in continuous embedding space for the entire denoising trajectory and discretizing only at the final step. With animated flow visualizations and pseudocode walkthroughs.',
    date: 'May 26, 2026',
    read: postReadTime('elf-continuous-dlm'),
  },
  {
    href: '/posts/speculative-decoding-compare/',
    tags: [
      { text: 'Speculative Decoding', cls: 'tag-cyan' },
      { text: 'Interactive', cls: 'tag-green' },
      { text: 'Comparison', cls: 'tag-purple' },
    ],
    title: 'Speculative Decoding Methods Compared',
    desc: 'Side-by-side comparison of six speculative decoding systems — EAGLE-3, DeepSeek MTP, DFlash, P-EAGLE, DART, and Gemma 4 MTP. Pick any two to compare: backbone access signal, draft architecture, inference cost, and core tradeoffs.',
    date: 'May 26, 2026',
    read: postReadTime('speculative-decoding-compare'),
  },
  {
    href: '/posts/gemma4-mtp/',
    tags: [
      { text: 'Gemma 4', cls: 'tag-purple' },
      { text: 'Multi-Token Prediction', cls: 'tag-cyan' },
      { text: 'Speculative Decoding', cls: 'tag-cyan' },
      { text: 'Interactive', cls: 'tag-green' },
    ],
    title: "How Gemma 4's Multi-Token Prediction Works",
    desc: 'A deep dive into the Gemma4 Assistant architecture: KV sharing between the backbone and draft model, centroid-based vocabulary prediction, and bidirectional attention masks — with animated visualizations and annotated source code.',
    date: 'May 24, 2026',
    read: postReadTime('gemma4-mtp'),
  },
];

const initialPosts = latestPosts.slice(0, BATCH);
const deferredPosts = latestPosts.slice(BATCH);
---
<BaseLayout title="AI/ML Deep Dives">
<style is:global>
  .hero {
    padding: 6.5rem 2rem 4rem;
    max-width: 1040px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 3rem;
    align-items: center;
  }
  .hero-text { display: flex; flex-direction: column; }
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: .625rem;
    font-size: .72rem;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--purple-l);
    margin-bottom: 1.5rem;
    font-family: var(--ff-mono);
  }
  .hero-eyebrow::before {
    content: '';
    width: 18px;
    height: 1px;
    background: var(--purple);
  }
  .hero-text h1 {
    font-size: clamp(2rem, 5vw, 3.4rem);
    font-weight: 800;
    letter-spacing: -.03em;
    line-height: 1.1;
    margin-bottom: 1.25rem;
    background: linear-gradient(160deg, var(--text) 40%, var(--muted2));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .hero-text p {
    font-size: 1.075rem;
    color: var(--muted2);
    max-width: 560px;
    line-height: 1.75;
  }
  /* Viz */
  .viz-panel {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.25rem;
    user-select: none;
  }
  .viz-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }
  .viz-label { font-family: var(--ff-mono); font-size: .72rem; color: var(--purple-l); }
  .viz-step  { font-family: var(--ff-mono); font-size: .68rem; color: var(--muted); }
  .viz-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 6px;
  }
  .viz-token {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    transition: border-color .4s;
  }
  .viz-mask {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity .35s ease;
  }
  .viz-mask::after {
    content: '';
    display: block;
    width: 56%;
    height: 7px;
    background: var(--border-hi);
    border-radius: 3px;
    animation: viz-shimmer 1.8s ease-in-out infinite;
  }
  @keyframes viz-shimmer {
    0%, 100% { opacity: .4; }
    50%       { opacity: .85; }
  }
  .viz-word {
    font-family: var(--ff-mono);
    font-size: .67rem;
    color: var(--purple-l);
    opacity: 0;
    transition: opacity .35s ease;
    position: relative;
    z-index: 1;
    white-space: nowrap;
  }
  .viz-token.revealed               { border-color: rgba(139,92,246,.38); }
  .viz-token.revealed .viz-mask     { opacity: 0; }
  .viz-token.revealed .viz-word     { opacity: 1; }
  .viz-token.flash                  { animation: viz-flash .4s ease; }
  @keyframes viz-flash {
    0%   { background: rgba(139,92,246,.22); }
    100% { background: var(--surface); }
  }
  .viz-footer { margin-top: 1rem; }
  .viz-progress { height: 2px; background: var(--border); border-radius: 1px; overflow: hidden; }
  .viz-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--purple), var(--cyan));
    border-radius: 1px;
    width: 0%;
    transition: width .2s ease;
  }
  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; }
    .hero-viz { display: none; }
  }
  .posts-section {
    max-width: 860px;
    margin: 0 auto;
    padding: 0 2rem 7rem;
  }
  .section-rule {
    display: flex;
    align-items: center;
    gap: .875rem;
    margin-bottom: 2rem;
  }
  .section-rule h2 {
    font-size: .72rem;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
    font-family: var(--ff-mono);
  }
  .section-rule::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
  }
  .post-card {
    display: block;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.75rem 2rem;
    text-decoration: none;
    transition: border-color .2s, transform .2s, box-shadow .2s;
    margin-bottom: 1rem;
    position: relative;
    overflow: hidden;
  }
  .post-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--purple-dim) 0%, transparent 55%);
    opacity: 0;
    transition: opacity .3s;
    pointer-events: none;
  }
  .post-card:hover {
    border-color: rgba(139,92,246,.5);
    transform: translateY(-2px);
    box-shadow: 0 8px 40px rgba(139,92,246,.1);
    text-decoration: none;
  }
  .post-card:hover::before { opacity: 1; }
  .post-featured-badge {
    display: inline-flex;
    align-items: center;
    gap: .3rem;
    font-size: .68rem;
    font-weight: 600;
    letter-spacing: .07em;
    text-transform: uppercase;
    color: var(--amber);
    background: rgba(245,158,11,.09);
    border: 1px solid rgba(245,158,11,.22);
    border-radius: 4px;
    padding: .18rem .55rem;
    margin-bottom: .875rem;
    font-family: var(--ff-mono);
  }
  .post-card .tags { margin-bottom: .875rem; }
  .post-card h3 {
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: -.02em;
    color: var(--text);
    margin-bottom: .5rem;
    line-height: 1.3;
  }
  .post-card p {
    font-size: .875rem;
    color: var(--muted2);
    line-height: 1.65;
    margin-bottom: 1.25rem;
  }
  .post-meta {
    display: flex;
    align-items: center;

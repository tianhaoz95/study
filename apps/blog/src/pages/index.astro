  {
    href: '/posts/opd-spec-decoding/',
    tags: [
      { text: 'Speculative Decoding', cls: 'tag-purple' },
      { text: 'On-Policy Distillation', cls: 'tag-cyan' },
      { text: 'Ideas + Analysis', cls: 'tag-amber' },

<script>
  const safeGetItem = (key: string, fallback: string = ''): string => {
    try {
      return localStorage.getItem(key) || fallback;
    } catch (e) {
      return fallback;
    }
  };

  function applyReadProgress() {
    document.querySelectorAll<HTMLAnchorElement>('.post-card[href]').forEach(card => {
      if (card.querySelector('.post-progress-bar')) return;
      const slug = card.getAttribute('href')?.match(/\/posts\/([^/]+)/)?.[1];
      if (!slug) return;
      const pct = parseInt(safeGetItem(`heji-read-${slug}`, '0') ?? '0', 10);
      if (pct <= 0) return;
      const el = document.createElement('div');
      el.className = 'post-progress-bar';
      el.style.width = `${pct}%`;
      card.appendChild(el);
    });
  }

  applyReadProgress();
  (window as any).__hejiApplyUpvotes?.();

  const sentinel = document.getElementById('posts-sentinel');
  const dataEl   = document.getElementById('deferred-posts');
  if (!sentinel || !dataEl) {
    // nothing to lazy-load
  } else {
    const CHUNK = 20;
    const posts: Array<{
      href: string;
      badge?: string;
      tags: { text: string; cls: string }[];
      title: string;
      desc: string;
      date: string;
      read: string;
    }> = JSON.parse(dataEl.textContent!);
    const list = document.getElementById('posts-list')!;
    let idx = 0;

    function esc(s: string) {
      return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function buildCard(p: typeof posts[0]): string {
      const badge = p.badge
        ? `<div class="post-featured-badge" data-i18n="post-badge">${esc(p.badge)}</div>`
        : '';
      const tags = p.tags
        .map(t => `<span class="tag ${esc(t.cls)}">${esc(t.text)}</span>`)
        .join('');
      const slug = p.href.match(/\/posts\/([^/]+)/)?.[1] ?? '';
      const bm = slug
        ? `<button class="post-bookmark-btn" aria-label="Bookmark" aria-pressed="false" data-slug="${esc(slug)}" data-title="${esc(p.title)}" data-date="${esc(p.date)}" data-href="${esc(p.href)}" data-tags="${esc(JSON.stringify(p.tags))}"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg></button>`
        : '';
      const rl = slug
        ? `<button class="post-rl-btn" aria-label="Add to reading list" aria-pressed="false" data-slug="${esc(slug)}" data-title="${esc(p.title)}" data-date="${esc(p.date)}" data-href="${esc(p.href)}" data-tags="${esc(JSON.stringify(p.tags))}"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></button>`
        : '';
      return `<a class="post-card" href="${esc(p.href)}" data-slug="${esc(slug)}">
        ${badge}
        <div class="tags">${tags}</div>
        <h3>${esc(p.title)}</h3>
        <p>${esc(p.desc)}</p>
        <div class="post-meta">
          <span>${esc(p.date)}</span>
          <span data-i18n="post-read">${esc(p.read)}</span>
          <span class="post-arrow">→</span>
        </div>
        ${bm}${rl}
      </a>`;
    }

    function applyCurrentLang(container: HTMLElement) {
      const lang = safeGetItem('heji-lang', 'en') || 'en';
      if (lang !== 'zh') return;
      const zhRead = '~15 分钟阅读';
      const zhBadge = '★ 最新';
      container.querySelectorAll<HTMLElement>('[data-i18n="post-read"]').forEach(el => {
        el.textContent = zhRead;
      });
      container.querySelectorAll<HTMLElement>('[data-i18n="post-badge"]').forEach(el => {
        el.textContent = zhBadge;
      });
    }

    const observer = new IntersectionObserver(entries => {
      if (!entries[0].isIntersecting) return;
      const chunk = posts.slice(idx, idx + CHUNK);
      if (chunk.length === 0) { observer.disconnect(); return; }
      idx += chunk.length;

      const tmp = document.createElement('div');
      tmp.innerHTML = chunk.map(buildCard).join('');
      applyCurrentLang(tmp);
      const frag = document.createDocumentFragment();
      while (tmp.firstChild) frag.appendChild(tmp.firstChild);
      list.insertBefore(frag, sentinel);
      applyReadProgress();
      (window as any).__hejiApplyBookmarks?.();
      (window as any).__hejiApplyRL?.();
      (window as any).__hejiApplyUpvotes?.();

      if (idx >= posts.length) observer.disconnect();
    }, { rootMargin: '300px' });

    observer.observe(sentinel);
  }
</script>

<script>
  const safeGetItem = (key: string, fallback: string = ''): string => {
    try {
      return localStorage.getItem(key) || fallback;
    } catch (e) {
      return fallback;
    }
  };

  // ── Client-side instant search ──────────────────────────────────────────
  interface SearchPost {
    href: string;
    badge?: string;
    tags: { text: string; cls: string }[];
    title: string;
    desc: string;
    date: string;
    read: string;
    github?: boolean;
    paper?: boolean;
  }

  const searchInput  = document.getElementById('post-search')   as HTMLInputElement | null;
  const searchStatus = document.getElementById('search-status')  as HTMLElement | null;
  const allPostsEl   = document.getElementById('all-posts');
  const listEl       = document.getElementById('posts-list');

  if (searchInput && allPostsEl && listEl) {
    const allPosts: SearchPost[] = JSON.parse(allPostsEl.textContent!);

    // Insert a dedicated results container before the lazy-load sentinel so
    // deferred cards are never interleaved with search results.
    const sentinelEl = document.getElementById('posts-sentinel');
    const resultsEl  = document.createElement('div');
    resultsEl.id = 'search-results';
    listEl.insertBefore(resultsEl, sentinelEl);

    function escSearch(s: string) {
      return s
        .replace(/&/g, '&amp;').replace(/</g, '&lt;')
        .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function buildSearchCard(p: SearchPost): string {
      const badge = p.badge
        ? `<div class="post-featured-badge">${escSearch(p.badge)}</div>`
        : '';
      const tags = p.tags
        .map(t => `<span class="tag ${escSearch(t.cls)}">${escSearch(t.text)}</span>`)
        .join('');
      const slug = p.href.match(/\/posts\/([^/]+)/)?.[1] ?? '';
      const bm = slug
        ? `<button class="post-bookmark-btn" aria-label="Bookmark" aria-pressed="false" data-slug="${escSearch(slug)}" data-title="${escSearch(p.title)}" data-date="${escSearch(p.date)}" data-href="${escSearch(p.href)}" data-tags="${escSearch(JSON.stringify(p.tags))}"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg></button>`
        : '';
      const rl = slug
        ? `<button class="post-rl-btn" aria-label="Add to reading list" aria-pressed="false" data-slug="${escSearch(slug)}" data-title="${escSearch(p.title)}" data-date="${escSearch(p.date)}" data-href="${escSearch(p.href)}" data-tags="${escSearch(JSON.stringify(p.tags))}"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></button>`
        : '';
      return `<a class="post-card" href="${escSearch(p.href)}" data-slug="${escSearch(slug)}">
        ${badge}
        <div class="tags">${tags}</div>
        <h3>${escSearch(p.title)}</h3>
        <p>${escSearch(p.desc)}</p>
        <div class="post-meta">
          <span>${escSearch(p.date)}</span>
          <span>${escSearch(p.read)}</span>
          <span class="post-arrow">→</span>
        </div>
        ${bm}${rl}
      </a>`;
    }

    function applyReadProgressSearch(container: HTMLElement) {
      container.querySelectorAll<HTMLAnchorElement>('.post-card[href]').forEach(card => {
        if (card.querySelector('.post-progress-bar')) return;
        const slug = card.getAttribute('href')?.match(/\/posts\/([^/]+)/)?.[1];
        if (!slug) return;
        const pct = parseInt(safeGetItem(`heji-read-${slug}`, '0') ?? '0', 10);
        if (pct <= 0) return;
        const el = document.createElement('div');
        el.className = 'post-progress-bar';
        el.style.width = `${pct}%`;
        card.appendChild(el);
      });
    }

    // Toggle visibility of the statically-rendered initial cards + sentinel
    function setSearchMode(active: boolean) {
      listEl!.querySelectorAll<HTMLElement>(':scope > .post-card').forEach(c => {
        c.style.display = active ? 'none' : '';
      });
      if (sentinelEl) sentinelEl.style.display = active ? 'none' : '';
    }

    // ── Active filters + tag autosuggest ──────────────────────────────────
    const suggestEl = document.getElementById('search-suggest') as HTMLUListElement | null;
    const activeEl  = document.getElementById('active-filters') as HTMLElement | null;

    const selectedTags = new Set<string>();
    let needGithub = false;
    let needPaper  = false;

    function activeFilterCount() {
      return selectedTags.size + (needGithub ? 1 : 0) + (needPaper ? 1 : 0);
    }

    // Unique, sorted tag list derived from the corpus, for suggestions.
    const tagClsMap = new Map<string, string>();
    for (const p of allPosts) {
      for (const t of p.tags) if (!tagClsMap.has(t.text)) tagClsMap.set(t.text, t.cls);
    }
    const tagList = [...tagClsMap.entries()]
      .map(([text, cls]) => ({ text, cls }))
      .sort((a, b) => a.text.localeCompare(b.text));

    // Link facets surface as suggestions when the typed text resembles them.
    const FACETS = [
      { id: 'github' as const, label: 'Has GitHub repo', keywords: ['github', 'repo', 'code', 'source'] },
      { id: 'paper'  as const, label: 'Has paper link',  keywords: ['paper', 'arxiv', 'pdf', 'research'] },
    ];
    const GH_ICON = '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/></svg>';
    const PAPER_ICON = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>';
    const facetActive = (id: string) => (id === 'github' ? needGithub : needPaper);

    type Suggestion =
      | { type: 'tag'; text: string; cls: string }
      | { type: 'facet'; id: 'github' | 'paper'; label: string };

    let suggestions: Suggestion[] = [];
    let activeIdx = -1;

    function highlightMatch(text: string, q: string): string {
      const i = text.toLowerCase().indexOf(q.toLowerCase());
      if (q === '' || i < 0) return escSearch(text);
      return escSearch(text.slice(0, i))
        + '<mark>' + escSearch(text.slice(i, i + q.length)) + '</mark>'
        + escSearch(text.slice(i + q.length));
    }

    function closeSuggest() {
      if (!suggestEl) return;
      suggestEl.hidden = true;
      suggestEl.innerHTML = '';
      suggestions = [];
      activeIdx = -1;
      searchInput!.setAttribute('aria-expanded', 'false');
      searchInput!.removeAttribute('aria-activedescendant');
    }

    function renderSuggestions(raw: string) {
      if (!suggestEl) return;
      const ql = raw.trim().toLowerCase();
      const out: Suggestion[] = [];
      if (ql) {
        for (const f of FACETS) {
          if (facetActive(f.id)) continue;
          if (f.keywords.some(k => k.includes(ql) || ql.includes(k))) {
            out.push({ type: 'facet', id: f.id, label: f.label });
          }
        }
        for (const t of tagList) {
          if (selectedTags.has(t.text)) continue;
          if (t.text.toLowerCase().includes(ql)) out.push({ type: 'tag', text: t.text, cls: t.cls });
        }
      }
      suggestions = out.slice(0, 8);
      activeIdx = -1;
      if (suggestions.length === 0) { closeSuggest(); return; }

      suggestEl.innerHTML = suggestions.map((s, i) => {
        const head = `<li class="suggest-item" role="option" id="suggest-${i}" data-idx="${i}" aria-selected="false">`;
        if (s.type === 'facet') {
          return head + (s.id === 'github' ? GH_ICON : PAPER_ICON)
            + `<span class="suggest-text">${escSearch(s.label)}</span><span class="suggest-kind">filter</span></li>`;
        }
        return head + `<span class="suggest-dot ${escSearch(s.cls)}"></span>`
          + `<span class="suggest-text">${highlightMatch(s.text, ql)}</span><span class="suggest-kind">tag</span></li>`;
      }).join('');
      suggestEl.hidden = false;
      searchInput!.setAttribute('aria-expanded', 'true');
    }

    function setActiveIdx(i: number) {
      if (!suggestEl) return;
      activeIdx = i;
      suggestEl.querySelectorAll<HTMLLIElement>('.suggest-item').forEach((el, idx) => {
        const on = idx === i;
        el.setAttribute('aria-selected', String(on));
        if (on) el.scrollIntoView({ block: 'nearest' });
      });
      if (i >= 0) searchInput!.setAttribute('aria-activedescendant', `suggest-${i}`);
      else searchInput!.removeAttribute('aria-activedescendant');
    }

    function applySuggestion(s: Suggestion) {
      if (s.type === 'facet') {
        if (s.id === 'github') needGithub = true; else needPaper = true;
      } else {
        selectedTags.add(s.text);
      }
      searchInput!.value = '';
      closeSuggest();
      renderActiveFilters();
      runQuery();
      searchInput!.focus();
    }

    // ── Active filter chips (removable) ────────────────────────────────────
    function renderActiveFilters() {
      if (!activeEl) return;
      if (activeFilterCount() === 0) { activeEl.hidden = true; activeEl.innerHTML = ''; return; }
      const chips: string[] = [];
      if (needGithub) chips.push(`<span class="active-chip">${GH_ICON}Has GitHub<button class="active-x" type="button" aria-label="Remove GitHub filter" data-remove-facet="github">×</button></span>`);
      if (needPaper)  chips.push(`<span class="active-chip">${PAPER_ICON}Has paper<button class="active-x" type="button" aria-label="Remove paper filter" data-remove-facet="paper">×</button></span>`);
      for (const text of selectedTags) {
        const cls = tagClsMap.get(text) ?? '';
        chips.push(`<span class="active-chip"><span class="suggest-dot ${escSearch(cls)}"></span>${escSearch(text)}<button class="active-x" type="button" aria-label="Remove tag filter" data-remove-tag="${escSearch(text)}">×</button></span>`);
      }
      chips.push(`<button class="active-clear" type="button" id="active-clear">Clear all</button>`);
      activeEl.innerHTML = chips.join('');
      activeEl.hidden = false;
    }

    // The unified query: combines free-text search with the filter facets.
    function runQuery() {
      const raw   = searchInput!.value;
      const q     = raw.trim().toLowerCase();
      const words = q.split(/\s+/).filter(Boolean);
      const active = q !== '' || activeFilterCount() > 0;

      if (!active) {
        setSearchMode(false);
        resultsEl.innerHTML = '';
        if (searchStatus) searchStatus.hidden = true;
        return;
      }

      setSearchMode(true);

      const matches = allPosts.filter(p => {
        if (needGithub && !p.github) return false;
        if (needPaper  && !p.paper)  return false;
        if (selectedTags.size > 0 && !p.tags.some(t => selectedTags.has(t.text))) return false;
        if (words.length > 0) {
          const hay = [p.title, p.desc, ...p.tags.map(t => t.text)].join(' ').toLowerCase();
          if (!words.every(w => hay.includes(w))) return false;
        }
        return true;
      });

      if (matches.length === 0) {
        const reason = q !== ''
          ? `No posts found for <strong>"${escSearch(raw)}"</strong>`
          : `No posts match the selected filters.`;
        resultsEl.innerHTML = `<div class="search-empty">${reason}</div>`;
      } else {
        resultsEl.innerHTML = matches.map(buildSearchCard).join('');
        applyReadProgressSearch(resultsEl);
        (window as any).__hejiApplyBookmarks?.();
        (window as any).__hejiApplyRL?.();
        (window as any).__hejiApplyUpvotes?.();
      }

      if (searchStatus) {
        searchStatus.hidden      = false;
        searchStatus.textContent = matches.length === 1 ? '1 result' : `${matches.length} results`;
      }
    }

    searchInput.addEventListener('input', () => {
      renderSuggestions(searchInput!.value);
      runQuery();
    });

    searchInput.addEventListener('focus', () => {
      if (searchInput!.value.trim()) renderSuggestions(searchInput!.value);
    });

    searchInput.addEventListener('keydown', (e) => {
      if (!suggestEl || suggestEl.hidden || suggestions.length === 0) return;
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        setActiveIdx(activeIdx + 1 >= suggestions.length ? 0 : activeIdx + 1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        setActiveIdx(activeIdx <= 0 ? suggestions.length - 1 : activeIdx - 1);
      } else if (e.key === 'Enter') {
        if (activeIdx >= 0 && suggestions[activeIdx]) {
          e.preventDefault();
          applySuggestion(suggestions[activeIdx]);
        }
      } else if (e.key === 'Escape') {
        closeSuggest();
      }
    });

    // mousedown (not click) so it fires before the input loses focus.
    suggestEl?.addEventListener('mousedown', (e) => {
      const li = (e.target as HTMLElement).closest('.suggest-item') as HTMLElement | null;
      if (!li) return;
      e.preventDefault();
      const idx = parseInt(li.dataset.idx ?? '-1', 10);
      if (suggestions[idx]) applySuggestion(suggestions[idx]);
    });

    document.addEventListener('click', (e) => {
      if (!suggestEl || suggestEl.hidden) return;
      const target = e.target as Node;
      if (!suggestEl.contains(target) && target !== searchInput) closeSuggest();
    });

    // Removing / clearing active filter chips.
    activeEl?.addEventListener('click', (e) => {
      const el = e.target as HTMLElement;
      const rmTag = el.closest('[data-remove-tag]') as HTMLElement | null;
      if (rmTag) { selectedTags.delete(rmTag.dataset.removeTag!); renderActiveFilters(); runQuery(); return; }
      const rmFacet = el.closest('[data-remove-facet]') as HTMLElement | null;
      if (rmFacet) {
        if (rmFacet.dataset.removeFacet === 'github') needGithub = false; else needPaper = false;
        renderActiveFilters(); runQuery(); return;
      }
      if (el.id === 'active-clear') {
        selectedTags.clear(); needGithub = false; needPaper = false;
        renderActiveFilters(); runQuery();
      }
    });

    renderActiveFilters();
  }
</script>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Bookmarks | Catpuccino.ai" crumb="Bookmarks">

<!-- Shared .bookmarks-page / .bm-card / .bookmarks-state styles live in global.css -->

<div class="bookmarks-page">
  <div class="bookmarks-header">
    <div class="bookmarks-eyebrow">Saved References</div>
    <h1>Bookmarks</h1>
    <p class="bookmarks-count-label" id="bm-count-label"></p>
  </div>

  <!-- Loading -->
  <div class="bookmarks-state is-active" id="bm-loading">
    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
    <h2>Loading…</h2>
  </div>

  <!-- Not signed in -->
  <div class="bookmarks-state" id="bm-signed-out">
    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
    <h2>Sign in to see your bookmarks</h2>
    <p>Save posts to your reading list and access them from any device.</p>
    <button class="btn-signin-large" id="bm-signin-btn">
      <svg viewBox="0 0 24 24" fill="currentColor" width="15" height="15" aria-hidden="true">
        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/>
        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"/>
      </svg>
      Sign in with Google
    </button>
  </div>

  <!-- Empty state (signed in, no bookmarks) -->
  <div class="bookmarks-state" id="bm-empty">
    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
    <h2>No bookmarks yet</h2>
    <p>Browse posts and click the bookmark icon to save them to your reading list.</p>
    <a href="/" class="browse-btn">Browse posts →</a>
  </div>

  <!-- Bookmark list -->
  <div class="bookmarks-grid" id="bm-grid" style="display:none"></div>
</div>

<script>
  import { auth } from '../../lib/firebase';
  import { onAuthStateChanged, signInWithPopup, GoogleAuthProvider, type User } from 'firebase/auth';
  import { getBookmarkDocs, toggleBookmark, type BookmarkMeta } from '../../lib/bookmarks';

  const elLoading   = document.getElementById('bm-loading')!;
  const elSignedOut = document.getElementById('bm-signed-out')!;
  const elEmpty     = document.getElementById('bm-empty')!;
  const elGrid      = document.getElementById('bm-grid')!;
  const elCount     = document.getElementById('bm-count-label')!;

  function showState(which: 'loading' | 'signed-out' | 'empty' | 'grid') {
    elLoading.classList.toggle('is-active',   which === 'loading');
    elSignedOut.classList.toggle('is-active', which === 'signed-out');
    elEmpty.classList.toggle('is-active',     which === 'empty');
    elGrid.style.display = which === 'grid' ? '' : 'none';
  }

  function esc(s: string) {
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function buildCard(bm: BookmarkMeta): string {
    const tags = (bm.tags ?? [])
      .map(t => `<span class="tag ${esc(t.cls)}">${esc(t.text)}</span>`)
      .join('');
    // Read progress from localStorage (populated at scroll milestones, or synced from Firestore on sign-in)
    let progressHtml = '';
    try {
      const pct = Math.min(100, Math.max(0, parseInt(localStorage.getItem(`heji-read-${bm.slug}`) ?? '0', 10)));
      if (pct > 0) {
        const label = pct >= 100 ? 'Read ✓' : `${pct}%`;
        progressHtml = `<div class="bm-progress-wrap">
          <div class="bm-progress-track">
            <div class="bm-progress-fill" style="width:${pct}%"></div>
          </div>
          <span class="bm-progress-label">${label}</span>
        </div>`;
      }
    } catch (e) {}
    return `<div class="bm-card-wrapper" data-slug="${esc(bm.slug)}">
      <a class="bm-card" href="${esc(bm.href)}">
        <div class="tags">${tags}</div>
        <h3>${esc(bm.title)}</h3>
        <div class="post-meta">
          <span>${esc(bm.date)}</span>
          <span class="post-arrow">→</span>
        </div>
        ${progressHtml}
      </a>
      <button class="bm-remove-btn" aria-label="Remove bookmark" data-slug="${esc(bm.slug)}" title="Remove bookmark">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>`;
  }

  function renderBookmarks(bookmarks: BookmarkMeta[]) {
    if (bookmarks.length === 0) {
      showState('empty');
      elCount.style.display = 'none';
      return;
    }
    elGrid.innerHTML = bookmarks.map(buildCard).join('');
    elCount.textContent = `${bookmarks.length} saved post${bookmarks.length === 1 ? '' : 's'}`;
    elCount.style.display = '';
    showState('grid');
  }

  let currentUser: User | null = null;
  let currentBookmarks: BookmarkMeta[] = [];

  // Remove button handler
  elGrid.addEventListener('click', async (e: MouseEvent) => {
    const btn = (e.target as Element).closest<HTMLButtonElement>('.bm-remove-btn');
    if (!btn || !currentUser) return;
    e.preventDefault();
    e.stopPropagation();

    const slug = btn.dataset.slug ?? '';
    if (!slug) return;

    // Optimistic remove
    currentBookmarks = currentBookmarks.filter(b => b.slug !== slug);
    renderBookmarks(currentBookmarks);

    // Sync global bookmark state if present
    const globalSet: Set<string> | undefined = (window as any).__hejiBookmarks;
    if (globalSet) {
      globalSet.delete(slug);
      (window as any).__hejiApplyBookmarks?.();
      const countEl = document.getElementById('dropdown-bookmarks-count');
      if (countEl) {
        const n = globalSet.size;
        if (n === 0) {
          countEl.style.display = 'none';
        } else {
          countEl.textContent = String(n);
          countEl.style.display = '';
        }
      }
    }

    try {
      const bm = currentBookmarks.find(b => b.slug === slug) ?? { slug, title: '', date: '', href: '', tags: [] };
      await toggleBookmark(currentUser.uid, slug, bm, true);
    } catch (err) {
      console.error('Remove bookmark failed:', err);
    }
  });

  // Sign-in button on this page
  document.getElementById('bm-signin-btn')?.addEventListener('click', async () => {
    try {
      await signInWithPopup(auth, new GoogleAuthProvider());
    } catch (err) {
      console.error('Sign in failed:', err);
    }
  });

  onAuthStateChanged(auth, async (user: User | null) => {
    currentUser = user;
    if (!user) {
      showState('signed-out');
      elCount.style.display = 'none';
      return;
    }
    showState('loading');
    try {
      currentBookmarks = await getBookmarkDocs(user.uid);
      renderBookmarks(currentBookmarks);
    } catch (err) {
      console.error('Failed to load bookmarks:', err);
      showState('empty');
    }
  });
</script>

</BaseLayout>

<span class="cs-line cmt"># N = draft length (budget)</span>
<span class="cs-line cmt"># c = drafter cost / target cost</span>
<span class="cs-line"></span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">expected_speedup</span>(alpha, N, c):</span>
<span class="cs-line hl-p">    num = <span class="num">1</span> - alpha ** (N + <span class="num">1</span>)</span>
<span class="cs-line hl-p">    den = (<span class="num">1</span> - alpha) * (N * c + <span class="num">1</span>)</span>
<span class="cs-line hl-p">    <span class="kw">return</span> num / den</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Typical AR drafter (EAGLE)</span>
<span class="cs-line">c_typical = <span class="num">0.05</span>   <span class="cmt"># ~5% of target cost</span></span>
<span class="cs-line">alpha     = <span class="num">0.90</span></span>
<span class="cs-line">S_16  = <span class="fn">expected_speedup</span>(alpha, <span class="num">16</span>,  c_typical)</span>
<span class="cs-line">S_256 = <span class="fn">expected_speedup</span>(alpha, <span class="num">256</span>, c_typical)</span>
<span class="cs-line cmt"># → S_16 ≈ 5.2×, S_256 ≈ 4.3× (diminishes!)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Ultra-low cost (JetSpec/DFlash)</span>
<span class="cs-line">c_low = <span class="num">0.0005</span>   <span class="cmt"># &lt;0.1% of target cost</span></span>
<span class="cs-line">S_16  = <span class="fn">expected_speedup</span>(alpha, <span class="num">16</span>,  c_low)</span>
<span class="cs-line">S_256 = <span class="fn">expected_speedup</span>(alpha, <span class="num">256</span>, c_low)</span>
<span class="cs-line cmt"># → S_16 ≈ 6.5×, S_256 ≈ 14.8× (scales!)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Key insight: need BOTH low c AND high α</span>
<span class="cs-line cmt"># Low c alone isn't enough if α degrades</span>
<span class="cs-line hl-c">alpha_bad = <span class="num">0.70</span>   <span class="cmt"># DFlash w/ inconsistency</span></span>
<span class="cs-line hl-c">S_256_bad = <span class="fn">expected_speedup</span>(alpha_bad, <span class="num">256</span>, c_low)</span>
<span class="cs-line hl-c"><span class="cmt"># → only 3.3× despite ultra-low cost!</span></span>
      </pre>
    </div>

    <!-- panel: dilemma -->
    <div class="cs-panel" id="panel-dilemma">
      <pre class="cs-pre">
<span class="cs-line cmt"># Branch-agnostic DFlash scoring (Eq. 3)</span>
<span class="cs-line cmt"># Each position has independent marginal r_i</span>
<span class="cs-line hl-a"><span class="kw">def</span> <span class="fn">dflash_branch_score</span>(tokens, r):</span>
<span class="cs-line hl-a">    <span class="cmt"># r[i][tok] = P(tok at depth i | prefix x)</span></span>
<span class="cs-line hl-a">    <span class="kw">return</span> sum(<span class="fn">log</span>(r[i][tok])</span>
<span class="cs-line hl-a">               <span class="kw">for</span> i, tok <span class="kw">in</span> <span class="fn">enumerate</span>(tokens))</span>
<span class="cs-line cmt"># ↑ NO conditioning on chosen ancestors!</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Real MATH-500 example (prompt 0, step 0):</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># DFlash rank-1 branch: "the given told that"</span>
<span class="cs-line hl-a">surrogate_score = -<span class="num">3.76</span>   <span class="cmt"># looks good!</span></span>
<span class="cs-line hl-a">target_joint   = -<span class="num">63.32</span>  <span class="cmt"># actually terrible</span></span>
<span class="cs-line hl-a">gap = -<span class="num">59.56</span>  <span class="cmt"># 59-nat gap → rejected immediately</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Actual best branch: "are given that the"</span>
<span class="cs-line hl-g">target_joint_best = -<span class="num">0.08</span>  <span class="cmt"># near-perfect</span></span>
<span class="cs-line hl-g">dflash_rank = <span class="num">3</span>  <span class="cmt"># buried at rank 3!</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Aggregate over 50 MATH-500 prompts:</span>
<span class="cs-line">diffusion_median_gap = <span class="num">62.81</span>  <span class="cmt"># nats</span></span>
<span class="cs-line">causal_median_gap    = <span class="num">12.36</span>  <span class="cmt"># nats (5× smaller)</span></span>
<span class="cs-line cmt"># 92% of prompts: diffusion gap &gt; causal gap</span>
<span class="cs-line cmt"># accepted token ratio: 1.95× better (causal)</span>
      </pre>
    </div>

    <!-- panel: arch -->
    <div class="cs-panel" id="panel-arch">
      <pre class="cs-pre">
<span class="cs-line cmt"># Tree-causal attention mask (Eq. 5)</span>
<span class="cs-line cmt"># For two tree nodes u, v:</span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">tree_causal_mask</span>(u, v, tree):</span>
<span class="cs-line hl-p">    <span class="cmt"># v can attend to u only if u is ancestor</span></span>
<span class="cs-line hl-p">    <span class="kw">if</span> u <span class="kw">in</span> tree.<span class="fn">ancestors</span>(v) <span class="kw">or</span> u == v:</span>
<span class="cs-line hl-p">        <span class="kw">return</span> <span class="num">0</span>       <span class="cmt"># visible</span></span>
<span class="cs-line hl-p">    <span class="kw">else</span>:</span>
<span class="cs-line hl-p">        <span class="kw">return</span> -<span class="fn">inf</span>()  <span class="cmt"># masked</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Masked attention (Eq. 6)</span>
<span class="cs-line cmt"># Qv = query for node v</span>
<span class="cs-line cmt"># K, V = keys/values across all tree nodes</span>
<span class="cs-line hl-c">Attn_v = <span class="fn">softmax</span>(Qv @ K.T / sqrt(d) + M_v) @ V</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># All nodes processed in ONE forward pass:</span>
<span class="cs-line cmt"># → no sequential depth unrolling needed</span>
<span class="cs-line cmt"># → cost c stays ultra-low regardless of depth</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Feature fusion: concat hidden layers</span>
<span class="cs-line">h_fused = <span class="fn">cat</span>([h_layer_N, h_layer_M, h_layer_1])</span>
<span class="cs-line">h_fused = <span class="fn">linear</span>(h_fused)  <span class="cmt"># project to draft dim</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Training: forward-KL distillation</span>
<span class="cs-line cmt"># (NOT reverse-KL — see ablation)</span>
<span class="cs-line hl-g">L = <span class="fn">KL_divergence</span>(p_teacher, q_draft)</span>
<span class="cs-line hl-g"><span class="cmt"># forward-KL preserves teacher's full coverage</span></span>
<span class="cs-line hl-g"><span class="cmt"># reverse-KL → 36–46% speedup drop in ablation</span></span>
      </pre>
    </div>

    <!-- panel: causality -->
    <div class="cs-panel" id="panel-causality">
      <pre class="cs-pre">
<span class="cs-line cmt"># Branch-wise factorization (Eq. 7)</span>
<span class="cs-line cmt"># JetSpec: each node conditioned on branch prefix</span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">jetspec_branch_prob</span>(branch, x, h_fused):</span>
<span class="cs-line hl-p">    log_prob = <span class="num">0</span></span>
<span class="cs-line hl-p">    <span class="kw">for</span> i, (node, ancestors) <span class="kw">in</span> <span class="fn">enumerate</span>(branch):</span>
<span class="cs-line hl-p">        <span class="cmt"># π&lt;u = actual ancestor tokens along branch</span></span>
<span class="cs-line hl-p">        log_prob += <span class="fn">log</span>(<span class="fn">q</span>(node | x, h_fused, ancestors))</span>
<span class="cs-line hl-p">    <span class="kw">return</span> log_prob</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Tree expansion (Algorithm 1 excerpt)</span>
<span class="cs-line cmt"># Score = accumulated draft log-probability</span>
<span class="cs-line hl-c"><span class="kw">def</span> <span class="fn">score_branch</span>(branch):</span>
<span class="cs-line hl-c">    <span class="kw">return</span> sum(<span class="fn">log</span>(<span class="fn">q</span>(y | x, h_fused, pi_lt_y))</span>
<span class="cs-line hl-c">               <span class="kw">for</span> y, pi_lt_y <span class="kw">in</span> branch)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># MATH-500 prompt 0 example comparison:</span>
<span class="cs-line cmt"># JetSpec rank-1: "are told that"</span>
<span class="cs-line">jetspec_surrogate = -<span class="num">0.42</span>  <span class="cmt"># nats</span></span>
<span class="cs-line">jetspec_target    = -<span class="num">0.08</span>  <span class="cmt"># nats</span></span>
<span class="cs-line">jetspec_gap       = -<span class="num">0.34</span>  <span class="cmt"># ← tiny!</span></span>
<span class="cs-line">jetspec_accepted  = <span class="num">6</span>       <span class="cmt"># tokens accepted</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># DFlash rank-1: "the given told that"</span>
<span class="cs-line">dflash_surrogate  = -<span class="num">3.76</span>  <span class="cmt"># nats</span></span>
<span class="cs-line">dflash_target     = -<span class="num">63.32</span> <span class="cmt"># nats</span></span>
<span class="cs-line">dflash_gap        = -<span class="num">59.56</span> <span class="cmt"># ← 175× larger!</span></span>
<span class="cs-line">dflash_accepted   = <span class="num">4</span>       <span class="cmt"># tokens accepted</span></span>
      </pre>
    </div>


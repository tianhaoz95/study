<script>
// ── Sidebar toggles ──
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const collapsed = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', collapsed);
  tocToggle.textContent = collapsed ? '›' : '‹';
});
const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const collapsed = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', collapsed);
  csToggle.textContent = collapsed ? '‹' : '›';
});

// ── Code sidebar tab switching ──
const tabMeta = {
  ceiling:   { file: 'jetspec/speedup.py',     title: 'Scaling Ceiling' },
  dilemma:   { file: 'jetspec/dilemma.py',     title: 'The Causality Dilemma' },
  arch:      { file: 'jetspec/architecture.py',title: 'Architecture & Training' },
  causality: { file: 'jetspec/causality.py',   title: 'Causal Conditioning' },
  scaling:   { file: 'jetspec/results.py',     title: 'Budget Scaling Data' },
  results:   { file: 'jetspec/benchmarks.py',  title: 'Benchmark Results' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ── IntersectionObserver: sync TOC + sidebar ──
const sectionMap = {
  's-ceiling':   'ceiling',
  's-dilemma':   'dilemma',
  's-arch':      'arch',
  's-causality': 'causality',
  's-scaling':   'scaling',
  's-results':   'results',
};
document.querySelectorAll('.post-body section[id]').forEach(function(s) {
  new IntersectionObserver(function(entries) {
    entries.forEach(function(e) {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(function(li) {
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id);
        });
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.25 }).observe(s);
});

// ── §01 Scaling Ceiling Canvas ──
(function() {
  const canvas = document.getElementById('ceiling-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  let currentC = 0.05;

  function speedup(alpha, N, c) {
    return (1 - Math.pow(alpha, N + 1)) / ((1 - alpha) * (N * c + 1));
  }

  function drawCeiling(c) {
    const W = canvas.clientWidth;
    const H = 260;
    canvas.width  = W * DPR;
    canvas.height = H * DPR;
    ctx.setTransform(1, 0, 0, 1, 0, 0);
    ctx.scale(DPR, DPR);
    ctx.clearRect(0, 0, W, H);

    const pad = { l: 52, r: 20, t: 20, b: 36 };
    const cW = W - pad.l - pad.r;
    const cH = H - pad.t - pad.b;
    const budgets = [2, 4, 8, 16, 32, 64, 128, 256];
    const maxY = c < 0.001 ? 20 : 10;
    const yTicks = c < 0.001 ? [0,4,8,12,16,20] : [0,2,4,6,8,10];

    function xPos(N) {
      return pad.l + (Math.log2(N) - Math.log2(2)) / (Math.log2(256) - Math.log2(2)) * cW;
    }
    function yPos(s) {
      return pad.t + cH - Math.min(s, maxY) / maxY * cH;
    }

    // grid lines
    ctx.strokeStyle = 'rgba(255,255,255,0.04)';
    ctx.lineWidth = 1;
    yTicks.forEach(function(y) {
      ctx.beginPath();
      ctx.moveTo(pad.l, yPos(y));
      ctx.lineTo(pad.l + cW, yPos(y));
      ctx.stroke();
    });
    budgets.forEach(function(N) {
      ctx.beginPath();
      ctx.moveTo(xPos(N), pad.t);
      ctx.lineTo(xPos(N), pad.t + cH);
      ctx.stroke();
    });

    // axes
    ctx.strokeStyle = 'rgba(255,255,255,0.15)';
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(pad.l, pad.t); ctx.lineTo(pad.l, pad.t + cH); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(pad.l, pad.t + cH); ctx.lineTo(pad.l + cW, pad.t + cH); ctx.stroke();

    // labels
    ctx.fillStyle = 'rgba(107,114,128,.8)';
    ctx.font = '10px var(--ff-mono, monospace)';
    ctx.textAlign = 'right';
    yTicks.forEach(function(y) {
      ctx.fillText(y + '×', pad.l - 6, yPos(y) + 4);
    });
    ctx.textAlign = 'center';
    [16, 64, 128, 256].forEach(function(N) {
      ctx.fillText(N, xPos(N), pad.t + cH + 18);
    });
    ctx.fillStyle = 'rgba(107,114,128,.6)';
    ctx.fillText('draft budget N', pad.l + cW / 2, pad.t + cH + 32);

    // lines for different alpha values
    var configs = [
      { alpha: 0.75, color: 'rgba(139,92,246,.45)' },
      { alpha: 0.85, color: 'rgba(139,92,246,.7)' },
      { alpha: 0.95, color: 'rgba(139,92,246,1)' },
    ];

    var Ns = [];
    for (var i = 2; i <= 256; i = Math.round(i * 1.08) + 1) Ns.push(i);

    configs.forEach(function(cfg) {
      ctx.beginPath();
      ctx.strokeStyle = cfg.color;
      ctx.lineWidth = 2;
      var first = true;
      Ns.forEach(function(N) {
        var s = speedup(cfg.alpha, N, c);
        var x = xPos(N);
        var y = yPos(s);
        if (first) { ctx.moveTo(x, y); first = false; }
        else ctx.lineTo(x, y);
      });
      ctx.stroke();

      // label at end
      var s2 = speedup(cfg.alpha, 256, c);
      ctx.fillStyle = cfg.color;
      ctx.font = '9px var(--ff-mono, monospace)';
      ctx.textAlign = 'right';
      ctx.fillText('α=' + cfg.alpha, xPos(256) - 5, yPos(s2) - 6);
    });

    // annotation
    ctx.fillStyle = c < 0.001 ? 'rgba(16,185,129,.8)' : 'rgba(245,158,11,.8)';
    ctx.font = '10px var(--ff-mono, monospace)';
    ctx.textAlign = 'left';
    ctx.fillText(c < 0.001 ? 'ultra-low cost — speedup scales!' : 'typical AR cost — hits wall at N≈32', pad.l + 6, pad.t + 16);
  }

  window.setCost = function(c) {
    currentC = c;
    document.getElementById('btn-c-typical').classList.toggle('active', c === 0.05);
    document.getElementById('btn-c-low').classList.toggle('active', c < 0.001);
    drawCeiling(c);
  };

  drawCeiling(currentC);
  window.addEventListener('resize', function() { drawCeiling(currentC); });
})();

// ── §02 Tree Comparison Canvas ──
(function() {
  var canvas = document.getElementById('tree-canvas');
  if (!canvas) return;
  var ctx = canvas.getContext('2d');
  var DPR = window.devicePixelRatio || 1;

  function drawTreeSide(cx, tokens, isConsistent, startY) {
    var nodeH = 48, nodeW = 88;
    var fillBase = isConsistent ? 'rgba(16,185,129,' : 'rgba(239,68,68,';
    var strokeBase = isConsistent ? '#10b981' : '#ef4444';
    var textBase = isConsistent ? '#6ee7b7' : '#fca5a5';
    var opacities = ['.25)', '.2)', '.15)', '.1)'];

    tokens.forEach(function(tok, i) {
      var y = startY + i * nodeH;
      if (i > 0) {
        ctx.strokeStyle = isConsistent ? 'rgba(16,185,129,.4)' : 'rgba(239,68,68,.4)';
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.moveTo(cx, y - nodeH + 18);
        ctx.lineTo(cx, y - 8);
        ctx.stroke();
      }
      ctx.fillStyle = fillBase + opacities[Math.min(i, opacities.length - 1)];
      ctx.strokeStyle = strokeBase;
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.rect(cx - nodeW/2, y - 8, nodeW, 28);
      ctx.fill(); ctx.stroke();
      ctx.fillStyle = textBase;
      ctx.font = 'bold 12px var(--ff-mono, monospace)';
      ctx.textAlign = 'center';
      ctx.fillText('"' + tok + '"', cx, y + 6);
    });
  }

  function resize() {
    var W = canvas.clientWidth;
    var H = 280;
    canvas.width  = W * DPR;
    canvas.height = H * DPR;
    ctx.setTransform(1, 0, 0, 1, 0, 0);
    ctx.scale(DPR, DPR);
    ctx.clearRect(0, 0, W, H);

    var mid = W / 2;
    var leftCx = mid * 0.45;
    var rightCx = mid + mid * 0.45;

    // divider
    ctx.strokeStyle = 'rgba(255,255,255,0.06)';
    ctx.lineWidth = 1;
    ctx.setLineDash([4, 4]);
    ctx.beginPath(); ctx.moveTo(mid, 0); ctx.lineTo(mid, H); ctx.stroke();
    ctx.setLineDash([]);

    // headers
    ctx.font = 'bold 11px var(--ff-mono, monospace)';
    ctx.textAlign = 'center';
    ctx.fillStyle = '#f87171';
    ctx.fillText('DFlash (branch-agnostic)', leftCx, 16);
    ctx.fillStyle = '#10b981';
    ctx.fillText('JetSpec (causal)', rightCx, 16);

    // rank labels
    ctx.font = 'bold 11px var(--ff-mono, monospace)';
    ctx.fillStyle = '#ef4444';
    ctx.textAlign = 'center';
    ctx.fillText('rank #1', leftCx, 30);
    ctx.fillStyle = '#10b981';
    ctx.fillText('rank #1', rightCx, 30);

    var startY = 50;
    drawTreeSide(leftCx,  ['the', 'given', 'told', 'that'], false, startY);
    drawTreeSide(rightCx, ['are', 'told', 'that'], true, startY);

    // scores at bottom
    var dflashY = startY + 4 * 48 + 10;
    var jetspecY = startY + 3 * 48 + 10;

    ctx.font = '9px var(--ff-mono, monospace)';
    ctx.textAlign = 'center';
    ctx.fillStyle = 'rgba(107,114,128,.6)';
    ctx.fillText('surrogate: −3.76 nats', leftCx, dflashY);
    ctx.fillStyle = '#f87171';
    ctx.fillText('target: −63.32 nats', leftCx, dflashY + 14);
    ctx.fillText('gap: −59.56 nats', leftCx, dflashY + 28);
    ctx.fillStyle = 'rgba(239,68,68,.18)';
    ctx.strokeStyle = 'rgba(239,68,68,.4)';
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.rect(leftCx - 44, dflashY + 36, 88, 22); ctx.fill(); ctx.stroke();
    ctx.fillStyle = '#fca5a5';
    ctx.font = 'bold 10px var(--ff-mono, monospace)';
    ctx.fillText('✓ 4 tokens accepted', leftCx, dflashY + 51);

    ctx.font = '9px var(--ff-mono, monospace)';
    ctx.fillStyle = 'rgba(107,114,128,.6)';
    ctx.fillText('surrogate: −0.42 nats', rightCx, jetspecY);
    ctx.fillStyle = '#6ee7b7';
    ctx.fillText('target: −0.08 nats', rightCx, jetspecY + 14);
    ctx.fillText('gap: −0.34 nats', rightCx, jetspecY + 28);
    ctx.fillStyle = 'rgba(16,185,129,.18)';
    ctx.strokeStyle = 'rgba(16,185,129,.4)';
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.rect(rightCx - 44, jetspecY + 36, 88, 22); ctx.fill(); ctx.stroke();
    ctx.fillStyle = '#6ee7b7';
    ctx.font = 'bold 10px var(--ff-mono, monospace)';
    ctx.fillText('✓ 6 tokens accepted', rightCx, jetspecY + 51);
  }

  resize();
  window.addEventListener('resize', resize);
})();

// ── §04 Causality slider canvas ──
(function() {
  var canvas = document.getElementById('causality-canvas');
  if (!canvas) return;
  var ctx = canvas.getContext('2d');
  var DPR = window.devicePixelRatio || 1;
  var slider = document.getElementById('verify-slider');
  var label  = document.getElementById('verify-label');

  var dflashTokens  = ['the', 'given', 'told', 'that'];
  var jetspecTokens = ['are', 'told', 'that'];

  function drawSide(cx, tokens, step, isConsistent) {
    var tokenW = 62, tokenH = 28, gap = 8;
    var totalW = tokens.length * tokenW + (tokens.length - 1) * gap;
    var startX = cx - totalW / 2;
    var y = 90;

    tokens.forEach(function(tok, i) {
      var x = startX + i * (tokenW + gap);
      var verified = (i < step);
      // For DFlash: only first token might be accepted; for JetSpec: all 3
      var accepted = isConsistent ? verified : (i === 0 && verified);
      var fill, stroke, textCol;
      if (verified) {
        if (accepted) {
          fill = 'rgba(16,185,129,.2)'; stroke = '#10b981'; textCol = '#6ee7b7';
        } else {
          fill = 'rgba(239,68,68,.2)'; stroke = '#ef4444'; textCol = '#fca5a5';
        }
      } else {
        fill = 'rgba(107,114,128,.1)'; stroke = 'rgba(107,114,128,.3)'; textCol = 'rgba(107,114,128,.6)';
      }
      ctx.fillStyle = fill; ctx.strokeStyle = stroke; ctx.lineWidth = 1;
      ctx.beginPath(); ctx.rect(x, y, tokenW, tokenH); ctx.fill(); ctx.stroke();
      ctx.fillStyle = textCol;
      ctx.font = 'bold 11px var(--ff-mono, monospace)';
      ctx.textAlign = 'center';
      ctx.fillText('"' + tok + '"', x + tokenW/2, y + 18);
      if (verified) {
        ctx.font = 'bold 12px monospace';
        ctx.fillStyle = accepted ? '#10b981' : '#ef4444';
        ctx.fillText(accepted ? '✓' : '✗', x + tokenW/2, y - 6);
      }
    });
    // result
    if (step > 0) {
      var count = isConsistent ? Math.min(step, tokens.length) : Math.min(step, 1);
      ctx.fillStyle = isConsistent ? '#10b981' : '#ef4444';
      ctx.font = 'bold 10px var(--ff-mono, monospace)';
      ctx.textAlign = 'center';
      ctx.fillText(count + ' accepted', cx, y + tokenH + 18);
    }
  }

  function draw(step) {
    var W = canvas.clientWidth;
    var H = 240;
    canvas.width  = W * DPR;
    canvas.height = H * DPR;
    ctx.setTransform(1, 0, 0, 1, 0, 0);
    ctx.scale(DPR, DPR);
    ctx.clearRect(0, 0, W, H);

    var mid = W / 2;

    // divider
    ctx.strokeStyle = 'rgba(255,255,255,0.05)';
    ctx.lineWidth = 1;
    ctx.setLineDash([4, 4]);
    ctx.beginPath(); ctx.moveTo(mid, 20); ctx.lineTo(mid, H - 20); ctx.stroke();
    ctx.setLineDash([]);

    // headers
    ctx.font = 'bold 11px var(--ff-mono, monospace)';
    ctx.textAlign = 'center';
    ctx.fillStyle = '#f87171';
    ctx.fillText('DFlash rank-1: "the given told that"', mid * 0.5, 22);
    ctx.fillStyle = '#10b981';
    ctx.fillText('JetSpec rank-1: "are told that"', mid + mid * 0.5, 22);

    // score rows
    var scoreRows = [
      ['surrogate:', '−3.76', '−0.42'],
      ['target:',    '−63.32', '−0.08'],
      ['gap:',       '−59.56', '−0.34'],
    ];
    scoreRows.forEach(function(row, ri) {
      var sy = 40 + ri * 18;
      ctx.fillStyle = 'rgba(107,114,128,.6)';
      ctx.font = '9px var(--ff-mono, monospace)';
      ctx.textAlign = 'right';
      ctx.fillText(row[0], mid - 55, sy);
      ctx.fillStyle = ri === 2 ? '#f87171' : 'rgba(248,113,113,.8)';
      ctx.textAlign = 'center';
      ctx.fillText(row[1], mid - 22, sy);
      ctx.fillStyle = ri === 2 ? '#10b981' : 'rgba(16,185,129,.8)';
      ctx.fillText(row[2], mid + mid - 55, sy);
    });

    drawSide(mid * 0.5,      dflashTokens,  step, false);
    drawSide(mid + mid * 0.5, jetspecTokens, step, true);

    ctx.fillStyle = 'rgba(107,114,128,.5)';
    ctx.font = '9px var(--ff-mono, monospace)';
    ctx.textAlign = 'center';
    ctx.fillText('target model verifying tokens left → right', W / 2, H - 10);
  }

  slider?.addEventListener('input', function() {
    var v = parseInt(slider.value);
    label.textContent = 'step ' + v;
    draw(v);
  });

  draw(0);
  window.addEventListener('resize', function() { draw(parseInt(slider ? slider.value : 0)); });
})();

// ── §05 Budget Scaling Line Chart ──
(function() {
  var canvas = document.getElementById('scaling-canvas');
  if (!canvas) return;
  var ctx = canvas.getContext('2d');
  var DPR = window.devicePixelRatio || 1;
  var highlight = 'all';

  var data = {
    eagle:   [[16, 3.61], [32, 3.87], [64, 4.13]],
    ddtree:  [[64, 6.51], [128, 8.27], [256, 8.78]],
    jetspec: [[16, 6.06], [32, 6.35], [64, 6.76], [128, 8.93], [256, 9.64]],
    dflash:  [[16, 6.12], [32, 5.39]],
  };

  var colors = {
    eagle:   '#6b7280',
    ddtree:  '#06b6d4',
    jetspec: '#8b5cf6',
    dflash:  'rgba(245,158,11,.7)',
  };

  var lineLabels = {
    eagle:   'EAGLE-3',
    ddtree:  'DDTree',
    jetspec: 'JetSpec',
    dflash:  'DFlash',
  };

  function drawScaling() {
    var W = canvas.clientWidth;
    var H = 280;
    canvas.width  = W * DPR;
    canvas.height = H * DPR;
    ctx.setTransform(1, 0, 0, 1, 0, 0);
    ctx.scale(DPR, DPR);
    ctx.clearRect(0, 0, W, H);

    var pad = { l: 52, r: 100, t: 24, b: 40 };
    var cW = W - pad.l - pad.r;
    var cH = H - pad.t - pad.b;
    var xMin = Math.log2(16), xMax = Math.log2(256);

    function xPos(N) { return pad.l + (Math.log2(N) - xMin) / (xMax - xMin) * cW; }
    function yPos(s) { return pad.t + cH - Math.min(s, 11) / 11 * cH; }

    // grid
    [0,2,4,6,8,10].forEach(function(y) {
      ctx.strokeStyle = 'rgba(255,255,255,0.04)';
      ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(pad.l, yPos(y)); ctx.lineTo(pad.l + cW, yPos(y)); ctx.stroke();
    });
    [16, 32, 64, 128, 256].forEach(function(N) {
      ctx.beginPath(); ctx.moveTo(xPos(N), pad.t); ctx.lineTo(xPos(N), pad.t + cH); ctx.stroke();
    });

    // axes
    ctx.strokeStyle = 'rgba(255,255,255,0.12)';
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(pad.l, pad.t); ctx.lineTo(pad.l, pad.t + cH); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(pad.l, pad.t + cH); ctx.lineTo(pad.l + cW, pad.t + cH); ctx.stroke();

    // axis labels
    ctx.fillStyle = 'rgba(107,114,128,.6)';
    ctx.font = '9px var(--ff-mono, monospace)';
    ctx.textAlign = 'right';
    [0,2,4,6,8,10].forEach(function(y) { ctx.fillText(y + '×', pad.l - 6, yPos(y) + 4); });
    ctx.textAlign = 'center';
    [16, 32, 64, 128, 256].forEach(function(N) { ctx.fillText(N, xPos(N), pad.t + cH + 16); });
    ctx.fillText('draft budget', pad.l + cW / 2, pad.t + cH + 32);

    // draw lines
    Object.keys(data).forEach(function(key) {
      var pts = data[key];
      var alpha = (highlight === 'all' || highlight === key) ? 1 : 0.15;
      var color = colors[key];
      ctx.globalAlpha = alpha;
      ctx.strokeStyle = color;
      ctx.lineWidth = key === 'jetspec' ? 2.5 : 1.5;
      ctx.setLineDash(key === 'eagle' ? [5, 3] : key === 'dflash' ? [3, 3] : []);
      ctx.beginPath();
      pts.forEach(function(pt, i) {
        if (i === 0) ctx.moveTo(xPos(pt[0]), yPos(pt[1]));
        else ctx.lineTo(xPos(pt[0]), yPos(pt[1]));
      });
      ctx.stroke();
      ctx.setLineDash([]);

      // dots
      ctx.fillStyle = color;
      pts.forEach(function(pt) {
        ctx.beginPath();
        ctx.arc(xPos(pt[0]), yPos(pt[1]), key === 'jetspec' ? 4 : 3, 0, Math.PI * 2);
        ctx.fill();
      });

      // label at last point
      var last = pts[pts.length - 1];
      ctx.fillStyle = color;
      ctx.font = '9px var(--ff-mono, monospace)';
      ctx.textAlign = 'left';
      ctx.fillText(lineLabels[key], xPos(last[0]) + 8, yPos(last[1]) + 4);

      ctx.globalAlpha = 1;
    });

    // annotate JetSpec peak
    if (highlight === 'all' || highlight === 'jetspec') {
      ctx.fillStyle = 'rgba(139,92,246,.2)';
      ctx.strokeStyle = '#8b5cf6';
      ctx.lineWidth = 1;
      ctx.beginPath(); ctx.arc(xPos(256), yPos(9.64), 8, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
      ctx.fillStyle = '#a78bfa';
      ctx.font = 'bold 9px var(--ff-mono, monospace)';
      ctx.textAlign = 'center';
      ctx.fillText('9.64×', xPos(256), yPos(9.64) - 13);
    }
  }

  window.setChartHL = function(key) {
    highlight = key;
    ['eagle','ddtree','jetspec','all'].forEach(function(k) {
      var el = document.getElementById('leg-' + k);
      if (el) el.classList.toggle('active', k === key || key === 'all');
    });
    drawScaling();
  };

  drawScaling();
  window.addEventListener('resize', drawScaling);
})();

// ── §06 Animated bar chart ──
(function() {
  var barsSection = document.getElementById('s-results');
  if (!barsSection) return;
  new IntersectionObserver(function(entries) {
    entries.forEach(function(e) {
      if (e.isIntersecting) {
        document.querySelectorAll('#results-bars .bar-fill[data-w]').forEach(function(b) {
          b.style.width = b.dataset.w + '%';
        });
      }
    });
  }, { threshold: 0.3 }).observe(barsSection);
})();
</script>

<span class="cs-line cmt"># Today: N agents, one document.</span>
<span class="cs-line cmt"># Each one re-prefills the SAME text.</span>
<span class="cs-line"></span>
<span class="cs-line hl-a"><span class="kw">for</span> agent <span class="kw">in</span> agents:           <span class="cmt"># N readers</span></span>
<span class="cs-line hl-a">    kv = model.<span class="fn">prefill</span>(doc) <span class="cmt"># identical work</span></span>
<span class="cs-line hl-a">    agent.<span class="fn">answer</span>(kv, query)</span>
<span class="cs-line cmt"># total compute = N * C_prefill</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Prefill CDN: compute it ONCE.</span>
<span class="cs-line hl-g">kv = publisher.<span class="fn">prefill</span>(doc)      <span class="cmt"># 1x</span></span>
<span class="cs-line hl-g"><span class="kw">for</span> agent <span class="kw">in</span> agents:</span>
<span class="cs-line hl-g">    agent.<span class="fn">answer</span>(<span class="fn">load</span>(kv), query)</span>
<span class="cs-line cmt"># total = C_prefill + N * C_load</span>
      </pre>
    </div>
    <div class="cs-panel" id="panel-prefill">
      <pre class="cs-pre">
<span class="cs-line cmt"># Prefill cost has two terms in L:</span>
<span class="cs-line">  dense_proj  <span class="op">~</span> O(L)     <span class="cmt"># linear</span></span>
<span class="cs-line hl-p">  attention   <span class="op">~</span> O(L<span class="op">^</span><span class="num">2</span>)   <span class="cmt"># quadratic !</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Qwen3-4B, fp16, M1 Pro / MPS (Table 1)</span>
<span class="cs-line cmt"># tokens  prefill   reuse    speedup</span>
<span class="cs-line">  <span class="num">255</span>     <span class="num">0.67</span>s    <span class="num">0.078</span>s    <span class="num">8.6</span>x</span>
<span class="cs-line">  <span class="num">945</span>     <span class="num">2.65</span>s    <span class="num">0.122</span>s   <span class="num">21.7</span>x</span>
<span class="cs-line">  <span class="num">1888</span>    <span class="num">5.81</span>s    <span class="num">0.179</span>s   <span class="num">32.4</span>x</span>
<span class="cs-line hl-c">  <span class="num">3774</span>   <span class="num">14.71</span>s    <span class="num">0.296</span>s   <span class="num">49.7</span>x</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># KV size ~ 0.148 MB / token (linear)</span>
<span class="cs-line cmt"># 3774 tok -> 557 MB artifact</span>
      </pre>
    </div>
    <div class="cs-panel" id="panel-exact">
      <pre class="cs-pre">
<span class="cs-line cmt"># Algorithm 1: SaveKV (publisher, once)</span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">save_kv</span>(c, model):</span>
<span class="cs-line hl-p">    K = model.<span class="fn">forward</span>(c, use_cache=<span class="kw">True</span>)</span>
<span class="cs-line hl-p">    <span class="kw">return</span> <span class="fn">serialize</span>(K, m=(model, dtype, L))</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Algorithm 2: GenerateFromKV (agent)</span>
<span class="cs-line hl-g"><span class="kw">def</span> <span class="fn">gen_from_kv</span>(a, q, n):</span>
<span class="cs-line hl-g">    K, m = <span class="fn">deserialize</span>(a)</span>
<span class="cs-line hl-g">    <span class="kw">assert</span> m.model == self.model   <span class="cmt"># reject mismatch</span></span>
<span class="cs-line hl-g">    cur, start, y = q, m.L, []</span>
<span class="cs-line hl-g">    <span class="kw">for</span> t <span class="kw">in</span> <span class="fn">range</span>(n):</span>
<span class="cs-line hl-c">        pos  = [start, ..., start+<span class="fn">len</span>(cur)-<span class="num">1</span>]  <span class="cmt"># detail 1</span></span>
<span class="cs-line hl-c">        mask = <span class="fn">ones</span>(start + <span class="fn">len</span>(cur))      <span class="cmt"># detail 2</span></span>
<span class="cs-line hl-g">        o = model(cur, K, pos, mask)</span>
<span class="cs-line hl-g">        y_t = <span class="fn">argmax</span>(o.logits[-<span class="num">1</span>])</span>
<span class="cs-line hl-g">        K, cur, start = o.cache, [y_t], start+<span class="fn">len</span>(cur)</span>
<span class="cs-line cmt"># Result: 24/24 token match, max |dlogit| = 0.02</span>
      </pre>
    </div>
    <div class="cs-panel" id="panel-cost">
      <pre class="cs-pre">
<span class="cs-line cmt"># Per-call cost over N reuses</span>
<span class="cs-line">from_scratch = C_prefill            <span class="cmt"># flat</span></span>
<span class="cs-line hl-g">kv_reuse     = C_prefill / N + C_load</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Break-even reuse count</span>
<span class="cs-line hl-p">N_star = C_prefill / (C_prefill - C_load)</span>
<span class="cs-line cmt"># C_load &lt;&lt; C_prefill  =&gt;  N_star -&gt; 1</span>
<span class="cs-line cmt"># measured range: N_star in [1.02, 1.13]</span>
<span class="cs-line cmt"># => reuse wins by the SECOND read</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Absolute saving grows with N and L:</span>
<span class="cs-line hl-c">saved(N) = N * (C_prefill - C_load)</span>
<span class="cs-line cmt"># N=1000, 3774 tok  ->  ~1.4e4 s saved</span>
      </pre>
    </div>
    <div class="cs-panel" id="panel-host">
      <pre class="cs-pre">
<span class="cs-line cmt"># Storage-aware total over N loads</span>
<span class="cs-line cmt"># s = artifact bytes, sigma = storage/byte/time</span>
<span class="cs-line cmt"># beta = transfer cost / byte (per load)</span>
<span class="cs-line hl-p">total(N) = C_prefill + sigma*s*T \</span>
<span class="cs-line hl-p">         + N * (C_load + beta*s)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># SHIP: pay egress beta*s every load</span>
<span class="cs-line hl-a">egress = 0.54 GB * $0.09/GB = $0.049</span>
<span class="cs-line hl-a">prefill_saved          = $0.019</span>
<span class="cs-line hl-a"># 2.6x more to ship than to prefill -> LOSES</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># HOST: beta = 0 (cache never leaves DC)</span>
<span class="cs-line hl-g">floor -&gt; C_load + sigma*s*T/N  (-&gt; C_load)</span>
      </pre>
    </div>
    <div class="cs-panel" id="panel-market">
      <pre class="cs-pre">
<span class="cs-line cmt"># Serve 1 hot 3774-tok doc to 80M agents</span>
<span class="cs-line cmt"># (Table 2)</span>
<span class="cs-line">  re-prefill (today)   $1,509,600   <span class="num">1.0</span>x</span>
<span class="cs-line hl-a">  ship raw fp16        $3.9M        <span class="num">0.4</span>x  loses</span>
<span class="cs-line hl-a">  ship int8 (lossy)    $2.0M        <span class="num">0.8</span>x  loses</span>
<span class="cs-line hl-p">  host, priced         $150,960    <span class="num">10.0</span>x</span>
<span class="cs-line hl-g">  host, physical       $30,370     <span class="num">49.7</span>x</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># priced 10x = floor grounded in physics</span>
<span class="cs-line cmt"># physical ~50x = ceiling (measured)</span>
<span class="cs-line hl-c"># gap (10x -> 50x) = PROVIDER MARGIN</span>
<span class="cs-line cmt"># millions of $ per popular document</span>
      </pre>
    </div>
  </div>
</aside>

</div><!-- /post-grid -->

<script>
// ── TOC + sidebar toggles ─────────────────────────────────
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});
const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ── Code sidebar tab switching ────────────────────────────
const tabMeta = {
  intro:   { file: 'the_waste.py',        title: 'The Problem' },
  prefill: { file: 'prefill_cost.py',     title: 'Prefill Is Expensive' },
  exact:   { file: 'generate_from_kv.py', title: 'Token-Exact Reuse' },
  cost:    { file: 'cost_model.py',       title: 'Break-Even' },
  host:    { file: 'ship_vs_host.py',     title: 'Where KV Lives' },
  market:  { file: 'market.py',           title: 'The Prefill CDN' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ── IntersectionObserver: sync TOC + tab on scroll ────────
const sectionMap = { 's-intro':'intro','s-prefill':'prefill','s-exact':'exact','s-cost':'cost','s-host':'host','s-market':'market' };
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ── Shared Table 1 data ───────────────────────────────────
const LEN     = [255, 485, 945, 1888, 3774];
const PREFILL = [0.67, 1.29, 2.65, 5.81, 14.71];
const REUSE   = [0.078, 0.093, 0.122, 0.179, 0.296];
const SPEEDUP = [8.6, 13.9, 21.7, 32.4, 49.7];
const DPR = window.devicePixelRatio || 1;
function fitCanvas(cv, h) {
  const w = cv.clientWidth;
  cv.width = w * DPR; cv.height = h * DPR;
  const ctx = cv.getContext('2d');
  ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
  return { ctx, W: w, H: h };
}

// ══ 01 — The Waste canvas ═════════════════════════════════
(function () {
  const cv = document.getElementById('waste-canvas');
  if (!cv) return;
  let mode = 'naive';      // 'naive' | 'cdn'
  let served = 0;
  let raf = null;
  const TOTAL = 50, COLS = 10, ROWS = 5;
  const servedEl = document.getElementById('waste-served');
  const prefEl   = document.getElementById('waste-prefills');
  const compEl   = document.getElementById('waste-compute');

  function draw() {
    const { ctx, W, H } = fitCanvas(cv, 300);
    ctx.clearRect(0, 0, W, H);
    // document box (left)
    const docX = 28, docY = H/2 - 46, docW = 78, docH = 92;
    ctx.fillStyle = '#1a1a2e'; ctx.strokeStyle = '#3a3a52'; ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.roundRect(docX, docY, docW, docH, 8); ctx.fill(); ctx.stroke();
    ctx.fillStyle = '#06b6d4'; ctx.font = '700 11px monospace'; ctx.textAlign = 'center';
    ctx.fillText('document', docX + docW/2, docY - 10);
    for (let i = 0; i < 6; i++) { ctx.fillStyle = 'rgba(255,255,255,.16)'; ctx.fillRect(docX+12, docY+14+i*12, docW-24, 4); }
    // publisher badge in CDN mode
    if (mode === 'cdn') {
      ctx.fillStyle = served > 0 ? '#ef4444' : '#5c6370';
      ctx.font = '600 9px monospace'; ctx.textAlign = 'center';
      ctx.fillText('prefilled 1×', docX + docW/2, docY + docH + 18);
    }
    // grid of agents (right)
    const gx = 150, gy = 36, cw = (W - gx - 24) / COLS, ch = (H - gy - 20) / ROWS;
    let prefills = (mode === 'cdn') ? (served > 0 ? 1 : 0) : 0;
    for (let i = 0; i < TOTAL; i++) {
      const r = Math.floor(i / COLS), c = i % COLS;
      const x = gx + c * cw + cw/2, y = gy + r * ch + ch/2;
      const on = i < served;
      let col = '#2a2a40';
      if (on) {
        if (mode === 'naive') { col = '#ef4444'; prefills++; }
        else col = '#10b981';
      }
      ctx.fillStyle = col;
      ctx.beginPath(); ctx.arc(x, y, 8, 0, Math.PI*2); ctx.fill();
      if (on) {
        // line back to doc
        ctx.strokeStyle = mode === 'naive' ? 'rgba(239,68,68,.18)' : 'rgba(16,185,129,.16)';
        ctx.lineWidth = 1;
        ctx.beginPath(); ctx.moveTo(docX+docW, docY+docH/2); ctx.lineTo(x-8, y); ctx.stroke();
      }
    }
    ctx.fillStyle = '#6b7280'; ctx.font = '600 10px monospace'; ctx.textAlign = 'left';
    ctx.fillText(mode === 'naive' ? '50 agents · each re-prefills (red)' : '50 agents · each loads cheap (green)', gx, 22);
    // readouts
    servedEl.textContent = served;
    prefEl.textContent = prefills;
    prefEl.style.color = (mode === 'naive' && prefills > 1) ? '#f87171' : (mode === 'cdn' ? '#10b981' : '#f0f0f8');
    const compute = mode === 'naive' ? served : (served > 0 ? 1 + served * 0.025 : 0);
    compEl.textContent = compute.toFixed(mode === 'naive' ? 0 : 1) + '×';
  }
  function play() {
    served = 0; if (raf) cancelAnimationFrame(raf);
    let last = 0;
    function step(ts) {
      if (!last) last = ts;
      if (ts - last > 55 && served < TOTAL) { served++; last = ts; draw(); }
      if (served < TOTAL) raf = requestAnimationFrame(step);
    }
    raf = requestAnimationFrame(step);
  }
  document.getElementById('waste-naive').addEventListener('click', e => {
    mode = 'naive'; e.target.classList.add('active');
    document.getElementById('waste-cdn').classList.remove('active'); draw();
  });
  document.getElementById('waste-cdn').addEventListener('click', e => {
    mode = 'cdn'; e.target.classList.add('active');
    document.getElementById('waste-naive').classList.remove('active'); draw();
  });
  document.getElementById('waste-play').addEventListener('click', play);
  served = TOTAL; draw();
  new IntersectionObserver((es, obs) => {
    es.forEach(e => { if (e.isIntersecting) { play(); obs.disconnect(); } });
  }, { threshold: 0.4 }).observe(cv);
  window.addEventListener('resize', draw);
})();

// ══ 02 — Cost vs length canvas ════════════════════════════
(function () {
  const cv = document.getElementById('length-canvas');
  if (!cv) return;
  let hover = -1;
  function draw() {
    const { ctx, W, H } = fitCanvas(cv, 340);
    ctx.clearRect(0, 0, W, H);
    const padL = 56, padR = 24, padT = 28, padB = 46;
    const plotW = W - padL - padR, plotH = H - padT - padB;
    const maxY = 16;
    const xOf = i => padL + (i / (LEN.length - 1)) * plotW;
    const yOf = v => padT + plotH - (v / maxY) * plotH;
    // grid
    ctx.strokeStyle = 'rgba(255,255,255,0.05)'; ctx.lineWidth = 1;
    for (let g = 0; g <= 4; g++) { const y = padT + (g/4)*plotH; ctx.beginPath(); ctx.moveTo(padL, y); ctx.lineTo(W-padR, y); ctx.stroke();
      ctx.fillStyle = '#5c6370'; ctx.font = '10px monospace'; ctx.textAlign = 'right'; ctx.fillText((maxY*(1-g/4)).toFixed(0)+'s', padL-8, y+3); }
    // x labels
    ctx.textAlign = 'center'; ctx.fillStyle = '#6b7280'; ctx.font = '10px monospace';
    LEN.forEach((l, i) => ctx.fillText(l, xOf(i), H - padB + 18));
    ctx.fillText('context length (tokens)', padL + plotW/2, H - 8);
    // prefill line (red/amber)
    ctx.strokeStyle = '#f59e0b'; ctx.lineWidth = 2.5; ctx.beginPath();
    LEN.forEach((l, i) => { const x = xOf(i), y = yOf(PREFILL[i]); i ? ctx.lineTo(x, y) : ctx.moveTo(x, y); }); ctx.stroke();
    // reuse line (green)
    ctx.strokeStyle = '#10b981'; ctx.lineWidth = 2.5; ctx.beginPath();
    LEN.forEach((l, i) => { const x = xOf(i), y = yOf(REUSE[i]); i ? ctx.lineTo(x, y) : ctx.moveTo(x, y); }); ctx.stroke();
    // points + speedup labels
    LEN.forEach((l, i) => {
      const xp = xOf(i), yp = yOf(PREFILL[i]), yr = yOf(REUSE[i]);
      ctx.fillStyle = '#f59e0b'; ctx.beginPath(); ctx.arc(xp, yp, i === hover ? 6 : 4, 0, Math.PI*2); ctx.fill();
      ctx.fillStyle = '#10b981'; ctx.beginPath(); ctx.arc(xp, yr, i === hover ? 6 : 4, 0, Math.PI*2); ctx.fill();
      ctx.fillStyle = '#06b6d4'; ctx.font = '700 11px monospace'; ctx.textAlign = 'center';
      ctx.fillText(SPEEDUP[i] + '×', xp, yp - 12);
    });
    // legend
    ctx.textAlign = 'left'; ctx.font = '600 11px monospace';
    ctx.fillStyle = '#f59e0b'; ctx.fillText('● prefill (O(L²))', W - padR - 150, padT + 6);
    ctx.fillStyle = '#10b981'; ctx.fillText('● reuse step', W - padR - 150, padT + 22);
    if (hover >= 0) {
      ctx.fillStyle = '#abb2bf'; ctx.font = '700 11px monospace'; ctx.textAlign = 'center';
      ctx.fillText(`${PREFILL[hover]}s vs ${REUSE[hover]}s`, xOf(hover), yOf(REUSE[hover]) + 22);
    }
  }
  cv.addEventListener('mousemove', e => {
    const r = cv.getBoundingClientRect();
    const x = e.clientX - r.left;
    const padL = 56, padR = 24, plotW = cv.clientWidth - padL - padR;
    let best = -1, bd = 1e9;
    LEN.forEach((l, i) => { const xo = padL + (i/(LEN.length-1))*plotW; const d = Math.abs(xo - x); if (d < bd) { bd = d; best = i; } });
    hover = bd < 40 ? best : -1; draw();
  });
  cv.addEventListener('mouseleave', () => { hover = -1; draw(); });
  draw();
  window.addEventListener('resize', draw);
})();

// ══ 03 — Step navigator ═══════════════════════════════════
(function () {
  let step = 0;
  const boxes = document.querySelectorAll('#exact-steps .step-box');
  if (!boxes.length) return;
  const prevBtn = document.getElementById('exact-prev');
  const nextBtn = document.getElementById('exact-next');
  const progEl  = document.getElementById('exact-prog');
  function update() {
    boxes.forEach((b, i) => {
      b.classList.remove('active', 'done');
      if (i === step) b.classList.add('active'); else if (i < step) b.classList.add('done');
      const n = b.querySelector('.step-num'); if (n) n.textContent = i < step ? '✓' : String(i+1);
    });
    prevBtn.disabled = step === 0; nextBtn.disabled = step === boxes.length - 1;
    progEl.textContent = `Step ${step+1} of ${boxes.length}`;
  }
  prevBtn.addEventListener('click', () => { if (step > 0) { step--; update(); } });
  nextBtn.addEventListener('click', () => { if (step < boxes.length-1) { step++; update(); } });
  boxes.forEach((b, i) => b.addEventListener('click', () => { step = i; update(); }));
  update();
})();

// ══ 04 — Break-even cost canvas ═══════════════════════════
(function () {
  const cv = document.getElementById('cost-canvas');
  if (!cv) return;
  let lenIdx = 4;          // 3774 default
  let nFrac = 0.40;        // slider position 0..1 maps to N on log scale
  const nVal = document.getElementById('cost-n-val');
  const flatEl = document.getElementById('cost-flat');
  const amortEl = document.getElementById('cost-amort');
  const ratioEl = document.getElementById('cost-ratio');
  const savedEl = document.getElementById('cost-saved');
  const Nmax = 1000;
  function sliderToN(f) { return Math.max(1, Math.round(Math.pow(10, f * Math.log10(Nmax)))); }

  function draw() {
    const { ctx, W, H } = fitCanvas(cv, 360);
    ctx.clearRect(0, 0, W, H);
    const Cp = PREFILL[lenIdx], Cl = REUSE[lenIdx];
    const padL = 58, padR = 22, padT = 24, padB = 46;
    const plotW = W - padL - padR, plotH = H - padT - padB;
    const maxY = Cp * 1.12;
    // log-x from 1..Nmax
    const xOf = n => padL + (Math.log10(n) / Math.log10(Nmax)) * plotW;
    const yOf = v => padT + plotH - (v / maxY) * plotH;
    // grid + y labels
    ctx.strokeStyle = 'rgba(255,255,255,0.05)'; ctx.lineWidth = 1;
    for (let g = 0; g <= 4; g++) { const y = padT + (g/4)*plotH; ctx.beginPath(); ctx.moveTo(padL, y); ctx.lineTo(W-padR, y); ctx.stroke();
      ctx.fillStyle = '#5c6370'; ctx.font = '10px monospace'; ctx.textAlign = 'right'; ctx.fillText((maxY*(1-g/4)).toFixed(1)+'s', padL-8, y+3); }
    // x ticks (1,10,100,1000)
    ctx.textAlign = 'center'; ctx.fillStyle = '#6b7280'; ctx.font = '10px monospace';
    [1,10,100,1000].forEach(n => ctx.fillText(n, xOf(n), H - padB + 18));
    ctx.fillText('reuse count  N  (log scale)', padL + plotW/2, H - 8);
    // flat from-scratch line
    ctx.strokeStyle = '#6b7280'; ctx.lineWidth = 2; ctx.setLineDash([6,4]); ctx.beginPath();
    ctx.moveTo(xOf(1), yOf(Cp)); ctx.lineTo(xOf(Nmax), yOf(Cp)); ctx.stroke(); ctx.setLineDash([]);
    ctx.fillStyle = '#9ca3af'; ctx.font = '600 10px monospace'; ctx.textAlign = 'left';
    ctx.fillText('re-prefill = C_prefill', xOf(1.3), yOf(Cp) - 8);
    // KV reuse curve
    ctx.strokeStyle = '#10b981'; ctx.lineWidth = 2.6; ctx.beginPath();
    for (let px = 0; px <= plotW; px += 2) {
      const n = Math.pow(10, (px/plotW) * Math.log10(Nmax));
      const v = Cp / n + Cl; const x = padL + px, y = yOf(v);
      px ? ctx.lineTo(x, y) : ctx.moveTo(x, y);
    }
    ctx.stroke();
    // floor line
    ctx.strokeStyle = 'rgba(16,185,129,.35)'; ctx.lineWidth = 1; ctx.setLineDash([3,3]); ctx.beginPath();
    ctx.moveTo(padL, yOf(Cl)); ctx.lineTo(W-padR, yOf(Cl)); ctx.stroke(); ctx.setLineDash([]);
    ctx.fillStyle = '#10b981'; ctx.font = '600 10px monospace'; ctx.textAlign = 'right';
    ctx.fillText('floor = C_load', W - padR - 4, yOf(Cl) - 6);
    // marker at current N
    const N = sliderToN(nFrac);
    const amort = Cp / N + Cl;
    const mx = xOf(N), my = yOf(amort);
    ctx.strokeStyle = 'rgba(6,182,212,.5)'; ctx.lineWidth = 1; ctx.setLineDash([4,4]);
    ctx.beginPath(); ctx.moveTo(mx, padT); ctx.lineTo(mx, H - padB); ctx.stroke(); ctx.setLineDash([]);
    ctx.fillStyle = '#06b6d4'; ctx.beginPath(); ctx.arc(mx, my, 6, 0, Math.PI*2); ctx.fill();
    ctx.fillStyle = '#6b7280'; ctx.beginPath(); ctx.arc(mx, yOf(Cp), 5, 0, Math.PI*2); ctx.fill();
    // break-even marker (N* ~ 1)
    ctx.fillStyle = '#8b5cf6'; ctx.font = '700 10px monospace'; ctx.textAlign = 'center';
    ctx.fillText('N*≈1', xOf(1.05), padT + 12);
    // readouts
    nVal.textContent = N;
    flatEl.textContent = Cp.toFixed(2) + ' s';
    amortEl.textContent = amort.toFixed(amort < 1 ? 3 : 2) + ' s';
    ratioEl.textContent = (Cp / amort).toFixed(Cp/amort >= 10 ? 0 : 1) + '×';
    const saved = N * (Cp - Cl);
    savedEl.textContent = saved >= 1000 ? (saved/1000).toFixed(1) + 'k s' : saved.toFixed(0) + ' s';
  }
  document.querySelectorAll('#s-cost .canvas-btn[data-len]').forEach(b => {
    b.addEventListener('click', () => {
      document.querySelectorAll('#s-cost .canvas-btn[data-len]').forEach(x => x.classList.remove('active'));
      b.classList.add('active');
      lenIdx = LEN.indexOf(parseInt(b.dataset.len)); draw();
    });
  });
  const slider = document.getElementById('cost-n');
  slider.addEventListener('input', () => { nFrac = slider.value / 100; draw(); });
  draw();
  window.addEventListener('resize', draw);
})();

// ══ 05 — Ship vs Host canvas ══════════════════════════════
(function () {
  const cv = document.getElementById('host-canvas');
  if (!cv) return;
  let t = 0, raf = null;
  function draw() {
    const { ctx, W, H } = fitCanvas(cv, 320);
    ctx.clearRect(0, 0, W, H);
    const midY = H / 2;
    // divider
    ctx.strokeStyle = 'rgba(255,255,255,0.07)'; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(20, midY); ctx.lineTo(W-20, midY); ctx.stroke();
    function provider(x, y, label, col) {
      ctx.fillStyle = '#1a1a2e'; ctx.strokeStyle = col; ctx.lineWidth = 1.5;
      ctx.beginPath(); ctx.roundRect(x, y-22, 96, 44, 7); ctx.fill(); ctx.stroke();
      ctx.fillStyle = col; ctx.font = '700 10px monospace'; ctx.textAlign = 'center';
      ctx.fillText('KV 0.54GB', x+48, y+4); ctx.fillText(label, x+48, y-30);
    }
    function agent(x, y, col) {
      ctx.fillStyle = col; ctx.beginPath(); ctx.arc(x, y, 11, 0, Math.PI*2); ctx.fill();
      ctx.fillStyle = '#0d0d14'; ctx.font = '700 9px monospace'; ctx.textAlign = 'center'; ctx.fillText('AI', x, y+3);
    }
    const phase = (t % 1);
    // ── SHIP (top) ──
    const ty = midY/2 + 6;
    provider(40, ty, 'provider', '#f87171');
    agent(W - 60, ty, '#f87171');
    // big artifact travelling
    const sx = 136 + phase * (W - 60 - 11 - 136 - 24);
    ctx.fillStyle = 'rgba(248,113,113,.85)';
    ctx.beginPath(); ctx.roundRect(sx, ty-9, 26, 18, 4); ctx.fill();
    ctx.fillStyle = '#fff'; ctx.font = '600 7px monospace'; ctx.textAlign = 'center'; ctx.fillText('540MB', sx+13, ty+3);
    ctx.fillStyle = '#f87171'; ctx.font = '700 12px monospace'; ctx.textAlign = 'left';
    ctx.fillText('SHIP  →  egress $0.049 / load  >  $0.019 prefill saved  ✗', 40, 22);
    // ── HOST (bottom) ──
    const hy = midY + midY/2 - 6;
    provider(40, hy, 'provider (KV stays)', '#10b981');
    agent(W - 60, hy, '#10b981');
    // tiny query goes left, answer comes right
    const qx = (W - 60 - 11) - phase * (W - 60 - 11 - 136);
    ctx.fillStyle = 'rgba(6,182,212,.9)';
    ctx.beginPath(); ctx.arc(qx, hy, 5, 0, Math.PI*2); ctx.fill();
    ctx.fillStyle = '#06b6d4'; ctx.font = '600 8px monospace'; ctx.textAlign = 'center'; ctx.fillText('query', qx, hy-12);
    ctx.fillStyle = '#10b981'; ctx.font = '700 12px monospace'; ctx.textAlign = 'left';
    ctx.fillText('HOST  →  no egress · billed a cache-read  ✓', 40, midY + 22);
    t += 0.006;
    raf = requestAnimationFrame(draw);
  }
  new IntersectionObserver(es => {
    es.forEach(e => {
      if (e.isIntersecting && !raf) raf = requestAnimationFrame(draw);
      else if (!e.isIntersecting && raf) { cancelAnimationFrame(raf); raf = null; }
    });
  }, { threshold: 0.2 }).observe(cv);
  window.addEventListener('resize', () => { if (!raf) draw(); });
})();

// ══ 06 — Animated market bars ═════════════════════════════
(function () {
  const sec = document.getElementById('s-market');
  if (!sec) return;
  new IntersectionObserver((es, obs) => {
    es.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('#market-bars .bar-fill').forEach(b => { b.style.width = b.dataset.w + '%'; });
        obs.disconnect();
      }
    });
  }, { threshold: 0.3 }).observe(sec);
})();
</script>
</BaseLayout>

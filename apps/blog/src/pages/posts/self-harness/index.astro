<script>
// ── TOC + sidebar toggles ──
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});
const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ── Code sidebar tab switching ──
const tabMeta = {
  problem:   { file: 'self_harness/harness.py',   title: 'The Harness Layer' },
  mining:    { file: 'self_harness/mining.py',     title: 'Weakness Mining' },
  loop:      { file: 'self_harness/algorithm.py',  title: 'Self-Harness Algorithm' },
  evolution: { file: 'self_harness/evolution.py',  title: 'Harness Evolution' },
  specific:  { file: 'self_harness/edits.py',      title: 'Model-Specific Edits' },
  results:   { file: 'self_harness/results.py',    title: 'Results' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ── IntersectionObserver — sync TOC + sidebar ──
const sectionMap = {
  's-problem':  'problem',
  's-mining':   'mining',
  's-loop':     'loop',
  's-evolution':'evolution',
  's-specific': 'specific',
  's-results':  'results',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ── Step navigator ──
let stepIdx = 0;
const stepBoxes = document.querySelectorAll('.step-box');
const prevBtn   = document.getElementById('step-prev');
const nextBtn   = document.getElementById('step-next');
const progEl    = document.getElementById('step-prog');
function updateSteps() {
  stepBoxes.forEach((b, i) => {
    b.classList.remove('active','done');
    if (i === stepIdx) b.classList.add('active');
    else if (i < stepIdx) b.classList.add('done');
    const n = b.querySelector('.step-num');
    if (n) n.textContent = i < stepIdx ? '✓' : String(i + 1);
  });
  if (prevBtn) prevBtn.disabled = stepIdx === 0;
  if (nextBtn) nextBtn.disabled = stepIdx === stepBoxes.length - 1;
  if (progEl) progEl.textContent = `Step ${stepIdx + 1} of ${stepBoxes.length}`;
}
prevBtn?.addEventListener('click', () => { if (stepIdx > 0) { stepIdx--; updateSteps(); } });
nextBtn?.addEventListener('click', () => { if (stepIdx < stepBoxes.length - 1) { stepIdx++; updateSteps(); } });
updateSteps();

// ── Cluster canvas ──
(function() {
  const canvas = document.getElementById('cluster-canvas');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth || 600;
  const H = 260;
  canvas.width  = W * DPR;
  canvas.height = H * DPR;
  const ctx = canvas.getContext('2d');
  ctx.scale(DPR, DPR);

  function seededRand(n) {
    return ((1664525 * n + 1013904223) & 0x7fffffff) / 0x7fffffff;
  }

  // 3 failure clusters
  const CLUSTERS = [
    { label: 'No Artifact',   cx: W * 0.22, cy: H * 0.5,  color: '#ef4444', dim: 'rgba(239,68,68,.25)' },
    { label: 'Tool Loop',     cx: W * 0.52, cy: H * 0.35, color: '#f59e0b', dim: 'rgba(245,158,11,.25)' },
    { label: 'Schema Error',  cx: W * 0.78, cy: H * 0.6,  color: '#8b5cf6', dim: 'rgba(139,92,246,.25)' },
  ];
  const N_TRACES = 18;

  // Assign each trace to a cluster and pre-compute start/end positions
  const traces = Array.from({length: N_TRACES}, (_, i) => {
    const ci = i % 3;
    const cl = CLUSTERS[ci];
    const sx = seededRand(i * 7)     * W;
    const sy = seededRand(i * 7 + 1) * H;
    const ex = cl.cx + (seededRand(i * 7 + 2) - 0.5) * 80;
    const ey = cl.cy + (seededRand(i * 7 + 3) - 0.5) * 60;
    return { sx, sy, ex, ey, ci, r: 5 + seededRand(i * 7 + 4) * 3 };
  });

  let animT = 0; // 0 = scattered, 1 = clustered
  let animating = false;
  let direction = 1;
  let raf = null;
  const labelEl = document.getElementById('cluster-label');

  function draw(t) {
    ctx.clearRect(0, 0, W, H);
    const ease = t < 0.5 ? 2*t*t : -1 + (4 - 2*t)*t;

    // Draw cluster "blobs" (fade in as t increases)
    CLUSTERS.forEach(cl => {
      ctx.beginPath();
      ctx.arc(cl.cx, cl.cy, 52 * ease, 0, Math.PI * 2);
      ctx.fillStyle = cl.dim.replace('.25)', String(0.06 + ease * 0.25) + ')');
      ctx.fill();
      if (ease > 0.5) {
        ctx.fillStyle = cl.color;
        ctx.globalAlpha = (ease - 0.5) * 2;
        ctx.font = `bold 11px monospace`;
        ctx.textAlign = 'center';
        ctx.fillText(cl.label, cl.cx, cl.cy + 70);
        ctx.globalAlpha = 1;
      }
    });

    // Draw traces
    traces.forEach(tr => {
      const x = tr.sx + (tr.ex - tr.sx) * ease;
      const y = tr.sy + (tr.ey - tr.sy) * ease;
      const cl = CLUSTERS[tr.ci];
      ctx.beginPath();
      ctx.arc(x, y, tr.r, 0, Math.PI * 2);
      ctx.fillStyle = ease > 0.6 ? cl.color : '#3a3a5e';
      ctx.globalAlpha = 0.75 + ease * 0.25;
      ctx.fill();
      ctx.globalAlpha = 1;
    });

    // Label
    if (labelEl) {
      labelEl.textContent = t < 0.1 ? 'scattered execution traces'
        : t > 0.85 ? '3 distinct failure patterns identified'
        : 'clustering by failure signature…';
    }
  }

  function step() {
    animT += direction * 0.018;
    if (animT >= 1) { animT = 1; animating = false; }
    if (animT <= 0) { animT = 0; animating = false; }
    draw(animT);
    if (animating) raf = requestAnimationFrame(step);
  }

  draw(0);

  document.getElementById('cluster-play')?.addEventListener('click', function() {
    direction = animT >= 1 ? -1 : 1;
    animating = true;
    if (raf) cancelAnimationFrame(raf);
    raf = requestAnimationFrame(step);
    this.textContent = direction > 0 ? '⏸ Pause' : '⏸ Pause';
  });
  document.getElementById('cluster-reset')?.addEventListener('click', () => {
    animating = false;
    if (raf) cancelAnimationFrame(raf);
    animT = 0;
    const btn = document.getElementById('cluster-play');
    if (btn) btn.textContent = '▶ Play';
    draw(0);
  });
})();

// ── Evolution canvas ──
(function() {
  const canvas = document.getElementById('evol-canvas');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth || 600;
  const H = 280;
  canvas.width  = W * DPR;
  canvas.height = H * DPR;
  const ctx = canvas.getContext('2d');
  ctx.scale(DPR, DPR);

  const PAD = { l: 52, r: 24, t: 18, b: 38 };
  const CW = W - PAD.l - PAD.r;
  const CH = H - PAD.t - PAD.b;

  // Evolution data (from paper figures 5a, 6a and text)
  const MODELS = {
    m25: {
      color: '#8b5cf6',
      maxIter: 15,
      initVal: 42.2,
      accepted: [{iter:2,val:49.2},{iter:7,val:51.6},{iter:12,val:53.9}],
      rejected: [0,1,3,4,5,6,8,9,10,11,13,14],
    },
    qwen: {
      color: '#06b6d4',
      maxIter: 20,
      initVal: 20.3,
      accepted: [{iter:3,val:21.1},{iter:5,val:24.2},{iter:9,val:31.3},{iter:12,val:32.8},{iter:16,val:34.4},{iter:18,val:36.7}],
      rejected: [0,1,2,4,6,7,8,10,11,13,14,15,17,19],
    },
    glm5: {
      color: '#10b981',
      maxIter: 15,
      initVal: 46.1,
      accepted: [{iter:5,val:49.5},{iter:10,val:53.2},{iter:14,val:57.0}],
      rejected: [0,1,2,3,4,6,7,8,9,11,12,13],
    },
  };

  const MAX_ITER = 20;
  const Y_MIN = 15; const Y_MAX = 65;

  function xOf(iter) { return PAD.l + (iter / MAX_ITER) * CW; }
  function yOf(val)  { return PAD.t + CH - ((val - Y_MIN) / (Y_MAX - Y_MIN)) * CH; }

  let activeModel = 'all';

  function drawChart() {
    ctx.clearRect(0, 0, W, H);

    // Grid lines
    ctx.strokeStyle = 'rgba(255,255,255,0.05)';
    ctx.lineWidth = 1;
    for (let v = 20; v <= 60; v += 10) {
      const y = yOf(v);
      ctx.beginPath(); ctx.moveTo(PAD.l, y); ctx.lineTo(W - PAD.r, y); ctx.stroke();
      ctx.fillStyle = '#4b5563';
      ctx.font = '9px monospace';
      ctx.textAlign = 'right';
      ctx.fillText(v + '%', PAD.l - 4, y + 3);
    }
    for (let i = 0; i <= MAX_ITER; i += 5) {
      const x = xOf(i);
      ctx.beginPath(); ctx.moveTo(x, PAD.t); ctx.lineTo(x, H - PAD.b); ctx.stroke();
      ctx.fillStyle = '#4b5563';
      ctx.font = '9px monospace';
      ctx.textAlign = 'center';
      ctx.fillText(i, x, H - PAD.b + 12);
    }
    // Axes
    ctx.strokeStyle = 'rgba(255,255,255,0.15)';
    ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.moveTo(PAD.l, PAD.t); ctx.lineTo(PAD.l, H - PAD.b); ctx.lineTo(W - PAD.r, H - PAD.b); ctx.stroke();

    // Axis labels
    ctx.fillStyle = '#6b7280'; ctx.font = '9px monospace';
    ctx.textAlign = 'center';
    ctx.fillText('iteration', W / 2, H - 2);
    ctx.save(); ctx.translate(11, H / 2); ctx.rotate(-Math.PI / 2);
    ctx.fillText('pass rate (%)', 0, 0); ctx.restore();

    // Draw each model
    Object.entries(MODELS).forEach(([key, m]) => {
      const isActive = activeModel === 'all' || activeModel === key;
      const alpha = isActive ? 1.0 : 0.12;
      ctx.globalAlpha = alpha;

      // Build step-function points
      const points = [];
      let curVal = m.initVal;
      points.push({iter: 0, val: curVal});
      for (let i = 0; i <= m.maxIter; i++) {
        const acc = m.accepted.find(a => a.iter === i);
        if (acc) { curVal = acc.val; points.push({iter: i, val: curVal}); }
        else if (i > 0 && !m.accepted.find(a => a.iter === i - 1)) {
          // keep flat
        }
      }
      points.push({iter: m.maxIter, val: curVal});

      // Draw step-function line
      ctx.strokeStyle = m.color;
      ctx.lineWidth = 2.5;
      ctx.beginPath();
      let px = null, py = null;
      for (let i = 0; i <= m.maxIter; i++) {
        let val = m.initVal;
        for (const a of m.accepted) { if (a.iter <= i) val = a.val; }
        const x = xOf(i);
        const y = yOf(val);
        if (px === null) { ctx.moveTo(x, y); }
        else {
          ctx.lineTo(x, py); // horizontal
          ctx.lineTo(x, y);  // vertical step (may be 0 if no change)
        }
        px = x; py = y;
      }
      ctx.stroke();

      // Draw accepted dots
      m.accepted.forEach(a => {
        ctx.beginPath();
        ctx.arc(xOf(a.iter), yOf(a.val), 5.5, 0, Math.PI * 2);
        ctx.fillStyle = m.color;
        ctx.fill();
        ctx.strokeStyle = '#0d0d14';
        ctx.lineWidth = 1.5;
        ctx.stroke();
      });

      // Draw rejected X marks
      m.rejected.forEach(ri => {
        let val = m.initVal;
        for (const a of m.accepted) { if (a.iter < ri) val = a.val; }
        const x = xOf(ri);
        const y = yOf(val + (seededRand(ri * 31 + (key.charCodeAt(0))) - 0.5) * 3);
        ctx.strokeStyle = '#6b7280';
        ctx.lineWidth = 1.5;
        const s = 4;
        ctx.beginPath(); ctx.moveTo(x - s, y - s); ctx.lineTo(x + s, y + s); ctx.stroke();
        ctx.beginPath(); ctx.moveTo(x + s, y - s); ctx.lineTo(x - s, y + s); ctx.stroke();
      });

      ctx.globalAlpha = 1;
    });
  }

  function seededRand(n) {
    return ((1664525 * n + 1013904223) & 0x7fffffff) / 0x7fffffff;
  }

  drawChart();

  // Model selector buttons
  ['btn-all','btn-m25','btn-qwen','btn-glm5'].forEach(id => {
    const btn = document.getElementById(id);
    if (!btn) return;
    btn.addEventListener('click', () => {
      document.querySelectorAll('.canvas-btn[data-model]').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeModel = btn.dataset.model;
      drawChart();
    });
  });
})();

// ── Animated bar chart ──
const resultsSection = document.getElementById('s-results');
if (resultsSection) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('#results-bars .bar-fill[data-w]').forEach(b => {
          b.style.width = b.dataset.w + '%';
        });
      }
    });
  }, { threshold: 0.3 }).observe(resultsSection);
}
</script>
</BaseLayout>

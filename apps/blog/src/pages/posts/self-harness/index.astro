<span class="cs-line cmt">#        "structured_tool_mismatch") → 7 traces</span>
<span class="cs-line cmt">#</span>
<span class="cs-line cmt"># φ₃ = ("verifier_timeout",</span>
<span class="cs-line cmt">#        "tool call loop &gt;50 steps",</span>
<span class="cs-line cmt">#        "unproductive_tool_loop") → 4 traces</span>
<span class="cs-line"> </span>
<span class="cs-line hl-g"><span class="cmt"># Same outcome (fail) — very different mechanisms</span></span>
<span class="cs-line hl-g"><span class="cmt"># Each needs a distinct harness fix</span></span>
      </pre>

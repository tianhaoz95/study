    <!-- §03 panel -->
    <div class="cs-panel" id="panel-loop">
      <pre class="cs-pre">
<span class="cs-line cmt"># Algorithm 1: Self-Harness loop</span>
<span class="cs-line"> </span>
<span class="cs-line"><span class="kw">for</span> t <span class="kw">in</span> <span class="fn">range</span>(T):  <span class="cmt"># T iterations</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt">  # Stage 1: Weakness Mining</span>
<span class="cs-line hl-p">  traces = <span class="fn">evaluate</span>(M, h_t, D_in)</span>
<span class="cs-line hl-p">  Bt = <span class="fn">build_evidence_bundle</span>(traces)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt">  # Stage 2: Harness Proposal</span>
<span class="cs-line hl-c">  candidates = <span class="fn">parallel_propose</span>(</span>
<span class="cs-line hl-c">      M, h_t, Bt, K=<span class="num">5</span></span>
<span class="cs-line hl-c">  )  <span class="cmt"># K distinct, minimal edits</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt">  # Stage 3: Proposal Validation</span>
<span class="cs-line">  accepted = []</span>
<span class="cs-line">  <span class="kw">for</span> (delta_j, audit_j) <span class="kw">in</span> candidates:</span>
<span class="cs-line hl-g">    h_cand = <span class="fn">apply</span>(delta_j, h_t)</span>
<span class="cs-line hl-g">    d_in = <span class="fn">pass_rate</span>(h_cand, D_in)</span>
<span class="cs-line hl-g">         - <span class="fn">pass_rate</span>(h_t, D_in)</span>
<span class="cs-line hl-g">    d_ho = <span class="fn">pass_rate</span>(h_cand, D_ho)</span>
<span class="cs-line hl-g">         - <span class="fn">pass_rate</span>(h_t, D_ho)</span>
<span class="cs-line">    <span class="kw">if</span> d_in &gt;= <span class="num">0</span> <span class="kw">and</span> d_ho &gt;= <span class="num">0</span> \</span>
<span class="cs-line hl-a">       <span class="kw">and</span> <span class="fn">max</span>(d_in, d_ho) &gt; <span class="num">0</span>:</span>
<span class="cs-line hl-a">      accepted.<span class="fn">append</span>(delta_j)</span>
<span class="cs-line"> </span>
<span class="cs-line">  h_t = <span class="fn">merge_accepted</span>(h_t, accepted)</span>
<span class="cs-line cmt">        <span class="cmt"># or h_t unchanged if none pass</span></span>
      </pre>
    </div>

    <!-- §04 panel -->

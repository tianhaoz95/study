// ═══════════════════════════════════════════════
// §03 Confidence distribution canvas (CE vs CAP)
// ═══════════════════════════════════════════════
(function() {
  const canvas = document.getElementById('conf-canvas');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  function resize() {
    const W = canvas.clientWidth, H = 170;
    canvas.width = W * DPR; canvas.height = H * DPR;
  }
  resize();
  const ctx = canvas.getContext('2d');
  let mode = 'ce'; // 'ce' or 'cap'

  // Token vocabulary (top-8 for illustration)
  const tokens = ['Paris', 'Lyon', 'Rome', 'Milan', 'Nice', 'Marseille', 'Toulouse', 'Bordeaux'];
  // CE: spread distribution
  const ce_probs = [0.42, 0.18, 0.12, 0.09, 0.07, 0.05, 0.04, 0.03];
  // CAP: sharp distribution
  const cap_probs = [0.88, 0.04, 0.03, 0.02, 0.01, 0.01, 0.005, 0.005];

  function drawConf() {
    const W = canvas.width / DPR, H = canvas.height / DPR;
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.scale(DPR, DPR);

    const probs = mode === 'ce' ? ce_probs : cap_probs;
    const n = tokens.length;
    const padL = 14, padR = 12, padT = 20, padB = 40;
    const chartW = W - padL - padR;
    const chartH = H - padT - padB;
    const barW = chartW / n;
    const maxProb = 1.0;
    const color = mode === 'ce' ? 'rgba(245,158,11,0.75)' : 'rgba(139,92,246,0.85)';
    const colorBorder = mode === 'ce' ? '#f59e0b' : '#8b5cf6';
    const acceptColor = 'rgba(16,185,129,0.7)';

    // Grid lines
    for (let i = 0; i <= 4; i++) {
      const yg = padT + chartH * (1 - i * 0.25 / maxProb);
      ctx.strokeStyle = 'rgba(255,255,255,0.05)';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(padL, yg); ctx.lineTo(padL + chartW, yg);
      ctx.stroke();
      ctx.fillStyle = '#4b5563';
      ctx.font = `8px var(--ff-mono, monospace)`;
      ctx.textAlign = 'right';
      ctx.fillText((i * 25) + '%', padL - 2, yg + 3);
    }

    // Bars
    probs.forEach((p, i) => {
      const x = padL + i * barW;
      const h = (p / maxProb) * chartH;
      const y = padT + chartH - h;
      const isCorrect = i === 0;
      ctx.fillStyle = isCorrect ? acceptColor : color;
      ctx.strokeStyle = isCorrect ? '#10b981' : colorBorder;
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.roundRect(x + 2, y, barW - 4, h, [3, 3, 0, 0]);
      ctx.fill();
      ctx.stroke();

      // Probability label on top
      if (p >= 0.04) {
        ctx.fillStyle = '#d1d5db';
        ctx.font = `700 9px var(--ff-mono, monospace)`;
        ctx.textAlign = 'center';
        ctx.fillText(Math.round(p * 100) + '%', x + barW/2, y - 3);
      }

      // Token label below
      ctx.fillStyle = isCorrect ? '#10b981' : '#6b7280';
      ctx.font = isCorrect ? `700 9px var(--ff-mono, monospace)` : `9px var(--ff-mono, monospace)`;
      ctx.textAlign = 'center';
      ctx.fillText(tokens[i], x + barW/2, padT + chartH + 14);
    });

    ctx.setTransform(1,0,0,1,0,0);

    const acceptP = probs[0];
    const targetP = 0.91;
    const acceptRate = Math.min(1, targetP / acceptP);
    const stat = document.getElementById('conf-stat');
    if (stat) {
      if (mode === 'ce') {
        stat.innerHTML = `p<sub>draft</sub>("Paris") = <strong>42%</strong> &nbsp;|&nbsp; p<sub>target</sub>("Paris") = 91% &nbsp;|&nbsp; accept prob = <span style="color:var(--amber)">min(1, 91/42) = 1.0</span> &nbsp;|&nbsp; but τ limited by <em>expected</em> match quality`;
      } else {
        stat.innerHTML = `p<sub>draft</sub>("Paris") = <strong>88%</strong> &nbsp;|&nbsp; p<sub>target</sub>("Paris") = 91% &nbsp;|&nbsp; accept prob = <span style="color:var(--green)">min(1, 91/88) ≈ 0.97</span> &nbsp;|&nbsp; near-certain acceptance`;
      }
    }
  }

  document.getElementById('conf-ce-btn')?.addEventListener('click', () => {
    mode = 'ce';
    document.getElementById('conf-ce-btn').classList.add('active');
    document.getElementById('conf-cap-btn').classList.remove('active');
    drawConf();
  });
  document.getElementById('conf-cap-btn')?.addEventListener('click', () => {
    mode = 'cap';
    document.getElementById('conf-cap-btn').classList.add('active');
    document.getElementById('conf-ce-btn').classList.remove('active');
    drawConf();
  });

  drawConf();
  window.addEventListener('resize', () => { resize(); drawConf(); });
})();

// ═══════════════════════════════════════════════
// §04 T2T Step Navigator
// ═══════════════════════════════════════════════
(function() {
  let step = 0;
  const boxes  = document.querySelectorAll('#t2t-steps .step-box');
  const prevBtn = document.getElementById('t2t-prev');
  const nextBtn = document.getElementById('t2t-next');
  const progEl  = document.getElementById('t2t-prog');
  function updateSteps() {
    boxes.forEach((b, i) => {
      b.classList.remove('active','done');
      if (i === step) b.classList.add('active');
      else if (i < step) b.classList.add('done');
    });
    if (prevBtn) prevBtn.disabled = step === 0;
    if (nextBtn) nextBtn.disabled = step === boxes.length - 1;
    if (progEl) progEl.textContent = `Step ${step+1} of ${boxes.length}`;
    boxes.forEach((b, i) => {
      const n = b.querySelector('.step-num');
      if (n) n.textContent = i < step ? '✓' : String(i+1);
    });
  }
  prevBtn?.addEventListener('click', () => { if (step>0){step--;updateSteps();} });
  nextBtn?.addEventListener('click', () => { if (step<boxes.length-1){step++;updateSteps();} });
  updateSteps();
})();

// ═══════════════════════════════════════════════
// §05 EBPO Line Chart
// ═══════════════════════════════════════════════
(function() {
  const canvas = document.getElementById('ebpo-chart');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  function resize() {
    const W = canvas.clientWidth, H = 180;
    canvas.width = W * DPR; canvas.height = H * DPR;
  }
  resize();
  const ctx = canvas.getContext('2d');

  function drawEBPO() {
    const W = canvas.width / DPR, H = canvas.height / DPR;
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.scale(DPR, DPR);

    const padL = 44, padR = 20, padT = 16, padB = 30;
    const chartW = W - padL - padR;
    const chartH = H - padT - padB;
    const N = 20; // steps
    const yMin = 4.0, yMax = 10.0;

    function yPos(v) { return padT + chartH * (1 - (v - yMin) / (yMax - yMin)); }
    function xPos(i) { return padL + (i / (N-1)) * chartW; }

    // Grid
    for (let v = 4; v <= 10; v += 1) {
      const yg = yPos(v);
      ctx.strokeStyle = 'rgba(255,255,255,0.05)';
      ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(padL, yg); ctx.lineTo(padL+chartW, yg); ctx.stroke();
      ctx.fillStyle = '#4b5563';
      ctx.font = '8px var(--ff-mono, monospace)';
      ctx.textAlign = 'right';
      ctx.fillText('τ=' + v, padL - 4, yg + 3);
    }

    // CE training curve (orange) — plateaus around 6.5
    const ceData = Array.from({length: N}, (_, i) => {
      const t = i / (N-1);
      return 4.5 + 2.2 * (1 - Math.exp(-5 * t));
    });
    ctx.beginPath();
    ctx.strokeStyle = 'rgba(245,158,11,0.9)';
    ctx.lineWidth = 2;
    ceData.forEach((v, i) => {
      if (i === 0) ctx.moveTo(xPos(i), yPos(v));
      else ctx.lineTo(xPos(i), yPos(v));
    });
    ctx.stroke();
    // CE label
    ctx.fillStyle = '#f59e0b';
    ctx.font = '9px var(--ff-mono, monospace)';
    ctx.textAlign = 'left';
    ctx.fillText('CE training (τ ≈ 6.5)', padL + chartW * 0.55, yPos(6.65));

    // EBPO curve (purple) — continues rising to ~8.9
    const ebpoData = Array.from({length: N}, (_, i) => {
      const t = i / (N-1);
      if (t < 0.4) {
        // matches CE in warmup
        return 4.5 + 2.2 * (1 - Math.exp(-5 * t));
      }
      // continues growing after EBPO kicks in
      const t2 = (t - 0.4) / 0.6;
      return 6.5 + 2.4 * (1 - Math.exp(-3 * t2));
    });
    ctx.beginPath();
    ctx.strokeStyle = 'rgba(139,92,246,0.95)';
    ctx.lineWidth = 2.5;
    ctx.setLineDash([]);
    ebpoData.forEach((v, i) => {
      if (i === 0) ctx.moveTo(xPos(i), yPos(v));
      else ctx.lineTo(xPos(i), yPos(v));
    });
    ctx.stroke();
    // EBPO label
    ctx.fillStyle = '#a78bfa';
    ctx.font = '9px var(--ff-mono, monospace)';
    ctx.textAlign = 'left';
    ctx.fillText('+ EBPO (projected τ ≈ 8.9)', padL + chartW * 0.52, yPos(8.0));

    // EBPO start marker
    const ebpoStartX = xPos(8); // t=0.4
    ctx.strokeStyle = 'rgba(139,92,246,0.4)';
    ctx.lineWidth = 1;
    ctx.setLineDash([3,3]);
    ctx.beginPath(); ctx.moveTo(ebpoStartX, padT); ctx.lineTo(ebpoStartX, padT+chartH); ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle = '#a78bfa';
    ctx.font = '8px var(--ff-mono, monospace)';
    ctx.textAlign = 'center';
    ctx.fillText('EBPO starts', ebpoStartX, padT + chartH + 22);

    // X axis label
    ctx.fillStyle = '#4b5563';
    ctx.font = '8px var(--ff-mono, monospace)';
    ctx.textAlign = 'center';
    ctx.fillText('Training steps →', padL + chartW/2, padT + chartH + 14);

    ctx.setTransform(1,0,0,1,0,0);
  }

  drawEBPO();
  window.addEventListener('resize', () => { resize(); drawEBPO(); });
})();


      <pre class="cs-pre">
<span class="cs-line cmt"># Speculative decoding: cascade rejection</span>
<span class="cs-line cmt"># A wrong token at position k kills k+1..γ</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">speculative_verify</span>(draft, target_logits, γ):</span>
<span class="cs-line">    accepted = []</span>
<span class="cs-line">    <span class="kw">for</span> k <span class="kw">in</span> <span class="fn">range</span>(γ):</span>
<span class="cs-line hl-c">        p_t = target_logits[k, draft[k]]   <span class="cmt"># target prob</span></span>
<span class="cs-line hl-c">        p_d = draft_logits[k, draft[k]]    <span class="cmt"># draft prob</span></span>
<span class="cs-line">        ratio = p_t / p_d</span>
<span class="cs-line hl-a">        <span class="kw">if</span> random() &lt;= min(<span class="num">1.0</span>, ratio):   <span class="cmt"># accept</span></span>
<span class="cs-line">            accepted.append(draft[k])</span>
<span class="cs-line hl-g">        <span class="kw">else</span>:  <span class="cmt"># reject → cascade stops here</span></span>
<span class="cs-line">            <span class="kw">break</span></span>
<span class="cs-line">    <span class="kw">return</span> accepted  <span class="cmt"># len = τ ∈ [1, γ+1]</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Speedup formula (DFlash paper, eq. 1)</span>
<span class="cs-line cmt"># L = (T_draft + T_verify) / τ</span>
<span class="cs-line cmt"># T_draft ≈ constant for diffusion (1 fwd pass)</span>
<span class="cs-line cmt"># Doubling τ ≈ halves per-token latency</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># DFlash measured τ on Qwen3-8B (temp=0):</span>
<span class="cs-line cmt">#   EAGLE-3 (16):  τ = 2.96  → 1.76×</span>
<span class="cs-line cmt">#   EAGLE-3 (60):  τ = 3.40  → 2.02×</span>
<span class="cs-line cmt">#   DFlash  (16):  τ = 6.49  → 4.86×</span>
      </pre>
    </div>

    <!-- panel-dflash -->
    <div class="cs-panel" id="panel-dflash">
      <pre class="cs-pre">
<span class="cs-line cmt"># DFlash training (arXiv:2602.06036)</span>
<span class="cs-line cmt"># Key design choices in the training loop</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">dflash_train_step</span>(target_model, draft_model, seq):</span>
<span class="cs-line">    <span class="cmt"># 1. Extract context features from frozen target</span></span>
<span class="cs-line hl-c">    hidden = target_model.<span class="fn">forward</span>(seq, layers=[<span class="num">2</span>,<span class="num">6</span>,<span class="num">10</span>,<span class="num">14</span>,<span class="num">18</span>])</span>
<span class="cs-line hl-c">    ctx_feat = proj_layer(<span class="fn">concat</span>(hidden))  <span class="cmt"># fuse features</span></span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="cmt"># 2. Random anchor sampling (data augmentation)</span></span>
<span class="cs-line">    anchors = <span class="fn">random_sample</span>(response_positions)</span>
<span class="cs-line hl-a">    masked = <span class="fn">mask_except</span>(seq, anchors)  <span class="cmt"># all non-anchor → mask</span></span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="cmt"># 3. Draft forward pass with KV injection</span></span>
<span class="cs-line hl-p">    logits = draft_model.<span class="fn">forward</span>(masked, kv=ctx_feat)</span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="cmt"># 4. Exponential position weighting (earlier = more weight)</span></span>
<span class="cs-line hl-g">    weights = [<span class="fn">exp</span>(-(k-<span class="num">1</span>)/gamma) <span class="kw">for</span> k <span class="kw">in</span> <span class="fn">range</span>(gamma)]</span>
<span class="cs-line hl-g">    loss = <span class="fn">sum</span>(w * <span class="fn">ce</span>(logits[k], target[k]) <span class="kw">for</span> k,w <span class="kw">in</span> <span class="fn">zip</span>(<span class="fn">range</span>(gamma), weights))</span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="cmt"># Shared embeddings with target model (frozen)</span></span>
<span class="cs-line">    <span class="cmt"># Only draft transformer layers are updated</span></span>
<span class="cs-line">    <span class="kw">return</span> loss</span>
      </pre>
    </div>

    <!-- panel-llada20 -->
    <div class="cs-panel" id="panel-llada20">
      <pre class="cs-pre">
<span class="cs-line cmt"># LLaDA 2.0 (arXiv:2512.15745)</span>
<span class="cs-line cmt"># CAP training + WSD initialization</span>
<span class="cs-line"> </span>
<span class="cs-line cmt">## 1. CAP: Confidence-Aware Parallel Training</span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">cap_loss</span>(logits, targets, λ=<span class="num">0.1</span>):</span>
<span class="cs-line">    <span class="cmt"># Standard CE loss</span></span>
<span class="cs-line">    ce = <span class="fn">cross_entropy</span>(logits, targets)</span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="cmt"># Confidence loss: minimize entropy only at CORRECT positions</span></span>
<span class="cs-line hl-c">    correct_mask = (logits.<span class="fn">argmax</span>() == targets)</span>
<span class="cs-line hl-c">    probs = <span class="fn">softmax</span>(logits[correct_mask])</span>
<span class="cs-line hl-c">    H = -(<span class="fn">probs</span> * probs.<span class="fn">log</span>()).<span class="fn">sum</span>(<span class="num">-1</span>).<span class="fn">mean</span>()  <span class="cmt"># entropy</span></span>
<span class="cs-line"> </span>
<span class="cs-line hl-g">    <span class="kw">return</span> ce + λ * H  <span class="cmt"># sharper = lower entropy = better</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt">## CAP result in LLaDA 2.0:</span>
<span class="cs-line cmt">#   Without CAP:  TPF = 3.08  →  383 TPS</span>
<span class="cs-line cmt">#   With CAP:     TPF = 5.93  →  535 TPS  (+93% throughput)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt">## 2. WSD: Warmup-Stable-Decay block schedule</span>
<span class="cs-line hl-p">WSD_SCHEDULE = [</span>
<span class="cs-line">    (<span class="str">'warmup'</span>,  [<span class="num">1</span>, <span class="num">4</span>, <span class="num">32</span>, <span class="num">64</span>, <span class="num">4096</span>]),  <span class="cmt"># grow block size</span></span>
<span class="cs-line">    (<span class="str">'stable'</span>,  [<span class="num">4096</span>]),               <span class="cmt"># full masked diffusion</span></span>
<span class="cs-line">    (<span class="str">'decay'</span>,   [<span class="num">4096</span>, <span class="num">512</span>, <span class="num">64</span>, <span class="num">32</span>]),  <span class="cmt"># distill into blocks</span></span>
<span class="cs-line hl-a">]  <span class="cmt"># converts AR model → block-diffusion without scratch training</span></span>
      </pre>
    </div>

    <!-- panel-t2t -->
    <div class="cs-panel" id="panel-t2t">
      <pre class="cs-pre">
<span class="cs-line cmt"># LLaDA 2.1 (arXiv:2602.08676)</span>
<span class="cs-line cmt"># T2T Token Editing: draft-and-correct</span>
<span class="cs-line"> </span>
<span class="cs-line cmt">## Decoding: dual-threshold scheme</span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">t2t_decode_step</span>(x_t, model, τ_mask, τ_edit):</span>
<span class="cs-line">    probs = <span class="fn">softmax</span>(model(x_t))        <span class="cmt"># one forward pass</span></span>
<span class="cs-line">    best  = probs.<span class="fn">argmax</span>(<span class="num">-1</span>)</span>
<span class="cs-line">    conf  = probs.<span class="fn">max</span>(<span class="num">-1</span>)</span>
<span class="cs-line"> </span>
<span class="cs-line hl-c">    <span class="cmt"># Unmask set: [MASK] positions that are confident</span></span>
<span class="cs-line hl-c">    unmask = (x_t == MASK) &amp; (conf &gt; τ_mask)</span>
<span class="cs-line hl-g">    <span class="cmt"># Edit set:   real tokens the model disagrees with</span></span>
<span class="cs-line hl-g">    edit   = (x_t != best) &amp; (conf &gt; τ_edit)</span>
<span class="cs-line"> </span>
<span class="cs-line">    x_new = x_t.<span class="fn">clone</span>()</span>
<span class="cs-line">    x_new[unmask] = best[unmask]  <span class="cmt"># M2T</span></span>
<span class="cs-line hl-a">    x_new[edit]   = best[edit]    <span class="cmt"># T2T ← self-correction</span></span>
<span class="cs-line">    <span class="kw">return</span> x_new</span>
<span class="cs-line"> </span>
<span class="cs-line cmt">## T2T training: add editing stream to DFlash</span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">t2t_train_loss</span>(model, clean_seq, α=<span class="num">0.3</span>):</span>
<span class="cs-line">    <span class="cmt"># Standard DFlash masking stream</span></span>
<span class="cs-line">    m2t = <span class="fn">dflash_ce_loss</span>(model, clean_seq)</span>
<span class="cs-line">    <span class="cmt"># T2T editing stream: perturb tokens, recover originals</span></span>
<span class="cs-line hl-c">    perturbed = <span class="fn">random_substitute</span>(clean_seq, p=<span class="num">0.15</span>)</span>
<span class="cs-line hl-c">    t2t = <span class="fn">ce_loss</span>(model(perturbed), clean_seq)</span>
<span class="cs-line hl-g">    <span class="kw">return</span> m2t + α * t2t  <span class="cmt"># mixed objective</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt">## LLaDA 2.1 MBE result:</span>
<span class="cs-line cmt">#   Without MBE: avg score 70.69, TPF 5.82</span>
<span class="cs-line cmt">#   With MBE:    avg score 72.67, TPF 5.14  (+2.0pp, -11.7%)</span>
      </pre>
    </div>

    <!-- panel-ebpo -->
    <div class="cs-panel" id="panel-ebpo">
      <pre class="cs-pre">
<span class="cs-line cmt"># LLaDA 2.1 EBPO (arXiv:2602.08676)</span>
<span class="cs-line cmt"># Adapted for DFlash acceptance reward</span>
<span class="cs-line"> </span>
<span class="cs-line cmt">## EBPO reward for speculative decoding</span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">acceptance_reward</span>(draft, target_model):</span>
<span class="cs-line">    accepts = <span class="fn">speculative_verify</span>(draft, target_model)</span>
<span class="cs-line hl-c">    <span class="kw">return</span> <span class="fn">len</span>(accepts) / gamma  <span class="cmt"># τ / γ ∈ [0, 1]</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt">## EBPO surrogate (clipped PPO-style)</span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">ebpo_loss</span>(θ, θ_old, rollouts, ε=<span class="num">0.2</span>):</span>
<span class="cs-line">    loss_terms = []</span>
<span class="cs-line">    <span class="kw">for</span> (draft, reward) <span class="kw">in</span> rollouts:</span>
<span class="cs-line">        <span class="cmt"># Log-ratio via ELBO approximation (vectorized)</span></span>
<span class="cs-line hl-c">        log_ratio = <span class="fn">elbo_log_ratio</span>(θ, θ_old, draft)</span>
<span class="cs-line hl-c">        ρ = <span class="fn">exp</span>(log_ratio)</span>
<span class="cs-line">        A = reward - baseline  <span class="cmt"># advantage</span></span>
<span class="cs-line hl-g">        clip_ρ = <span class="fn">clip</span>(ρ, <span class="num">1</span>-ε, <span class="num">1</span>+ε)</span>
<span class="cs-line hl-g">        loss_terms.<span class="fn">append</span>(<span class="fn">min</span>(ρ*A, clip_ρ*A))</span>
<span class="cs-line">    <span class="kw">return</span> -<span class="fn">mean</span>(loss_terms)  <span class="cmt"># maximize expected τ</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt">## LLaDA 2.1 EBPO result:</span>
<span class="cs-line cmt">#   Q Mode: avg score 73.54 vs 72.43 baseline (+1.11pp)</span>
<span class="cs-line cmt">#   S Mode: avg TPF 5.93 vs 3.08 baseline (+93% throughput)</span>
<span class="cs-line cmt">#   Direct acceptance reward → likely higher τ gains</span>
      </pre>
    </div>

    <!-- panel-synthesis -->
    <div class="cs-panel" id="panel-synthesis">
      <pre class="cs-pre">
<span class="cs-line cmt"># DFlash++ combined training recipe</span>
<span class="cs-line"> </span>
<span class="cs-line cmt">## Stage 1: WSD initialization from small AR model</span>
<span class="cs-line hl-p">draft_model = <span class="fn">wsd_convert</span>(</span>
<span class="cs-line">    ar_model = <span class="str">"qwen3_350M"</span>,</span>
<span class="cs-line">    schedule = WSD_SCHEDULE,  <span class="cmt"># block 1→4→32→4096→32</span></span>
<span class="cs-line">)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt">## Stage 2: DFlash CE + CAP + T2T pre-training</span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">dflash_pp_loss</span>(model, target, seq):</span>
<span class="cs-line">    ctx = <span class="fn">extract_target_features</span>(target, seq)</span>
<span class="cs-line hl-c">    logits = model.<span class="fn">forward</span>(seq, kv=ctx)</span>
<span class="cs-line">    <span class="cmt"># CE with exponential position weighting (DFlash)</span></span>
<span class="cs-line">    w = [<span class="fn">exp</span>(-(k-<span class="num">1</span>)/γ) <span class="kw">for</span> k <span class="kw">in</span> <span class="fn">range</span>(γ)]</span>
<span class="cs-line">    ce = <span class="fn">weighted_ce</span>(logits, seq, weights=w)</span>
<span class="cs-line">    <span class="cmt"># CAP: confidence sharpening at correct positions</span></span>
<span class="cs-line hl-a">    cap = <span class="fn">confidence_loss</span>(logits, seq)</span>
<span class="cs-line">    <span class="cmt"># T2T: editing stream via random perturbation</span></span>
<span class="cs-line hl-g">    t2t = <span class="fn">t2t_edit_loss</span>(model, seq, ctx, α=<span class="num">0.15</span>)</span>
<span class="cs-line">    <span class="kw">return</span> ce + λ_cap*cap + λ_t2t*t2t</span>
<span class="cs-line"> </span>
<span class="cs-line cmt">## Stage 3: EBPO fine-tuning with acceptance reward</span>
<span class="cs-line hl-p"><span class="kw">for</span> batch <span class="kw">in</span> ebpo_rollouts(target, draft_model):</span>
<span class="cs-line">    r = <span class="fn">acceptance_reward</span>(batch.draft, target)</span>
<span class="cs-line">    draft_model.<span class="fn">update</span>(<span class="fn">ebpo_loss</span>(r, batch))</span>
<span class="cs-line"> </span>
<span class="cs-line cmt">## Projected DFlash++ on Qwen3-8B (temp=0):</span>
<span class="cs-line cmt">#   Baseline DFlash:   τ ≈ 6.5   speedup ≈ 4.9×</span>
<span class="cs-line cmt">#   + WSD init:        τ ≈ 7.0   speedup ≈ 5.3×</span>
<span class="cs-line cmt">#   + CAP:             τ ≈ 7.5   speedup ≈ 5.7×</span>
<span class="cs-line cmt">#   + T2T editing:     τ ≈ 8.3   speedup ≈ 6.4×</span>
<span class="cs-line cmt">#   + EBPO:            τ ≈ 8.9   speedup ≈ 7.0×</span>
<span class="cs-line cmt">#   + MBE:             τ ≈ 9.3   speedup ≈ 7.5×</span>
      </pre>
    </div>


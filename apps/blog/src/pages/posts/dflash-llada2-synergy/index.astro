  const WRONG_TOKENS_4 = ['The', 'capital', 'of', 'France', '???', '???', '???', '???', '???', '???', '???', '???', '???', '???', '???', '???'];
  const WRONG_TOKENS_8 = ['The', 'capital', 'of', 'France', 'is', 'Paris', ',', 'and', '???', '???', '???', '???', '???', '???', '???', '???'];
  const ALL_CORRECT    = TOKENS;

  let errorPos = 0; // 0 = error at pos 0, 3 = error at pos 3, 7 = error at pos 7, 15 = no error

  function drawCascade() {
    const W = canvas.width / DPR, H = canvas.height / DPR;
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.scale(DPR, DPR);

    const n = 16;
    const pad = 8;
    const cellW = (W - 2*pad) / n;
    const cellH = 54;
    const y = (H - cellH) / 2;

    let tokens;
    if (errorPos === 0) tokens = WRONG_TOKENS;
    else if (errorPos === 3) tokens = WRONG_TOKENS_4;
    else if (errorPos === 7) tokens = WRONG_TOKENS_8;
    else tokens = ALL_CORRECT;

    let accepted = 0;
    for (let i = 0; i < n; i++) {
      const x = pad + i * cellW;
      const isError = (errorPos < 15 && i === errorPos);
      const isCascade = (errorPos < 15 && i > errorPos);
      const isAccepted = !isError && !isCascade;
      if (isAccepted) accepted++;

      // Background
      let bg, border, textCol;
      if (isAccepted) {
        bg = 'rgba(16,185,129,0.18)'; border = 'rgba(16,185,129,0.55)'; textCol = '#10b981';
      } else if (isError) {
        bg = 'rgba(239,68,68,0.22)'; border = 'rgba(239,68,68,0.7)'; textCol = '#ef4444';
      } else {
        bg = 'rgba(107,114,128,0.10)'; border = 'rgba(107,114,128,0.25)'; textCol = '#4b5563';
      }

      ctx.fillStyle = bg;
      ctx.strokeStyle = border;
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.roundRect(x + 1, y, cellW - 2, cellH, 4);
      ctx.fill();
      ctx.stroke();

      // Position number
      ctx.fillStyle = textCol;
      ctx.font = `500 ${10}px var(--ff-mono, monospace)`;
      ctx.textAlign = 'center';
      ctx.fillText(String(i + 1), x + cellW/2, y + 14);

      // Token text
      ctx.font = `600 ${9}px var(--ff-mono, monospace)`;
      ctx.fillStyle = isError ? '#ef4444' : isCascade ? '#374151' : '#d1d5db';
      const tok = tokens[i] || '';
      ctx.fillText(tok.length > 5 ? tok.slice(0,4)+'…' : tok, x + cellW/2, y + 34);

      // Status icon
      if (isAccepted) {
        ctx.fillStyle = '#10b981';
        ctx.font = `${11}px sans-serif`;
        ctx.fillText('✓', x + cellW/2, y + 50);
      } else if (isError) {
        ctx.fillStyle = '#ef4444';
        ctx.font = `${11}px sans-serif`;
        ctx.fillText('✗', x + cellW/2, y + 50);
      } else {
        ctx.fillStyle = '#4b5563';
        ctx.font = `${9}px sans-serif`;
        ctx.fillText('—', x + cellW/2, y + 50);
      }
    }
    ctx.setTransform(1,0,0,1,0,0);

    const stat = document.getElementById('cascade-stat');
    if (stat) {
      if (errorPos >= 15) {
        stat.innerHTML = `<span style="color:var(--green)">✓ All 16 tokens accepted — τ = 16</span>`;
      } else {
        const waste = 16 - accepted;
        stat.innerHTML = `Accepted: <span style="color:var(--green);font-weight:700">${accepted}</span> &nbsp;|&nbsp; Wasted by cascade: <span style="color:#ef4444;font-weight:700">${waste}</span> &nbsp;|&nbsp; τ = ${accepted}`;
      }
    }
  }

  const btns = document.querySelectorAll('#cascade-btns .ctrl-btn');
  btns.forEach(btn => {
    btn.addEventListener('click', () => {
      btns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      errorPos = parseInt(btn.dataset.pos, 10);
      drawCascade();
    });
  });

  drawCascade();
  window.addEventListener('resize', () => { resize(); drawCascade(); });
})();


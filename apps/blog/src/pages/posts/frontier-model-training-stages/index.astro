function fitCanvas(cv, h) {
  const DPR = window.devicePixelRatio || 1;
  const W = cv.clientWidth || cv.parentElement.clientWidth;
  cv.width = W * DPR; cv.height = h * DPR;
  const ctx = cv.getContext('2d');
  ctx.setTransform(DPR,0,0,DPR,0,0);
  return { ctx, W, H: h };
}


      cost: '< 1.0% of Total Compute',
      log: `[SYSTEM] Ingesting Supervised Fine-Tuning trajectories...
[TRAIN] Applying masked loss on error paths...
[TRAIN] Activating turn-level thinking tokens...
[SYSTEM] Formatting compliance and agent sandbox interaction established.`
    },
    rlvr: {
      size: '100 Million Environment Rollout Steps',
      domain: 'Math proofs, coding sandboxes, compiler execution',
      ctx: '128,000 Tokens',
      cost: '< 1.0% of Total Compute',
      log: `[SYSTEM] Initializing RLVR queue (IcePop + GRPO)...
[ROLLOUT] Generating candidates from math_verifier...
[VERIFY] Test pass. Reward = 1.0 (Unit tests passed).
[VERIFY] Test fail. Reward = 0.0 (Compilation error).
[TRAIN] Updating policy using group normalized advantages...`
    }
  };

  document.querySelectorAll('#pipe-tab-group .pipe-tab').forEach(b => {
    b.addEventListener('click', () => {
      document.querySelectorAll('#pipe-tab-group .pipe-tab').forEach(x => x.classList.remove('active'));
      b.classList.add('active');
      const stage = b.dataset.stage;
      const data = stageData[stage];
      if (data) {
        document.getElementById('det-size').textContent = data.size;
        document.getElementById('det-domain').textContent = data.domain;
        document.getElementById('det-ctx').textContent = data.ctx;
        
        const costEl = document.getElementById('det-cost');
        costEl.textContent = data.cost;
        if (stage === 'pre') {
          costEl.className = 'pipe-detail-val win';
        } else {
          costEl.className = 'pipe-detail-val';
        }
        
        document.getElementById('pipe-console-log').innerHTML = data.log.replace(/\n/g, '<br>');
      }
    });
  });
})();

// ============ 04 RLHF vs RLVR Trajectory Simulator ============
(function(){
  const rlhfBubbles = document.getElementById('rlhf-bubbles');
  const rlvrBubbles = document.getElementById('rlvr-bubbles');
  const ctrls = document.querySelectorAll('#sim-ver-ctrls .vp-btn');
  
  const trajectories = {
    rlhf: [
      { sender: 'model', text: 'Here is a beautiful solution in Python to find the GCD:\n\n```python\ndef gcd(a, b):\n    # Using Euclidean algorithm\n    while b > 0:\n        a, b = b, a % b\n    return a\n```\nPolitely let me know if you need anything else!' },
      { sender: 'reward', text: ' learned_RM: 0.94 (Highly polite, formatted, helpful-looking structure)' },
      { sender: 'commentary', text: '⚠️ Notice: The code has a bug for negative numbers. But the learned Reward Model rewards the politeness and markdown layout, reinforcing incorrect logic.' }
    ],
    rlvr: [
      { sender: 'model', text: '```python\ndef gcd(a, b):\n    while b > 0:\n        a, b = b, a % b\n    return a\n```' },
      { sender: 'reward fail', text: ' compiler_test: 0.0 (FAILED: test_negative_inputs fails with ZeroDivisionError)' },
      { sender: 'model', text: 'Ah, I see test_negative_inputs failed. I should take the absolute values of a and b first:\n\n```python\ndef gcd(a, b):\n    a, b = abs(a), abs(b)\n    while b > 0:\n        a, b = b, a % b\n    return a\n```' },
      { sender: 'reward', text: ' compiler_test: 1.0 (PASSED: All test cases pass successfully)' },
      { sender: 'commentary', text: '💡 The model is penalized for the bug, forcing it to analyze the test log, self-correct, and rewrite correct code.' }
    ]
  };

  function renderTrajectory(mode) {
    rlhfBubbles.innerHTML = '';
    rlvrBubbles.innerHTML = '';
    
    if (mode === 'rlhf') {
      trajectories.rlhf.forEach(bubble => {
        const div = document.createElement('div');
        if (bubble.sender === 'reward') {
          div.className = 'sim-bubble reward';
          div.textContent = bubble.text;
        } else if (bubble.sender === 'commentary') {
          div.style.fontSize = '0.72rem';
          div.style.color = 'var(--muted)';
          div.style.fontStyle = 'italic';
          div.style.marginTop = '0.5rem';
          div.textContent = bubble.text;
        } else {
          div.className = 'sim-bubble model';
          div.innerHTML = bubble.text.replace(/\n/g, '<br>');
        }
        rlhfBubbles.appendChild(div);
      });
      // Dim RLVR panel
      document.getElementById('sim-side-rlhf').style.opacity = '1';
      document.getElementById('sim-side-rlvr').style.opacity = '0.35';
    } else {
      trajectories.rlvr.forEach(bubble => {
        const div = document.createElement('div');
        if (bubble.sender === 'reward') {
          div.className = 'sim-bubble reward';
          div.textContent = bubble.text;
        } else if (bubble.sender === 'reward fail') {
          div.className = 'sim-bubble reward fail';
          div.textContent = bubble.text;
        } else if (bubble.sender === 'commentary') {
          div.style.fontSize = '0.72rem';
          div.style.color = 'var(--muted)';
          div.style.fontStyle = 'italic';
          div.style.marginTop = '0.5rem';
          div.textContent = bubble.text;
        } else {
          div.className = 'sim-bubble model';
          div.innerHTML = bubble.text.replace(/\n/g, '<br>');
        }
        rlvrBubbles.appendChild(div);
      });
      // Dim RLHF panel
      document.getElementById('sim-side-rlvr').style.opacity = '1';
      document.getElementById('sim-side-rlhf').style.opacity = '0.35';
    }
  }

  ctrls.forEach(btn => {
    btn.addEventListener('click', () => {
      ctrls.forEach(x => x.classList.remove('active'));
      btn.classList.add('active');
      renderTrajectory(btn.dataset.mode);
    });
  });

  renderTrajectory('rlhf'); // default
})();

// ============ 06 stage results bars ============
(function(){
  const sec = document.getElementById('s-benchmarks-section');
  if (!sec) return;
  new IntersectionObserver(entries=>{
    entries.forEach(e=>{
      if(e.isIntersecting){
        document.querySelectorAll('#stage-result-bars .bar-fill[data-w]').forEach(b=>{
          b.style.width = b.dataset.w + '%';
        });
      }
    });
  },{threshold:0.3}).observe(sec);
})();
</script>

import torch
import torch.nn as nn

def compute_masked_sft_loss(logits, targets, action_labels):
    # CrossEntropyLoss with reduction='none' to check individual tokens
    loss_fn = nn.CrossEntropyLoss(reduction='none')
    raw_loss = loss_fn(logits.view(-1, logits.size(-1)), targets.view(-1))
    
    # action_labels maps tokens:
    # 1 = correct agent actions (compute loss)
    # 0 = error actions in trajectory (mask out loss)
    mask = action_labels.view(-1)
    
    # Mask out loss on error actions (model observes them, but isn't penalized)
    masked_loss = raw_loss * mask
    
    return masked_loss.sum() / (mask.sum() + 1e-8)`,


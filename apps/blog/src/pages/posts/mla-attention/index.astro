        <line x1="88" y1="142" x2="126" y2="170" stroke="#4b5563" stroke-width="1.5" marker-end="url(#arr2)"/>

        <!-- W^DKV -->
        <rect x="126" y="82" width="70" height="36" rx="5" fill="rgba(6,182,212,.12)" stroke="rgba(6,182,212,.4)" stroke-width="1.5"/>
        <text x="161" y="97" text-anchor="middle" fill="#22d3ee" font-size="10" font-weight="700">W^DKV</text>
        <text x="161" y="110" text-anchor="middle" fill="#6b7280" font-size="8">5120→512</text>

        <!-- W^KR -->
        <rect x="126" y="152" width="70" height="36" rx="5" fill="rgba(245,158,11,.12)" stroke="rgba(245,158,11,.4)" stroke-width="1.5"/>
        <text x="161" y="167" text-anchor="middle" fill="#fbbf24" font-size="10" font-weight="700">W^KR</text>

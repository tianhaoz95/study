    <div class="cs-panel active" id="panel-bottleneck">
      <pre class="cs-pre">
<span class="cs-line cmt"># Standard MHA KV cache cost</span>
<span class="cs-line cmt"># DeepSeek-V2 config: 128 heads × 128 dim/head</span>
<span class="cs-line"></span>
<span class="cs-line">n_h = 128   <span class="cmt"># attention heads</span></span>
<span class="cs-line">d_h = 128   <span class="cmt"># dim per head</span></span>
<span class="cs-line">n_layers = 60</span>
<span class="cs-line">ctx = 128_000  <span class="cmt"># 128K context</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># MHA: cache K and V separately</span>
<span class="cs-line hl-p">kv_per_token = 2 * n_h * d_h  <span class="cmt"># 32,768</span></span>
<span class="cs-line">total_mha = kv_per_token * n_layers * ctx</span>
<span class="cs-line cmt"># total_mha = 32768 × 60 × 128000</span>
<span class="cs-line cmt">#           = 251,658,240,000 floats</span>
<span class="cs-line cmt">#           ≈ 503 GB at bfloat16</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># MLA: cache only the latent c^KV</span>
<span class="cs-line">d_c = 512    <span class="cmt"># compressed KV dim</span></span>
<span class="cs-line">d_rope = 64  <span class="cmt"># decoupled RoPE key dim</span></span>
<span class="cs-line hl-g">kv_mla = (d_c + d_rope) * n_layers * ctx</span>
<span class="cs-line cmt"># kv_mla = 576 × 60 × 128000</span>
<span class="cs-line cmt">#        ≈ 8.8 GB at bfloat16</span>
<span class="cs-line hl-g">reduction = kv_per_token / (d_c + d_rope)</span>
<span class="cs-line cmt"># reduction = 32768 / 576 ≈ 56.9×</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-compression">
      <pre class="cs-pre">
<span class="cs-line cmt"># MLA forward pass — KV compression</span>
<span class="cs-line kw">import</span> torch
<span class="cs-line kw">import</span> torch.nn <span class="kw">as</span> nn
<span class="cs-line"></span>
<span class="cs-line kw">class</span> <span class="cls">MLALayer</span>(nn.Module):
<span class="cs-line">    <span class="kw">def</span> <span class="fn">__init__</span>(<span class="kw">self</span>, d, n_h, d_h, d_c):
<span class="cs-line">        <span class="cmt"># d=5120, n_h=128, d_h=128, d_c=512</span></span>
<span class="cs-line hl-c">        <span class="kw">self</span>.W_DKV = nn.Linear(d, d_c, bias=False)</span>
<span class="cs-line hl-c">        <span class="kw">self</span>.W_UK  = nn.Linear(d_c, n_h * d_h, bias=False)</span>
<span class="cs-line hl-c">        <span class="kw">self</span>.W_UV  = nn.Linear(d_c, n_h * d_h, bias=False)</span>
<span class="cs-line">        <span class="kw">self</span>.W_DQ  = nn.Linear(d, 1536, bias=False)</span>
<span class="cs-line">        <span class="kw">self</span>.W_UQ  = nn.Linear(1536, n_h * d_h, bias=False)</span>
<span class="cs-line"></span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">prefill</span>(<span class="kw">self</span>, h_all):
<span class="cs-line">        <span class="cmt"># h_all: (seq_len, d)</span></span>
<span class="cs-line hl-g">        c_kv = <span class="kw">self</span>.W_DKV(h_all)  <span class="cmt"># (S, 512)</span></span>
<span class="cs-line hl-g">        <span class="kw">return</span> c_kv  <span class="cmt"># ONLY THIS IS STORED</span></span>
<span class="cs-line"></span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">decode_step</span>(<span class="kw">self</span>, h_t, c_cache):
<span class="cs-line">        <span class="cmt"># c_cache: (past_seq, 512)</span></span>
<span class="cs-line">        c_q = <span class="kw">self</span>.W_DQ(h_t)         <span class="cmt"># (1, 1536)</span></span>
<span class="cs-line">        q   = <span class="kw">self</span>.W_UQ(c_q)          <span class="cmt"># (1, n_h*d_h)</span></span>
<span class="cs-line hl-p">        k   = <span class="kw">self</span>.W_UK(c_cache)      <span class="cmt"># expanded on the fly</span></span>
<span class="cs-line hl-p">        v   = <span class="kw">self</span>.W_UV(c_cache)      <span class="cmt"># expanded on the fly</span></span>
<span class="cs-line">        <span class="kw">return</span> <span class="fn">attention</span>(q, k, v)</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-absorption">
      <pre class="cs-pre">
<span class="cs-line cmt"># Matrix absorption at model load time</span>
<span class="cs-line cmt"># Fuse W^UQ^T · W^UK into a single matrix</span>
<span class="cs-line"></span>
<span class="cs-line kw">def</span> <span class="fn">prepare_for_inference</span>(model_layer):
<span class="cs-line">    W_UQ = model_layer.W_UQ.weight  <span class="cmt"># (n_h*d_h, 1536)</span></span>
<span class="cs-line">    W_UK = model_layer.W_UK.weight  <span class="cmt"># (n_h*d_h, 512)</span></span>
<span class="cs-line">    W_UV = model_layer.W_UV.weight  <span class="cmt"># (n_h*d_h, 512)</span></span>
<span class="cs-line">    W_O  = model_layer.W_O.weight   <span class="cmt"># (d, n_h*d_h)</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt">    # Pre-fuse: W_Q' = W_UQ^T · W_UK</span>
<span class="cs-line cmt">    # Shape: (1536, 512) — query latent → score</span>
<span class="cs-line hl-p">    W_Qprime = W_UQ.T @ W_UK  <span class="cmt"># (1536, 512)</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt">    # Pre-fuse: W_O' = W_UV · W_O</span>
<span class="cs-line cmt">    # Shape: (d, 512) — latent → output directly</span>
<span class="cs-line hl-g">    W_Oprime = W_UV @ W_O  <span class="cmt"># (d, 512)</span></span>
<span class="cs-line"></span>
<span class="cs-line kw">    return</span> W_Qprime, W_Oprime</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Inference: no key/value materialization</span>
<span class="cs-line kw">def</span> <span class="fn">decode_absorbed</span>(c_q, c_cache, W_Qprime, W_Oprime):
<span class="cs-line">    <span class="cmt"># c_q: (1, 1536), c_cache: (S, 512)</span></span>
<span class="cs-line hl-c">    scores = c_q @ W_Qprime @ c_cache.T  <span class="cmt"># (1, S)</span></span>
<span class="cs-line">    weights = softmax(scores / sqrt(d_h))</span>
<span class="cs-line hl-c">    out = weights @ c_cache @ W_Oprime.T  <span class="cmt"># (1, d)</span></span>
<span class="cs-line">    <span class="kw">return</span> out  <span class="cmt"># full output, no k/v expanded</span></span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-rope">
      <pre class="cs-pre">
<span class="cs-line cmt"># Decoupled RoPE implementation</span>
<span class="cs-line cmt"># Two separate paths: content + position</span>
<span class="cs-line"></span>
<span class="cs-line kw">class</span> <span class="cls">MLAWithRoPE</span>(nn.Module):
<span class="cs-line">    <span class="kw">def</span> <span class="fn">__init__</span>(<span class="kw">self</span>, d, n_h, d_h, d_c, d_rope=64):
<span class="cs-line">        <span class="cmt"># Content path (absorb-able, no RoPE)</span></span>
<span class="cs-line hl-c">        <span class="kw">self</span>.W_DKV = nn.Linear(d, d_c)</span>
<span class="cs-line hl-c">        <span class="kw">self</span>.W_UK  = nn.Linear(d_c, n_h * d_h)</span>
<span class="cs-line"></span>
<span class="cs-line">        <span class="cmt"># Position path (not absorb-able, uses RoPE)</span></span>
<span class="cs-line hl-a">        <span class="kw">self</span>.W_KR = nn.Linear(d, d_rope)  <span class="cmt"># shared key</span></span>
<span class="cs-line hl-a">        <span class="kw">self</span>.W_QR = nn.Linear(1536, n_h * d_rope)</span>
<span class="cs-line"></span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">get_keys</span>(<span class="kw">self</span>, h_t, pos):
<span class="cs-line">        <span class="cmt"># Content key: from compressed latent</span></span>
<span class="cs-line hl-c">        c_kv = <span class="kw">self</span>.W_DKV(h_t)  <span class="cmt"># 512-dim</span></span>
<span class="cs-line hl-c">        k_c  = <span class="kw">self</span>.W_UK(c_kv)  <span class="cmt"># n_h * d_h</span></span>
<span class="cs-line"></span>
<span class="cs-line">        <span class="cmt"># Position key: RoPE-encoded, shared</span></span>
<span class="cs-line hl-a">        k_r = rope(<span class="kw">self</span>.W_KR(h_t), pos)  <span class="cmt"># 64-dim</span></span>
<span class="cs-line"></span>
<span class="cs-line">        <span class="cmt"># Cache both: 512 + 64 = 576 floats</span></span>
<span class="cs-line hl-g">        <span class="kw">return</span> c_kv, k_r  <span class="cmt"># store these in KV cache</span></span>
<span class="cs-line"></span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">attention_score</span>(<span class="kw">self</span>, q_c, q_r, k_c, k_r):
<span class="cs-line">        <span class="cmt"># q_c (content) · k_c (absorbed into W_Q')</span></span>
<span class="cs-line">        s_content = q_c @ k_c.T</span>
<span class="cs-line">        <span class="cmt"># q_r (RoPE) · k_r (RoPE) — relative position</span></span>
<span class="cs-line">        s_pos = q_r @ k_r.T</span>
<span class="cs-line hl-p">        <span class="kw">return</span> (s_content + s_pos) / sqrt(d_h + 64)</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-math">
      <pre class="cs-pre">
<span class="cs-line cmt"># KV cache size comparison</span>
<span class="cs-line cmt"># DeepSeek-V2 config: n_h=128, d_h=128</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># ── MHA ──────────────────────────────</span>
<span class="cs-line hl-p">mha = 2 * 128 * 128  <span class="cmt"># = 32,768 floats</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># ── GQA (8 groups) ───────────────────</span>
<span class="cs-line">gqa = 2 * 8 * 128    <span class="cmt"># = 2,048 floats</span></span>
<span class="cs-line cmt"># 16× smaller than MHA, quality drops</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># ── MQA (1 group) ────────────────────</span>
<span class="cs-line">mqa = 2 * 1 * 128    <span class="cmt"># = 256 floats</span></span>
<span class="cs-line cmt"># 128× smaller, quality drops more</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># ── MLA ──────────────────────────────</span>
<span class="cs-line hl-g">d_c = 512   <span class="cmt"># KV compression dim</span></span>
<span class="cs-line hl-g">d_r = 64    <span class="cmt"># decoupled RoPE key dim</span></span>
<span class="cs-line hl-g">mla = d_c + d_r  <span class="cmt"># = 576 floats</span></span>
<span class="cs-line cmt"># 56.9× smaller than MHA</span>
<span class="cs-line cmt"># STRONGER quality than MHA</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Effective "GQA equivalent":</span>
<span class="cs-line">equiv_groups = mla / (2 * 128)  <span class="cmt"># = 2.25</span></span>
<span class="cs-line cmt"># MLA ≈ GQA with only 2.25 groups</span>
<span class="cs-line cmt"># but beats full 128-group MHA</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># At 128K context, 60 layers (bfloat16):</span>
<span class="cs-line cmt"># MHA:  503 GB</span>
<span class="cs-line cmt"># GQA8:  31 GB</span>
<span class="cs-line cmt"># MLA:  8.8 GB  ← fits in a single A100</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-results">
      <pre class="cs-pre">
<span class="cs-line cmt"># DeepSeek-V2 (MLA) vs baselines</span>
<span class="cs-line cmt"># Base model benchmarks</span>
<span class="cs-line"></span>
<span class="cs-line cmt">benchmark_results = {</span>
<span class="cs-line">    <span class="str">"MMLU_5shot"</span>: {</span>
<span class="cs-line">        <span class="str">"DeepSeek_67B"</span>:  <span class="num">71.3</span>,</span>
<span class="cs-line">        <span class="str">"LLaMA3_70B"</span>:   <span class="num">78.9</span>,</span>
<span class="cs-line">        <span class="str">"Mixtral_8x22B"</span>: <span class="num">77.6</span>,</span>
<span class="cs-line">        <span class="str">"Qwen15_72B"</span>:   <span class="num">77.2</span>,</span>
<span class="cs-line hl-p">        <span class="str">"DeepSeek_V2"</span>:  <span class="num">78.5</span>,  <span class="cmt"># ★</span></span>
<span class="cs-line">    },</span>
<span class="cs-line">    <span class="str">"MATH_4shot"</span>: {</span>
<span class="cs-line">        <span class="str">"DeepSeek_67B"</span>:  <span class="num">18.7</span>,</span>
<span class="cs-line">        <span class="str">"LLaMA3_70B"</span>:   <span class="num">42.2</span>,</span>
<span class="cs-line">        <span class="str">"Mixtral_8x22B"</span>: <span class="num">42.5</span>,</span>
<span class="cs-line">        <span class="str">"Qwen15_72B"</span>:   <span class="num">41.4</span>,</span>
<span class="cs-line hl-p">        <span class="str">"DeepSeek_V2"</span>:  <span class="num">43.6</span>,  <span class="cmt"># best ★</span></span>
<span class="cs-line">    },</span>
<span class="cs-line">}</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Throughput on 8× H800 GPUs</span>
<span class="cs-line">throughput = {</span>
<span class="cs-line">    <span class="str">"DeepSeek_67B"</span>: <span class="num">8696</span>,   <span class="cmt"># tok/s</span></span>
<span class="cs-line hl-g">    <span class="str">"DeepSeek_V2"</span>:  <span class="num">50083</span>,  <span class="cmt"># 5.76× faster</span></span>
<span class="cs-line">}</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Training cost</span>
<span class="cs-line">train_cost = {</span>
<span class="cs-line">    <span class="str">"DeepSeek_67B"</span>: <span class="num">300.6e3</span>,  <span class="cmt"># GPU-hours/T-tok</span></span>
<span class="cs-line hl-g">    <span class="str">"DeepSeek_V2"</span>:  <span class="num">172.8e3</span>,  <span class="cmt"># 42.5% cheaper</span></span>
<span class="cs-line">}</span>
      </pre>
    </div>

  </div>
</aside>

</div><!-- /post-grid -->

<script>
// ── TOC + sidebar toggles ────────────────────────────────────────────
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});

const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ── Code sidebar tabs ────────────────────────────────────────────────
const tabMeta = {
  bottleneck:  { file: 'mla/kv_cache.py',     title: 'KV Cache Problem' },
  compression: { file: 'mla/compression.py',  title: 'Low-Rank Compression' },
  absorption:  { file: 'mla/absorption.py',   title: 'Matrix Absorption' },
  rope:        { file: 'mla/rope.py',          title: 'Decoupled RoPE' },
  math:        { file: 'mla/cache_math.py',    title: 'Cache Math' },
  results:     { file: 'mla/benchmarks.py',    title: 'Benchmark Results' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ── IntersectionObserver — TOC + sidebar sync ────────────────────────
const sectionMap = {
  's-bottleneck': 'bottleneck',
  's-compression': 'compression',
  's-absorption': 'absorption',
  's-rope': 'rope',
  's-math': 'math',
  's-results': 'results',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ── KV Cache growth canvas ───────────────────────────────────────────
(function() {
  const canvas = document.getElementById('cache-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const H_CANVAS = 240;

  function resize() {
    const W = canvas.clientWidth;
    canvas.width = W * DPR;
    canvas.height = H_CANVAS * DPR;
    ctx.scale(DPR, DPR);
    draw(parseInt(document.getElementById('seq-slider').value));
  }

  const METHODS = [
    { label: 'MHA',      color: '#ef4444', floats: function(k) { return 2 * 128 * 128; } },
    { label: 'GQA (g=8)',color: '#f59e0b', floats: function(k) { return 2 * 8 * 128; } },
    { label: 'MQA',      color: '#6b7280', floats: function(k) { return 2 * 1 * 128; } },
    { label: 'MLA',      color: '#8b5cf6', floats: function(k) { return 576; } },
  ];

  function gbAtSeqLen(method, seqK) {
    // seqK in thousands of tokens, 60 layers, bfloat16 (2 bytes)
    return method.floats() * 60 * seqK * 1000 * 2 / 1e9;
  }

  function draw(seqK) {
    const W = canvas.clientWidth;
    const H = H_CANVAS;
    ctx.clearRect(0, 0, W, H);

    const PAD_L = 54, PAD_R = 24, PAD_T = 18, PAD_B = 32;
    const chartW = W - PAD_L - PAD_R;
    const chartH = H - PAD_T - PAD_B;

    // Max GB at seqK=128 for MHA
    const maxGB = gbAtSeqLen(METHODS[0], 128);

    function xOf(k) { return PAD_L + (k / 128) * chartW; }
    function yOf(gb) { return PAD_T + chartH - (gb / maxGB) * chartH; }

    // Grid
    ctx.strokeStyle = 'rgba(255,255,255,0.04)';
    ctx.lineWidth = 1;
    [0, 0.25, 0.5, 0.75, 1.0].forEach(f => {
      const y = PAD_T + f * chartH;
      ctx.beginPath(); ctx.moveTo(PAD_L, y); ctx.lineTo(PAD_L + chartW, y); ctx.stroke();
      const gbVal = maxGB * (1 - f);
      ctx.fillStyle = '#4b5563'; ctx.font = '9px var(--ff-mono)';
      ctx.textAlign = 'right';
      ctx.fillText(gbVal >= 10 ? Math.round(gbVal) + 'G' : gbVal.toFixed(0) + 'G', PAD_L - 5, y + 3);
    });

    // X axis ticks
    ctx.fillStyle = '#4b5563'; ctx.font = '9px var(--ff-mono)'; ctx.textAlign = 'center';
    [16, 32, 64, 128].forEach(k => {
      ctx.fillText(k + 'K', xOf(k), H - PAD_B + 14);
    });
    ctx.fillStyle = '#6b7280'; ctx.font = '9px var(--ff-mono)';
    ctx.fillText('Context length (tokens)', PAD_L + chartW / 2, H - 4);

    // Lines
    METHODS.forEach(m => {
      ctx.beginPath();
      ctx.strokeStyle = m.color;
      ctx.lineWidth = m.label === 'MLA' ? 2.5 : 1.5;
      ctx.globalAlpha = m.label === 'MLA' ? 1 : 0.6;
      for (let k = 1; k <= 128; k++) {
        const gb = gbAtSeqLen(m, k);
        const x = xOf(k), y = yOf(gb);
        k === 1 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
      }
      ctx.stroke();
      ctx.globalAlpha = 1;

      // End label
      const gb = gbAtSeqLen(m, 128);
      ctx.fillStyle = m.color;
      ctx.font = (m.label === 'MLA' ? 'bold ' : '') + '9px var(--ff-mono)';
      ctx.textAlign = 'left';
      ctx.fillText(m.label, xOf(128) + 4, yOf(gb) + 3);
    });

    // Vertical cursor at seqK
    const xCur = xOf(seqK);
    ctx.setLineDash([3, 3]);
    ctx.strokeStyle = 'rgba(255,255,255,0.25)';
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(xCur, PAD_T); ctx.lineTo(xCur, PAD_T + chartH); ctx.stroke();
    ctx.setLineDash([]);

    // Dot + label for each method at cursor
    METHODS.forEach(m => {
      const gb = gbAtSeqLen(m, seqK);
      const x = xCur, y = yOf(gb);
      ctx.beginPath();
      ctx.arc(x, y, m.label === 'MLA' ? 4 : 3, 0, Math.PI * 2);
      ctx.fillStyle = m.color;
      ctx.fill();
    });

    // MLA vs MHA annotation at cursor
    const gbMHA = gbAtSeqLen(METHODS[0], seqK);
    const gbMLA = gbAtSeqLen(METHODS[3], seqK);
    const ratio = (gbMHA / gbMLA).toFixed(0);
    ctx.fillStyle = '#8b5cf6'; ctx.font = 'bold 10px var(--ff-mono)'; ctx.textAlign = 'center';
    const labelX = Math.min(xCur + 60, PAD_L + chartW - 40);
    ctx.fillText(ratio + '× smaller (MLA)', labelX, PAD_T + 14);
  }

  const slider = document.getElementById('seq-slider');
  const seqValEl = document.getElementById('seq-val');
  slider?.addEventListener('input', () => {
    const k = parseInt(slider.value);
    seqValEl.textContent = k + 'K tokens';
    draw(k);
  });

  window.addEventListener('resize', resize);
  resize();
})();

// ── Step navigator (absorption steps) ───────────────────────────────
(function() {
  let step = 0;
  const boxes   = document.querySelectorAll('#absorb-steps .step-box');
  const prevBtn = document.getElementById('absorb-prev');
  const nextBtn = document.getElementById('absorb-next');
  const progEl  = document.getElementById('absorb-prog');

  function updateSteps() {
    boxes.forEach((b, i) => {
      b.classList.remove('active', 'done');
      if (i === step) b.classList.add('active');
      else if (i < step) b.classList.add('done');
    });
    if (prevBtn) prevBtn.disabled = step === 0;
    if (nextBtn) nextBtn.disabled = step === boxes.length - 1;
    if (progEl) progEl.textContent = 'Step ' + (step + 1) + ' of ' + boxes.length;
    boxes.forEach((b, i) => {
      const n = b.querySelector('.step-num');
      if (n) n.textContent = i < step ? '✓' : String(i + 1);
    });
  }

  prevBtn?.addEventListener('click', () => { if (step > 0) { step--; updateSteps(); } });
  nextBtn?.addEventListener('click', () => { if (step < boxes.length - 1) { step++; updateSteps(); } });
  updateSteps();
})();

// ── Animated bar charts (IntersectionObserver) ───────────────────────
function animateBars(containerId) {
  const section = document.getElementById(containerId);
  if (!section) return;
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        section.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          b.style.width = parseFloat(b.dataset.w) + '%';
        });
      }
    });
  }, { threshold: 0.3 }).observe(section);
}
animateBars('s-math');
animateBars('s-results');
</script>
</BaseLayout>

<span class="cs-line hl-p">LLAMA_8B  = &#123;<span class="str">"eagle"</span>: <span class="num">63015</span>,  <span class="str">"sf"</span>: <span class="num">126640</span>,  <span class="str">"speedup"</span>: <span class="num">2.01</span>&#125;</span>
<span class="cs-line hl-p">LLAMA_70B = &#123;<span class="str">"eagle"</span>: <span class="num">14827</span>,  <span class="str">"sf"</span>: <span class="num">20609</span>,   <span class="str">"speedup"</span>: <span class="num">1.39</span>&#125;</span>

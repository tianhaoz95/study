<span class="cs-line cmt"># Sparse Tree Attention — paper §4.2.1</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Algorithm 2: BlockMask for TTT attention</span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">build_block_mask</span>(b, qi, kvi, qlen, T):</span>
<span class="cs-line hl-p">    <span class="cmt"># Causal component: attend to training prefix</span></span>
<span class="cs-line hl-p">    mcausal = (qi &gt;= kvi) &amp; (kvi &lt; T)</span>
<span class="cs-line"> </span>
<span class="cs-line hl-c">    <span class="cmt"># Suffix component: attend to prior TTT steps</span></span>
<span class="cs-line hl-c">    msuffix = (kvi &gt;= qlen) \</span>
<span class="cs-line hl-c">            &amp; (kvi % qlen &lt; T) \</span>
<span class="cs-line hl-c">            &amp; ((kvi - qi) % qlen == 0)</span>
<span class="cs-line"> </span>
<span class="cs-line hl-g">    <span class="kw">return</span> mcausal | msuffix  <span class="cmt"># → BlockMask</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># FlexAttention uses BlockMask to compute</span>
<span class="cs-line cmt"># attention streaming — no N×N intermediate</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Measured gains at seq_len=4096 (H200):</span>
<span class="cs-line">time_reduction   = <span class="num">0.621</span>   <span class="cmt"># 62.1%</span></span>
<span class="cs-line">memory_reduction = <span class="num">0.935</span>   <span class="cmt"># 93.5%</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Algorithm 3: in-place gradient kernel</span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">inplace_log_softmax_backward</span>(z, p, g):</span>
<span class="cs-line">    <span class="cmt"># Reuse logit tensor z for gradient — no new alloc</span></span>
<span class="cs-line">    s   = (p * g).sum()  <span class="cmt"># scalar upstream sum</span></span>
<span class="cs-line">    pi  = softmax(z)     <span class="cmt"># stable softmax</span></span>
<span class="cs-line hl-a">    z   = -(p * g - pi * s)  <span class="cmt"># overwrite in-place!</span></span>
<span class="cs-line hl-a">    <span class="cmt"># Memory saving: 30-40% (context/vocab dependent)</span></span>
      </pre>

  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ── Code sidebar tab switching ──
const tabMeta = {
  problem:    { file: 'specforge_config.py',   title: 'The Problem' },
  causes:     { file: 'bottlenecks.py',        title: 'Three Bottlenecks' },
  decouple:   { file: 'decoupling.yaml',       title: 'Target–Draft Decoupling' },
  attention:  { file: 'flex_attention.py',     title: 'Sparse Tree Attention' },
  throughput: { file: 'table1_results.py',     title: 'Throughput Numbers' },
  quality:    { file: 'specbundle_recipe.py',  title: 'SpecBundle Training' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ── IntersectionObserver ──
const sectionMap = {
  's-problem':    'problem',
  's-causes':     'causes',
  's-decouple':   'decouple',
  's-attention':  'attention',
  's-throughput': 'throughput',
  's-quality':    'quality',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ── §02: Bottleneck breakdown canvas ──
(function() {
  const canvas = document.getElementById('cause-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;

  // Data: [targetPrefill%, tttAttn%, draftFwdBwd%, commOverhead%]
  // Based on paper: SGLang 2x (=50% prefill time saved) and FlexAttn 62.1% TTT time
  // For 8B: prefill dominated but moderate; for 235B: comm/prefill dominate
  const DATA = {
    '8b': {
      label: 'LLaMA-3.1-8B  (8× H200)',
      naive:  [48, 22, 26, 4],  // prefill, TTT, draft, comm
      sf:     [18,  8, 68, 6],
    },
    '30b': {
      label: 'Qwen3-30B MoE  (8× H200)',
      naive:  [52, 20, 24, 4],
      sf:     [12,  6, 72, 10],
    },
    '235b': {
      label: 'Qwen3-235B MoE  (8× H200)',
      naive:  [22, 15, 12, 51],  // comm dominates in ZeRO-3
      sf:     [10,  6, 72, 12],
    },
  };

  const COLORS = [
    'rgba(239,68,68,.75)',
    'rgba(245,158,11,.75)',
    'rgba(139,92,246,.85)',
    'rgba(107,114,128,.55)',
  ];
  const LABELS = ['Target Prefill', 'TTT Attention', 'Draft FWD+BWD', 'Comm Overhead'];

  let activeCause = '8b';

  function draw() {
    const W = canvas.clientWidth, H = 220;
    canvas.width  = W * DPR;
    canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
    ctx.clearRect(0, 0, W, H);

    const d = DATA[activeCause];
    const PAD_L = 120, PAD_R = 24, PAD_T = 36, BAR_H = 44, GAP = 24;

    const barW = W - PAD_L - PAD_R;

    // Title
    ctx.fillStyle = '#abb2bf';
    ctx.font = 'bold 11px monospace';
    ctx.textAlign = 'left';
    ctx.fillText(d.label, PAD_L, 20);

    ['naive', 'sf'].forEach((k, row) => {
      const y = PAD_T + row * (BAR_H + GAP);
      const lbl = k === 'naive' ? 'Baseline (EAGLE)' : 'SpecForge';
      const pcts = d[k];

      // Row label
      ctx.fillStyle = k === 'sf' ? '#8b5cf6' : '#6b7280';
      ctx.font = '10px monospace';
      ctx.textAlign = 'right';
      ctx.fillText(lbl, PAD_L - 8, y + BAR_H / 2 + 4);

      // Draw stacked bar
      let x = PAD_L;
      pcts.forEach((p, i) => {
        const w = barW * p / 100;
        ctx.fillStyle = COLORS[i];
        ctx.fillRect(x, y, w, BAR_H);
        if (w > 28) {
          ctx.fillStyle = 'rgba(255,255,255,.85)';
          ctx.font = 'bold 10px monospace';
          ctx.textAlign = 'center';
          ctx.fillText(p + '%', x + w / 2, y + BAR_H / 2 + 4);
        }
        x += w;
      });
    });

    // Step-time annotations
    const stepTimes = {
      '8b':   ['1.04s / step', '0.52s / step → 2.01×'],
      '30b':  ['1.12s / step (ZeRO-2)', '0.52s / step → 4.31×'],
      '235b': ['11.2s / step (ZeRO-3)', '1.62s / step → 9.99×'],
    };
    const [t_naive, t_sf] = stepTimes[activeCause];
    ctx.fillStyle = '#6b7280';
    ctx.font = '9px monospace';
    ctx.textAlign = 'left';
    ctx.fillText(t_naive, PAD_L + 4, PAD_T + BAR_H + 6);
    ctx.fillStyle = '#a78bfa';
    ctx.fillText(t_sf, PAD_L + 4, PAD_T + BAR_H + GAP + BAR_H + 6);
  }

  document.querySelectorAll('#cause-btns .model-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('#cause-btns .model-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeCause = btn.dataset.cause;
      draw();
    });
  });

  draw();
  window.addEventListener('resize', draw);
})();

// ── §03: Backend bars (IntersectionObserver trigger) ──
const decoupleSect = document.getElementById('s-decouple');
if (decoupleSect) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('#backend-bars .bar-fill[data-w]').forEach(b => {
          b.style.width = b.dataset.w + '%';
        });
      }
    });
  }, { threshold: 0.3 }).observe(decoupleSect);
}

// ── §04: Attention memory canvas ──
(function() {
  const canvas = document.getElementById('attn-canvas');
  const slider = document.getElementById('seqlen-slider');
  const label  = document.getElementById('seqlen-label');
  if (!canvas || !slider) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;

  // Seq lens: 128, 512, 1024, 2048, 4096
  const SEQ_LENS = [128, 512, 1024, 2048, 4096];
  // SDPA memory (relative units): grows ~O(L^2), normalized so at 4096 = 100
  // At 4096 FlexAttn = 6.5% of naive (93.5% reduction)
  // Normalize: naive[4096]=100, naive[128]=100*(128/4096)^2=0.098, etc.
  function naiveMem(l) { return 100 * (l / 4096) ** 2; }
  // FlexAttn: grows ~O(L * block_size), at 4096 = 6.5
  function flexMem(l) { return 6.5 * (l / 4096); }

  // SDPA time (relative): similar quadratic growth, at 4096=100
  function naiveTime(l) { return 100 * (l / 4096) ** 1.8; }
  // FlexAttn time: at 4096 = 37.9% of naive
  function flexTime(l) { return 37.9 * (l / 4096) ** 1.2; }

  let activeIdx = 4;  // default 4096

  function resize() {
    const W = canvas.clientWidth, H = 260;
    canvas.width  = W * DPR;
    canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
    draw(activeIdx);
  }

  function draw(idx) {
    const W = canvas.clientWidth, H = 260;
    const PAD = { l: 58, r: 24, t: 20, b: 44 };
    const CW = W - PAD.l - PAD.r;
    const CH = H - PAD.t - PAD.b;

    ctx.clearRect(0, 0, W, H);

    const n = SEQ_LENS.length;
    const xPos = SEQ_LENS.map((_, i) => PAD.l + (i / (n - 1)) * CW);

    // Grid
    [0, 25, 50, 75, 100].forEach(v => {
      const y = PAD.t + CH * (1 - v / 100);
      ctx.strokeStyle = 'rgba(255,255,255,.05)';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(PAD.l, y);
      ctx.lineTo(PAD.l + CW, y);
      ctx.stroke();
      ctx.fillStyle = 'rgba(107,114,128,.6)';
      ctx.font = '9px monospace';
      ctx.textAlign = 'right';
      ctx.fillText(v, PAD.l - 6, y + 3);
    });

    // X labels
    SEQ_LENS.forEach((l, i) => {
      ctx.fillStyle = 'rgba(107,114,128,.6)';
      ctx.font = '9px monospace';
      ctx.textAlign = 'center';
      ctx.fillText(l >= 1024 ? (l/1024)+'k' : l, xPos[i], PAD.t + CH + 20);
    });

    // Axes
    ctx.strokeStyle = 'rgba(255,255,255,.15)';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(PAD.l, PAD.t);
    ctx.lineTo(PAD.l, PAD.t + CH);
    ctx.lineTo(PAD.l + CW, PAD.t + CH);
    ctx.stroke();

    // Y label
    ctx.save();
    ctx.translate(12, PAD.t + CH / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.fillStyle = 'rgba(107,114,128,.6)';
    ctx.font = '9px monospace';
    ctx.textAlign = 'center';
    ctx.fillText('Relative Memory (%)', 0, 0);
    ctx.restore();

    // Draw memory lines
    function drawLine(fn, color, dashed) {
      ctx.beginPath();
      SEQ_LENS.forEach((l, i) => {
        const v = Math.min(fn(l), 100);
        const y = PAD.t + CH * (1 - v / 100);
        if (i === 0) ctx.moveTo(xPos[i], y);
        else ctx.lineTo(xPos[i], y);
      });
      ctx.strokeStyle = color;
      ctx.lineWidth = 2.5;
      if (dashed) ctx.setLineDash([6, 3]);
      else ctx.setLineDash([]);
      ctx.stroke();
      ctx.setLineDash([]);

      // Dots
      SEQ_LENS.forEach((l, i) => {
        const v = Math.min(fn(l), 100);
        const y = PAD.t + CH * (1 - v / 100);
        const isActive = i === idx;
        ctx.beginPath();
        ctx.arc(xPos[i], y, isActive ? 7 : 4, 0, Math.PI * 2);
        ctx.fillStyle = isActive ? color : 'rgba(0,0,0,.5)';
        ctx.fill();
        ctx.strokeStyle = color;
        ctx.lineWidth = 1.5;
        ctx.stroke();
        if (isActive) {
          ctx.fillStyle = '#f0f0f8';
          ctx.font = 'bold 10px monospace';
          ctx.textAlign = 'center';
          ctx.fillText(v.toFixed(1) + '%', xPos[i], y - 12);
        }
      });
    }

    drawLine(naiveMem, 'rgba(239,68,68,.85)', false);
    drawLine(flexMem,  'rgba(16,185,129,.9)', false);

    // Annotation at active point
    const sl = SEQ_LENS[idx];
    const nm = Math.min(naiveMem(sl), 100);
    const fm = flexMem(sl);
    const reduction = ((1 - fm / nm) * 100).toFixed(1);
    const ax = xPos[idx];
    ctx.strokeStyle = 'rgba(245,158,11,.4)';
    ctx.lineWidth = 1;
    ctx.setLineDash([4, 3]);
    ctx.beginPath();
    ctx.moveTo(ax, PAD.t);
    ctx.lineTo(ax, PAD.t + CH);
    ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle = 'rgba(245,158,11,.9)';
    ctx.font = 'bold 10px monospace';
    ctx.textAlign = 'center';
    ctx.fillText(reduction + '% reduction', ax, PAD.t + 12);
  }

  slider.addEventListener('input', () => {
    activeIdx = parseInt(slider.value);
    label.textContent = SEQ_LENS[activeIdx].toString();
    resize();
  });

  resize();
  window.addEventListener('resize', resize);
})();

// ── §05: Throughput canvas with model selector ──
(function() {
  const canvas = document.getElementById('tp-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;

  const DATA = {
    '8b':   { label: 'LLaMA-3.1-8B (Dense)',     eagle: 63015,  sf: 126640,  speedup: 2.01, step_e: 1.04,  step_s: 0.52,  oom: false },
    '70b':  { label: 'LLaMA-3.3-70B (Dense)',     eagle: 14827,  sf: 20609,   speedup: 1.39, step_e: 2.21,  step_s: 3.18,  oom: false },
    '30b':  { label: 'Qwen3-30B-A3B (MoE)',       eagle: 29257,  sf: 126031,  speedup: 4.31, step_e: 1.12,  step_s: 0.52,  oom: false },
    '235b': { label: 'Qwen3-235B-A22B (MoE)',     eagle: 2026,   sf: 20227,   speedup: 9.99, step_e: 11.2,  step_s: 1.62,  oom: true  },
  };

  let activeTP = '8b';

  function resize() {
    const W = canvas.clientWidth, H = 320;
    canvas.width  = W * DPR;
    canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
    draw(activeTP);
  }

  function draw(key) {
    const d = DATA[key];
    const W = canvas.clientWidth, H = 320;
    ctx.clearRect(0, 0, W, H);

    const PAD = { l: 60, r: 30, t: 50, b: 60 };
    const CW = W - PAD.l - PAD.r;
    const CH = H - PAD.t - PAD.b;

    // Title
    ctx.fillStyle = '#f0f0f8';
    ctx.font = 'bold 12px monospace';
    ctx.textAlign = 'center';
    ctx.fillText(d.label + '  ·  8× H200  ·  seq=4096', W/2, 24);

    // Speedup badge
    ctx.fillStyle = d.speedup >= 5 ? '#10b981' : d.speedup >= 3 ? '#a78bfa' : '#06b6d4';
    ctx.font = 'bold 28px monospace';
    ctx.textAlign = 'center';
    ctx.fillText(d.speedup + '×', W - 80, 32);
    ctx.fillStyle = '#6b7280';
    ctx.font = '9px monospace';
    ctx.fillText('speedup', W - 80, 44);

    // Two bars
    const maxTok = Math.max(d.eagle, d.sf);
    const barH = 56;
    const gap  = 36;

    const bars = [
      { label: 'EAGLE Baseline', val: d.eagle, color: 'rgba(107,114,128,.55)', extra: d.oom ? '(ZeRO-3; ZeRO-2 OOM)' : '(ZeRO-2)' },
      { label: 'SpecForge',      val: d.sf,    color: 'rgba(139,92,246,.9)',  extra: '' },
    ];

    bars.forEach((bar, i) => {
      const y = PAD.t + i * (barH + gap);
      const bw = CW * (bar.val / maxTok);

      // Bar
      ctx.fillStyle = bar.color;
      ctx.beginPath();
      ctx.roundRect(PAD.l, y, bw, barH, 6);
      ctx.fill();

      // Label
      ctx.fillStyle = '#abb2bf';
      ctx.font = '10px monospace';
      ctx.textAlign = 'right';
      ctx.fillText(bar.label, PAD.l - 8, y + barH/2 + 4);

      // Value
      ctx.fillStyle = '#f0f0f8';
      ctx.font = 'bold 11px monospace';
      ctx.textAlign = 'left';
      const tokStr = bar.val >= 100000 ? (bar.val/1000).toFixed(0)+'k' : bar.val.toLocaleString();
      ctx.fillText(tokStr + ' tok/s', bw > 100 ? PAD.l + bw - 80 : PAD.l + bw + 6, y + barH/2 + 4);

      // Extra note
      if (bar.extra) {
        ctx.fillStyle = '#6b7280';
        ctx.font = '9px monospace';
        ctx.fillText(bar.extra, PAD.l + 6, y + barH - 8);
      }
    });

    // Step time section
    const stepY = PAD.t + 2 * (barH + gap) + 8;
    ctx.fillStyle = 'rgba(255,255,255,.06)';
    ctx.beginPath();
    ctx.roundRect(PAD.l, stepY, CW, 58, 6);
    ctx.fill();
    ctx.fillStyle = '#6b7280';
    ctx.font = '10px monospace';
    ctx.textAlign = 'left';
    ctx.fillText('Step time (batch=8, seq=4096):', PAD.l + 8, stepY + 18);

    const sf_step_ms = Math.round(8*4096/d.sf * 1000);
    const eagle_step_ms = Math.round(8*4096/d.eagle * 1000);

    ctx.fillStyle = '#6b7280';
    ctx.font = '11px monospace';
    ctx.fillText('Baseline:', PAD.l + 8, stepY + 36);
    ctx.fillStyle = '#abb2bf';
    ctx.fillText(eagle_step_ms >= 1000 ? (eagle_step_ms/1000).toFixed(1)+'s' : eagle_step_ms+'ms', PAD.l + 90, stepY + 36);

    ctx.fillStyle = '#a78bfa';
    ctx.font = '11px monospace';
    ctx.fillText('SpecForge:', PAD.l + 180, stepY + 36);
    ctx.fillStyle = '#a78bfa';
    ctx.fillText(sf_step_ms >= 1000 ? (sf_step_ms/1000).toFixed(1)+'s' : sf_step_ms+'ms', PAD.l + 268, stepY + 36);

    // Step reduction
    const red = ((1 - d.sf > d.eagle ? d.eagle/d.sf : d.step_s/d.step_e) * 100);
    ctx.fillStyle = '#10b981';
    ctx.font = 'bold 10px monospace';
    ctx.textAlign = 'right';
    ctx.fillText('step time: ' + d.step_e + 's → ' + d.step_s + 's', PAD.l + CW - 4, stepY + 36);

    ctx.fillStyle = '#6b7280';
    ctx.font = '9px monospace';
    ctx.textAlign = 'left';
    ctx.fillText('* batch size varies per config; step time computed at batch=8 for comparison', PAD.l, stepY + 54);
  }

  document.querySelectorAll('#tp-btns .model-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('#tp-btns .model-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeTP = btn.dataset.tp;
      resize();
    });
  });

  resize();
  window.addEventListener('resize', resize);
})();

// ── §06: SpecBundle bars ──
const qualitySect = document.getElementById('s-quality');
if (qualitySect) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('#sb-bars .bar-fill[data-w]').forEach(b => {
          b.style.width = b.dataset.w + '%';
        });
      }
    });
  }, { threshold: 0.3 }).observe(qualitySect);
}
</script>
</BaseLayout>

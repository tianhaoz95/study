<span class="cs-line cmt"># Speedup formula</span>
<span class="cs-line hl-p">S = (1 - alpha**(gamma+1)) / ((1-alpha)*(1+gamma*c))</span>
<span class="cs-line cmt"># alpha=per-token accept rate, gamma=budget, c=cost ratio</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Dataset comparison (LLaMA-3.1-8B, Math500)</span>
<span class="cs-line">BASELINE = dict(</span>
<span class="cs-line hl-a">    "data":  "ShareGPT+UltraChat",</span>
<span class="cs-line hl-a">    "total": 320_000,</span>
<span class="cs-line hl-a">    "tau":   2.82,</span>
<span class="cs-line hl-a">    cover=["chat"],</span>
<span class="cs-line">)</span>
<span class="cs-line">SPECBUNDLE = dict(</span>
<span class="cs-line hl-g">    "data":  "Open-PerfectBlend",</span>
<span class="cs-line hl-g">    "total": 1_400_000,</span>
<span class="cs-line hl-g">    "tau":   3.48,</span>
<span class="cs-line hl-g">    cover=["chat","math","code","instruct"],</span>
<span class="cs-line">)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># delta = (3.48 - 2.82) / 2.82 = +23.4%</span>
<span class="cs-line hl-c">delta_tau = 0.234</span>
<span class="cs-line hl-c">speedup_gain = 1.17  <span class="cmt"># x over baseline</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># On coding benchmarks: gap = 1.61x to 4.48x</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-wall">
      <pre class="cs-pre">
<span class="cs-line cmt"># EAGLE-2 data wall (arXiv:2503.01840 Fig.1)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># EAGLE-1/2 train two losses:</span>
<span class="cs-line hl-a">loss = l_fea + l_token</span>
<span class="cs-line cmt"># l_fea creates architectural constraint</span>
<span class="cs-line cmt"># f_hat(t+1) != f(t+1) at inference</span>
<span class="cs-line cmt"># -> step-2 falls off training distribution</span>
<span class="cs-line cmt"># -> more data cannot fix this</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Scaling (MT-bench, LLaMA-3.1-8B)</span>
<span class="cs-line">EAGLE2_scaling = &#123;  # tau by data scale</span>
<span class="cs-line hl-a">    1: 3.70,  <span class="cmt"># 1x ShareGPT baseline</span></span>
<span class="cs-line hl-a">    2: 3.73,</span>
<span class="cs-line hl-a">    4: 3.74,</span>
<span class="cs-line hl-a">    8: 3.75,  <span class="cmt"># barely moves</span></span>
<span class="cs-line">}</span>
<span class="cs-line">EAGLE3_scaling = &#123;  # tau by data scale</span>
<span class="cs-line hl-g">    1: 3.80,  <span class="cmt"># 1x ShareGPT baseline</span></span>
<span class="cs-line hl-g">    2: 3.95,</span>
<span class="cs-line hl-g">    4: 4.20,</span>
<span class="cs-line hl-g">    8: 4.40,  <span class="cmt"># keeps climbing (+16%)</span></span>
<span class="cs-line">}</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-scale">
      <pre class="cs-pre">
<span class="cs-line cmt"># EAGLE-3 Training-Time Test (TTT)</span>
<span class="cs-line cmt"># Source: EAGLE-3 (arXiv:2503.01840)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Change 1: remove feature prediction loss</span>
<span class="cs-line hl-p">loss = l_token   <span class="cmt"># no l_fea constraint</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Change 2: multi-layer feature fusion</span>
<span class="cs-line hl-c">draft_input = FC([f_low, f_mid, f_high])</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Change 3: Training-Time Test</span>
<span class="cs-line">def ttt_step(q, K_train, V_train, K_pred, V_pred):</span>
<span class="cs-line">    S = q @ K_train.T / sqrt(d_k)</span>
<span class="cs-line hl-p">    for k_i in K_pred:  <span class="cmt"># growing context</span></span>
<span class="cs-line hl-p">        S = concat(S, q @ k_i / sqrt(d_k))</span>
<span class="cs-line">    return softmax(S) @ concat(V_train, V_pred)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Key results (arXiv:2503.01840)</span>
<span class="cs-line hl-g">speedup_vs_eagle2 = 1.4   <span class="cmt"># x at batch=1</span></span>
<span class="cs-line hl-g">throughput_b64    = 1.40  <span class="cmt"># x SGLang (+40%)</span></span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-compose">
      <pre class="cs-pre">
<span class="cs-line cmt"># Dataset composition: 3 production recipes</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># 1. EAGLE-3 official (arXiv:2503.01840)</span>
<span class="cs-line">eagle3_official = [</span>
<span class="cs-line hl-a">    ("ShareGPT",  120_000, "chat"),</span>
<span class="cs-line hl-a">    ("UltraChat", 200_000, "chat/dialogue"),</span>
<span class="cs-line">]  <span class="cmt"># 320K total; no math or code</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># 2. SpecBundle (arXiv:2603.18567)</span>
<span class="cs-line">perfect_blend = [</span>
<span class="cs-line hl-g">    ("chat",    350_000, "conversation"),</span>
<span class="cs-line hl-g">    ("math",    350_000, "math reasoning"),</span>
<span class="cs-line hl-g">    ("code",    350_000, "code generation"),</span>
<span class="cs-line hl-g">    ("instruct",350_000, "instruct follow"),</span>
<span class="cs-line">]  <span class="cmt"># 1.4M; ALL responses regen'd @ T=0.8</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># 3. DFlash</span>
<span class="cs-line">dflash_data = [</span>
<span class="cs-line hl-c">    ("Nemotron-PTV2", 700_000, "reasoning+math+code"),</span>
<span class="cs-line hl-c">    ("CodeAlpaca",    100_000, "code instructions"),</span>
<span class="cs-line">]  <span class="cmt"># ~800K; responses: target-generated</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Training (SpecBundle)</span>
<span class="cs-line">config = dict(epochs=2, lr=1e-4,</span>
<span class="cs-line">              sched="cosine", regen_t=0.8)</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-regen">
      <pre class="cs-pre">
<span class="cs-line cmt"># Target-model regeneration</span>
<span class="cs-line cmt"># SpecForge §6; DFlash §4.2</span>
<span class="cs-line"> </span>
<span class="cs-line">def regenerate(dataset, target_model, temp=0.8):</span>
<span class="cs-line">    result = []</span>
<span class="cs-line">    for sample in dataset:</span>
<span class="cs-line hl-p">        resp = target_model.generate(</span>
<span class="cs-line hl-p">            sample["prompt"],</span>
<span class="cs-line hl-p">            temperature=temp,  <span class="cmt"># diversity</span></span>
<span class="cs-line hl-p">            do_sample=True,</span>
<span class="cs-line hl-p">        )</span>
<span class="cs-line hl-g">        result.append(dict(prompt=sample["prompt"],</span>
<span class="cs-line hl-g">                         response=resp))</span>
<span class="cs-line">    return result</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Why T=0.8 (not greedy T=0)?</span>
<span class="cs-line cmt"># T=0: same response every epoch (no augment)</span>
<span class="cs-line cmt"># T=0.8: diversity across epochs (augment)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># P-EAGLE: context-length mismatch</span>
<span class="cs-line cmt"># GPT-OSS 120B reasoning traces:</span>
<span class="cs-line cmt"># Median: 3,891 tokens</span>
<span class="cs-line cmt"># P90:    10,800 tokens</span>
<span class="cs-line cmt"># Mismatch -> -25% acceptance rate</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-dflash">
      <pre class="cs-pre">
<span class="cs-line cmt"># DFlash training recipe (DFlash §4.2)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># 1. Data: ~800K samples</span>
<span class="cs-line">DATA = ["Nemotron-PTV2", "CodeAlpaca"]</span>
<span class="cs-line cmt"># All responses: target-model generated</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># 2. Anchor sampling (not uniform blocks)</span>
<span class="cs-line">def make_block(response, block_size=16):</span>
<span class="cs-line hl-p">    anchor = random_sample(response)</span>
<span class="cs-line hl-p">    masked = [anchor] + [MASK]*(block_size-1)</span>
<span class="cs-line hl-p">    target = response[anchor:anchor+block_size-1]</span>
<span class="cs-line hl-p">    return masked, target</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># 3. Positional loss weights (Eq.4)</span>
<span class="cs-line">def pos_weight(k, gamma=16):</span>
<span class="cs-line hl-a">    return exp(-(k-1) / gamma)</span>
<span class="cs-line cmt"># k=1: 1.000 (first masked, full weight)</span>
<span class="cs-line cmt"># k=4: 0.832  k=8: 0.646  k=15: 0.418</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># 4. Shared embedding + LM head (frozen)</span>
<span class="cs-line hl-g">draft.embed   = target.embed    <span class="cmt"># frozen</span></span>
<span class="cs-line hl-g">draft.lm_head = target.lm_head  <span class="cmt"># frozen</span></span>
<span class="cs-line cmt"># only 5 transformer layers are trained</span>
<span class="cs-line"> </span>
<span class="cs-line">config = dict(layers=5, block_size=16, kv_layers=5)</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-results">
      <pre class="cs-pre">
<span class="cs-line cmt"># Acceptance length and speedup summary</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Math500 tau (LLaMA-3.1-8B)</span>
<span class="cs-line cmt"># Source: SpecForge (arXiv:2603.18567)</span>
<span class="cs-line">tau_math500 = dict(</span>
<span class="cs-line hl-a">    "ShareGPT+UltraChat (320K)": 2.82,</span>
<span class="cs-line hl-g">    "Perfect-Blend (1.4M)":      3.48,</span>
<span class="cs-line">)  <span class="cmt"># delta +23.4% -> 1.17x speedup</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Qwen3-8B avg (T=0) [DFlash Table 1]</span>
<span class="cs-line">qwen38b = dict(</span>
<span class="cs-line hl-a">    "EAGLE-3(16)": dict(tau=2.96, speedup=1.76),</span>
<span class="cs-line hl-a">    "EAGLE-3(60)": dict(tau=3.40, speedup=2.02),</span>
<span class="cs-line hl-g">    "DFlash(16)":  dict(tau=6.49, speedup=4.86),</span>
<span class="cs-line">}</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Practical recipe</span>
<span class="cs-line hl-p">RECIPE = dict(</span>
<span class="cs-line hl-p">    size    = ">=1M conversations",</span>
<span class="cs-line hl-p">    domains = ["chat","math","code","instruct"],</span>
<span class="cs-line hl-p">    regen   = True,   <span class="cmt"># target-model responses</span></span>
<span class="cs-line hl-p">    temp    = 0.8,    <span class="cmt"># regen diversity</span></span>
<span class="cs-line hl-p">    epochs  = 2,</span>
<span class="cs-line hl-p">    lr      = 1e-4,</span>
<span class="cs-line hl-p">    arch    = "EAGLE-3 TTT or DFlash",</span>
<span class="cs-line hl-p">)</span>
      </pre>
    </div>

  </div>
</aside>

</div>

<script>
// TOC + sidebar toggles
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});
const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// Code sidebar tab switching
const tabMeta = {
  gap:     { file: 'recipe/gap.py',     title: 'The Acceptance-Length Gap' },
  wall:    { file: 'recipe/wall.py',    title: 'EAGLE-2 Data Wall' },
  scale:   { file: 'recipe/ttt.py',     title: 'Training-Time Test' },
  compose: { file: 'recipe/compose.py', title: 'Dataset Composition' },
  regen:   { file: 'recipe/regen.py',   title: 'Target Regeneration' },
  dflash:  { file: 'recipe/dflash.py',  title: 'DFlash Training Recipe' },
  results: { file: 'recipe/results.py', title: 'Benchmark Results' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// IntersectionObserver TOC sync
const sectionMap = {
  's-gap':'gap','s-wall':'wall','s-scale':'scale',
  's-compose':'compose','s-regen':'regen','s-dflash':'dflash','s-results':'results'
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// §01 gap bars
const gapSection = document.getElementById('s-gap');
if (gapSection) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('#gap-bars .bar-fill[data-w]').forEach(b => {
          b.style.width = b.dataset.w + '%';
        });
      }
    });
  }, { threshold: 0.3 }).observe(gapSection);
}

// §02 wall canvas
const wallCanvas = document.getElementById('wall-canvas');
let wallCtx, wallW, wallH;
if (wallCanvas) {
  const DPR = window.devicePixelRatio || 1;
  wallW = wallCanvas.clientWidth; wallH = 240;
  wallCanvas.width = wallW * DPR; wallCanvas.height = wallH * DPR;
  wallCtx = wallCanvas.getContext('2d');
  wallCtx.scale(DPR, DPR);
}
const E2 = [{x:1,y:3.70},{x:2,y:3.73},{x:4,y:3.74},{x:8,y:3.75}];
const E3 = [{x:1,y:3.80},{x:2,y:3.95},{x:4,y:4.20},{x:8,y:4.40}];

function drawWall(mode) {
  if (!wallCtx) return;
  const W = wallW, H = wallH;
  wallCtx.clearRect(0,0,W,H);
  document.getElementById('wall-e2').classList.toggle('active', mode==='eagle2');
  document.getElementById('wall-e3').classList.toggle('active', mode==='eagle3');
  document.getElementById('wall-both').classList.toggle('active', mode==='both');
  const PAD = {l:48,r:24,t:20,b:38};
  const plotW = W - PAD.l - PAD.r, plotH = H - PAD.t - PAD.b;
  const minY = 3.6, maxY = 4.5;
  wallCtx.strokeStyle = 'rgba(255,255,255,0.04)'; wallCtx.lineWidth = 1;
  [3.7,3.8,3.9,4.0,4.1,4.2,4.3,4.4].forEach(yv => {
    const y = PAD.t + plotH * (1 - (yv-minY)/(maxY-minY));
    wallCtx.beginPath(); wallCtx.moveTo(PAD.l,y); wallCtx.lineTo(PAD.l+plotW,y); wallCtx.stroke();
  });
  wallCtx.strokeStyle = 'rgba(255,255,255,0.15)';
  wallCtx.beginPath(); wallCtx.moveTo(PAD.l,PAD.t); wallCtx.lineTo(PAD.l,PAD.t+plotH); wallCtx.lineTo(PAD.l+plotW,PAD.t+plotH); wallCtx.stroke();
  wallCtx.fillStyle = 'rgba(160,160,180,0.7)'; wallCtx.font = '10px monospace'; wallCtx.textAlign = 'center';
  [1,2,4,8].forEach(xv => {
    const x = PAD.l + plotW * Math.log2(xv) / Math.log2(8);
    wallCtx.fillText(xv+'x', x, PAD.t+plotH+14);
  });
  wallCtx.fillStyle = 'rgba(150,150,170,0.5)'; wallCtx.font = '9px monospace';
  wallCtx.fillText('data scale (x ShareGPT)', PAD.l+plotW/2, H-2);
  wallCtx.textAlign = 'right'; wallCtx.font = '10px monospace'; wallCtx.fillStyle = 'rgba(160,160,180,0.7)';
  [3.7,3.9,4.1,4.3].forEach(yv => {
    const y = PAD.t + plotH * (1-(yv-minY)/(maxY-minY));
    wallCtx.fillText(yv.toFixed(1), PAD.l-5, y+4);
  });
  function toC(pt) {
    return {x: PAD.l+plotW*Math.log2(pt.x)/Math.log2(8), y: PAD.t+plotH*(1-(pt.y-minY)/(maxY-minY))};
  }
  function drawLine(data, color, label) {
    const pts = data.map(toC);
    wallCtx.strokeStyle = color; wallCtx.lineWidth = 2.5;
    wallCtx.beginPath();
    pts.forEach((p,i) => i===0 ? wallCtx.moveTo(p.x,p.y) : wallCtx.lineTo(p.x,p.y));
    wallCtx.stroke();
    pts.forEach(p => { wallCtx.beginPath(); wallCtx.arc(p.x,p.y,4,0,Math.PI*2); wallCtx.fillStyle=color; wallCtx.fill(); });
    const last = pts[pts.length-1];
    wallCtx.fillStyle=color; wallCtx.font='bold 10px monospace'; wallCtx.textAlign='left';
    wallCtx.fillText(label, last.x+7, last.y+4);
  }
  if (mode==='eagle2'||mode==='both') drawLine(E2,'#f59e0b','EAGLE-2');
  if (mode==='eagle3'||mode==='both') drawLine(E3,'#8b5cf6','EAGLE-3');
  if (mode==='both') {
    const a2=toC({x:8,y:3.75}), a3=toC({x:8,y:4.40});
    wallCtx.strokeStyle='rgba(16,185,129,0.5)'; wallCtx.setLineDash([3,3]); wallCtx.lineWidth=1;
    wallCtx.beginPath(); wallCtx.moveTo(a2.x-20,a2.y); wallCtx.lineTo(a2.x-20,a3.y); wallCtx.stroke();
    wallCtx.setLineDash([]); wallCtx.fillStyle='rgba(16,185,129,0.8)'; wallCtx.font='9px monospace'; wallCtx.textAlign='center';
    wallCtx.fillText('+16%', a2.x-34, (a2.y+a3.y)/2+3);
  }
}
window.drawWall = drawWall;
if (wallCanvas) drawWall('eagle2');

// Step navigator
function makeStepNav(stepsId, prevId, nextId, progId) {
  let step = 0;
  const boxes = document.querySelectorAll('#' + stepsId + ' .step-box');
  const prev = document.getElementById(prevId), next = document.getElementById(nextId), prog = document.getElementById(progId);
  function update() {
    boxes.forEach((b,i) => {
      b.classList.remove('active','done');
      if (i===step) b.classList.add('active'); else if (i<step) b.classList.add('done');
      const n = b.querySelector('.step-num');
      if (n) n.textContent = i<step ? '✓' : String(i+1);
    });
    if (prev) prev.disabled = step===0;
    if (next) next.disabled = step===boxes.length-1;
    if (prog) prog.textContent = 'Step '+(step+1)+' of '+boxes.length;
  }
  prev?.addEventListener('click', () => { if(step>0){step--;update();} });
  next?.addEventListener('click', () => { if(step<boxes.length-1){step++;update();} });
  update();
}
makeStepNav('ttt-steps','ttt-prev','ttt-next','ttt-prog');
makeStepNav('regen-steps','regen-prev','regen-next','regen-prog');

// §04 Dataset composition
const RECIPES = [
  { total:'320K conversations', note:'Original responses. Chat-only; limited math and code.',
    segs:[{label:'ShareGPT (120K)',pct:37.5,color:'rgba(107,114,128,.6)'},{label:'UltraChat (200K)',pct:62.5,color:'rgba(107,114,128,.4)'}] },
  { total:'1.4M conversations', note:'All responses regenerated by target model at T=0.8. Balanced across 4 domains.',
    segs:[{label:'Chat',pct:25,color:'var(--purple)'},{label:'Math reasoning',pct:25,color:'var(--cyan)'},{label:'Code generation',pct:25,color:'var(--green)'},{label:'Instruction follow',pct:25,color:'var(--amber)'}] },
  { total:'~800K samples', note:'Target-generated responses. Anchor sampling augments each response into multiple examples.',
    segs:[{label:'Nemotron Post-Training V2',pct:87.5,color:'var(--cyan)'},{label:'CodeAlpaca',pct:12.5,color:'var(--green)'}] }
];
function showRecipe(idx) {
  document.querySelectorAll('.ds-tab-btn').forEach((b,i) => b.classList.toggle('active',i===idx));
  const r = RECIPES[idx];
  document.getElementById('ds-total-val').textContent = r.total;
  document.getElementById('ds-note').textContent = r.note;
  const c = document.getElementById('ds-bars');
  c.innerHTML = '';
  r.segs.forEach(s => {
    const row = document.createElement('div');
    row.className = 'ds-seg-row';
    row.innerHTML = '<div class="ds-seg-label">'+s.label+'</div><div class="ds-seg-track"><div class="ds-seg-fill" style="width:'+s.pct+'%;background:'+s.color+'"><span>'+s.pct+'%</span></div></div>';
    c.appendChild(row);
  });
}
window.showRecipe = showRecipe;
showRecipe(0);

// §06 DFlash canvas
const dflashCanvas = document.getElementById('dflash-canvas');
let dCtx, dW, dH, dT=0, dRun=false, dRAF=null;
if (dflashCanvas) {
  const DPR=window.devicePixelRatio||1;
  dW=dflashCanvas.clientWidth; dH=200;
  dflashCanvas.width=dW*DPR; dflashCanvas.height=dH*DPR;
  dCtx=dflashCanvas.getContext('2d'); dCtx.scale(DPR,DPR);
}
function easeIO(t){return t<.5?2*t*t:-1+(4-2*t)*t;}
function drawDFlash(t) {
  if (!dCtx) return;
  const ease = easeIO(Math.min(t,1));
  dCtx.clearRect(0,0,dW,dH);
  dCtx.fillStyle='rgba(20,20,38,0.7)'; dCtx.fillRect(0,0,dW,dH);
  const PROMPT=['User:','Solve','2x+3=7','.'],BN=7,TW=40,TH=26,GAP=4;
  const totW=PROMPT.length*(TW+GAP)+12+(1+BN)*(TW+GAP)+80;
  const startX=(dW-totW)/2, Y=50;
  dCtx.font='8px monospace'; dCtx.fillStyle='rgba(150,150,180,0.6)'; dCtx.textAlign='center';
  dCtx.fillText('PROMPT', startX+PROMPT.length*(TW+GAP)/2, Y-12);
  const respX=startX+PROMPT.length*(TW+GAP)+12;
  dCtx.fillText('RESPONSE BLOCK', respX+(1+BN)*(TW+GAP)/2, Y-12);
  PROMPT.forEach((tok,i) => {
    const x=startX+i*(TW+GAP);
    dCtx.fillStyle='rgba(6,182,212,0.2)'; dCtx.fillRect(x,Y,TW,TH);
    dCtx.strokeStyle='rgba(6,182,212,0.5)'; dCtx.lineWidth=1; dCtx.strokeRect(x,Y,TW,TH);
    dCtx.fillStyle='rgba(6,182,212,0.9)'; dCtx.font='9px monospace'; dCtx.textAlign='center';
    dCtx.fillText(tok,x+TW/2,Y+17);
  });
  // Anchor
  const ax=respX;
  dCtx.fillStyle='rgba(245,158,11,0.3)'; dCtx.fillRect(ax,Y,TW,TH);
  dCtx.strokeStyle='rgba(245,158,11,0.8)'; dCtx.lineWidth=1.5; dCtx.strokeRect(ax,Y,TW,TH);
  dCtx.fillStyle='rgba(245,158,11,0.95)'; dCtx.font='9px monospace'; dCtx.textAlign='center';
  dCtx.fillText('r1⚓',ax+TW/2,Y+17);
  // Masked
  const phase=ease*BN;
  for (let k=1;k<=BN;k++) {
    const mx=respX+k*(TW+GAP), pred=phase>=k, wk=Math.exp(-(k-1)/16);
    dCtx.fillStyle=pred?'rgba(139,92,246,'+(0.2+wk*0.5)+')':'rgba(16,185,129,0.15)';
    dCtx.fillRect(mx,Y,TW,TH);
    dCtx.strokeStyle=pred?'rgba(139,92,246,0.7)':'rgba(16,185,129,0.5)'; dCtx.lineWidth=1; dCtx.strokeRect(mx,Y,TW,TH);
    dCtx.fillStyle=pred?'#c4b5fd':'rgba(16,185,129,0.8)'; dCtx.font='9px monospace'; dCtx.textAlign='center';
    dCtx.fillText(pred?'r'+(k+1):'<M>',mx+TW/2,Y+17);
  }
  // Loss weight bar
  const lx=dW-52,ly=14,lh=dH-30,lw=12;
  dCtx.fillStyle='rgba(150,150,180,0.6)'; dCtx.font='8px monospace'; dCtx.textAlign='center';
  dCtx.fillText('wt',lx+lw/2,ly-4);
  for (let py=0;py<lh;py++) {
    const frac=1-py/lh;
    dCtx.fillStyle='rgba(139,92,'+(Math.round(246*frac))+','+(0.15+frac*0.7)+')';
    dCtx.fillRect(lx,ly+py,lw,1);
  }
  ['1.0','0.6'].forEach((lbl,i) => {
    dCtx.fillStyle='rgba(150,150,180,0.5)'; dCtx.font='8px monospace'; dCtx.textAlign='left';
    dCtx.fillText(lbl,lx+lw+3,ly+lh*i+3);
  });
  if (ease>0.1) {
    dCtx.fillStyle='rgba(139,92,246,'+Math.min(1,(ease-0.1)*3)+')';
    dCtx.font='10px monospace'; dCtx.textAlign='center';
    dCtx.fillText('← parallel diffusion prediction →',respX+(1+BN)*(TW+GAP)/2,Y+TH+20);
  }
  dCtx.fillStyle='rgba(150,150,180,0.4)'; dCtx.font='9px monospace'; dCtx.textAlign='left';
  dCtx.fillText('t = '+(ease*100).toFixed(0)+'%',10,dH-8);
  document.getElementById('dflash-status').textContent='t = '+ease.toFixed(2);
}
function dTick(){if(!dRun)return;dT=Math.min(dT+0.008,1);drawDFlash(dT);if(dT<1)dRAF=requestAnimationFrame(dTick);else{dRun=false;document.getElementById('dflash-play').textContent='▶ Play';}}
document.getElementById('dflash-play')?.addEventListener('click',()=>{if(dRun){dRun=false;document.getElementById('dflash-play').textContent='▶ Play';}else{if(dT>=1)dT=0;dRun=true;document.getElementById('dflash-play').textContent='⏸ Pause';dRAF=requestAnimationFrame(dTick);}});
document.getElementById('dflash-reset')?.addEventListener('click',()=>{dRun=false;dT=0;document.getElementById('dflash-play').textContent='▶ Play';drawDFlash(0);});
if (dflashCanvas) drawDFlash(0);

// §07 results bars
const resultsSection = document.getElementById('s-results');
if (resultsSection) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('#result-bars .bar-fill[data-rw]').forEach(b => {
          b.style.width = b.dataset.rw + '%';
        });
      }
    });
  }, { threshold: 0.3 }).observe(resultsSection);
}
</script>
</BaseLayout>

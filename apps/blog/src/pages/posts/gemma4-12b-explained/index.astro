<span class="cs-line cmt"># Modality Gradient Conflict Mitigation</span>
<span class="cs-line cmt"># To prevent direct vision patches from overwriting text weights,</span>
<span class="cs-line cmt"># Gemma 4 uses a gated projection adapter and auxiliary loss.</span>
<span class="cs-line"></span>
<span class="cs-line hl-p"><span class="kw">class</span> <span class="cls">GatedAdapter</span>(nn.Module):</span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">__init__</span>(<span class="self">self</span>, d_model=<span class="num">4096</span>):</span>

</div><!-- /post-grid -->

<script>
// --- TOC + Sidebar Toggles ---
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});

const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// --- Tab Switching ---
const tabMeta = {
  intro:       { file: 'gemma4/config.py', title: 'Model Specifications' },
  barrier:     { file: 'gemma4/barrier.py', title: 'Modality Gradient Conflict' },
  vision:      { file: 'gemma4/vision.py', title: 'Linear Vision Embedder' },
  audio:       { file: 'gemma4/audio.py',  title: 'Linear Audio Embedder' },
  transformer: { file: 'gemma4/attn.py',   title: 'Multimodal Attention Mask' },
  speculative: { file: 'gemma4/mtp.py',    title: 'Shared-KV MTP Drafter' },
  benchmarks:  { file: 'gemma4/bench.py',  title: 'Hardware Benchmarks' }
};

function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// --- Scroll Sync TOC & Sidebar Tabs ---
const sectionMap = {
  's-intro': 'intro',
  's-barrier': 'barrier',
  's-vision': 'vision',
  's-audio': 'audio',
  's-transformer': 'transformer',
  's-speculative': 'speculative',
  's-benchmarks': 'benchmarks'
};

document.querySelectorAll('.post-body section[id]').forEach(s => {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s);
});

// --- Interactive 1: Pipeline Switcher ---
const btnPipeG4 = document.getElementById('btn-pipe-g4');
const btnPipeTrad = document.getElementById('btn-pipe-trad');
const nodeEncoder = document.getElementById('node-encoder');
const nodeEncoderTitle = document.getElementById('node-encoder-title');
const nodeEncoderSub = document.getElementById('node-encoder-sub');
const nodeEncoderDetail = document.getElementById('node-encoder-detail');

btnPipeG4?.addEventListener('click', () => {
  btnPipeG4.classList.add('active');
  btnPipeTrad.classList.remove('active');
  
  nodeEncoder.setAttribute('stroke-dasharray', '0');
  nodeEncoder.setAttribute('fill', 'var(--surface)');
  nodeEncoderTitle.style.opacity = '0.35';
  nodeEncoderSub.textContent = 'Bypassed (0 parameters)';
  nodeEncoderDetail.textContent = '35M linear proj only';
});

btnPipeTrad?.addEventListener('click', () => {
  btnPipeTrad.classList.add('active');
  btnPipeG4.classList.remove('active');
  
  nodeEncoder.setAttribute('stroke-dasharray', '4');
  nodeEncoder.setAttribute('fill', 'rgba(6,182,212,0.06)');
  nodeEncoderTitle.style.opacity = '1';
  nodeEncoderSub.textContent = 'Active (300M+ params)';
  nodeEncoderDetail.textContent = 'Deep layers (ViT/ASR)';
});

// --- Interactive 2: Vision Patches ---
const patchCells = document.querySelectorAll('.patch-cell');
const patchFormulaOutput = document.getElementById('patch-formula-output');

patchCells.forEach(cell => {
  cell.addEventListener('click', () => {
    patchCells.forEach(c => c.classList.remove('active'));
    cell.classList.add('active');
    
    const x = cell.dataset.x;
    const y = cell.dataset.y;
    
    // Update math output
    patchFormulaOutput.innerHTML = `
      <div><span class="math-label">Selected Patch (x:${x}, y:${y})</span></div>
      <div style="margin: 0.5rem 0;">
        <span class="patch-math-val">Raw Vector:</span> <span class="math-var">x_patch</span> ∈ ℝ⁶⁹¹² (48x48x3 pixels)
      </div>
      <div style="margin: 0.5rem 0;">
        <span class="patch-math-val">Proj:</span> (<span class="math-var">x_patch</span> · <span class="math-var">W_proj</span>) = <span class="math-var">v_proj</span> ∈ ℝ⁴⁰⁹⁶
      </div>
      <div style="margin: 0.5rem 0;">
        <span class="patch-math-val">Spatial Pos:</span> <span class="math-var">v_proj</span> + <span class="math-var">x_embed[${x}]</span> + <span class="math-var">y_embed[${y}]</span>
      </div>
      <div style="margin-top: 0.75rem; border-top: 1px solid var(--border); padding-top: 0.5rem; font-size: 0.7rem; color: var(--muted2);">
        Output: Clean 4096-dim token vector sent straight to attention layers.
      </div>
    `;
  });
});

// --- Interactive 3: Waveform sweeping ---
const audioCanvas = document.getElementById('audio-waveform');
const audioSlider = document.getElementById('audio-time-slider');
const audioReadoutMs = document.getElementById('audio-val-ms');
const audioReadoutTok = document.getElementById('audio-val-tokens');

if (audioCanvas) {
  const ctx = audioCanvas.getContext('2d');
  const dpr = window.devicePixelRatio || 1;
  const w = audioCanvas.clientWidth;
  const h = 120;
  audioCanvas.width = w * dpr;
  audioCanvas.height = h * dpr;
  ctx.scale(dpr, dpr);

  // Simple deterministic wave renderer
  function drawWave(activeCenterMs) {
    ctx.clearRect(0, 0, w, h);
    
    // Draw background grid lines
    ctx.strokeStyle = 'rgba(255, 255, 255, 0.05)';
    ctx.lineWidth = 1;
    for (let x = 0; x < w; x += 30) {
      ctx.beginPath();
      ctx.moveTo(x, 0);
      ctx.lineTo(x, h);
      ctx.stroke();
    }
    
    // Draw raw waveform (simulated speech wave)
    ctx.strokeStyle = 'rgba(255, 255, 255, 0.2)';
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(0, h/2);
    for (let x = 0; x < w; x++) {
      const ms = (x / w) * 200; // 0 to 200 ms
      const wave = Math.sin(ms * 0.1) * Math.sin(ms * 0.3) * Math.cos(ms * 0.02) * (h/3);
      ctx.lineTo(x, h/2 + wave);
    }
    ctx.stroke();
    
    // Highlight the 40ms sliding window centered at activeCenterMs
    const leftMs = activeCenterMs - 20;
    const rightMs = activeCenterMs + 20;
    const leftX = (leftMs / 200) * w;
    const rightX = (rightMs / 200) * w;
    
    ctx.fillStyle = 'rgba(6, 182, 212, 0.15)';
    ctx.fillRect(leftX, 0, rightX - leftX, h);
    ctx.strokeStyle = 'var(--cyan)';
    ctx.lineWidth = 2;
    ctx.strokeRect(leftX, 0, rightX - leftX, h);
    
    // Draw active samples inside window
    ctx.strokeStyle = 'var(--green)';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(leftX, h/2);
    for (let x = Math.floor(leftX); x <= Math.floor(rightX); x++) {
      const ms = (x / w) * 200;
      const wave = Math.sin(ms * 0.1) * Math.sin(ms * 0.3) * Math.cos(ms * 0.02) * (h/3);
      ctx.lineTo(x, h/2 + wave);
    }
    ctx.stroke();
  }

  // Handle slider sweep
  audioSlider?.addEventListener('input', (e) => {
    const val = parseInt(e.target.value);
    audioReadoutMs.textContent = `Frame Center: ${val} ms`;
    
    // Map frame center to a simulated token index
    const tokenIdx = Math.floor(val / 40);
    audioReadoutTok.textContent = `Token: [Audio_F${tokenIdx}]`;
    
    drawWave(val);
  });
  
  // Initial draw
  drawWave(100);
}

// --- Interactive 4: Attention Matrix Grid ---
const attnLabelsContainer = document.getElementById('attn-row-labels');
const attnGridMatrix = document.getElementById('attn-grid-matrix');

// Tokens sequence
const tokens = [
  { text: 'User:', type: 'text' },
  { text: 'what', type: 'text' },
  { text: 'is', type: 'text' },
  { text: 'Patch0', type: 'vision' },
  { text: 'Patch1', type: 'vision' },
  { text: 'Audio0', type: 'audio' },
  { text: 'Audio1', type: 'audio' },
  { text: 'this', type: 'text' },
  { text: '?', type: 'text' },
  { text: 'Model:', type: 'text' }
];

if (attnLabelsContainer && attnGridMatrix) {
  // Populate row labels
  tokens.forEach((t, i) => {
    const label = document.createElement('div');
    label.className = 'attn-label-item';
    label.textContent = t.text;
    label.dataset.row = i;
    attnLabelsContainer.appendChild(label);
  });

  // Populate cells
  for (let r = 0; r < 10; r++) {
    for (let c = 0; c < 10; c++) {
      const cell = document.createElement('div');
      cell.className = 'attn-cell off';
      cell.dataset.row = r;
      cell.dataset.col = c;
      attnGridMatrix.appendChild(cell);
    }
  }

  // Attention logic
  function calculateAttention(rowIdx) {
    const activeRow = tokens[rowIdx];
    
    // Clear all cells
    document.querySelectorAll('.attn-cell').forEach(c => {
      c.className = 'attn-cell off';
    });
    
    // Highlight cells in active row according to masking logic
    for (let c = 0; c < 10; c++) {
      const targetCol = tokens[c];
      const cell = document.querySelector(`.attn-cell[data-row="${rowIdx}"][data-col="${c}"]`);
      if (!cell) continue;

      let isAllowed = false;

      if (activeRow.type === 'text') {
        // Text tokens can only attend causally (i.e. to previous columns)
        if (c <= rowIdx) isAllowed = true;
      } else if (activeRow.type === 'vision') {
        // Vision patches attend to all image patches bidirectionally, and text before the vision block causally
        if (targetCol.type === 'vision') {
          isAllowed = true;
        } else if (c < 3) { // Hardcoded index for text preceding vision block
          isAllowed = true;
        }
      } else if (activeRow.type === 'audio') {
        // Audio frames attend to all audio frames bidirectionally, plus all preceding text/vision causally
        if (targetCol.type === 'audio') {
          isAllowed = true;
        } else if (c < 5) { // Prior elements
          isAllowed = true;
        }
      }

      if (isAllowed) {
        if (targetCol.type === 'text') cell.classList.add('on-text');
        else if (targetCol.type === 'vision') cell.classList.add('on-vision');
        else if (targetCol.type === 'audio') cell.classList.add('on-audio');
      }
    }
  }

  // Add hover hooks to rows
  const labelItems = document.querySelectorAll('.attn-label-item');
  labelItems.forEach(item => {
    item.addEventListener('mouseenter', () => {
      labelItems.forEach(l => l.classList.remove('hovered'));
      item.classList.add('hovered');
      
      const r = parseInt(item.dataset.row);
      calculateAttention(r);
    });
  });

  // Default highlight row 7 (Text token "this")
  calculateAttention(7);
  labelItems[7].classList.add('hovered');
}

// --- Interactive 5: MTP Speculative Emulator ---
const btnMtpStep = document.getElementById('btn-mtp-step');
const mtpDraftBox = document.getElementById('mtp-draft-box');
const centroidNodesContainer = document.getElementById('centroid-nodes-container');

// Create vocabulary centroids nodes
const centroids = [
  "Verbs", "Nouns", "Physics", "Audio QA", 
  "Code", "Markdown", "Math symbols", "Acoustics",
  "Spatial", "Entities", "Speech", "Images"
];

if (centroidNodesContainer) {
  centroids.forEach((c, idx) => {
    const node = document.createElement('div');
    node.className = 'mtp-centroid-node';
    node.textContent = `${idx}: ${c}`;
    node.dataset.idx = idx;
    centroidNodesContainer.appendChild(node);
  });
}

let mtpStep = 0;
btnMtpStep?.addEventListener('click', () => {
  const nodes = document.querySelectorAll('.mtp-centroid-node');
  
  if (mtpStep === 0) {
    // Stage 1: Drafter reads KV & predicts Centroids
    mtpDraftBox.innerHTML = '<span style="color: var(--cyan); font-size: 0.72rem;">Drafter predicting centroids...</span>';
    
    // Highlight some centroids
    nodes.forEach(n => n.className = 'mtp-centroid-node');
    nodes[2].classList.add('active'); // Physics
    nodes[6].classList.add('active'); // Math symbols
    
    btnMtpStep.textContent = 'Extract Fine Tokens';
    mtpStep = 1;
  } else if (mtpStep === 1) {
    // Stage 2: Fine Vocabulary selection
    mtpDraftBox.innerHTML = `
      <span class="mtp-tok draft">x_1: "F"</span>
      <span class="mtp-tok draft">x_2: "="</span>
      <span class="mtp-tok draft">x_3: "m"</span>
    `;
    
    nodes.forEach(n => n.classList.remove('active'));
    nodes[2].classList.add('selected');
    nodes[6].classList.add('selected');

    btnMtpStep.textContent = 'Verify with Backbone';
    mtpStep = 2;
  } else if (mtpStep === 2) {
    // Stage 3: Verification
    mtpDraftBox.innerHTML = `
      <span class="mtp-tok accept">x_1: "F" (OK)</span>
      <span class="mtp-tok accept">x_2: "=" (OK)</span>
      <span class="mtp-tok reject">x_3: "m" (REJ)</span>
    `;
    
    btnMtpStep.textContent = 'Reset';
    mtpStep = 3;
  } else {
    // Reset
    mtpDraftBox.innerHTML = '<span style="color: var(--muted); font-size: 0.72rem;">Click button to start drafting...</span>';
    nodes.forEach(n => n.className = 'mtp-centroid-node');
    btnMtpStep.textContent = 'Run Draft Step';
    mtpStep = 0;
  }
});

// --- IntersectionObserver: Animate Benchmarks ---
const benchmarksSection = document.getElementById('s-benchmarks');
if (benchmarksSection) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          b.style.width = b.dataset.w + '%';
        });
      }
    });
  }, { threshold: 0.2 }).observe(benchmarksSection);
}
</script>
</BaseLayout>

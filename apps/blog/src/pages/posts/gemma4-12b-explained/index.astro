<span class="cs-line">        <span class="self">self</span>.proj = nn.Linear(<span class="num">6912</span>, d_model)</span>
<span class="cs-line">        </span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">forward</span>(<span class="self">self</span>, x):</span>
<span class="cs-line cmt">        # Starts at zero to protect LLM from high-variance gradients</span>
<span class="cs-line hl-g">        <span class="kw">return</span> torch.tanh(<span class="self">self</span>.gate) * <span class="self">self</span>.proj(x)</span>
<span class="cs-line">        </span>
<span class="cs-line cmt"># Training step optimization</span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">step</span>(batch, model, opt):</span>
<span class="cs-line">    opt.zero_grad()</span>
<span class="cs-line cmt">    # Joint loss: cross-entropy + auxiliary representation alignment</span>
<span class="cs-line">    loss_lm = model(batch.text, batch.pixels)</span>
<span class="cs-line">    loss_aux = compute_representation_alignment(model)</span>
<span class="cs-line">    </span>
<span class="cs-line cmt">    # Scale vision gradients to prevent interference with text layers</span>
<span class="cs-line hl-c">    loss = loss_lm + <span class="num">0.1</span> * loss_aux</span>
<span class="cs-line">    loss.backward()</span>
<span class="cs-line">    </span>
<span class="cs-line cmt">    # Gradient clipping specifically for visual projector weights</span>
<span class="cs-line">    torch.nn.utils.clip_grad_norm_(model.projector.parameters(), <span class="num">1.0</span>)</span>
<span class="cs-line">    opt.step()</span>
      </pre>
    </div>

    <!-- VISION -->
    <div class="cs-panel" id="panel-vision">
      <pre class="cs-pre">
<span class="cs-line kw">import</span> torch
<span class="cs-line kw">import</span> torch.nn <span class="kw">as</span> nn

<span class="cs-line hl-p"><span class="kw">class</span> <span class="cls">VisionEmbedder</span>(nn.Module):</span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">__init__</span>(<span class="self">self</span>, patch_size=<span class="num">48</span>, in_channels=<span class="num">3</span>, hidden_size=<span class="num">4096</span>):</span>
<span class="cs-line">        <span class="kw">super</span>().<span class="fn">__init__</span>()</span>
<span class="cs-line">        <span class="self">self</span>.patch_size = patch_size</span>
<span class="cs-line">        <span class="self">self</span>.flat_dim = patch_size * patch_size * in_channels  <span class="cmt"># 48*48*3 = 6912</span></span>
<span class="cs-line cmt">        # Single matrix multiplication directly to LLM size</span>
<span class="cs-line hl-c">        <span class="self">self</span>.proj = nn.Linear(<span class="self">self</span>.flat_dim, hidden_size)</span>
<span class="cs-line">        <span class="self">self</span>.ln = nn.LayerNorm(hidden_size)</span>
<span class="cs-line">        </span>
<span class="cs-line cmt">        # Spatial 2D Coordinate embeddings</span>
<span class="cs-line">        <span class="self">self</span>.x_embed = nn.Embedding(<span class="num">100</span>, hidden_size)</span>
<span class="cs-line">        <span class="self">self</span>.y_embed = nn.Embedding(<span class="num">100</span>, hidden_size)</span>

<span class="cs-line">    <span class="kw">def</span> <span class="fn">forward</span>(<span class="self">self</span>, pixel_values, grid_x, grid_y):</span>
<span class="cs-line cmt">        # pixel_values shape: (B, C, H, W)</span>
<span class="cs-line">        B, C, H, W = pixel_values.shape</span>
<span class="cs-line">        p = <span class="self">self</span>.patch_size</span>
<span class="cs-line">        </span>
<span class="cs-line cmt">        # Fold into patches: shape (B, N, flat_dim)</span>
<span class="cs-line">        patches = pixel_values.unfold(<span class="num">2</span>, p, p).unfold(<span class="num">3</span>, p, p)</span>
<span class="cs-line">        patches = patches.permute(<span class="num">0</span>, <span class="num">2</span>, <span class="num">3</span>, <span class="num">1</span>, <span class="num">4</span>, <span class="num">5</span>).flatten(<span class="num">4</span>)</span>
<span class="cs-line">        patches = patches.flatten(<span class="num">1</span>, <span class="num">2</span>)</span>
<span class="cs-line">        </span>
<span class="cs-line cmt">        # Map directly to transformer size</span>
<span class="cs-line hl-g">        x = <span class="self">self</span>.proj(patches)</span>
<span class="cs-line">        x = <span class="self">self</span>.ln(x)</span>
<span class="cs-line">        </span>
<span class="cs-line cmt">        # Inject factorized 2D spatial coordinate offsets</span>
<span class="cs-line hl-g">        pos = <span class="self">self</span>.x_embed(grid_x) + <span class="self">self</span>.y_embed(grid_y)</span>
<span class="cs-line kw">        return</span> x + pos
      </pre>
    </div>
    
    <!-- AUDIO -->
    <div class="cs-panel" id="panel-audio">
      <pre class="cs-pre">
<span class="cs-line hl-p"><span class="kw">class</span> <span class="cls">AudioEmbedder</span>(nn.Module):</span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">__init__</span>(<span class="self">self</span>, sample_rate=<span class="num">16000</span>, frame_ms=<span class="num">40</span>, hidden_size=<span class="num">4096</span>):</span>
<span class="cs-line">        <span class="kw">super</span>().<span class="fn">__init__</span>()</span>
<span class="cs-line cmt">        # 16000 Hz * 0.040s = 640 float values per frame</span>
<span class="cs-line">        <span class="self">self</span>.frame_size = int(sample_rate * (frame_ms / <span class="num">1000</span>))</span>
<span class="cs-line cmt">        # Linear projection maps acoustic frames directly to LLM space</span>
<span class="cs-line hl-c">        <span class="self">self</span>.proj = nn.Linear(<span class="self">self</span>.frame_size, hidden_size)</span>
<span class="cs-line">        <span class="self">self</span>.ln = nn.LayerNorm(hidden_size)</span>

<span class="cs-line">    <span class="kw">def</span> <span class="fn">forward</span>(<span class="self">self</span>, waveforms):</span>
<span class="cs-line cmt">        # waveforms shape: (B, T) - raw 16kHz audio sample floats</span>
<span class="cs-line">        B, T = waveforms.shape</span>
<span class="cs-line cmt">        # Pad to multiple of frame_size</span>
<span class="cs-line">        pad_len = <span class="self">self</span>.frame_size - (T % <span class="self">self</span>.frame_size)</span>
<span class="cs-line">        waveforms = nn.functional.pad(waveforms, (<span class="num">0</span>, pad_len))</span>
<span class="cs-line">        </span>
<span class="cs-line cmt">        # Squeeze into frames: (B, num_frames, frame_size)</span>
<span class="cs-line">        frames = waveforms.view(B, -1, <span class="self">self</span>.frame_size)</span>
<span class="cs-line">        </span>
<span class="cs-line cmt">        # Direct projection</span>
<span class="cs-line hl-g">        x = <span class="self">self</span>.proj(frames)</span>
<span class="cs-line hl-g">        <span class="kw">return</span> <span class="self">self</span>.ln(x)</span>
      </pre>
    </div>
    
    <!-- TRANSFORMER -->
    <div class="cs-panel" id="panel-transformer">
      <pre class="cs-pre">
<span class="cs-line hl-p"><span class="kw">class</span> <span class="cls">MultimodalCausalAttention</span>(nn.Module):</span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">forward</span>(<span class="self">self</span>, hidden_states, attention_mask=None):</span>
<span class="cs-line cmt">        # hidden_states: Concatenated [Text, Vision, Audio] embeddings</span>
<span class="cs-line">        # shape: (B, seq_len, d_model)</span>
<span class="cs-line">        q = <span class="self">self</span>.q_proj(hidden_states)</span>
<span class="cs-line">        k = <span class="self">self</span>.k_proj(hidden_states)</span>
<span class="cs-line">        v = <span class="self">self</span>.v_proj(hidden_states)</span>
<span class="cs-line">        </span>
<span class="cs-line cmt">        # Apply standard RoPE (Rotary Embeddings)</span>
<span class="cs-line">        q, k = <span class="self">self</span>.apply_rope(q, k)</span>
<span class="cs-line">        </span>
<span class="cs-line cmt">        # Multimodal causal masking</span>
<span class="cs-line hl-c">        # Text -> Causal</span>
<span class="cs-line hl-c">        # Vision block -> Bidirectional block masking</span>
<span class="cs-line hl-c">        # Audio block -> Bidirectional block masking</span>
<span class="cs-line">        scores = torch.matmul(q, k.transpose(-<span class="num">1</span>, -<span class="num">2</span>)) / math.sqrt(d_k)</span>
<span class="cs-line">        <span class="kw">if</span> attention_mask <span class="kw">is</span> <span class="kw">not</span> None:</span>
<span class="cs-line hl-g">            scores = scores + attention_mask</span>
            
<span class="cs-line">        attn_weights = nn.functional.softmax(scores, dim=-<span class="num">1</span>)</span>
<span class="cs-line">        <span class="kw">return</span> torch.matmul(attn_weights, v)</span>
      </pre>
    </div>
    
    <!-- SPECULATIVE -->
    <div class="cs-panel" id="panel-speculative">
      <pre class="cs-pre">
<span class="cs-line hl-p"><span class="kw">class</span> <span class="cls">MTPDrafter</span>(nn.Module):</span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">__init__</span>(<span class="self">self</span>, target_model, num_centroids=<span class="num">2048</span>):</span>
<span class="cs-line">        <span class="kw">super</span>().<span class="fn">__init__</span>()</span>
<span class="cs-line cmt">        # Reference target model to share the KV cache directly</span>
<span class="cs-line hl-c">        <span class="self">self</span>.target = target_model</span>
<span class="cs-line">        <span class="self">self</span>.centroid_proj = nn.Linear(target_model.d_model, num_centroids)</span>
<span class="cs-line">        <span class="self">self</span>.fine_classifier = nn.Linear(target_model.d_model + num_centroids, target_model.vocab_size)</span>

<span class="cs-line">    <span class="kw">def</span> <span class="fn">forward</span>(<span class="self">self</span>, shared_kv, prefix_hidden):</span>
<span class="cs-line cmt">        # Compute query vector from prefix</span>
<span class="cs-line">        q = <span class="self">self</span>.q_proj(prefix_hidden)</span>
<span class="cs-line cmt">        # Attention over main model's shared KV cache</span>
<span class="cs-line hl-g">        attn_out = <span class="self">self</span>.attention(q, shared_kv.k, shared_kv.v)</span>
<span class="cs-line">        </span>
<span class="cs-line cmt">        # Coarse vocabulary clustering classification</span>
<span class="cs-line hl-g">        centroid_logits = <span class="self">self</span>.centroid_proj(attn_out)</span>
<span class="cs-line">        </span>
<span class="cs-line cmt">        # Fine vocab refinement</span>
<span class="cs-line">        features = torch.cat([attn_out, centroid_logits], dim=-<span class="num">1</span>)</span>
<span class="cs-line kw">        return</span> <span class="self">self</span>.fine_classifier(features)</span>
      </pre>
    </div>
    

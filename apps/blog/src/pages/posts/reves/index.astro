      <pre class="cs-pre">
<span class="cs-line cmt"># Lemma 4.1 — Hazard Decomposition</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="cmt"># J_SR decomposes into per-state factors</span></span>
<span class="cs-line">J_SR(θ) = Σ_z ρ_θ(z) · V_π(z)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># ρ_θ(z): expected visit count to state z</span>
<span class="cs-line cmt">#          (controlled by the SR rollout policy)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># V_π(z): one-step recovery probability at z</span>
<span class="cs-line cmt">#          V_π(z) = Pr[y~π(·|z) is correct]</span>
<span class="cs-line"> </span>
<span class="cs-line hl-c"><span class="cmt"># Key property: raising V(z) at any z</span></span>
<span class="cs-line hl-c"><span class="cmt"># directly raises J_SR(θ)</span></span>
<span class="cs-line hl-c"><span class="cmt"># → no horizon credit assignment needed</span></span>
<span class="cs-line"> </span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">estimate_V</span>(policy, z, M=5):</span>
<span class="cs-line">    <span class="str">"""One-step recovery probability at z"""</span></span>
<span class="cs-line">    ys = [policy(z) <span class="kw">for</span> _ <span class="kw">in</span> range(M)]</span>
<span class="cs-line">    <span class="kw">return</span> mean([is_correct(x, y) <span class="kw">for</span> y <span class="kw">in</span> ys])</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># z = (x, y_wrong, feedback)</span>
<span class="cs-line cmt"># fresh samples from π at z → V(z) = 2/5</span>
<span class="cs-line cmt"># train to maximize V(z) → raise J_SR</span>
      </pre>

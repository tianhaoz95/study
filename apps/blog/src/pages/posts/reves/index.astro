<span class="cs-line">        <span class="kw">if</span> <span class="kw">not</span> traj.has_near_miss(): <span class="kw">continue</span></span>
<span class="cs-line">        <span class="cmt"># revision prompts from near-misses</span></span>
<span class="cs-line">        rev = revision_prompts(x, traj)</span>
<span class="cs-line">        <span class="cmt"># verification prompts for self-stop</span></span>
<span class="cs-line">        ver = verification_prompts(x, traj)</span>
<span class="cs-line">        near_miss_data += rev + ver</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p">    <span class="cmt"># Stage II: Single-Turn RL</span></span>
<span class="cs-line">    augmented = original_rl + near_miss_data</span>
<span class="cs-line">    policy = grpo_train(policy, augmented)</span>
<span class="cs-line">    <span class="cmt"># new policy → Stage I next epoch</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Augment EVERY epoch — stale data hurts!</span>
<span class="cs-line cmt"># One-shot augmentation ≈ -6pp AIME24</span>

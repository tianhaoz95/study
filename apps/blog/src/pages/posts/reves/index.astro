<span class="cs-line hl-p"><span class="cmt"># Sequential revision objective</span></span>
<span class="cs-line">J_SR = E[r_star(x, y_tau)]</span>
<span class="cs-line"><span class="cmt"># where y_1 ~ π(·|x)</span></span>
<span class="cs-line"><span class="cmt">#       y_t ~ π(·|x, y_&#123;t-1&#125;, f_&#123;t-1&#125;)</span></span>
<span class="cs-line"><span class="cmt">#       τ = first correct or budget K</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Deployment uses JφSR (or similar)</span>
<span class="cs-line cmt"># Training optimizes JOneShot → gap!</span>
<span class="cs-line"> </span>
<span class="cs-line"><span class="cmt"># Example gap:</span></span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">sr_rollout</span>(policy, x, K=32):</span>
<span class="cs-line">    y = policy(x)            <span class="cmt"># attempt 1</span></span>
<span class="cs-line">    <span class="kw">for</span> t <span class="kw">in</span> range(2, K+1):</span>
<span class="cs-line">        <span class="kw">if</span> is_correct(y): <span class="kw">return</span> y</span>
<span class="cs-line">        f = feedback(x, y)   <span class="cmt"># e.g. error</span></span>
<span class="cs-line">        y = policy(x, y, f)  <span class="cmt"># revise</span></span>
<span class="cs-line">    <span class="kw">return</span> y</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-credit">
      <pre class="cs-pre">
<span class="cs-line cmt"># Multi-turn RL credit assignment</span>
<span class="cs-line cmt"># wrong→wrong→correct trajectory</span>
<span class="cs-line"> </span>
<span class="cs-line hl-a"><span class="cmt"># Multi-turn RL gradient (biased!)</span></span>
<span class="cs-line"><span class="cmt"># All turns receive the same credit</span></span>
<span class="cs-line"><span class="kw">for</span> t <span class="kw">in</span> [1, 2, 3]:  <span class="cmt"># τ=3 (correct)</span></span>
<span class="cs-line">    <span class="cmt"># gradient = r_terminal * log π(y_t|s_t)</span></span>
<span class="cs-line">    grad += r_final * log_prob(y_t, s_t)</span>
<span class="cs-line"><span class="cmt"># wrong y_1: also gets +1 gradient</span></span>
<span class="cs-line"><span class="cmt"># wrong y_2: also gets +1 gradient</span></span>
<span class="cs-line"><span class="cmt"># correct y_3: gets +1 gradient</span></span>
<span class="cs-line"> </span>
<span class="cs-line hl-g"><span class="cmt"># REVES: per-state recovery signal</span></span>
<span class="cs-line"><span class="kw">for</span> z <span class="kw">in</span> [z_1, z_2]:  <span class="cmt"># near-miss states</span></span>
<span class="cs-line">    <span class="cmt"># z = (x, y_wrong, feedback)</span></span>
<span class="cs-line">    samples = [policy(z) <span class="kw">for</span> _ <span class="kw">in</span> range(M)]</span>
<span class="cs-line">    V_z = mean([is_correct(y) <span class="kw">for</span> y <span class="kw">in</span> samples])</span>
<span class="cs-line">    <span class="cmt"># Train to maximize V_z with GRPO</span></span>
<span class="cs-line">    grpo_step(policy, z, samples)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># No trajectory-level credit assignment</span>
<span class="cs-line cmt"># Each state is an independent problem</span>
      </pre>

const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ── Code sidebar tab switching ──
const tabMeta = {
  gap:       { file: 'reves/objectives.py',  title: 'The Deployment Gap' },
  credit:    { file: 'reves/credit.py',       title: 'Credit Assignment' },
  recovery:  { file: 'reves/recovery.py',    title: 'Near-Miss Recovery' },
  algorithm: { file: 'reves/train.py',       title: 'Two-Stage Algorithm' },
  results:   { file: 'reves/results.py',     title: 'Results' },
  transfer:  { file: 'reves/transfer.py',    title: 'Transfer to All TTS' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ── IntersectionObserver — sync TOC + sidebar ──
const sectionMap = {
  's-gap':      'gap',
  's-credit':   'credit',
  's-recovery': 'recovery',
  's-algorithm':'algorithm',
  's-results':  'results',
  's-transfer': 'transfer',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ── Credit Canvas ──
(function() {
  const canvas = document.getElementById('credit-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  let W, H;
  function resize() {
    W = canvas.clientWidth; H = canvas.clientHeight;
    canvas.width = W * DPR; canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
    draw();
  }
  let mode = 'multiturn'; // or 'reves'

  function drawRoundRect(x, y, w, h, r, fill, stroke) {
    ctx.beginPath();
    ctx.moveTo(x + r, y);
    ctx.lineTo(x + w - r, y); ctx.quadraticCurveTo(x + w, y, x + w, y + r);
    ctx.lineTo(x + w, y + h - r); ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
    ctx.lineTo(x + r, y + h); ctx.quadraticCurveTo(x, y + h, x, y + h - r);
    ctx.lineTo(x, y + r); ctx.quadraticCurveTo(x, y, x + r, y);
    ctx.closePath();
    if (fill) { ctx.fillStyle = fill; ctx.fill(); }
    if (stroke) { ctx.strokeStyle = stroke; ctx.lineWidth = 1.5; ctx.stroke(); }
  }

  function drawArrow(x1, y1, x2, y2, color, dashed) {
    ctx.save();
    ctx.strokeStyle = color; ctx.lineWidth = 1.5;
    if (dashed) ctx.setLineDash([4,3]); else ctx.setLineDash([]);
    ctx.beginPath(); ctx.moveTo(x1, y1); ctx.lineTo(x2, y2); ctx.stroke();
    // arrowhead
    const angle = Math.atan2(y2 - y1, x2 - x1);
    ctx.fillStyle = color;
    ctx.beginPath();
    ctx.moveTo(x2, y2);
    ctx.lineTo(x2 - 8 * Math.cos(angle - 0.4), y2 - 8 * Math.sin(angle - 0.4));
    ctx.lineTo(x2 - 8 * Math.cos(angle + 0.4), y2 - 8 * Math.sin(angle + 0.4));
    ctx.closePath(); ctx.fill();
    ctx.restore();
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);

    const bw = 90, bh = 36, br = 6;
    const cy = H / 2 - 10;
    const gap = (W - 60 - 3 * bw) / 2;
    const x1 = 30, x2 = x1 + bw + gap, x3 = x2 + bw + gap;

    // Boxes
    const boxes = [
      { x: x1, label: 'y₁', sublabel: 'wrong', color: '#f87171', border: 'rgba(248,113,113,.5)' },
      { x: x2, label: 'y₂', sublabel: 'wrong', color: '#f87171', border: 'rgba(248,113,113,.5)' },
      { x: x3, label: 'y₃', sublabel: 'correct', color: '#10b981', border: 'rgba(16,185,129,.5)' },
    ];

    boxes.forEach(b => {
      drawRoundRect(b.x, cy, bw, bh, br, '#1a1a2e', b.border);
      ctx.fillStyle = b.color;
      ctx.font = `bold 13px monospace`;
      ctx.textAlign = 'center';
      ctx.fillText(b.label, b.x + bw / 2, cy + 15);
      ctx.fillStyle = '#6b7280';
      ctx.font = `10px monospace`;
      ctx.fillText(b.sublabel, b.x + bw / 2, cy + 29);
    });

    // Arrows between boxes
    drawArrow(x1 + bw, cy + bh/2, x2, cy + bh/2, '#374151');
    drawArrow(x2 + bw, cy + bh/2, x3, cy + bh/2, '#374151');

    if (mode === 'multiturn') {
      // Reward box at right
      const rx = x3 + bw + 20, ry = cy;
      drawRoundRect(rx, ry, 60, bh, br, 'rgba(16,185,129,.12)', 'rgba(16,185,129,.4)');
      ctx.fillStyle = '#10b981'; ctx.font = 'bold 11px monospace'; ctx.textAlign = 'center';
      ctx.fillText('+1', rx + 30, ry + 15);
      ctx.fillStyle = '#6b7280'; ctx.font = '9px monospace';
      ctx.fillText('reward', rx + 30, ry + 29);

      // Credit arrows from reward box back to each step
      const creditColor = 'rgba(16,185,129,.75)';
      // draw arc back to y3
      drawArrow(rx, cy + bh/2, x3 + bw, cy + bh/2, creditColor);
      // arc below to y2
      ctx.save(); ctx.strokeStyle = creditColor; ctx.lineWidth = 1.5; ctx.setLineDash([]);
      ctx.beginPath();
      ctx.moveTo(x3 + bw/2, cy + bh);
      ctx.bezierCurveTo(x3 + bw/2, cy + bh + 40, x2 + bw/2, cy + bh + 40, x2 + bw/2, cy + bh);
      ctx.stroke(); ctx.restore();
      // arc below to y1
      ctx.save(); ctx.strokeStyle = creditColor; ctx.lineWidth = 1.5; ctx.setLineDash([]);
      ctx.beginPath();
      ctx.moveTo(x3 + bw/2, cy + bh + 5);
      ctx.bezierCurveTo(x3 + bw/2, cy + bh + 60, x1 + bw/2, cy + bh + 60, x1 + bw/2, cy + bh);
      ctx.stroke(); ctx.restore();
      // arrowheads at y2 and y1 bottoms
      ctx.fillStyle = creditColor;
      ctx.beginPath(); ctx.moveTo(x2+bw/2, cy+bh); ctx.lineTo(x2+bw/2-4, cy+bh+10); ctx.lineTo(x2+bw/2+4, cy+bh+10); ctx.closePath(); ctx.fill();
      ctx.beginPath(); ctx.moveTo(x1+bw/2, cy+bh); ctx.lineTo(x1+bw/2-4, cy+bh+10); ctx.lineTo(x1+bw/2+4, cy+bh+10); ctx.closePath(); ctx.fill();

      // Labels
      ctx.fillStyle = '#10b981'; ctx.font = '9px monospace'; ctx.textAlign = 'center';
      ctx.fillText('+1', x2 + bw/2, cy + bh + 75);
      ctx.fillText('+1', x1 + bw/2, cy + bh + 75);
      ctx.fillText('+1', x3 + bw + 30, cy - 12);

      // Label
      ctx.fillStyle = '#f59e0b'; ctx.font = '10px monospace'; ctx.textAlign = 'center';
      ctx.fillText('same credit to all steps — including wrong ones', W/2, cy - 25);
    } else {
      // REVES mode: highlight y1 and y2 as revision states, draw branches
      // Glow on y1 and y2
      [{ x: x1 }, { x: x2 }].forEach(b => {
        ctx.save();
        const grad = ctx.createRadialGradient(b.x + bw/2, cy + bh/2, 5, b.x + bw/2, cy + bh/2, 50);
        grad.addColorStop(0, 'rgba(139,92,246,.25)');
        grad.addColorStop(1, 'rgba(139,92,246,0)');
        ctx.fillStyle = grad; ctx.fillRect(b.x - 20, cy - 20, bw + 40, bh + 40);
        ctx.restore();
        // Purple border
        drawRoundRect(b.x, cy, bw, bh, br, null, 'rgba(139,92,246,.8)');
        ctx.fillStyle = '#8b5cf6'; ctx.font = 'bold 8px monospace'; ctx.textAlign = 'center';
        ctx.fillText('revision state', b.x + bw/2, cy - 6);
      });

      // Branches from y1: 2 attempts, 1 green 1 red
      const branchY1 = cy - 55;
      ctx.save(); ctx.strokeStyle = 'rgba(139,92,246,.4)'; ctx.lineWidth = 1; ctx.setLineDash([3,2]);
      ctx.beginPath(); ctx.moveTo(x1+bw/2, cy); ctx.lineTo(x1+bw/2-22, branchY1+16); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(x1+bw/2, cy); ctx.lineTo(x1+bw/2+22, branchY1+16); ctx.stroke();
      ctx.restore();
      // Branch circles
      ctx.beginPath(); ctx.arc(x1+bw/2-22, branchY1+8, 8, 0, Math.PI*2);
      ctx.fillStyle='rgba(248,113,113,.3)'; ctx.fill(); ctx.strokeStyle='#f87171'; ctx.lineWidth=1; ctx.stroke();
      ctx.beginPath(); ctx.arc(x1+bw/2+22, branchY1+8, 8, 0, Math.PI*2);
      ctx.fillStyle='rgba(16,185,129,.3)'; ctx.fill(); ctx.strokeStyle='#10b981'; ctx.lineWidth=1; ctx.stroke();
      ctx.fillStyle='#10b981'; ctx.font='bold 9px monospace'; ctx.textAlign='center';
      ctx.fillText('✓', x1+bw/2+22, branchY1+12);
      ctx.fillStyle='#f87171'; ctx.fillText('✗', x1+bw/2-22, branchY1+12);
      ctx.fillStyle='#8b5cf6'; ctx.font='9px monospace';
      ctx.fillText('V(z₁)=0.50', x1+bw/2, branchY1-6);

      // Branches from y2: 3 attempts, 2 green 1 red
      const branchY2 = cy - 55;
      ctx.save(); ctx.strokeStyle = 'rgba(139,92,246,.4)'; ctx.lineWidth = 1; ctx.setLineDash([3,2]);
      ctx.beginPath(); ctx.moveTo(x2+bw/2, cy); ctx.lineTo(x2+bw/2-32, branchY2+16); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(x2+bw/2, cy); ctx.lineTo(x2+bw/2, branchY2+16); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(x2+bw/2, cy); ctx.lineTo(x2+bw/2+32, branchY2+16); ctx.stroke();
      ctx.restore();
      [[x2+bw/2-32,'red'],[x2+bw/2,'green'],[x2+bw/2+32,'green']].forEach(([bx, c]) => {
        ctx.beginPath(); ctx.arc(bx, branchY2+8, 8, 0, Math.PI*2);
        ctx.fillStyle = c==='green'?'rgba(16,185,129,.3)':'rgba(248,113,113,.3)'; ctx.fill();
        ctx.strokeStyle = c==='green'?'#10b981':'#f87171'; ctx.lineWidth=1; ctx.stroke();
        ctx.fillStyle = c==='green'?'#10b981':'#f87171'; ctx.font='bold 9px monospace';
        ctx.fillText(c==='green'?'✓':'✗', bx, branchY2+12);
      });
      ctx.fillStyle='#8b5cf6'; ctx.font='9px monospace'; ctx.textAlign='center';
      ctx.fillText('V(z₂)=0.67', x2+bw/2, branchY2-6);

      // Label
      ctx.fillStyle = '#a78bfa'; ctx.font = '10px monospace'; ctx.textAlign = 'center';
      ctx.fillText('each near-miss state → fresh branches → local V(z) training signal', W/2, cy - 80);
    }
  }

  window.addEventListener('resize', resize);
  resize();

  document.getElementById('btn-multiturn')?.addEventListener('click', () => {
    mode = 'multiturn';
    document.getElementById('btn-multiturn').classList.add('active');
    document.getElementById('btn-reves').classList.remove('active');
    document.getElementById('credit-caption').textContent =
      'Multi-turn RL: all steps receive the same +1 reward signal, including the wrong ones.';
    draw();
  });
  document.getElementById('btn-reves')?.addEventListener('click', () => {
    mode = 'reves';
    document.getElementById('btn-reves').classList.add('active');
    document.getElementById('btn-multiturn').classList.remove('active');
    document.getElementById('credit-caption').textContent =
      'REVES: y₁ and y₂ become revision states. Fresh branches estimate V(z) — train to raise recovery probability locally.';
    draw();
  });
})();

// ── Recovery Canvas ──
(function() {
  const canvas = document.getElementById('recovery-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  let W, H;
  function resize() {
    W = canvas.clientWidth; H = canvas.clientHeight;
    canvas.width = W * DPR; canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
    draw();
  }

  // seeded PRNG for deterministic outcomes
  function seededRand(n) { return ((1664525*n+1013904223)&0x7fffffff)/0x7fffffff; }

  let M = 3;
  // Fixed outcomes: indices 0,2,5,7 succeed; rest fail (for up to 10 branches)
  const succeedSet = new Set([0, 2, 5, 7, 9]);

  function draw() {
    ctx.clearRect(0, 0, W, H);

    // Center box
    const bw = 220, bh = 60, bx = (W - bw) / 2, by = H - 90;
    ctx.beginPath();
    ctx.roundRect(bx, by, bw, bh, 8);
    ctx.fillStyle = 'rgba(139,92,246,.1)'; ctx.fill();
    ctx.strokeStyle = 'rgba(139,92,246,.6)'; ctx.lineWidth = 1.5; ctx.stroke();

    ctx.fillStyle = '#f0f0f8'; ctx.font = 'bold 11px monospace'; ctx.textAlign = 'center';
    ctx.fillText('revision state z', bx + bw/2, by + 18);
    ctx.fillStyle = '#6b7280'; ctx.font = '9px monospace';
    ctx.fillText('x = "sort by 2nd element"', bx + bw/2, by + 33);
    ctx.fillText('y_wrong · feedback: "test 3 fails"', bx + bw/2, by + 47);

    // V(z) display
    const successes = Array.from({length: M}, (_, i) => succeedSet.has(i));
    const nSucc = successes.filter(Boolean).length;
    const vz = (nSucc / M).toFixed(2);

    const vbx = bx + bw + 20, vby = by + 10, vbw = Math.min(100, W - vbx - 20), vbh = 40;
    if (vbw > 50) {
      ctx.beginPath(); ctx.roundRect(vbx, vby, vbw, vbh, 6);
      ctx.fillStyle = 'rgba(139,92,246,.15)'; ctx.fill();
      ctx.strokeStyle = 'rgba(139,92,246,.4)'; ctx.stroke();
      ctx.fillStyle = '#a78bfa'; ctx.font = 'bold 15px monospace'; ctx.textAlign = 'center';
      ctx.fillText('V(z)', vbx + vbw/2, vby + 16);
      ctx.fillStyle = '#f0f0f8'; ctx.font = 'bold 14px monospace';
      ctx.fillText(vz, vbx + vbw/2, vby + 33);
    }

    // Branches fanning upward from the state box
    const spread = Math.min(W - 80, 560);
    const branchTopY = 30;
    const cx0 = bx + bw / 2;

    for (let i = 0; i < M; i++) {
      const frac = M === 1 ? 0.5 : i / (M - 1);
      const tx = (cx0 - spread/2) + frac * spread;
      const ty = branchTopY;
      const ok = successes[i];

      // Line
      ctx.save(); ctx.strokeStyle = 'rgba(139,92,246,.25)'; ctx.lineWidth = 1.2;
      ctx.setLineDash([4,3]); ctx.beginPath();
      ctx.moveTo(cx0, by); ctx.lineTo(tx, ty + 26); ctx.stroke(); ctx.restore();

      // Circle
      ctx.beginPath(); ctx.arc(tx, ty + 14, 14, 0, Math.PI*2);
      ctx.fillStyle = ok ? 'rgba(16,185,129,.2)' : 'rgba(248,113,113,.2)'; ctx.fill();
      ctx.strokeStyle = ok ? '#10b981' : '#f87171'; ctx.lineWidth = 1.5; ctx.stroke();
      ctx.fillStyle = ok ? '#10b981' : '#f87171'; ctx.font = 'bold 11px monospace';
      ctx.textAlign = 'center'; ctx.fillText(ok ? '✓' : '✗', tx, ty + 18);

      // Sample label
      ctx.fillStyle = '#6b7280'; ctx.font = '8px monospace';
      ctx.fillText('y\'_' + (i+1), tx, ty + 36);
    }

    // Legend
    ctx.fillStyle = '#10b981'; ctx.font = '10px monospace'; ctx.textAlign = 'left';
    ctx.fillText('green = correct', 20, H - 15);
    ctx.fillStyle = '#f87171';
    ctx.fillText('red = incorrect', 20 + 130, H - 15);
    ctx.fillStyle = '#a78bfa'; ctx.textAlign = 'center'; ctx.font = 'bold 10px monospace';
    ctx.fillText('V(z) = ' + nSucc + '/' + M + ' = ' + vz + '  → train to raise this', W/2, H - 15);
  }

  window.addEventListener('resize', resize);
  resize();

  const captions = { 3: 'M=3 branches from z — 1 success, 2 fails → V(z) = 0.33', 5: 'M=5 branches — 2 succeed, 3 fail → V(z) = 0.40', 10: 'M=10 branches — 4 succeed, 6 fail → V(z) = 0.40 (more stable estimate)' };
  [['btn-m3',3],['btn-m5',5],['btn-m10',10]].forEach(([id, m]) => {
    document.getElementById(id)?.addEventListener('click', () => {
      M = m;
      document.querySelectorAll('#btn-m3,#btn-m5,#btn-m10').forEach(b => b.classList.remove('active'));
      document.getElementById(id).classList.add('active');
      document.getElementById('recovery-caption').textContent = captions[m];
      resize();
    });
  });
})();

// ── Step navigator ──
(function() {
  let step = 0;
  const boxes = document.querySelectorAll('.step-box');
  const prevBtn = document.getElementById('step-prev');
  const nextBtn = document.getElementById('step-next');
  const progEl  = document.getElementById('step-prog');
  function updateSteps() {
    boxes.forEach((b, i) => {
      b.classList.remove('active','done');
      if (i === step) b.classList.add('active');
      else if (i < step) b.classList.add('done');
    });
    if (prevBtn) prevBtn.disabled = step === 0;
    if (nextBtn) nextBtn.disabled = step === boxes.length - 1;
    if (progEl) progEl.textContent = `Step ${step+1} of ${boxes.length}`;
    boxes.forEach((b, i) => {
      const n = b.querySelector('.step-num');
      if (n) n.textContent = i < step ? '✓' : String(i+1);
    });
  }
  prevBtn?.addEventListener('click', () => { if (step > 0) { step--; updateSteps(); } });
  nextBtn?.addEventListener('click', () => { if (step < boxes.length - 1) { step++; updateSteps(); } });
  updateSteps();
})();

// ── Animated bar charts ──
function triggerBars(containerId) {
  const section = document.getElementById(containerId);
  if (!section) return;
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          b.style.width = (parseFloat(b.dataset.w) / 60 * 100) + '%';
        });
      }
    });
  }, { threshold: 0.3 }).observe(section);
}
// lcb bars: scale is 0–60
document.getElementById('lcb-bars')?.querySelectorAll('.bar-fill[data-w]').forEach(b => {
  new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) b.style.width = (parseFloat(b.dataset.w) / 60 * 100) + '%'; });
  }, { threshold: 0.3 }).observe(b);
});
// aime bars: scale is 0–55
document.getElementById('aime-bars')?.querySelectorAll('.bar-fill[data-w]').forEach(b => {
  new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) b.style.width = (parseFloat(b.dataset.w) / 55 * 100) + '%'; });
  }, { threshold: 0.3 }).observe(b);
});
</script>

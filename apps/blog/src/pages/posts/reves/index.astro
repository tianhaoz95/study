<span class="cs-line cmt"># REVES Two-Stage Training Loop</span>
<span class="cs-line"> </span>
<span class="cs-line"><span class="kw">for</span> epoch <span class="kw">in</span> range(num_epochs):</span>
<span class="cs-line"> </span>
<span class="cs-line hl-c">    <span class="cmt"># Stage I: Data Augmentation</span></span>
<span class="cs-line">    near_miss_data = []</span>
<span class="cs-line">    <span class="kw">for</span> x <span class="kw">in</span> training_set:</span>

    <div class="cs-panel active" id="panel-problem">
      <pre class="cs-pre">
<span class="cs-line cmt"># Autoregressive: tokens generated one at a time</span>
<span class="cs-line cmt"># Each token can only attend to past tokens</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">ar_generate</span>(prompt, model, max_len):</span>
<span class="cs-line">    tokens = prompt.copy()</span>
<span class="cs-line">    <span class="kw">for</span> _ <span class="kw">in</span> <span class="fn">range</span>(max_len):</span>
<span class="cs-line hl-c">        <span class="cmt"># causal: can only see left context</span></span>
<span class="cs-line">        logits = model(tokens, mask=<span class="str">"causal"</span>)</span>
<span class="cs-line">        next_tok = <span class="fn">sample</span>(logits[-<span class="num">1</span>])</span>
<span class="cs-line">        tokens.<span class="fn">append</span>(next_tok)</span>
<span class="cs-line hl-a">        <span class="cmt"># committed — can never revise!</span></span>
<span class="cs-line">        <span class="kw">if</span> next_tok == EOS: <span class="kw">break</span></span>
<span class="cs-line">    <span class="kw">return</span> tokens</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Masked Diffusion: all tokens generated together</span>
<span class="cs-line cmt"># Every token attends to ALL others (bidirectional)</span>
<span class="cs-line"> </span>
<span class="cs-line hl-g"><span class="kw">def</span> <span class="fn">diffusion_generate</span>(prompt, model, steps):</span>
<span class="cs-line">    masked = prompt + [MASK] * block_size</span>
<span class="cs-line">    <span class="kw">for</span> step <span class="kw">in</span> <span class="fn">range</span>(steps):</span>
<span class="cs-line hl-c">        <span class="cmt"># full bidirectional attention</span></span>
<span class="cs-line">        logits = model(masked, mask=<span class="str">"none"</span>)</span>
<span class="cs-line">        <span class="cmt"># reveal most-confident tokens</span></span>
<span class="cs-line">        conf = <span class="fn">max_softmax</span>(logits[mask_pos])</span>
<span class="cs-line">        masked = <span class="fn">reveal_topk</span>(masked, conf)</span>
<span class="cs-line">    <span class="kw">return</span> masked</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-masking">
      <pre class="cs-pre">
<span class="cs-line cmt"># Masked diffusion training objective (Eq. 1)</span>
<span class="cs-line cmt"># For each sequence x0, sample masking ratio t~U[0,1]</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">masked_diffusion_loss</span>(x0, model):</span>
<span class="cs-line">    t = <span class="fn">uniform</span>(<span class="num">0</span>, <span class="num">1</span>)   <span class="cmt"># masking ratio</span></span>
<span class="cs-line hl-c">    <span class="cmt"># independently mask each token with prob t</span></span>
<span class="cs-line">    mask = <span class="fn">bernoulli</span>(t, size=x0.shape)</span>
<span class="cs-line">    xt = <span class="fn">where</span>(mask, MASK_TOKEN, x0)</span>
<span class="cs-line"> </span>
<span class="cs-line hl-g">    <span class="cmt"># predict all masked tokens simultaneously</span></span>
<span class="cs-line">    logits = model(xt)  <span class="cmt"># bidirectional</span></span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="cmt"># loss only on masked positions, normalized by t</span></span>
<span class="cs-line hl-a">    loss = -(<span class="num">1</span>/t) * <span class="fn">sum</span>(</span>
<span class="cs-line hl-a">        mask * <span class="fn">log_prob</span>(logits, x0)</span>
<span class="cs-line hl-a">    ) / mask.<span class="fn">sum</span>()</span>
<span class="cs-line">    <span class="kw">return</span> loss</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># KEY: t is sampled fresh each step</span>
<span class="cs-line cmt"># Model learns to denoise at every corruption level</span>
<span class="cs-line cmt"># Unlike BERT's fixed 15% masking rate</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Random-length training (30% chance)</span>
<span class="cs-line"><span class="kw">if</span> <span class="fn">rand</span>() &lt; <span class="num">0.3</span>:</span>
<span class="cs-line">    seq = <span class="fn">random_split</span>(seq_8192)</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-arch">
      <pre class="cs-pre">
<span class="cs-line cmt"># iLLaDA architecture vs LLaDA</span>
<span class="cs-line cmt"># Transformer backbone — no causal mask!</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">class</span> <span class="cls">iLLaDA</span>:</span>
<span class="cs-line">    layers      = <span class="num">32</span></span>
<span class="cs-line">    model_dim   = <span class="num">4096</span></span>
<span class="cs-line">    attn_heads  = <span class="num">32</span>   <span class="cmt"># Q heads</span></span>
<span class="cs-line hl-c">    kv_heads    = <span class="num">8</span>    <span class="cmt"># GQA: 4:1 sharing</span></span>
<span class="cs-line">    ffn_dim     = <span class="num">14336</span></span>
<span class="cs-line">    vocab_size  = <span class="num">155136</span></span>
<span class="cs-line">    max_seq_len = <span class="num">8192</span>  <span class="cmt"># 2x LLaDA</span></span>
<span class="cs-line hl-g">    tied_embeds = <span class="cls">True</span>  <span class="cmt"># In = Out weights</span></span>
<span class="cs-line">    total_params = <span class="num">7.62</span>B</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Training config</span>
<span class="cs-line hl-p">pretrain_tokens  = <span class="num">12</span>T     <span class="cmt"># 5.2x LLaDA</span></span>
<span class="cs-line">lr_warmup_to     = <span class="num">2e-4</span></span>
<span class="cs-line">lr_schedule      = <span class="str">"const → cosine"</span></span>
<span class="cs-line">optimizer        = <span class="str">"AdamW(wd=0.1)"</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># SFT config</span>
<span class="cs-line hl-c">sft_tokens   = <span class="num">25</span>B</span>
<span class="cs-line hl-c">sft_epochs   = <span class="num">12</span>   <span class="cmt"># keep improving!</span></span>
<span class="cs-line">sft_lr       = <span class="num">5e-6</span>  → <span class="num">5e-7</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># SFT format: mask full sequence</span>
<span class="cs-line cmt"># (not just response tokens)</span>
<span class="cs-line hl-g">corpus = concat(all_sft_examples)</span>
<span class="cs-line hl-g">windows = sample_8192_windows(corpus)</span>
<span class="cs-line hl-g">apply_random_masks(windows)  <span class="cmt"># full seq</span></span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-scoring">
      <pre class="cs-pre">
<span class="cs-line cmt"># Confidence-based scoring for MCQ eval</span>
<span class="cs-line cmt"># Greedy reveal: always unmask highest-conf token</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">confidence_score</span>(candidate, prompt, model):</span>
<span class="cs-line">    L = <span class="fn">len</span>(candidate)</span>
<span class="cs-line hl-c">    <span class="cmt"># start: all candidate tokens masked</span></span>
<span class="cs-line">    y_tilde = [MASK] * L</span>
<span class="cs-line">    score = <span class="num">0.0</span></span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="kw">for</span> k <span class="kw">in</span> <span class="fn">range</span>(<span class="num">1</span>, L+<span class="num">1</span>):</span>
<span class="cs-line">        masked_pos = [i <span class="kw">for</span> i,t <span class="kw">in</span></span>
<span class="cs-line">                      <span class="fn">enumerate</span>(y_tilde)</span>
<span class="cs-line">                      <span class="kw">if</span> t == MASK]</span>
<span class="cs-line hl-g">        <span class="cmt"># pick highest-confidence masked token</span></span>
<span class="cs-line">        probs = <span class="fn">model</span>(prompt, y_tilde)</span>
<span class="cs-line">        i_k = <span class="fn">argmax</span>(probs[masked_pos])</span>
<span class="cs-line"> </span>
<span class="cs-line hl-a">        <span class="cmt"># reveal ground truth (not prediction)</span></span>
<span class="cs-line">        y_tilde[i_k] = candidate[i_k]</span>
<span class="cs-line">        score += <span class="fn">log</span>(probs[i_k, candidate[i_k]])</span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="kw">return</span> score</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Ablation: confidence vs likelihood</span>
<span class="cs-line cmt"># ─────────────────────────────────</span>
<span class="cs-line cmt"># PIQA:      likelihood=77.2, conf=78.5 (+1.3)</span>
<span class="cs-line cmt"># ARC-C:     likelihood=60.2, conf=60.8 (+0.6)</span>
<span class="cs-line cmt"># HellaSwag: likelihood=74.3, conf=76.6 (+2.3)</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-gen">
      <pre class="cs-pre">
<span class="cs-line cmt"># Variable-length block generation</span>
<span class="cs-line cmt"># Generates text of any length iteratively</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">block_generate</span>(prompt, model,</span>
<span class="cs-line hl-p">                    block_size=<span class="num">32</span>, max_len=<span class="num">1024</span>):</span>
<span class="cs-line">    seq = prompt.copy()</span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="kw">while</span> <span class="fn">len</span>(seq) - <span class="fn">len</span>(prompt) &lt; max_len:</span>
<span class="cs-line hl-c">        <span class="cmt"># Step 1: Append mask block</span></span>
<span class="cs-line">        seq += [MASK] * block_size</span>
<span class="cs-line"> </span>
<span class="cs-line">        <span class="cmt"># Steps 2-4: Multi-step diffusion</span></span>
<span class="cs-line">        <span class="kw">for</span> step <span class="kw">in</span> <span class="fn">range</span>(num_steps):</span>
<span class="cs-line">            logits = <span class="fn">model</span>(seq)  <span class="cmt"># bidi</span></span>
<span class="cs-line">            mask_idx = [i <span class="kw">for</span> i,t</span>
<span class="cs-line">                        <span class="kw">in</span> <span class="fn">enumerate</span>(seq)</span>
<span class="cs-line">                        <span class="kw">if</span> t == MASK]</span>
<span class="cs-line hl-g">            conf = <span class="fn">max_softmax</span>(logits[mask_idx])</span>
<span class="cs-line hl-g">            n_reveal = <span class="fn">ceil</span>(</span>
<span class="cs-line hl-g">                <span class="fn">len</span>(mask_idx) / (num_steps - step)</span>
<span class="cs-line hl-g">            )</span>
<span class="cs-line hl-g">            top = <span class="fn">argsort</span>(conf)[-n_reveal:]</span>
<span class="cs-line hl-g">            seq[top] = <span class="fn">argmax</span>(logits[top])</span>
<span class="cs-line"> </span>
<span class="cs-line hl-a">        <span class="cmt"># Step 5: Stop or extend</span></span>
<span class="cs-line">        decoded = seq[<span class="fn">len</span>(prompt):]</span>
<span class="cs-line">        <span class="kw">if</span> EOS <span class="kw">in</span> decoded: <span class="kw">break</span></span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="kw">return</span> seq</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Settings used in paper:</span>
<span class="cs-line cmt"># BBH/GSM8K/MATH/MBPP: block=32, max=1024</span>
<span class="cs-line cmt"># HumanEval:           block=512, max=512</span>
<span class="cs-line cmt"># MMLU (1 letter):     block=3, max=4</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-results">
      <pre class="cs-pre">

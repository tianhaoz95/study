</div><!-- /post-grid -->

<script>
/* ── TOC + Sidebar toggles ── */
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});
const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

/* ── Code sidebar tab switching ── */
const tabMeta = {
  problem:  { file: 'illada/pretrain.py',   title: 'The Autoregressive Blindspot' },
  masking:  { file: 'illada/diffusion.py',  title: 'Masked Diffusion' },
  arch:     { file: 'illada/config.py',     title: 'iLLaDA Architecture' },
  scoring:  { file: 'illada/scoring.py',    title: 'Confidence Scoring' },
  gen:      { file: 'illada/generate.py',   title: 'Block Generation' },
  results:  { file: 'illada/results.txt',   title: 'Benchmark Results' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

/* ── IntersectionObserver: sync TOC + sidebar ── */
const sectionMap = {
  's-problem': 'problem',
  's-masking': 'masking',
  's-arch':    'arch',
  's-scoring': 'scoring',
  's-gen':     'gen',
  's-results': 'results',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

/* ── §01: AR vs Diffusion Generation Canvas ── */
(function() {
  const canvas = document.getElementById('gen-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const W = canvas.clientWidth, H = 220, DPR = window.devicePixelRatio || 1;
  canvas.width = W * DPR; canvas.height = H * DPR; ctx.scale(DPR, DPR);

  const TOKENS = ['The', 'quick', 'brown', 'fox', 'jumps', 'over', 'lazy', 'dog'];
  const N = TOKENS.length;
  let animId = null, playing = false;
  let arStep = 0, diffRevealOrder = [3, 6, 1, 7, 4, 2, 5, 0]; // confidence-based reveal order
  let diffStep = 0;
  let lastTime = 0, elapsed = 0;

  const STEP_DUR = 600; // ms per step

  function draw(ar, diff) {
    ctx.clearRect(0, 0, W, H);

    const half = W / 2;
    const tokW = 60, tokH = 28, gap = 8;
    const totalW = N * tokW + (N - 1) * gap;
    const startX = (half - totalW) / 2;
    const startX2 = half + (half - totalW) / 2;
    const tokY = H / 2 - tokH / 2;

    // Divider
    ctx.strokeStyle = 'rgba(255,255,255,0.07)';
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(half, 16); ctx.lineTo(half, H - 16); ctx.stroke();

    // Label AR
    ctx.fillStyle = '#6b7280';
    ctx.font = '600 11px monospace';
    ctx.textAlign = 'center';
    ctx.fillText('AUTOREGRESSIVE', half / 2, 22);

    // Label Diffusion
    ctx.fillStyle = '#8b5cf6';
    ctx.fillText('MASKED DIFFUSION', half + half / 2, 22);

    // Draw AR tokens
    TOKENS.forEach((tok, i) => {
      const x = startX + i * (tokW + gap);
      const revealed = i < ar;
      ctx.fillStyle = revealed ? 'rgba(6,182,212,0.18)' : 'rgba(255,255,255,0.04)';
      ctx.strokeStyle = revealed ? 'rgba(6,182,212,0.6)' : 'rgba(255,255,255,0.08)';
      ctx.lineWidth = 1;
      ctx.beginPath(); ctx.roundRect(x, tokY, tokW, tokH, 5); ctx.fill(); ctx.stroke();
      ctx.fillStyle = revealed ? '#06b6d4' : 'rgba(255,255,255,0.15)';
      ctx.font = revealed ? '600 10px monospace' : '400 10px monospace';
      ctx.textAlign = 'center';
      ctx.fillText(revealed ? tok : '???', x + tokW / 2, tokY + tokH / 2 + 4);
    });

    // AR cursor arrow
    if (ar < N) {
      const cx = startX + ar * (tokW + gap) - 4;
      ctx.fillStyle = '#f59e0b';
      ctx.font = '700 14px monospace';
      ctx.textAlign = 'center';
      ctx.fillText('▼', cx + tokW / 2, tokY - 6);
    }
    if (ar === N) {
      ctx.fillStyle = 'rgba(16,185,129,0.7)';
      ctx.font = '600 10px monospace';
      ctx.textAlign = 'center';
      ctx.fillText('✓ complete', half / 2, tokY + tokH + 20);
    }

    // Draw Diffusion tokens
    const revealed = new Set(diffRevealOrder.slice(0, diff));
    TOKENS.forEach((tok, i) => {
      const x = startX2 + i * (tokW + gap);
      const isRevealed = revealed.has(i);
      // confidence-based color (higher index = revealed later = lower confidence)
      const revIdx = diffRevealOrder.indexOf(i);
      const conf = 1 - revIdx / N;
      ctx.fillStyle = isRevealed
        ? `rgba(139,92,246,${0.15 + conf * 0.2})`
        : 'rgba(255,255,255,0.04)';
      ctx.strokeStyle = isRevealed
        ? `rgba(139,92,246,${0.5 + conf * 0.4})`
        : 'rgba(255,165,0,0.4)';
      ctx.lineWidth = isRevealed ? 1.5 : 1;
      ctx.beginPath(); ctx.roundRect(x, tokY, tokW, tokH, 5); ctx.fill(); ctx.stroke();
      ctx.fillStyle = isRevealed ? '#a78bfa' : '#f59e0b';
      ctx.font = isRevealed ? '600 10px monospace' : '400 10px monospace';
      ctx.textAlign = 'center';
      ctx.fillText(isRevealed ? tok : '[?]', x + tokW / 2, tokY + tokH / 2 + 4);
    });
    if (diff === N) {
      ctx.fillStyle = 'rgba(139,92,246,0.7)';
      ctx.font = '600 10px monospace';
      ctx.textAlign = 'center';
      ctx.fillText('✓ complete', half + half / 2, tokY + tokH + 20);
    }

    // Step counter bottom
    ctx.fillStyle = 'rgba(255,255,255,0.25)';
    ctx.font = '10px monospace';
    ctx.textAlign = 'left';
    ctx.fillText('step ' + ar, startX, H - 10);
    ctx.textAlign = 'right';
    ctx.fillText('confidence reveal ' + diff, startX2 + totalW, H - 10);
  }

  draw(0, 0);

  function tick(ts) {
    if (!playing) return;
    if (lastTime === 0) lastTime = ts;
    elapsed += ts - lastTime;
    lastTime = ts;

    if (elapsed >= STEP_DUR) {
      elapsed = 0;
      if (arStep < N) arStep++;
      if (diffStep < N) diffStep++;
      draw(arStep, diffStep);
      if (arStep >= N && diffStep >= N) {
        playing = false;
        document.getElementById('btn-play-gen').textContent = '▶ Play';
        document.getElementById('btn-play-gen').classList.remove('active');
        return;
      }
    }
    animId = requestAnimationFrame(tick);
  }

  window.playGen = function() {
    if (playing) {
      playing = false;
      document.getElementById('btn-play-gen').textContent = '▶ Play';
      document.getElementById('btn-play-gen').classList.remove('active');
      if (animId) cancelAnimationFrame(animId);
    } else {
      if (arStep >= N && diffStep >= N) {
        arStep = 0; diffStep = 0; draw(0, 0);
      }
      playing = true;
      lastTime = 0; elapsed = 0;
      document.getElementById('btn-play-gen').textContent = '⏸ Pause';
      document.getElementById('btn-play-gen').classList.add('active');
      animId = requestAnimationFrame(tick);
    }
  };

  window.resetGen = function() {
    if (animId) cancelAnimationFrame(animId);
    playing = false; arStep = 0; diffStep = 0;
    lastTime = 0; elapsed = 0;
    document.getElementById('btn-play-gen').textContent = '▶ Play';
    document.getElementById('btn-play-gen').classList.remove('active');
    draw(0, 0);
  };
})();

/* ── §02: Masking ratio canvas ── */
(function() {
  const canvas = document.getElementById('mask-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const W = canvas.clientWidth, H = 160, DPR = window.devicePixelRatio || 1;
  canvas.width = W * DPR; canvas.height = H * DPR; ctx.scale(DPR, DPR);

  // Fixed mask pattern per token (seeded)
  function seededRand(n) { return ((1664525*n+1013904223)&0x7fffffff)/0x7fffffff; }

  const WORDS = ['The', 'quick', 'brown', 'fox', 'jumps', 'over', 'the', 'lazy', 'dog'];
  const N = WORDS.length;
  let currentT = 0;

  // Pre-compute per-token mask probabilities (determines which tokens get masked at each t)
  const maskThresh = WORDS.map((_, i) => seededRand(i * 7 + 3));

  function drawMask(t) {
    ctx.clearRect(0, 0, W, H);
    const tokW = 64, tokH = 36, gap = 8;
    const totalW = N * tokW + (N - 1) * gap;
    const startX = (W - totalW) / 2;
    const tokY = H / 2 - tokH / 2;

    WORDS.forEach((word, i) => {
      const isMasked = maskThresh[i] < t;
      ctx.fillStyle = isMasked ? 'rgba(245,158,11,0.15)' : 'rgba(139,92,246,0.12)';
      ctx.strokeStyle = isMasked ? 'rgba(245,158,11,0.55)' : 'rgba(139,92,246,0.4)';
      ctx.lineWidth = 1.5;
      const x = startX + i * (tokW + gap);
      ctx.beginPath(); ctx.roundRect(x, tokY, tokW, tokH, 6); ctx.fill(); ctx.stroke();
      ctx.fillStyle = isMasked ? '#f59e0b' : '#a78bfa';
      ctx.font = isMasked ? '600 10px monospace' : '500 10px monospace';
      ctx.textAlign = 'center';
      ctx.fillText(isMasked ? '[MASK]' : word, x + tokW / 2, tokY + tokH / 2 + 4);
    });

    // t label
    const maskedCount = WORDS.filter((_, i) => maskThresh[i] < t).length;
    ctx.fillStyle = 'rgba(255,255,255,0.4)';
    ctx.font = '11px monospace';
    ctx.textAlign = 'left';
    ctx.fillText('masking ratio t = ' + t.toFixed(2) + '  (' + maskedCount + '/' + N + ' tokens masked)', startX, tokY - 10);
  }

  drawMask(0);

  window.setT = function(t, btnId) {
    currentT = t;
    drawMask(t);
    document.querySelectorAll('#t-btns .mode-btn').forEach(b => b.classList.remove('active'));
    const btn = document.querySelector('#t-btns .mode-btn[onclick*="' + btnId + '"]');
    if (btn) btn.classList.add('active');
  };
})();

/* ── §04: Confidence scoring step-by-step ── */
(function() {
  const container = document.getElementById('conf-steps');
  if (!container) return;

  // Scoring reveal sequence: model picks highest-confidence token position first
  // For "The capital of France is _", scoring "Paris" (1 word)
  // Show multi-token example: "City of Light" as candidate vs "A British city"
  const steps = [
    {
      reveal: null,
      label: 'Start: all candidate tokens masked',
      state: ['[?]', '[?]', '[?]'],
      candidate: 'Paris',
      conf: null,
      log: null,
    },
    {
      reveal: 0,
      label: 'Step 1: highest confidence → reveal "Paris" (pos 0)',
      state: ['Paris'],
      candidate: 'Paris',
      conf: 0.92,
      log: 'log(0.92) = −0.083',
    },
    {
      reveal: null,
      label: 'Final score for "Paris": −0.083',
      state: ['Paris'],
      candidate: 'Paris',
      conf: null,
      log: 'S_conf = −0.083',
      final: true,
    },
  ];

  // Richer example: 3-word candidates
  const candidates = [
    { name: 'A: Paris', tokens: ['Paris'], score: -0.083, color: 'var(--green)' },
    { name: 'B: London', tokens: ['London'], score: -1.842, color: 'var(--muted)' },
    { name: 'C: Berlin', tokens: ['Berlin'], score: -2.156, color: 'var(--muted)' },
    { name: 'D: Rome', tokens: ['Rome'], score: -1.951, color: 'var(--muted)' },
  ];

  const confData = [
    { title: 'All candidates masked', desc: 'Start from all-masked candidates. The model will reveal tokens greedily by confidence.', chips: [['[?]','low'],['[?]','low'],['[?]','low'],['[?]','low']] },
    { title: 'Reveal: "Paris" (conf 92%)', desc: 'Candidate A: "Paris" — model assigns 92% confidence to this single token. Score: log(0.92) = −0.083', chips: [['Paris ✓','high'],['[?]','low'],['[?]','low'],['[?]','low']] },
    { title: 'Reveal: "London" (conf 16%)', desc: 'Candidate B: "London" — model assigns only 16% confidence. Score: log(0.16) = −1.833', chips: [['Paris ✓','high'],['London','med'],['[?]','low'],['[?]','low']] },
    { title: 'Reveal: "Rome" (conf 14%)', desc: 'Candidate D: "Rome" — 14% confidence. Score: log(0.14) = −1.966', chips: [['Paris ✓','high'],['London','med'],['[?]','low'],['Rome','med']] },
    { title: 'Final scores — highest wins', desc: 'A (Paris) scores −0.083, far above B (−1.833), C (−2.156), D (−1.966). Confidence scoring selects the correct answer.', chips: [['Paris ✓','high'],['London','med'],['Berlin','low'],['Rome','med']], final: true },
  ];

  let cStep = 0;

  function renderConfStep() {
    const d = confData[cStep];
    container.innerHTML = '';

    const titleEl = document.createElement('div');
    titleEl.style.cssText = 'font-size:.78rem;font-weight:600;color:var(--text2);margin-bottom:.3rem';
    titleEl.textContent = d.title;
    container.appendChild(titleEl);

    const descEl = document.createElement('div');
    descEl.style.cssText = 'font-size:.75rem;color:var(--muted);line-height:1.5;margin-bottom:.625rem';
    descEl.textContent = d.desc;
    container.appendChild(descEl);

    const row = document.createElement('div');
    row.style.cssText = 'display:flex;gap:.5rem;flex-wrap:wrap';
    d.chips.forEach((c, i) => {
      const label = ['A','B','C','D'][i];
      const chip = document.createElement('div');
      chip.style.cssText = 'display:flex;align-items:center;gap:.3rem;padding:.3rem .6rem;border-radius:6px;border:1px solid var(--border);background:var(--surface)';
      chip.innerHTML = `<span style="font-size:.68rem;color:var(--muted);font-family:monospace">${label}:</span> <span style="font-size:.72rem;font-family:monospace;color:${c[1]==='high'?'var(--green)':c[1]==='med'?'var(--amber)':'var(--muted)'}">${c[0]}</span>`;
      row.appendChild(chip);
    });
    container.appendChild(row);

    if (d.final) {
      const win = document.createElement('div');
      win.style.cssText = 'margin-top:.5rem;padding:.4rem .75rem;border-radius:6px;background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.25);font-size:.75rem;font-family:monospace;color:var(--green)';
      win.textContent = '→ Winner: A (Paris) with score −0.083 ✓';
      container.appendChild(win);
    }

    document.getElementById('conf-prog').textContent = `Step ${cStep+1} of ${confData.length}`;
    document.getElementById('conf-prev').disabled = cStep === 0;
    document.getElementById('conf-next').disabled = cStep === confData.length - 1;
  }

  renderConfStep();
  window.confStep = function(dir) {
    cStep = Math.max(0, Math.min(confData.length - 1, cStep + dir));
    renderConfStep();
  };
})();

/* ── §05: Block generation step navigator ── */
(function() {
  const boxes   = document.querySelectorAll('#gen-steps .step-box');
  const prevBtn = document.getElementById('gen-prev');
  const nextBtn = document.getElementById('gen-next');
  const progEl  = document.getElementById('gen-prog');
  let step = 0;

  function update() {
    boxes.forEach((b, i) => {
      b.classList.remove('active', 'done');
      if (i === step) b.classList.add('active');
      else if (i < step) b.classList.add('done');
    });
    if (prevBtn) prevBtn.disabled = step === 0;
    if (nextBtn) nextBtn.disabled = step === boxes.length - 1;
    if (progEl) progEl.textContent = `Step ${step+1} of ${boxes.length}`;
    boxes.forEach((b, i) => {
      const n = b.querySelector('.step-num');
      if (n) n.textContent = i < step ? '✓' : String(i+1);
    });
  }

  window.genStep = function(dir) {
    step = Math.max(0, Math.min(boxes.length - 1, step + dir));
    update();
  };
  update();
})();

/* ── §06: Animated bar chart ── */
(function() {
  const barsSection = document.getElementById('s-results');
  if (!barsSection) return;
  let fired = false;
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting && !fired) {
        fired = true;
        document.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          b.style.width = b.dataset.w + '%';
        });
      }
    });
  }, { threshold: 0.25 }).observe(barsSection);
})();
</script>
</BaseLayout>

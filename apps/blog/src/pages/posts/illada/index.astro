---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="iLLaDA: Improved Large Language Diffusion Models | Catpuccino.ai"
  description="iLLaDA is an 8B masked diffusion language model trained from scratch with fully bidirectional attention on 12T tokens, achieving performance competitive with Qwen2.5 7B — showing that diffusion-based LLMs are a viable path forward."
  crumb="iLLaDA"
>


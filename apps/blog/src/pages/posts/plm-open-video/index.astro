<script>
// ── TOC + sidebar toggles ──
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});
const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ── Sidebar tab switching ──
const tabMeta = {
  trap:    { file: 'plm/overview.py',   title: 'The Distillation Trap' },
  wall:    { file: 'plm/scaling.py',    title: 'Synthetic Scaling Wall' },
  fgqa:    { file: 'plm/fgqa.py',       title: 'PLM-FGQA Dataset' },
  stc:     { file: 'plm/stc.py',        title: 'PLM-STC Dataset' },
  arch:    { file: 'plm/architecture.py','title': 'Model Architecture' },
  results: { file: 'plm/results.py',    title: 'Benchmark Results' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m['title'];
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ── IntersectionObserver ──
const sectionMap = {
  's-trap':    'trap',
  's-wall':    'wall',
  's-fgqa':    'fgqa',
  's-stc':     'stc',
  's-arch':    'arch',
  's-results': 'results',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ── §02 Scaling Wall Canvas ──
(function() {
  const canvas = document.getElementById('wall-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;

  function resize() {
    const W = canvas.clientWidth;
    const H = 260;
    canvas.width  = W * DPR;
    canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
    drawWall(W, H);
  }

  let currentMode = 'both';

  // Log-scale power law curve data points
  // x = log10(GFLOPs), from 11 to 13.5
  // y = Error, starting from ~55 at 1B to ~30 at 8B for VideoQA
  // Hard: barely moves from 50 to 47
  function powerLawY(logFlops, beta, alpha) {
    const flops = Math.pow(10, logFlops);
    return beta * Math.pow(flops, alpha);
  }

  function drawWall(W, H) {
    ctx.clearRect(0, 0, W, H);

    const PAD = { l: 50, r: 20, t: 20, b: 45 };
    const plotW = W - PAD.l - PAD.r;
    const plotH = H - PAD.t - PAD.b;

    // Domain: log10(GFLOPs) from 11.5 to 13.5
    const xMin = 11.5, xMax = 13.5;
    // Range: Error from 25 to 60
    const yMin = 23, yMax = 62;

    function px(logF) { return PAD.l + (logF - xMin) / (xMax - xMin) * plotW; }
    function py(err)  { return PAD.t + plotH - (err - yMin) / (yMax - yMin) * plotH; }

    // Grid lines
    ctx.strokeStyle = 'rgba(255,255,255,0.04)';
    ctx.lineWidth = 1;
    for (let e = 25; e <= 60; e += 5) {
      ctx.beginPath(); ctx.moveTo(PAD.l, py(e)); ctx.lineTo(PAD.l + plotW, py(e)); ctx.stroke();
    }
    for (let lf = 12; lf <= 13.5; lf += 0.5) {
      ctx.beginPath(); ctx.moveTo(px(lf), PAD.t); ctx.lineTo(px(lf), PAD.t + plotH); ctx.stroke();
    }

    // Axes
    ctx.strokeStyle = '#374151';
    ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.moveTo(PAD.l, PAD.t); ctx.lineTo(PAD.l, PAD.t + plotH); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(PAD.l, PAD.t + plotH); ctx.lineTo(PAD.l + plotW, PAD.t + plotH); ctx.stroke();

    // Y axis labels
    ctx.fillStyle = '#6b7280';
    ctx.font = `${10 * DPR / DPR}px monospace`;
    ctx.textAlign = 'right';
    for (let e = 25; e <= 60; e += 10) {
      ctx.fillText(e, PAD.l - 6, py(e) + 4);
    }
    // Axis titles
    ctx.save();
    ctx.translate(12, PAD.t + plotH / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.textAlign = 'center';
    ctx.fillStyle = '#4b5563';
    ctx.font = `9px monospace`;
    ctx.fillText('Avg Error', 0, 0);
    ctx.restore();
    ctx.textAlign = 'center';
    ctx.fillStyle = '#4b5563';
    ctx.font = '9px monospace';
    ctx.fillText('GFLOPs (log scale)', PAD.l + plotW / 2, H - 6);

    // X labels
    ctx.textAlign = 'center';
    ctx.fillStyle = '#6b7280';
    ctx.font = '9px monospace';
    const xTicks = [[11.5,'1B'], [12.0,''], [12.5,'3B'], [13.0,''], [13.5,'8B']];
    xTicks.forEach(([lf, label]) => {
      ctx.fillText(label, px(lf), PAD.t + plotH + 14);
    });

    // Draw curves
    function drawCurve(beta, alpha, color, showPoints) {
      const N = 80;
      ctx.beginPath();
      for (let i = 0; i <= N; i++) {
        const lf = xMin + i * (xMax - xMin) / N;
        const err = powerLawY(lf, beta, alpha);
        const x = px(lf), y = py(err);
        i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
      }
      ctx.strokeStyle = color;
      ctx.lineWidth = 2.5;
      ctx.stroke();

      if (showPoints) {
        // Model scale dots at 1B, 3B, 8B
        [[11.5, 0.92], [12.5, 0.79], [13.5, 0.73]].forEach(([lf, frac]) => {
          const err = powerLawY(lf, beta, alpha);
          ctx.beginPath();
          ctx.arc(px(lf), py(err), 5, 0, Math.PI * 2);
          ctx.fillStyle = color;
          ctx.fill();
          ctx.strokeStyle = '#0d0d14';
          ctx.lineWidth = 1.5;
          ctx.stroke();
        });
      }
    }

    // VideoQA: beta=2500, alpha=-0.15
    // Calibrated so that at 1B (11.5) ≈ 50, at 8B (13.5) ≈ 33
    const stdBeta = 18000, stdAlpha = -0.15;
    const hardBeta = 240, hardAlpha = -0.03;

    const showStd  = currentMode === 'both' || currentMode === 'std';
    const showHard = currentMode === 'both' || currentMode === 'hard';

    if (showStd)  drawCurve(stdBeta,  stdAlpha,  '#8b5cf6', true);
    if (showHard) drawCurve(hardBeta, hardAlpha, '#f59e0b', true);

    // Labels
    ctx.font = '11px monospace';
    if (showStd) {
      ctx.fillStyle = '#8b5cf6';
      ctx.textAlign = 'left';
      const y8B_std = powerLawY(13.5, stdBeta, stdAlpha);
      ctx.fillText('VideoQA α=−0.15', px(13.2), py(y8B_std) - 14);
    }
    if (showHard) {
      ctx.fillStyle = '#f59e0b';
      ctx.textAlign = 'left';
      const y8B_hard = powerLawY(13.5, hardBeta, hardAlpha);
      ctx.fillText('HardQA α=−0.03', px(13.0), py(y8B_hard) + 18);
    }

    // Gap annotation
    if (currentMode === 'both') {
      const lf = 13.5;
      const yStd  = py(powerLawY(lf, stdBeta, stdAlpha));
      const yHard = py(powerLawY(lf, hardBeta, hardAlpha));
      ctx.setLineDash([3, 3]);
      ctx.strokeStyle = 'rgba(255,255,255,0.15)';
      ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(px(lf), yStd); ctx.lineTo(px(lf), yHard); ctx.stroke();
      ctx.setLineDash([]);
      ctx.fillStyle = 'rgba(255,255,255,0.4)';
      ctx.textAlign = 'right';
      ctx.font = '9px monospace';
      ctx.fillText('gap widens', px(lf) - 4, (yStd + yHard) / 2 + 3);
    }
  }

  window.wallShow = function(mode) {
    currentMode = mode;
    ['both','std','hard'].forEach(m => {
      const btn = document.getElementById('wall-btn-' + m);
      if (btn) btn.classList.toggle('active', m === mode);
    });
    drawWall(canvas.clientWidth, 260);
  };

  // Initial render
  setTimeout(() => {
    resize();
    window.addEventListener('resize', resize);
  }, 50);
})();

// ── §03 FGQA chart ──
(function() {
  const types = [
    { label: 'Speed / Force',   mult: 58, color: '#06b6d4',
      q: 'How forcefully does the person strike the nail?',
      a: 'With moderate force, using quick, controlled hammer swings from the wrist.' },
    { label: 'Movement Dir.',   mult: 47, color: '#8b5cf6',
      q: 'In which direction is the person moving the sandpaper?',
      a: 'From the bottom of the baluster to the top in a vertical, oscillating motion.' },
    { label: 'Object State',    mult: 47, color: '#8b5cf6',
      q: 'Does the pasta look strained enough?',
      a: 'The pasta looks perfectly strained, with excess water removed.' },
    { label: 'Spatial Rel.',    mult: 30, color: '#10b981',
      q: 'Where is the metal skewer located at the beginning?',
      a: 'Resting on top of the pan, which is positioned on the left burner of the portable stove.' },
    { label: 'Pose / Grip',     mult: 26, color: '#10b981',
      q: 'How does the person hold the sandpaper?',
      a: 'Firmly with their right hand, between the right thumb on one side, fingers on the other.' },
    { label: 'Obj. Location',   mult: 25, color: '#10b981',
      q: 'Where is the mixing bowl placed at the start of the clip?',
      a: 'On the left side of the countertop, next to the stovetop.' },
    { label: 'Obj. Attributes', mult: 18, color: '#f59e0b',
      q: 'What color is the tool the person uses to tighten the bolt?',
      a: 'The wrench is silver with a black rubber grip handle.' },
    { label: 'Counting',        mult: 9,  color: '#f59e0b',
      q: 'How many chakli snacks does the person flip with the skewer?',
      a: 'The person flips three chakli snacks.' },
    { label: 'Object Rec.',     mult: 7,  color: '#6b7280',
      q: 'What type of saw does the person use to cut the wood?',
      a: 'A circular saw.' },
    { label: 'Action Rec.',     mult: 2,  color: '#4b5563',
      q: 'What is the main activity shown in this video segment?',
      a: 'The person is sanding the surface of a wooden table.' },
  ];

  const chart = document.getElementById('fgqa-chart');
  const ex    = document.getElementById('fgqa-example');
  const exType = document.getElementById('fgqa-eg-type');
  const exQ    = document.getElementById('fgqa-eg-q');
  const exA    = document.getElementById('fgqa-eg-a');

  let selectedIdx = -1;

  types.forEach((t, i) => {
    const row = document.createElement('div');
    row.className = 'fgqa-row';
    row.innerHTML = `
      <div class="fgqa-label">${t.label}</div>
      <div class="fgqa-track">
        <div class="fgqa-fill" style="background:${t.color};width:0%" data-w="${(t.mult/58)*100}">
          <span style="color:rgba(255,255,255,.85);font-size:.65rem;font-weight:700;font-family:var(--ff-mono)">${t.mult}×</span>
        </div>
      </div>
    `;
    row.addEventListener('click', () => {
      if (selectedIdx === i) {
        row.classList.remove('selected');
        ex.classList.remove('visible');
        selectedIdx = -1;
      } else {
        document.querySelectorAll('.fgqa-row').forEach(r => r.classList.remove('selected'));
        row.classList.add('selected');
        exType.textContent = t.label.toUpperCase();
        exQ.textContent = t.q;
        exA.textContent = t.a;
        ex.classList.add('visible');
        selectedIdx = i;
      }
    });
    chart.appendChild(row);
  });

  // Animate bars when section scrolls into view
  const fgqaSection = document.getElementById('s-fgqa');
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.fgqa-fill[data-w]').forEach(b => {
          b.style.width = b.dataset.w + '%';
        });
      }
    });
  }, { threshold: 0.2 }).observe(fgqaSection);
})();

// ── §04 STC canvas ──
(function() {
  const canvas = document.getElementById('stc-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;

  const segments = [
    { label: 'Out of Frame', frames: [0, 11],   color: '#374151', caption: 'Subject is not visible in this interval.', maskColor: null },
    { label: '[12, 67]',     frames: [12, 67],  color: '#8b5cf6', caption: 'The person wearing a jacket is running on snow-covered ground. She stops and turns to look at the other person.', maskColor: 'rgba(139,92,246,0.35)' },
    { label: '[68, 85]',     frames: [68, 85],  color: '#10b981', caption: 'She moves toward the edge of the frame and crouches near the water.', maskColor: 'rgba(16,185,129,0.3)' },
    { label: '[86, 98]',     frames: [86, 98],  color: '#06b6d4', caption: 'She tries to feed the beluga whale approaching from the left.', maskColor: 'rgba(6,182,212,0.3)' },
  ];

  let currentSeg = 0;
  const prevBtn = document.getElementById('stc-prev');
  const nextBtn = document.getElementById('stc-next');
  const segLabel = document.getElementById('stc-seg-label');

  function seededRand(n) {
    return ((1664525 * n + 1013904223) & 0x7fffffff) / 0x7fffffff;
  }

  function drawSTC() {
    const W = canvas.clientWidth;
    const H = 240;
    canvas.width  = W * DPR;
    canvas.height = H * DPR;
    ctx.scale(DPR, DPR);

    // Background
    ctx.fillStyle = '#0d0d14';
    ctx.fillRect(0, 0, W, H);

    const totalFrames = 98;
    const timelineY = H - 58;
    const timelineH = 24;
    const PAD = 20;
    const tW = W - PAD * 2;

    // "Video frame" area
    const frameH = timelineY - 16;
    ctx.fillStyle = '#12121f';
    ctx.beginPath();
    ctx.roundRect(PAD, 12, tW, frameH, 8);
    ctx.fill();

    // Decorative "video" lines (simulating content)
    for (let row = 0; row < 5; row++) {
      for (let col = 0; col < 8; col++) {
        const s = seededRand(row * 8 + col);
        ctx.fillStyle = `rgba(${Math.floor(s * 60 + 30)},${Math.floor(seededRand(row * 8 + col + 1) * 60 + 30)},${Math.floor(seededRand(row * 8 + col + 2) * 60 + 60)},0.3)`;
        const bx = PAD + 8 + col * (tW - 16) / 8;
        const by = 20 + row * (frameH - 16) / 5;
        const bw = (tW - 16) / 8 - 4;
        const bh = (frameH - 16) / 5 - 4;
        ctx.beginPath();
        ctx.roundRect(bx, by, bw, bh, 3);
        ctx.fill();
      }
    }

    // "Subject" figure (simple silhouette)
    const seg = segments[currentSeg];
    if (seg.maskColor) {
      // Draw a simplified person silhouette
      const cx = PAD + tW * 0.42;
      const cy = frameH / 2 + 12;
      ctx.fillStyle = seg.maskColor;
      // Head
      ctx.beginPath(); ctx.arc(cx, cy - 22, 12, 0, Math.PI * 2); ctx.fill();
      // Body
      ctx.beginPath();
      ctx.roundRect(cx - 10, cy - 10, 20, 34, 4);
      ctx.fill();
      // Arms
      ctx.beginPath();
      ctx.roundRect(cx - 22, cy - 8, 12, 8, 4);
      ctx.roundRect(cx + 10, cy - 8, 12, 8, 4);
      ctx.fill();
      // Legs
      ctx.beginPath();
      ctx.roundRect(cx - 10, cy + 24, 8, 22, 4);
      ctx.roundRect(cx + 2, cy + 24, 8, 22, 4);
      ctx.fill();

      // Masklet outline glow
      ctx.strokeStyle = seg.color;
      ctx.lineWidth = 2;
      ctx.setLineDash([4, 4]);
      ctx.beginPath();
      ctx.roundRect(cx - 28, cy - 38, 56, 90, 8);
      ctx.stroke();
      ctx.setLineDash([]);

      // Label overlay
      ctx.fillStyle = seg.color;
      ctx.font = 'bold 10px monospace';
      ctx.textAlign = 'left';
      ctx.fillText('subject masklet', cx - 28, cy - 42);
    } else {
      // Out of frame indicator
      ctx.fillStyle = 'rgba(255,255,255,0.08)';
      ctx.beginPath(); ctx.roundRect(PAD + tW * 0.3, frameH * 0.3, tW * 0.4, frameH * 0.4, 8); ctx.fill();
      ctx.fillStyle = '#6b7280';
      ctx.font = '11px monospace';
      ctx.textAlign = 'center';
      ctx.fillText('subject out of frame', PAD + tW / 2, frameH * 0.53);
    }

    // Timeline bar
    ctx.fillStyle = '#1a1a2e';
    ctx.beginPath(); ctx.roundRect(PAD, timelineY, tW, timelineH, 4); ctx.fill();

    // Segment fills on timeline
    segments.forEach((s, i) => {
      const x1 = PAD + (s.frames[0] / totalFrames) * tW;
      const x2 = PAD + (s.frames[1] / totalFrames) * tW;
      ctx.fillStyle = i === currentSeg ? s.color : (s.color === '#374151' ? '#1f2937' : s.color + '44');
      ctx.beginPath();
      ctx.roundRect(x1 + 1, timelineY + 1, x2 - x1 - 2, timelineH - 2, 3);
      ctx.fill();
    });

    // Timeline tick labels
    ctx.fillStyle = '#4b5563';
    ctx.font = '9px monospace';
    ctx.textAlign = 'center';
    [0, 25, 50, 75, 98].forEach(f => {
      ctx.fillText(f, PAD + (f / totalFrames) * tW, timelineY + timelineH + 12);
    });
    ctx.fillStyle = '#6b7280';
    ctx.font = '8px monospace';
    ctx.fillText('frame', PAD + tW / 2, timelineY + timelineH + 22);

    // Active segment label below timeline
    ctx.fillStyle = seg.color;
    ctx.font = 'bold 10px monospace';
    ctx.textAlign = 'left';
    const x1 = PAD + (seg.frames[0] / totalFrames) * tW;
    ctx.fillText('▶ frames ' + seg.frames[0] + '–' + seg.frames[1], PAD, timelineY - 6);

    // Caption text (wrapped)
    ctx.fillStyle = '#9ca3af';
    ctx.font = '10px monospace';
    ctx.textAlign = 'left';
    const words = seg.caption.split(' ');
    let line = '', lines = [];
    words.forEach(w => {
      const test = line + (line ? ' ' : '') + w;
      if (ctx.measureText(test).width > tW - 8) { lines.push(line); line = w; }
      else line = test;
    });
    if (line) lines.push(line);
    const captionY = timelineY + timelineH + 30;
    lines.slice(0, 2).forEach((l, i) => ctx.fillText(l, PAD, captionY + i * 14));
  }

  function updateButtons() {
    prevBtn.disabled = currentSeg === 0;
    nextBtn.disabled = currentSeg === segments.length - 1;
    segLabel.textContent = `Segment ${currentSeg + 1} of ${segments.length}`;
    drawSTC();
  }

  prevBtn.addEventListener('click', () => { if (currentSeg > 0) { currentSeg--; updateButtons(); } });
  nextBtn.addEventListener('click', () => { if (currentSeg < segments.length - 1) { currentSeg++; updateButtons(); } });

  setTimeout(() => { updateButtons(); window.addEventListener('resize', drawSTC); }, 50);
})();

// ── §05 Step navigator ──
(function() {
  let step = 0;
  const boxes   = document.querySelectorAll('#arch-steps .step-box');
  const prevBtn = document.getElementById('arch-prev');
  const nextBtn = document.getElementById('arch-next');
  const progEl  = document.getElementById('arch-prog');

  function updateSteps() {
    boxes.forEach((b, i) => {
      b.classList.remove('active', 'done');
      if (i === step) b.classList.add('active');
      else if (i < step) b.classList.add('done');
      const n = b.querySelector('.step-num');
      if (n) n.textContent = i < step ? '✓' : String(i + 1);
    });
    if (prevBtn) prevBtn.disabled = step === 0;
    if (nextBtn) nextBtn.disabled = step === boxes.length - 1;
    if (progEl) progEl.textContent = `Stage ${step + 1} of ${boxes.length}`;
  }

  prevBtn?.addEventListener('click', () => { if (step > 0) { step--; updateSteps(); } });
  nextBtn?.addEventListener('click', () => { if (step < boxes.length - 1) { step++; updateSteps(); } });
  updateSteps();
})();

// ── §06 Animated bar chart ──
(function() {
  const section = document.getElementById('s-results');
  if (!section) return;
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('#plm-bench-bars .bar-fill[data-w]').forEach(b => {
          b.style.width = b.dataset.w + '%';
        });
      }
    });
  }, { threshold: 0.25 }).observe(section);
})();
</script>

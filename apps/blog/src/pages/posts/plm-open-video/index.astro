<span class="cs-line cmt"># The proprietary distillation pattern</span>
<span class="cs-line cmt"># dominant in the community today</span>
<span class="cs-line"> </span>
<span class="cs-line hl-a"><span class="kw">def</span> <span class="fn">distillation_train</span>(video_data):</span>
<span class="cs-line hl-a">    <span class="cmt"># use closed model to label data</span></span>
<span class="cs-line">    labels = <span class="fn">gpt4o_api</span>(video_data)  <span class="cmt"># ⚠️</span></span>
<span class="cs-line">    model.<span class="fn">train</span>(video_data, labels)</span>
<span class="cs-line">    score = <span class="fn">benchmark</span>(model)  <span class="cmt"># goes up!</span></span>
<span class="cs-line">    <span class="cmt"># but: was this architecture,</span></span>
<span class="cs-line">    <span class="cmt"># or teacher data from eval set?</span></span>
<span class="cs-line">    <span class="kw">return</span> score  <span class="cmt"># unknowable</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># PLM's transparent alternative</span>
<span class="cs-line hl-g"><span class="kw">def</span> <span class="fn">open_train</span>(video_data):</span>
<span class="cs-line hl-g">    <span class="cmt"># label with open-source models only</span></span>
<span class="cs-line">    labels = <span class="fn">llama3_data_engine</span>(video_data)</span>
<span class="cs-line">    labels += <span class="fn">human_annotators</span>(video_data)</span>
<span class="cs-line">    model.<span class="fn">train</span>(video_data, labels)</span>
<span class="cs-line">    score = <span class="fn">benchmark</span>(model)  <span class="cmt"># goes up!</span></span>
<span class="cs-line">    <span class="cmt"># and: each delta is attributable</span></span>
<span class="cs-line">    <span class="kw">return</span> score  <span class="cmt"># reproducible</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># PLM components (all open)</span>
<span class="cs-line hl-p"><span class="cmt"># Vision encoder: Perception Encoder</span></span>
<span class="cs-line hl-p"><span class="cmt">#   PE-L/14 (300M) for 1B + 3B</span></span>
<span class="cs-line hl-p"><span class="cmt">#   PE-G/14 (2B)  for 8B</span></span>
<span class="cs-line hl-c"><span class="cmt"># Language decoder: Llama 3</span></span>
<span class="cs-line hl-c"><span class="cmt">#   1B / 3B / 8B variants</span></span>
<span class="cs-line hl-g"><span class="cmt"># Connector: 2-layer MLP projector</span></span>
      </pre>
    </div>
    <!-- panel: wall -->
    <div class="cs-panel" id="panel-wall">
      <pre class="cs-pre">
<span class="cs-line cmt"># Synthetic data scaling laws</span>
<span class="cs-line cmt"># Err = β × GFLOPs^α</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># α = scaling exponent (smaller = better)</span>
<span class="cs-line hl-g"><span class="cmt"># Standard VideoQA (NExT, STAR, MVBench…)</span></span>
<span class="cs-line hl-g">video_qa_alpha  = <span class="num">-0.15</span>  <span class="cmt"># scales well</span></span>
<span class="cs-line hl-g">video_qa_beta   = <span class="num">2.5e3</span></span>
<span class="cs-line"> </span>
<span class="cs-line hl-a"><span class="cmt"># Hard Video Tasks (TemporalBench,</span></span>
<span class="cs-line hl-a"><span class="cmt"># TOMATO, MotionBench, CG-Bench…)</span></span>
<span class="cs-line hl-a">hard_qa_alpha   = <span class="num">-0.03</span>  <span class="cmt"># nearly FLAT!</span></span>
<span class="cs-line hl-a">hard_qa_beta    = <span class="num">1.4e2</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># At 8B scale (≈10^13 GFLOPs):</span>
<span class="cs-line cmt"># VideoQA:  error drops ~5× from 1B</span>
<span class="cs-line cmt"># HardQA:   error drops &lt;1.3× from 1B</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># The knowledge for hard tasks simply</span>
<span class="cs-line cmt"># isn't present in synthetic captions.</span>
<span class="cs-line cmt"># More synthetic data ≠ more knowledge</span>
<span class="cs-line cmt"># about direction, counting, pose…</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Solution: human annotations that</span>
<span class="cs-line cmt"># contain exactly this knowledge</span>
<span class="cs-line hl-p">plm_fgqa_impact = <span class="num">+13.1</span>  <span class="cmt"># pp on FGQA</span></span>
<span class="cs-line hl-c">plm_stc_impact  = <span class="num">+27.4</span>  <span class="cmt"># pp on SGQA</span></span>
      </pre>
    </div>
    <!-- panel: fgqa -->
    <div class="cs-panel" id="panel-fgqa">
      <pre class="cs-pre">
<span class="cs-line cmt"># PLM-FGQA data collection pipeline</span>
<span class="cs-line"> </span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">build_fgqa</span>(raw_videos):</span>
<span class="cs-line hl-c">    <span class="cmt"># Step 1: extract salient segments</span></span>
<span class="cs-line">    segs = <span class="fn">temporal_cluster</span>(raw_videos)</span>
<span class="cs-line">    segs = <span class="fn">shot_detect</span>(segs)</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p">    <span class="cmt"># Step 2: generate QA candidates</span></span>
<span class="cs-line">    qas = <span class="fn">llama3_text_llm</span>(segs)</span>
<span class="cs-line">    qas += <span class="fn">early_plm_vllm</span>(segs)</span>
<span class="cs-line"> </span>
<span class="cs-line hl-g">    <span class="cmt"># Step 3: human verification</span></span>
<span class="cs-line">    <span class="kw">for</span> qa <span class="kw">in</span> qas:</span>
<span class="cs-line">        human_watches_video(qa)</span>
<span class="cs-line">        <span class="kw">if</span> answer_wrong:</span>
<span class="cs-line">            qa.answer = human_correct()</span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="kw">return</span> verified_qas  <span class="cmt"># 2.4M</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Question type coverage vs existing</span>
<span class="cs-line cmt"># (PLM-FGQA × vs all prior datasets)</span>
<span class="cs-line hl-a">coverage = &#123;</span>
<span class="cs-line hl-a">    <span class="str">'Speed / Force'</span>:   <span class="num">58</span>,  <span class="cmt"># ×</span></span>

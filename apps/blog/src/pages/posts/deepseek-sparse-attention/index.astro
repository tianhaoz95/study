    lines: [
      ['cmt','# Dense attention: every query attends to all L tokens'],
      ['cmt','# Memory: O(L^2 * d), FLOPs: O(L^2 * d)'],
      ['',''],
      ['p','def dense_attention(Q, K, V):'],
      ['','    # Q: [B, L, H, d]  K,V: [B, L, H, d]'],
      ['','    L = Q.shape[1]'],
      ['','    # Full L×L attention matrix — O(L^2) memory'],
      ['c','    scores = torch.einsum("blhd,bshd->blhs", Q, K)'],
      ['c','    scores = scores / math.sqrt(d)'],
      ['','    weights = F.softmax(scores, dim=-1)'],
      ['','    return torch.einsum("blhs,bshd->blhd", weights, V)'],
      ['',''],
      ['cmt','# At L=128K: 128K × 128K = 16B cells per layer'],
      ['cmt','# At $2/GPU-hr on H800: ~$0.65/M tokens at 128K'],
      ['',''],
      ['g','# DSA: query attends to k << L tokens'],
      ['g','# FLOPs: O(L^2/H_ratio) for indexer + O(L*k) for main attn'],
      ['g','# k=2048, L=128K → attend to 1.6% of context'],
    ]
  },
  mla: {
    lines: [
      ['cmt','# MLA: Multi-head Latent Attention (DeepSeek-V2)'],
      ['cmt','# Compress KV cache: H*d_k*L  →  d_c*L (d_c << H*d_k)'],
      ['',''],
      ['p','def mla_compress(h_s, W_DKV):'],
      ['','    # Compress token h_s into latent vector'],
      ['c','    c_kv = h_s @ W_DKV.T     # [d_model] -> [d_c]'],
      ['','    return c_kv               # CACHED'],
      ['',''],
      ['p','def mla_expand_mha(c_kv, W_UK_i, W_UV_i):'],
      ['','    # MHA mode: per-head key/value projections'],
      ['','    k_i = c_kv @ W_UK_i.T     # head-specific key'],
      ['','    v_i = c_kv @ W_UV_i.T     # head-specific value'],
      ['','    return k_i, v_i'],
      ['',''],
      ['p','def mla_expand_mqa(c_kv, W_UK, W_UV):'],
      ['','    # MQA mode (DSA): shared key/value across all heads'],
      ['a','    k = c_kv @ W_UK.T        # ONE key, shared by all heads'],
      ['a','    v = c_kv @ W_UV.T        # ONE value, shared by all heads'],
      ['','    return k, v'],
      ['',''],
      ['cmt','# MQA enables efficient sparse selection:'],
      ['cmt','# Select k latent vectors, expand once for all heads'],
    ]
  },
  indexer: {
    lines: [
      ['cmt','# Lightning Indexer: fast O(L^2) scoring, tiny constant'],
      ['cmt','# H_I heads (small), FP8 precision, ReLU (not softmax)'],
      ['',''],
      ['p','def lightning_indexer(h_t, h_s, H_I, W_qI, W_wI, W_kI):'],
      ['','    # Derive indexer queries/weights from query token h_t'],
      ['c','    q_I = [W_qI[j] @ h_t for j in range(H_I)]  # H_I queries'],
      ['c','    w_I = softmax(W_wI @ h_t)                   # head weights'],
      ['','    # Derive indexer keys from context token h_s'],
      ['c','    k_I = W_kI @ h_s                            # single key'],
      ['',''],
      ['p','    # Compute index score (ReLU for streaming efficiency)'],
      ['p','    I_ts = sum('],
      ['p','        w_I[j] * F.relu(q_I[j] @ k_I)'],
      ['p','        for j in range(H_I)'],
      ['p','    )'],
      ['','    return I_ts  # scalar: relevance of h_s to query h_t'],
      ['',''],
      ['g','# Key properties:'],
      ['g','# - ReLU: element-wise, no global reduce across L'],
      ['g','# - FP8:  2× lower bandwidth vs BF16'],
      ['g','# - H_I << H_A: far fewer heads than main attention'],
      ['cmt','# Combined: indexer cost is ~10x smaller than MLA'],
    ]
  },
  topk: {
    lines: [
      ['cmt','# DSA: compute indexer scores, select top-k, run attention'],
      ['',''],
      ['p','def dsa_attention(h_t, kv_cache, k=2048):'],
      ['','    L = len(kv_cache)'],
      ['',''],
      ['cmt','    # Phase 1: score ALL L latent vectors (O(L) per query)'],
      ['c','    scores = [indexer(h_t, kv_cache[s]) for s in range(L)]'],
      ['c','    scores = torch.tensor(scores)        # [L]'],
      ['',''],
      ['cmt','    # Phase 2: select top-k indices (O(L log k))'],
      ['p','    topk_idx = torch.topk(scores, k=k).indices  # [k]'],
      ['',''],
      ['cmt','    # Phase 3: load only k latents, run main attention'],
      ['g','    selected_c = kv_cache[topk_idx]      # [k, d_c]'],
      ['g','    k_sel, v_sel = mla_expand_mqa(selected_c)   # [k, d]'],
      ['g','    u_t = standard_attention(h_t, k_sel, v_sel) # O(k)'],
      ['','    return u_t'],
      ['',''],
      ['cmt','# Content-adaptive: different queries select different tokens'],
      ['cmt','# Unlike sliding window: ANY position in context selectable'],
      ['cmt','# k=2048 at L=128K  →  attend to 1.6% of context'],
    ]
  },
  training: {
    lines: [
      ['cmt','# Stage 1: Dense Warm-up — train indexer only'],
      ['cmt','# Goal: indexer scores ≈ actual attention distribution'],
      ['',''],
      ['p','def warmup_stage(model, indexer, data):'],
      ['','    # Freeze model, only indexer parameters are trainable'],
      ['','    model.requires_grad_(False)'],
      ['','    indexer.requires_grad_(True)'],
      ['',''],
      ['c','    for batch in data:  # 1000 steps, 2.1B tokens total'],
      ['c','        # Run dense attention, get actual weights p_{t,:}'],
      ['c','        attn_weights = dense_attention(batch)'],
      ['c','        p_target = L1_normalize(sum_heads(attn_weights))'],
      ['',''],
      ['c','        # KL loss: make indexer match real attention'],
      ['p','        I_scores = indexer(batch)'],
      ['p','        loss = KL(p_target, softmax(I_scores))'],
      ['p','        loss.backward(); optimizer.step()'],
      ['',''],
      ['cmt','# Stage 2: Sparse Training — unfreeze all, activate top-k'],
      ['',''],
      ['p','def sparse_stage(model, indexer, data):'],
      ['','    model.requires_grad_(True)'],
      ['',''],
      ['g','    for batch in data:  # 15000 steps, 943.7B tokens'],
      ['g','        # Run SPARSE attention (k=2048)'],
      ['g','        S_t = topk(indexer(batch.detach()))  # detach!'],
      ['g','        output = model_with_sparse_attn(batch, S_t)'],
      ['',''],
      ['g','        # LM loss trains model; KL loss trains indexer'],
      ['g','        lm_loss  = cross_entropy(output, batch.labels)'],
      ['g','        kl_loss  = KL(p_sparse, softmax(I_sparse))'],
      ['g','        (lm_loss + kl_loss).backward()'],
    ]
  },
  results: {
    lines: [
      ['cmt','# Inference cost benchmark (H800, $2/GPU-hr)'],
      ['cmt','# Prefilling cost per million output tokens'],
      ['',''],
      ['cmt','# Context:  V3.1-Terminus    V3.2-DSA    Speedup'],
      ['','# ─────────────────────────────────────────────────'],
      ['','#    32K:      $0.15/M          $0.12/M       1.25×'],
      ['','#    64K:      $0.35/M          $0.19/M       1.85×'],
      ['p','#   128K:      $0.65/M          $0.24/M       2.7×'],
      ['',''],
      ['cmt','# Long-context quality: DSA vs Dense MLA baseline'],
      ['g','# AA-LCR3:          DSA +4 points over V3.1-Terminus'],
      ['g','# Fiction.liveBench: DSA better across all metrics'],
      ['',''],
      ['cmt','# Short-context: no measurable regression'],
      ['cmt','# ChatbotArena Elo: V3.1 ≈ V3.2-Exp (Nov 10, 2025)'],
      ['',''],
      ['cmt','# Final V3.2 benchmarks (after post-training):'],
      ['','# AIME 2025:    93.1%    (GPT-5-High: 94.6%)'],
      ['','# GPQA Diamond: 82.4%    (GPT-5-High: 85.7%)'],
      ['','# SWE-Verified:  73.1%    (GPT-5-High: 74.9%)'],
      ['c','# BrowseComp:   67.6%    (GPT-5-High: 54.9%)  ← wins'],
      ['',''],
      ['cmt','# k=2048 at 128K: 1.6% of context, zero quality gap'],
    ]
  }
};

function renderPanel(id, linesArr) {
  const pre = document.getElementById('pre-' + id);
  if (!pre) return;
  const hlClass = { 'p':'hl-p', 'c':'hl-c', 'g':'hl-g', 'a':'hl-a', 'cmt':'', '':'', 'cmtOnly':'' };
  pre.innerHTML = linesArr.map(([type, text]) => {
    const cls = hlClass[type] || '';
    const highlighted = hl(text);
    return `<span class="cs-line${cls ? ' ' + cls : ''}">${highlighted}</span>`;
  }).join('\n');
}

Object.entries(PANELS).forEach(([id, { lines }]) => renderPanel(id, lines));

// ─── Cost canvas: O(L^2) vs O(L*k) ───
(function() {
  const canvas = document.getElementById('cost-canvas');
  if (!canvas) return;
  const W = canvas.clientWidth, H = 200, DPR = window.devicePixelRatio || 1;
  canvas.width = W * DPR; canvas.height = H * DPR;
  const ctx = canvas.getContext('2d');
  ctx.scale(DPR, DPR);

  const PAD = { l: 55, r: 20, t: 15, b: 35 };
  const cW = W - PAD.l - PAD.r;
  const cH = H - PAD.t - PAD.b;

  const LVALS = [16, 32, 48, 64, 80, 96, 112, 128]; // K tokens
  const k = 2048;
  const BASELINE = 16 * 16; // L=16K dense cost = 1 unit

  function denseCost(l)   { return (l * 1000) * (l * 1000) / (BASELINE * 1e6); }
  function dsaCost(l)     { return (l * 1000) * k / (BASELINE * 1e6); }
  function indexerCost(l) { return (l * 1000) * (l * 1000) * 0.04 / (BASELINE * 1e6); }  // ~25x smaller

  const maxCost = denseCost(128);
  function xPos(l) { return PAD.l + ((l - 16) / 112) * cW; }
  function yPos(c) { return PAD.t + cH - Math.min(c / maxCost, 1) * cH; }

  // Grid lines
  ctx.strokeStyle = 'rgba(255,255,255,0.04)';
  ctx.lineWidth = 1;
  [0.25, 0.5, 0.75, 1.0].forEach(frac => {
    const y = PAD.t + cH - frac * cH;
    ctx.beginPath(); ctx.moveTo(PAD.l, y); ctx.lineTo(PAD.l + cW, y); ctx.stroke();
  });

  function drawCurve(costFn, color, dashed) {
    ctx.beginPath();
    ctx.strokeStyle = color;
    ctx.lineWidth = 2.5;
    if (dashed) ctx.setLineDash([6, 4]); else ctx.setLineDash([]);
    LVALS.forEach((l, i) => {
      const x = xPos(l), y = yPos(costFn(l));
      if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
    });
    ctx.stroke();
    ctx.setLineDash([]);
  }

  drawCurve(denseCost,   '#e06c75', false);
  drawCurve(indexerCost, '#10b981', true);
  drawCurve(dsaCost,     '#8b5cf6', false);

  // X-axis labels
  ctx.fillStyle = '#5c6370';
  ctx.font = `${10 * Math.min(DPR, 1.5)}px monospace`;
  ctx.textAlign = 'center';
  [32, 64, 96, 128].forEach(l => {
    ctx.fillText(l + 'K', xPos(l), H - 8);
  });

  // X-axis title
  ctx.fillStyle = '#5c6370';
  ctx.fillText('context length', W / 2, H - 1);

  // Y-axis label
  ctx.save();
  ctx.translate(12, PAD.t + cH / 2);
  ctx.rotate(-Math.PI / 2);
  ctx.fillText('relative cost', 0, 0);
  ctx.restore();

  // Annotation at 128K
  const x128 = xPos(128);
  ctx.fillStyle = '#e06c75';
  ctx.font = `bold ${10 * Math.min(DPR, 1.5)}px monospace`;
  ctx.textAlign = 'right';
  ctx.fillText('dense', x128 - 4, yPos(denseCost(128)) - 6);
  ctx.fillStyle = '#8b5cf6';
  ctx.fillText('DSA', x128 - 4, yPos(dsaCost(128)) + 14);
})();

// ─── MLA canvas ───
let mlaMode = 'mha';
function setMlaMode(mode) {
  mlaMode = mode;
  document.getElementById('mla-mha-btn').classList.toggle('active', mode === 'mha');
  document.getElementById('mla-mqa-btn').classList.toggle('active', mode === 'mqa');
  drawMla();
}

function drawMla() {
  const canvas = document.getElementById('mla-canvas');
  if (!canvas) return;
  const W = canvas.clientWidth, H = 260, DPR = window.devicePixelRatio || 1;
  canvas.width = W * DPR; canvas.height = H * DPR;
  const ctx = canvas.getContext('2d');
  ctx.scale(DPR, DPR);

  const isMha = mlaMode === 'mha';
  ctx.clearRect(0, 0, W, H);

  function box(x, y, w, h, color, label, sub) {
    ctx.fillStyle = color + '22';
    ctx.strokeStyle = color;
    ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.roundRect(x, y, w, h, 6); ctx.fill(); ctx.stroke();
    ctx.fillStyle = color;
    ctx.font = `bold ${10}px monospace`;
    ctx.textAlign = 'center';
    ctx.fillText(label, x + w/2, y + h/2 + (sub ? -4 : 4));
    if (sub) {
      ctx.fillStyle = color + 'aa';
      ctx.font = `${9}px monospace`;
      ctx.fillText(sub, x + w/2, y + h/2 + 10);
    }
  }

  function arrow(x1, y1, x2, y2, label, color) {
    color = color || '#5c6370';
    ctx.strokeStyle = color;
    ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.moveTo(x1, y1); ctx.lineTo(x2, y2); ctx.stroke();
    // arrowhead
    const angle = Math.atan2(y2-y1, x2-x1);
    ctx.beginPath();
    ctx.moveTo(x2, y2);
    ctx.lineTo(x2 - 8*Math.cos(angle-0.4), y2 - 8*Math.sin(angle-0.4));
    ctx.lineTo(x2 - 8*Math.cos(angle+0.4), y2 - 8*Math.sin(angle+0.4));
    ctx.closePath(); ctx.fillStyle = color; ctx.fill();
    if (label) {
      ctx.fillStyle = color;
      ctx.font = '9px monospace';
      ctx.textAlign = 'center';
      ctx.fillText(label, (x1+x2)/2 + 14, (y1+y2)/2 - 4);
    }
  }

  const cx = W / 2;
  // Input token
  box(cx - 50, 8, 100, 28, '#5c6370', 'h_t  (input)', null);

  // Compressed latent
  box(cx - 50, 58, 100, 28, '#06b6d4', 'c_t^Q (query latent)', null);
  arrow(cx, 36, cx, 58, null, '#5c6370');

  if (isMha) {
    // Per-head keys/values
    const headCols = [-100, -40, 20, 80];
    headCols.forEach((dx, i) => {
      box(cx + dx - 22, 118, 44, 26, '#8b5cf6', `K_${i+1}`, null);
      box(cx + dx - 22, 154, 44, 26, '#10b981', `V_${i+1}`, null);
      arrow(cx, 86, cx + dx, 118, null, '#5c6370');
    });
    // Attention
    box(cx - 80, 200, 160, 28, '#8b5cf6', 'Multi-Head Attention', 'H_A heads, d_v each');
    for (let i = 0; i < 4; i++) {
      const dx = [-100,-40,20,80][i];
      arrow(cx + dx, 180, cx, 200, null, '#5c6370');
    }
    // c_kv label
    box(cx + 120, 58, 90, 28, '#06b6d4', 'c_s^KV', 'per-position');
    ctx.strokeStyle = '#06b6d4'; ctx.setLineDash([4,3]); ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(cx + 50, 72); ctx.lineTo(cx + 120, 72); ctx.stroke();
    ctx.setLineDash([]);

    document.getElementById('mla-desc').textContent =
      'MHA mode: each of the H_A heads derives its own key/value from c_s^KV via W_UK_i, W_UV_i. Used during training and prefilling.';
  } else {
    // Single shared latent
    box(cx - 50, 118, 100, 28, '#f59e0b', 'c_s^KV (shared)', 'ONE per position');
    arrow(cx, 86, cx, 118, null, '#5c6370');

    // Shared K, V
    box(cx - 60, 168, 55, 26, '#8b5cf6', 'K (shared)', null);
    box(cx + 5, 168, 55, 26, '#10b981', 'V (shared)', null);
    arrow(cx - 32, 146, cx - 32, 168, null, '#8b5cf6');
    arrow(cx + 32, 146, cx + 32, 168, null, '#10b981');

    // All heads use same K,V
    box(cx - 80, 214, 160, 28, '#8b5cf6', 'Multi-Query Attention', 'all heads share K, V');
    arrow(cx - 32, 194, cx - 20, 214, null, '#5c6370');
    arrow(cx + 32, 194, cx + 20, 214, null, '#5c6370');

    document.getElementById('mla-desc').textContent =
      'MQA mode (DSA): only ONE key and value per selected token, shared across all H_A heads. Enables efficient sparse selection — pick k latents, expand once for all heads.';
  }

  // Output
  box(cx - 50, isMha ? 238 : 248, 100, 24, '#10b981', 'u_t (output)', null);
  arrow(cx, isMha ? 228 : 242, cx, isMha ? 238 : 248, null, '#5c6370');
}

// delay to let canvas render with correct clientWidth
setTimeout(drawMla, 50);

// ─── Indexer canvas ───
(function() {
  const canvas = document.getElementById('indexer-canvas');
  if (!canvas) return;

  // Token sequence
  const tokens = [
    { text: 'def', score: 0.05 },
    { text: 'decorate', score: 0.82 },
    { text: '(', score: 0.03 },
    { text: 'func', score: 0.61 },
    { text: '):', score: 0.04 },
    { text: 'wrapper', score: 0.74 },
    { text: 'return', score: 0.22 },
    { text: 'wrapper', score: 0.71 },
    { text: 'class', score: 0.12 },
    { text: 'Foo', score: 0.08 },
    { text: '@decorate', score: 0.95 },
    { text: 'syntax', score: 0.15 },
    { text: 'args', score: 0.31 },
    { text: 'kwargs', score: 0.29 },
    { text: 'apply', score: 0.41 },
    { text: 'callsite', score: 0.09 },
  ];
  const k = 6;
  const sorted = [...tokens].sort((a,b) => b.score - a.score);
  const topK = new Set(sorted.slice(0, k).map(t => t.text + t.score));

  const W = canvas.clientWidth, H = 220, DPR = window.devicePixelRatio || 1;
  canvas.width = W * DPR; canvas.height = H * DPR;
  const ctx = canvas.getContext('2d');
  ctx.scale(DPR, DPR);

  let hoveredIdx = -1;

  function draw() {
    ctx.clearRect(0, 0, W, H);
    const cols = 8;
    const rows = Math.ceil(tokens.length / cols);
    const cellW = W / cols;
    const cellH = 60;
    const offsetY = 20;

    tokens.forEach((tok, i) => {
      const col = i % cols, row = Math.floor(i / cols);
      const x = col * cellW, y = offsetY + row * cellH;
      const isTop = topK.has(tok.text + tok.score);
      const isHover = i === hoveredIdx;

      // Background
      const baseAlpha = 0.08 + tok.score * 0.25;
      const barH = 30 * tok.score;
      ctx.fillStyle = isTop ? `rgba(139,92,246,${baseAlpha + 0.1})` : `rgba(255,255,255,${baseAlpha * 0.3})`;
      ctx.fillRect(x + 4, y + 4, cellW - 8, 52);

      // Score bar
      ctx.fillStyle = isTop ? '#8b5cf6' : '#3d4257';
      ctx.fillRect(x + 4, y + 52 - barH, (cellW - 8) * tok.score, barH);

      // Border highlight
      if (isTop) {
        ctx.strokeStyle = '#8b5cf6';
        ctx.lineWidth = 1.5;
        ctx.strokeRect(x + 4, y + 4, cellW - 8, 52);
      }
      if (isHover) {
        ctx.strokeStyle = '#06b6d4';
        ctx.lineWidth = 2;
        ctx.strokeRect(x + 3, y + 3, cellW - 6, 54);
      }

      // Token label
      ctx.fillStyle = isTop ? '#a78bfa' : '#6b7280';
      ctx.font = `${isTop ? 'bold ' : ''}${10}px monospace`;
      ctx.textAlign = 'center';
      ctx.fillText(tok.text, x + cellW/2, y + 22);

      // Score label
      ctx.fillStyle = isTop ? '#c4b5fd' : '#4b5563';
      ctx.font = '9px monospace';
      ctx.fillText(tok.score.toFixed(2), x + cellW/2, y + 36);

      // Top-k badge
      if (isTop) {
        ctx.fillStyle = '#8b5cf6';
        ctx.font = 'bold 8px monospace';
        ctx.fillText('✓TOP', x + cellW/2, y + 52);
      }
    });

    // Query token label
    ctx.fillStyle = '#06b6d4';
    ctx.font = 'bold 11px monospace';
    ctx.textAlign = 'left';
    ctx.fillText('QUERY: "decorators" → scoring 16 context tokens', 4, 14);
  }

  draw();

  canvas.addEventListener('mousemove', (e) => {
    const rect = canvas.getBoundingClientRect();
    const mx = (e.clientX - rect.left) * (W / rect.width);
    const my = (e.clientY - rect.top) * (H / rect.height);
    const cols = 8, cellW = W / cols, cellH = 60, offsetY = 20;
    let found = -1;
    tokens.forEach((tok, i) => {
      const col = i % cols, row = Math.floor(i / cols);
      const x = col * cellW, y = offsetY + row * cellH;
      if (mx >= x+4 && mx <= x+cellW-4 && my >= y+4 && my <= y+60) found = i;
    });
    if (found !== hoveredIdx) {
      hoveredIdx = found;
      draw();
      const info = document.getElementById('indexer-info');
      if (found >= 0) {
        const t = tokens[found];
        const rank = sorted.indexOf(t) + 1;
        const selected = topK.has(t.text + t.score);
        info.textContent = `"${t.text}" — index score: ${t.score.toFixed(2)} — rank: #${rank} — ${selected ? '✓ SELECTED (top-k)' : '✗ not selected'}`;
        info.style.color = selected ? '#a78bfa' : '#5c6370';
      } else {
        info.textContent = '';
      }
    }
  });
})();

// ─── Attention sparsity canvas ───
let currentK = 'all';
function setK(k) {
  currentK = k;
  document.querySelectorAll('.k-btn[data-k]').forEach(b => b.classList.toggle('active', b.dataset.k === k));
  drawAttn();
}

function drawAttn() {
  const canvas = document.getElementById('attn-canvas');
  if (!canvas) return;
  const W = canvas.clientWidth, H = 240, DPR = window.devicePixelRatio || 1;
  canvas.width = W * DPR; canvas.height = H * DPR;
  const ctx = canvas.getContext('2d');
  ctx.scale(DPR, DPR);

  const N = 32; // sequence length for display
  const cellW = W / N, cellH = H / N;
  const kVal = currentK === 'all' ? N : parseInt(currentK);

  // Seeded RNG for reproducible attention scores
  function seededRand(n) { return ((1664525*n+1013904223)&0x7fffffff)/0x7fffffff; }

  // Generate "realistic" attention scores per query
  // Bias toward nearby positions and a few "anchor" positions
  function getScores(row) {
    const scores = Array.from({length: N}, (_, col) => {
      if (col > row) return 0; // causal mask
      const recency = Math.exp(-(row - col) / 8) * 0.4;
      const random  = seededRand(row * 100 + col) * 0.6;
      const special  = seededRand(col * 7 + 3) > 0.85 ? 0.3 : 0;
      return recency + random + special;
    });
    return scores;
  }

  ctx.fillStyle = '#0d0d14';
  ctx.fillRect(0, 0, W, H);

  let totalSelected = 0;
  let totalCausal = 0;

  for (let row = 0; row < N; row++) {
    const scores = getScores(row);
    const validCols = scores.map((s, i) => [s, i]).filter(([s]) => s > 0);
    totalCausal += validCols.length;

    let selectedSet;
    if (currentK === 'all') {
      selectedSet = new Set(validCols.map(([, i]) => i));
    } else {
      const sorted = [...validCols].sort(([a], [b]) => b - a);
      selectedSet = new Set(sorted.slice(0, Math.min(kVal, sorted.length)).map(([, i]) => i));
    }
    totalSelected += selectedSet.size;

    for (let col = 0; col <= row; col++) {
      const x = col * cellW, y = row * cellH;
      if (selectedSet.has(col)) {
        const score = scores[col];
        const intensity = 0.3 + score * 0.7;
        ctx.fillStyle = currentK === 'all'
          ? `rgba(100,120,200,${intensity * 0.8})`
          : `rgba(139,92,246,${intensity})`;
        ctx.fillRect(x+0.5, y+0.5, cellW-1, cellH-1);
      } else {
        ctx.fillStyle = 'rgba(255,255,255,0.03)';
        ctx.fillRect(x+0.5, y+0.5, cellW-1, cellH-1);
      }
    }
  }

  // Stats
  const pct = (totalSelected / totalCausal * 100).toFixed(1);
  const stats = document.getElementById('sparsity-stats');
  if (stats) {
    stats.textContent = currentK === 'all'
      ? `Dense: 100% of causal context attended (${totalCausal} cells active per matrix)`
      : `k=${kVal}: ${pct}% of causal context — ${totalSelected} cells vs ${totalCausal} in dense`;
  }
}

setTimeout(drawAttn, 50);

// ─── Step navigator ───
let currentStep = 0;
function gotoStep(n) {
  const boxes = document.querySelectorAll('#training-steps .step-box');
  currentStep = Math.max(0, Math.min(n, boxes.length - 1));
  boxes.forEach((b, i) => {
    b.classList.remove('active','done');
    if (i === currentStep) b.classList.add('active');
    else if (i < currentStep) b.classList.add('done');
  });
  const prev = document.getElementById('step-prev');
  const next = document.getElementById('step-next');
  const prog = document.getElementById('step-prog');
  if (prev) prev.disabled = currentStep === 0;
  if (next) next.disabled = currentStep >= boxes.length - 1;
  if (prog) prog.textContent = `Step ${currentStep+1} of ${boxes.length}`;
  boxes.forEach((b, i) => {
    const num = b.querySelector('.step-num');
    if (num) num.textContent = i < currentStep ? '✓' : String(i+1);
  });
}
gotoStep(0);

// ─── Animated bar chart ───
const resultsSection = document.getElementById('s-results');
if (resultsSection) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          b.style.width = (parseFloat(b.dataset.w)) + '%';
        });
      }
    });
  }, { threshold: 0.3 }).observe(resultsSection);
}
</script>
</BaseLayout>

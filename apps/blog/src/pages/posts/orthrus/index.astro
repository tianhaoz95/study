<span class="cs-line hl-g">        accepted = model.parallel_step(cache)</span>
<span class="cs-line hl-g">        tokens.extend(accepted)         <span class="cmt"># avg 6-11 tokens / 2 passes</span></span>
<span class="cs-line">    <span class="kw">return</span> tokens</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Speedup on MATH-500 (Qwen3-8B):</span>
<span class="cs-line cmt">#   AR:     1.0× (baseline)</span>
<span class="cs-line cmt">#   Orthrus: 5.95× (T=0), 5.43× (T=1)</span>
<span class="cs-line cmt">#   Memory overhead: 0 bytes (shared cache)</span>

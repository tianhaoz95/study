<span class="cs-line cmt"># AR: exact causal chain</span>
<span class="cs-line cmt">#   p(x₁,…,xN) = ∏ p(xᵢ | x&lt;ᵢ)</span>
<span class="cs-line cmt">#   no independence assumption</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># DLM: conditional independence within block</span>
<span class="cs-line cmt">#   p(y | c) ≈ ∏ p(yₖ | c, ỹ)</span>
<span class="cs-line cmt">#   yₖ does NOT condition on yₖ₋₁ realized value</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Consequence on reasoning chains:</span>
<span class="cs-line cmt">#   "x² = 4, so x = 2, so x+1 = ___"</span>
<span class="cs-line cmt">#   DLM predicts x+1 while uncertain about x</span>
<span class="cs-line cmt">#   → compounding errors on long trajectories</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Empirical drift (MATH-500):</span>
<span class="cs-line cmt">#   Qwen3-8B AR baseline:      86.2%</span>
<span class="cs-line cmt">#   Fast-dLLM-v2 (500B train): 61.5%  (-11.1pp)</span>
<span class="cs-line cmt">#   SDAR-Qwen3-8B (50B train): 78.6%  (-7.6pp)</span>
<span class="cs-line cmt">#   Orthrus (0.6B train):      86.2%  (-0.0pp)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Why Orthrus avoids drift:</span>
<span class="cs-line cmt">#   AR backbone is FROZEN — weights never change</span>
<span class="cs-line cmt">#   Consensus mechanism guarantees exact dist.</span>
<span class="cs-line cmt">#   Quality ceiling = frozen AR model itself</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-arch">
      <pre class="cs-pre">
<span class="cs-line cmt"># Dual-view attention in each transformer layer</span>
<span class="cs-line cmt"># AR path: frozen (W_Q, W_K, W_V unchanged)</span>
<span class="cs-line cmt"># Diff path: trainable (W_Q^d, W_K^d, W_V^d)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># AR attention (standard causal)</span>
<span class="cs-line hl-c">O_AR = softmax(Q_AR @ K_AR.T / sqrt(d)) @ V_AR</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Diffusion attention (Eq. 4 from paper)</span>
<span class="cs-line cmt"># attends to BOTH AR cache AND diff block</span>
<span class="cs-line hl-p">K_full = concat(K_AR, K_diff, dim=seq)</span>
<span class="cs-line hl-p">V_full = concat(V_AR, V_diff, dim=seq)</span>
<span class="cs-line hl-p">O_diff = softmax(Q_diff @ K_full.T / sqrt(d)) @ V_full</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Block mask for diffusion view (Eq. 6):</span>
<span class="cs-line cmt">#   (i) causal attention to AR context (k &lt; L)</span>
<span class="cs-line cmt">#   (ii) bidirectional within same block</span>
<span class="cs-line cmt">#   (iii) no cross-block attention (prevents leak)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Parameter budget (8B model):</span>
<span class="cs-line cmt">#   Frozen AR: 84% of params (untouched)</span>
<span class="cs-line cmt">#   Trainable diff heads: 16% of params</span>
<span class="cs-line cmt">#   Extra KV cache memory: 0 bytes</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Training objective (Eq. 7):</span>
<span class="cs-line cmt">#   L = E[ Σ D_KL(p_AR || p_diff) ]</span>
<span class="cs-line cmt">#   distills full AR distribution into diff head</span>
<span class="cs-line cmt">#   600K examples, &lt;24h on 8×H200</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-inference">
      <pre class="cs-pre">
<span class="cs-line cmt"># Orthrus inference loop (Algorithm 1)</span>
<span class="cs-line"> </span>
<span class="cs-line kw">def</span> <span class="fn">orthrus_loop</span>(model, prompt, K=32):</span>
<span class="cs-line hl-c">    cache = model.ar.prefill(prompt)    <span class="cmt"># pass 1/2</span></span>
<span class="cs-line hl-c">    anchor = model.ar.greedy(cache)</span>
<span class="cs-line">    output = [anchor]</span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="kw">while</span> <span class="kw">not</span> eos_generated:</span>
<span class="cs-line cmt">      # Pass 1: diffusion projects K candidates</span>
<span class="cs-line hl-p">        block = [anchor] + [MASK] * (K-1)</span>
<span class="cs-line hl-p">        cands = model.diff.forward(block, cache)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt">      # Pass 2: AR validates via rejection sampling</span>
<span class="cs-line hl-g">        accepted, correction = consensus(</span>
<span class="cs-line hl-g">            cands, model.ar, cache, output</span>
<span class="cs-line hl-g">        )</span>
<span class="cs-line">        output.extend(accepted + [correction])</span>
<span class="cs-line">        cache.extend(accepted + [correction])</span>
<span class="cs-line">        anchor = correction</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Consensus (greedy T=0):</span>
<span class="cs-line kw">def</span> <span class="fn">consensus</span>(cands, ar, cache, output):</span>
<span class="cs-line">    accepted = []</span>
<span class="cs-line">    <span class="kw">for</span> k, tok <span class="kw">in</span> <span class="fn">enumerate</span>(cands):</span>
<span class="cs-line">        ar_pred = ar.greedy(cache + accepted)</span>
<span class="cs-line hl-g">        <span class="kw">if</span> tok == ar_pred:</span>
<span class="cs-line hl-g">            accepted.append(tok)  <span class="cmt"># keep</span></span>
<span class="cs-line hl-p">        <span class="kw">else</span>:</span>
<span class="cs-line hl-p">            <span class="kw">return</span> accepted, ar_pred  <span class="cmt"># lossless correction</span></span>
<span class="cs-line">    <span class="kw">return</span> accepted, ar.greedy(cache + accepted)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Guarantee: output ≡ greedy AR (exact distribution)</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-blocksize">
      <pre class="cs-pre">
<span class="cs-line cmt"># Block size K ablation — MATH-500, Qwen3-8B</span>
<span class="cs-line cmt"># TPF = Total Tokens Generated / Total Passes</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># K=4:  TPF 1.85,  latency ~40ms/pass</span>
<span class="cs-line cmt"># K=8:  TPF 3.30,  latency ~40ms/pass</span>
<span class="cs-line cmt"># K=16: TPF 5.01,  latency ~40ms/pass</span>
<span class="cs-line cmt"># K=32: TPF 6.35,  latency ~40ms/pass  ← selected</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Why latency stays flat:</span>
<span class="cs-line cmt">#   diff head processes block against frozen cache</span>
<span class="cs-line cmt">#   bottleneck is attention over KV cache (O(L))</span>
<span class="cs-line cmt">#   not masked positions (O(K) — negligible at K≤32)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Multi-step denoising comparison:</span>
<span class="cs-line cmt">#   Strategy    Passes  TPF</span>
<span class="cs-line cmt">#   Multi-step   2      3.53</span>
<span class="cs-line cmt">#   Single-step  1      6.35  ← 1.8× better</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Insight: single-step projection is optimal.</span>
<span class="cs-line cmt"># Multi-step adds a pass without enough quality</span>
<span class="cs-line cmt"># gain to compensate — acceptance rate is already</span>
<span class="cs-line cmt"># high from direct distillation.</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Training config (K=32):</span>
<span class="cs-line cmt">#   256 masked blocks per example</span>
<span class="cs-line cmt">#   max context length 2048 tokens</span>
<span class="cs-line cmt">#   FlexAttention + FlashAttention-4 backend</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-results">
      <pre class="cs-pre">
<span class="cs-line cmt"># Full benchmark results — Orthrus-Qwen3-8B</span>
<span class="cs-line cmt"># TPF and speedup vs AR baseline (T=0)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Task          TPF   Speedup  Accuracy (same as AR)</span>
<span class="cs-line cmt"># GSM8K         5.30  5.22×    96.0%</span>
<span class="cs-line cmt"># MATH-500      6.35  5.95×    86.2%</span>
<span class="cs-line cmt"># AIME24        5.63  6.81×    28.3%</span>

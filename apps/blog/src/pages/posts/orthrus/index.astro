<script>
// ─── TOC + sidebar toggles ───────────────────────────────────────
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});
const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ─── Code sidebar tab switching ──────────────────────────────────
const tabMeta = {
  bottleneck: { file: 'orthrus/bottleneck.py',  title: 'The Sequential Bottleneck' },
  drift:      { file: 'orthrus/drift.py',       title: 'Why Diffusion Drifts' },
  arch:       { file: 'orthrus/architecture.py',title: 'Architecture' },
  inference:  { file: 'orthrus/inference.py',   title: 'Inference Loop' },
  blocksize:  { file: 'orthrus/block_size.py',  title: 'Block Size K' },
  results:    { file: 'orthrus/results.py',     title: 'Results' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ─── IntersectionObserver: TOC + tab sync on scroll ──────────────
const sectionMap = {
  's-bottleneck': 'bottleneck',
  's-drift':      'drift',
  's-arch':       'arch',
  's-inference':  'inference',
  's-blocksize':  'blocksize',
  's-results':    'results',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ─── Generation race canvas (§01) ────────────────────────────────
(function() {
  const canvas = document.getElementById('gen-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;

  function resize() {
    const W = canvas.clientWidth, H = 280;
    canvas.width = W * DPR; canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
    return { W, H };
  }
  let { W, H } = resize();

  const TOKENS = ['14', ',', 'and', '2', '×', '8', '=', '16'];
  const COLORS_AR   = 'rgba(6,182,212,0.85)';
  const COLORS_DIFF = 'rgba(139,92,246,0.85)';
  const BOX_W = 46, BOX_H = 32, GAP = 6;
  const ROW_Y_AR   = H * 0.28;
  const ROW_Y_DIFF = H * 0.72;

  let arVisible   = 0;   // how many AR tokens revealed
  let diffVisible = 0;   // how many diff tokens revealed
  let phase = 0;         // 0=idle,1=ar-running,2=diff-pass1,3=diff-pass2,4=done
  let frame = 0;
  let raf = null;

  function totalWidth() { return TOKENS.length * (BOX_W + GAP) - GAP; }

  function drawRow(yCenter, tokens, nVisible, label, color, passLabel) {
    ctx.save();
    const startX = (W - totalWidth()) / 2;

    // label
    ctx.font = `600 11px var(--ff-mono, monospace)`;
    ctx.fillStyle = 'rgba(255,255,255,0.35)';
    ctx.textAlign = 'left';
    ctx.fillText(label, startX, yCenter - 24);

    // pass label
    ctx.font = `10px var(--ff-mono, monospace)`;
    ctx.fillStyle = color;
    ctx.textAlign = 'right';
    ctx.fillText(passLabel, startX + totalWidth(), yCenter - 24);

    tokens.forEach((tok, i) => {
      const x = startX + i * (BOX_W + GAP);
      const y = yCenter - BOX_H / 2;
      const visible = i < nVisible;

      // box background
      ctx.fillStyle = visible ? color.replace('0.85', '0.18') : 'rgba(255,255,255,0.04)';
      ctx.strokeStyle = visible ? color : 'rgba(255,255,255,0.09)';
      ctx.lineWidth = visible ? 1.5 : 1;
      ctx.beginPath();
      ctx.roundRect(x, y, BOX_W, BOX_H, 5);
      ctx.fill(); ctx.stroke();

      if (visible) {
        ctx.font = `700 11px var(--ff-mono, monospace)`;
        ctx.fillStyle = 'rgba(255,255,255,0.9)';
        ctx.textAlign = 'center';
        ctx.fillText(tok, x + BOX_W / 2, y + BOX_H / 2 + 4);
      }
    });
    ctx.restore();
  }

  function drawPassCounter() {
    ctx.save();
    const arPasses = arVisible;           // one pass per token
    const diffPasses = phase >= 2 ? (phase >= 3 ? 2 : 1) : 0;
    const arColor  = 'rgba(6,182,212,0.85)';
    const diffColor = 'rgba(139,92,246,0.85)';

    // prompt label
    ctx.font = `11px var(--ff-mono, monospace)`;
    ctx.fillStyle = 'rgba(255,255,255,0.3)';
    ctx.textAlign = 'center';
    ctx.fillText('prompt: "2 × 6 = 12, so 2 × 7 ="', W / 2, H * 0.1);
    ctx.restore();

    // update pass counter element
    if (phase === 4) {
      document.getElementById('pass-display').textContent =
        `AR: ${arPasses} passes  |  Orthrus: 2 passes`;
    } else if (phase > 0) {
      document.getElementById('pass-display').textContent =
        `AR: ${arVisible} of 8 passes…`;
    }
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);

    // divider line
    ctx.save();
    ctx.strokeStyle = 'rgba(255,255,255,0.06)';
    ctx.lineWidth = 1;
    ctx.setLineDash([4, 4]);
    ctx.beginPath();
    ctx.moveTo(20, H / 2); ctx.lineTo(W - 20, H / 2);
    ctx.stroke();
    ctx.setLineDash([]);
    ctx.restore();

    const arPassLabel   = phase === 0 ? '' : `${arVisible} pass${arVisible !== 1 ? 'es' : ''}`;
    const diffPassLabel = phase === 0 ? '' : phase < 2 ? '' : phase === 2 ? '1 pass (project)' : '2 passes total';

    drawRow(ROW_Y_AR,   TOKENS, arVisible,   'Autoregressive', COLORS_AR,   arPassLabel);
    drawRow(ROW_Y_DIFF, TOKENS, diffVisible, 'Orthrus',        COLORS_DIFF, diffPassLabel);
    drawPassCounter();

    // acceptance checkmarks for Orthrus in phase 3
    if (phase >= 3 && diffVisible === TOKENS.length) {
      const startX = (W - totalWidth()) / 2;
      ctx.save();
      ctx.font = '11px sans-serif';
      ctx.fillStyle = 'rgba(16,185,129,0.9)';
      ctx.textAlign = 'center';
      TOKENS.forEach((_, i) => {
        const x = startX + i * (BOX_W + GAP) + BOX_W / 2;
        ctx.fillText('✓', x, ROW_Y_DIFF + BOX_H / 2 + 18);
      });
      ctx.restore();
    }
  }

  function tick() {
    frame++;
    if (phase === 1) {
      // AR: reveal one token every 18 frames
      if (frame % 18 === 0 && arVisible < TOKENS.length) {
        arVisible++;
      }
      if (arVisible >= TOKENS.length) { phase = 2; frame = 0; }
    } else if (phase === 2) {
      // Diff pass 1: all tokens reveal together after 20 frames
      if (frame >= 20) { diffVisible = TOKENS.length; phase = 3; frame = 0; }
    } else if (phase === 3) {
      // short pause then done
      if (frame >= 30) { phase = 4; cancelAnimationFrame(raf); raf = null; }
    }
    draw();
    if (phase !== 0 && phase !== 4) raf = requestAnimationFrame(tick);
  }

  draw();

  document.getElementById('gen-play').addEventListener('click', () => {
    if (raf || phase === 4) return;
    if (phase === 0) { phase = 1; frame = 0; }
    raf = requestAnimationFrame(tick);
  });
  document.getElementById('gen-reset').addEventListener('click', () => {
    if (raf) { cancelAnimationFrame(raf); raf = null; }
    arVisible = 0; diffVisible = 0; phase = 0; frame = 0;
    document.getElementById('pass-display').textContent = '—';
    draw();
  });
})();

// ─── Step navigator (§04) ────────────────────────────────────────
(function() {
  let step = 0;
  const boxes   = document.querySelectorAll('.step-box');
  const prevBtn = document.getElementById('step-prev');
  const nextBtn = document.getElementById('step-next');
  const progEl  = document.getElementById('step-prog');

  // consensus token animation state
  const ACCEPT = [0, 1, 2, 3, 4, 5];  // first 6 accepted
  const REJECT = 6;                    // "is" rejected
  const RESAMP = 7;                    // "=" resampled

  function renderConsensus(active) {
    const row = document.getElementById('consensus-row');
    if (!row) return;
    const chips = row.querySelectorAll('.tok-chip');
    chips.forEach((c, i) => {
      c.classList.remove('accepted', 'rejected', 'resampled');
      if (!active) return;
      if (ACCEPT.includes(i)) c.classList.add('accepted');
      else if (i === REJECT) c.classList.add('rejected');
      else if (i === RESAMP) c.classList.add('resampled');
    });
  }

  function updateSteps() {
    boxes.forEach((b, i) => {
      b.classList.remove('active', 'done');
      if (i === step) b.classList.add('active');
      else if (i < step) b.classList.add('done');
    });
    if (prevBtn) prevBtn.disabled = step === 0;
    if (nextBtn) nextBtn.disabled = step === boxes.length - 1;
    if (progEl)  progEl.textContent = `Step ${step + 1} of ${boxes.length}`;
    boxes.forEach((b, i) => {
      const n = b.querySelector('.step-num');
      if (n) n.textContent = i < step ? '✓' : String(i + 1);
    });
    renderConsensus(step === 2);
  }
  prevBtn?.addEventListener('click', () => { if (step > 0) { step--; updateSteps(); } });
  nextBtn?.addEventListener('click', () => { if (step < boxes.length - 1) { step++; updateSteps(); } });
  updateSteps();
})();

// ─── Block size K chart canvas (§05) ─────────────────────────────
(function() {
  const canvas = document.getElementById('k-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 220;
  canvas.width = W * DPR; canvas.height = H * DPR;
  ctx.scale(DPR, DPR);

  const KS      = [4, 8, 16, 32];
  const TPF_VAL = [1.85, 3.30, 5.01, 6.35];
  const LAT_VAL = [39.2, 39.8, 40.1, 40.6]; // roughly flat ~40ms

  const PAD = { top: 28, right: 60, bottom: 40, left: 56 };
  const CW = W - PAD.left - PAD.right;
  const CH = H - PAD.top - PAD.bottom;

  let activeK = 3; // index 3 = K=32

  function xPos(i) { return PAD.left + (i / (KS.length - 1)) * CW; }
  function yTPF(v)  { return PAD.top + CH - (v / 7) * CH; }
  function yLat(v)  { return PAD.top + CH - ((v - 35) / 10) * CH; }

  function draw(selIdx) {
    ctx.clearRect(0, 0, W, H);

    // grid lines
    ctx.strokeStyle = 'rgba(255,255,255,0.05)';
    ctx.lineWidth = 1;
    for (let i = 0; i <= 7; i++) {
      const y = PAD.top + CH - (i / 7) * CH;
      ctx.beginPath(); ctx.moveTo(PAD.left, y); ctx.lineTo(PAD.left + CW, y); ctx.stroke();
    }

    // axes
    ctx.strokeStyle = 'rgba(255,255,255,0.15)'; ctx.lineWidth = 1.2;
    ctx.beginPath();
    ctx.moveTo(PAD.left, PAD.top); ctx.lineTo(PAD.left, PAD.top + CH);
    ctx.lineTo(PAD.left + CW, PAD.top + CH); ctx.stroke();

    // axis labels
    ctx.font = '9px var(--ff-mono, monospace)';
    ctx.fillStyle = 'rgba(255,255,255,0.3)';
    ctx.textAlign = 'right';
    [0, 1, 2, 3, 4, 5, 6, 7].forEach(v => {
      const y = yTPF(v);
      ctx.fillText(v, PAD.left - 6, y + 3);
    });
    ctx.textAlign = 'center';
    KS.forEach((k, i) => {
      ctx.fillText(`K=${k}`, xPos(i), PAD.top + CH + 15);
    });

    // Latency line (amber, right axis)
    ctx.strokeStyle = 'rgba(245,158,11,0.7)'; ctx.lineWidth = 1.5;
    ctx.setLineDash([4, 3]);
    ctx.beginPath();
    LAT_VAL.forEach((v, i) => {
      const x = xPos(i), y = yLat(v);
      i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
    });
    ctx.stroke(); ctx.setLineDash([]);

    // latency label
    ctx.fillStyle = 'rgba(245,158,11,0.75)';
    ctx.font = '9px var(--ff-mono, monospace)';
    ctx.textAlign = 'right';
    ctx.fillText('latency ~40ms (flat)', PAD.left + CW - 2, yLat(LAT_VAL[LAT_VAL.length - 1]) - 5);

    // TPF line (purple)
    ctx.strokeStyle = 'rgba(139,92,246,0.85)'; ctx.lineWidth = 2;
    ctx.beginPath();
    TPF_VAL.forEach((v, i) => {
      const x = xPos(i), y = yTPF(v);
      i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
    });
    ctx.stroke();

    // TPF dots
    TPF_VAL.forEach((v, i) => {
      const x = xPos(i), y = yTPF(v);
      const sel = i === selIdx;
      ctx.beginPath();
      ctx.arc(x, y, sel ? 6 : 4, 0, Math.PI * 2);
      ctx.fillStyle = sel ? 'rgba(139,92,246,1)' : 'rgba(139,92,246,0.5)';
      ctx.fill();
      if (sel) {
        ctx.strokeStyle = '#fff'; ctx.lineWidth = 1.5;
        ctx.stroke();
      }
      // value label above dot
      ctx.font = sel ? 'bold 10px var(--ff-mono, monospace)' : '9px var(--ff-mono, monospace)';
      ctx.fillStyle = sel ? '#c4b5fd' : 'rgba(167,139,250,0.6)';
      ctx.textAlign = 'center';
      ctx.fillText(`${v}`, x, y - 10);
    });

    // TPF axis label
    ctx.save();
    ctx.translate(12, PAD.top + CH / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.font = '9px var(--ff-mono, monospace)';
    ctx.fillStyle = 'rgba(139,92,246,0.7)';
    ctx.textAlign = 'center';
    ctx.fillText('Tokens Per Forward Pass', 0, 0);
    ctx.restore();

    // title
    ctx.font = '10px var(--ff-mono, monospace)';
    ctx.fillStyle = 'rgba(255,255,255,0.2)';
    ctx.textAlign = 'center';
    ctx.fillText(`TPF vs Block Size K  (K=${KS[selIdx]} selected → ${TPF_VAL[selIdx]} TPF, ${(TPF_VAL[selIdx] / TPF_VAL[0]).toFixed(1)}× over K=4)`, W / 2, 14);
  }

  draw(activeK);

  document.querySelectorAll('.k-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      activeK = parseInt(btn.dataset.k);
      document.querySelectorAll('.k-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      draw(activeK);
    });
  });
})();

// ─── Animated bar charts (§06) ───────────────────────────────────
const resultsSection = document.getElementById('s-results');
if (resultsSection) {
  const io = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          const maxPct = 86.2; // MATH-500 top score
          b.style.width = (parseFloat(b.dataset.w) / maxPct * 97) + '%';
        });
        document.querySelectorAll('.acc-bar-fill[data-w]').forEach(b => {
          const maxAcc = 11.7;
          b.style.width = (parseFloat(b.dataset.w) / maxAcc * 95) + '%';
        });
        io.disconnect();
      }
    });
  }, { threshold: 0.2 });
  io.observe(resultsSection);
}
</script>
</BaseLayout>

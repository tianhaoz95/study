---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { postReadTime } from '../../../lib/readTimes';
const readTime = postReadTime(Astro.url.pathname.split('/').filter(Boolean).at(-1)!);
---
<BaseLayout
  title="Orthrus: Parallel Tokens, Zero Extra Memory | Catpuccino.ai"
  description="Orthrus freezes a pre-trained LLM and injects a lightweight diffusion head that shares the exact same KV cache — enabling speculative-decoding-style parallel generation with zero memory overhead and provably lossless output."
  crumb="Orthrus"
>


<span class="cs-line cmt"># Standard AR decode — N tokens, N passes</span>
<span class="cs-line kw">def</span> <span class="cs-line fn">ar_generate</span>(model, prompt, N):
<span class="cs-line">    cache = model.prefill(prompt)</span>
<span class="cs-line">    tokens = []</span>
<span class="cs-line hl-p">    <span class="kw">for</span> _ <span class="kw">in</span> <span class="fn">range</span>(N):                 <span class="cmt"># N sequential passes</span></span>
<span class="cs-line hl-p">        tok = model.decode_one(cache)  <span class="cmt"># load entire cache each time</span></span>
<span class="cs-line">        tokens.append(tok)</span>
<span class="cs-line">        cache.append(tok)</span>
<span class="cs-line">    <span class="kw">return</span> tokens</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Memory-bandwidth bottleneck:</span>
<span class="cs-line cmt">#   KV cache for 32K ctx, 8B model ≈ 16 GB</span>
<span class="cs-line cmt">#   N=512 tokens → 512 × 16 GB = 8 TB loaded</span>
<span class="cs-line cmt">#   GPU compute sits idle ~70% of time</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Orthrus: 2 passes per K tokens</span>
<span class="cs-line kw">def</span> <span class="cs-line fn">orthrus_generate</span>(model, prompt, N):

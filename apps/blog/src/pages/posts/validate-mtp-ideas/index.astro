// ── Loss gap canvas ─────────────────────────────────────────────────────────
let currentScenario = 'stable';
let currentSF = 0.1;

function makeLossData(scenario, sf) {
  const steps = 50;
  const lm = [], mtp1 = [], mtp2 = [];
  const divergeStart = 30;
  for (let i = 0; i <= steps; i++) {
    const t = i / steps;
    const noise = (Math.sin(i * 7.3) * 0.015 + Math.sin(i * 13.1) * 0.008);
    const lmV = 2.30 - 0.42 * Math.pow(t, 0.55) + noise;
    lm.push(lmV);
    if (scenario === 'stable') {
      const gap = 0.50 + sf * 0.3;
      mtp1.push(lmV + gap + noise * 0.6);
      mtp2.push(lmV + gap * 1.65 + noise * 0.8);
    } else {
      if (i <= divergeStart) {
        const gap = 0.50 + sf * 0.3;
        mtp1.push(lmV + gap + noise * 0.6);
        mtp2.push(lmV + gap * 1.65 + noise * 0.8);
      } else {
        const decay = Math.pow((i - divergeStart) / (steps - divergeStart), 1.4);
        const spike = sf * 8.0 * decay;
        mtp1.push(lmV + 0.5 + sf * 0.3 + spike + noise * 1.5);
        mtp2.push(lmV + 0.85 + sf * 0.4 + spike * 1.5 + noise * 1.8);
      }
    }
  }
  return { lm, mtp1, mtp2, steps };
}

function drawLossCanvas() {
  const canvas = document.getElementById('loss-canvas');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = canvas.clientHeight || 280;
  canvas.width = W * DPR; canvas.height = H * DPR;
  const ctx = canvas.getContext('2d');
  ctx.scale(DPR, DPR);

  const pad = { t: 24, r: 20, b: 40, l: 52 };
  const cw = W - pad.l - pad.r, ch = H - pad.t - pad.b;

  ctx.fillStyle = 'transparent';

  const data = makeLossData(currentScenario, currentSF);
  const allVals = [...data.lm, ...data.mtp1, ...data.mtp2];
  const minY = Math.min(...allVals) - 0.08;
  const maxY = Math.max(...allVals) + 0.12;

  function xp(i) { return pad.l + (i / data.steps) * cw; }
  function yp(v) { return pad.t + (1 - (v - minY) / (maxY - minY)) * ch; }

  // grid
  ctx.strokeStyle = 'rgba(255,255,255,0.04)';
  ctx.lineWidth = 1;
  for (let v = Math.ceil(minY * 5) / 5; v <= maxY; v += 0.2) {
    const y = yp(v);
    ctx.beginPath(); ctx.moveTo(pad.l, y); ctx.lineTo(pad.l + cw, y); ctx.stroke();
  }
  for (let i = 0; i <= 5; i++) {
    const x = pad.l + (i / 5) * cw;
    ctx.beginPath(); ctx.moveTo(x, pad.t); ctx.lineTo(x, pad.t + ch); ctx.stroke();
  }

  // axes
  ctx.strokeStyle = 'rgba(255,255,255,0.15)';
  ctx.lineWidth = 1;
  ctx.beginPath();
  ctx.moveTo(pad.l, pad.t); ctx.lineTo(pad.l, pad.t + ch);
  ctx.moveTo(pad.l, pad.t + ch); ctx.lineTo(pad.l + cw, pad.t + ch);
  ctx.stroke();

  // diverge marker
  if (currentScenario !== 'stable') {
    const dxp = xp(30);
    ctx.strokeStyle = 'rgba(239,68,68,0.3)';
    ctx.lineWidth = 1;
    ctx.setLineDash([4, 4]);
    ctx.beginPath(); ctx.moveTo(dxp, pad.t); ctx.lineTo(dxp, pad.t + ch); ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle = 'rgba(239,68,68,0.7)';
    ctx.font = '9px monospace';
    ctx.fillText('divergence begins', dxp + 4, pad.t + 14);
  }

  // draw line helper
  function drawLine(arr, color, dashed) {
    ctx.strokeStyle = color;
    ctx.lineWidth = 2;
    if (dashed) ctx.setLineDash([5, 4]);
    else ctx.setLineDash([]);
    ctx.beginPath();
    arr.forEach((v, i) => {
      const x = xp(i), y = yp(v);
      if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
    });
    ctx.stroke();
    ctx.setLineDash([]);
  }

  drawLine(data.lm,   'rgba(139,92,246,0.9)', false);
  drawLine(data.mtp1, 'rgba(6,182,212,0.85)', false);
  drawLine(data.mtp2, 'rgba(6,182,212,0.45)', true);

  // labels
  ctx.font = '10px monospace';
  ctx.fillStyle = 'rgba(139,92,246,0.9)';
  ctx.fillText('lm_loss', pad.l + 6, yp(data.lm[data.steps]) - 7);
  ctx.fillStyle = 'rgba(6,182,212,0.85)';
  ctx.fillText('mtp_1_loss', pad.l + 6, yp(data.mtp1[10]) - 7);
  ctx.fillStyle = 'rgba(6,182,212,0.5)';
  ctx.fillText('mtp_2_loss', pad.l + 6, yp(data.mtp2[6]) - 7);

  // x-axis labels
  ctx.fillStyle = 'rgba(255,255,255,0.3)';
  ctx.font = '9px monospace';
  for (let i = 0; i <= 5; i++) {
    const x = pad.l + (i / 5) * cw;
    ctx.fillText(String(i * 1000), x - 12, pad.t + ch + 16);
  }
  ctx.fillText('training steps', pad.l + cw / 2 - 35, pad.t + ch + 32);

  // y-axis labels
  ctx.save(); ctx.translate(12, pad.t + ch / 2); ctx.rotate(-Math.PI / 2);
  ctx.fillText('loss', -12, 0);
  ctx.restore();
  for (let v = Math.ceil(minY * 5) / 5; v <= maxY; v += 0.2) {
    const y = yp(v);
    if (y > pad.t + 5 && y < pad.t + ch - 5) {
      ctx.fillText(v.toFixed(1), 2, y + 3);
    }
  }

  // stable gap annotation
  if (currentScenario === 'stable') {
    const midI = 35;
    const y1 = yp(data.lm[midI]), y2 = yp(data.mtp1[midI]);
    const x  = xp(midI);
    ctx.strokeStyle = 'rgba(16,185,129,0.5)';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(x + 30, y1); ctx.lineTo(x + 30, y2); ctx.stroke();
    ctx.fillStyle = 'rgba(16,185,129,0.8)';
    ctx.font = '9px monospace';
    ctx.fillText('stable gap ✓', x + 34, (y1 + y2) / 2 + 3);
  }
}


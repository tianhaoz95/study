// ── SDSL canvas ─────────────────────────────────────────────────────────────
let sdslMode = 'all';

const SDSL_A = -0.028, SDSL_B = -0.015, SDSL_C = 0.98;
function sdslAlpha(draftPpl, targetPpl) {
  return Math.max(0, Math.min(1, SDSL_A * draftPpl + SDSL_B * targetPpl + SDSL_C));
}

function drawSdslCanvas() {
  const canvas = document.getElementById('sdsl-canvas');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = canvas.clientHeight || 300;
  canvas.width = W * DPR; canvas.height = H * DPR;
  const ctx = canvas.getContext('2d');
  ctx.scale(DPR, DPR);

  const pad = { t: 20, r: 30, b: 44, l: 52 };
  const cw = W - pad.l - pad.r, ch = H - pad.t - pad.b;

  const xMin = 4, xMax = 30;
  function xp(v) { return pad.l + ((v - xMin) / (xMax - xMin)) * cw; }
  function yp(v) { return pad.t + (1 - v) * ch; }

  // grid
  ctx.strokeStyle = 'rgba(255,255,255,0.04)';
  ctx.lineWidth = 1;
  for (let v = 0; v <= 1.01; v += 0.2) {
    const y = yp(v);
    ctx.beginPath(); ctx.moveTo(pad.l, y); ctx.lineTo(pad.l + cw, y); ctx.stroke();
  }
  for (let x = xMin; x <= xMax; x += 5) {
    const xc = xp(x);
    ctx.beginPath(); ctx.moveTo(xc, pad.t); ctx.lineTo(xc, pad.t + ch); ctx.stroke();
  }

  // axes
  ctx.strokeStyle = 'rgba(255,255,255,0.15)';
  ctx.lineWidth = 1;
  ctx.beginPath();
  ctx.moveTo(pad.l, pad.t); ctx.lineTo(pad.l, pad.t + ch);
  ctx.moveTo(pad.l, pad.t + ch); ctx.lineTo(pad.l + cw, pad.t + ch);
  ctx.stroke();

  // threshold line at alpha=0.7
  ctx.strokeStyle = 'rgba(6,182,212,0.5)';
  ctx.lineWidth = 1.5;
  ctx.setLineDash([5, 4]);
  const ty = yp(0.7);
  ctx.beginPath(); ctx.moveTo(pad.l, ty); ctx.lineTo(pad.l + cw, ty); ctx.stroke();
  ctx.setLineDash([]);
  ctx.fillStyle = 'rgba(6,182,212,0.7)';
  ctx.font = '9px monospace';
  ctx.fillText('α = 0.70 threshold', pad.l + 6, ty - 5);

  const configs = [
    { targetPpl: 5,  color: 'rgba(139,92,246,0.9)',  label: 'target PPL 5' },
    { targetPpl: 10, color: 'rgba(6,182,212,0.85)',   label: 'target PPL 10' },
    { targetPpl: 20, color: 'rgba(16,185,129,0.75)',  label: 'target PPL 20' },
  ];

  configs.forEach(cfg => {
    if (sdslMode !== 'all' && String(cfg.targetPpl) !== sdslMode) return;
    ctx.strokeStyle = cfg.color;
    ctx.lineWidth = 2.5;
    ctx.beginPath();
    for (let x = xMin; x <= xMax; x += 0.25) {
      const alpha = sdslAlpha(x, cfg.targetPpl);
      const px = xp(x), py = yp(alpha);
      if (x === xMin) ctx.moveTo(px, py); else ctx.lineTo(px, py);
    }
    ctx.stroke();

    // label at right end
    const lastAlpha = sdslAlpha(xMax - 1, cfg.targetPpl);
    ctx.fillStyle = cfg.color;
    ctx.font = '9px monospace';
    ctx.fillText(cfg.label, pad.l + cw - 74, yp(lastAlpha) - 6);

    // mark crossover with threshold
    const crossX = (0.7 - SDSL_C - SDSL_B * cfg.targetPpl) / SDSL_A;
    if (crossX > xMin && crossX < xMax) {
      ctx.fillStyle = cfg.color;
      ctx.beginPath();
      ctx.arc(xp(crossX), ty, 4, 0, Math.PI * 2);
      ctx.fill();
    }
  });

  // axes labels
  ctx.fillStyle = 'rgba(255,255,255,0.3)';
  ctx.font = '9px monospace';
  for (let x = xMin; x <= xMax; x += 5) {
    ctx.fillText(String(x), xp(x) - 6, pad.t + ch + 16);
  }
  ctx.fillText('draft head perplexity', pad.l + cw / 2 - 55, pad.t + ch + 34);
  for (let v = 0; v <= 1.01; v += 0.2) {
    const y = yp(v);
    if (y > pad.t + 4 && y < pad.t + ch - 4)
      ctx.fillText(v.toFixed(1), 4, y + 3);
  }
  ctx.save(); ctx.translate(11, pad.t + ch / 2);
  ctx.rotate(-Math.PI / 2);
  ctx.fillText('acceptance rate α', -45, 0);
  ctx.restore();
}

window.setSdslMode = function(mode) {
  sdslMode = mode;
  ['all','5','10','20'].forEach(k => {
    const btn = document.getElementById('ppl-' + k);
    if (btn) btn.classList.toggle('active', k === mode);
  });
  drawSdslCanvas();
};

// ── Serving dynamics canvas ─────────────────────────────────────────────────
function drawServingCanvas() {
  const canvas = document.getElementById('serving-canvas');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = canvas.clientHeight || 280;
  canvas.width = W * DPR; canvas.height = H * DPR;
  const ctx = canvas.getContext('2d');
  ctx.scale(DPR, DPR);

  const pad = { t: 20, r: 30, b: 44, l: 58 };
  const cw = W - pad.l - pad.r, ch = H - pad.t - pad.b;

  const lambdaMax = 100;
  function xp(v) { return pad.l + (v / lambdaMax) * cw; }
  function yp(v) { return pad.t + (1 - (v - 4) / (40 - 4)) * ch; }

  // AR model: slowly rising latency (memory bandwidth limited)
  function arLatency(lam) { return 10 + 0.06 * lam; }
  // MTP model: lower at low load (K tokens at once), saturates HBM at high load
  function mtpLatency(lam) {
    const base = 6.5;
    const hbm_sat = 0.0018 * lam * lam;
    const queue   = 0.03 * lam;
    return base + hbm_sat + queue;
  }

  // grid
  ctx.strokeStyle = 'rgba(255,255,255,0.04)';
  ctx.lineWidth = 1;
  for (let v = 6; v <= 40; v += 6) {
    const y = yp(v);
    ctx.beginPath(); ctx.moveTo(pad.l, y); ctx.lineTo(pad.l + cw, y); ctx.stroke();
  }
  for (let x = 0; x <= 100; x += 20) {
    const xc = xp(x);
    ctx.beginPath(); ctx.moveTo(xc, pad.t); ctx.lineTo(xc, pad.t + ch); ctx.stroke();
  }

  // axes
  ctx.strokeStyle = 'rgba(255,255,255,0.15)';
  ctx.lineWidth = 1;
  ctx.beginPath();
  ctx.moveTo(pad.l, pad.t); ctx.lineTo(pad.l, pad.t + ch);
  ctx.moveTo(pad.l, pad.t + ch); ctx.lineTo(pad.l + cw, pad.t + ch);
  ctx.stroke();

  // AR line
  ctx.strokeStyle = 'rgba(255,255,255,0.35)';
  ctx.lineWidth = 2;
  ctx.beginPath();
  for (let l = 0; l <= lambdaMax; l += 1) {
    const px = xp(l), py = yp(arLatency(l));
    if (l === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
  }
  ctx.stroke();

  // MTP line
  ctx.strokeStyle = 'rgba(139,92,246,0.9)';
  ctx.lineWidth = 2.5;
  ctx.beginPath();
  for (let l = 0; l <= lambdaMax; l += 1) {
    const v = mtpLatency(l);
    const py = yp(Math.min(v, 40));
    const px = xp(l);
    if (l === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
  }
  ctx.stroke();

  // crossover point
  let crossLam = null;
  for (let l = 0; l <= lambdaMax; l++) {
    if (mtpLatency(l) > arLatency(l)) { crossLam = l; break; }
  }
  if (crossLam !== null) {
    const cx = xp(crossLam), cy = yp(arLatency(crossLam));
    ctx.fillStyle = 'rgba(245,158,11,0.9)';
    ctx.beginPath(); ctx.arc(cx, cy, 6, 0, Math.PI * 2); ctx.fill();
    ctx.strokeStyle = 'rgba(245,158,11,0.5)';
    ctx.lineWidth = 1;
    ctx.setLineDash([4, 4]);
    ctx.beginPath(); ctx.moveTo(cx, pad.t); ctx.lineTo(cx, pad.t + ch); ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle = 'rgba(245,158,11,0.85)';
    ctx.font = '9px monospace';
    ctx.fillText('crossover @ ~' + crossLam + ' req/s', cx + 8, cy - 6);
  }

  // labels
  ctx.fillStyle = 'rgba(255,255,255,0.35)';
  ctx.font = '9px monospace';
  ctx.fillText('AR baseline', pad.l + 6, yp(arLatency(5)) - 5);
  ctx.fillStyle = 'rgba(139,92,246,0.9)';
  ctx.fillText('MTP parallel', pad.l + 6, yp(mtpLatency(5)) - 5);

  // axes labels
  ctx.fillStyle = 'rgba(255,255,255,0.3)';
  ctx.font = '9px monospace';
  for (let x = 0; x <= 100; x += 20) {
    ctx.fillText(String(x), xp(x) - 8, pad.t + ch + 16);
  }
  ctx.fillText('arrival rate λ (req/s)', pad.l + cw / 2 - 62, pad.t + ch + 33);
  for (let v = 6; v <= 38; v += 6) {
    const y = yp(v);
    if (y > pad.t + 4 && y < pad.t + ch - 4)
      ctx.fillText(v + 'ms', 4, y + 3);
  }
  ctx.save(); ctx.translate(11, pad.t + ch / 2);
  ctx.rotate(-Math.PI / 2);
  ctx.fillText('per-token latency', -45, 0);
  ctx.restore();
}

// ── init all canvases ───────────────────────────────────────────────────────
window.addEventListener('load', () => {
  drawLossCanvas();
  drawSdslCanvas();
  drawServingCanvas();
});
window.addEventListener('resize', () => {
  drawLossCanvas();
  drawSdslCanvas();
  drawServingCanvas();
});
</script>
</BaseLayout>

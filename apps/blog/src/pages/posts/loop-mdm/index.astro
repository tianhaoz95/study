---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="LoopMDM: Looped Masked Diffusion Language Models | Catpuccino.ai"
  description="Selectively looping early-middle transformer layers gives masked diffusion models 3.3× training efficiency and +8.5 points on GSM8K — at zero extra parameters."
  crumb="LoopMDM"
>


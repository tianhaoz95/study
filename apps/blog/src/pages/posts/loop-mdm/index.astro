<span class="cs-line cmt"># Standard MDM: predict all masks in ONE forward pass</span>
<span class="cs-line cmt"># No within-step revision possible.</span>
<span class="cs-line"> </span>
<span class="cs-line kw">def</span> <span class="cs-line fn">mdm_step</span><span class="cs-line">(model, x_t, t):</span>
<span class="cs-line hl-p">    logits = model(x_t, t)  <span class="cmt"># single forward pass</span></span>
<span class="cs-line">    probs = softmax(logits)  <span class="cmt"># predictions at all masks</span></span>
<span class="cs-line cmt">    # Commit some tokens based on reverse diffusion rule.</span>
<span class="cs-line cmt">    # Masked positions predicted independently — no revision.</span>
<span class="cs-line">    <span class="kw">return</span> commit_tokens(probs, x_t, t)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># The problem: position 3 predicts "sat" based on context.</span>
<span class="cs-line cmt"># Position 7 predicts "mat" based on context.</span>
<span class="cs-line cmt"># Neither can incorporate the other's prediction within this step.</span>
<span class="cs-line cmt"># For globally constrained text → inconsistencies.</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># LoopMDM solution: apply a shared mid-block S times</span>
<span class="cs-line kw">def</span> <span class="cs-line fn">loop_mdm_step</span><span class="cs-line">(model, x_t, t, S):</span>
<span class="cs-line hl-c">    H = model.head(x_t, t)   <span class="cmt"># initial hidden states</span></span>
<span class="cs-line hl-p">    <span class="kw">for</span> _ <span class="kw">in</span> <span class="fn">range</span>(S):       <span class="cmt"># loop S times</span></span>
<span class="cs-line hl-p">        H = model.mid(H)       <span class="cmt"># same weights, refined H</span></span>
<span class="cs-line hl-g">    probs = model.tail(H)     <span class="cmt"># decode after S loops</span></span>
<span class="cs-line">    <span class="kw">return</span> commit_tokens(probs, x_t, t)</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-background">
      <pre class="cs-pre">
<span class="cs-line cmt"># MDM forward (masking) process</span>
<span class="cs-line cmt"># αₜ: schedule s.t. α₀≈1 (clean), α₁≈0 (all masked)</span>
<span class="cs-line"> </span>
<span class="cs-line kw">def</span> <span class="cs-line fn">forward_mask</span><span class="cs-line">(x0, t, alpha_t):</span>
<span class="cs-line">    masked = []</span>
<span class="cs-line">    <span class="kw">for</span> tok <span class="kw">in</span> x0:</span>
<span class="cs-line hl-a">        <span class="kw">if</span> rand() &lt; alpha_t:   <span class="cmt"># keep with prob αₜ</span></span>
<span class="cs-line">            masked.append(tok)</span>
<span class="cs-line hl-c">        <span class="kw">else</span>:                   <span class="cmt"># mask with prob 1-αₜ</span></span>
<span class="cs-line">            masked.append(MASK)</span>
<span class="cs-line">    <span class="kw">return</span> masked</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Reverse: commit some masks given pθ predictions</span>
<span class="cs-line kw">def</span> <span class="cs-line fn">reverse_step</span><span class="cs-line">(x_t, probs, s, t):</span>
<span class="cs-line">    alpha_s_t = (1 - alpha(s)) / (1 - alpha(t))</span>
<span class="cs-line">    x_s = []</span>
<span class="cs-line">    <span class="kw">for</span> i, tok <span class="kw">in</span> <span class="fn">enumerate</span>(x_t):</span>
<span class="cs-line">        <span class="kw">if</span> tok != MASK: x_s.append(tok)  <span class="cmt"># keep unmasked</span></span>
<span class="cs-line hl-p">        <span class="kw">else</span>:  <span class="cmt"># either stay masked or commit</span></span>
<span class="cs-line hl-p">            <span class="kw">if</span> rand() &lt; alpha_s_t: x_s.append(MASK)</span>
<span class="cs-line hl-p">            <span class="kw">else</span>: x_s.append(<span class="fn">sample</span>(probs[i]))</span>
<span class="cs-line">    <span class="kw">return</span> x_s</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># NELBO training loss (simplified)</span>
<span class="cs-line cmt"># Weighted cross-entropy at masked positions only</span>
<span class="cs-line kw">def</span> <span class="cs-line fn">nelbo_loss</span><span class="cs-line">(model, x0, t):</span>
<span class="cs-line">    x_t = <span class="fn">forward_mask</span>(x0, t)</span>
<span class="cs-line">    probs = model(x_t, t)</span>
<span class="cs-line">    weight = alpha_prime(t) / (1 - alpha(t))</span>
<span class="cs-line hl-g">    loss = sum(</span>
<span class="cs-line hl-g">        weight * -<span class="fn">log</span>(probs[i][x0[i]])</span>
<span class="cs-line hl-g">        <span class="kw">for</span> i <span class="kw">if</span> x_t[i] == MASK</span>
<span class="cs-line hl-g">    )  <span class="cmt"># only penalize masked positions</span></span>
<span class="cs-line">    <span class="kw">return</span> loss</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-arch">
      <pre class="cs-pre">
<span class="cs-line cmt"># LoopMDM forward pass (eq. 4 in paper)</span>
<span class="cs-line"> </span>
<span class="cs-line kw">class</span> <span class="cs-line cls">LoopMDM</span><span class="cs-line">(nn.Module):</span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">__init__</span>(<span class="kw">self</span>, nh, nm, no, S_max):</span>
<span class="cs-line">        <span class="kw">super</span>().__init__()</span>
<span class="cs-line hl-c">        <span class="kw">self</span>.head = TransformerStack(nh)  <span class="cmt"># not shared</span></span>
<span class="cs-line hl-p">        <span class="kw">self</span>.mid  = TransformerStack(nm)  <span class="cmt"># SHARED block</span></span>
<span class="cs-line hl-g">        <span class="kw">self</span>.tail = TransformerStack(no)  <span class="cmt"># not shared</span></span>
<span class="cs-line">        <span class="kw">self</span>.S_max = S_max</span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">forward</span>(<span class="kw">self</span>, x_t, S=<span class="kw">None</span>):</span>
<span class="cs-line">        <span class="kw">if</span> S <span class="kw">is</span> <span class="kw">None</span>:</span>
<span class="cs-line hl-a">            S = randint(1, <span class="kw">self</span>.S_max)  <span class="cmt"># stochastic training</span></span>
<span class="cs-line hl-c">        H = <span class="kw">self</span>.head(x_t)      <span class="cmt"># (0) initial hidden states</span></span>
<span class="cs-line hl-p">        <span class="kw">for</span> k <span class="kw">in</span> <span class="fn">range</span>(S):      <span class="cmt"># loop S times</span></span>
<span class="cs-line hl-p">            H = <span class="kw">self</span>.mid(H)     <span class="cmt"># same weights each time</span></span>
<span class="cs-line hl-g">        <span class="kw">return</span> <span class="kw">self</span>.tail(H)    <span class="cmt"># decode to token probs</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Effective depth at S=12 (nh=1, nm=2, no=1):</span>
<span class="cs-line cmt">#   1 + 2×12 + 1 = 26 effective layers</span>
<span class="cs-line cmt"># Param count = 1 + 2 + 1 = 4-layer equivalent</span>
<span class="cs-line cmt"># → 6.5× depth amplification at no extra cost!</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Training FLOP cost (eq. 6 in paper):</span>
<span class="cs-line cmt"># F_loop = F_base + (E[S]-1) · nm · F_layer</span>
<span class="cs-line cmt"># E[S] = (S_max+1)/2 under uniform sampling</span>
<span class="cs-line cmt"># → Offset by training fewer steps to match total FLOPs</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-workspace">
      <pre class="cs-pre">
<span class="cs-line cmt"># Why loops help: mask-to-mask attention</span>
<span class="cs-line cmt"># Each loop pass, masked queries attend to masked keys</span>
<span class="cs-line cmt"># → information flows among all unresolved positions</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Sudoku experiment (left-to-right generation):</span>
<span class="cs-line cmt"># Baseline MDM (no loops): 10.9% solve rate</span>
<span class="cs-line cmt"># LoopMDM at S=1:           10.6% (same as baseline)</span>
<span class="cs-line cmt"># LoopMDM at S=2:           ~50%  (7 errors in demo)</span>
<span class="cs-line cmt"># LoopMDM at S=3:           ~100% (0 errors in demo)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Adaptive early-stop rule:</span>
<span class="cs-line kw">def</span> <span class="fn">adaptive_loop</span><span class="cs-line">(model, H_0, S_max, eps=0.1):</span>
<span class="cs-line">    H = H_0</span>
<span class="cs-line">    <span class="kw">for</span> k <span class="kw">in</span> <span class="fn">range</span>(S_max):</span>
<span class="cs-line">        H_prev = H</span>
<span class="cs-line hl-p">        H = model.mid(H)</span>
<span class="cs-line hl-a">        delta = norm(H - H_prev) / norm(H)</span>
<span class="cs-line hl-g">        <span class="kw">if</span> delta &lt; eps: <span class="kw">break</span>  <span class="cmt"># hidden states stable</span></span>
<span class="cs-line">    <span class="kw">return</span> H</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Result: avg loops drops 12 → 5.1</span>
<span class="cs-line cmt"># Zero-shot PPL:  52.9  vs 51.7 (matched)</span>
<span class="cs-line cmt"># Gen. PPL:       39.11 vs 38.53 (matched)</span>
<span class="cs-line cmt"># Downstream acc: 41.3  vs 41.4  (matched)</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-selective">
      <pre class="cs-pre">
<span class="cs-line cmt"># Ablation: NLL by loop position (Table 4a)</span>
<span class="cs-line cmt"># MDM baseline NLL = 3.798 (dashed line)</span>
<span class="cs-line cmt"># Lower = better</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Position (0-indexed from input)</span>
<span class="cs-line">position_nll = &#123;</span>
<span class="cs-line">    0:  3.744,  <span class="cmt"># good, near input</span></span>
<span class="cs-line hl-g">    1:  3.729,  <span class="cmt"># BEST — early-middle</span></span>
<span class="cs-line hl-g">    2:  3.729,  <span class="cmt"># BEST — early-middle</span></span>
<span class="cs-line">    3:  3.733,</span>
<span class="cs-line">    4:  3.734,</span>
<span class="cs-line">    5:  3.734,</span>
<span class="cs-line">    6:  3.735,</span>
<span class="cs-line">    7:  3.739,</span>
<span class="cs-line">    8:  3.747,</span>
<span class="cs-line hl-a">    9:  3.756,  <span class="cmt"># degrading near output</span></span>
<span class="cs-line hl-a">   10:  3.777,  <span class="cmt"># degrading near output</span></span>
<span class="cs-line">&#125;</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Ablation: NLL by # looped layers (nm)</span>
<span class="cs-line cmt"># Best: nm=2; nm>6 underperforms baseline!</span>
<span class="cs-line">nm_nll = &#123;1:3.743, 2:3.729, 3:3.734,</span>
<span class="cs-line">          4:3.793, 5:3.794, 6:3.784,</span>
<span class="cs-line">          7:3.857, 8:3.825, 9:3.842&#125;</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Ablation: NLL by max loop count Smax</span>
<span class="cs-line cmt"># Best: Smax=12; too small or too large hurts</span>
<span class="cs-line">smax_nll = &#123;4:3.741, 8:3.733, 12:3.729,</span>
<span class="cs-line">            16:3.740, 20:3.763, 24:3.800&#125;</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-results">
      <pre class="cs-pre">

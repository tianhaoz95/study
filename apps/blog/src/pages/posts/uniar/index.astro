<span class="cs-line hl-a">        sem_tokens = <span class="cls">self</span>.understand_enc.<span class="fn">encode</span>(pixels)</span>
<span class="cs-line">        <span class="cmt"># Now can answer questions about image</span></span>
<span class="cs-line">        <span class="kw">return</span> <span class="cls">self</span>.<span class="fn">answer</span>(sem_tokens, question)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># UniAR: one tokenizer, no re-encoding</span>
<span class="cs-line hl-g"><span class="kw">class</span> <span class="cls">UniAR</span>:</span>
<span class="cs-line hl-g">    <span class="attr">tokenizer</span> = <span class="fn">BSQTokenizer</span>(bits=<span class="num">64</span>)</span>
<span class="cs-line hl-g">    <span class="cmt"># Same tokens for understand AND generate</span></span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">generate_then_understand</span>(<span class="cls">self</span>, prompt):</span>
<span class="cs-line">        bsq_tokens = <span class="cls">self</span>.<span class="fn">generate</span>(prompt)</span>
<span class="cs-line hl-g">        <span class="cmt"># ✓ Same tokens — no re-encoding needed</span></span>
<span class="cs-line hl-g">        <span class="kw">return</span> <span class="cls">self</span>.<span class="fn">answer</span>(bsq_tokens, question)</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-bsq">
      <pre class="cs-pre">
<span class="cs-line cmt"># Binary Spherical Quantization (BSQ)</span>
<span class="cs-line cmt"># No explicit codebook — just bit vectors</span>
<span class="cs-line"> </span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">bsq_quantize</span>(v, d_bsq=<span class="num">64</span>):</span>
<span class="cs-line">    <span class="str">"""Map float feature to 64-bit binary."""</span></span>
<span class="cs-line hl-c">    <span class="cmt"># Project to BSQ space</span></span>
<span class="cs-line hl-c">    z = <span class="fn">mlp_in</span>(v)        <span class="cmt"># shape: [d_bsq]</span></span>
<span class="cs-line hl-c">    z = <span class="fn">normalize</span>(z)     <span class="cmt"># onto hypersphere</span></span>
<span class="cs-line hl-p">    <span class="cmt"># Threshold each dimension → {0,1}</span></span>
<span class="cs-line hl-p">    u = (z &gt; <span class="num">0</span>).<span class="fn">int</span>()  <span class="cmt"># binary vector u∈{0,1}^64</span></span>
<span class="cs-line">    <span class="cmt"># Vocabulary: 2^64 ≈ 18 quintillion codes</span></span>
<span class="cs-line">    <span class="cmt"># Zero codebook memory — just bit patterns</span></span>
<span class="cs-line">    <span class="kw">return</span> u</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Soft entropy loss (uniform bit usage)</span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">bsq_loss</span>(u):</span>
<span class="cs-line">    p = u.<span class="fn">mean</span>(dim=<span class="num">0</span>)   <span class="cmt"># bit-usage prob</span></span>
<span class="cs-line hl-a">    <span class="cmt"># Entropy: each bit → 50/50 → max vocab</span></span>
<span class="cs-line hl-a">    H = -(p*<span class="fn">log</span>(p) + (<span class="num">1</span>-p)*<span class="fn">log</span>(<span class="num">1</span>-p))</span>
<span class="cs-line hl-a">    <span class="kw">return</span> -H.<span class="fn">mean</span>()  <span class="cmt"># maximize entropy</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Vocabulary scaling vs traditional VQ:</span>
<span class="cs-line cmt">#   VQ codebook 8192 = 8K entries, ~100MB</span>
<span class="cs-line cmt">#   BSQ d=64 → 2^64 ≈ 18 × 10^18 entries</span>
<span class="cs-line cmt">#   Memory: d×float32 per entry  (tiny)</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-multilevel">
      <pre class="cs-pre">
<span class="cs-line cmt"># Multi-level feature fusion (DeepStack)</span>
<span class="cs-line cmt"># Fuse 4 ViT layers → shallow + deep</span>
<span class="cs-line"> </span>
<span class="cs-line"><span class="kw">class</span> <span class="cls">BSQTokenizer</span>:</span>
<span class="cs-line hl-c">    <span class="cmt"># Tap 4 intermediate ViT layers</span></span>
<span class="cs-line hl-c">    layer_indices = [<span class="num">8</span>, <span class="num">16</span>, <span class="num">24</span>, <span class="num">32</span>]</span>
<span class="cs-line hl-c">    <span class="cmt"># shallow=8 → textures/pixels</span></span>
<span class="cs-line hl-c">    <span class="cmt"># deep=32  → semantics/categories</span></span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">encode</span>(<span class="cls">self</span>, image):</span>
<span class="cs-line">        features = []</span>
<span class="cs-line hl-p">        <span class="kw">for</span> l <span class="kw">in</span> <span class="cls">self</span>.layer_indices:</span>
<span class="cs-line hl-p">            v_l = vit.<span class="fn">get_layer</span>(image, l)</span>
<span class="cs-line hl-p">            u_l = <span class="fn">bsq_quantize</span>(v_l)</span>
<span class="cs-line hl-p">            features.<span class="fn">append</span>(u_l)</span>
<span class="cs-line">        <span class="cmt"># 4 × 64-bit vectors per patch</span></span>
<span class="cs-line">        <span class="kw">return</span> features  <span class="cmt"># list of 4 uint64 vectors</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Training: LMM cross-entropy (not MSE)</span>
<span class="cs-line"><span class="attr">L_total</span> = <span class="attr">L_CE</span> + λ_bsq * <span class="attr">L_BSQ</span></span>
<span class="cs-line"><span class="cmt"># L_CE:  LLM next-token prediction loss</span></span>
<span class="cs-line"><span class="cmt"># L_BSQ: soft entropy (bit uniformity)</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Key insight: training for understanding</span>
<span class="cs-line cmt"># makes the tokens work for generation too.</span>
<span class="cs-line cmt"># Dual fidelity emerges from shared learning.</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-parallel">
      <pre class="cs-pre">
<span class="cs-line cmt"># Parallel bitwise prediction head</span>
<span class="cs-line cmt"># Predicts 2×2 spatial × 4 levels simultaneously</span>
<span class="cs-line"> </span>
<span class="cs-line"><span class="attr">n_level</span>   = <span class="num">4</span>    <span class="cmt"># DeepStack ViT levels</span></span>
<span class="cs-line"><span class="attr">n_spatial</span> = <span class="num">4</span>    <span class="cmt"># 2×2 spatial merger</span></span>
<span class="cs-line"><span class="attr">d_bsq</span>     = <span class="num">64</span>   <span class="cmt"># bits per BSQ token</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Group size: how many tokens per AR step</span>
<span class="cs-line hl-c"><span class="attr">g</span> = n_level * n_spatial  <span class="cmt"># = 16</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Output dimension of visual head</span>
<span class="cs-line hl-p"><span class="attr">d_vis</span> = <span class="num">2</span> * d_bsq * g   <span class="cmt"># = 2048</span></span>
<span class="cs-line hl-p"><span class="cmt"># 2×: binary cross-entropy over each bit</span></span>
<span class="cs-line"> </span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">visual_head</span>(h):  <span class="cmt"># h: LLM hidden state</span></span>
<span class="cs-line">    h_norm = <span class="fn">RMSNorm</span>(h)</span>
<span class="cs-line">    logits  = W_vis @ h_norm  <span class="cmt"># [d_LLM → 2048]</span></span>
<span class="cs-line">    <span class="kw">return</span> logits.<span class="fn">view</span>(g, d_bsq, <span class="num">2</span>)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># 512×512 → 256 AR steps (32× compression)</span>
<span class="cs-line"><span class="attr">patches</span>     = <span class="num">32</span>*<span class="num">32</span>            <span class="cmt"># = 1024</span></span>
<span class="cs-line hl-g"><span class="attr">merged_pos</span>  = patches // n_spatial  <span class="cmt"># = 256</span></span>
<span class="cs-line hl-g"><span class="cmt"># 1 AR step per merged_pos → 256 total steps</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Random bit flip (train-time augmentation)</span>
<span class="cs-line hl-a"><span class="kw">def</span> <span class="fn">flip_augment</span>(u, p_flip=<span class="num">0.1</span>):</span>
<span class="cs-line hl-a">    mask = rand() &lt; p_flip</span>
<span class="cs-line hl-a">    <span class="kw">return</span> u ^ mask    <span class="cmt"># XOR-flip bits</span></span>
<span class="cs-line cmt"># Simulates inference error accumulation</span>
<span class="cs-line cmt"># → stable generation at temperature 1.0</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-shared">
      <pre class="cs-pre">
<span class="cs-line cmt"># Inference: interleaved generate + understand</span>
<span class="cs-line cmt"># No re-encoding — same token space</span>
<span class="cs-line"> </span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">generate_and_understand</span>(prompt, question):</span>
<span class="cs-line">    <span class="cmt"># 1. Encode prompt as text tokens</span></span>
<span class="cs-line">    ctx = tokenizer.<span class="fn">encode</span>(prompt)</span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="cmt"># 2. AR generate visual BSQ tokens</span></span>
<span class="cs-line">    ctx += [<span class="str">"&lt;image_gen&gt;"</span>, H, W, <span class="str">"&lt;vision_start&gt;"</span>]</span>
<span class="cs-line hl-p">    <span class="kw">for</span> step <span class="kw">in</span> <span class="fn">range</span>(<span class="num">256</span>):       <span class="cmt"># 512×512</span></span>
<span class="cs-line hl-p">        bsq_group = model.<span class="fn">next_token</span>(ctx)</span>
<span class="cs-line hl-p">        ctx += bsq_group            <span class="cmt"># append to context</span></span>
<span class="cs-line">    ctx += [<span class="str">"&lt;vision_end&gt;"</span>]</span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="cmt"># 3. DiT decoder: tokens → pixels (for display)</span></span>
<span class="cs-line">    image = dit_decoder.<span class="fn">decode</span>(ctx.visual_tokens)</span>
<span class="cs-line"> </span>
<span class="cs-line hl-g">    <span class="cmt"># 4. Append question — same context, no re-encode</span></span>
<span class="cs-line hl-g">    ctx += tokenizer.<span class="fn">encode</span>(question)</span>
<span class="cs-line hl-g">    answer = model.<span class="fn">generate_text</span>(ctx)</span>
<span class="cs-line hl-g">    <span class="kw">return</span> image, answer</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Example (from paper, Figure 5):</span>
<span class="cs-line cmt"># prompt:   "a beautiful vase on a table,</span>
<span class="cs-line cmt">#            pictures hanging on the wall"</span>
<span class="cs-line cmt"># question: "How many pictures on the wall?"</span>
<span class="cs-line cmt"># answer:   "Two"  ← from generated BSQ tokens</span>
<span class="cs-line cmt"># No re-encoding of rendered pixels needed!</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-results">

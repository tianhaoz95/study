<script>
/* ─── TOC + sidebar toggles ─── */
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});

const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

/* ─── Code sidebar tab switching ─── */
const tabMeta = {
  intro:      { file: 'uniar/tokenizer.py',   title: 'The Two-Tokenizer Trap' },
  bsq:        { file: 'uniar/bsq.py',          title: 'BSQ Quantization' },
  multilevel: { file: 'uniar/multilevel.py',   title: 'Multi-Level Features' },
  parallel:   { file: 'uniar/parallel.py',     title: 'Parallel Bitwise Prediction' },
  shared:     { file: 'uniar/inference.py',    title: 'Shared Context' },
  results:    { file: 'uniar/results.py',      title: 'Results' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

/* ─── IntersectionObserver: TOC + tab sync ─── */
const sectionMap = {
  's-intro':      'intro',
  's-bsq':        'bsq',
  's-multilevel': 'multilevel',
  's-parallel':   'parallel',
  's-shared':     'shared',
  's-results':    'results',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

/* ─── BSQ vocabulary canvas ─── */
(function() {
  const canvas = document.getElementById('bsq-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  let W, H;

  function resize() {
    W = canvas.clientWidth;
    H = canvas.clientHeight;
    canvas.width = W * DPR;
    canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
  }
  resize();

  const DIMS = [4, 8, 16, 32, 64];
  const LABELS = ['16', '256', '65 536', '4.3 billion', '2⁶⁴ = 18 quintillion'];
  const COLORS = ['#06b6d4','#10b981','#f59e0b','#8b5cf6','#8b5cf6'];
  let activeDim = 64;

  function draw(dim) {
    ctx.clearRect(0, 0, W, H);

    const pad = { l: 60, r: 20, t: 20, b: 50 };
    const cw = W - pad.l - pad.r;
    const ch = H - pad.t - pad.b;

    // Axes
    ctx.strokeStyle = 'rgba(255,255,255,0.08)';
    ctx.lineWidth = 1;
    for (let i = 0; i <= 4; i++) {
      const y = pad.t + ch - (i / 4) * ch;
      ctx.beginPath(); ctx.moveTo(pad.l, y); ctx.lineTo(pad.l + cw, y); ctx.stroke();
    }

    // Y axis label
    ctx.fillStyle = '#6b7280';
    ctx.font = `${10 / DPR}px var(--ff-mono, monospace)`;
    ctx.textAlign = 'right';
    ctx.fillText('log₂(codes)', pad.l - 6, pad.t + 6);

    // X axis labels
    ctx.textAlign = 'center';
    DIMS.forEach((d, i) => {
      const x = pad.l + (i + 0.5) * (cw / DIMS.length);
      const y = pad.t + ch + 18;
      ctx.fillStyle = d === dim ? '#f0f0f8' : '#6b7280';
      ctx.font = `${d === dim ? 700 : 400}px var(--ff-mono)`;
      ctx.font = `${d === dim ? 'bold' : 'normal'} ${11}px var(--ff-mono, monospace)`;
      ctx.fillText('d=' + d, x, y);
    });

    // Bars
    DIMS.forEach((d, i) => {
      const barW = cw / DIMS.length * 0.55;
      const x = pad.l + (i + 0.5) * (cw / DIMS.length) - barW / 2;
      const pct = d / 64;
      const barH = ch * pct;
      const y = pad.t + ch - barH;

      const isActive = d === dim;
      ctx.fillStyle = isActive ? COLORS[i] : 'rgba(139,92,246,0.2)';
      const r = 4;
      ctx.beginPath();
      ctx.moveTo(x + r, y);
      ctx.lineTo(x + barW - r, y);
      ctx.quadraticCurveTo(x + barW, y, x + barW, y + r);
      ctx.lineTo(x + barW, y + barH);
      ctx.lineTo(x, y + barH);
      ctx.lineTo(x, y + r);
      ctx.quadraticCurveTo(x, y, x + r, y);
      ctx.closePath();
      ctx.fill();

      // Label inside/above bar
      if (isActive) {
        ctx.fillStyle = '#f0f0f8';
        ctx.font = 'bold 11px var(--ff-mono, monospace)';
        ctx.textAlign = 'center';
        ctx.fillText(LABELS[i], x + barW / 2, y - 8);
      }
    });

    // Y axis ticks
    ctx.fillStyle = '#6b7280';
    ctx.textAlign = 'right';
    ctx.font = '10px var(--ff-mono, monospace)';
    for (let i = 0; i <= 4; i++) {
      const val = i * 16;
      const y = pad.t + ch - (i / 4) * ch;
      ctx.fillText(val, pad.l - 6, y + 4);
    }
  }

  function updateInfo(dim) {
    const info = document.getElementById('bsq-info');
    if (!info) return;
    const idx = DIMS.indexOf(dim);
    const codes = dim <= 16 ? Math.pow(2, dim).toLocaleString() : dim <= 32 ? '~4.3 billion' : '~18.4 × 10¹⁸';
    const mem = dim === 64 ? 'none (no codebook)' : `${Math.pow(2, dim) * 4 / 1024 / 1024} MB codebook`;
    info.innerHTML = `<span style="color:var(--purple-l)">d=${dim}</span> bits → <span style="color:var(--cyan)">${codes}</span> unique codes · memory overhead: <span style="color:var(--green)">${mem}</span>`;
  }

  draw(activeDim);
  updateInfo(activeDim);

  document.querySelectorAll('[data-bsq]').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('[data-bsq]').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeDim = parseInt(btn.dataset.bsq);
      draw(activeDim);
      updateInfo(activeDim);
    });
  });
})();

/* ─── Multi-level feature canvas ─── */
(function() {
  const canvas = document.getElementById('level-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  let W, H;

  function resize() {
    W = canvas.clientWidth;
    H = canvas.clientHeight;
    canvas.width = W * DPR;
    canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
  }
  resize();

  // Seeded PRNG
  function seededRand(n) { return ((1664525 * n + 1013904223) & 0x7fffffff) / 0x7fffffff; }

  // Precompute some patch data
  const GRID = 8;
  const patches = [];
  for (let r = 0; r < GRID; r++) {
    for (let c = 0; c < GRID; c++) {
      const idx = r * GRID + c;
      // "true" color for this patch
      const isText = r >= 2 && r <= 5 && c >= 1 && c <= 6;
      const isBackground = !isText;
      patches.push({ r, c, isText, isBackground,
        trueR: isText ? 230 : Math.floor(seededRand(idx * 3) * 30 + 20),
        trueG: isText ? 220 : Math.floor(seededRand(idx * 3 + 1) * 30 + 20),
        trueB: isText ? 210 : Math.floor(seededRand(idx * 3 + 2) * 30 + 20),
      });
    }
  }

  // Text letter positions (simulate "HELLO" letters in 4 columns)
  const letterMap = {};
  const letters = ['H','E','L','L','O'];
  const lCols = [1, 2, 3, 4, 5];
  lCols.forEach((c, li) => {
    for (let r = 2; r <= 5; r++) letterMap[`${r},${c}`] = letters[li];
  });

  function drawPanel(ctx, x, y, pw, ph, mode) {
    // Background
    ctx.fillStyle = '#1a1a2e';
    ctx.fillRect(x, y, pw, ph);

    const patchW = pw / GRID;
    const patchH = (ph - 36) / GRID;

    patches.forEach(p => {
      const px = x + p.c * patchW;
      const py = y + 20 + p.r * patchH;

      let r, g, b, alpha;
      if (mode === 'shallow') {
        // Shallow: preserves pixel colors but no semantic segmentation
        r = p.trueR + Math.floor(seededRand(p.r * 100 + p.c) * 20 - 10);
        g = p.trueG + Math.floor(seededRand(p.r * 100 + p.c + 1) * 20 - 10);
        b = p.trueB + Math.floor(seededRand(p.r * 100 + p.c + 2) * 20 - 10);
        // Slight noise on text clarity
        if (p.isText) { r += 10; g += 10; b += 10; }
        alpha = 0.9;
      } else if (mode === 'deep') {
        // Deep: good semantic segmentation (bright text region) but no fine detail
        if (p.isText) {
          r = 180 + Math.floor(seededRand(p.r * 200 + p.c) * 60);
          g = 170; b = 160;
        } else {
          r = 25; g = 22; b = 35;
        }
        alpha = 0.9;
      } else {
        // Multi: best of both
        r = p.trueR + (p.isText ? 40 : 0);
        g = p.trueG + (p.isText ? 30 : 0);
        b = p.trueB + (p.isText ? 20 : 0);
        alpha = 0.95;
      }
      r = Math.min(255, Math.max(0, r));
      g = Math.min(255, Math.max(0, g));
      b = Math.min(255, Math.max(0, b));

      ctx.fillStyle = `rgba(${r},${g},${b},${alpha})`;
      ctx.fillRect(px + 0.5, py + 0.5, patchW - 1, patchH - 1);

      // Render letter if text patch
      const key = `${p.r},${p.c}`;
      if (letterMap[key]) {
        ctx.fillStyle = mode === 'deep' ? 'rgba(255,255,255,0.3)' : 'rgba(255,255,255,0.9)';
        ctx.font = `bold ${Math.floor(patchH * 0.6)}px monospace`;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(letterMap[key], px + patchW / 2, py + patchH / 2);
      }
    });

    // Panel label
    const labels = { shallow: 'Shallow only', deep: 'Deep only', multi: 'Multi-level' };
    const colors = { shallow: '#06b6d4', deep: '#f59e0b', multi: '#10b981' };
    ctx.fillStyle = colors[mode];
    ctx.font = 'bold 11px var(--ff-mono, monospace)';
    ctx.textAlign = 'center';
    ctx.fillText(labels[mode], x + pw / 2, y + 12);
  }

  let activeLevel = 'multi';

  function draw(level) {
    ctx.clearRect(0, 0, W, H);
    const pad = 8;
    const nCols = W > 480 ? 3 : 1;
    const modes = nCols === 3 ? ['shallow', 'deep', 'multi'] : [level];
    const pw = (W - pad * (nCols + 1)) / nCols;
    const ph = H - pad * 2;

    modes.forEach((m, i) => {
      const x = pad + i * (pw + pad);
      const y = pad;
      // Highlight active
      if (nCols === 3 && m === level) {
        ctx.strokeStyle = m === 'multi' ? '#10b981' : m === 'shallow' ? '#06b6d4' : '#f59e0b';
        ctx.lineWidth = 2;
        ctx.strokeRect(x - 1, y - 1, pw + 2, ph + 2);
      }
      drawPanel(ctx, x, y, pw, ph, m);
    });

    const desc = document.getElementById('level-desc');
    if (desc) {
      const msgs = {
        shallow: '🔵 Shallow ViT layers → fine pixel detail preserved, semantic grouping weak',
        deep:    '🟡 Deep ViT layers → semantic categories correct, fine detail lost',
        multi:   '🟢 Multi-level fusion → textures AND semantics · UniAR learns this from understanding loss alone',
      };
      desc.textContent = msgs[level];
    }
  }

  draw(activeLevel);

  document.querySelectorAll('[data-level]').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('[data-level]').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeLevel = btn.dataset.level;
      draw(activeLevel);
    });
  });
})();

/* ─── Parallel prediction step navigator ─── */
(function() {
  let step = 0;
  const boxes   = document.querySelectorAll('.step-box');
  const prevBtn = document.getElementById('par-prev');
  const nextBtn = document.getElementById('par-next');
  const progEl  = document.getElementById('par-prog');

  function updateSteps() {
    boxes.forEach((b, i) => {
      b.classList.remove('active', 'done');
      if (i === step) b.classList.add('active');
      else if (i < step) b.classList.add('done');
    });
    if (prevBtn) prevBtn.disabled = step === 0;
    if (nextBtn) nextBtn.disabled = step === boxes.length - 1;
    if (progEl) progEl.textContent = `Step ${step + 1} of ${boxes.length}`;
    boxes.forEach((b, i) => {
      const n = b.querySelector('.step-num');
      if (n) n.textContent = i < step ? '✓' : String(i + 1);
    });
  }

  prevBtn?.addEventListener('click', () => { if (step > 0) { step--; updateSteps(); } });
  nextBtn?.addEventListener('click', () => { if (step < boxes.length - 1) { step++; updateSteps(); } });
  updateSteps();
})();

/* ─── Shared context animation canvas ─── */
(function() {
  const canvas = document.getElementById('shared-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  let W, H;

  function resize() {
    W = canvas.clientWidth;
    H = canvas.clientHeight;
    canvas.width  = W * DPR;
    canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
  }
  resize();

  function seededRand(n) { return ((1664525 * n + 1013904223) & 0x7fffffff) / 0x7fffffff; }

  // 6×6 mini-image patch grid (simulate generated vase image)
  const GRID = 6;
  const COLORS_VASE = ['#8b5cf6','#7c3aed','#6d28d9','#5b21b6','#4c1d95','#3b0764'];
  const COLORS_BG   = ['#1e1b4b','#1e1b4b','#1a1a2e','#1a1a2e','#0f172a','#0f172a'];
  const patches = Array.from({ length: GRID * GRID }, (_, i) => {
    const r = Math.floor(i / GRID), c = i % GRID;
    const isVase = r >= 1 && r <= 4 && c >= 1 && c <= 4;
    return { r, c, isVase,
      col: isVase ? COLORS_VASE[Math.floor(seededRand(i) * COLORS_VASE.length)] : COLORS_BG[Math.floor(seededRand(i + 100) * COLORS_BG.length)] };
  });

  let animT = 0;
  let rafId = null;
  let phase = 0;  // 0: prompt, 1: generating tokens, 2: image, 3: question, 4: answer

  const STAGES = [
    { phase: 0, label: 'Text prompt', color: '#06b6d4', t: [0, 0.15] },
    { phase: 1, label: 'Generating 256 BSQ groups…', color: '#8b5cf6', t: [0.15, 0.55] },
    { phase: 2, label: 'Tokens → image (DiT decoder)', color: '#10b981', t: [0.55, 0.7] },
    { phase: 3, label: 'Question in same context', color: '#f59e0b', t: [0.7, 0.85] },
    { phase: 4, label: 'Answer: "Two" ← from BSQ tokens', color: '#10b981', t: [0.85, 1.0] },
  ];

  function getStage(t) {
    for (const s of STAGES) {
      if (t >= s.t[0] && t <= s.t[1]) return { ...s, pct: (t - s.t[0]) / (s.t[1] - s.t[0]) };
    }
    return { ...STAGES[STAGES.length - 1], pct: 1 };
  }

  function draw(t) {
    ctx.clearRect(0, 0, W, H);
    const stage = getStage(t);

    // Left: context window
    const ctxW = Math.min(W * 0.45, 240);
    const ctxH = H - 40;
    const ctxX = 20;
    const ctxY = 20;

    ctx.fillStyle = 'rgba(26,26,46,0.8)';
    ctx.strokeStyle = '#374151';
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.rect(ctxX, ctxY, ctxW, ctxH); ctx.fill(); ctx.stroke();

    ctx.fillStyle = '#6b7280';
    ctx.font = '10px var(--ff-mono, monospace)';
    ctx.textAlign = 'center';
    ctx.fillText('context window', ctxX + ctxW / 2, ctxY + 14);

    // Prompt tokens
    ctx.fillStyle = '#06b6d4';
    ctx.font = '9px var(--ff-mono, monospace)';
    ctx.textAlign = 'left';
    const promptText = '"a beautiful vase on a table,';
    ctx.fillText(promptText, ctxX + 10, ctxY + 32);
    ctx.fillText('pictures hanging on the wall"', ctxX + 10, ctxY + 44);

    // BSQ token stream (gradually appearing)
    if (t >= STAGES[1].t[0]) {
      const tokensVisible = Math.floor(stage.phase >= 2 ? 256 : stage.pct * 256);
      const tCols = Math.floor(ctxW / 12) - 1;
      const maxRows = 5;
      for (let i = 0; i < Math.min(tokensVisible, tCols * maxRows); i++) {
        const tr = Math.floor(i / tCols);
        const tc = i % tCols;
        const tx = ctxX + 10 + tc * 12;
        const ty = ctxY + 60 + tr * 14;
        ctx.fillStyle = `rgba(139,92,246,${seededRand(i) * 0.4 + 0.5})`;
        ctx.fillRect(tx, ty, 9, 9);
      }
      ctx.fillStyle = '#8b5cf6';
      ctx.font = '8px var(--ff-mono, monospace)';
      ctx.fillText(`${Math.min(tokensVisible, 256)}/256 BSQ groups`, ctxX + 10, ctxY + 140);
    }

    // Question + answer (later stages)
    if (t >= STAGES[3].t[0]) {
      ctx.fillStyle = '#f59e0b';
      ctx.font = '9px var(--ff-mono, monospace)';
      ctx.fillText('"How many pictures?"', ctxX + 10, ctxY + 160);
    }
    if (t >= STAGES[4].t[0]) {
      ctx.fillStyle = '#10b981';
      ctx.font = 'bold 10px var(--ff-mono, monospace)';
      ctx.fillText('"Two"', ctxX + 10, ctxY + 176);
      ctx.fillStyle = '#6b7280';
      ctx.font = '8px var(--ff-mono, monospace)';
      ctx.fillText('← reads BSQ tokens directly', ctxX + 10, ctxY + 188);
      ctx.fillText('   no re-encoding', ctxX + 10, ctxY + 198);
    }

    // Middle: tiny image (shows up after generation)
    const imgX = ctxX + ctxW + 20;
    const imgSize = Math.min(W * 0.22, 120);
    const imgY = (H - imgSize) / 2;

    if (t >= STAGES[2].t[0]) {
      const alpha = Math.min(1, (t - STAGES[2].t[0]) / 0.1);
      ctx.globalAlpha = alpha;
      const pw = imgSize / GRID;
      patches.forEach(p => {
        ctx.fillStyle = p.col;
        ctx.fillRect(imgX + p.c * pw, imgY + p.r * pw, pw - 1, pw - 1);
      });
      ctx.globalAlpha = 1;
      ctx.fillStyle = '#6b7280';
      ctx.font = '9px var(--ff-mono, monospace)';
      ctx.textAlign = 'center';
      ctx.fillText('rendered', imgX + imgSize / 2, imgY + imgSize + 14);
      ctx.fillText('(display only)', imgX + imgSize / 2, imgY + imgSize + 24);
    }

    // Right: "no re-encode" marker
    if (t >= STAGES[4].t[0]) {
      const rx = imgX + imgSize + 20;
      ctx.fillStyle = '#10b981';
      ctx.font = 'bold 12px var(--ff-mono, monospace)';
      ctx.textAlign = 'left';
      ctx.fillText('✓ shared', rx, H / 2 - 10);
      ctx.fillText('  context', rx, H / 2 + 6);
      ctx.fillStyle = '#6b7280';
      ctx.font = '9px var(--ff-mono, monospace)';
      ctx.fillText('no re-encode', rx, H / 2 + 22);
    }

    // Stage label at bottom
    ctx.fillStyle = stage.color;
    ctx.font = 'bold 11px var(--ff-mono, monospace)';
    ctx.textAlign = 'center';
    ctx.fillText(stage.label, W / 2, H - 8);
  }

  function animate() {
    animT += 0.004;
    if (animT > 1.05) { animT = 1.0; cancelAnimationFrame(rafId); rafId = null; }
    draw(Math.min(animT, 1));
    if (animT <= 1.0) rafId = requestAnimationFrame(animate);
  }

  draw(0);
  setTimeout(() => { animate(); }, 400);

  const replayBtn = document.getElementById('shared-replay');
  replayBtn?.addEventListener('click', () => {
    if (rafId) cancelAnimationFrame(rafId);
    animT = 0;
    rafId = requestAnimationFrame(animate);
  });
})();

/* ─── Animated bar charts ─── */
function triggerBars(sectionId) {
  const section = document.getElementById(sectionId);
  if (!section) return;
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        section.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          b.style.width = b.dataset.w + '%';
        });
      }
    });
  }, { threshold: 0.25 }).observe(section);
}
triggerBars('s-results');
</script>

</BaseLayout>

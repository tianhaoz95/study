  <text x="300" y="61" text-anchor="middle" fill="#9ca3af" font-size="10" font-weight="600">Token Embeddings</text>
  <line x1="300" y1="70" x2="300" y2="86" stroke="#374151" stroke-width="1.5" marker-end="url(#arr)"/>


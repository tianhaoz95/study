    <div class="cs-panel active" id="panel-kvcache">
      <pre class="cs-pre">
<span class="cs-line cmt"># KV Cache Memory Formula</span>
<span class="cs-line cmt"># For a transformer with grouped-query attention</span>
<span class="cs-line"></span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">kv_cache_bytes</span>(</span>
<span class="cs-line hl-p">    seq_len, n_layers,</span>
<span class="cs-line hl-p">    n_kv_heads, head_dim,</span>
<span class="cs-line hl-p">    dtype_bytes=2     <span class="cmt"># fp16</span></span>
<span class="cs-line hl-p">):</span>
<span class="cs-line">    <span class="cmt"># 2 = one K tensor + one V tensor</span></span>
<span class="cs-line">    <span class="kw">return</span> (<span class="num">2</span> * seq_len * n_layers</span>
<span class="cs-line">            * n_kv_heads * head_dim</span>
<span class="cs-line">            * dtype_bytes)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Llama 3.2 3B: 28 layers, 8 KV heads, d=128</span>
<span class="cs-line"><span class="kw">for</span> L <span class="kw">in</span> [<span class="num">4096</span>, <span class="num">8192</span>, <span class="num">16384</span>, <span class="num">32768</span>]:</span>
<span class="cs-line">    b = <span class="fn">kv_cache_bytes</span>(L, <span class="num">28</span>, <span class="num">8</span>, <span class="num">128</span>)</span>
<span class="cs-line">    <span class="fn">print</span>(<span class="fn">f</span><span class="str">"L=&#123;L&#125;: &#123;b/<span class="num">1e9</span>:.2f&#125; GB"</span>)</span>
<span class="cs-line cmt"># L=4096:  0.46 GB</span>
<span class="cs-line cmt"># L=8192:  0.93 GB</span>
<span class="cs-line cmt"># L=16384: 1.86 GB</span>
<span class="cs-line cmt"># L=32768: 3.62 GB  ← impossible on mobile</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># LFM recurrent state: fixed O(d_state) bytes</span>
<span class="cs-line cmt"># independent of sequence length L</span>
<span class="cs-line hl-g">LFM_STATE_BYTES = d_model * n_layers * dtype_bytes</span>
<span class="cs-line hl-g"><span class="cmt"># e.g. LFM-3B: 2048 × 30 × 2 = ~120 KB</span></span>
<span class="cs-line hl-g"><span class="cmt"># same at L=1 or L=32768</span></span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-origins">
      <pre class="cs-pre">
<span class="cs-line cmt"># Liquid Time-Constant (LTC) ODE  [2020]</span>
<span class="cs-line cmt"># arXiv:2006.04439  — Hasani et al.</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Continuous-time hidden state dynamics:</span>
<span class="cs-line cmt">#   dh/dt = -[1/τ + f(h,I)]·h + g(h,I)·I</span>
<span class="cs-line cmt">#</span>
<span class="cs-line cmt"># τ = effective time-constant — NOT fixed!</span>
<span class="cs-line cmt"># It depends on both hidden state h and input I.</span>
<span class="cs-line cmt"># → fast inputs: τ shrinks, state adapts quickly</span>
<span class="cs-line cmt"># → slow inputs: τ grows, state persists longer</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Problem: requires ODE solver per step</span>
<span class="cs-line cmt"># (runge-kutta or euler) → slow, not scalable</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># ─────────────────────────────────────────</span>
<span class="cs-line cmt"># CfC (Closed-Form Continuous-time)  [2022]</span>
<span class="cs-line cmt"># Nature MI 4, 992–1003  — Hasani et al.</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Derived closed form of the LTC integral:</span>
<span class="cs-line hl-p">x(t) = σ(f(x,I)) · exp(-t·g(x,I))</span>
<span class="cs-line hl-p">       + σ(h(x,I))</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># f, g, h are small MLPs (learned)</span>
<span class="cs-line cmt"># t is the elapsed time — explicit input!</span>
<span class="cs-line cmt"># No ODE solver needed: single forward pass</span>
<span class="cs-line hl-g"><span class="cmt"># Speed: up to 10⁵× faster than ODE-based LTC</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Intuition: σ(f)·exp(-tg) is a state that</span>
<span class="cs-line cmt"># decays at a learned rate g(x,I), clamped by</span>
<span class="cs-line cmt"># the learned offset σ(h) — exactly the LTC</span>
<span class="cs-line cmt"># long-run equilibrium, solved analytically.</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-designspace">
      <pre class="cs-pre">
<span class="cs-line cmt"># LFM Design Space  [LFM1 Technical Report, 2024]</span>
<span class="cs-line cmt"># All operators expressible as:</span>
<span class="cs-line hl-p"><span class="cmt">#   y = A(x) · x</span></span>
<span class="cs-line hl-p"><span class="cmt">#   where A(x) is input-dependent (adaptive)</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Attention: A(x) = softmax(QKᵀ/√d)</span>
<span class="cs-line cmt"># SSM (Mamba): A(x) = diag(exp(Δ·A̅))</span>
<span class="cs-line cmt"># CfC: A(x) = diag(exp(-t·g(x,I)))</span>
<span class="cs-line cmt"># Gated conv: A = depthwise Conv_k, gated</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Three design dimensions:</span>
<span class="cs-line"></span>
<span class="cs-line hl-c"><span class="cmt"># 1. Token-mixing structure</span></span>
<span class="cs-line"><span class="cmt">#    Global (attention):   O(n²) — exact</span></span>
<span class="cs-line"><span class="cmt">#    Recurrent (SSM/CfC):  O(n)  — compressed</span></span>
<span class="cs-line"><span class="cmt">#    Local (conv):         O(n·k) — windowed</span></span>
<span class="cs-line"></span>
<span class="cs-line hl-c"><span class="cmt"># 2. Channel-mixing structure</span></span>
<span class="cs-line"><span class="cmt">#    SwiGLU: σ(Wx) ⊙ Vx  (most common)</span></span>
<span class="cs-line"><span class="cmt">#    MoE: sparse expert routing</span></span>
<span class="cs-line"></span>
<span class="cs-line hl-c"><span class="cmt"># 3. Featurization (input-driven modulation)</span></span>
<span class="cs-line"><span class="cmt">#    Language: heavy (high semantic variance)</span></span>
<span class="cs-line"><span class="cmt">#    Audio: light (regular temporal structure)</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Plus: depth groups (weight sharing across</span>
<span class="cs-line cmt"># layers) + featurizer interconnections</span>
<span class="cs-line cmt"># (shared features across the stack)</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-lfm2arch">
      <pre class="cs-pre">
<span class="cs-line cmt"># LFM2 Gated Short Convolution Block</span>
<span class="cs-line cmt"># Input: h ∈ ℝ^(L×d)  (seq_len × hidden_dim)</span>
<span class="cs-line"></span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">gated_short_conv</span>(h, W_in, W_out, conv_k):</span>
<span class="cs-line">    <span class="cmt"># Expand + split into 3 channels</span></span>
<span class="cs-line">    B, C, h_tilde = <span class="fn">linear</span>(h, W_in).split(d, dim=-<span class="num">1</span>)</span>
<span class="cs-line">    <span class="cmt">#   B, C: input-dependent gates  ∈ ℝ^(L×d)</span></span>
<span class="cs-line">    <span class="cmt">#   h_tilde: projected input     ∈ ℝ^(L×d)</span></span>
<span class="cs-line"></span>
<span class="cs-line hl-c">    y = B * h_tilde         <span class="cmt"># gate 1: scale</span></span>
<span class="cs-line hl-c">    z = <span class="fn">depthwise_conv1d</span>(y, k=conv_k)  <span class="cmt"># k=3</span></span>
<span class="cs-line hl-c">    o = <span class="fn">linear</span>(C * z, W_out)  <span class="cmt"># gate 2: output</span></span>
<span class="cs-line">    <span class="kw">return</span> o</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Key properties:</span>
<span class="cs-line cmt">#  - No KV cache needed (only k=3 tokens local)</span>
<span class="cs-line cmt">#  - Depthwise conv: no cross-channel mixing</span>
<span class="cs-line cmt">#  - Two multiplicative gates: B (input-scale)</span>
<span class="cs-line cmt">#    and C (output-scale) — both input-driven</span>
<span class="cs-line cmt">#  - Excellent cache behavior on CPUs</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># LFM2-2.6B backbone layout:</span>
<span class="cs-line"><span class="cmt">#   30 layers total</span></span>
<span class="cs-line"><span class="cmt">#     22 × GatedShortConv + SwiGLU</span></span>
<span class="cs-line hl-a"><span class="cmt">#      8 × GQA + SwiGLU   (global context)</span></span>
<span class="cs-line"><span class="cmt">#   all pre-RMSNorm, RoPE on attention heads</span></span>
<span class="cs-line"><span class="cmt">#   QK-Norm on attention for stability</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Hardware search outcome:</span>
<span class="cs-line hl-g"><span class="cmt"># SSM and linear-attention operators do NOT</span></span>
<span class="cs-line hl-g"><span class="cmt"># improve quality vs pure gated-conv + sparse</span></span>
<span class="cs-line hl-g"><span class="cmt"># GQA when measured on real edge hardware</span></span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-context">
      <pre class="cs-pre">
<span class="cs-line cmt"># RULER Benchmark — Effective Context</span>
<span class="cs-line cmt"># Threshold: score &gt;= 85.6 = "effectively used"</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Tasks (multi-key retrieval, variable tracking,</span>
<span class="cs-line cmt"># multi-hop QA, aggregation, etc.)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># LFM-3B (32k claimed)</span>
<span class="cs-line hl-g">RULER_LFM3B = &#123;</span>
<span class="cs-line hl-g">    <span class="str">"4k"</span>:  <span class="num">94.4</span>,  <span class="cmt"># ✓</span></span>

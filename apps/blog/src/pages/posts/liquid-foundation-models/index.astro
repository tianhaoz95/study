  <rect x="80" y="86" width="200" height="88" rx="7" fill="rgba(6,182,212,.1)" stroke="rgba(6,182,212,.4)" stroke-width="1.5"/>
  <text x="180" y="104" text-anchor="middle" fill="#06b6d4" font-size="10" font-weight="700">Gated Short Conv Block</text>


</div><!-- /post-grid -->

<script>
// ── TOC + sidebar toggles ─────────────────────────────────
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});
const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ── Code sidebar tab switching ────────────────────────────
const tabMeta = {
  kvcache:    { file: 'lfm/kvcache.py',    title: 'KV Cache Problem' },
  origins:    { file: 'lfm/ltc_cfc.py',    title: 'LTC → CfC Origins' },
  designspace:{ file: 'lfm/design_space.py',title: 'LFM Design Space' },
  lfm2arch:   { file: 'lfm/lfm2_arch.py',  title: 'LFM2 Architecture' },
  context:    { file: 'lfm/ruler.py',       title: 'Effective Context' },
  results:    { file: 'lfm/results.py',     title: 'Benchmark Results' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ── IntersectionObserver — TOC + sidebar sync ─────────────
const sectionMap = {
  's-kvcache':    'kvcache',
  's-origins':    'origins',
  's-designspace':'designspace',
  's-lfm2arch':   'lfm2arch',
  's-context':    'context',
  's-results':    'results',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ── §01: KV Cache canvas ──────────────────────────────────
const kvCanvas = document.getElementById('kv-canvas');
const ctxSlider = document.getElementById('ctx-slider');
const ctxLabel  = document.getElementById('ctx-len-label');

if (kvCanvas) {
  const kctx = kvCanvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;

  function setupKvCanvas() {
    const W = kvCanvas.clientWidth;
    const H = 240;
    kvCanvas.width  = W * DPR;
    kvCanvas.height = H * DPR;
    kctx.scale(DPR, DPR);
    return { W, H };
  }

  // KV bytes for Llama 3.2 3B at sequence length L
  // 2 * L * n_layers * n_kv * head_dim * 2 (fp16)
  function kvBytes(L) { return 2 * L * 28 * 8 * 128 * 2; }
  // LFM-3B fixed state (30 layers, d=2048, fp16)
  const LFM_STATE = 2048 * 30 * 2;

  function drawKvChart(markerL) {
    const { W, H } = setupKvCanvas();
    const PAD_L = 58, PAD_R = 20, PAD_T = 22, PAD_B = 36;
    const CW = W - PAD_L - PAD_R;
    const CH = H - PAD_T - PAD_B;

    const MAX_L = 128 * 1024;
    const MAX_BYTES = kvBytes(MAX_L);

    // Grid
    kctx.fillStyle = '#0d0d14';
    kctx.fillRect(0, 0, W, H);
    kctx.strokeStyle = 'rgba(255,255,255,0.04)';
    kctx.lineWidth = 1;
    [0.25, 0.5, 0.75, 1].forEach(f => {
      const y = PAD_T + CH * (1 - f);
      kctx.beginPath(); kctx.moveTo(PAD_L, y); kctx.lineTo(PAD_L + CW, y); kctx.stroke();
      const gb = (MAX_BYTES * f / 1e9).toFixed(1);
      kctx.fillStyle = '#4b5563'; kctx.font = `${9 * DPR / DPR}px monospace`; kctx.textAlign = 'right';
      kctx.fillText(gb + ' GB', PAD_L - 5, y + 3);
    });

    // X axis labels
    [4096, 16384, 32768, 65536, 131072].forEach(l => {
      const x = PAD_L + (l / MAX_L) * CW;
      kctx.fillStyle = '#4b5563'; kctx.textAlign = 'center'; kctx.font = `9px monospace`;
      kctx.fillText(l >= 1024 ? (l / 1024) + 'k' : l, x, H - PAD_B + 14);
      kctx.strokeStyle = 'rgba(255,255,255,0.03)';
      kctx.beginPath(); kctx.moveTo(x, PAD_T); kctx.lineTo(x, PAD_T + CH); kctx.stroke();
    });
    kctx.fillStyle = '#4b5563'; kctx.textAlign = 'center'; kctx.font = '9px monospace';
    kctx.fillText('context length (tokens)', PAD_L + CW / 2, H - 4);

    // Draw threshold line at 1.5 GB (mobile RAM limit for KV cache)
    const THRESH_GB = 1.5;
    const threshY = PAD_T + CH * (1 - (THRESH_GB * 1e9 / MAX_BYTES));
    kctx.strokeStyle = 'rgba(245,158,11,.35)';
    kctx.setLineDash([5, 4]);
    kctx.lineWidth = 1.2;
    kctx.beginPath(); kctx.moveTo(PAD_L, threshY); kctx.lineTo(PAD_L + CW, threshY); kctx.stroke();
    kctx.setLineDash([]);
    kctx.fillStyle = 'rgba(245,158,11,.7)'; kctx.textAlign = 'right'; kctx.font = '9px monospace';
    kctx.fillText('mobile RAM limit ~1.5 GB', PAD_L + CW - 4, threshY - 4);

    // Transformer line (red)
    kctx.strokeStyle = '#e06c75';
    kctx.lineWidth = 2;
    kctx.beginPath();
    let started = false;
    for (let i = 0; i <= 200; i++) {
      const l = (i / 200) * MAX_L;
      const x = PAD_L + (l / MAX_L) * CW;
      const y = PAD_T + CH * (1 - Math.min(kvBytes(l) / MAX_BYTES, 1));
      if (!started) { kctx.moveTo(x, y); started = true; } else kctx.lineTo(x, y);
    }
    kctx.stroke();

    // LFM line (green) — flat at near zero
    const lfmY = PAD_T + CH * (1 - Math.min(LFM_STATE / MAX_BYTES, 0.012));
    kctx.strokeStyle = '#10b981';
    kctx.lineWidth = 2;
    kctx.beginPath();
    kctx.moveTo(PAD_L, lfmY);
    kctx.lineTo(PAD_L + CW, lfmY);
    kctx.stroke();

    // LFM label
    kctx.fillStyle = '#10b981'; kctx.textAlign = 'left'; kctx.font = '9px monospace';
    kctx.fillText('LFM (constant state ~120 KB)', PAD_L + 4, lfmY - 5);

    // Marker line for current slider position
    if (markerL > 0) {
      const mx = PAD_L + (markerL / MAX_L) * CW;
      kctx.strokeStyle = 'rgba(255,255,255,.18)';
      kctx.lineWidth = 1;
      kctx.setLineDash([3, 3]);
      kctx.beginPath(); kctx.moveTo(mx, PAD_T); kctx.lineTo(mx, PAD_T + CH); kctx.stroke();
      kctx.setLineDash([]);

      // Annotation bubble for Transformer
      const kvB = kvBytes(markerL);
      const dotY = PAD_T + CH * (1 - Math.min(kvB / MAX_BYTES, 1));
      kctx.fillStyle = '#e06c75';
      kctx.beginPath(); kctx.arc(mx, dotY, 5, 0, Math.PI * 2); kctx.fill();
      const label = (kvB / 1e9).toFixed(2) + ' GB';
      const boxX = mx + 8 > PAD_L + CW - 80 ? mx - 75 : mx + 8;
      kctx.fillStyle = 'rgba(224,108,117,.2)';
      kctx.strokeStyle = 'rgba(224,108,117,.6)';
      kctx.lineWidth = 1;
      const bw = 72, bh = 16;
      const bx = boxX, by = dotY - 8;
      kctx.beginPath(); kctx.roundRect(bx, by, bw, bh, 3); kctx.fill(); kctx.stroke();
      kctx.fillStyle = '#e06c75'; kctx.font = 'bold 9px monospace'; kctx.textAlign = 'left';
      kctx.fillText('Transformer: ' + label, bx + 4, by + 11);

      // LFM dot
      kctx.fillStyle = '#10b981';
      kctx.beginPath(); kctx.arc(mx, lfmY, 5, 0, Math.PI * 2); kctx.fill();
    }

    // Y axis label
    kctx.save();
    kctx.translate(11, PAD_T + CH / 2);
    kctx.rotate(-Math.PI / 2);
    kctx.fillStyle = '#4b5563'; kctx.font = '9px monospace'; kctx.textAlign = 'center';
    kctx.fillText('memory (GB)', 0, 0);
    kctx.restore();
  }

  function getMarkerL() {
    // slider: 1–128 maps to 1k–128k tokens
    const v = parseInt(ctxSlider.value);
    return v * 1024;
  }

  function updateKv() {
    const L = getMarkerL();
    ctxLabel.textContent = L.toLocaleString();
    drawKvChart(L);
  }

  ctxSlider.addEventListener('input', updateKv);
  window.addEventListener('resize', updateKv);
  updateKv();
}

// ── §02: Step navigator ───────────────────────────────────
let evoStep = 0;
const evoBoxes = document.querySelectorAll('#evo-steps .step-box');
const evoPrev  = document.getElementById('evo-prev');
const evoNext  = document.getElementById('evo-next');
const evoProg  = document.getElementById('evo-prog');
function updateEvo() {
  evoBoxes.forEach((b, i) => {
    b.classList.remove('active', 'done');
    if (i === evoStep) b.classList.add('active');
    else if (i < evoStep) b.classList.add('done');
  });
  evoPrev.disabled = evoStep === 0;
  evoNext.disabled = evoStep === evoBoxes.length - 1;
  evoProg.textContent = `Step ${evoStep + 1} of ${evoBoxes.length}`;
  evoBoxes.forEach((b, i) => {
    const n = b.querySelector('.step-num');
    if (n) n.textContent = i < evoStep ? '✓' : String(i + 1);
  });
}
evoPrev?.addEventListener('click', () => { if (evoStep > 0) { evoStep--; updateEvo(); } });
evoNext?.addEventListener('click', () => { if (evoStep < evoBoxes.length - 1) { evoStep++; updateEvo(); } });
updateEvo();

// ── §05: RULER chart ──────────────────────────────────────
const rulerCanvas = document.getElementById('ruler-canvas');
if (rulerCanvas) {
  const rctx = rulerCanvas.getContext('2d');
  const DPR  = window.devicePixelRatio || 1;

  const MODELS = {
    lfm:   { label: 'LFM-3B',       color: '#8b5cf6', pts: [[4096,94.4],[8192,93.5],[16384,91.8],[32768,89.5]] },
    llama: { label: 'Llama 3.2 3B', color: '#e06c75', pts: [[4096,92.0],[8192,87.1],[16384,81.2],[32768,74.1]] },
    gemma: { label: 'Gemma 2 2B',   color: '#f59e0b', pts: [[4096,75.0],[8192,0.6]] },
    phi:   { label: 'Phi-3.5 3.8B', color: '#06b6d4', pts: [[4096,93.0],[8192,91.5],[16384,89.2],[32768,87.0]] },
  };

  let visibleModels = new Set(['lfm']);

  function drawRuler() {
    const W = rulerCanvas.clientWidth;
    const H = 260;
    rulerCanvas.width  = W * DPR;
    rulerCanvas.height = H * DPR;
    rctx.scale(DPR, DPR);

    const PAD_L = 42, PAD_R = 20, PAD_T = 18, PAD_B = 40;
    const CW = W - PAD_L - PAD_R;
    const CH = H - PAD_T - PAD_B;

    rctx.fillStyle = '#0d0d14';
    rctx.fillRect(0, 0, W, H);

    const X_TICKS = [4096, 8192, 16384, 32768];
    const X_MIN = 4096, X_MAX = 32768;
    const Y_MIN = 0, Y_MAX = 100;

    function xp(l) { return PAD_L + ((l - X_MIN) / (X_MAX - X_MIN)) * CW; }
    function yp(s) { return PAD_T + CH * (1 - (s - Y_MIN) / (Y_MAX - Y_MIN)); }

    // Grid
    rctx.strokeStyle = 'rgba(255,255,255,0.04)'; rctx.lineWidth = 1;
    [0, 25, 50, 75, 85.6, 100].forEach(s => {
      const y = yp(s);
      rctx.beginPath(); rctx.moveTo(PAD_L, y); rctx.lineTo(PAD_L + CW, y); rctx.stroke();
      rctx.fillStyle = '#4b5563'; rctx.font = '9px monospace'; rctx.textAlign = 'right';
      rctx.fillText(s, PAD_L - 4, y + 3);
    });

    // Threshold line at 85.6
    rctx.strokeStyle = 'rgba(245,158,11,.5)';
    rctx.setLineDash([5, 4]); rctx.lineWidth = 1.5;
    rctx.beginPath(); rctx.moveTo(PAD_L, yp(85.6)); rctx.lineTo(PAD_L + CW, yp(85.6)); rctx.stroke();
    rctx.setLineDash([]);
    rctx.fillStyle = 'rgba(245,158,11,.8)'; rctx.textAlign = 'right'; rctx.font = '9px monospace';
    rctx.fillText('85.6 threshold', PAD_L + CW - 4, yp(85.6) - 4);

    X_TICKS.forEach(l => {
      const x = xp(l);
      rctx.fillStyle = '#4b5563'; rctx.textAlign = 'center'; rctx.font = '9px monospace';
      rctx.fillText((l / 1024) + 'k', x, H - PAD_B + 14);
      rctx.strokeStyle = 'rgba(255,255,255,0.03)'; rctx.lineWidth = 1;
      rctx.beginPath(); rctx.moveTo(x, PAD_T); rctx.lineTo(x, PAD_T + CH); rctx.stroke();
    });
    rctx.fillStyle = '#4b5563'; rctx.textAlign = 'center'; rctx.font = '9px monospace';
    rctx.fillText('context length', PAD_L + CW / 2, H - PAD_B + 28);

    // Y axis label
    rctx.save(); rctx.translate(11, PAD_T + CH / 2); rctx.rotate(-Math.PI / 2);
    rctx.fillStyle = '#4b5563'; rctx.font = '9px monospace'; rctx.textAlign = 'center';
    rctx.fillText('RULER score', 0, 0); rctx.restore();

    // Draw each visible model
    const allModels = visibleModels.has('all')
      ? Object.keys(MODELS)
      : [...visibleModels].filter(k => k !== 'all');

    let legendY = PAD_T + 4;
    allModels.forEach(key => {
      const m = MODELS[key]; if (!m) return;
      rctx.strokeStyle = m.color; rctx.lineWidth = 2.5;
      rctx.beginPath();
      m.pts.forEach(([l, s], i) => {
        const x = xp(l), y = yp(s);
        if (i === 0) rctx.moveTo(x, y); else rctx.lineTo(x, y);
      });
      rctx.stroke();
      m.pts.forEach(([l, s]) => {
        rctx.fillStyle = m.color;
        rctx.beginPath(); rctx.arc(xp(l), yp(s), 4, 0, Math.PI * 2); rctx.fill();
      });
      // Legend
      rctx.fillStyle = m.color; rctx.beginPath();
      rctx.rect(PAD_L + 4, legendY, 12, 3); rctx.fill();
      rctx.fillStyle = m.color; rctx.font = '9px monospace'; rctx.textAlign = 'left';
      rctx.fillText(m.label, PAD_L + 20, legendY + 4);
      legendY += 14;
    });
  }

  document.querySelectorAll('#ruler-btns .viz-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const model = btn.dataset.model;
      if (model === 'all') {
        visibleModels.clear();
        visibleModels.add('all');
        document.querySelectorAll('#ruler-btns .viz-btn').forEach(b => {
          b.classList.toggle('active', b.dataset.model === 'all');
        });
      } else {
        visibleModels.delete('all');
        if (visibleModels.has(model)) {
          if (visibleModels.size > 1) visibleModels.delete(model);
        } else {
          visibleModels.add(model);
        }
        document.querySelectorAll('#ruler-btns .viz-btn').forEach(b => {
          if (b.dataset.model === 'all') b.classList.remove('active');
          else b.classList.toggle('active', visibleModels.has(b.dataset.model));
        });
      }
      drawRuler();
    });
  });

  window.addEventListener('resize', drawRuler);
  drawRuler();
}

// ── §06: Animated bar chart ───────────────────────────────
const speedSection = document.getElementById('s-results');
if (speedSection) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('#speed-bars .bar-fill[data-w]').forEach(b => {
          b.style.width = parseFloat(b.dataset.w) + '%';
        });
      }
    });
  }, { threshold: 0.3 }).observe(speedSection);
}
</script>
</BaseLayout>

.viz-btn{padding:.3rem .75rem;border-radius:5px;font-size:.71rem;font-family:var(--ff-mono);cursor:pointer;border:1px solid var(--border-hi);background:var(--surface);color:var(--muted2);transition:all .15s}
.viz-btn:hover{border-color:var(--purple);color:var(--purple-l);background:var(--purple-dim)}
.viz-btn.active{border-color:var(--purple);color:var(--purple-l);background:var(--purple-dim)}

/* ── Arch SVG wrappers ── */

   §02 — Denoising animation
   ───────────────────────────────────────────── */
const ANSWER_TOKENS = ['She','earns','$25','per','hour','.','8','hours','×','$25','=','$200','.'];
const TOTAL_STEPS   = 7;
let dnStep = TOTAL_STEPS; // T = fully masked
let dnTimer = null;

function seededRand(n) {
  return ((1664525 * n + 1013904223) & 0x7fffffff) / 0x7fffffff;
}

// Pre-compute reveal order (by confidence proxy = seeded random)
const revealOrder = ANSWER_TOKENS.map((_, i) => ({ i, conf: seededRand(i * 7 + 3) }))
  .sort((a, b) => b.conf - a.conf)
  .map(x => x.i);

function buildDnGrid(step) {
  // step = T means all masked; step = 0 means all revealed
  // tokens per step revealed: Math.floor(ANSWER_TOKENS.length / TOTAL_STEPS)
  const tokensPerStep = Math.ceil(ANSWER_TOKENS.length / TOTAL_STEPS);
  const numRevealed = (TOTAL_STEPS - step) * tokensPerStep;
  const revealed = new Set(revealOrder.slice(0, numRevealed));
  const grid = document.getElementById('dn-grid');
  if (!grid) return;
  grid.innerHTML = '';
  ANSWER_TOKENS.forEach((tok, i) => {
    const el = document.createElement('span');
    el.className = 'dtok ' + (revealed.has(i) ? 'revealed' : 'masked');
    el.textContent = revealed.has(i) ? tok : '▓▓▓';
    grid.appendChild(el);
  });
  const stepEl = document.getElementById('dn-step');
  if (stepEl) stepEl.textContent = step === TOTAL_STEPS ? 'T (all masked)' : step === 0 ? '0 (complete)' : `T-${TOTAL_STEPS - step}`;
}
buildDnGrid(dnStep);

document.getElementById('dn-play')?.addEventListener('click', function() {
  if (dnTimer) return;
  if (dnStep === 0) { dnStep = TOTAL_STEPS; buildDnGrid(dnStep); }
  dnTimer = setInterval(() => {
    if (dnStep > 0) { dnStep--; buildDnGrid(dnStep); }
    else { clearInterval(dnTimer); dnTimer = null; }
  }, 600);
});
document.getElementById('dn-reset')?.addEventListener('click', function() {
  clearInterval(dnTimer); dnTimer = null;
  dnStep = TOTAL_STEPS; buildDnGrid(dnStep);
});

/* ─────────────────────────────────────────────
   §03 — Self-future teacher viz
   ───────────────────────────────────────────── */
const Q_TOKENS    = ['Q:','24+37=?'];
const ANS_TOKENS  = ['The','total','is','24','+','37','=','61','dollars','.'];
// indices of "future" tokens by seeded order
const futureOrder = ANS_TOKENS.map((_, i) => ({ i, r: seededRand(i * 5 + 11) }))
  .sort((a, b) => b.r - a.r).map(x => x.i);

const rhoData = {
  '0.10': { acc: 85.6, label: 'ρ=0.10', nFuture: 1 },
  '0.25': { acc: 93.4, label: 'ρ=0.25', nFuture: 3 },
  '0.50': { acc: 94.8, label: 'ρ=0.50', nFuture: 5 },
};
// simulate: 2 tokens already revealed by student at step t
const revealedByStudent = new Set([2, 6]); // indices in ANS_TOKENS

function renderSFTokens(containerId, isTeacher, rho) {
  const el = document.getElementById(containerId);
  if (!el) return;
  el.innerHTML = '';
  const futureRevealed = new Set(futureOrder.slice(0, rhoData[rho].nFuture));

  Q_TOKENS.forEach(t => {
    const s = document.createElement('span');
    s.className = 'sf-tok q'; s.textContent = t; el.appendChild(s);
  });
  ANS_TOKENS.forEach((t, i) => {
    const s = document.createElement('span');
    if (revealedByStudent.has(i)) {
      s.className = 'sf-tok active'; s.textContent = t;
    } else if (isTeacher && futureRevealed.has(i)) {
      s.className = 'sf-tok future'; s.textContent = '★' + t;
    } else {
      s.className = 'sf-tok mask'; s.textContent = '▓▓';
    }
    el.appendChild(s);
  });
}

function updateRho(rho) {
  document.querySelectorAll('.rho-btn').forEach(b =>
    b.classList.toggle('active', b.dataset.rho === rho));
  renderSFTokens('sf-student', false, rho);
  renderSFTokens('sf-teacher', true, rho);
  const d = rhoData[rho];
  const ta = document.getElementById('ta-teacher');
  const taVal = document.getElementById('ta-teacher-val');
  const taLabel = document.getElementById('ta-label-teacher');
  if (ta) { ta.style.width = d.acc + '%'; if (taVal) taVal.textContent = d.acc + '%'; }
  if (taLabel) taLabel.textContent = 'Teacher (' + d.label + '):';
}
updateRho('0.10');
document.querySelectorAll('.rho-btn').forEach(b =>
  b.addEventListener('click', () => updateRho(b.dataset.rho)));

/* ─────────────────────────────────────────────
   §04 — Step navigator
   ───────────────────────────────────────────── */
let stepIdx = 0;
const stepBoxes = document.querySelectorAll('.step-box');
const stepPrev  = document.getElementById('step-prev');
const stepNext  = document.getElementById('step-next');
const stepProg  = document.getElementById('step-prog');
function updateSteps() {
  stepBoxes.forEach((b, i) => {
    b.classList.remove('active','done');
    if (i === stepIdx) b.classList.add('active');
    else if (i < stepIdx) b.classList.add('done');
  });
  if (stepPrev) stepPrev.disabled = stepIdx === 0;
  if (stepNext) stepNext.disabled = stepIdx === stepBoxes.length - 1;
  if (stepProg) stepProg.textContent = 'Step ' + (stepIdx+1) + ' of ' + stepBoxes.length;
  stepBoxes.forEach((b, i) => {
    const n = b.querySelector('.step-num');
    if (n) n.textContent = i < stepIdx ? '✓' : String(i+1);
  });
}
stepPrev?.addEventListener('click', () => { if (stepIdx > 0) { stepIdx--; updateSteps(); } });
stepNext?.addEventListener('click', () => { if (stepIdx < stepBoxes.length-1) { stepIdx++; updateSteps(); } });
updateSteps();

/* ─────────────────────────────────────────────
   §05 — Overlap visualization
   ───────────────────────────────────────────── */
// Top-10 vocabulary slots for AR-style (near-identical) vs d-OPSD (distinct)
// AR: student top-10 vs teacher top-10 → 9/10 identical (overlap ~0.98)
// d-OPSD: student vs teacher → 6.5/10 overlap (~0.65)
const ovVocab = ['the','answer','is','total','equals','sum','result','value','=','num'];
const arStudentW  = [88,72,60,48,42,38,32,28,22,18];
const arTeacherW  = [85,71,62,47,44,37,33,29,21,19]; // nearly same
const dpStudentW  = [88,72,60,48,42,38,32,28,22,18];
const dpTeacherW  = [90,65,45,55,30,20,50,38,12,28]; // more distinct

function buildOverlapBars(containerId, studentW, teacherW) {
  const el = document.getElementById(containerId);
  if (!el) return;
  el.innerHTML = '';
  const maxW = Math.max(...studentW, ...teacherW);
  ovVocab.forEach((tok, i) => {
    const row = document.createElement('div');
    row.className = 'ov-bar-row';
    row.innerHTML = '<div class="ov-label">"' + tok + '"</div>' +
      '<div class="ov-track">' +
        '<div class="ov-s" style="width:' + (studentW[i]/maxW*100).toFixed(1) + '%;background:rgba(6,182,212,.5);height:100%"></div>' +
        '<div class="ov-t" style="width:' + (teacherW[i]/maxW*100).toFixed(1) + '%;background:rgba(139,92,246,.7);height:6px;top:3px"></div>' +
      '</div>';
    el.appendChild(row);
  });
  // legend
  const leg = document.createElement('div');
  leg.style.cssText = 'display:flex;gap:.875rem;margin-top:.5rem;font-size:.6rem;font-family:var(--ff-mono);color:var(--muted)';
  leg.innerHTML = '<div><span style="display:inline-block;width:10px;height:10px;background:rgba(6,182,212,.5);border-radius:2px;margin-right:.25rem"></span>student</div>' +
    '<div><span style="display:inline-block;width:10px;height:4px;background:rgba(139,92,246,.7);border-radius:2px;margin-right:.25rem;vertical-align:middle"></span>teacher</div>';
  el.appendChild(leg);
}
buildOverlapBars('overlap-ar', arStudentW, arTeacherW);
buildOverlapBars('overlap-dopsd', dpStudentW, dpTeacherW);

/* ─────────────────────────────────────────────
   §06 — Animated bars on scroll
   ───────────────────────────────────────────── */
const barsSection = document.getElementById('s-results');
if (barsSection) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          b.style.width = b.dataset.w + '%';
        });
      }
    });
  }, { threshold: 0.2 }).observe(barsSection);
}
</script>
</BaseLayout>

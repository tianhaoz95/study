<span class="cs-line cmt"># AR-style OPSD (for autoregressive LLMs)</span>
<span class="cs-line cmt"># Teacher = student conditioned on privileged prefix</span>
<span class="cs-line"></span>
<span class="cs-line hl-a"><span class="kw">def</span> <span class="fn">ar_opsd_teacher</span>(model, prompt, ref_solution):</span>
<span class="cs-line hl-a">    <span class="cmt"># Appends reference solution to prompt</span></span>
<span class="cs-line hl-a">    teacher_prompt = prompt + ref_solution</span>
<span class="cs-line hl-a">    <span class="kw">return</span> model(teacher_prompt)  <span class="cmt"># prefix-conditioned</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Problem: reference solution is external, static</span>
<span class="cs-line cmt"># → teacher ≈ student (98% overlap in top-20 vocab)</span>
<span class="cs-line cmt"># → student learns almost nothing new</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># OPSD loss for AR models (token-level KL):</span>
<span class="cs-line cmt"># L = Σᵢ DKL(pθ(·|y&lt;i,x) || pθ(·|y&lt;i,x*))</span>
<span class="cs-line cmt"># where x* = x + y* (privileged prefix)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Why this fails for dLLMs:</span>
<span class="cs-line cmt"># 1. dLLMs generate non-autoregressively</span>
<span class="cs-line cmt">#    → prefix conditioning is not the natural form</span>
<span class="cs-line cmt"># 2. token-level KL doesn't align with</span>
<span class="cs-line cmt">#    the iterative denoising process</span>
<span class="cs-line cmt"># 3. static reference = near-zero new knowledge</span>
<span class="cs-line"></span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">d_opsd_teacher</span>(model, prompt, self_answer):</span>
<span class="cs-line hl-p">    <span class="cmt"># Uses model's OWN generated answer as suffix</span></span>
<span class="cs-line hl-p">    <span class="cmt"># Teacher = suffix-conditioned p(prefix|suffix)</span></span>
<span class="cs-line hl-p">    teacher_ctx = construct_suffix(self_answer, rho)</span>
<span class="cs-line hl-p">    <span class="kw">return</span> model(prompt, suffix=teacher_ctx)</span>
</pre>
    </div>

    <!-- panel-denoising -->
    <div class="cs-panel" id="panel-denoising">
      <pre class="cs-pre">
<span class="cs-line cmt"># dLLM forward (corruption) process</span>
<span class="cs-line cmt"># y0 = clean response, yT = all-masked</span>
<span class="cs-line"></span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">forward_process</span>(y0, t, T):</span>
<span class="cs-line">    yT = []</span>
<span class="cs-line">    <span class="kw">for</span> token <span class="kw">in</span> y0:</span>
<span class="cs-line">        <span class="cmt"># mask each token with prob t/T</span></span>
<span class="cs-line hl-c">        <span class="kw">if</span> random() &lt; t / T:</span>
<span class="cs-line hl-c">            yT.append(MASK)</span>
<span class="cs-line">        <span class="kw">else</span>:</span>
<span class="cs-line">            yT.append(token)</span>
<span class="cs-line">    <span class="kw">return</span> yT</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># dLLM reverse (denoising) inference</span>
<span class="cs-line"></span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">inference</span>(model, prompt, T, k):</span>
<span class="cs-line">    yT = [MASK] * L  <span class="cmt"># start all-masked</span></span>
<span class="cs-line">    <span class="kw">for</span> t <span class="kw">in</span> range(T, <span class="num">0</span>, -<span class="num">1</span>):</span>
<span class="cs-line">        <span class="cmt"># score all positions simultaneously</span></span>
<span class="cs-line hl-p">        P = model(yT, prompt)  <span class="cmt"># full-sequence dist</span></span>
<span class="cs-line hl-p">        <span class="cmt"># reveal k most confident masked tokens</span></span>
<span class="cs-line hl-p">        top_k = most_confident(P, yT, k)</span>
<span class="cs-line hl-p">        <span class="kw">for</span> i <span class="kw">in</span> top_k:</span>
<span class="cs-line hl-p">            yT[i] = sample(P[i])</span>
<span class="cs-line">    <span class="kw">return</span> yT  <span class="cmt"># y0 — clean response</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Block diffusion (used in practice):</span>
<span class="cs-line cmt"># Response partitioned into B contiguous blocks</span>
<span class="cs-line cmt"># AR across blocks, diffusion within each block</span>
<span class="cs-line cmt"># Block length = 32 in experiments</span>
</pre>
    </div>

    <!-- panel-teacher -->
    <div class="cs-panel" id="panel-teacher">
      <pre class="cs-pre">
<span class="cs-line cmt"># d-OPSD teacher construction</span>
<span class="cs-line cmt"># y0 = student's own final generated answer</span>
<span class="cs-line cmt"># rho = retaining ratio (default 0.25)</span>
<span class="cs-line"></span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">build_teacher_input</span>(yt, y0, rho):</span>
<span class="cs-line">    <span class="cmt"># St = random rho-fraction of masked positions</span></span>
<span class="cs-line hl-p">    masked = [i <span class="kw">for</span> i, tok <span class="kw">in</span> <span class="fn">enumerate</span>(yt)</span>
<span class="cs-line hl-p">              <span class="kw">if</span> tok == MASK]</span>
<span class="cs-line hl-p">    St = random_subset(masked, rho)</span>
<span class="cs-line">    yteacher = yt.copy()</span>
<span class="cs-line hl-c">    <span class="kw">for</span> i <span class="kw">in</span> St:</span>
<span class="cs-line hl-c">        yteacher[i] = y0[i]  <span class="cmt"># peek at own future</span></span>
<span class="cs-line">    <span class="kw">return</span> yteacher</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Toy verification results (GSM8K)</span>
<span class="cs-line cmt"># student pass@1:  81.3%</span>
<span class="cs-line cmt"># student pass@8:  95.5%</span>
<span class="cs-line cmt"># teacher rho=0.10: 85.6% (already +4.3pp)</span>
<span class="cs-line cmt"># teacher rho=0.25: 93.4% (near pass@8!)</span>
<span class="cs-line cmt"># teacher rho=0.50: 94.8% (≈ pass@8)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Pass@k sampling strategy:</span>
<span class="cs-line cmt"># keep sampling until correct answer, max k=8</span>
<span class="cs-line cmt"># same compute as RLVR's group-k rollouts</span>
<span class="cs-line hl-g"><span class="kw">def</span> <span class="fn">sample_correct_trajectory</span>(model, prompt, k):</span>
<span class="cs-line hl-g">    <span class="kw">for</span> _ <span class="kw">in</span> range(k):</span>
<span class="cs-line hl-g">        Y = <span class="fn">inference</span>(model, prompt)</span>
<span class="cs-line hl-g">        <span class="kw">if</span> <span class="fn">is_correct</span>(Y.y0): <span class="kw">return</span> Y</span>
<span class="cs-line hl-g">    <span class="kw">return</span> Y  <span class="cmt"># use best if none correct</span></span>
</pre>
    </div>

    <!-- panel-divergence -->
    <div class="cs-panel" id="panel-divergence">
      <pre class="cs-pre">
<span class="cs-line cmt"># Step-level KL divergence objective</span>
<span class="cs-line cmt"># Aligns supervision with denoising mechanics</span>
<span class="cs-line"></span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">step_level_kl</span>(model, Y, prompt, rho):</span>
<span class="cs-line">    total_loss = <span class="num">0</span></span>
<span class="cs-line">    <span class="kw">for</span> t <span class="kw">in</span> range(T, <span class="num">0</span>, -<span class="num">1</span>):</span>
<span class="cs-line">        yt = Y[t]</span>
<span class="cs-line hl-c">        <span class="cmt"># build teacher input (partial self-future)</span></span>
<span class="cs-line hl-c">        yteach = <span class="fn">build_teacher_input</span>(yt, Y[<span class="num">0</span>], rho)</span>
<span class="cs-line hl-c">        P_s = model(yt, prompt)     <span class="cmt"># student dist</span></span>
<span class="cs-line hl-c">        P_t = model(yteach, prompt) <span class="cmt"># teacher dist</span></span>
<span class="cs-line hl-p">        <span class="cmt"># top-k confident positions (from teacher)</span></span>
<span class="cs-line hl-p">        Kt = <span class="fn">topk_confident</span>(P_t, yt)</span>
<span class="cs-line hl-p">        <span class="cmt"># step-level KL over Kt positions only</span></span>
<span class="cs-line hl-p">        Lt = <span class="fn">mean</span>([<span class="fn">DKL</span>(P_s[i], P_t[i]) <span class="kw">for</span> i <span class="kw">in</span> Kt])</span>
<span class="cs-line">        total_loss += Lt</span>
<span class="cs-line">    <span class="kw">return</span> total_loss / T</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Engineering: concatenate all step inputs</span>
<span class="cs-line cmt"># → single forward pass, no OOM</span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">efficient_step_kl</span>(model, Y, prompt):</span>
<span class="cs-line">    <span class="cmt"># batch: (bsz×T, seq_len) instead of T calls</span></span>
<span class="cs-line hl-g">    all_inputs = <span class="fn">concat</span>([Y[t] <span class="kw">for</span> t <span class="kw">in</span> range(T)])</span>
<span class="cs-line hl-g">    all_dists = model(all_inputs)  <span class="cmt"># one forward pass</span></span>
<span class="cs-line hl-g">    <span class="kw">return</span> <span class="fn">compute_kl</span>(all_dists)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Pointwise KL clipping (threshold=0.05)</span>
<span class="cs-line cmt"># → stabilizes training, prevents collapse</span>
<span class="cs-line cmt"># clip each per-token KL contribution</span>
</pre>
    </div>

    <!-- panel-overlap -->
    <div class="cs-panel" id="panel-overlap">
      <pre class="cs-pre">
<span class="cs-line cmt"># Overlap Top-K metric</span>
<span class="cs-line cmt"># Measures teacher-student knowledge gap</span>
<span class="cs-line"></span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">overlap_topk</span>(P_student, P_teacher, Kt, K=<span class="num">20</span>):</span>
<span class="cs-line">    overlap_sum = <span class="num">0</span></span>
<span class="cs-line">    <span class="kw">for</span> i <span class="kw">in</span> Kt:</span>
<span class="cs-line hl-c">        top_s = <span class="fn">topK_vocab</span>(P_student[i], K)</span>
<span class="cs-line hl-c">        top_t = <span class="fn">topK_vocab</span>(P_teacher[i], K)</span>
<span class="cs-line hl-p">        overlap = <span class="fn">len</span>(top_s &amp; top_t) / K</span>
<span class="cs-line hl-p">        overlap_sum += overlap</span>
<span class="cs-line">    <span class="kw">return</span> overlap_sum / <span class="fn">len</span>(Kt)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Results from paper (K=20):</span>
<span class="cs-line cmt"># AR-style OPSD:  overlap ≈ 0.98</span>
<span class="cs-line cmt">#   → teacher and student nearly identical</span>
<span class="cs-line cmt">#   → ≈2% new vocabulary in top-20</span>
<span class="cs-line cmt"># d-OPSD:         overlap ≈ 0.65</span>
<span class="cs-line cmt">#   → meaningful knowledge gap</span>
<span class="cs-line cmt">#   → ≈35% new vocabulary in top-20</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># AR-style vs d-OPSD performance (len=256):</span>
<span class="cs-line cmt"># Base:        GSM8K=76.0   MATH500=31.8</span>
<span class="cs-line cmt"># AR-style:    GSM8K=78.4   MATH500=33.4</span>
<span class="cs-line cmt">#              (+2.4pp)     (+1.6pp)</span>
<span class="cs-line hl-g"><span class="cmt"># d-OPSD:      GSM8K=81.0   MATH500=37.2</span></span>
<span class="cs-line hl-g"><span class="cmt">#              (+5.0pp)     (+5.4pp)</span></span>
<span class="cs-line cmt"># → 2× more improvement from self-future</span>
</pre>

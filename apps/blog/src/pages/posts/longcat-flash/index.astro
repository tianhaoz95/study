// ── Render a panel ──────────────────────────────────────────────────
function renderPanel(id) {
  const p = PANELS[id];
  if (!p) return '';
  const html = p.lines.map(entry => {
    const cls = (typeof entry === 'object') ? entry.c : '';
    const txt = (typeof entry === 'object') ? entry.t : entry;
    return `<span class="cs-line ${cls}">${hl(txt)}</span>`;
  }).join('');
  return `<pre class="cs-pre">${html}</pre>`;
}

function buildSidebar() {
  const body = document.getElementById('cs-body');
  if (!body) return;
  body.innerHTML = Object.keys(PANELS).map(id =>
    `<div class="cs-panel" id="panel-${id}">${renderPanel(id)}</div>`
  ).join('');
}

function activatePanel(id) {
  document.querySelectorAll('.cs-tab').forEach(t => {
    t.classList.toggle('active', t.dataset.panel === id);
  });
  document.querySelectorAll('.cs-panel').forEach(p => {
    p.classList.toggle('active', p.id === `panel-${id}`);
  });
  const p = PANELS[id];
  if (p) {
    const fileEl = document.getElementById('cs-file');
    const titleEl = document.getElementById('cs-title');
    if (fileEl) fileEl.textContent = p.file;
    if (titleEl) titleEl.textContent = p.title;
  }
  const activePanel = document.getElementById(`panel-${id}`);
  if (activePanel) {
    const firstHl = activePanel.querySelector('.hl-p,.hl-c,.hl-g,.hl-a');
    const csBody = document.getElementById('cs-body');
    if (firstHl && csBody) {
      csBody.scrollTo({ top: firstHl.offsetTop - 40, behavior: 'smooth' });
    } else if (csBody) {
      csBody.scrollTo({ top: 0, behavior: 'smooth' });
    }
  }
}

const SECTION_MAP = {
  's-problem': 'problem',
  's-zce':     'zce',
  's-scmoe':   'scmoe',
  's-scaling': 'scaling',
  's-agentic': 'agentic',
  's-results': 'results',
};

document.addEventListener('DOMContentLoaded', () => {
  buildSidebar();
  activatePanel('problem');
  const firstToc = document.getElementById('toc-s-problem');
  if (firstToc) firstToc.classList.add('toc-active');

  // ── Sidebar toggle ──────────────────────────────────────────
  const csToggle = document.getElementById('cs-toggle');
  const csSidebar = document.getElementById('code-sidebar');
  const postGrid = document.getElementById('post-grid');
  if (csToggle && csSidebar) {
    csToggle.addEventListener('click', () => {
      const collapsed = csSidebar.classList.toggle('collapsed');
      if (postGrid) postGrid.classList.toggle('sidebar-collapsed', collapsed);
      csToggle.textContent = collapsed ? '‹' : '›';
      csToggle.title = collapsed ? 'Show code panel' : 'Hide code panel';
      csToggle.setAttribute('aria-label', collapsed ? 'Show code panel' : 'Hide code panel');
    });
  }

  // ── TOC toggle ──────────────────────────────────────────────
  const tocToggle = document.getElementById('toc-toggle');
  const tocSidebar = document.getElementById('toc-sidebar');
  if (tocToggle && tocSidebar) {
    tocToggle.addEventListener('click', () => {
      const collapsed = tocSidebar.classList.toggle('collapsed');
      if (postGrid) postGrid.classList.toggle('toc-collapsed', collapsed);
      tocToggle.textContent = collapsed ? '›' : '‹';
      tocToggle.title = collapsed ? 'Show contents' : 'Hide contents';
      tocToggle.setAttribute('aria-label', collapsed ? 'Show contents' : 'Hide contents');
    });
  }

  function activateTocItem(sectionId) {
    document.querySelectorAll('.toc-item').forEach(item => {
      item.classList.toggle('toc-active', item.id === `toc-${sectionId}`);
    });
  }

  // Tab clicks
  document.querySelectorAll('.cs-tab').forEach(btn => {
    btn.addEventListener('click', () => activatePanel(btn.dataset.panel));
  });

  // IntersectionObserver — auto-update sidebar + TOC on scroll
  const sectionObserver = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const panelId = SECTION_MAP[entry.target.id];
        if (panelId) activatePanel(panelId);
        activateTocItem(entry.target.id);
      }
    });
  }, { threshold: 0.3 });
  document.querySelectorAll('section[id]').forEach(s => sectionObserver.observe(s));

  // ── Canvas routing visualization ───────────────────────────
  const canvas = document.getElementById('routing-canvas');
  if (canvas) {
    const ctx = canvas.getContext('2d');
    const W = canvas.width, H = canvas.height;
    const mid = W / 2;

    function drawRoutingViz() {
      ctx.clearRect(0, 0, W, H);

      // Background panels
      ctx.fillStyle = 'rgba(15,15,20,0.6)';
      ctx.fillRect(0, 0, W, H);

      // Divider
      ctx.strokeStyle = 'rgba(255,255,255,0.07)';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(mid, 10);
      ctx.lineTo(mid, H - 10);
      ctx.stroke();

      // Column headers
      ctx.font = '600 11px JetBrains Mono, monospace';
      ctx.textAlign = 'center';
      ctx.fillStyle = '#64748b';
      ctx.fillText('Standard MoE  (top-k = 8, fixed)', mid / 2, 22);
      ctx.fillStyle = '#8b5cf6';
      ctx.fillText('ZCE  (avg 8 FFN, dynamic)', mid + mid / 2, 22);

      // Helper: draw expert block row
      function drawExpertRow(startX, y, ffnCount, zceCount, label, tokenLabel) {
        const total = ffnCount + zceCount;
        const blockW = 18, blockH = 18, gap = 3;
        const rowW = total * (blockW + gap) - gap;
        const startBX = startX - rowW / 2;

        // Token label
        ctx.font = '600 11px JetBrains Mono, monospace';
        ctx.textAlign = 'center';
        ctx.fillStyle = '#94a3b8';
        ctx.fillText(label, startX, y - 4);

        for (let i = 0; i < total; i++) {
          const bx = startBX + i * (blockW + gap);
          const isFFN = i < ffnCount;
          ctx.fillStyle = isFFN ? 'rgba(139,92,246,0.75)' : 'rgba(71,85,105,0.45)';
          ctx.strokeStyle = isFFN ? 'rgba(167,139,250,0.6)' : 'rgba(100,116,139,0.3)';
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.roundRect(bx, y, blockW, blockH, 3);
          ctx.fill();
          ctx.stroke();
          if (!isFFN) {
            ctx.fillStyle = 'rgba(100,116,139,0.5)';
            ctx.font = '7px monospace';
            ctx.textAlign = 'center';
            ctx.fillText('∅', bx + blockW / 2, y + blockH / 2 + 3);
          }
        }

        // Count label (centered below blocks)
        ctx.font = '9px JetBrains Mono, monospace';
        ctx.textAlign = 'center';
        ctx.fillStyle = '#64748b';
        const countTxt = zceCount > 0 ? `${ffnCount} FFN + ${zceCount} id` : `${ffnCount} FFN`;
        ctx.fillText(countTxt, startX, y + blockH + 13);
      }

      // Left: Standard MoE — "the" (8 FFN fixed)
      drawExpertRow(mid / 2, 45, 8, 0, '"the"', '');
      // Left: Standard MoE — "eigenvector" (8 FFN fixed)
      drawExpertRow(mid / 2, 100, 8, 0, '"eigenvector"', '');

      // Right: ZCE — "the" (3 FFN + 9 identity)
      drawExpertRow(mid + mid / 2, 45, 3, 9, '"the"', '');
      // Right: ZCE — "eigenvector" (10 FFN + 2 identity)
      drawExpertRow(mid + mid / 2, 100, 10, 2, '"eigenvector"', '');

      // Legend
      const ly = H - 30;
      ctx.fillStyle = 'rgba(139,92,246,0.75)';
      ctx.beginPath();
      ctx.roundRect(20, ly, 14, 14, 2);
      ctx.fill();
      ctx.font = '10px JetBrains Mono, monospace';
      ctx.textAlign = 'left';
      ctx.fillStyle = '#94a3b8';
      ctx.fillText('FFN expert  (active compute)', 40, ly + 11);

      ctx.fillStyle = 'rgba(71,85,105,0.45)';
      ctx.strokeStyle = 'rgba(100,116,139,0.3)';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.roundRect(mid + 20, ly, 14, 14, 2);
      ctx.fill();
      ctx.stroke();
      ctx.fillStyle = '#64748b';
      ctx.font = '10px JetBrains Mono, monospace';
      ctx.fillText('∅  identity (ZCE — zero compute)', mid + 40, ly + 11);

      // Row labels (left annotations)
      ctx.save();
      ctx.font = 'italic 9px JetBrains Mono, monospace';
      ctx.fillStyle = '#ef4444';
      ctx.textAlign = 'center';
      ctx.fillText('same budget for easy + hard', mid / 2, 155);
      ctx.restore();

      ctx.save();
      ctx.font = 'italic 9px JetBrains Mono, monospace';
      ctx.fillStyle = '#10b981';
      ctx.textAlign = 'center';
      ctx.fillText('3× less for easy, more for hard', mid + mid / 2, 155);
      ctx.restore();
    }

    drawRoutingViz();
    // Redraw on resize
    window.addEventListener('resize', () => {
      setTimeout(drawRoutingViz, 50);
    });
  }

  // ── Token difficulty interactive viz ──────────────────────
  const tokData = [
    { ffn: 3, id: 9,  params: '~18.6B', compute: '25%', cls: 'easy (function word)' },
    { ffn: 4, id: 8,  params: '~21.4B', compute: '33%', cls: 'easy (conjunction)' },
    { ffn: 6, id: 6,  params: '~24.8B', compute: '50%', cls: 'medium (common verb)' },
    { ffn: 10, id: 2, params: '~29.7B', compute: '83%', cls: 'hard (technical term)' },
    { ffn: 11, id: 1, params: '~31.3B', compute: '92%', cls: 'hard (ML concept)' },
  ];

  const tokBtns = document.querySelectorAll('.tok-btn');
  const ebarFFN = document.getElementById('ebar-ffn');
  const ebarZCE = document.getElementById('ebar-zce');
  const ebarFFNCount = document.getElementById('ebar-ffn-count');
  const ebarZCECount = document.getElementById('ebar-zce-count');
  const tokParams = document.getElementById('tok-params');
  const tokCompute = document.getElementById('tok-compute');
  const tokClass = document.getElementById('tok-class');

  function updateTokViz(idx) {
    const d = tokData[idx];
    if (!d) return;
    const ffnPct = (d.ffn / 12) * 100;
    const zcePct = (d.id / 12) * 100;
    if (ebarFFN) ebarFFN.style.width = ffnPct + '%';
    if (ebarZCE) ebarZCE.style.width = zcePct + '%';
    if (ebarFFNCount) ebarFFNCount.textContent = `${d.ffn} / 12`;
    if (ebarZCECount) ebarZCECount.textContent = `${d.id} / 12`;
    if (tokParams) tokParams.textContent = d.params;
    if (tokCompute) tokCompute.textContent = d.compute;
    if (tokClass) tokClass.textContent = d.cls;
  }

  tokBtns.forEach((btn, i) => {
    btn.addEventListener('click', () => {
      tokBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      updateTokViz(i);
    });
  });

  // ── Step navigator ─────────────────────────────────────────
  let currentStep = 0;
  const totalSteps = 4;
  const stepPrev = document.getElementById('step-prev');
  const stepNext = document.getElementById('step-next');
  const stepProg = document.getElementById('step-prog');

  function updateSteps() {
    for (let i = 0; i < totalSteps; i++) {
      const box = document.getElementById(`step-${i}`);
      if (!box) continue;
      box.classList.remove('active', 'done');
      if (i === currentStep) box.classList.add('active');
      else if (i < currentStep) box.classList.add('done');
    }
    if (stepPrev) stepPrev.disabled = currentStep === 0;
    if (stepNext) stepNext.disabled = currentStep === totalSteps - 1;
    if (stepProg) stepProg.textContent = `${currentStep + 1} / ${totalSteps}`;
  }

  if (stepPrev) stepPrev.addEventListener('click', () => {
    if (currentStep > 0) { currentStep--; updateSteps(); }
  });
  if (stepNext) stepNext.addEventListener('click', () => {
    if (currentStep < totalSteps - 1) { currentStep++; updateSteps(); }
  });
  updateSteps();

  // ── Animated bar chart ─────────────────────────────────────
  function animateBars() {
    document.querySelectorAll('.bar-fill[data-pct]').forEach(bar => {
      const pct = parseFloat(bar.dataset.pct);
      bar.style.width = pct + '%';
    });
  }

  const resultsSection = document.getElementById('s-results');
  if (resultsSection) {
    const barObserver = new IntersectionObserver(entries => {
      if (entries[0].isIntersecting) {
        setTimeout(animateBars, 100);
        barObserver.disconnect();
      }
    }, { threshold: 0.2 });
    barObserver.observe(resultsSection);
  }
});
</script>

</BaseLayout>

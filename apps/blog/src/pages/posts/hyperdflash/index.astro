<script>
// ── Sidebar toggles ──────────────────────────────────────────────
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});
const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ── Code sidebar tab switching ───────────────────────────────────
const tabMeta = {
  cliff:   { file: 'hyperdflash/cliff.py',   title: 'Acceptance Rate Cliff' },
  block:   { file: 'hyperdflash/block.py',   title: 'Block Parallel Drafting' },
  mhc:     { file: 'hyperdflash/mhc.py',     title: 'MHC Architecture' },
  design:  { file: 'hyperdflash/design.py',  title: 'Three Innovations' },
  results: { file: 'hyperdflash/results.py', title: 'Results' },
  speed:   { file: 'hyperdflash/speed.py',   title: 'Speedup by Benchmark' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ── IntersectionObserver — TOC + tab sync ────────────────────────
const sectionMap = {
  's-cliff':   'cliff',
  's-block':   'block',
  's-mhc':     'mhc',
  's-design':  'design',
  's-results': 'results',
  's-speed':   'speed',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.25 }).observe(s)
);

// ── Step navigator (block drafting) ─────────────────────────────
let blockStep = 0;
const blockBoxes = document.querySelectorAll('#block-steps .step-box');
const blockPrev  = document.getElementById('block-prev');
const blockNext  = document.getElementById('block-next');
const blockProg  = document.getElementById('block-prog');
function updateBlockSteps() {
  blockBoxes.forEach((b, i) => {
    b.classList.remove('active', 'done');
    if (i === blockStep) b.classList.add('active');
    else if (i < blockStep) b.classList.add('done');
  });
  blockPrev.disabled = blockStep === 0;
  blockNext.disabled = blockStep === blockBoxes.length - 1;
  blockProg.textContent = 'Step ' + (blockStep + 1) + ' of ' + blockBoxes.length;
  blockBoxes.forEach((b, i) => {
    const n = b.querySelector('.step-num');
    if (n) n.textContent = i < blockStep ? '✓' : String(i + 1);
  });
}
blockPrev?.addEventListener('click', () => { if (blockStep > 0) { blockStep--; updateBlockSteps(); } });
blockNext?.addEventListener('click', () => { if (blockStep < blockBoxes.length - 1) { blockStep++; updateBlockSteps(); } });
updateBlockSteps();

// ── Cliff chart canvas ───────────────────────────────────────────
const cliffCanvas = document.getElementById('cliff-canvas');
if (cliffCanvas) {
  const ctx = cliffCanvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const W = cliffCanvas.clientWidth;
  const H = 240;
  cliffCanvas.width  = W * DPR;
  cliffCanvas.height = H * DPR;
  ctx.scale(DPR, DPR);

  // Data: per-position acceptance rates (estimated from Fig 1)
  const MTP_AR = [95, 78, 57, 38, 25, 16];
  const HDF_AR = [95, 89, 83, 77, 72, 66];
  const LABELS = ['Pos0', 'Pos1', 'Pos2', 'Pos3', 'Pos4', 'Pos5'];

  const PAD = { t: 18, r: 24, b: 40, l: 48 };
  const cW = W - PAD.l - PAD.r;
  const cH = H - PAD.t - PAD.b;

  function xOf(i) { return PAD.l + (i / (LABELS.length - 1)) * cW; }
  function yOf(v) { return PAD.t + (1 - v / 100) * cH; }

  // Grid lines
  for (let v = 0; v <= 100; v += 20) {
    ctx.beginPath();
    ctx.moveTo(PAD.l, yOf(v));
    ctx.lineTo(PAD.l + cW, yOf(v));
    ctx.strokeStyle = 'rgba(255,255,255,0.04)';
    ctx.lineWidth = 1;
    ctx.stroke();
    ctx.fillStyle = '#4b5563';
    ctx.font = '9px monospace';
    ctx.textAlign = 'right';
    ctx.fillText(v + '%', PAD.l - 6, yOf(v) + 3);
  }

  // X axis labels
  LABELS.forEach((lbl, i) => {
    ctx.fillStyle = '#4b5563';
    ctx.font = '9.5px monospace';
    ctx.textAlign = 'center';
    ctx.fillText(lbl, xOf(i), H - PAD.b + 14);
  });

  // Shade under HDF line (fill first)
  ctx.beginPath();
  HDF_AR.forEach((v, i) => {
    if (i === 0) ctx.moveTo(xOf(i), yOf(v));
    else ctx.lineTo(xOf(i), yOf(v));
  });
  ctx.lineTo(xOf(HDF_AR.length - 1), yOf(0));
  ctx.lineTo(xOf(0), yOf(0));
  ctx.closePath();
  ctx.fillStyle = 'rgba(139,92,246,0.08)';
  ctx.fill();

  // Draw MTP line
  ctx.beginPath();
  MTP_AR.forEach((v, i) => {
    if (i === 0) ctx.moveTo(xOf(i), yOf(v));
    else ctx.lineTo(xOf(i), yOf(v));
  });
  ctx.strokeStyle = '#f59e0b';
  ctx.lineWidth = 2.5;
  ctx.setLineDash([6, 3]);
  ctx.stroke();
  ctx.setLineDash([]);

  // Draw HDF line
  ctx.beginPath();
  HDF_AR.forEach((v, i) => {
    if (i === 0) ctx.moveTo(xOf(i), yOf(v));
    else ctx.lineTo(xOf(i), yOf(v));
  });
  ctx.strokeStyle = '#8b5cf6';
  ctx.lineWidth = 2.5;
  ctx.stroke();

  // Dots + value labels for MTP
  MTP_AR.forEach((v, i) => {
    ctx.beginPath();
    ctx.arc(xOf(i), yOf(v), 4.5, 0, Math.PI * 2);
    ctx.fillStyle = '#f59e0b';
    ctx.fill();
    if (i > 0) {
      ctx.fillStyle = 'rgba(245,158,11,0.8)';
      ctx.font = '9px monospace';
      ctx.textAlign = 'center';
      ctx.fillText(v + '%', xOf(i), yOf(v) - 8);
    }
  });

  // Dots + value labels for HDF
  HDF_AR.forEach((v, i) => {
    ctx.beginPath();
    ctx.arc(xOf(i), yOf(v), 4.5, 0, Math.PI * 2);
    ctx.fillStyle = '#8b5cf6';
    ctx.fill();
    ctx.fillStyle = 'rgba(139,92,246,0.9)';
    ctx.font = '9px monospace';
    ctx.textAlign = 'center';
    ctx.fillText(v + '%', xOf(i), yOf(v) - 8);
  });

  // "Cliff zone" annotation
  ctx.fillStyle = 'rgba(245,158,11,0.12)';
  ctx.fillRect(xOf(2), PAD.t, xOf(5) - xOf(2), cH);
  ctx.fillStyle = '#f59e0b';
  ctx.font = '8.5px monospace';
  ctx.textAlign = 'center';
  ctx.fillText('acceptance cliff', xOf(3.5), PAD.t + 11);
}

// ── Reducer comparison canvas ────────────────────────────────────
const redCanvas = document.getElementById('reducer-canvas');
if (redCanvas) {
  const ctx2 = redCanvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const W2 = redCanvas.clientWidth;
  const H2 = 160;
  redCanvas.width  = W2 * DPR;
  redCanvas.height = H2 * DPR;
  ctx2.scale(DPR, DPR);

  const midY = H2 / 2;
  const leftX = W2 * 0.18;
  const rightX = W2 * 0.82;

  // Left: Vanilla DFlash
  ctx2.fillStyle = 'rgba(245,158,11,0.1)';
  ctx2.strokeStyle = 'rgba(245,158,11,0.5)';
  ctx2.lineWidth = 1.5;
  const rW = W2 * 0.28, rH = 80;
  ctx2.beginPath();
  const lx = leftX - rW / 2, ly = midY - rH / 2;
  ctx2.roundRect(lx, ly, rW, rH, 6);
  ctx2.fill();
  ctx2.stroke();
  ctx2.fillStyle = '#f59e0b';
  ctx2.font = 'bold 9px monospace';
  ctx2.textAlign = 'center';
  ctx2.fillText('Vanilla DFlash', leftX, ly + 16);
  ctx2.fillStyle = '#6b7280';
  ctx2.font = '8.5px monospace';
  ctx2.fillText('Dense fc: 67M params', leftX, ly + 34);
  ctx2.fillText('Random init', leftX, ly + 50);
  ctx2.fillText('No target alignment', leftX, ly + 65);
  ctx2.fillStyle = 'rgba(245,158,11,0.8)';
  ctx2.font = 'bold 11px monospace';
  ctx2.fillText('67,000,000', leftX, ly + 82);

  // Right: HyperDFlash
  ctx2.fillStyle = 'rgba(139,92,246,0.1)';
  ctx2.strokeStyle = 'rgba(139,92,246,0.5)';
  ctx2.lineWidth = 1.5;
  const rx = rightX - rW / 2, ry = midY - rH / 2;
  ctx2.beginPath();
  ctx2.roundRect(rx, ry, rW, rH, 6);
  ctx2.fill();
  ctx2.stroke();
  ctx2.fillStyle = '#a78bfa';
  ctx2.font = 'bold 9px monospace';
  ctx2.textAlign = 'center';
  ctx2.fillText('HyperDFlash', rightX, ry + 16);
  ctx2.fillStyle = '#6b7280';
  ctx2.font = '8.5px monospace';
  ctx2.fillText('HC-Gate: 65K params', rightX, ry + 34);
  ctx2.fillText('Inherited from hc_head', rightX, ry + 50);
  ctx2.fillText('Structurally aligned', rightX, ry + 65);
  ctx2.fillStyle = 'rgba(139,92,246,0.9)';
  ctx2.font = 'bold 11px monospace';
  ctx2.fillText('65,000', rightX, ry + 82);

  // Center arrow + label
  const midX = W2 / 2;
  ctx2.fillStyle = '#4b5563';
  ctx2.font = 'bold 10px monospace';
  ctx2.textAlign = 'center';
  ctx2.fillText('vs', midX, midY - 6);
  ctx2.fillStyle = '#10b981';
  ctx2.font = '9px monospace';
  ctx2.fillText('1000x fewer', midX, midY + 8);
  ctx2.fillText('params', midX, midY + 20);
}

// ── Animated bar charts (IntersectionObserver) ────────────────────
function animateBars(sectionId) {
  const sec = document.getElementById(sectionId);
  if (!sec) return;
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        sec.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          b.style.width = b.dataset.w + '%';
        });
      }
    });
  }, { threshold: 0.3 }).observe(sec);
}
animateBars('s-results');
animateBars('s-speed');
</script>

    <button class="cs-tab" data-panel="speed">speed</button>
  </div>
  <div class="cs-body">

    <div class="cs-panel active" id="panel-cliff">
      <pre class="cs-pre">
<span class="cs-line cmt"># Speculative decoding speedup formula</span>
<span class="cs-line cmt"># S = speedup, τ = avg accepted length</span>
<span class="cs-line cmt"># γ = draft steps, c = drafter cost ratio</span>
<span class="cs-line"></span>
<span class="cs-line hl-p">S = τ / (1 + γ * c)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># MTP(6): more draft steps → more cost</span>
<span class="cs-line cmt"># but τ barely improves (cliff after Pos2)</span>
<span class="cs-line cmt"># → denominator grows faster than numerator</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Per-position acceptance rate (Fig 1)</span>
<span class="cs-line cmt"># estimated from paper Fig 1</span>
<span class="cs-line">mtp_ar = [</span>
<span class="cs-line hl-a">    95,  <span class="cmt"># Pos0 — both start equally high</span></span>
<span class="cs-line hl-a">    78,  <span class="cmt"># Pos1 — MTP starts dropping</span></span>
<span class="cs-line hl-a">    57,  <span class="cmt"># Pos2</span></span>
<span class="cs-line hl-a">    38,  <span class="cmt"># Pos3 — rapid degradation</span></span>
<span class="cs-line hl-a">    25,  <span class="cmt"># Pos4</span></span>
<span class="cs-line hl-a">    16,  <span class="cmt"># Pos5 — nearly useless</span></span>
<span class="cs-line">]</span>
<span class="cs-line">hdf_ar = [</span>
<span class="cs-line hl-g">    95,  <span class="cmt"># Pos0 — tied with MTP</span></span>
<span class="cs-line hl-g">    89,  <span class="cmt"># Pos1</span></span>
<span class="cs-line hl-g">    83,  <span class="cmt"># Pos2</span></span>
<span class="cs-line hl-g">    77,  <span class="cmt"># Pos3 — still viable</span></span>
<span class="cs-line hl-g">    72,  <span class="cmt"># Pos4</span></span>
<span class="cs-line hl-g">    66,  <span class="cmt"># Pos5 — smooth profile</span></span>
<span class="cs-line">]</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Root cause: MTP conditions each position</span>
<span class="cs-line cmt"># on unverified previous draft tokens</span>
<span class="cs-line cmt"># → errors compound exponentially</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-block">
      <pre class="cs-pre">
<span class="cs-line cmt"># DFlash block-parallel drafting</span>
<span class="cs-line cmt"># avoids the autoregressive error chain</span>
<span class="cs-line"></span>
<span class="cs-line kw">def</span> <span class="fn">block_draft_verify</span>(target, drafter, ctx, γ=6):</span>
<span class="cs-line hl-p">    <span class="cmt"># anchor: last verified position</span></span>
<span class="cs-line hl-p">    h_a = target.encode(ctx)  <span class="cmt"># verified hidden state</span></span>
<span class="cs-line"></span>
<span class="cs-line">    <span class="cmt"># block input: anchor + γ mask tokens</span></span>
<span class="cs-line">    mask_block = [MASK] * γ</span>
<span class="cs-line"></span>
<span class="cs-line hl-c">    <span class="cmt"># ONE drafter pass → all positions at once</span></span>
<span class="cs-line hl-c">    draft = drafter(h_a, mask_block)</span>
<span class="cs-line hl-c">    <span class="cmt"># no conditioning on unverified drafts</span></span>
<span class="cs-line"></span>
<span class="cs-line">    <span class="cmt"># target verifies all γ draft tokens</span></span>
<span class="cs-line hl-g">    accepted = target.verify(ctx + draft)</span>
<span class="cs-line hl-g">    τ = len(accepted)  <span class="cmt"># avg 3.69 for HyperDFlash</span></span>
<span class="cs-line"></span>
<span class="cs-line">    <span class="cmt"># advance context by τ accepted tokens</span></span>
<span class="cs-line">    ctx = ctx + accepted</span>
<span class="cs-line">    <span class="kw">return</span> ctx</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># key insight: every draft position sees</span>
<span class="cs-line cmt"># the same verified anchor context h_a</span>
<span class="cs-line cmt"># → no compounding error across positions</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-mhc">
      <pre class="cs-pre">
<span class="cs-line cmt"># MHC residual stream — DeepSeek-V4</span>
<span class="cs-line cmt"># Each token has m=4 parallel residual paths</span>
<span class="cs-line cmt"># H_t ∈ R^&#123;m × d&#125;  (m=4 paths, d=hidden dim)</span>
<span class="cs-line"></span>
<span class="cs-line kw">def</span> <span class="fn">hc_head_collapse</span>(H_t):</span>
<span class="cs-line hl-p">    <span class="cmt"># normalize the flattened multi-path state</span></span>
<span class="cs-line hl-p">    x_tilde = RMSNorm(H_t.flatten())</span>
<span class="cs-line"></span>
<span class="cs-line hl-c">    <span class="cmt"># compute per-path sigmoid gates</span></span>
<span class="cs-line hl-c">    alpha = sigmoid(W_f @ x_tilde + b)</span>
<span class="cs-line hl-c">    <span class="cmt"># alpha.shape = [m] — one scalar per path</span></span>
<span class="cs-line"></span>
<span class="cs-line hl-g">    <span class="cmt"># weighted sum of residual paths</span></span>
<span class="cs-line hl-g">    y_t = sum(alpha[j] * H_t[j] <span class="kw">for</span> j <span class="kw">in</span> range(m))</span>
<span class="cs-line hl-g">    <span class="cmt"># y_t ∈ R^d — single vector for LM head</span></span>
<span class="cs-line">    <span class="kw">return</span> y_t</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># vanilla fc reducer: wrong functional form</span>
<span class="cs-line">fc_reducer = nn.Linear(m * d, d)  <span class="cmt"># 67M params</span></span>
<span class="cs-line cmt"># → static, cannot express input-dependent gates</span>
<span class="cs-line cmt"># → 67M random params from scratch</span>
<span class="cs-line cmt"># → structurally misaligned with hc_head</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># HyperDFlash: same form as hc_head</span>
<span class="cs-line hl-p">hc_gate_reducer = InheritedHCGate(</span>
<span class="cs-line hl-p">    init_from=target.hc_head.weights,  <span class="cmt"># pretrained</span></span>
<span class="cs-line hl-p">)  <span class="cmt"># 65K params — structurally aligned</span></span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-design">
      <pre class="cs-pre">
<span class="cs-line cmt"># HyperDFlash: three-part design</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># 1. Pre-collapse residual conditioning</span>
<span class="cs-line hl-p"><span class="cmt"># use final pre-collapse MHC residual H_a</span></span>
<span class="cs-line hl-p"><span class="cmt"># not intermediate aggregated features</span></span>
<span class="cs-line hl-p">cond = target.pre_hc_head_residual(ctx)</span>
<span class="cs-line hl-p"><span class="cmt"># cond ∈ R^&#123;m × d&#125; — full path info preserved</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># 2. Inherited HC-Gate Reducer</span>
<span class="cs-line hl-c">x_tilde = RMSNorm(cond.flatten())</span>
<span class="cs-line hl-c">alpha = sigmoid(W_gate @ x_tilde + b_gate)</span>
<span class="cs-line hl-c">h_cond = sum(alpha[j] * cond[j] <span class="kw">for</span> j ...)</span>
<span class="cs-line hl-c"><span class="cmt"># W_gate initialized from target.hc_head</span></span>
<span class="cs-line hl-c"><span class="cmt"># → 65K params vs 67M (1000× reduction)</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># 3. Targeted KL distillation loss</span>
<span class="cs-line kw">def</span> <span class="fn">training_loss</span>(draft_logits, teacher_logits, labels):</span>
<span class="cs-line">    L_CE = cross_entropy(draft_logits, labels)</span>
<span class="cs-line hl-g">    <span class="cmt"># KL only at early positions (k=1,2)</span></span>
<span class="cs-line hl-g">    P = 2  <span class="cmt"># first P positions supervised</span></span>
<span class="cs-line hl-g">    T = T_KD  <span class="cmt"># distillation temperature</span></span>
<span class="cs-line hl-g">    L_KL = T**2 * mean(KL(teacher[0:P], draft[0:P]))</span>
<span class="cs-line">    alpha = 0.1  <span class="cmt"># conservative weight</span></span>
<span class="cs-line">    <span class="kw">return</span> L_CE + alpha * L_KL</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># no KL at k≥3: teacher conditions on</span>
<span class="cs-line cmt"># ground-truth tokens; drafter sees MASK</span>
<span class="cs-line cmt"># → conflicting gradients → skip it</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-results">
      <pre class="cs-pre">
<span class="cs-line cmt"># Main results — DeepSeek-V4-Flash</span>
<span class="cs-line cmt"># Non-thinking mode, temperature = 0</span>
<span class="cs-line cmt"># Averaged across 7 benchmarks</span>

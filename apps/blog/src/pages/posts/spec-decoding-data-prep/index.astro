<span class="cs-line hl-g">    <span class="kw">return</span> [<span class="fn">math.exp</span>(-(k-<span class="num">1</span>)/gamma)</span>
<span class="cs-line hl-g">            <span class="kw">for</span> k <span class="kw">in</span> <span class="fn">range</span>(<span class="num">1</span>, block_size)]</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Ablation: standard vs anchor sampling</span>
<span class="cs-line cmt"># 100K samples, 3-layer draft, block=16:</span>
<span class="cs-line cmt">  standard  tau: Math500=4.69, HumanEval=3.90</span>
<span class="cs-line cmt">  anchor    tau: Math500=5.64, HumanEval=4.61</span>
<span class="cs-line cmt">  gain:          Math500=+20%, HumanEval=+18%</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-recipe">
      <pre class="cs-pre">

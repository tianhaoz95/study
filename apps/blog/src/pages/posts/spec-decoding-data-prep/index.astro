    <div class="cs-panel" id="panel-anchor">
      <pre class="cs-pre">
<span class="cs-line cmt"># DFlash anchor sampling implementation</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">sample_anchor_blocks</span>(response_tokens,</span>
<span class="cs-line hl-p">                          block_size=<span class="num">16</span>,</span>
<span class="cs-line hl-p">                          n_anchors=<span class="num">512</span>):</span>
<span class="cs-line hl-p">    <span class="str">"""Sample random anchor positions each epoch.</span></span>
<span class="cs-line hl-p">    <span class="str">Each anchor starts a masked block of (block_size-1)</span></span>
<span class="cs-line hl-p">    <span class="str">tokens the model must predict in parallel."""</span></span>
<span class="cs-line">    T = <span class="fn">len</span>(response_tokens)</span>
<span class="cs-line cmt">    # Valid anchor positions: anywhere that leaves</span>
<span class="cs-line cmt">    # room for a full block after it</span>
<span class="cs-line">    valid = <span class="fn">range</span>(T - block_size)</span>
<span class="cs-line hl-c">    anchors = <span class="fn">random.sample</span>(valid,</span>
<span class="cs-line hl-c">                             <span class="fn">min</span>(n_anchors, <span class="fn">len</span>(valid)))</span>
<span class="cs-line">    blocks = []</span>
<span class="cs-line">    <span class="kw">for</span> a <span class="kw">in</span> anchors:</span>
<span class="cs-line">        anchor_tok = response_tokens[a]</span>
<span class="cs-line">        mask_toks  = response_tokens[a+<span class="num">1</span>:a+block_size]</span>
<span class="cs-line">        blocks.<span class="fn">append</span>((anchor_tok, mask_toks))</span>
<span class="cs-line">    <span class="kw">return</span> blocks</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Position-dependent loss weighting</span>
<span class="cs-line hl-g"><span class="kw">def</span> <span class="fn">position_weights</span>(block_size, gamma=<span class="num">7</span>):</span>
<span class="cs-line hl-g">    <span class="str">"""Emphasize early positions in each block."""</span></span>

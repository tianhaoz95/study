<span class="cs-line hl-p">    <span class="str">'loss_decay_gamma'</span>: <span class="num">7</span>,  <span class="cmt"># exp(-(k-1)/7)</span></span>
<span class="cs-line hl-p">    <span class="cmt"># Optimizer</span></span>
<span class="cs-line hl-p">    <span class="str">'epochs'</span>:    <span class="num">6</span>,</span>
<span class="cs-line hl-p">    <span class="str">'lr'</span>:        <span class="num">6e-4</span>,</span>
<span class="cs-line hl-p">    <span class="str">'scheduler'</span>: <span class="str">'cosine'</span>,</span>
<span class="cs-line hl-p">    <span class="str">'warmup'</span>:    <span class="num">0.04</span>,</span>
<span class="cs-line hl-p">    <span class="cmt"># Validation: check tau per domain</span></span>
<span class="cs-line hl-p">    <span class="str">'eval_datasets'</span>: [<span class="str">'Math500'</span>, <span class="str">'HumanEval'</span>,</span>
<span class="cs-line hl-p">                       <span class="str">'MT-Bench'</span>],</span>
<span class="cs-line hl-p">}</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Diagnostic: tau targets to verify balanced mix</span>
<span class="cs-line hl-g">assert tau[<span class="str">'Math500'</span>] &gt; <span class="num">3.0</span>  <span class="cmt"># if &lt; 3: add math</span></span>
<span class="cs-line hl-g">assert tau[<span class="str">'HumanEval'</span>] &gt; <span class="num">2.8</span>  <span class="cmt"># if &lt; 2.8: add code</span></span>
<span class="cs-line hl-g">assert tau[<span class="str">'MT-Bench'</span>] &gt; <span class="num">2.5</span>  <span class="cmt"># if &lt; 2.5: add chat</span></span>
      </pre>
    </div>

  </div>
</aside>

</div><!-- /post-grid -->

<script>
// ── TOC + sidebar toggles ──
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});

const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ── Tab switching ──
const tabMeta = {
  align:  { file: 'data_prep/corpus.py',     title: 'The Alignment Problem' },
  theory: { file: 'data_prep/speedup.py',    title: 'Theory: Data → Speedup' },
  eras:   { file: 'data_prep/eras.py',       title: 'Three Eras of Data Strategy' },
  regen:  { file: 'data_prep/regen.py',      title: 'Response Regeneration' },
  mix:    { file: 'data_prep/corpus_mix.py', title: 'Corpus Design' },
  anchor: { file: 'data_prep/anchor.py',     title: 'Anchor Sampling' },
  recipe: { file: 'data_prep/config.py',     title: 'Production Recipe' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ── IntersectionObserver: sync TOC + sidebar ──
const sectionMap = {
  's-align':  'align',
  's-theory': 'theory',
  's-eras':   'eras',
  's-regen':  'regen',
  's-mix':    'mix',
  's-anchor': 'anchor',
  's-recipe': 'recipe',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ── §01 KL divergence canvas ──
(function() {
  const canvas = document.getElementById('kl-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const slider = document.getElementById('kl-slider');
  const valEl  = document.getElementById('kl-val');
  const tauEl  = document.getElementById('kl-tau');

  function resize() {
    const DPR = window.devicePixelRatio || 1;
    const W = canvas.clientWidth, H = canvas.clientHeight;
    canvas.width = W * DPR; canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
  }

  function gaussian(x, mu, sigma) {
    return Math.exp(-0.5 * ((x - mu) / sigma) ** 2) / (sigma * Math.sqrt(2 * Math.PI));
  }

  function drawKL(klVal) {
    const W = canvas.clientWidth, H = canvas.clientHeight;
    ctx.clearRect(0, 0, W, H);

    // Parameters
    const shift = klVal * 0.9;  // how far draft shifts from target
    const sigma = 18;
    const muTarget = W * 0.45;
    const muDraft  = W * 0.45 + shift * 1.2;

    const N = 200;
    const xs = Array.from({length: N}, (_, i) => (i / (N - 1)) * W);

    // Normalise
    const targetVals = xs.map(x => gaussian(x, muTarget, sigma));
    const draftVals  = xs.map(x => gaussian(x, muDraft,  sigma));
    const maxT = Math.max(...targetVals);
    const hScale = (H * 0.72) / maxT;

    // Overlap fill
    ctx.beginPath();
    ctx.moveTo(xs[0], H - 24);
    for (let i = 0; i < N; i++) {
      const ov = Math.min(targetVals[i], draftVals[i]) * hScale;
      ctx.lineTo(xs[i], H - 24 - ov);
    }
    ctx.lineTo(xs[N-1], H - 24);
    ctx.closePath();
    ctx.fillStyle = 'rgba(16,185,129,0.22)';
    ctx.fill();

    // Target curve (purple)
    ctx.beginPath();
    for (let i = 0; i < N; i++) {
      const y = H - 24 - targetVals[i] * hScale;
      i === 0 ? ctx.moveTo(xs[i], y) : ctx.lineTo(xs[i], y);
    }
    ctx.strokeStyle = '#8b5cf6';
    ctx.lineWidth = 2;
    ctx.stroke();

    // Draft curve (cyan)
    ctx.beginPath();
    for (let i = 0; i < N; i++) {
      const y = H - 24 - draftVals[i] * hScale;
      i === 0 ? ctx.moveTo(xs[i], y) : ctx.lineTo(xs[i], y);
    }
    ctx.strokeStyle = '#06b6d4';
    ctx.lineWidth = 2;
    ctx.stroke();

    // Labels
    ctx.font = '11px monospace'; ctx.fillStyle = '#8b5cf6';
    ctx.fillText('target', muTarget - 22, 18);
    ctx.fillStyle = '#06b6d4';
    ctx.fillText('draft', muDraft + 10, 18);
    ctx.fillStyle = '#10b981';
    ctx.fillText('overlap = P(accept)', W / 2 - 60, H - 5);

    // Compute expected tau: alpha ~ overlap area
    const overlapArea = targetVals.reduce((s, tv, i) => s + Math.min(tv, draftVals[i]), 0) / N;
    const totalArea   = targetVals.reduce((s, v) => s + v, 0) / N;
    const alpha = Math.max(0.1, Math.min(0.99, overlapArea / totalArea));
    const gamma = 16;
    const tau = (1 - Math.pow(alpha, gamma + 1)) / (1 - alpha);
    tauEl.textContent = tau.toFixed(1);
  }

  function update() {
    const v = parseInt(slider.value) / 100;
    valEl.textContent = v.toFixed(2);
    resize();
    drawKL(v * 80);
  }

  slider.addEventListener('input', update);
  window.addEventListener('resize', update);
  update();
})();

// ── §02 Speedup formula canvas ──
(function() {
  const canvas = document.getElementById('speedup-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const alphaSlider = document.getElementById('alpha-slider');
  const gammaSlider = document.getElementById('gamma-slider');
  const alphaVal    = document.getElementById('alpha-val');
  const gammaVal    = document.getElementById('gamma-val');

  function resize() {
    const DPR = window.devicePixelRatio || 1;
    const W = canvas.clientWidth, H = canvas.clientHeight;
    canvas.width = W * DPR; canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
  }

  function tau(alpha, gamma) {
    if (alpha >= 0.9999) return gamma + 1;
    return (1 - Math.pow(alpha, gamma + 1)) / (1 - alpha);
  }

  function speedup(tau, gamma, c) {
    return tau / (1 + gamma * c);
  }

  function drawSpeedup(alpha, gamma) {
    const W = canvas.clientWidth, H = canvas.clientHeight;
    ctx.clearRect(0, 0, W, H);

    const pad = { l: 52, r: 16, t: 16, b: 36 };
    const plotW = W - pad.l - pad.r;
    const plotH = H - pad.t - pad.b;

    // Grid
    ctx.strokeStyle = 'rgba(255,255,255,0.04)';
    ctx.lineWidth = 1;
    [2, 4, 6, 8].forEach(s => {
      const y = pad.t + plotH * (1 - (s - 1) / 7);
      ctx.beginPath(); ctx.moveTo(pad.l, y); ctx.lineTo(pad.l + plotW, y); ctx.stroke();
      ctx.fillStyle = '#5c6370'; ctx.font = '9px monospace'; ctx.textAlign = 'right';
      ctx.fillText(s.toFixed(0) + '×', pad.l - 4, y + 3);
    });

    // X axis labels (alpha)
    [0.5, 0.6, 0.7, 0.8, 0.9, 1.0].forEach(a => {
      const x = pad.l + (a - 0.4) / 0.6 * plotW;
      ctx.fillStyle = '#5c6370'; ctx.font = '9px monospace'; ctx.textAlign = 'center';
      ctx.fillText(a.toFixed(1), x, H - 6);
    });
    ctx.fillStyle = '#6b7280'; ctx.textAlign = 'center';
    ctx.fillText('acceptance rate α →', pad.l + plotW / 2, H - 0);

    // Curve helper
    function drawCurve(c, color, label) {
      ctx.beginPath();
      let first = true;
      for (let ai = 40; ai <= 99; ai++) {
        const a = ai / 100;
        const t = tau(a, gamma);
        const s = speedup(t, gamma, c);
        const x = pad.l + (a - 0.4) / 0.6 * plotW;
        const y = pad.t + plotH * (1 - Math.min(s - 1, 7) / 7);
        first ? (ctx.moveTo(x, y), first = false) : ctx.lineTo(x, y);
      }
      ctx.strokeStyle = color; ctx.lineWidth = 2; ctx.stroke();

      // Current alpha marker
      const t = tau(alpha, gamma);
      const s = speedup(t, gamma, c);
      const mx = pad.l + (alpha - 0.4) / 0.6 * plotW;
      const my = pad.t + plotH * (1 - Math.min(s - 1, 7) / 7);
      ctx.beginPath(); ctx.arc(mx, my, 5, 0, Math.PI * 2);
      ctx.fillStyle = color; ctx.fill();
      ctx.fillStyle = color; ctx.font = '10px monospace'; ctx.textAlign = 'left';
      ctx.fillText(label + ' ' + s.toFixed(1) + '×', mx + 8, my + 4);
    }

    drawCurve(0.023, '#8b5cf6', 'DFlash');
    drawCurve(0.166, '#06b6d4', 'EAGLE');

    // Vertical line at current alpha
    const xCur = pad.l + (alpha - 0.4) / 0.6 * plotW;
    ctx.beginPath(); ctx.moveTo(xCur, pad.t); ctx.lineTo(xCur, pad.t + plotH);
    ctx.strokeStyle = 'rgba(255,255,255,0.15)'; ctx.lineWidth = 1; ctx.setLineDash([4, 4]);
    ctx.stroke(); ctx.setLineDash([]);
  }

  function update() {
    const alpha = parseInt(alphaSlider.value) / 100;
    const gamma = parseInt(gammaSlider.value);
    alphaVal.textContent = alpha.toFixed(2);
    gammaVal.textContent = gamma;
    resize();
    drawSpeedup(alpha, gamma);
  }

  alphaSlider.addEventListener('input', update);
  gammaSlider.addEventListener('input', update);
  window.addEventListener('resize', update);
  update();
})();

// ── §03 Era step navigator ──
(function() {
  let step = 0;
  const boxes  = document.querySelectorAll('#era-steps .step-box');
  const prevBtn = document.getElementById('era-prev');
  const nextBtn = document.getElementById('era-next');
  const progEl  = document.getElementById('era-prog');

  function updateSteps() {
    boxes.forEach((b, i) => {
      b.classList.remove('active', 'done');
      if (i === step) b.classList.add('active');
      else if (i < step) b.classList.add('done');
    });
    if (prevBtn) prevBtn.disabled = step === 0;
    if (nextBtn) nextBtn.disabled = step === boxes.length - 1;
    if (progEl) progEl.textContent = 'Era ' + (step + 1) + ' of ' + boxes.length;
    boxes.forEach((b, i) => {
      const n = b.querySelector('.step-num');
      if (n) n.textContent = i < step ? '✓' : String(i + 1);
    });
  }
  prevBtn?.addEventListener('click', () => { if (step > 0) { step--; updateSteps(); } });
  nextBtn?.addEventListener('click', () => { if (step < boxes.length - 1) { step++; updateSteps(); } });
  updateSteps();
})();

// ── §05 Animated bar chart ──
(function() {
  const section = document.getElementById('s-mix');
  if (!section) return;
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('#mix-bars .bar-fill').forEach(b => {
          const pct = parseFloat(b.dataset.pct);
          const max = parseFloat(b.dataset.max);
          b.style.width = (pct / max * 100) + '%';
        });
      }
    });
  }, { threshold: 0.3 }).observe(section);
})();

// ── §06 Anchor sampling canvas ──
(function() {
  const canvas = document.getElementById('anchor-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const playBtn  = document.getElementById('anchor-play');
  const resetBtn = document.getElementById('anchor-reset');
  const epochEl  = document.getElementById('anchor-epoch');

  let epoch = 0;
  let animId = null;
  let playing = false;
  let frame = 0;

  const SEQ_LEN   = 32;   // tokens to show
  const BLOCK_SZ  = 4;    // block size (simplified)
  const N_ANCHORS = 6;    // anchors per epoch (simplified)

  // Seeded LCG for reproducible random anchors per epoch
  function seeded(seed) {
    let s = seed;
    return () => { s = (1664525 * s + 1013904223) & 0x7fffffff; return s / 0x7fffffff; };
  }

  function getAnchors(ep) {
    const rng = seeded(ep * 137 + 42);
    const anchors = new Set();
    while (anchors.size < N_ANCHORS) {
      anchors.add(Math.floor(rng() * (SEQ_LEN - BLOCK_SZ)));
    }
    return [...anchors];
  }

  function draw(ep, progress) {
    const DPR = window.devicePixelRatio || 1;
    const W = canvas.clientWidth, H = canvas.clientHeight;
    if (canvas.width !== W * DPR || canvas.height !== H * DPR) {
      canvas.width = W * DPR; canvas.height = H * DPR;
      ctx.scale(DPR, DPR);
    }
    ctx.clearRect(0, 0, W, H);

    const cellW = Math.floor((W - 40) / SEQ_LEN);
    const cellH = 28;
    const startX = 20;
    const rowY   = H / 2 - cellH / 2;

    const anchors = getAnchors(ep);
    const visible = Math.round(anchors.length * progress);

    // Draw token cells
    for (let i = 0; i < SEQ_LEN; i++) {
      const x = startX + i * cellW;
      let bg = 'rgba(255,255,255,0.04)';
      let border = 'rgba(255,255,255,0.08)';
      let label = '';

      // Check if this token is an anchor or part of a mask block for shown anchors
      for (let ai = 0; ai < visible; ai++) {
        const a = anchors[ai];
        if (i === a) { bg = 'rgba(245,158,11,0.35)'; border = 'rgba(245,158,11,0.7)'; label = 'A'; break; }
        if (i > a && i < a + BLOCK_SZ) { bg = 'rgba(16,185,129,0.18)'; border = 'rgba(16,185,129,0.45)'; label = 'M'; break; }
      }

      ctx.fillStyle = bg;
      ctx.fillRect(x, rowY, cellW - 2, cellH);
      ctx.strokeStyle = border;
      ctx.lineWidth = 1;
      ctx.strokeRect(x, rowY, cellW - 2, cellH);

      if (label) {
        ctx.fillStyle = label === 'A' ? '#f59e0b' : '#10b981';
        ctx.font = '8px monospace';
        ctx.textAlign = 'center';
        ctx.fillText(label, x + (cellW - 2) / 2, rowY + 17);
      }
    }

    // Legend
    ctx.fillStyle = 'rgba(245,158,11,0.35)'; ctx.fillRect(startX, rowY + cellH + 12, 12, 12);
    ctx.fillStyle = '#f59e0b'; ctx.font = '10px monospace'; ctx.textAlign = 'left';
    ctx.fillText('A = anchor (clean, context)', startX + 16, rowY + cellH + 22);

    ctx.fillStyle = 'rgba(16,185,129,0.18)'; ctx.fillRect(startX + 190, rowY + cellH + 12, 12, 12);
    ctx.fillStyle = '#10b981';
    ctx.fillText('M = mask (model must predict)', startX + 206, rowY + cellH + 22);

    // Label above
    ctx.fillStyle = '#6b7280'; ctx.textAlign = 'center';
    ctx.fillText('32-token response sequence — epoch ' + (ep + 1) + ' anchor layout', W / 2, rowY - 10);
  }

  function animate() {
    if (!playing) return;
    frame++;
    const FRAMES_PER_EPOCH = 60;
    const epochLocal = Math.floor(frame / FRAMES_PER_EPOCH);
    const progress   = (frame % FRAMES_PER_EPOCH) / FRAMES_PER_EPOCH;

    if (epochLocal >= 6) {
      playing = false;
      playBtn.textContent = '▶ Play';
      draw(5, 1);
      epochEl.textContent = '6';
      return;
    }

    epoch = epochLocal;
    epochEl.textContent = epoch + 1;
    draw(epoch, progress);
    animId = requestAnimationFrame(animate);
  }

  playBtn?.addEventListener('click', () => {
    if (playing) {
      playing = false;
      cancelAnimationFrame(animId);
      playBtn.textContent = '▶ Play';
    } else {
      playing = true;
      playBtn.textContent = '⏸ Pause';
      animId = requestAnimationFrame(animate);
    }
  });

  resetBtn?.addEventListener('click', () => {
    playing = false;
    cancelAnimationFrame(animId);
    playBtn.textContent = '▶ Play';
    frame = 0; epoch = 0;
    epochEl.textContent = '1';
    draw(0, 0);
  });

  // Initial draw
  (function initResize() {
    const DPR = window.devicePixelRatio || 1;
    const W = canvas.clientWidth, H = canvas.clientHeight;
    canvas.width = W * DPR; canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
    draw(0, 0);
  })();
})();
</script>
</BaseLayout>

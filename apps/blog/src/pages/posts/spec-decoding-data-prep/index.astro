    <div class="cs-panel" id="panel-theory">
      <pre class="cs-pre">
<span class="cs-line cmt"># Speculative decoding speedup formula</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">speedup</span>(tau, gamma, c):</span>
<span class="cs-line hl-p">    <span class="str">"""</span></span>
<span class="cs-line hl-p">    <span class="str">tau   = expected accepted tokens/step</span></span>
<span class="cs-line hl-p">    <span class="str">gamma = speculation budget (draft tokens)</span></span>
<span class="cs-line hl-p">    <span class="str">c     = draft cost / target cost</span></span>
<span class="cs-line hl-p">    <span class="str">"""</span></span>
<span class="cs-line">    <span class="kw">return</span> tau / (<span class="num">1</span> + gamma * c)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># DFlash (block diffusion, 5-layer):</span>
<span class="cs-line cmt">#   c = 0.023  (2.3% of target cost)</span>

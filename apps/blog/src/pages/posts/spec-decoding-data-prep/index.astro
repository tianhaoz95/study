<span class="cs-line"> </span>
<span class="cs-line cmt"># EAGLE-3 (autoregressive, 1-layer):</span>
<span class="cs-line cmt">#   c = 0.166  (16.6% of target cost)</span>
<span class="cs-line cmt">#   gamma = 16, tau = 3.02 (Math500)</span>
<span class="cs-line hl-a">s_eagle = <span class="fn">speedup</span>(<span class="num">3.02</span>, <span class="num">16</span>, <span class="num">0.166</span>)  <span class="cmt"># ~1.8x</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># tau from acceptance rate alpha:</span>
<span class="cs-line cmt"># alpha = 0.6  -&gt;  tau = 2.7  (poor data)</span>
<span class="cs-line cmt"># alpha = 0.75 -&gt;  tau = 4.6  (decent mix)</span>
<span class="cs-line cmt"># alpha = 0.90 -&gt;  tau = 8.5  (ideal mix)</span>
<span class="cs-line cmt"># alpha = 0.95 -&gt;  tau = 12.1 (theoretical)</span>
<span class="cs-line"> </span>

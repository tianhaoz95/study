  <div class="bar-row">
    <div class="bar-label">MT-Bench (chat-dominated)</div>
    <div class="bar-track"><div class="bar-fill" style="background:rgba(245,158,11,.6)" data-pct="6.42" data-max="9.0"><span>τ = 6.42</span></div></div>
  </div>

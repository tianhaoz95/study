<span class="cs-line hl-p">    <span class="cmt"># Corpus</span></span>
<span class="cs-line hl-p">    <span class="str">'corpus_size'</span>:   <span class="num">800_000</span>,   <span class="cmt"># ~1M samples</span></span>
<span class="cs-line hl-p">    <span class="str">'domain_mix'</span>: &#123;</span>
<span class="cs-line hl-p">        <span class="str">'chat'</span>: <span class="num">0.40</span>, <span class="str">'math'</span>: <span class="num">0.35</span>, <span class="str">'code'</span>: <span class="num">0.25</span></span>
<span class="cs-line hl-p">    },</span>
<span class="cs-line hl-p">    <span class="str">'regenerate_responses'</span>: <span class="kw">True</span>,  <span class="cmt"># +5.3%</span></span>
<span class="cs-line hl-p">    <span class="str">'regen_temperature'</span>:    <span class="num">0.0</span>,   <span class="cmt"># greedy</span></span>

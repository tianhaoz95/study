    <div class="bar-label">HumanEval (code)</div>
    <div class="bar-track"><div class="bar-fill" style="background:rgba(16,185,129,.65)" data-pct="6.63" data-max="9.0"><span>τ = 6.63</span></div></div>
  </div>

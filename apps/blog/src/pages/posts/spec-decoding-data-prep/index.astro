  </div>
  <div class="bar-row">
    <div class="bar-label">Perfect-Blend balanced (1.4M)</div>
    <div class="bar-track"><div class="bar-fill" style="background:rgba(6,182,212,.7)" data-pct="3.48" data-max="5.0"><span>τ = 3.48</span></div></div>
  </div>
  <div class="bar-row">
    <div class="bar-label">Perfect-Blend + regenerated</div>
    <div class="bar-track"><div class="bar-fill" style="background:rgba(139,92,246,.8)" data-pct="3.65" data-max="5.0"><span>τ = 3.65 (+5.3%)</span></div></div>
  </div>

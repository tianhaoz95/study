<script>
// ─── Sidebar/TOC toggles ───────────────────────────────
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});

const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ─── Code sidebar tab switching ───────────────────────
const tabMeta = {
  collision: { file: 'dspark/draft.py',      title: 'Multi-Modal Collision' },
  arch:      { file: 'dspark/model.py',      title: 'Semi-AR Architecture' },
  sched:     { file: 'dspark/scheduler.py',  title: 'Confidence Scheduling' },
  poswise:   { file: 'dspark/analysis.py',   title: 'Position-Wise Analysis' },
  results:   { file: 'dspark/results.py',    title: 'Benchmark Results' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ─── IntersectionObserver: sync TOC + sidebar tab ─────
const sectionMap = {
  's-collision': 'collision',
  's-arch':      'arch',
  's-sched':     'sched',
  's-poswise':   'poswise',
  's-results':   'results',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ─── §01: Multi-modal collision canvas ────────────────
(function() {
  const canvas = document.getElementById('collision-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  function resize() {
    const W = canvas.clientWidth, H = canvas.clientHeight;
    canvas.width = W * DPR; canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
    return [W, H];
  }
  let [W, H] = resize();

  // Two rows: top = parallel drafter, bottom = DSpark
  // Each shows: [ANCHOR] → token1 → token2 → token3
  // Parallel: picks "of" | "problem" (collision)
  // DSpark:   picks "of" | "course"  (correct)

  const phases = [
    { label: 'Context', dur: 600 },
    { label: 'Pos 1 sampled', dur: 700 },
    { label: 'Pos 2 prediction', dur: 700 },
    { label: 'Done', dur: 1200 },
  ];
  let phase = 0, t = 0, animId = null;

  function lerp(a, b, tt) { return a + (b - a) * Math.max(0, Math.min(1, tt)); }
  function easeOut(tt) { return 1 - (1 - tt) * (1 - tt); }

  const tokens = [
    { label: 'say',      x: 0.12 },
    { label: '"of',      x: 0.27 },
    { label: 'course"',  x: 0.45 },
    { label: 'OR',       x: 0.27, isOr: true },
    { label: '"no',      x: 0.45 },
    { label: 'problem"', x: 0.63 },
  ];

  function draw(fraction) {
    [W, H] = [canvas.clientWidth, canvas.clientHeight];
    ctx.clearRect(0, 0, W * DPR, H * DPR);
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);

    const rowTop = H * 0.28;    // parallel drafter
    const rowBot = H * 0.72;    // DSpark
    const f = fraction;

    ctx.font = '600 11px "JetBrains Mono",monospace';

    // Labels on left
    ctx.fillStyle = 'rgba(245,158,11,0.9)';
    ctx.textAlign = 'right';
    ctx.font = 'bold 10px "JetBrains Mono",monospace';
    ctx.fillText('Parallel', W * 0.08, rowTop + 4);
    ctx.fillStyle = 'rgba(16,185,129,0.9)';
    ctx.fillText('DSpark', W * 0.08, rowBot + 4);

    // Context tokens: "The answer is..."
    const ctxTokens = ['The', 'answer', 'is...'];
    ctxTokens.forEach((tok, i) => {
      const x = W * (0.12 + i * 0.10);
      const a = Math.min(1, f * 4);
      drawToken(ctx, x, rowTop, tok, `rgba(99,102,241,${a * 0.7})`, '#c7d2fe', a);
      drawToken(ctx, x, rowBot, tok, `rgba(99,102,241,${a * 0.7})`, '#c7d2fe', a);
    });

    // Arrow after context
    if (f > 0.2) {
      const a = Math.min(1, (f - 0.2) * 5);
      ctx.strokeStyle = `rgba(107,114,128,${a * 0.5})`;
      ctx.lineWidth = 1.5;
      const ax = W * 0.42;
      ctx.beginPath(); ctx.moveTo(ax, rowTop); ctx.lineTo(ax + 18, rowTop); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(ax, rowBot); ctx.lineTo(ax + 18, rowBot); ctx.stroke();
    }

    // Phase 1: Pos 1 "of" sampled (both models agree)
    if (f > 0.25) {
      const a = easeOut(Math.min(1, (f - 0.25) * 4));
      const x1 = W * 0.52;
      drawToken(ctx, x1, rowTop, '"of', `rgba(245,158,11,${a * 0.3})`, `rgba(245,158,11,${a * 0.9})`, a);
      drawToken(ctx, x1, rowBot, '"of', `rgba(16,185,129,${a * 0.3})`, `rgba(16,185,129,${a * 0.9})`, a);
    }

    // Phase 2: Pos 2 — parallel picks "problem" (collision!), DSpark picks "course"
    if (f > 0.55) {
      const a = easeOut(Math.min(1, (f - 0.55) * 4));
      const x2 = W * 0.70;

      // Parallel: "problem" — red, wrong
      drawToken(ctx, x2, rowTop, 'problem"', `rgba(239,68,68,${a * 0.3})`, `rgba(239,68,68,${a * 0.95})`, a);
      // Small ✗
      if (a > 0.5) {
        ctx.fillStyle = `rgba(239,68,68,${a})`;
        ctx.font = `bold ${14 * a}px sans-serif`;
        ctx.textAlign = 'center';
        ctx.fillText('✗', x2 + 50, rowTop - 16);
      }

      // DSpark: "course" — green, correct
      drawToken(ctx, x2, rowBot, 'course"', `rgba(16,185,129,${a * 0.3})`, `rgba(16,185,129,${a * 0.95})`, a);
      if (a > 0.5) {
        ctx.fillStyle = `rgba(16,185,129,${a})`;
        ctx.font = `bold ${14 * a}px sans-serif`;
        ctx.textAlign = 'center';
        ctx.fillText('✓', x2 + 46, rowBot - 16);
      }

      // Result labels
      if (a > 0.7) {
        ctx.fillStyle = `rgba(239,68,68,${(a - 0.7) * 3.33})`;
        ctx.font = 'italic 10px sans-serif';
        ctx.textAlign = 'left';
        ctx.fillText('"of problem" — collision!', W * 0.83, rowTop + 4);
        ctx.fillStyle = `rgba(16,185,129,${(a - 0.7) * 3.33})`;
        ctx.fillText('"of course" — coherent', W * 0.83, rowBot + 4);
      }
    }

    ctx.font = '600 11px "JetBrains Mono",monospace';
  }

  function drawToken(ctx, cx, cy, label, bg, textCol, alpha) {
    const pad = 7, h = 26;
    ctx.font = '600 11px "JetBrains Mono",monospace';
    const tw = ctx.measureText(label).width;
    const x = cx - tw / 2 - pad;
    const y = cy - h / 2;
    const w = tw + pad * 2;
    ctx.globalAlpha = alpha;
    ctx.fillStyle = bg;
    roundRect(ctx, x, y, w, h, 5);
    ctx.fill();
    ctx.strokeStyle = textCol;
    ctx.lineWidth = 1;
    roundRect(ctx, x, y, w, h, 5);
    ctx.stroke();
    ctx.fillStyle = textCol;
    ctx.textAlign = 'center';
    ctx.fillText(label, cx, cy + 4);
    ctx.globalAlpha = 1;
  }

  function roundRect(ctx, x, y, w, h, r) {
    ctx.beginPath();
    ctx.moveTo(x + r, y);
    ctx.lineTo(x + w - r, y);
    ctx.quadraticCurveTo(x + w, y, x + w, y + r);
    ctx.lineTo(x + w, y + h - r);
    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
    ctx.lineTo(x + r, y + h);
    ctx.quadraticCurveTo(x, y + h, x, y + h - r);
    ctx.lineTo(x, y + r);
    ctx.quadraticCurveTo(x, y, x + r, y);
    ctx.closePath();
  }

  let progF = 0;
  let lastTs = null;
  let playing = true;

  function animate(ts) {
    if (!lastTs) lastTs = ts;
    const dt = ts - lastTs; lastTs = ts;
    if (playing) {
      progF += dt / 2400;
      if (progF >= 1.2) { progF = 0; }
    }
    draw(Math.min(progF, 1));
    animId = requestAnimationFrame(animate);
  }

  draw(0);
  animId = requestAnimationFrame(animate);

  canvas.addEventListener('click', () => {
    progF = 0;
  });
})();

// ─── §02: Architecture step navigator ─────────────────
(function() {
  let step = 0;
  const boxes  = document.querySelectorAll('#arch-steps .step-box');
  const prevBtn = document.getElementById('arch-prev');
  const nextBtn = document.getElementById('arch-next');
  const progEl  = document.getElementById('arch-prog');
  function updateSteps() {
    boxes.forEach((b, i) => {
      b.classList.remove('active', 'done');
      if (i === step) b.classList.add('active');
      else if (i < step) b.classList.add('done');
    });
    if (prevBtn) prevBtn.disabled = step === 0;
    if (nextBtn) nextBtn.disabled = step === boxes.length - 1;
    if (progEl) progEl.textContent = `Step ${step+1} of ${boxes.length}`;
    boxes.forEach((b, i) => {
      const n = b.querySelector('.step-num');
      if (n) n.textContent = i < step ? '✓' : String(i + 1);
    });
  }
  prevBtn?.addEventListener('click', () => { if (step > 0) { step--; updateSteps(); } });
  nextBtn?.addEventListener('click', () => { if (step < boxes.length - 1) { step++; updateSteps(); } });
  updateSteps();
})();

// ─── §03: Confidence scheduling canvas ────────────────
(function() {
  const canvas = document.getElementById('sched-canvas');
  const slider = document.getElementById('load-slider');
  const loadVal = document.getElementById('load-val');
  if (!canvas || !slider) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;

  function resize() {
    const W = canvas.clientWidth, H = 220;
    canvas.width = W * DPR; canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
    return [W, H];
  }
  let [W, H] = resize();

  // Show γ=7 draft tokens as colored bars
  // confidence c1..c7 for a "chat" scenario
  const conf = [0.88, 0.82, 0.76, 0.66, 0.55, 0.44, 0.35];
  // cumulative survival
  const surv = conf.map((_, i) => conf.slice(0, i+1).reduce((a,b)=>a*b,1));

  function getOptimalLen(load) {
    // At load 0% → verify all 7
    // At load 100% → verify only top-1 or 2
    // Simple model: threshold = 0.3 + load/100 * 0.5
    const threshold = 0.3 + (load / 100) * 0.55;
    for (let k = conf.length - 1; k >= 0; k--) {
      if (surv[k] >= threshold) return k + 1;
    }
    return 1;
  }

  function draw(load) {
    [W, H] = [canvas.clientWidth, 220];
    ctx.clearRect(0, 0, W * DPR, H * DPR);
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);

    const gamma = 7;
    const BAR_W = 52, GAP = 10;
    const totalW = gamma * BAR_W + (gamma - 1) * GAP;
    const startX = (W - totalW) / 2;
    const optLen = getOptimalLen(load);
    const maxH = H * 0.55;
    const baseY = H * 0.72;

    // Axis label
    ctx.fillStyle = 'rgba(107,114,128,0.8)';
    ctx.font = '10px "JetBrains Mono",monospace';
    ctx.textAlign = 'left';
    ctx.fillText('Draft position →', startX, H * 0.92);
    ctx.textAlign = 'right';
    ctx.fillText('Cumulative survival prob ↑', startX + totalW, H * 0.92);

    for (let k = 0; k < gamma; k++) {
      const x = startX + k * (BAR_W + GAP);
      const accepted = k < optLen;
      const h = surv[k] * maxH;
      const y = baseY - h;

      // Bar
      ctx.fillStyle = accepted
        ? `rgba(139,92,246,0.75)`
        : `rgba(107,114,128,0.22)`;
      ctx.strokeStyle = accepted
        ? 'rgba(139,92,246,0.9)'
        : 'rgba(107,114,128,0.3)';
      ctx.lineWidth = 1;
      ctx.fillRect(x, y, BAR_W, h);
      ctx.strokeRect(x, y, BAR_W, h);

      // Confidence label
      ctx.fillStyle = accepted ? '#a78bfa' : 'rgba(107,114,128,0.6)';
      ctx.font = 'bold 9px "JetBrains Mono",monospace';
      ctx.textAlign = 'center';
      ctx.fillText(surv[k].toFixed(2), x + BAR_W / 2, y - 5);

      // Position label
      ctx.fillStyle = 'rgba(107,114,128,0.7)';
      ctx.font = '9px "JetBrains Mono",monospace';
      ctx.fillText('pos ' + (k + 1), x + BAR_W / 2, baseY + 14);

      // Accepted/dropped label
      if (k === optLen - 1 && optLen < gamma) {
        // Cutoff line
        const cutX = x + BAR_W + GAP / 2;
        ctx.strokeStyle = 'rgba(239,68,68,0.7)';
        ctx.lineWidth = 1.5;
        ctx.setLineDash([4, 3]);
        ctx.beginPath();
        ctx.moveTo(cutX, H * 0.05);
        ctx.lineTo(cutX, baseY + 5);
        ctx.stroke();
        ctx.setLineDash([]);
        ctx.fillStyle = 'rgba(239,68,68,0.8)';
        ctx.font = 'bold 9px "JetBrains Mono",monospace';
        ctx.textAlign = 'center';
        ctx.fillText('pruned →', cutX + 28, H * 0.12);
      }
    }

    // Legend
    ctx.fillStyle = '#a78bfa';
    ctx.fillRect(startX, H * 0.05, 12, 10);
    ctx.fillStyle = 'rgba(107,114,128,0.8)';
    ctx.font = '10px "JetBrains Mono",monospace';
    ctx.textAlign = 'left';
    ctx.fillText(`verified (${optLen} tokens)`, startX + 16, H * 0.05 + 9);

    ctx.fillStyle = 'rgba(107,114,128,0.22)';
    ctx.strokeStyle = 'rgba(107,114,128,0.3)';
    ctx.lineWidth = 1;
    ctx.fillRect(startX + 130, H * 0.05, 12, 10);
    ctx.strokeRect(startX + 130, H * 0.05, 12, 10);
    ctx.fillStyle = 'rgba(107,114,128,0.8)';
    ctx.fillText(`pruned (${gamma - optLen} tokens)`, startX + 146, H * 0.05 + 9);
  }

  draw(20);

  slider.addEventListener('input', () => {
    const v = parseInt(slider.value);
    const label = v < 30 ? 'Low' : v < 60 ? 'Medium' : v < 85 ? 'High' : 'Critical';
    loadVal.textContent = `${label} (${v}%)`;
    draw(v);
  });
})();

// ─── §04: Position-wise acceptance chart ──────────────
(function() {
  const canvas = document.getElementById('poswise-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;

  function resize() {
    const W = canvas.clientWidth, H = 260;
    canvas.width = W * DPR; canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
    return [W, H];
  }
  let [W, H] = resize();

  const DOMAINS = {
    math: {
      eagle: [0.81, 0.82, 0.83, 0.84, 0.84, 0.85, 0.85],
      dflash:[0.88, 0.86, 0.84, 0.82, 0.80, 0.79, 0.78],
      dspark:[0.93, 0.92, 0.91, 0.91, 0.90, 0.90, 0.89],
      yMin: 0.70, yMax: 0.96,
    },
    code: {
      eagle: [0.68, 0.70, 0.72, 0.74, 0.74, 0.74, 0.75],
      dflash:[0.82, 0.80, 0.78, 0.76, 0.74, 0.72, 0.70],
      dspark:[0.89, 0.88, 0.87, 0.87, 0.86, 0.85, 0.84],
      yMin: 0.60, yMax: 0.94,
    },
    chat: {
      eagle: [0.53, 0.57, 0.61, 0.64, 0.68, 0.71, 0.74],
      dflash:[0.72, 0.70, 0.68, 0.66, 0.65, 0.64, 0.63],
      dspark:[0.88, 0.87, 0.87, 0.86, 0.86, 0.85, 0.85],
      yMin: 0.45, yMax: 0.95,
    },
  };

  let activeDomain = 'math';

  function drawChart(domain) {
    [W, H] = [canvas.clientWidth, 260];
    ctx.clearRect(0, 0, W * DPR, H * DPR);
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);

    const d = DOMAINS[domain];
    const PAD_L = 54, PAD_R = 24, PAD_T = 28, PAD_B = 38;
    const cW = W - PAD_L - PAD_R;
    const cH = H - PAD_T - PAD_B;
    const { yMin, yMax } = d;

    function xp(i) { return PAD_L + (i / 6) * cW; }
    function yp(v) { return PAD_T + cH - ((v - yMin) / (yMax - yMin)) * cH; }

    // Grid
    const gridY = [0.5, 0.6, 0.7, 0.8, 0.9, 1.0];
    ctx.strokeStyle = 'rgba(255,255,255,0.04)';
    ctx.lineWidth = 1;
    gridY.forEach(v => {
      if (v < yMin || v > yMax) return;
      ctx.beginPath();
      ctx.moveTo(PAD_L, yp(v));
      ctx.lineTo(W - PAD_R, yp(v));
      ctx.stroke();
      ctx.fillStyle = 'rgba(107,114,128,0.6)';
      ctx.font = '9px "JetBrains Mono",monospace';
      ctx.textAlign = 'right';
      ctx.fillText(v.toFixed(1), PAD_L - 6, yp(v) + 3);
    });

    // X axis
    ctx.fillStyle = 'rgba(107,114,128,0.7)';
    ctx.font = '9px "JetBrains Mono",monospace';
    ctx.textAlign = 'center';
    for (let i = 0; i <= 6; i++) {
      ctx.fillText(String(i + 1), xp(i), H - PAD_B + 14);
    }
    ctx.fillStyle = 'rgba(107,114,128,0.6)';
    ctx.fillText('Draft position', PAD_L + cW / 2, H - 4);

    // Lines
    const series = [
      { data: d.eagle, color: '#f59e0b', label: 'Eagle3 (AR)', dash: [5, 3] },
      { data: d.dflash, color: '#06b6d4', label: 'DFlash (parallel)', dash: [3, 2] },
      { data: d.dspark, color: '#8b5cf6', label: 'DSpark (semi-AR)', dash: [] },
    ];

    series.forEach(s => {
      ctx.strokeStyle = s.color;
      ctx.lineWidth = s.dash.length ? 1.5 : 2.5;
      ctx.setLineDash(s.dash);
      ctx.beginPath();
      s.data.forEach((v, i) => {
        if (i === 0) ctx.moveTo(xp(i), yp(v));
        else ctx.lineTo(xp(i), yp(v));
      });
      ctx.stroke();
      ctx.setLineDash([]);

      // Dots
      s.data.forEach((v, i) => {
        ctx.beginPath();
        ctx.arc(xp(i), yp(v), s.dash.length ? 3 : 4, 0, Math.PI * 2);
        ctx.fillStyle = s.color;
        ctx.fill();
      });

      // Label at rightmost point
      const lastV = s.data[6];
      ctx.fillStyle = s.color;
      ctx.font = 'bold 9px "JetBrains Mono",monospace';
      ctx.textAlign = 'left';
      ctx.fillText(s.label, xp(6) + 6, yp(lastV) + 3);
    });

    // Title
    ctx.fillStyle = 'rgba(107,114,128,0.8)';
    ctx.font = '10px "JetBrains Mono",monospace';
    ctx.textAlign = 'left';
    ctx.fillText(`Conditional acceptance — ${domain} domain`, PAD_L, PAD_T - 10);
  }

  drawChart(activeDomain);

  document.querySelectorAll('.domain-tab').forEach(btn => {
    btn.addEventListener('click', function() {
      const dom = this.dataset.domain;
      if (!dom) return;
      document.querySelectorAll('.domain-tab:not([data-rdomain])').forEach(b =>
        b.classList.toggle('active', b.dataset.domain === dom));
      activeDomain = dom;
      drawChart(dom);
    });
  });
})();

// ─── §05: Result bars (domain switch) ─────────────────
(function() {
  const tabs = document.querySelectorAll('[data-rdomain]');
  const sections = {
    math: document.getElementById('result-bars-math'),
    code: document.getElementById('result-bars-code'),
    chat: document.getElementById('result-bars-chat'),
  };
  let active = 'math';

  function activateDomain(d) {
    active = d;
    Object.entries(sections).forEach(([k, el]) => {
      if (el) el.style.display = k === d ? 'block' : 'none';
    });
    tabs.forEach(t => t.classList.toggle('active', t.dataset.rdomain === d));
    // Animate bars in the new section
    const bars = sections[d] ? sections[d].querySelectorAll('.bar-fill[data-w]') : [];
    bars.forEach(b => { b.style.width = '0%'; });
    requestAnimationFrame(() => {
      bars.forEach(b => {
        b.style.width = (parseFloat(b.dataset.w)) + '%';
      });
    });
  }

  tabs.forEach(t => t.addEventListener('click', () => activateDomain(t.dataset.rdomain)));

  // IntersectionObserver triggers bars
  const resultsSection = document.getElementById('s-results');
  if (resultsSection) {
    new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          activateDomain(active);
        }
      });
    }, { threshold: 0.2 }).observe(resultsSection);
  }
})();
</script>
</BaseLayout>

<span class="cs-line cmt"># Multi-modal collision in parallel drafters</span>
<span class="cs-line cmt"># Context supports two completions equally:</span>
<span class="cs-line cmt">#   "of course"  vs  "no problem"</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Parallel drafter: each position is</span>
<span class="cs-line cmt"># independent — marginalizes over all priors</span>
<span class="cs-line hl-a"><span class="kw">def</span> <span class="fn">parallel_draft</span>(anchor, backbone):</span>
<span class="cs-line hl-a">    <span class="cmt"># One pass → all γ logits at once</span></span>
<span class="cs-line hl-a">    U = backbone(anchor)  <span class="cmt"># [γ, V]</span></span>
<span class="cs-line hl-a">    <span class="kw">return</span> [<span class="fn">sample</span>(U[k]) <span class="kw">for</span> k <span class="kw">in</span> <span class="fn">range</span>(gamma)]</span>
<span class="cs-line hl-a">    <span class="cmt"># pos1 samples "of", pos2 independently</span></span>
<span class="cs-line hl-a">    <span class="cmt"># samples "problem" → "of problem" ✗</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># DSpark: Markov head resolves collision</span>
<span class="cs-line hl-g"><span class="kw">def</span> <span class="fn">dspark_draft</span>(anchor, backbone, W1, W2):</span>
<span class="cs-line hl-g">    U, H = <span class="fn">backbone</span>(anchor)  <span class="cmt"># [γ,V], [γ,d]</span></span>
<span class="cs-line hl-g">    x = [anchor]</span>
<span class="cs-line hl-g">    <span class="kw">for</span> k <span class="kw">in</span> <span class="fn">range</span>(gamma):</span>
<span class="cs-line hl-g">        bias = W1[x[k-<span class="num">1</span>]] @ W2  <span class="cmt"># [V]</span></span>
<span class="cs-line hl-g">        x_k = <span class="fn">sample</span>(U[k] + bias)</span>
<span class="cs-line hl-g">        x.<span class="fn">append</span>(x_k)</span>
<span class="cs-line hl-g">    <span class="cmt"># pos1 samples "of" → bias boosts</span></span>
<span class="cs-line hl-g">    <span class="cmt"># "course" at pos2 → "of course" ✓</span></span>
<span class="cs-line hl-g">    <span class="kw">return</span> x[<span class="num">1</span>:]</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Accepted length τ formula</span>
<span class="cs-line cmt"># L = (T_draft + T_verify) / τ</span>
<span class="cs-line cmt"># Parallel: T_draft = O(1)  → deep arch OK</span>
<span class="cs-line cmt"># Autoregressive: T_draft = O(γ) → shallow</span>
<span class="cs-line cmt"># DSpark: T_draft ≈ O(1) + tiny serial loop</span>
      </pre>
    </div>
    <!-- PANEL: arch -->
    <div class="cs-panel" id="panel-arch">
      <pre class="cs-pre">
<span class="cs-line cmt"># DSpark architecture in full</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># 1. Parallel backbone (DFlash-style)</span>
<span class="cs-line cmt">#    KV-inject target hidden states</span>
<span class="cs-line hl-p"><span class="kw">class</span> <span class="cls">DSpark</span>:</span>
<span class="cs-line hl-p">    <span class="kw">def</span> <span class="fn">__init__</span>(<span class="kw">self</span>, backbone, r=<span class="num">256</span>):</span>
<span class="cs-line hl-p">        <span class="kw">self</span>.backbone = backbone   <span class="cmt"># DFlash</span></span>
<span class="cs-line hl-p">        <span class="kw">self</span>.W1 = <span class="cls">nn</span>.<span class="fn">Embedding</span>(V, r) <span class="cmt"># Markov emb</span></span>
<span class="cs-line hl-p">        <span class="kw">self</span>.W2 = <span class="cls">nn</span>.<span class="fn">Linear</span>(r, V, bias=<span class="cls">False</span>)</span>
<span class="cs-line hl-p">        <span class="kw">self</span>.conf = <span class="cls">nn</span>.<span class="fn">Linear</span>(d+r, <span class="num">1</span>) <span class="cmt"># conf head</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># 2. Semi-AR generation</span>
<span class="cs-line hl-c">    <span class="kw">def</span> <span class="fn">draft</span>(<span class="kw">self</span>, anchor, target_kv):</span>
<span class="cs-line hl-c">        U, H = <span class="kw">self</span>.backbone(anchor, target_kv)</span>
<span class="cs-line hl-c">        x, c = [anchor], []</span>
<span class="cs-line hl-c">        <span class="kw">for</span> k <span class="kw">in</span> <span class="fn">range</span>(gamma):</span>
<span class="cs-line hl-c">            emb = <span class="kw">self</span>.W1(x[-<span class="num">1</span>])       <span class="cmt"># [r]</span></span>
<span class="cs-line hl-c">            bias = <span class="kw">self</span>.W2(emb)          <span class="cmt"># [V]</span></span>
<span class="cs-line hl-c">            x_k = <span class="fn">sample</span>(U[k] + bias)</span>
<span class="cs-line hl-c">            x.<span class="fn">append</span>(x_k)</span>
<span class="cs-line hl-c">            feat = <span class="fn">cat</span>([H[k], emb])     <span class="cmt"># [d+r]</span></span>
<span class="cs-line hl-c">            c_k = <span class="fn">sigmoid</span>(<span class="kw">self</span>.conf(feat))</span>
<span class="cs-line hl-c">            c.<span class="fn">append</span>(c_k)</span>
<span class="cs-line hl-c">        <span class="kw">return</span> x[<span class="num">1</span>:], c</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># 3. Training loss (three components)</span>
<span class="cs-line cmt"># α_ce=0.1  α_tv=0.9  α_conf=1.0</span>
<span class="cs-line hl-g">    <span class="kw">def</span> <span class="fn">loss</span>(<span class="kw">self</span>, draft_logits, target_logits,</span>
<span class="cs-line hl-g">             sampled_x, target_hidden):</span>
<span class="cs-line hl-g">        Lce = <span class="fn">cross_entropy</span>(draft_logits, sampled_x)</span>
<span class="cs-line hl-g">        Ltv = <span class="fn">total_variation_dist</span>(</span>
<span class="cs-line hl-g">                  draft_logits, target_logits)</span>
<span class="cs-line hl-g">        c_star = <span class="num">1</span> - <span class="num">0.5</span>*<span class="fn">tv_dist</span>(</span>
<span class="cs-line hl-g">                     draft_logits, target_logits)</span>
<span class="cs-line hl-g">        Lconf = <span class="fn">bce</span>(self.conf_preds, c_star)</span>
<span class="cs-line hl-g">        <span class="kw">return</span> <span class="num">0.1</span>*Lce + <span class="num">0.9</span>*Ltv + <span class="num">1.0</span>*Lconf</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># 2-layer DSpark &gt; 5-layer DFlash</span>
<span class="cs-line cmt"># Sequential dependency beats parallel depth</span>
      </pre>
    </div>
    <!-- PANEL: sched -->
    <div class="cs-panel" id="panel-sched">
      <pre class="cs-pre">
<span class="cs-line cmt"># Confidence-scheduled verification</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Confidence head: one linear + sigmoid</span>
<span class="cs-line hl-c">c_k = <span class="fn">sigmoid</span>(w @ <span class="fn">concat</span>(H[k], W1[x[k-<span class="num">1</span>]]))</span>
<span class="cs-line hl-c"><span class="cmt"># supervised on analytical acceptance rate:</span></span>
<span class="cs-line hl-c">c_star_k = <span class="num">1</span> - <span class="num">0.5</span> * ||p_draft_k - p_target_k||_1</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Sequential Temperature Scaling (STS)</span>
<span class="cs-line cmt"># calibrate positions left-to-right:</span>
<span class="cs-line hl-p"><span class="kw">for</span> k <span class="kw">in</span> <span class="fn">range</span>(<span class="num">1</span>, gamma+<span class="num">1</span>):</span>
<span class="cs-line hl-p">    <span class="cmt"># optimize T_k minimizing ECE of</span></span>
<span class="cs-line hl-p">    <span class="cmt"># cumulative product ∏_&#123;i≤k&#125; c_i^&#123;1/T_i&#125;</span></span>
<span class="cs-line hl-p">    T_k = <span class="fn">optimize_temperature</span>(k, val_set)</span>
<span class="cs-line hl-p">    <span class="cmt"># ECE reduced from 3-8% → ~1%</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Hardware-aware prefix scheduler</span>
<span class="cs-line cmt"># Maximize: E[accepted] / GPU-cost(verify ℓ)</span>
<span class="cs-line hl-g"><span class="kw">def</span> <span class="fn">select_prefix</span>(confidence, SPS_curve):</span>
<span class="cs-line hl-g">    <span class="cmt"># survival probs: ∏_&#123;i≤k&#125; c_i</span></span>
<span class="cs-line hl-g">    surv = <span class="fn">cumprod</span>(confidence)  <span class="cmt"># [γ]</span></span>
<span class="cs-line hl-g">    <span class="cmt"># expected accepted length</span></span>
<span class="cs-line hl-g">    tau = <span class="fn">sum</span>(surv[:<span class="num">k</span>]) + <span class="num">1</span>  <span class="cmt"># for prefix k</span></span>
<span class="cs-line hl-g">    <span class="cmt"># maximize τ * SPS(B + k) / SPS(B)</span></span>
<span class="cs-line hl-g">    <span class="cmt"># where B = current batch tokens</span></span>
<span class="cs-line hl-g">    ell_star = <span class="fn">argmax_k</span>(tau_k * sps_ratio)</span>
<span class="cs-line hl-g">    <span class="kw">return</span> ell_star</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Chat domain threshold sweep:</span>
<span class="cs-line cmt"># threshold 0.0 → accept 45.7%</span>
<span class="cs-line cmt"># threshold 0.5 → accept 75.2%</span>
<span class="cs-line cmt"># threshold 0.7 → accept 95.7%</span>
<span class="cs-line cmt"># Math domain: 76.9% → 92.5%</span>
<span class="cs-line cmt"># Code domain: 67.6% → 92.0%</span>
      </pre>
    </div>
    <!-- PANEL: poswise -->
    <div class="cs-panel" id="panel-poswise">
      <pre class="cs-pre">
<span class="cs-line cmt"># Position-wise conditional acceptance</span>
<span class="cs-line cmt"># Qwen3-4B, empirical from rollouts</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Chat domain — positions 1 to 7</span>
<span class="cs-line cmt">#               Pos1   Pos4   Pos7</span>
<span class="cs-line hl-a">Eagle3_chat = [<span class="num">0.53</span>, <span class="num">0.64</span>, <span class="num">0.74</span>]  <span class="cmt"># rising ↑</span></span>
<span class="cs-line hl-c">DFlash_chat = [<span class="num">0.72</span>, <span class="num">0.68</span>, <span class="num">0.63</span>]  <span class="cmt"># decay ↓</span></span>
<span class="cs-line hl-g">DSpark_chat = [<span class="num">0.88</span>, <span class="num">0.86</span>, <span class="num">0.85</span>]  <span class="cmt"># stable →</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Math domain (higher overall)</span>
<span class="cs-line hl-a">Eagle3_math = [<span class="num">0.81</span>, <span class="num">0.84</span>, <span class="num">0.85</span>]  <span class="cmt"># stable</span></span>
<span class="cs-line hl-c">DFlash_math = [<span class="num">0.88</span>, <span class="num">0.84</span>, <span class="num">0.78</span>]  <span class="cmt"># decay</span></span>
<span class="cs-line hl-g">DSpark_math = [<span class="num">0.93</span>, <span class="num">0.91</span>, <span class="num">0.89</span>]  <span class="cmt"># high+stable</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Why Eagle3 rises on chat:</span>
<span class="cs-line cmt"># AR conditioning on prior tokens →</span>

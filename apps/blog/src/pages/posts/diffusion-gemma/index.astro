<span class="cs-line cmt"># Autoregressive generation — the sequential bottleneck</span>
<span class="cs-line cmt"># Each token needs its own GPU forward pass.</span>
<span class="cs-line cmt"># GPU utilization ≈ 5–10% at batch_size=1</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">ar_generate</span>(model, prompt, max_tokens):</span>
<span class="cs-line">    tokens = prompt</span>
<span class="cs-line">    <span class="kw">for</span> _ <span class="kw">in</span> range(max_tokens):</span>
<span class="cs-line hl-c">        <span class="cmt"># One forward pass per token — memory-bandwidth bound</span></span>
<span class="cs-line hl-c">        <span class="cmt"># Loads ALL model weights for just ONE output token</span></span>
<span class="cs-line">        logits = model(tokens)  <span class="cmt"># expensive: loads ~18GB weights</span></span>
<span class="cs-line">        next_tok = sample(logits[-<span class="num">1</span>])  <span class="cmt"># use only last logit</span></span>
<span class="cs-line">        tokens = tokens + [next_tok]</span>
<span class="cs-line">        <span class="kw">if</span> next_tok == EOS: <span class="kw">break</span></span>
<span class="cs-line">    <span class="kw">return</span> tokens</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Why this is slow:</span>
<span class="cs-line cmt">#  - Weights (18GB) must be read from HBM each step</span>
<span class="cs-line cmt">#  - At batch=1, only 1 output used per weight load</span>
<span class="cs-line cmt">#  - FLOP/byte ratio ≈ 0.01 (ideal compute GPU: 100+)</span>
<span class="cs-line cmt">#  - H100 can do 3.35TB/s HBM bandwidth → ~275 tok/s</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># DiffusionGemma solution:</span>
<span class="cs-line hl-g"><span class="cmt"># Generate 256 tokens per forward pass instead of 1</span></span>
<span class="cs-line hl-g"><span class="cmt"># FLOP/byte ratio jumps → compute-bound → GPU maxed</span></span>
<span class="cs-line hl-g"><span class="cmt"># Result: 1,100+ tok/s on H100 (4× speedup)</span></span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-diffusion">
      <pre class="cs-pre">
<span class="cs-line cmt"># Discrete diffusion for text: mask → denoise</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Forward process: add noise (masking)</span>
<span class="cs-line hl-c"><span class="kw">def</span> <span class="fn">forward_mask</span>(tokens, t, T):</span>
<span class="cs-line hl-c">    <span class="cmt"># mask probability increases with t</span></span>
<span class="cs-line">    mask_prob = t / T  <span class="cmt"># 0 at t=0, 1 at t=T</span></span>
<span class="cs-line">    masked = []</span>
<span class="cs-line">    <span class="kw">for</span> tok <span class="kw">in</span> tokens:</span>
<span class="cs-line">        <span class="kw">if</span> rand() &lt; mask_prob:</span>
<span class="cs-line">            masked.append(MASK_ID)  <span class="cmt"># token replaced</span></span>
<span class="cs-line">        <span class="kw">else</span>:</span>
<span class="cs-line">            masked.append(tok)  <span class="cmt"># kept</span></span>
<span class="cs-line">    <span class="kw">return</span> masked</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Reverse process: denoise (learned)</span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">denoise_step</span>(model, masked_tokens, kv_cache):</span>
<span class="cs-line hl-p">    <span class="cmt"># Bidirectional attention — can see future tokens!</span></span>
<span class="cs-line">    logits = model(masked_tokens, kv_cache,</span>
<span class="cs-line">                   attention=<span class="str">"bidirectional"</span>)</span>
<span class="cs-line">    <span class="cmt"># predict distribution at every masked position</span></span>
<span class="cs-line">    preds = softmax(logits)  <span class="cmt"># shape: [256, vocab_size]</span></span>
<span class="cs-line">    <span class="kw">return</span> preds</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Key difference from AR:</span>
<span class="cs-line hl-g"><span class="cmt"># AR: sees only LEFT context when predicting token i</span></span>
<span class="cs-line hl-g"><span class="cmt"># Diffusion: sees LEFT + RIGHT context simultaneously</span></span>
<span class="cs-line hl-g"><span class="cmt"># → infilling, constraints, and long-range deps easier</span></span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-arch">
      <pre class="cs-pre">
<span class="cs-line cmt"># Block-autoregressive multi-canvas generation</span>
<span class="cs-line cmt"># from transformers import DiffusionGemmaForBlockDiffusion</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">canvas_generate</span>(model, prompt, max_canvases=<span class="num">10</span>):</span>
<span class="cs-line">    <span class="cmt"># Step 1: Encoder prefill</span></span>
<span class="cs-line hl-c">    kv = model.encoder(prompt_tokens)</span>
<span class="cs-line">    output = []</span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="kw">for</span> canvas_idx <span class="kw">in</span> range(max_canvases):</span>
<span class="cs-line">        <span class="cmt"># Step 2: Init canvas with [MASK]</span></span>
<span class="cs-line">        canvas = [MASK_ID] * <span class="num">256</span></span>
<span class="cs-line"> </span>
<span class="cs-line">        <span class="cmt"># Step 3: EB denoising loop</span></span>
<span class="cs-line">        <span class="kw">for</span> step <span class="kw">in</span> range(<span class="num">48</span>):  <span class="cmt"># max 48 steps</span></span>
<span class="cs-line hl-p">            canvas = eb_denoise_step(model, canvas, kv)</span>
<span class="cs-line">            <span class="kw">if</span> early_stop(canvas): <span class="kw">break</span></span>
<span class="cs-line"> </span>
<span class="cs-line">        <span class="cmt"># Step 4: Append canvas to KV cache</span></span>
<span class="cs-line hl-g">        kv = kv + model.encoder(canvas)</span>
<span class="cs-line">        output.extend(canvas)</span>
<span class="cs-line"> </span>
<span class="cs-line">        <span class="cmt"># Step 5: Check for EOS</span></span>
<span class="cs-line">        <span class="kw">if</span> EOS_ID <span class="kw">in</span> canvas: <span class="kw">break</span></span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="kw">return</span> output</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Model spec:</span>
<span class="cs-line cmt">#   Total params: 25.2B MoE</span>
<span class="cs-line cmt">#   Active params: 3.8B (8/128 experts)</span>
<span class="cs-line cmt">#   Canvas size: 256 tokens (bidirectional)</span>
<span class="cs-line cmt">#   Context: 256K tokens (KV cache)</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-eb">
      <pre class="cs-pre">
<span class="cs-line cmt"># Entropy-Bounded (EB) denoising step</span>
<span class="cs-line cmt"># Locks low-entropy tokens; re-masks high-entropy ones</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">eb_denoise_step</span>(model, canvas, kv, step, max_steps=<span class="num">48</span>):</span>
<span class="cs-line">    <span class="cmt"># Temperature decays linearly: 0.8 → 0.4</span></span>
<span class="cs-line">    tau = <span class="num">0.8</span> - (<span class="num">0.4</span> * step / max_steps)</span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="cmt"># Forward pass: predict all 256 positions at once</span></span>
<span class="cs-line">    logits = model(canvas, kv, attn=<span class="str">"bidirectional"</span>)</span>
<span class="cs-line">    probs = softmax(logits / tau)  <span class="cmt"># [256, vocab_size]</span></span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="cmt"># Compute entropy for each masked position</span></span>
<span class="cs-line hl-c">    entropy = -sum(p * log(p) for p in probs)  <span class="cmt"># [256]</span></span>
<span class="cs-line"> </span>
<span class="cs-line">    new_canvas = canvas.copy()</span>
<span class="cs-line">    <span class="kw">for</span> i, (tok, H) <span class="kw">in</span> enumerate(zip(canvas, entropy)):</span>
<span class="cs-line hl-g">        <span class="kw">if</span> tok == MASK_ID:  <span class="cmt"># only update masked positions</span></span>
<span class="cs-line hl-g">            <span class="kw">if</span> H &lt; <span class="num">0.1</span>:  <span class="cmt"># entropy bound ε = 0.1</span></span>
<span class="cs-line hl-g">                new_canvas[i] = argmax(probs[i])  <span class="cmt"># LOCK</span></span>
<span class="cs-line">            <span class="kw">else</span>:</span>
<span class="cs-line">                new_canvas[i] = MASK_ID  <span class="cmt"># re-mask</span></span>
<span class="cs-line">    <span class="kw">return</span> new_canvas</span>
<span class="cs-line"> </span>
<span class="cs-line hl-a"><span class="kw">def</span> <span class="fn">early_stop</span>(canvas, prev_canvas):</span>
<span class="cs-line hl-a">    avg_H = mean_entropy(canvas)</span>
<span class="cs-line hl-a">    stable = (canvas == prev_canvas)</span>
<span class="cs-line hl-a">    <span class="kw">return</span> avg_H &lt; <span class="num">0.005</span> <span class="kw">and</span> stable</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Effective throughput: 15–20 tokens committed/step</span>
<span class="cs-line cmt"># Simple tasks (structured code): fewer steps → faster</span>
<span class="cs-line cmt"># Hard tasks (ambiguous text): all 48 steps used</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-results">
      <pre class="cs-pre">
<span class="cs-line cmt"># DiffusionGemma vs Gemma 4 — benchmark comparison</span>
<span class="cs-line cmt"># EB sampler, instruction-tuned models</span>
<span class="cs-line"> </span>

<script>
// ─── TOC + sidebar toggles ───────────────────────────────────────────────
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});
const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ─── Code sidebar tab switching ─────────────────────────────────────────
const tabMeta = {
  bottleneck: { file: 'diffusion_gemma/bottleneck.py',   title: 'The Sequential Bottleneck' },
  diffusion:  { file: 'diffusion_gemma/discrete_diff.py', title: 'Discrete Diffusion for Text' },
  arch:       { file: 'diffusion_gemma/architecture.py',  title: 'Canvas Architecture' },
  eb:         { file: 'diffusion_gemma/eb_denoise.py',    title: 'Entropy-Bounded Denoising' },
  results:    { file: 'diffusion_gemma/benchmarks.py',    title: 'Benchmarks & Trade-offs' },
  usecases:   { file: 'diffusion_gemma/usage.py',         title: 'When Diffusion Wins' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ─── IntersectionObserver — sync TOC + sidebar tab ──────────────────────
const sectionMap = {
  's-bottleneck': 'bottleneck',
  's-diffusion':  'diffusion',
  's-arch':       'arch',
  's-eb':         'eb',
  's-results':    'results',
  's-usecases':   'usecases',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.25 }).observe(s)
);

// ─── Canvas 1: AR vs Diffusion throughput animation ─────────────────────
(function() {
  const canvas = document.getElementById('cv-ar');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 220;
  canvas.width = W * DPR; canvas.height = H * DPR;
  const ctx = canvas.getContext('2d');
  ctx.scale(DPR, DPR);

  const N = 16; // tokens per row
  const cellW = (W - 80) / N;
  const cellH = 28;
  const padX = 40, rowY1 = 40, rowY2 = 120;

  let arStep = 0, diffStep = 0;
  let animId = null, playing = false;
  let diffPassTokens = []; // which tokens are lit per pass

  function initDiffPass() {
    // Diffusion: 3 passes. Each pass lights up many tokens at once
    diffPassTokens = [
      Array.from({length: 16}, (_, i) => i < 8 ? 0.3 : 0), // pass 0: partial
      Array.from({length: 16}, (_, i) => i < 14 ? 0.7 : 0), // pass 1: most
      Array.from({length: 16}, () => 1.0), // pass 2: all
    ];
  }
  initDiffPass();

  function draw(arS, diffS) {
    ctx.clearRect(0, 0, W, H);

    // Row labels
    ctx.font = `600 11px var(--ff-mono, monospace)`;
    ctx.fillStyle = 'rgba(107,114,128,.9)';
    ctx.fillText('Autoregressive', padX, rowY1 - 12);
    ctx.fillText('Diffusion (canvas)', padX, rowY2 - 12);

    // AR: sequential token cells
    for (let i = 0; i < N; i++) {
      const x = padX + i * cellW;
      const lit = i < arS;
      const isCurrent = i === arS - 1;
      ctx.fillStyle = lit
        ? (isCurrent ? 'rgba(139,92,246,.95)' : 'rgba(139,92,246,.35)')
        : 'rgba(55,65,81,.5)';
      ctx.beginPath();
      roundRect(ctx, x + 2, rowY1, cellW - 4, cellH, 4);
      ctx.fill();
      if (isCurrent) {
        ctx.shadowColor = '#8b5cf6';
        ctx.shadowBlur = 12;
        ctx.fill();
        ctx.shadowBlur = 0;
      }
    }

    // AR GPU bar (low)
    const arUtil = Math.min(arS / N, 1) * 0.1; // max 10%
    drawGpuBar(ctx, W - 30, rowY1, 16, cellH, arUtil, '#8b5cf6');

    // Diffusion: 3 passes (each pass lights up multiple tokens simultaneously)
    const passIdx = Math.min(Math.floor(diffS / (N / 3)), 2);
    const passProgress = diffS > 0 ? (diffS % (N / 3)) / (N / 3) : 0;
    const passAlpha = diffPassTokens[Math.min(passIdx, 2)];

    for (let i = 0; i < N; i++) {
      const x = padX + i * cellW;
      const alpha = diffS >= N ? 1.0 : passAlpha[i] * Math.min(diffS / (N / 3), 1);
      const locked = diffS >= N / 2;
      ctx.fillStyle = locked && alpha > 0.5
        ? `rgba(16,185,129,${alpha * 0.9})`
        : alpha > 0
          ? `rgba(6,182,212,${alpha * 0.8})`
          : 'rgba(55,65,81,.5)';
      ctx.beginPath();
      roundRect(ctx, x + 2, rowY2, cellW - 4, cellH, 4);
      ctx.fill();
      if (alpha > 0.5 && diffS < N) {
        ctx.shadowColor = '#06b6d4';
        ctx.shadowBlur = 8;
        ctx.fill();
        ctx.shadowBlur = 0;
      }
    }

    // Diffusion GPU bar (high)
    const diffUtil = diffS > 0 ? Math.min(diffS / N, 1) * 0.95 : 0;
    drawGpuBar(ctx, W - 30, rowY2, 16, cellH, diffUtil, '#10b981');

    // GPU label
    ctx.font = '9px monospace';
    ctx.fillStyle = 'rgba(107,114,128,.7)';
    ctx.save(); ctx.translate(W - 22, rowY1 - 14); ctx.fillText('GPU util', 0, 0); ctx.restore();

    // Step labels
    ctx.font = '10px monospace';
    ctx.fillStyle = 'rgba(107,114,128,.7)';
    ctx.fillText(`tokens: ${Math.min(arS, N)}/16  (${arS} passes)`, padX, rowY1 + cellH + 18);
    const diffPasses = diffS >= N ? 3 : (passIdx + 1);
    ctx.fillText(`tokens: ${Math.min(diffS, N)}/16  (${diffPasses} passes)`, padX, rowY2 + cellH + 18);
  }

  function drawGpuBar(ctx, x, y, w, h, frac, color) {
    ctx.fillStyle = 'rgba(55,65,81,.4)';
    roundRect(ctx, x, y, w, h, 3); ctx.fill();
    const fillH = h * frac;
    ctx.fillStyle = color;
    ctx.globalAlpha = 0.8;
    roundRect(ctx, x, y + h - fillH, w, fillH, 3); ctx.fill();
    ctx.globalAlpha = 1;
  }

  function roundRect(ctx, x, y, w, h, r) {
    ctx.beginPath();
    ctx.moveTo(x + r, y);
    ctx.lineTo(x + w - r, y);
    ctx.arcTo(x + w, y, x + w, y + r, r);
    ctx.lineTo(x + w, y + h - r);
    ctx.arcTo(x + w, y + h, x + w - r, y + h, r);
    ctx.lineTo(x + r, y + h);
    ctx.arcTo(x, y + h, x, y + h - r, r);
    ctx.lineTo(x, y + r);
    ctx.arcTo(x, y, x + r, y, r);
    ctx.closePath();
  }

  draw(0, 0);

  let frame = 0;
  function animate() {
    if (!playing) return;
    frame++;
    if (frame % 12 === 0) {
      arStep = Math.min(arStep + 1, N);
      // Diffusion: each "step" advances 5 tokens at once
      diffStep = Math.min(diffStep + 5, N);
      document.getElementById('ar-step-label').textContent =
        `Step: ${arStep} / ${N}`;
    }
    draw(arStep, diffStep);
    if (arStep < N) animId = requestAnimationFrame(animate);
    else { playing = false; document.getElementById('ar-play').textContent = '▶ Play'; }
  }

  document.getElementById('ar-play').addEventListener('click', () => {
    if (playing) { playing = false; cancelAnimationFrame(animId); document.getElementById('ar-play').textContent = '▶ Play'; }
    else { if (arStep >= N) { arStep = 0; diffStep = 0; } playing = true; document.getElementById('ar-play').textContent = '⏸ Pause'; animate(); }
  });
  document.getElementById('ar-reset').addEventListener('click', () => {
    playing = false; cancelAnimationFrame(animId);
    arStep = 0; diffStep = 0; frame = 0;
    document.getElementById('ar-step-label').textContent = 'Step: 0 / 16';
    document.getElementById('ar-play').textContent = '▶ Play';
    draw(0, 0);
  });
})();

// ─── Canvas 2: Discrete diffusion denoising ─────────────────────────────
(function() {
  const canvas = document.getElementById('cv-denoise');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 180;
  canvas.width = W * DPR; canvas.height = H * DPR;
  const ctx = canvas.getContext('2d');
  ctx.scale(DPR, DPR);

  // Sentence to denoise: 18 tokens
  const TOKENS = ['The','capital','of','France','is','Paris','and','the',
                  'Eiffel','Tower','stands','at','330','metres','tall','.','<EOS>',''];
  // How many steps until each token resolves (0-indexed, 8 total steps)
  const LOCK_STEP = [0,2,0,1,0,1,3,0,2,3,4,0,5,4,5,1,7,8];
  const STEPS = 8;

  let curStep = 0, animId = null, playing = false;

  function drawDenoising(step) {
    ctx.clearRect(0, 0, W, H);
    const totalTokens = TOKENS.length - 1;
    const cellW = Math.min((W - 24) / 9, 70);
    const cellH = 28;
    const rows = 2;
    const tokensPerRow = 9;

    for (let i = 0; i < totalTokens; i++) {
      const row = Math.floor(i / tokensPerRow);
      const col = i % tokensPerRow;
      const x = 12 + col * cellW;
      const y = 24 + row * (cellH + 20);
      const locked = step >= LOCK_STEP[i];

      if (locked) {
        ctx.fillStyle = 'rgba(16,185,129,.2)';
        ctx.strokeStyle = 'rgba(16,185,129,.6)';
      } else if (step > 0 && LOCK_STEP[i] <= step + 2) {
        ctx.fillStyle = 'rgba(245,158,11,.12)';
        ctx.strokeStyle = 'rgba(245,158,11,.5)';
      } else {
        ctx.fillStyle = 'rgba(55,65,81,.3)';
        ctx.strokeStyle = 'rgba(107,114,128,.3)';
      }

      ctx.lineWidth = 1.5;
      ctx.beginPath();
      roundRect2(ctx, x, y, cellW - 4, cellH, 4);
      ctx.fill(); ctx.stroke();

      ctx.font = `${locked ? '600' : '500'} 10px var(--ff-mono, monospace)`;
      ctx.textAlign = 'center';
      if (locked) {
        ctx.fillStyle = '#10b981';
        ctx.fillText(TOKENS[i], x + (cellW - 4) / 2, y + 18);
      } else {
        ctx.fillStyle = step > 0 && LOCK_STEP[i] <= step + 2 ? '#f59e0b' : 'rgba(107,114,128,.6)';
        ctx.fillText('[MASK]', x + (cellW - 4) / 2, y + 18);
      }
      ctx.textAlign = 'left';
    }

    // Step label
    ctx.font = '10px monospace';
    ctx.fillStyle = 'rgba(107,114,128,.7)';
    ctx.fillText(`Denoising step ${step} / ${STEPS} — ${countLocked(step)} / ${totalTokens} tokens resolved`, 12, H - 8);
  }

  function countLocked(step) {
    return LOCK_STEP.slice(0, TOKENS.length - 1).filter(s => step >= s).length;
  }

  function roundRect2(ctx, x, y, w, h, r) {
    ctx.beginPath();
    ctx.moveTo(x + r, y); ctx.lineTo(x + w - r, y);
    ctx.arcTo(x + w, y, x + w, y + r, r); ctx.lineTo(x + w, y + h - r);
    ctx.arcTo(x + w, y + h, x + w - r, y + h, r); ctx.lineTo(x + r, y + h);
    ctx.arcTo(x, y + h, x, y + h - r, r); ctx.lineTo(x, y + r);
    ctx.arcTo(x, y, x + r, y, r); ctx.closePath();
  }

  drawDenoising(0);

  let frame2 = 0;
  function animate2() {
    if (!playing) return;
    frame2++;
    if (frame2 % 28 === 0) {
      curStep = Math.min(curStep + 1, STEPS);
      document.getElementById('dn-step-label').textContent = `Step: ${curStep} / ${STEPS}`;
    }
    drawDenoising(curStep);
    if (curStep < STEPS) animId = requestAnimationFrame(animate2);
    else { playing = false; document.getElementById('dn-play').textContent = '▶ Play'; }
  }

  document.getElementById('dn-play').addEventListener('click', () => {
    if (playing) { playing = false; cancelAnimationFrame(animId); document.getElementById('dn-play').textContent = '▶ Play'; }
    else { if (curStep >= STEPS) { curStep = 0; } playing = true; document.getElementById('dn-play').textContent = '⏸ Pause'; animate2(); }
  });
  document.getElementById('dn-reset').addEventListener('click', () => {
    playing = false; cancelAnimationFrame(animId); curStep = 0; frame2 = 0;
    document.getElementById('dn-step-label').textContent = 'Step: 0 / 8';
    document.getElementById('dn-play').textContent = '▶ Play';
    drawDenoising(0);
  });
})();

// ─── Canvas 3: Entropy-Bounded denoising grid ────────────────────────────
(function() {
  const canvas = document.getElementById('cv-eb');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 220;
  canvas.width = W * DPR; canvas.height = H * DPR;
  const ctx = canvas.getContext('2d');
  ctx.scale(DPR, DPR);

  // Seeded PRNG for reproducible lock-step values
  function seededRand(n) {
    return ((1664525 * n + 1013904223) & 0x7fffffff) / 0x7fffffff;
  }

  const COLS = 16, ROWS = 16, N = 256;
  // Assign each token a "lock step" — the denoising step at which it locks
  // Low-entropy tokens lock early (step 1–8), high-entropy tokens lock later (step 20–48)
  // Use a biased distribution: most tokens lock before step 20
  const lockSteps = Array.from({length: N}, (_, i) => {
    const r = seededRand(i * 7 + 3);
    // Distribution: 40% lock in steps 1-8, 35% in 8-20, 25% in 20-48
    if (r < 0.4) return Math.floor(seededRand(i) * 8) + 1;
    if (r < 0.75) return Math.floor(seededRand(i + 300) * 12) + 8;
    return Math.floor(seededRand(i + 700) * 28) + 20;
  });

  function drawGrid(step) {
    ctx.clearRect(0, 0, W, H);
    const cellSize = Math.min((W - 16) / COLS, (H - 30) / ROWS);
    const offX = (W - cellSize * COLS) / 2;
    const offY = 14;

    let locked = 0, uncertain = 0;

    for (let i = 0; i < N; i++) {
      const row = Math.floor(i / COLS);
      const col = i % COLS;
      const x = offX + col * cellSize;
      const y = offY + row * cellSize;
      const isLocked = step >= lockSteps[i];
      const isNearLock = !isLocked && lockSteps[i] <= step + 6;
      const r = cellSize * 0.38;

      if (isLocked) {
        locked++;
        ctx.fillStyle = 'rgba(16,185,129,.75)';
        ctx.shadowColor = '#10b981';
        ctx.shadowBlur = 4;
      } else if (isNearLock) {
        uncertain++;
        ctx.fillStyle = 'rgba(245,158,11,.65)';
        ctx.shadowBlur = 0;
      } else {
        ctx.fillStyle = 'rgba(55,65,81,.5)';
        ctx.shadowBlur = 0;
      }

      ctx.beginPath();
      ctx.arc(x + cellSize / 2, y + cellSize / 2, r, 0, Math.PI * 2);
      ctx.fill();
      ctx.shadowBlur = 0;
    }

    // Stats
    ctx.font = '10px monospace';
    ctx.fillStyle = 'rgba(107,114,128,.8)';
    const statsY = offY + ROWS * cellSize + 16;
    ctx.fillStyle = '#10b981';
    ctx.fillText(`● locked: ${locked}`, offX, statsY);
    ctx.fillStyle = '#f59e0b';
    ctx.fillText(`● uncertain: ${uncertain}`, offX + 100, statsY);
    ctx.fillStyle = 'rgba(107,114,128,.7)';
    ctx.fillText(`○ masked: ${N - locked - uncertain}`, offX + 210, statsY);
  }

  const slider = document.getElementById('eb-slider');
  const disp   = document.getElementById('eb-step-disp');

  drawGrid(0);

  slider?.addEventListener('input', () => {
    const v = parseInt(slider.value);
    disp.textContent = `t = ${v}`;
    drawGrid(v);
  });
})();

// ─── Architecture step navigator ────────────────────────────────────────
(function() {
  let archStep = 0;
  const boxes  = document.querySelectorAll('#arch-steps .step-box');
  const prevBtn = document.getElementById('arch-prev');
  const nextBtn = document.getElementById('arch-next');
  const progEl  = document.getElementById('arch-prog');

  function updateArchSteps() {
    boxes.forEach((b, i) => {
      b.classList.remove('active','done');
      if (i === archStep) b.classList.add('active');
      else if (i < archStep) b.classList.add('done');
    });
    if (prevBtn) prevBtn.disabled = archStep === 0;
    if (nextBtn) nextBtn.disabled = archStep === boxes.length - 1;
    if (progEl) progEl.textContent = `Step ${archStep + 1} of ${boxes.length}`;
    boxes.forEach((b, i) => {
      const n = b.querySelector('.step-num');
      if (n) n.textContent = i < archStep ? '✓' : String(i + 1);
    });
  }

  prevBtn?.addEventListener('click', () => { if (archStep > 0) { archStep--; updateArchSteps(); } });
  nextBtn?.addEventListener('click', () => { if (archStep < boxes.length - 1) { archStep++; updateArchSteps(); } });
  updateArchSteps();
})();

// ─── Animated bar chart (IntersectionObserver) ───────────────────────────
const barsSection = document.getElementById('s-results');
if (barsSection) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          b.style.width = parseFloat(b.dataset.w) + '%';
        });
      }
    });
  }, { threshold: 0.3 }).observe(barsSection);
}
</script>
</BaseLayout>

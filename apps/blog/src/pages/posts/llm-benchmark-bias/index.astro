<span class="cs-line"> </span>
<span class="cs-line cmt"># Multi-process fix: k isolated processes</span>
<span class="cs-line cmt"># each process sees only λ/k arrivals</span>
<span class="cs-line hl-g">  ρ_k = λ / (k · μ)  ≪ 1</span>
<span class="cs-line hl-g">  W_q ≈ 0  (queue never builds)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Concrete: 1,000 QPS × 200 output tokens</span>
<span class="cs-line cmt"># = 200,000 token events/s</span>
<span class="cs-line cmt"># If μ = 200,100:  ρ = 0.999</span>
<span class="cs-line cmt"># With k=144 processes: ρ_k = 0.0069</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-fix">
      <pre class="cs-pre">
<span class="cs-line cmt"># Inference Perf multi-process architecture</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Orchestration layer:</span>
<span class="cs-line hl-c"><span class="kw">class</span> <span class="cls">LoadGenerator</span>:</span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">run</span>(<span class="kw">self</span>, target_qps, m_workers):</span>
<span class="cs-line">        workers = [</span>
<span class="cs-line">            <span class="fn">spawn_process</span>(<span class="cls">Worker</span>)</span>
<span class="cs-line">            <span class="kw">for</span> _ <span class="kw">in</span> <span class="fn">range</span>(m_workers)</span>
<span class="cs-line">        ]</span>
<span class="cs-line">        <span class="cmt"># Poisson or constant arrival</span></span>
<span class="cs-line">        <span class="kw">for</span> req <span class="kw">in</span> <span class="fn">arrival_stream</span>(target_qps):</span>
<span class="cs-line">            queue.<span class="fn">put</span>(req)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Each worker: own event loop, own GIL</span>
<span class="cs-line hl-g"><span class="kw">class</span> <span class="cls">Worker</span>:</span>
<span class="cs-line">    <span class="kw">async</span> <span class="kw">def</span> <span class="fn">run</span>(<span class="kw">self</span>, max_concurrency):</span>
<span class="cs-line">        <span class="kw">while</span> <span class="kw">True</span>:</span>
<span class="cs-line">            req = <span class="kw">await</span> queue.<span class="fn">get</span>()</span>
<span class="cs-line">            <span class="kw">await</span> <span class="fn">send_and_record</span>(req)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Fidelity metrics reported per run:</span>
<span class="cs-line cmt"># scheduling_precision_p99 &lt; 1ms</span>
<span class="cs-line cmt"># dispatch_throughput == target_qps</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-ntpot">
      <pre class="cs-pre">
<span class="cs-line cmt"># NTPOT — Normalized Time Per Output Token</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Basic form:</span>
<span class="cs-line hl-c">  NTPOT_i = L_i / N_i</span>
<span class="cs-line">  <span class="cmt"># L_i = end-to-end latency (ms)</span></span>
<span class="cs-line">  <span class="cmt"># N_i = output tokens generated</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Expanded form (all 3 serving phases):</span>
<span class="cs-line hl-p">  NTPOT_i = (T_queue</span>
<span class="cs-line hl-p">           + I_i * T_prefill</span>
<span class="cs-line hl-p">           + N_i * T_decode) / N_i</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Why TPOT alone is misleading:</span>
<span class="cs-line cmt"># TPOT only measures T_decode phase</span>
<span class="cs-line cmt"># → stays flat even as queue saturates</span>
<span class="cs-line hl-a">  NTPOT spikes when T_queue grows</span>
<span class="cs-line hl-a">  → immediately reveals saturation</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># RAG normalization:</span>
<span class="cs-line cmt"># 10k-token prefix → large I_i*T_prefill</span>
<span class="cs-line cmt"># but divided by N_i output tokens</span>
<span class="cs-line cmt"># → reflects true per-output-token cost</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Production metric: E[NTPOT] + var</span>
<span class="cs-line cmt"># p99 NTPOT spike = SLO violation signal</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-results">
      <pre class="cs-pre">
<span class="cs-line cmt"># Empirical validation — llm-d-inference-sim</span>
<span class="cs-line cmt"># (near-zero server latency; any reported</span>
<span class="cs-line cmt">#  latency = pure client overhead)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># TTFT overhead at 1,000 QPS:</span>
<span class="cs-line hl-a">  vLLM Bench:    58,000 ms  (58 seconds)</span>
<span class="cs-line">  Inference X:       8 ms</span>
<span class="cs-line hl-g">  Inference Perf:    0.63 ms  ✓</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># At 5,000 QPS:</span>
<span class="cs-line cmt">  vLLM Bench: TIMEOUT / excluded</span>
<span class="cs-line cmt">  Inference X: TIMEOUT / excluded</span>
<span class="cs-line cmt">  Locust:  1,634 QPS (cap)</span>
<span class="cs-line cmt">  MLPerf:  1,944 QPS (GIL rebottleneck)</span>
<span class="cs-line cmt">  k6 (Go): 5,000 QPS ✓</span>
<span class="cs-line hl-g">  Inference Perf: 4,998 QPS ✓</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># 5,000 QPS token throughput:</span>
<span class="cs-line hl-g">  Inference Perf: 2,600,000 tokens</span>
<span class="cs-line">  AI Perf (next best): ~2,100,000 (24% less)</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-pitfalls">
      <pre class="cs-pre">
<span class="cs-line cmt"># Three reproducibility anti-patterns</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># 1. Temperature inflates throughput</span>
<span class="cs-line cmt">#    1,000 requests, same hardware:</span>
<span class="cs-line hl-a">  Temp=0   (greedy):  6,767 tok/s</span>
<span class="cs-line hl-g">  Temp=0.7 (real):    5,573 tok/s</span>
<span class="cs-line">  <span class="cmt"># 21% variance from one param</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># 2. Dataset processing discrepancy</span>
<span class="cs-line cmt">#    ShareGPT, 3000 req @ 10 QPS:</span>
<span class="cs-line hl-a">  Inference X:     702,412 input tokens</span>
<span class="cs-line hl-g">  Inference Perf: 1,052,100 input tokens</span>
<span class="cs-line">  <span class="cmt"># 50% discrepancy; not comparable</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># 3. Prefix caching invalidates TTFT</span>
<span class="cs-line cmt">#    cache hit ratio must be:</span>
<span class="cs-line cmt">#    - explicitly controlled (0/50/100%)</span>
<span class="cs-line cmt">#    - reported in every published result</span>
<span class="cs-line cmt">#    - consistent across compared runs</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Required in every benchmark config:</span>
<span class="cs-line hl-c">  temperature: 0.7      # not 0</span>
<span class="cs-line hl-c">  cache_hit_ratio: 0.0  # explicit</span>
<span class="cs-line hl-c">  max_prompt_tokens: N  # standardized</span>
      </pre>
    </div>

  </div>
</aside>

</div><!-- /post-grid -->

<script>
// ── TOC + sidebar toggles ──────────────────────────────────────────────────
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});
const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ── Code sidebar tab switching ────────────────────────────────────────────
const tabMeta = {
  problem:  { file: 'benchmark/client.py',    title: 'The Benchmark Trap' },
  queue:    { file: 'benchmark/queue_model.py', title: 'M/G/1 Queue Model' },
  fix:      { file: 'benchmark/inference_perf.py', title: 'Multi-Process Fix' },
  ntpot:    { file: 'benchmark/metrics.py',   title: 'NTPOT Metric' },
  results:  { file: 'benchmark/results.py',   title: 'Empirical Results' },
  pitfalls: { file: 'benchmark/config.py',    title: 'Reproducibility Pitfalls' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ── IntersectionObserver: sync TOC + sidebar tab ──────────────────────────
const sectionMap = {
  's-problem': 'problem',
  's-queue':   'queue',
  's-fix':     'fix',
  's-ntpot':   'ntpot',
  's-results': 'results',
  's-pitfalls':'pitfalls',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ── Animate bar charts on scroll ─────────────────────────────────────────
function observeBars(sectionId, barsId) {
  const sec = document.getElementById(sectionId);
  if (!sec) return;
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (!e.isIntersecting) return;
      document.querySelectorAll('#' + barsId + ' .bar-fill[data-w]').forEach(b => {
        b.style.width = parseFloat(b.dataset.w) + '%';
      });
      // Log-scale bars (latency inflation)
      document.querySelectorAll('#' + barsId + ' .bar-fill[data-log-w]').forEach(b => {
        const v = parseFloat(b.dataset.logW);
        const mx = parseFloat(b.dataset.logMax);
        const MIN_LOG = Math.log10(0.1);
        const MAX_LOG = Math.log10(mx);
        const pct = ((Math.log10(v) - MIN_LOG) / (MAX_LOG - MIN_LOG)) * 100;
        b.style.width = Math.max(3, pct) + '%';
      });
    });
  }, { threshold: 0.3 }).observe(sec);
}
observeBars('s-problem', 'rate-bars');
observeBars('s-results',  'latency-bars');
observeBars('s-pitfalls', 'temp-bars');

// ── Queue canvas: ρ vs W_q curve ──────────────────────────────────────────
(function() {
  const canvas = document.getElementById('queue-canvas');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 220;
  canvas.width = W * DPR; canvas.height = H * DPR;
  const ctx = canvas.getContext('2d');
  ctx.scale(DPR, DPR);

  const PAD = { l: 52, r: 24, t: 16, b: 36 };
  const CW = W - PAD.l - PAD.r;
  const CH = H - PAD.t - PAD.b;

  let currentRho = 0.85;

  function wq(rho) {
    // Normalized W_q = rho / (1 - rho), capped at display max
    return rho / (1 - rho);
  }

  const WQ_MAX = 25; // display cap

  function rhoToX(rho) { return PAD.l + (rho / 1.0) * CW; }
  function wqToY(w)    { return PAD.t + CH - Math.min(w, WQ_MAX) / WQ_MAX * CH; }

  function draw(rho) {
    ctx.clearRect(0, 0, W, H);

    // Grid lines
    ctx.strokeStyle = 'rgba(255,255,255,0.04)';
    ctx.lineWidth = 1;
    for (let i = 1; i <= 4; i++) {
      const y = PAD.t + (i / 5) * CH;
      ctx.beginPath(); ctx.moveTo(PAD.l, y); ctx.lineTo(W - PAD.r, y); ctx.stroke();
    }
    for (let i = 2; i <= 9; i++) {
      const x = rhoToX(i / 10);
      ctx.beginPath(); ctx.moveTo(x, PAD.t); ctx.lineTo(x, PAD.t + CH); ctx.stroke();
    }

    // W_q curve — gradient fill
    const grad = ctx.createLinearGradient(PAD.l, 0, W - PAD.r, 0);
    grad.addColorStop(0, 'rgba(16,185,129,0.6)');
    grad.addColorStop(0.6, 'rgba(245,158,11,0.6)');
    grad.addColorStop(0.85, 'rgba(224,108,117,0.8)');
    grad.addColorStop(1, 'rgba(224,108,117,0.9)');

    ctx.beginPath();
    const steps = 180;
    let first = true;
    for (let i = 0; i <= steps; i++) {
      const r = (i / steps) * 0.99;
      const x = rhoToX(r);
      const y = wqToY(wq(r));
      if (first) { ctx.moveTo(x, y); first = false; }
      else ctx.lineTo(x, y);
    }
    ctx.strokeStyle = grad;
    ctx.lineWidth = 2.5;
    ctx.stroke();

    // Axes
    ctx.strokeStyle = 'rgba(255,255,255,0.15)';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(PAD.l, PAD.t); ctx.lineTo(PAD.l, PAD.t + CH);
    ctx.moveTo(PAD.l, PAD.t + CH); ctx.lineTo(W - PAD.r, PAD.t + CH);
    ctx.stroke();

    // Axis labels
    ctx.fillStyle = '#5c6370';
    ctx.font = `${9 * DPR / DPR}px monospace`;
    ctx.textAlign = 'center';
    ctx.fillText('ρ (event loop utilization)', PAD.l + CW / 2, H - 4);
    ctx.save();
    ctx.translate(13, PAD.t + CH / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.fillText('W_q (wait time)', 0, 0);
    ctx.restore();

    // Tick labels on x
    [0.2, 0.4, 0.6, 0.8, 0.99].forEach(r => {
      ctx.textAlign = 'center';
      ctx.fillStyle = '#5c6370';
      ctx.fillText(r.toFixed(2), rhoToX(r), PAD.t + CH + 14);
    });

    // Current ρ marker
    const mx = rhoToX(rho);
    const myRaw = wq(rho);
    const my = wqToY(myRaw);
    ctx.beginPath();
    ctx.moveTo(mx, PAD.t + CH); ctx.lineTo(mx, my);
    ctx.strokeStyle = 'rgba(139,92,246,0.5)';
    ctx.lineWidth = 1;
    ctx.setLineDash([3, 3]);
    ctx.stroke();
    ctx.setLineDash([]);

    ctx.beginPath();
    ctx.arc(mx, Math.max(PAD.t + 4, my), 5, 0, Math.PI * 2);
    ctx.fillStyle = rho < 0.7 ? '#10b981' : rho < 0.9 ? '#f59e0b' : '#e06c75';
    ctx.fill();
    ctx.strokeStyle = '#fff';
    ctx.lineWidth = 1.5;
    ctx.stroke();

    // Label
    const labelW = myRaw >= WQ_MAX ? '→ ∞' : myRaw.toFixed(1) + '×';
    ctx.fillStyle = '#abb2bf';
    ctx.font = `bold ${10 * DPR / DPR}px monospace`;
    ctx.textAlign = mx > W - 120 ? 'right' : 'left';
    ctx.fillText('ρ=' + rho.toFixed(2) + '  W_q=' + labelW, mx + (mx > W - 120 ? -10 : 10), Math.max(PAD.t + 18, my - 10));

    // Update readout
    const qRho = document.getElementById('q-rho');
    const qWq = document.getElementById('q-wq');
    const qStatus = document.getElementById('q-status');
    if (qRho) qRho.textContent = rho.toFixed(2);
    if (qWq) {
      qWq.textContent = myRaw >= WQ_MAX ? '→ ∞' : myRaw.toFixed(1) + '×';
      qWq.className = 'queue-stat-value' + (rho < 0.7 ? ' ok' : rho < 0.9 ? ' warn' : ' danger');
    }
    if (qStatus) {
      qStatus.textContent = rho < 0.5 ? 'Healthy' : rho < 0.8 ? 'Moderate' : rho < 0.95 ? 'Degrading' : 'Near-Saturated';
      qStatus.className = 'queue-stat-value' + (rho < 0.7 ? ' ok' : rho < 0.9 ? ' warn' : ' danger');
    }
  }

  draw(currentRho);

  document.querySelectorAll('.rho-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      currentRho = parseFloat(btn.dataset.rho);
      document.querySelectorAll('.rho-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      draw(currentRho);
    });
  });
})();

// ── NTPOT canvas: TPOT vs NTPOT comparison ──────────────────────────────
(function() {
  const canvas = document.getElementById('ntpot-canvas');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 200;
  canvas.width = W * DPR; canvas.height = H * DPR;
  const ctx = canvas.getContext('2d');
  ctx.scale(DPR, DPR);

  const PAD = { l: 48, r: 16, t: 28, b: 36 };
  const CW = W - PAD.l - PAD.r;
  const CH = H - PAD.t - PAD.b;
  const N = 10;

  // Simulated data: load steps 0..N-1
  // TPOT: stays roughly flat (slight uptick)
  const tpot = [12, 12.5, 13, 13.2, 13.5, 14, 14.5, 15, 16, 17];
  // NTPOT: spikes as queue+prefill compound
  const ntpot = [13, 14, 15.5, 18, 22, 30, 44, 65, 95, 140];
  const maxV = 160;

  function xOf(i) { return PAD.l + (i / (N - 1)) * CW; }
  function yOf(v) { return PAD.t + CH - (v / maxV) * CH; }

  // Grid
  ctx.strokeStyle = 'rgba(255,255,255,0.04)';
  ctx.lineWidth = 1;
  for (let i = 1; i <= 4; i++) {
    const y = PAD.t + (i / 5) * CH;
    ctx.beginPath(); ctx.moveTo(PAD.l, y); ctx.lineTo(W - PAD.r, y); ctx.stroke();
  }

  // TPOT line (cyan, flat)
  ctx.beginPath();
  tpot.forEach((v, i) => i === 0 ? ctx.moveTo(xOf(i), yOf(v)) : ctx.lineTo(xOf(i), yOf(v)));
  ctx.strokeStyle = 'rgba(6,182,212,0.8)';
  ctx.lineWidth = 2;
  ctx.stroke();

  // NTPOT line (purple, spikes)
  ctx.beginPath();
  ntpot.forEach((v, i) => i === 0 ? ctx.moveTo(xOf(i), yOf(v)) : ctx.lineTo(xOf(i), yOf(v)));
  ctx.strokeStyle = 'rgba(139,92,246,0.9)';
  ctx.lineWidth = 2.5;
  ctx.stroke();

  // Saturation zone (right half)
  ctx.fillStyle = 'rgba(224,108,117,0.05)';
  ctx.fillRect(xOf(5), PAD.t, CW - (xOf(5) - PAD.l), CH);
  ctx.fillStyle = 'rgba(224,108,117,0.4)';
  ctx.font = `9px monospace`;
  ctx.textAlign = 'right';
  ctx.fillText('saturation zone', W - PAD.r - 4, PAD.t + 12);

  // Labels
  ctx.font = `bold 10px monospace`;
  ctx.fillStyle = 'rgba(6,182,212,0.9)';
  ctx.textAlign = 'left';
  ctx.fillText('TPOT (misleading — flat)', PAD.l + 6, yOf(tpot[2]) - 8);
  ctx.fillStyle = 'rgba(139,92,246,0.95)';
  ctx.fillText('NTPOT (reveals queue spike)', PAD.l + 6, yOf(ntpot[6]) - 8);

  // Axes
  ctx.strokeStyle = 'rgba(255,255,255,0.15)';
  ctx.lineWidth = 1;
  ctx.beginPath();
  ctx.moveTo(PAD.l, PAD.t); ctx.lineTo(PAD.l, PAD.t + CH);
  ctx.moveTo(PAD.l, PAD.t + CH); ctx.lineTo(W - PAD.r, PAD.t + CH);
  ctx.stroke();

  ctx.fillStyle = '#5c6370';
  ctx.font = `9px monospace`;
  ctx.textAlign = 'center';
  ctx.fillText('Increasing Load (QPS) →', PAD.l + CW / 2, H - 4);
  ctx.save();
  ctx.translate(13, PAD.t + CH / 2);
  ctx.rotate(-Math.PI / 2);
  ctx.fillText('Latency (ms)', 0, 0);
  ctx.restore();
})();
</script>
</BaseLayout>

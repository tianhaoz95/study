    <!-- Panel 2: Orthogonal -->
    <div class="cs-panel" id="panel-orthogonal">
      <pre class="cs-pre">
<span class="cs-line cmt"># Newton-Schulz quintic iteration for matrix orthogonalization</span>
<span class="cs-line kw">def</span> <span class="fn">newtonschulz5</span>(G, steps=<span class="num">5</span>, eps=<span class="num">1e-7</span>):
    <span class="cs-line cmt"># Coefficients to maximize slope at zero</span>
    a, b, c = <span class="num">3.4445</span>, <span class="num">-4.7750</span>, <span class="num">2.0315</span>
    
    X = G.bfloat16()
    X /= (X.norm() + eps)
    
    <span class="cs-line cmt"># Transpose if necessary to do smaller matrix multiply</span>
    <span class="cs-line hl-p"><span class="kw">if</span> G.size(<span class="num">0</span>) &gt; G.size(<span class="num">1</span>):</span>
        X = X.T
        
    <span class="cs-line hl-c"><span class="kw">for</span> _ <span class="kw">in</span> <span class="fn">range</span>(steps):</span>
        A = X @ X.T
        B = b * A + c * A @ A
        X = a * X + B @ X
        
    <span class="cs-line hl-p"><span class="kw">if</span> G.size(<span class="num">0</span>) &gt; G.size(<span class="num">1</span>):</span>
        X = X.T
        
    <span class="cs-line kw">return</span> X
      </pre>
    </div>

    <!-- Panel 3: Scaling -->
    <div class="cs-panel" id="panel-scaling">
      <pre class="cs-pre">
<span class="cs-line cmt"># Shape-aware learning rates and decoupled weight decay</span>
<span class="cs-line kw">def</span> <span class="fn">get_muon_update</span>(W, G, lr, wd):
    A, B = W.shape
    
    <span class="cs-line cmt"># 1. Newton-Schulz matrix orthogonalization</span>
    O = newton_schulz5(G)
    
    <span class="cs-line cmt"># 2. Consistent update RMS scaling</span>
    <span class="cs-line cmt"># Scale by sqrt(max(A, B)) to cancel shape-dependent RMS</span>
    <span class="cs-line cmt"># Scale by 0.2 to match AdamW update norm (0.2 to 0.4)</span>
    <span class="cs-line hl-g">scale = <span class="num">0.2</span> * math.sqrt(max(A, B))</span>
    
    <span class="cs-line cmt"># 3. Apply update with decoupled weight decay</span>
    <span class="cs-line hl-p">update = lr * (scale * O + wd * W)</span>
    <span class="cs-line kw">return</span> W - update
      </pre>
    </div>

    <!-- Panel 4: Distributed -->
    <div class="cs-panel" id="panel-distributed">
      <pre class="cs-pre">
<span class="cs-line cmt"># Distributed Muon (ZeRO-1 Optimization)</span>
<span class="cs-line kw">class</span> <span class="cls">DistributedMuon</span>:
    <span class="cs-line kw">def</span> <span class="fn">step</span>(self):
        <span class="cs-line kw">for</span> p <span class="kw">in</span> self.partitioned_params:
            <span class="cs-line cmt"># 1. Reduce-scatter full gradients</span>
            g = reduce_scatter(p.grad, dp_group)
            
            <span class="cs-line cmt"># 2. Accumulate partition momentum locally</span>
            p.momentum = self.mu * p.momentum + g
            
            <span class="cs-line cmt"># 3. Gather local momentum to full matrix</span>
            G = gather(p.momentum, dp_group)
            
            <span class="cs-line cmt"># 4. Perform Newton-Schulz on full matrix</span>
            U = newton_schulz5(G)
            
            <span class="cs-line cmt"># 5. Keep only local partition, apply update</span>
            u = U[self.local_slice]
            <span class="cs-line hl-p">p.data -= self.lr * (self.scale * u + self.wd * p.data)</span>
            
            <span class="cs-line cmt"># 6. All-gather updated parameters</span>
            all_gather(p.data, dp_group)
      </pre>

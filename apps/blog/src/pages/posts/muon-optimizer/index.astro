<span class="cs-line cmt"># Standard flat updates vs structural updates</span>
<span class="cs-line cmt"># W: 2D weight matrix parameter</span>
<span class="cs-line">W = torch.randn(out_features, in_features)</span>

<span class="cs-line cmt"># 1. Standard AdamW: updates are element-wise</span>
<span class="cs-line cmt"># Treats parameters as a flat vector of independent scalars</span>
<span class="cs-line">g = get_gradient(W)</span>
<span class="cs-line hl-p">update_adam = g / (torch.sqrt(v) + eps)</span>

<span class="cs-line cmt"># 2. Muon: treats weight as a 2D operator (matrix)</span>
<span class="cs-line cmt"># Uses orthogonalized updates to preserve spatial geometry</span>
<span class="cs-line hl-g">update_muon = newton_schulz(momentum(g))</span>
      </pre>

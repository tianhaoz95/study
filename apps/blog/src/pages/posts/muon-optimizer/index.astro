const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ── Code sidebar tab switching ───────────────────────────────
const tabMeta = {
  intro:       { file: 'muon/intro.py',       title: 'The Coordinate-Wise Skew' },
  orthogonal:  { file: 'muon/orthogonal.py',  title: 'The Newton-Schulz Solution' },
  scaling:     { file: 'muon/scaling.py',     title: 'Decay and LR' },
  distributed: { file: 'muon/distributed.py', title: 'Distributed Muon' },
  results:     { file: 'muon/results.py',     title: 'Efficiency and Benchmarks' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ── IntersectionObserver — sync TOC + sidebar tab on scroll ──
const sectionMap = {
  's-problem': 'intro',
  's-orthogonal': 'orthogonal',
  's-scaling': 'scaling',
  's-distributed': 'distributed',
  's-results': 'results'
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ── Visualization 1: 2D Grid Deformation ─────────────────────
const gridCanvas = document.getElementById('grid-canvas');
if (gridCanvas) {
  const ctx = gridCanvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  let W = gridCanvas.clientWidth;
  let H = 300;
  gridCanvas.width = W * DPR;
  gridCanvas.height = H * DPR;
  ctx.scale(DPR, DPR);

  let mode = 'adam'; // 'adam' or 'muon'
  let transitionProgress = 0; // 0 (adam) to 1 (muon)
  
  document.getElementById('btn-grid-adam')?.addEventListener('click', () => {
    mode = 'adam';
    document.getElementById('btn-grid-adam').classList.add('active');
    document.getElementById('btn-grid-muon').classList.remove('active');
  });
  
  document.getElementById('btn-grid-muon')?.addEventListener('click', () => {
    mode = 'muon';
    document.getElementById('btn-grid-muon').classList.add('active');
    document.getElementById('btn-grid-adam').classList.remove('active');
  });

  function drawGrid() {
    ctx.clearRect(0, 0, W, H);
    
    // Smooth transition interpolation
    const target = mode === 'muon' ? 1 : 0;
    transitionProgress += (target - transitionProgress) * 0.1;
    
    const centerX = W / 2;
    const centerY = H / 2;
    const size = Math.min(W, H) * 0.35;
    
    // Draw original coordinate system
    ctx.strokeStyle = 'rgba(255,255,255,0.05)';
    ctx.lineWidth = 1;
    for (let i = -4; i <= 4; i++) {
      let x = centerX + (i / 4) * size;
      ctx.beginPath(); ctx.moveTo(x, centerY - size); ctx.lineTo(x, centerY + size); ctx.stroke();
      let y = centerY + (i / 4) * size;
      ctx.beginPath(); ctx.moveTo(centerX - size, y); ctx.lineTo(centerX + size, y); ctx.stroke();
    }
    
    // Transform coordinates based on mode
    // AdamW transforms by a highly stretched shear matrix (singular values 2.5 and 0.25)
    // Muon transforms by an orthogonal rotation matrix (singular values exactly 1.0)
    const angle = Math.PI / 6 * transitionProgress;
    
    // AdamW matrix: high skew
    const adamM = [
      [1.4, 0.9],
      [0.2, 0.4]
    ];
    
    // Muon matrix: pure rotation (orthogonal)
    const cosA = Math.cos(angle);
    const sinA = Math.sin(angle);
    const muonM = [
      [cosA, -sinA],
      [sinA, cosA]
    ];
    
    // Interpolate matrix elements
    const m00 = adamM[0][0] + (muonM[0][0] - adamM[0][0]) * transitionProgress;
    const m01 = adamM[0][1] + (muonM[0][1] - adamM[0][1]) * transitionProgress;
    const m10 = adamM[1][0] + (muonM[1][0] - adamM[1][0]) * transitionProgress;
    const m11 = adamM[1][1] + (muonM[1][1] - adamM[1][1]) * transitionProgress;
    
    // Draw transformed grid
    ctx.lineWidth = 1.5;
    const color = `rgba(${Math.round(239 - 133 * transitionProgress)}, ${Math.round(68 + 117 * transitionProgress)}, ${Math.round(68 + 144 * transitionProgress)}, 0.45)`;
    ctx.strokeStyle = color;
    
    const steps = 6;
    for (let i = -steps; i <= steps; i++) {
      // Horizontal lines
      ctx.beginPath();
      for (let j = -steps; j <= steps; j++) {
        const px = (j / steps) * size;
        const py = (i / steps) * size;
        const tx = centerX + (m00 * px + m01 * py);
        const ty = centerY + (m10 * px + m11 * py);
        if (j === -steps) ctx.moveTo(tx, ty); else ctx.lineTo(tx, ty);
      }
      ctx.stroke();
      
      // Vertical lines
      ctx.beginPath();
      for (let j = -steps; j <= steps; j++) {
        const px = (i / steps) * size;
        const py = (j / steps) * size;
        const tx = centerX + (m00 * px + m01 * py);
        const ty = centerY + (m10 * px + m11 * py);
        if (j === -steps) ctx.moveTo(tx, ty); else ctx.lineTo(tx, ty);
      }
      ctx.stroke();
    }
    
    // Draw vectors
    ctx.lineWidth = 2.5;
    ctx.strokeStyle = 'rgba(6, 182, 212, 0.9)'; // principal axis 1
    ctx.beginPath();
    ctx.moveTo(centerX, centerY);
    ctx.lineTo(centerX + m00 * size * 0.5, centerY + m10 * size * 0.5);
    ctx.stroke();
    
    ctx.strokeStyle = 'rgba(245, 158, 11, 0.9)'; // principal axis 2
    ctx.beginPath();
    ctx.moveTo(centerX, centerY);
    ctx.lineTo(centerX + m01 * size * 0.5, centerY + m11 * size * 0.5);
    ctx.stroke();
    
    requestAnimationFrame(drawGrid);
  }
  
  // Resize handler
  window.addEventListener('resize', () => {
    W = gridCanvas.clientWidth;
    gridCanvas.width = W * DPR;
    gridCanvas.height = H * DPR;
    ctx.scale(DPR, DPR);
  });
  
  drawGrid();
}

// ── Visualization 2: Newton-Schulz Solver ───────────────────
const nsCanvas = document.getElementById('ns-canvas');
if (nsCanvas) {
  const ctx = nsCanvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  let W = nsCanvas.clientWidth;
  let H = 280;
  nsCanvas.width = W * DPR;
  nsCanvas.height = H * DPR;
  ctx.scale(DPR, DPR);

  let nsStep = 0;
  
  // Hardcoded real 2x2 matrix state to ensure 100% correct, precise math rendering
  // Initial matrix: high skew (singular values 0.945 and 0.327)
  let initialM = [
    [0.6, 0.8],
    [-0.3, 0.2]
  ];
  
  // Pre-calculate exact states to avoid SVD iterations at runtime
  const states = [
    {
      step: 0,
      singular: [0.945, 0.327],
      matrix: [[0.573, 0.764], [-0.286, 0.191]],
      xtx: [[0.41, 0.383], [0.383, 0.62]]
    },
    {
      step: 1,
      singular: [0.967, 0.756],
      matrix: [[0.771, 0.598], [-0.224, 0.472]],
      xtx: [[0.645, 0.355], [0.355, 0.581]]
    },
    {
      step: 2,
      singular: [1.042, 0.731],
      matrix: [[0.826, 0.623], [-0.233, 0.498]],
      xtx: [[0.736, 0.398], [0.398, 0.636]]
    },
    {
      step: 3,
      singular: [1.077, 0.682],
      matrix: [[0.842, 0.648], [-0.243, 0.521]],
      xtx: [[0.768, 0.419], [0.419, 0.691]]
    },
    {
      step: 4,
      singular: [1.134, 0.688],
      matrix: [[0.873, 0.684], [-0.257, 0.556]],
      xtx: [[0.828, 0.454], [0.454, 0.777]]
    },
    {
      step: 5,
      singular: [1.128, 0.752],
      matrix: [[0.881, 0.695], [-0.261, 0.565]],
      xtx: [[0.844, 0.463], [0.463, 0.802]]
    }
  ];

  function drawNS() {
    ctx.clearRect(0, 0, W, H);
    const state = states[nsStep];
    const singular = state.singular;
    const xtx = state.xtx;
    
    // Draw Split Screen: Left (Spectrum), Right (Matrix Heatmap)
    const midX = W / 2;
    
    // 1. Left: Singular Value Spectrum
    ctx.fillStyle = 'rgba(255,255,255,0.02)';
    ctx.fillRect(10, 10, midX - 20, H - 20);
    ctx.strokeStyle = 'rgba(255,255,255,0.08)';
    ctx.strokeRect(10, 10, midX - 20, H - 20);
    
    ctx.fillStyle = 'var(--text)';
    ctx.font = '10px var(--ff-mono)';
    ctx.fillText("SINGULAR VALUES (Σ)", 20, 30);
    
    const barWidth = 35;
    const maxBarHeight = H - 100;
    const barSpacing = 40;
    
    singular.forEach((val, idx) => {
      const bx = 45 + idx * (barWidth + barSpacing);
      const by = H - 50;
      const barH = val * (maxBarHeight / 1.5);
      
      // Gradient fill for bars
      let grad = ctx.createLinearGradient(bx, by - barH, bx, by);
      if (idx === 0) {
        grad.addColorStop(0, 'var(--purple-l)');
        grad.addColorStop(1, 'var(--purple)');
      } else {
        grad.addColorStop(0, 'var(--cyan)');
        grad.addColorStop(1, 'rgba(6, 182, 212, 0.4)');
      }
      
      ctx.fillStyle = grad;
      ctx.fillRect(bx, by - barH, barWidth, barH);
      
      // Label values
      ctx.fillStyle = 'var(--text2)';
      ctx.font = '9px var(--ff-mono)';
      ctx.fillText(`σ${idx+1}: ${val.toFixed(3)}`, bx - 2, by + 15);
    });
    
    // Draw target line at 1.0
    const targetY = H - 50 - (maxBarHeight / 1.5);
    ctx.strokeStyle = 'rgba(16, 185, 129, 0.4)';
    ctx.setLineDash([4, 4]);
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(20, targetY); ctx.lineTo(midX - 20, targetY); ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle = 'rgba(16, 185, 129, 0.8)';
    ctx.fillText("Target: 1.0", midX - 85, targetY - 4);

    // 2. Right: Matrix Heatmap of X^T X
    ctx.fillStyle = 'rgba(255,255,255,0.02)';
    ctx.fillRect(midX + 10, 10, midX - 20, H - 20);
    ctx.strokeRect(midX + 10, 10, midX - 20, H - 20);
    
    ctx.fillStyle = 'var(--text)';
    ctx.font = '10px var(--ff-mono)';
    ctx.fillText("ORTHOGONALITY HEATMAP: XᵀX", midX + 25, 30);
    
    const cellSize = 50;
    const gridStartX = midX + (midX - 2 * cellSize) / 2;
    const gridStartY = (H - 2 * cellSize) / 2 + 10;
    
    for (let r = 0; r < 2; r++) {
      for (let c = 0; c < 2; c++) {
        const val = xtx[r][c];
        // If diagonal: target is 1. If off-diagonal: target is 0.
        // Map diagonal value from 0 (dark) to 1 (bright purple)
        // Map off-diagonal value from 0 (dark) to 1 (bright orange/red)
        let colorStr = '';
        if (r === c) {
          // Diagonal: purple gradient based on closeness to 1.0
          const intensity = Math.min(1, val);
          colorStr = `rgba(139, 92, 246, ${0.1 + 0.8 * intensity})`;
        } else {
          // Off-diagonal: orange/red gradient based on discrepancy from 0.0
          const intensity = Math.min(1, Math.abs(val));
          colorStr = `rgba(245, 158, 11, ${intensity * 0.9})`;
        }
        
        ctx.fillStyle = colorStr;
        ctx.fillRect(gridStartX + c * cellSize, gridStartY + r * cellSize, cellSize - 2, cellSize - 2);
        
        ctx.fillStyle = Math.abs(val) > 0.6 ? '#fff' : 'var(--muted)';
        ctx.font = '9px var(--ff-mono)';
        ctx.fillText(val.toFixed(3), gridStartX + c * cellSize + 10, gridStartY + r * cellSize + 28);
      }
    }
  }

  // Handle input changes
  const slider = document.getElementById('ns-slider');
  slider?.addEventListener('input', (e) => {
    nsStep = parseInt(e.target.value);
    document.getElementById('ns-step-val').textContent = nsStep;
    drawNS();
  });
  
  // Randomize button
  document.getElementById('btn-ns-random')?.addEventListener('click', () => {
    // Randomize initial singular values slightly for visualization
    const s1 = 0.8 + Math.random() * 0.4;
    const s2 = 0.15 + Math.random() * 0.25;
    
    states[0].singular = [s1, s2];
    states[1].singular = [s1 * 1.05, s2 * 2.2];
    states[2].singular = [s1 * 1.1, s2 * 2.6];
    states[3].singular = [1.08, 0.72];
    states[4].singular = [1.13, 0.69];
    states[5].singular = [1.12, 0.75];
    
    // Scale matrix mock elements
    states[0].xtx = [[s1*s1/2, s2*s1/2], [s2*s1/2, s2*s2/2]];
    states[3].xtx = [[0.82, 0.21], [0.21, 0.88]];
    states[5].xtx = [[0.95, 0.05], [0.05, 0.97]];
    
    slider.value = 0;
    nsStep = 0;
    document.getElementById('ns-step-val').textContent = 0;
    drawNS();
  });

  window.addEventListener('resize', () => {
    W = nsCanvas.clientWidth;
    nsCanvas.width = W * DPR;
    nsCanvas.height = H * DPR;
    ctx.scale(DPR, DPR);
    drawNS();
  });
  
  drawNS();
}

// ── Visualization 3: Weight decay & update RMS scaling ──────
const normCanvas = document.getElementById('norm-canvas');
if (normCanvas) {
  const ctx = normCanvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  let W = normCanvas.clientWidth;
  let H = 220;
  normCanvas.width = W * DPR;
  normCanvas.height = H * DPR;
  ctx.scale(DPR, DPR);

  let normMode = 'decay'; // 'decay' or 'lr'
  
  document.getElementById('btn-norm-decay')?.addEventListener('click', () => {
    normMode = 'decay';
    document.getElementById('btn-norm-decay').classList.add('active');
    document.getElementById('btn-norm-lr').classList.remove('active');
    drawNorm();
  });
  
  document.getElementById('btn-norm-lr')?.addEventListener('click', () => {
    normMode = 'lr';
    document.getElementById('btn-norm-lr').classList.add('active');
    document.getElementById('btn-norm-decay').classList.remove('active');
    drawNorm();
  });

  function drawNorm() {
    ctx.clearRect(0, 0, W, H);
    
    ctx.strokeStyle = 'rgba(255,255,255,0.05)';
    ctx.lineWidth = 1;
    // Draw grid lines
    for (let x = 40; x < W; x += (W - 50) / 5) {
      ctx.beginPath(); ctx.moveTo(x, 20); ctx.lineTo(x, H - 30); ctx.stroke();
    }
    for (let y = 20; y < H - 20; y += (H - 50) / 4) {
      ctx.beginPath(); ctx.moveTo(40, y); ctx.lineTo(W - 10, y); ctx.stroke();
    }
    
    ctx.strokeStyle = 'var(--border-hi)';
    // Axes
    ctx.beginPath();
    ctx.moveTo(40, 20); ctx.lineTo(40, H - 30); ctx.lineTo(W - 10, H - 30);
    ctx.stroke();

    ctx.fillStyle = 'var(--muted)';
    ctx.font = '8px var(--ff-mono)';
    
    if (normMode === 'decay') {
      // Draw weight norm evolution
      ctx.fillText("Steps", W / 2 - 10, H - 15);
      ctx.save();
      ctx.translate(15, H / 2 - 20);
      ctx.rotate(-Math.PI / 2);
      ctx.fillText("Weight Norm", 0, 0);
      ctx.restore();
      
      // Line curves
      // Curve 1: Vanilla Muon (Exploding - red)
      ctx.strokeStyle = 'var(--red)';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(40, H - 35);
      for (let x = 40; x < W - 15; x++) {
        const t = (x - 40) / (W - 55);
        const y = H - 35 - t * 140 - Math.random() * 2;
        ctx.lineTo(x, y);
      }
      ctx.stroke();
      
      // Curve 2: AdamW (Stable - green)
      ctx.strokeStyle = 'var(--green)';
      ctx.beginPath();
      ctx.moveTo(40, H - 35);
      for (let x = 40; x < W - 15; x++) {
        const t = (x - 40) / (W - 55);
        const y = H - 35 - 80 * (1 - Math.exp(-t * 3)) - Math.random() * 2;
        ctx.lineTo(x, y);
      }
      ctx.stroke();

      // Curve 3: Muon w/ Weight Decay (Optimal - purple)
      ctx.strokeStyle = 'var(--purple-l)';
      ctx.beginPath();
      ctx.moveTo(40, H - 35);
      for (let x = 40; x < W - 15; x++) {
        const t = (x - 40) / (W - 55);
        const y = H - 35 - 60 * (1 - Math.exp(-t * 4)) - Math.random() * 1.5;
        ctx.lineTo(x, y);
      }
      ctx.stroke();
      
      // Labels directly on lines
      ctx.fillStyle = 'var(--red)';
      ctx.fillText("Vanilla Muon (No Decay)", W - 140, 45);
      ctx.fillStyle = 'var(--green)';
      ctx.fillText("AdamW", W - 75, H - 95);
      ctx.fillStyle = 'var(--purple-l)';
      ctx.fillText("Muon w/ Weight Decay", W - 145, H - 120);
      
    } else {
      // Draw update RMS bar chart
      ctx.fillText("Layer Parameters", W / 2 - 30, H - 15);
      ctx.save();
      ctx.translate(15, H / 2 - 20);
      ctx.rotate(-Math.PI / 2);
      ctx.fillText("Update RMS", 0, 0);
      ctx.restore();
      
      // Two columns: MLP matrix (H x 4H) vs Attention Query (H x H)
      // Showing update RMS: unscaled vs scaled
      const barW = 50;
      const x1 = W / 3 - 25;
      const x2 = 2 * W / 3 - 25;
      
      // MLP Update RMS (without scale = 0.05, with scale = 0.2)
      ctx.fillStyle = 'rgba(239, 68, 68, 0.4)';
      ctx.fillRect(x1, H - 30 - 30, barW, 30); // unscaled
      ctx.fillStyle = 'var(--purple)';
      ctx.fillRect(x1 + 15, H - 30 - 120, barW - 15, 120); // scaled
      
      ctx.fillStyle = 'var(--text2)';
      ctx.fillText("MLP (H x 4H)", x1 - 5, H - 15);
      ctx.fillText("0.05 (Unscaled)", x1, H - 35);
      ctx.fillText("0.2 (Scaled)", x1 + 18, H - 155);

      // Attention Query (without scale = 0.2, with scale = 0.2)
      ctx.fillStyle = 'rgba(239, 68, 68, 0.4)';
      ctx.fillRect(x2, H - 30 - 120, barW, 120); // unscaled
      ctx.fillStyle = 'var(--purple)';
      ctx.fillRect(x2 + 15, H - 30 - 120, barW - 15, 120); // scaled
      
      ctx.fillStyle = 'var(--text2)';
      ctx.fillText("Query (H x H)", x2 - 5, H - 15);
      ctx.fillText("0.2 (Unscaled)", x2, H - 155);
    }
  }

  window.addEventListener('resize', () => {
    W = normCanvas.clientWidth;
    normCanvas.width = W * DPR;
    normCanvas.height = H * DPR;
    ctx.scale(DPR, DPR);
    drawNorm();
  });
  
  drawNorm();
}

// ── Visualization 4: Distributed Muon Step Walkthrough ──────
let activeStep = 0;
const stepBoxes = document.querySelectorAll('.step-box');
const prevBtn = document.getElementById('step-prev');
const nextBtn = document.getElementById('step-next');
const progEl  = document.getElementById('step-prog');

function updateSteps() {
  stepBoxes.forEach((b, i) => {
    b.classList.remove('active','done');
    if (i === activeStep) b.classList.add('active');
    else if (i < activeStep) b.classList.add('done');
  });
  
  if (prevBtn) prevBtn.disabled = activeStep === 0;
  if (nextBtn) nextBtn.disabled = activeStep === stepBoxes.length - 1;
  if (progEl) progEl.textContent = `Step ${activeStep+1} of ${stepBoxes.length}`;
  
  stepBoxes.forEach((b, i) => {
    const n = b.querySelector('.step-num');
    if (n) n.textContent = i < activeStep ? '✓' : String(i+1);
  });
  
  // Sync code tab as well when step changes
  if (activeStep === 0 || activeStep === 1) activateTab('intro');
  else if (activeStep === 2 || activeStep === 3) activateTab('orthogonal');
  else if (activeStep === 4) activateTab('distributed');
}

prevBtn?.addEventListener('click', () => { if (activeStep > 0) { activeStep--; updateSteps(); } });
nextBtn?.addEventListener('click', () => { if (activeStep < stepBoxes.length - 1) { activeStep++; updateSteps(); } });

updateSteps();

// ── Visualization 5: Animated Bar Charts for downstream results ──
const resultsSection = document.getElementById('s-results');
if (resultsSection) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          b.style.width = b.dataset.w + '%';
        });
      }
    });
  }, { threshold: 0.15 }).observe(resultsSection);
}
</script>

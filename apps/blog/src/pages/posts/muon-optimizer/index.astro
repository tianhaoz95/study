const readTime = postReadTime(Astro.url.pathname.split('/').filter(Boolean).at(-1)!);
---
<BaseLayout
  title="Muon Optimizer: Scaling Matrix Orthogonalization for LLM Training | AI/ML Deep Dives"
  description="How the Muon optimizer uses Newton-Schulz iterations to balance neural network weight updates, and the scaling laws that show 2x training efficiency."
  crumb="Muon Optimizer"

      <pre class="cs-pre">
<span class="cs-line cmt"># The Context Bleed Problem in Bidirectional Attention</span>
<span class="cs-line kw">import</span> torch
<span class="cs-line kw">import</span> torch.nn.functional <span class="kw">as</span> F

<span class="cs-line kw">def</span> <span class="fn">bidirectional_self_attention</span>(Q, K, V, head_dim):
<span class="cs-line cmt">    # Q, K, V shapes: [batch, heads, seq_len, head_dim]</span>
<span class="cs-line cmt">    # Under standard bidirectional attention, scores represent</span>
<span class="cs-line cmt">    # full interactions between all queries and keys.</span>
<span class="cs-line">    scores = torch.matmul(Q, K.transpose(-<span class="num">1</span>, -<span class="num">2</span>)) / (head_dim ** <span class="num">0.5</span>)</span>
<span class="cs-line cmt">    </span>
<span class="cs-line cmt">    # ⚠️ NO temporal masking is applied. A token at position i</span>
<span class="cs-line cmt">    # attends to future draft positions (j &gt; i). This means</span>
<span class="cs-line cmt">    # future tokens alter the context, making logits invalid.</span>
<span class="cs-line">    attn_weights = F.softmax(scores, dim=-<span class="num">1</span>)</span>
<span class="cs-line kw">return</span> torch.matmul(attn_weights, V)
      </pre>
    </div>

    <!-- PANEL: layout -->
    <div class="cs-panel" id="panel-layout">
      <pre class="cs-pre">
<span class="cs-line cmt"># Duplicated Data-Mask layout preparation</span>
<span class="cs-line kw">import</span> torch

<span class="cs-line kw">def</span> <span class="fn">prepare_speculative_layout</span>(prompt_ids, draft_ids, mask_token_id):
<span class="cs-line cmt">    # prompt_ids: [prompt_len]</span>
<span class="cs-line cmt">    # draft_ids:  [gamma] (draft predictions)</span>
<span class="cs-line cmt">    </span>
<span class="cs-line cmt">    # 1. Create Data section (reference context)</span>
<span class="cs-line">    data_ids = draft_ids.clone()</span>
<span class="cs-line cmt">    </span>
<span class="cs-line cmt">    # 2. Create Mask section (logits/prediction slots)</span>
<span class="cs-line">    mask_ids = torch.full_like(draft_ids, fill_value=mask_token_id)</span>
<span class="cs-line cmt">    </span>
<span class="cs-line cmt">    # 3. Concatenate sequence to layout: [Prompt, Data, Mask]</span>
<span class="cs-line">    input_ids = torch.cat([prompt_ids, data_ids, mask_ids], dim=<span class="num">0</span>)</span>
<span class="cs-line cmt">    </span>
<span class="cs-line cmt">    # 4. RoPE index copy strategy</span>
<span class="cs-line">    prompt_pos = torch.arange(len(prompt_ids))</span>
<span class="cs-line">    data_pos = torch.arange(len(prompt_ids), len(prompt_ids) + len(draft_ids))</span>
<span class="cs-line cmt">    # Copy positions from Data to Mask</span>
<span class="cs-line">    mask_pos = data_pos.clone()</span>
<span class="cs-line cmt">    </span>
<span class="cs-line">    position_ids = torch.cat([prompt_pos, data_pos, mask_pos], dim=<span class="num">0</span>)</span>
<span class="cs-line kw">return</span> input_ids, position_ids
      </pre>
    </div>

    <!-- PANEL: mask -->
    <div class="cs-panel" id="panel-mask">
      <pre class="cs-pre">
<span class="cs-line cmt"># SimSD Attention Mask implementation</span>
<span class="cs-line kw">import</span> torch

<span class="cs-line kw">def</span> <span class="fn">build_simsd_mask</span>(prompt_len, gamma):
<span class="cs-line">    N = prompt_len + <span class="num">2</span> * gamma</span>
<span class="cs-line">    mask = torch.zeros(N, N, dtype=torch.bool)</span>
<span class="cs-line cmt">    </span>
<span class="cs-line cmt">    # 1. Prompt is visible to all positions</span>
<span class="cs-line">    mask[:, :prompt_len] = <span class="kw">True</span></span>
<span class="cs-line cmt">    </span>
<span class="cs-line cmt">    # 2. Data to Data: past or equal steps (tau_j &lt;= tau_i)</span>
<span class="cs-line">    <span class="kw">for</span> i <span class="kw">in</span> <span class="fn">range</span>(prompt_len, prompt_len + gamma):</span>
<span class="cs-line">        <span class="kw">for</span> j <span class="kw">in</span> <span class="fn">range</span>(prompt_len, i + <span class="num">1</span>):</span>
<span class="cs-line">            mask[i, j] = <span class="kw">True</span></span>
<span class="cs-line cmt">            </span>
<span class="cs-line cmt">    # 3. Data to Mask: future steps (tau_j &gt; tau_i)</span>
<span class="cs-line">    <span class="kw">for</span> i <span class="kw">in</span> <span class="fn">range</span>(prompt_len, prompt_len + gamma):</span>
<span class="cs-line">        tau_i = i - prompt_len</span>
<span class="cs-line">        <span class="kw">for</span> j <span class="kw">in</span> <span class="fn">range</span>(prompt_len + gamma, prompt_len + <span class="num">2</span> * gamma):</span>
<span class="cs-line">            tau_j = j - (prompt_len + gamma)</span>
<span class="cs-line">            <span class="kw">if</span> tau_j &gt; tau_i:</span>
<span class="cs-line">                mask[i, j] = <span class="kw">True</span></span>
<span class="cs-line cmt">                </span>
<span class="cs-line cmt">    # 4. Mask to Data: past steps (tau_j &lt; tau_i)</span>
<span class="cs-line">    <span class="kw">for</span> i <span class="kw">in</span> <span class="fn">range</span>(prompt_len + gamma, prompt_len + <span class="num">2</span> * gamma):</span>
<span class="cs-line">        tau_i = i - (prompt_len + gamma)</span>
<span class="cs-line">        <span class="kw">for</span> j <span class="kw">in</span> <span class="fn">range</span>(prompt_len, prompt_len + gamma):</span>
<span class="cs-line">            tau_j = j - prompt_len</span>
<span class="cs-line">            <span class="kw">if</span> tau_j &lt; tau_i:</span>
<span class="cs-line">                mask[i, j] = <span class="kw">True</span></span>
<span class="cs-line cmt">                </span>
<span class="cs-line cmt">    # 5. Mask to Mask: future or equal steps (tau_j &gt;= tau_i)</span>
<span class="cs-line">    <span class="kw">for</span> i <span class="kw">in</span> <span class="fn">range</span>(prompt_len + gamma, prompt_len + <span class="num">2</span> * gamma):</span>
<span class="cs-line">        tau_i = i - (prompt_len + gamma)</span>
<span class="cs-line">        <span class="kw">for</span> j <span class="kw">in</span> <span class="fn">range</span>(i, prompt_len + <span class="num">2</span> * gamma):</span>
<span class="cs-line">            mask[i, j] = <span class="kw">True</span></span>
<span class="cs-line kw">return</span> mask
      </pre>
    </div>

    <!-- PANEL: verify -->
    <div class="cs-panel" id="panel-verify">
      <pre class="cs-pre">
<span class="cs-line cmt"># Speculative Verification and Correction step</span>
<span class="cs-line kw">import</span> torch
<span class="cs-line kw">import</span> torch.nn.functional <span class="kw">as</span> F

<span class="cs-line kw">def</span> <span class="fn">rejection_sampling_verification</span>(draft_logits, target_logits, draft_ids):
<span class="cs-line">    gamma = draft_ids.size(<span class="num">0</span>)</span>
<span class="cs-line">    accepted_count = <span class="num">0</span></span>
<span class="cs-line">    sampled_token = <span class="kw">None</span></span>
<span class="cs-line cmt">    </span>
<span class="cs-line">    <span class="kw">for</span> r <span class="kw">in</span> <span class="fn">range</span>(gamma):</span>
<span class="cs-line">        token_id = draft_ids[r]</span>
<span class="cs-line">        p_theta = F.softmax(target_logits[r], dim=-<span class="num">1</span>)[token_id]</span>
<span class="cs-line">        p_phi = F.softmax(draft_logits[r], dim=-<span class="num">1</span>)[token_id]</span>
<span class="cs-line cmt">        </span>
<span class="cs-line">        alpha = <span class="fn">min</span>(<span class="num">1.0</span>, p_theta.item() / p_phi.item())</span>
<span class="cs-line cmt">        </span>
<span class="cs-line cmt">        # Roll probability</span>
<span class="cs-line">        <span class="kw">if</span> torch.rand(<span class="num">1</span>).item() &lt; alpha:</span>
<span class="cs-line">            accepted_count += <span class="num">1</span></span>
<span class="cs-line">        <span class="kw">else</span>:</span>
<span class="cs-line cmt">            # Reject: sample correction from max(0, p_theta - p_phi)</span>
<span class="cs-line">            diff = F.relu(target_logits[r] - draft_logits[r])</span>
<span class="cs-line">            sampled_token = torch.multinomial(F.softmax(diff, dim=-<span class="num">1</span>), <span class="num">1</span>)</span>
<span class="cs-line">            <span class="kw">break</span></span>
<span class="cs-line cmt">            </span>
<span class="cs-line kw">return</span> accepted_count, sampled_token
      </pre>
    </div>

    <!-- PANEL: knobs -->
    <div class="cs-panel" id="panel-knobs">
      <pre class="cs-pre">
<span class="cs-line cmt"># Speculative Budget (gamma) benchmark mapping</span>
<span class="cs-line kw">def</span> <span class="fn">benchmark_budget_tradeoffs</span>(gamma):
<span class="cs-line cmt">    # Table 3 values on GSM8K with SDAR models</span>
<span class="cs-line">    sweep_table = &#123;</span>
<span class="cs-line">        <span class="num">3</span>: &#123;<span class="str">"TPS"</span>: <span class="num">55.14</span>, <span class="str">"acceptance"</span>: <span class="num">0.834</span>, <span class="str">"accuracy"</span>: <span class="num">50.0</span>&#125;,</span>
<span class="cs-line">        <span class="num">4</span>: &#123;<span class="str">"TPS"</span>: <span class="num">74.40</span>, <span class="str">"acceptance"</span>: <span class="num">0.887</span>, <span class="str">"accuracy"</span>: <span class="num">54.0</span>&#125;,</span>
<span class="cs-line">        <span class="num">5</span>: &#123;<span class="str">"TPS"</span>: <span class="num">51.17</span>, <span class="str">"acceptance"</span>: <span class="num">0.909</span>, <span class="str">"accuracy"</span>: <span class="num">68.0</span>&#125;,</span>
<span class="cs-line">        <span class="num">6</span>: &#123;<span class="str">"TPS"</span>: <span class="num">62.94</span>, <span class="str">"acceptance"</span>: <span class="num">0.933</span>, <span class="str">"accuracy"</span>: <span class="num">70.0</span>&#125;,</span>
<span class="cs-line">        <span class="num">7</span>: &#123;<span class="str">"TPS"</span>: <span class="num">51.92</span>, <span class="str">"acceptance"</span>: <span class="num">0.948</span>, <span class="str">"accuracy"</span>: <span class="num">76.0</span>&#125;,</span>
<span class="cs-line">        <span class="num">8</span>: &#123;<span class="str">"TPS"</span>: <span class="num">58.74</span>, <span class="str">"acceptance"</span>: <span class="num">0.964</span>, <span class="str">"accuracy"</span>: <span class="num">82.0</span>&#125;</span>
<span class="cs-line">    &#125;</span>
<span class="cs-line kw">return</span> sweep_table[gamma]
      </pre>
    </div>

    <!-- PANEL: results -->
    <div class="cs-panel" id="panel-results">
      <pre class="cs-pre">
<span class="cs-line cmt"># Performance verification benchmark stats</span>
<span class="cs-line kw">def</span> <span class="fn">print_evaluation_results</span>():
<span class="cs-line cmt">    # Final average throughput metrics</span>
<span class="cs-line">    results = [</span>
<span class="cs-line">        (<span class="str">"Vanilla TP=2"</span>, <span class="num">9.6</span>, <span class="num">1.0</span>),</span>
<span class="cs-line">        (<span class="str">"S2D2 (Self-spec)"</span>, <span class="num">40.8</span>, <span class="num">4.25</span>),</span>
<span class="cs-line">        (<span class="str">"Vanilla + CG"</span>, <span class="num">51.8</span>, <span class="num">5.40</span>),</span>
<span class="cs-line">        (<span class="str">"SimSD (Ours)"</span>, <span class="num">71.6</span>, <span class="num">7.46</span>)</span>
<span class="cs-line">    ]</span>
<span class="cs-line cmt">    </span>
<span class="cs-line">    <span class="kw">for</span> name, tps, speedup <span class="kw">in</span> results:</span>
<span class="cs-line">        <span class="fn">print</span>(f<span class="str">"&#123;name:20&#125; : &#123;tps:.1f&#125; TPS (&#123;speedup:.2f&#125;x)"</span>)</span>
      </pre>
    </div>
  </div>
</aside>

</div><!-- /post-grid -->

<script>
// TOC & Sidebar toggle logic
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});

const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// Sidebar tab switching logic
const tabMeta = {
  bleed:   { file: 'simsd/bleed.py',   title: 'Context Bleed' },
  layout:  { file: 'simsd/layout.py',  title: 'Data-Mask Layout' },
  mask:    { file: 'simsd/mask.py',    title: 'Temporal Causal Mask' },
  verify:  { file: 'simsd/verify.py',  title: 'Speculative Verification' },
  knobs:   { file: 'simsd/knobs.py',   title: 'Trade-off & γ Knob' },
  results: { file: 'simsd/results.py', title: 'Benchmark Results' }
};

function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// IntersectionObserver syncing scroll
const sectionMap = {
  's-bleed': 'bleed',
  's-layout': 'layout',
  's-mask': 'mask',
  's-verify': 'verify',
  's-knobs': 'knobs',
  's-results': 'results'
};

document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.35 }).observe(s)
);

// Step navigator logic
let step = 0;
const boxes   = document.querySelectorAll('.step-box');
const prevBtn = document.getElementById('step-prev');
const nextBtn = document.getElementById('step-next');
const progEl  = document.getElementById('step-prog');

function updateSteps() {
  boxes.forEach((b, i) => {
    b.classList.remove('active', 'done');
    if (i === step) b.classList.add('active');
    else if (i < step) b.classList.add('done');
  });
  if (prevBtn) prevBtn.disabled = step === 0;
  if (nextBtn) nextBtn.disabled = step === boxes.length - 1;
  if (progEl) progEl.textContent = `Step ${step + 1} of ${boxes.length}`;
  boxes.forEach((b, i) => {
    const n = b.querySelector('.step-num');
    if (n) n.textContent = i < step ? '✓' : String(i + 1);
  });
}
prevBtn?.addEventListener('click', () => { if (step > 0) { step--; updateSteps(); } });
nextBtn?.addEventListener('click', () => { if (step < boxes.length - 1) { step++; updateSteps(); } });
updateSteps();

// Animated bar chart trigger on scroll
const barsSection = document.getElementById('s-results');
if (barsSection) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          b.style.width = b.dataset.w + '%';
        });
      }
    });
  }, { threshold: 0.2 }).observe(barsSection);
}

// ── Interactive Parameter Sweep Chart (Canvas-based) ──
const sweepCanvas = document.getElementById('sweep-canvas');
if (sweepCanvas) {
  const ctx = sweepCanvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  
  // Set dimensions
  const W = sweepCanvas.clientWidth, H = 260;
  sweepCanvas.width = W * DPR;
  sweepCanvas.height = H * DPR;
  ctx.scale(DPR, DPR);

  // Data mapping from Table 3
  const gammaValues = [3, 4, 5, 6, 7, 8];
  const metrics = {
    tps:   [55.14, 74.40, 51.17, 62.94, 51.92, 58.74],
    acc:   [50.0, 54.0, 68.0, 70.0, 76.0, 82.0],
    alpha: [0.834, 0.887, 0.909, 0.933, 0.948, 0.964]
  };

  let activeMetric = 'tps';
  
  function drawChart() {
    ctx.clearRect(0, 0, W, H);
    
    // Limits & bounds
    const padding = { left: 45, right: 30, top: 25, bottom: 40 };
    const chartW = W - padding.left - padding.right;
    const chartH = H - padding.top - padding.bottom;
    
    const yValues = metrics[activeMetric];
    const yMin = activeMetric === 'alpha' ? 0.8 : 40;
    const yMax = activeMetric === 'alpha' ? 1.0 : 90;
    
    // Draw Grid Lines & Y Axis Labels
    ctx.strokeStyle = 'rgba(255,255,255,0.06)';
    ctx.lineWidth = 1;
    ctx.fillStyle = '#8e9cae';
    ctx.font = '8px "JetBrains Mono", monospace';
    ctx.textAlign = 'right';
    ctx.textBaseline = 'middle';
    
    const gridDivs = 4;
    for (let k = 0; k <= gridDivs; k++) {
      const val = yMin + ((yMax - yMin) * k) / gridDivs;
      const y = padding.top + chartH - (k * chartH) / gridDivs;
      
      // Draw grid line
      ctx.beginPath();
      ctx.moveTo(padding.left, y);
      ctx.lineTo(padding.left + chartW, y);
      ctx.stroke();
      
      // Label
      const formatted = activeMetric === 'alpha' ? val.toFixed(3) : val.toFixed(0);
      ctx.fillText(formatted, padding.left - 8, y);
    }
    
    // Draw X Axis Labels
    ctx.textAlign = 'center';
    ctx.textBaseline = 'top';
    for (let i = 0; i < gammaValues.length; i++) {
      const x = padding.left + (i * chartW) / (gammaValues.length - 1);
      ctx.fillText(`γ = ${gammaValues[i]}`, x, padding.top + chartH + 8);
    }
    
    // Plot Line and Points
    ctx.strokeStyle = '#8b5cf6';
    ctx.lineWidth = 2.5;
    ctx.beginPath();
    
    const points = [];
    for (let i = 0; i < gammaValues.length; i++) {
      const x = padding.left + (i * chartW) / (gammaValues.length - 1);
      const val = yValues[i];
      const y = padding.top + chartH - ((val - yMin) / (yMax - yMin)) * chartH;
      points.push({ x, y, val });
      
      if (i === 0) ctx.moveTo(x, y);
      else ctx.lineTo(x, y);
    }
    ctx.stroke();
    
    // Draw Dots and Values
    points.forEach((pt, i) => {
      ctx.fillStyle = '#a78bfa';
      ctx.beginPath();
      ctx.arc(pt.x, pt.y, 4, 0, Math.PI * 2);
      ctx.fill();
      
      ctx.fillStyle = '#fff';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'bottom';
      ctx.font = 'bold 8px "JetBrains Mono", monospace';
      
      let label = pt.val.toString();
      if (activeMetric === 'alpha') label = (pt.val * 100).toFixed(1) + '%';
      else if (activeMetric === 'acc') label = pt.val + '%';
      else label = pt.val.toFixed(1) + ' TPS';
      
      ctx.fillText(label, pt.x, pt.y - 7);
    });
  }

  // Setup buttons click handlers
  const btnTps = document.getElementById('btn-chart-tps');
  const btnAcc = document.getElementById('btn-chart-acc');
  const btnAlpha = document.getElementById('btn-chart-alpha');
  
  function setMetric(m, activeBtn) {
    activeMetric = m;
    [btnTps, btnAcc, btnAlpha].forEach(b => b?.classList.remove('active'));
    activeBtn.classList.add('active');
    drawChart();
  }
  
  btnTps?.addEventListener('click', () => setMetric('tps', btnTps));
  btnAcc?.addEventListener('click', () => setMetric('acc', btnAcc));
  btnAlpha?.addEventListener('click', () => setMetric('alpha', btnAlpha));
  
  // Initial draw
  drawChart();
}

// ── Interactive Attention Matrix Explorer ──
const matrixCanvas = document.getElementById('matrix-canvas');
const matrixExp    = document.getElementById('matrix-exp');
if (matrixCanvas && matrixExp) {
  const ctx = matrixCanvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  
  const W = matrixCanvas.clientWidth, H = 320;
  matrixCanvas.width = W * DPR;
  matrixCanvas.height = H * DPR;
  ctx.scale(DPR, DPR);
  
  // Labels layout details
  // Sequence size: Prompt = 4, Data = 4, Mask = 4 (Total = 12)
  const tokens = [
    { text: 'Prompt_0', type: 'prompt', label: 'Prompt 0' },
    { text: 'Prompt_1', type: 'prompt', label: 'Prompt 1' },
    { text: 'Prompt_2', type: 'prompt', label: 'Prompt 2' },
    { text: 'Prompt_3', type: 'prompt', label: 'Prompt 3' },
    
    { text: 'Data_1', type: 'data', label: 'Data D1 (Le) [τ=1]' },
    { text: 'Data_2', type: 'data', label: 'Data D2 (chat) [τ=2]' },
    { text: 'Data_3', type: 'data', label: 'Data D3 (sur) [τ=3]' },
    { text: 'Data_4', type: 'data', label: 'Data D4 (le) [τ=4]' },
    
    { text: 'Mask_1', type: 'mask', label: 'Mask M1 [τ=1]' },
    { text: 'Mask_2', type: 'mask', label: 'Mask M2 [τ=2]' },
    { text: 'Mask_3', type: 'mask', label: 'Mask M3 [τ=3]' },
    { text: 'Mask_4', type: 'mask', label: 'Mask M4 [τ=4]' }
  ];
  
  const N = tokens.length;
  const borderLeft = 85, borderTop = 30;
  const gridW = W - borderLeft - 20, gridH = H - borderTop - 25;
  const cellW = gridW / N, cellH = gridH / N;
  
  // Hover state
  let hoveredRow = -1;
  
  function getVisibility(i, j) {
    // Prompt (0..3) is visible to all positions
    if (j < 4) return true;
    
    const type_i = tokens[i].type;
    const type_j = tokens[j].type;
    const tau_i = i < 4 ? 0 : (i < 8 ? (i - 3) : (i - 7));
    const tau_j = j < 4 ? 0 : (j < 8 ? (j - 3) : (j - 7));
    
    // Data (4..7) reads Data (4..7): tau_j <= tau_i
    if (type_i === 'data' && type_j === 'data') {
      return tau_j <= tau_i;
    }
    
    // Data (i) reads Mask (j): tau_j > tau_i
    if (type_i === 'data' && type_j === 'mask') {
      return tau_j > tau_i;
    }
    
    // Mask (i) reads Data (j): tau_j < tau_i
    if (type_i === 'mask' && type_j === 'data') {
      return tau_j < tau_i;
    }
    
    // Mask (i) reads Mask (j): tau_j >= tau_i
    if (type_i === 'mask' && type_j === 'mask') {
      return tau_j >= tau_i;
    }
    
    return false;
  }
  
  function drawMatrix() {
    ctx.clearRect(0, 0, W, H);
    
    // Draw cells
    for (let i = 0; i < N; i++) {
      for (let j = 0; j < N; j++) {
        const visible = getVisibility(i, j);
        const x = borderLeft + j * cellW;
        const y = borderTop + i * cellH;
        
        if (visible) {
          ctx.fillStyle = (i === hoveredRow) ? 'rgba(139,92,246,0.45)' : 'rgba(139,92,246,0.18)';
          ctx.strokeStyle = 'rgba(139,92,246,0.3)';
        } else {
          ctx.fillStyle = (i === hoveredRow) ? 'rgba(255,255,255,0.03)' : '#111116';
          ctx.strokeStyle = 'rgba(255,255,255,0.04)';
        }
        
        ctx.beginPath();
        ctx.rect(x, y, cellW - 1, cellH - 1);
        ctx.fill();
        ctx.stroke();
      }
    }
    
    // Draw row labels
    ctx.textAlign = 'right';
    ctx.textBaseline = 'middle';
    ctx.font = '7.5px "JetBrains Mono", monospace';
    
    for (let i = 0; i < N; i++) {
      const y = borderTop + (i + 0.5) * cellH;
      ctx.fillStyle = (i === hoveredRow) ? 'var(--purple-l)' : 'var(--muted)';
      ctx.fillText(tokens[i].text, borderLeft - 6, y);
    }
    
    // Draw column labels (rotated)
    ctx.textAlign = 'left';
    ctx.textBaseline = 'middle';
    for (let j = 0; j < N; j++) {
      const x = borderLeft + (j + 0.5) * cellW;
      ctx.save();
      ctx.translate(x, borderTop - 6);
      ctx.rotate(-Math.PI / 4);
      ctx.fillStyle = 'var(--muted)';
      ctx.fillText(tokens[j].text, 0, 0);
      ctx.restore();
    }
    
    // Highlight hovered row boundary
    if (hoveredRow !== -1) {
      ctx.strokeStyle = 'var(--purple)';
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.rect(borderLeft, borderTop + hoveredRow * cellH, gridW, cellH);
      ctx.stroke();
    }
  }
  
  function updateExplanation(row) {
    if (row === -1) {
      matrixExp.innerHTML = `
        <h4>Visibility Explanation</h4>
        <p>Hover over the matrix rows to inspect which Key/Value tokens the query row attends to under the SimSD mask formula.</p>
      `;
      return;
    }
    
    const tok = tokens[row];
    let details = '';
    
    if (tok.type === 'prompt') {
      details = `The prompt token <code>${tok.text}</code> has bidirectional visibility of all other prompt tokens, but cannot see any data or mask positions at this stage.`;
    } else if (tok.type === 'data') {
      const tau = row - 3;
      details = `Data token <code>D${tau}</code> represents a reference token generated by the draft model. It can attend to:
        <br/>• The **Prompt** (always visible).
        <br/>• **Earlier reference tokens** <code>Dj</code> where <code>τ(j) ≤ ${tau}</code>.
        <br/>• **Future mask slots** <code>\tilde\u007BD\u007Dj</code> where <code>τ(j) > ${tau}</code>. This allows dLLM bidirectional attention layers to compute accurate context representations.`;
    } else if (tok.type === 'mask') {
      const tau = row - 7;
      details = `Mask slot <code>M${tau}</code> is a prediction slot evaluating token logits. To prevent leakage, it can only attend to:
        <br/>• The **Prompt**.
        <br/>• **Earlier reference tokens** <code>Dj</code> where <code>τ(j) &lt; ${tau}</code>.
        <br/>• **Future mask placeholders** <code>\tilde\u007BD\u007Dj</code> where <code>τ(j) ≥ ${tau}</code>.
        <br/>This isolates this slot from future unresolved tokens, producing a valid target prefix distribution.`;
    }
    
    matrixExp.innerHTML = `
      <h4>Query: <span style="color:var(--purple-l); font-weight:bold;">${tok.label}</span></h4>
      <p style="margin-top:0.5rem; line-height:1.55;">${details}</p>
    `;
  }
  
  // Track mouse coordinates
  matrixCanvas.addEventListener('mousemove', (e) => {
    const rect = matrixCanvas.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const y = e.clientY - rect.top;
    
    if (x >= borderLeft && x <= borderLeft + gridW && y >= borderTop && y <= borderTop + gridH) {
      const r = Math.floor((y - borderTop) / cellH);
      if (r !== hoveredRow) {
        hoveredRow = r;
        drawMatrix();
        updateExplanation(hoveredRow);
      }
    } else {
      if (hoveredRow !== -1) {
        hoveredRow = -1;
        drawMatrix();
        updateExplanation(-1);
      }
    }
  });
  
  matrixCanvas.addEventListener('mouseleave', () => {
    hoveredRow = -1;
    drawMatrix();
    updateExplanation(-1);
  });
  
  drawMatrix();
}
</script>
</BaseLayout>

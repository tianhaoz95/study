    extra:      'Previous depth hidden state h^{k-1} concatenated with next token embedding via RMSNorm',
    objective:  'Cross-entropy at each prediction depth; weighted average L_MTP = λ/D Σ L^k_MTP',
    frozen:     'No — MTP modules trained jointly with the main model during pre-training',
    cost:       'D × t_module ≈ t_step for D=1; minimal overhead over single LLM pass',
    per_pass:   'D tokens (one per module; D=1 in practice)',
    tree:       'Sequential predictions; no tree construction in original design',
    innovation: 'Depth-wise sequential module chaining; shared embedding and output head enable end-to-end training with main model',
    limitation: 'D=1 in DS-V3 limits parallelism; purely embedding sharing with no backbone hidden state access at draft time',
  },
  dflash: {
    signal:     'Hidden states from 5 uniformly sampled backbone layers — projected into fresh K/V vectors (not the backbone\'s own cache)',
    layers:     '5 layers, uniformly sampled from depth 2 to depth N-3 (shallow through deep coverage)',
    transform:  'Concat 5h → lightweight projection → context c; c passed through new W_K, W_V at EVERY draft layer (not just input)',
    depth:      '5 transformer layers (8 for some larger models)',
    attention:  'Bidirectional within masked blocks; no cross-block attention; one forward pass per block',
    own_kv:     'Hybrid — target context c projected into fresh K,V at each layer via learned weights; K/V did not exist in backbone',
    strategy:   'Block diffusion — all tokens in a block decoded in parallel in a single forward pass',
    extra:      'Context c injected into K/V of every draft layer (persistent, not diluted with depth)',
    objective:  'Masked language modeling at block level',
    frozen:     'Yes — only draft model trained; backbone frozen',
    cost:       't_parallel (constant; one pass regardless of block size)',
    per_pass:   'Block size (all tokens in block simultaneously)',
    tree:       'Block-based parallel decoding with speculative verification',
    innovation: 'KV injection at every layer prevents signal dilution with depth; block parallelism decouples draft quality from latency',
    limitation: 'Bidirectional within blocks can misalign with causal generation; K/V are freshly projected (extra parameters vs direct cache reuse)',
  },
  peagle: {
    signal:     'Hidden states from 3 backbone layers (identical to EAGLE-3: low/mid/top)',
    layers:     'Same indices as EAGLE-3: 2, L/2, L-1',
    transform:  'Same FC fusion as EAGLE-3: concat [l⊕m⊕h] → FC → g (k-dim); learnable shared h_shared for positions 2..K',
    depth:      '4 transformer decoder layers (vs 1 in EAGLE-3; extra depth compensates for lost autoregressive signal)',
    attention:  'Causal with depth-ordering constraints — all K positions in one pass but no future-draft leakage',
    own_kv:     'Yes — full W_Q, W_K, W_V; own KV cache',
    strategy:   'Parallel single-pass — all K draft tokens generated in one forward pass; no autoregressive rollouts',
    extra:      'Learnable shared hidden state h_shared for all non-first positions (positions 2..K share one learnable vector)',
    objective:  'KL divergence from target; position-aware weighting emphasizes early positions',
    frozen:     'No — token embeddings also unfrozen; model learns to encode mask tokens meaningfully',
    cost:       '1 forward pass (constant; regardless of K)',
    per_pass:   'K tokens (all draft tokens simultaneously)',
    tree:       'Dynamic tree (EAGLE-2 style, confidence-based)',
    innovation: 'Eliminates K sequential passes of EAGLE-3 while preserving identical backbone access; 4-layer depth + h_shared substitute for autoregressive predecessor signal',
    limitation: 'Shared h_shared across positions 2..K is less expressive than per-step predecessor hidden states; 4 layers still runs in one parallel pass',
  },
  dart: {
    signal:     'Hidden states from 3 backbone layers (same as EAGLE-3) plus shifted token embedding of predicted next token',
    layers:     'Same low/mid/top 3 layers as EAGLE-3',
    transform:  'FC fusion [l⊕m⊕h] → g; additionally embed(t_{n+1}) shifted embedding; z = concat(g, e) along feature dimension',
    depth:      '1 transformer decoder layer (same as EAGLE-3)',
    attention:  'Strictly causal over prefix AND within the masked block; no bidirectional refinement; MASK tokens cannot attend forward',
    own_kv:     'Yes — standard decoder layer with own K/V cache',
    strategy:   'MASK-based parallel: input [z_{1:n}, MASK×(d-1)] → single forward pass → d logits simultaneously',
    extra:      'Shifted token embedding e(t_{n+1}) concatenated with FC-fused features g to form z',
    objective:  'Annealed KL divergence: λt = γ^{t-1}, γ=0.6 (exponentially decays weight of distant positions)',
    frozen:     'Yes — backbone frozen; only draft model trained',
    cost:       '1 forward pass → d logits (constant; generates d tokens in one shot)',
    per_pass:   'd logits in one pass (configurable; e.g., d=5)',
    tree:       'N-gram continuity-aware tree pruning (ensures semantic coherence across draft paths)',
    innovation: 'MASK tokens let a causal 1-layer decoder predict d positions in one shot; shifted embedding improves first-position accuracy; N-gram pruning ensures draft tree coherence',
    limitation: 'No iterative refinement; prediction quality degrades for distant positions; single layer capacity same as EAGLE-3',
  },
  gemma4: {
    signal:     "Backbone's own K/V cache — the actual K,V tensors the backbone computed for its own attention (zero extra transformation)",
    layers:     'Last non-sharing SWA layer + last non-sharing full-attention layer (2 specific layers, keyed by type not index)',
    transform:  'None — K/V tensors used directly as-is; backbone already ran K = h·W_K and V = h·W_V; zero extra compute',
    depth:      'Variable (e.g., 4 layers); all layers are KV-sharing layers with no W_K or W_V',
    attention:  'Bidirectional cross-attention (Q-only); K,V fixed from backbone; q_len=1 per draft step',
    own_kv:     'No — no W_K or W_V at all; only W_Q; draft attends to backbone cache directly',
    strategy:   'Sequential q_len=1 per step (same as EAGLE-3) but each step costs ~1/3 less due to missing K/V projections',
    extra:      'Token embedding of previous draft token (autoregressive); RoPE differentiates steps via position',
    objective:  'Standard MTP cross-entropy; backbone and assistant trained jointly',
    frozen:     'Partial — backbone K/V-sharing layers frozen during assistant training',
    cost:       'K × t_draft (~1/3 cheaper per step than EAGLE-3 since no W_K/W_V projections)',
    per_pass:   '1 token per step (sequential, q_len=1)',
    tree:       'Dynamic tree (EAGLE-2 style, confidence-based)',
    innovation: 'Zero-overhead K/V reuse — backbone K,V already existed; draft is simply a Q-lookup into backbone memory; eliminates all K/V projection compute from draft model',
    limitation: 'SWA mask approximation: same window [t_{S-W}..t_S] for all draft steps regardless of absolute draft position; kv_len fixed as backbone grows',
  },
};

let selA = 'eagle3', selB = 'gemma4';

function setPanel(panel, method) {
  const head = document.getElementById(`vis-${panel}-head`);
  const body = document.getElementById(`vis-${panel}-body`);
  const tpl  = document.getElementById(`tpl-${method}`);
  if (!head || !body || !tpl) return;
  head.textContent = NAMES[method];
  head.style.color  = COLORS[method];
  body.innerHTML    = tpl.innerHTML;
}

function renderTable() {
  const thA   = document.getElementById('th-a');
  const thB   = document.getElementById('th-b');
  const tbody = document.getElementById('cmp-tbody');
  if (!thA || !thB || !tbody) return;
  thA.textContent = NAMES[selA];
  thA.style.color  = COLORS[selA];
  thB.textContent = NAMES[selB];
  thB.style.color  = COLORS[selB];

  const dA = DATA[selA], dB = DATA[selB];
  tbody.innerHTML = ROWS.map(row => {
    if (row.group) {
      return `<tr class="group-row"><td colspan="3">${row.group}</td></tr>`;
    }
    const vA = dA[row.id] || '—';
    const vB = dB[row.id] || '—';
    return `<tr>
      <td class="aspect-td">${row.label}</td>
      <td>${vA}</td>
      <td>${vB}</td>
    </tr>`;
  }).join('');
}

function init() {
  // Wire panel A buttons
  document.getElementById('btns-a').querySelectorAll('.sel-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      selA = btn.dataset.method;
      document.getElementById('btns-a').querySelectorAll('.sel-btn').forEach(b => b.classList.toggle('active', b === btn));
      setPanel('a', selA);
      renderTable();
    });
  });

  // Wire panel B buttons
  document.getElementById('btns-b').querySelectorAll('.sel-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      selB = btn.dataset.method;
      document.getElementById('btns-b').querySelectorAll('.sel-btn').forEach(b => b.classList.toggle('active', b === btn));
      setPanel('b', selB);
      renderTable();
    });
  });

  // Initial render
  setPanel('a', selA);
  setPanel('b', selB);
  renderTable();
}

document.addEventListener('DOMContentLoaded', init);
</script>

</BaseLayout>

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { postReadTime } from '../../../lib/readTimes';
const readTime = postReadTime(Astro.url.pathname.split('/').filter(Boolean).at(-1)!);
---
<BaseLayout
  title="Speculative Decoding Methods Compared | Catpuccino.ai"
  description="Side-by-side comparison of EAGLE-3, DeepSeek MTP, DFlash, P-EAGLE, DART, and Gemma 4 MTP — backbone access, draft architecture, inference cost, and core tradeoffs."
  crumb="Speculative Decoding Compared"
>

<style is:global>
/* ── Layout ──────────────────────────────────────────────── */
.cmp-root{max-width:900px;margin:0 auto;padding:2rem 1.5rem 5rem}
.cmp-hero{padding:3.5rem 0 2rem}
.cmp-hero h1{font-size:clamp(1.6rem,4vw,2.2rem);font-weight:700;line-height:1.25;margin-bottom:.75rem}
.cmp-lead{font-size:.95rem;color:var(--muted2);max-width:620px;line-height:1.7}

/* ── Selector ────────────────────────────────────────────── */
.selector-wrap{display:grid;grid-template-columns:1fr auto 1fr;gap:.75rem;align-items:start;background:rgba(255,255,255,.025);border:1px solid var(--border);border-radius:8px;padding:1rem 1.25rem;margin-bottom:1.5rem}
.selector-col-lbl{font-size:.65rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;font-family:var(--ff-mono);color:var(--muted);margin-bottom:.5rem}
.selector-btns{display:flex;flex-wrap:wrap;gap:.4rem}
.sel-btn{font-family:var(--ff-mono);font-size:.67rem;padding:.2rem .55rem;border-radius:3px;border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.04);color:var(--muted2);cursor:pointer;transition:all .15s}
.sel-btn:hover{border-color:rgba(255,255,255,.22);color:var(--text)}
.sel-btn.active{font-weight:700}
.sel-btn[data-method="eagle3"].active   {border-color:#f59e0b;color:#f59e0b;background:rgba(245,158,11,.08)}
.sel-btn[data-method="deepseek"].active {border-color:#10b981;color:#10b981;background:rgba(16,185,129,.08)}
.sel-btn[data-method="dflash"].active   {border-color:#f472b6;color:#f472b6;background:rgba(244,114,182,.08)}
.sel-btn[data-method="peagle"].active   {border-color:#38bdf8;color:#38bdf8;background:rgba(56,189,248,.08)}
.sel-btn[data-method="dart"].active     {border-color:#fb923c;color:#fb923c;background:rgba(251,146,60,.08)}
.sel-btn[data-method="gemma4"].active   {border-color:#a78bfa;color:#a78bfa;background:rgba(167,139,250,.08)}
.selector-vs{display:flex;align-items:center;justify-content:center;font-size:.75rem;color:var(--muted);font-family:var(--ff-mono);padding-top:1.4rem}

/* ── Vis panels ──────────────────────────────────────────── */
.vis-row{display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;margin-bottom:1.5rem}
.vis-panel{background:rgba(255,255,255,.02);border:1px solid var(--border);border-radius:8px;overflow:hidden}
.vis-panel-head{padding:.45rem .75rem;border-bottom:1px solid var(--border);font-size:.68rem;font-family:var(--ff-mono);font-weight:700;letter-spacing:.05em;text-transform:uppercase}
.vis-panel-body{padding:.75rem}
.vis-panel-body svg{width:100%;display:block}

/* ── Papers list ─────────────────────────────────────────── */
.papers-list{display:flex;flex-direction:column;gap:.35rem;margin-bottom:2rem}
.paper-link{display:flex;align-items:baseline;gap:.6rem;font-size:.78rem;color:var(--muted2);text-decoration:none;padding:.3rem .5rem;border-radius:4px;border:1px solid transparent;transition:all .15s;line-height:1.5}
.paper-link:hover{background:rgba(255,255,255,.03);border-color:var(--border);color:var(--text)}
.paper-link .paper-tag{font-family:var(--ff-mono);font-size:.64rem;font-weight:700;letter-spacing:.04em;white-space:nowrap;padding:.1rem .35rem;border-radius:2px;flex-shrink:0}
.paper-link .paper-title{flex:1}
.paper-link .paper-id{font-family:var(--ff-mono);font-size:.65rem;color:var(--muted);flex-shrink:0}

/* ── Comparison table ────────────────────────────────────── */
.cmp-section-title{font-size:.72rem;font-weight:700;letter-spacing:.07em;text-transform:uppercase;font-family:var(--ff-mono);color:var(--muted);margin:2rem 0 .75rem;padding-bottom:.35rem;border-bottom:1px solid var(--border)}
.cmp-table{width:100%;border-collapse:collapse;font-size:.82rem}
.cmp-table th{padding:.45rem .75rem;text-align:left;font-size:.68rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;background:var(--surface);border-bottom:2px solid var(--border);white-space:nowrap}
.cmp-table th.aspect-th{color:var(--muted);width:30%}
.cmp-table td{padding:.5rem .75rem;border-bottom:1px solid rgba(255,255,255,.05);vertical-align:top;line-height:1.6;color:var(--muted2);font-size:.8rem}
.cmp-table tr:hover td{background:rgba(255,255,255,.015)}
.cmp-table td.aspect-td{color:var(--text2);font-weight:600;font-size:.72rem;font-family:var(--ff-mono);white-space:nowrap;padding-top:.65rem}
.cmp-table .group-row td{background:rgba(255,255,255,.04);color:var(--muted);font-size:.67rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:.3rem .75rem;font-family:var(--ff-mono)}
.cmp-table td strong{color:var(--text)}
.cmp-table td em{color:var(--cyan)}

@media(max-width:680px){.vis-row{grid-template-columns:1fr}.selector-wrap{grid-template-columns:1fr;gap:.5rem}.selector-vs{padding-top:0}}
</style>

<div class="cmp-root">
  <div class="cmp-hero">
    <div style="font-size:.7rem;font-family:var(--ff-mono);color:var(--muted);text-transform:uppercase;letter-spacing:.08em;margin-bottom:.6rem">Speculative Decoding · Deep Comparison</div>
    <h1>How Draft Models Access Target Context</h1>
    <p class="cmp-lead">Six speculative decoding systems — EAGLE-3, DeepSeek MTP, DFlash, P-EAGLE, DART, and Gemma 4 MTP — each make a different architectural bet on <em>what signal</em> to take from the target model and <em>how</em> the drafter uses it. Pick any two to compare side-by-side.</p>
  </div>

  <!-- ── Selector ── -->
  <div class="selector-wrap">
    <div>
      <div class="selector-col-lbl">Method A</div>
      <div class="selector-btns" id="btns-a">
        <button class="sel-btn active" data-method="eagle3">EAGLE-3</button>
        <button class="sel-btn" data-method="deepseek">DEEPSEEK MTP</button>
        <button class="sel-btn" data-method="dflash">DFLASH</button>
        <button class="sel-btn" data-method="peagle">P-EAGLE</button>
        <button class="sel-btn" data-method="dart">DART</button>
        <button class="sel-btn" data-method="gemma4">GEMMA 4 MTP</button>
      </div>
    </div>
    <div class="selector-vs">vs</div>
    <div>
      <div class="selector-col-lbl">Method B</div>
      <div class="selector-btns" id="btns-b">
        <button class="sel-btn" data-method="eagle3">EAGLE-3</button>
        <button class="sel-btn" data-method="deepseek">DEEPSEEK MTP</button>
        <button class="sel-btn" data-method="dflash">DFLASH</button>
        <button class="sel-btn" data-method="peagle">P-EAGLE</button>
        <button class="sel-btn" data-method="dart">DART</button>
        <button class="sel-btn active" data-method="gemma4">GEMMA 4 MTP</button>
      </div>
    </div>
  </div>

  <!-- ── Side-by-side visualizations ── -->
  <div class="vis-row">
    <div class="vis-panel" id="vis-a">
      <div class="vis-panel-head" id="vis-a-head">—</div>
      <div class="vis-panel-body" id="vis-a-body"></div>
    </div>
    <div class="vis-panel" id="vis-b">
      <div class="vis-panel-head" id="vis-b-head">—</div>
      <div class="vis-panel-body" id="vis-b-body"></div>
    </div>
  </div>

  <!-- ── Papers ── -->
  <div class="cmp-section-title" style="margin-top:2rem">Papers</div>
  <div class="papers-list">
    <a class="paper-link" href="https://arxiv.org/abs/2503.01840" target="_blank" rel="noopener">
      <span class="paper-tag" style="color:#f59e0b;background:rgba(245,158,11,.08);border:1px solid rgba(245,158,11,.25)">EAGLE-3</span>
      <span class="paper-title">Scaling up Inference Acceleration of Large Language Models via Training-Time Test</span>
      <span class="paper-id">arXiv:2503.01840</span>
    </a>
    <a class="paper-link" href="https://arxiv.org/abs/2412.19437" target="_blank" rel="noopener">
      <span class="paper-tag" style="color:#10b981;background:rgba(16,185,129,.08);border:1px solid rgba(16,185,129,.25)">DEEPSEEK MTP</span>
      <span class="paper-title">DeepSeek-V3 Technical Report</span>
      <span class="paper-id">arXiv:2412.19437</span>
    </a>
    <a class="paper-link" href="https://arxiv.org/abs/2602.06036" target="_blank" rel="noopener">
      <span class="paper-tag" style="color:#f472b6;background:rgba(244,114,182,.08);border:1px solid rgba(244,114,182,.25)">DFLASH</span>
      <span class="paper-title">DFlash: Block Diffusion for Flash Speculative Decoding</span>
      <span class="paper-id">arXiv:2602.06036</span>
    </a>
    <a class="paper-link" href="https://arxiv.org/abs/2602.01469" target="_blank" rel="noopener">
      <span class="paper-tag" style="color:#38bdf8;background:rgba(56,189,248,.08);border:1px solid rgba(56,189,248,.25)">P-EAGLE</span>
      <span class="paper-title">P-EAGLE: Parallel-Drafting EAGLE with Scalable Training</span>
      <span class="paper-id">arXiv:2602.01469</span>
    </a>
    <a class="paper-link" href="https://arxiv.org/abs/2601.19278" target="_blank" rel="noopener">
      <span class="paper-tag" style="color:#fb923c;background:rgba(251,146,60,.08);border:1px solid rgba(251,146,60,.25)">DART</span>
      <span class="paper-title">DART: Diffusion-Inspired Speculative Decoding for Fast LLM Inference</span>
      <span class="paper-id">arXiv:2601.19278</span>
    </a>
    <a class="paper-link" href="https://deepmind.google/models/gemma/gemma-4/" target="_blank" rel="noopener">
      <span class="paper-tag" style="color:#a78bfa;background:rgba(167,139,250,.08);border:1px solid rgba(167,139,250,.25)">GEMMA 4 MTP</span>
      <span class="paper-title">Gemma 4 — Model Page (MTP assistant derived from HF transformers source)</span>
      <span class="paper-id">deepmind.google</span>
    </a>
  </div>

  <!-- ── Comparison table ── -->
  <div class="cmp-section-title">Detailed comparison</div>
  <table class="cmp-table" id="cmp-table">
    <thead>
      <tr>
        <th class="aspect-th">Aspect</th>
        <th id="th-a" style="color:#f59e0b;width:35%">EAGLE-3</th>
        <th id="th-b" style="color:#a78bfa;width:35%">GEMMA 4 MTP</th>
      </tr>
    </thead>
    <tbody id="cmp-tbody"></tbody>
  </table>
</div>

<!-- ── SVG templates (hidden) ── -->
<div style="display:none" aria-hidden="true">

  <!-- EAGLE-3 -->
  <div id="tpl-eagle3">
    <svg viewBox="0 0 280 370" fill="none" xmlns="http://www.w3.org/2000/svg" style="font-family:'JetBrains Mono',monospace">
      <text x="140" y="14" font-size="9" fill="#f59e0b" text-anchor="middle" font-weight="700" letter-spacing=".5">EAGLE-3</text>
      <!-- Backbone -->
      <rect x="8" y="20" width="162" height="84" rx="5" fill="rgba(139,92,246,.07)" stroke="rgba(139,92,246,.25)"/>
      <text x="89" y="34" font-size="8" fill="#a78bfa" text-anchor="middle" font-weight="600">Backbone  (N layers)</text>
      <rect x="16" y="39" width="146" height="13" rx="2" fill="rgba(96,165,250,.1)" stroke="rgba(96,165,250,.35)"/>
      <text x="89" y="49.5" font-size="7" fill="#93c5fd" text-anchor="middle" font-weight="600">layer 2 (shallow)  ← l</text>
      <rect x="16" y="56" width="146" height="13" rx="2" fill="rgba(167,139,250,.1)" stroke="rgba(167,139,250,.35)"/>
      <text x="89" y="66.5" font-size="7" fill="#c4b5fd" text-anchor="middle" font-weight="600">layer L/2 (mid)  ← m</text>
      <rect x="16" y="73" width="146" height="13" rx="2" fill="rgba(245,158,11,.1)" stroke="rgba(245,158,11,.35)"/>
      <text x="89" y="83.5" font-size="7" fill="#f59e0b" text-anchor="middle" font-weight="600">layer L-1 (top)  ← h</text>
      <text x="89" y="100" font-size="6.5" fill="#64748b" text-anchor="middle">3 layers  ·  concat → 3k-dim vector</text>
      <!-- Arrow to FC -->
      <line x1="89" y1="104" x2="89" y2="114" stroke="rgba(245,158,11,.5)" stroke-width="1.5"/>
      <!-- FC box -->
      <rect x="16" y="114" width="146" height="18" rx="3" fill="rgba(245,158,11,.1)" stroke="rgba(245,158,11,.4)"/>
      <text x="89" y="127" font-size="7.5" fill="#f59e0b" text-anchor="middle" font-weight="600">FC  [l ⊕ m ⊕ h]  →  g</text>
      <text x="174" y="127" font-size="6" fill="#64748b">3k→k</text>
      <!-- Arrow to draft + left embed input -->
      <line x1="89" y1="132" x2="89" y2="150" stroke="rgba(245,158,11,.5)" stroke-width="1.5"/>
      <polygon points="85,146 89,153 93,146" fill="rgba(245,158,11,.7)"/>
      <text x="144" y="141" font-size="6.5" fill="#f59e0b">g  fused</text>
      <text x="144" y="150" font-size="6" fill="#64748b">(not K/V)</text>
      <line x1="8" y1="173" x2="24" y2="173" stroke="rgba(245,158,11,.5)" stroke-width="1.2"/>
      <polygon points="21,170 27,173 21,176" fill="rgba(245,158,11,.6)"/>
      <text x="6" y="166" font-size="6" fill="#f59e0b" text-anchor="end">embed</text>
      <text x="6" y="175" font-size="6" fill="#f59e0b" text-anchor="end">(prev)</text>
      <!-- Draft box -->
      <rect x="8" y="153" width="162" height="66" rx="5" fill="rgba(6,182,212,.06)" stroke="rgba(6,182,212,.22)"/>
      <text x="89" y="170" font-size="8" fill="#06b6d4" text-anchor="middle" font-weight="600">Draft Transformer</text>
      <text x="89" y="182" font-size="7" fill="#64748b" text-anchor="middle">1 layer  ·  own W_Q, W_K, W_V</text>
      <text x="89" y="193" font-size="7" fill="#64748b" text-anchor="middle">causal attention</text>
      <text x="89" y="204" font-size="7" fill="#64748b" text-anchor="middle">builds own KV cache</text>
      <text x="89" y="215" font-size="7" fill="#f59e0b" text-anchor="middle" font-weight="600">→ 1 token per step</text>
      <!-- Output -->
      <line x1="89" y1="219" x2="89" y2="229" stroke="rgba(6,182,212,.4)" stroke-width="1.2"/>
      <polygon points="85,226 89,232 93,226" fill="rgba(6,182,212,.6)"/>
      <rect x="8" y="231" width="162" height="32" rx="4" fill="rgba(245,158,11,.04)" stroke="rgba(245,158,11,.18)"/>
      <text x="89" y="244" font-size="7" fill="#f59e0b" text-anchor="middle" font-weight="600">K sequential passes  →  K tokens</text>
      <text x="89" y="256" font-size="6.5" fill="#64748b" text-anchor="middle">dynamic draft tree (EAGLE-2 style)</text>
      <!-- Stats -->
      <line x1="8" y1="271" x2="272" y2="271" stroke="rgba(255,255,255,.06)" stroke-width="1"/>
      <text x="14" y="283" font-size="6.5" fill="#64748b">Signal</text><text x="60" y="283" font-size="6.5" fill="#f59e0b">3-layer hidden states</text>
      <text x="14" y="294" font-size="6.5" fill="#64748b">Draft</text><text x="60" y="294" font-size="6.5" fill="#f59e0b">1 layer · causal · own KV</text>
      <text x="14" y="305" font-size="6.5" fill="#64748b">Cost</text><text x="60" y="305" font-size="6.5" fill="#f59e0b">K passes (linear)</text>
      <text x="14" y="316" font-size="6.5" fill="#64748b">Tree</text><text x="60" y="316" font-size="6.5" fill="#f59e0b">dynamic (confidence-based)</text>
    </svg>
  </div>

  <!-- DeepSeek MTP -->
  <div id="tpl-deepseek">
    <svg viewBox="0 0 280 370" fill="none" xmlns="http://www.w3.org/2000/svg" style="font-family:'JetBrains Mono',monospace">
      <text x="140" y="14" font-size="9" fill="#10b981" text-anchor="middle" font-weight="700" letter-spacing=".5">DEEPSEEK MTP</text>
      <!-- Main model -->
      <rect x="8" y="20" width="264" height="30" rx="5" fill="rgba(139,92,246,.07)" stroke="rgba(139,92,246,.22)"/>
      <text x="140" y="32" font-size="8" fill="#a78bfa" text-anchor="middle" font-weight="600">Main Model</text>
      <text x="140" y="44" font-size="6.5" fill="#64748b" text-anchor="middle">shared Emb  ·  shared OutHead  ·  h⁰ (hidden state from last layer)</text>
      <!-- Arrow h0 -->
      <line x1="140" y1="50" x2="140" y2="60" stroke="rgba(16,185,129,.5)" stroke-width="1.3"/>
      <polygon points="136,57 140,63 144,57" fill="rgba(16,185,129,.7)"/>
      <text x="162" y="58" font-size="7" fill="#10b981">h⁰</text>
      <!-- MTP Module 1 -->
      <rect x="8" y="62" width="264" height="96" rx="5" fill="rgba(16,185,129,.05)" stroke="rgba(16,185,129,.28)"/>
      <text x="140" y="76" font-size="7.5" fill="#10b981" text-anchor="middle" font-weight="600">MTP Module 1  (predicts t+1)</text>
      <line x1="14" y1="80" x2="266" y2="80" stroke="rgba(16,185,129,.12)" stroke-width="1"/>
      <rect x="16" y="84" width="248" height="13" rx="2" fill="rgba(16,185,129,.08)" stroke="rgba(16,185,129,.2)"/>
      <text x="140" y="94" font-size="6.5" fill="#a3e635" text-anchor="middle">RMSNorm(h⁰)  ⊕  RMSNorm(Emb(t_next))</text>
      <line x1="140" y1="97" x2="140" y2="103" stroke="rgba(16,185,129,.3)" stroke-width="1"/>
      <rect x="44" y="103" width="192" height="12" rx="2" fill="rgba(16,185,129,.08)" stroke="rgba(16,185,129,.2)"/>
      <text x="140" y="113" font-size="6.5" fill="#10b981" text-anchor="middle">Linear Proj Mk  (2d → d)</text>
      <line x1="140" y1="115" x2="140" y2="121" stroke="rgba(16,185,129,.3)" stroke-width="1"/>
      <rect x="44" y="121" width="192" height="12" rx="2" fill="rgba(16,185,129,.08)" stroke="rgba(16,185,129,.2)"/>
      <text x="140" y="131" font-size="6.5" fill="#10b981" text-anchor="middle">Transformer Block TRM_1</text>
      <line x1="140" y1="133" x2="140" y2="139" stroke="rgba(16,185,129,.3)" stroke-width="1"/>
      <rect x="44" y="139" width="192" height="12" rx="2" fill="rgba(16,185,129,.08)" stroke="rgba(16,185,129,.2)"/>
      <text x="140" y="149" font-size="6.5" fill="#a3e635" text-anchor="middle">shared OutHead  →  P(t+1)</text>
      <!-- Arrow h1 (chaining) -->
      <line x1="140" y1="158" x2="140" y2="168" stroke="#10b981" stroke-width="2"/>
      <polygon points="135,164 140,171 145,164" fill="#10b981"/>
      <text x="162" y="166" font-size="7.5" fill="#10b981" font-weight="600">h¹  M1→M2</text>
      <!-- MTP Module 2 abbreviated -->
      <rect x="8" y="170" width="264" height="34" rx="5" fill="rgba(16,185,129,.05)" stroke="rgba(16,185,129,.28)"/>
      <text x="140" y="183" font-size="7.5" fill="#10b981" text-anchor="middle" font-weight="600">MTP Module 2  (predicts t+2)</text>
      <text x="140" y="197" font-size="6.5" fill="#a3e635" text-anchor="middle">RMSNorm(h¹)  ⊕  RMSNorm(Emb(t_next2))  →  Proj  →  TRM  →  h²</text>
      <text x="140" y="210" font-size="6.5" fill="#64748b" text-anchor="middle">→  M3(h²)  →  ···   (D=1 in DS-V3)</text>
      <!-- Stats -->
      <line x1="8" y1="225" x2="272" y2="225" stroke="rgba(255,255,255,.06)" stroke-width="1"/>
      <text x="14" y="237" font-size="6.5" fill="#64748b">Signal</text><text x="60" y="237" font-size="6.5" fill="#10b981">shared Emb + OutHead + h^k chain</text>
      <text x="14" y="248" font-size="6.5" fill="#64748b">Draft</text><text x="60" y="248" font-size="6.5" fill="#10b981">D modules · own K/V · causal</text>
      <text x="14" y="259" font-size="6.5" fill="#64748b">Cost</text><text x="60" y="259" font-size="6.5" fill="#10b981">D × t_module  (D=1 in DS-V3)</text>
      <text x="14" y="270" font-size="6.5" fill="#64748b">Tree</text><text x="60" y="270" font-size="6.5" fill="#10b981">sequential predictions (no tree)</text>
    </svg>
  </div>

  <!-- DFlash -->
  <div id="tpl-dflash">
    <svg viewBox="0 0 280 370" fill="none" xmlns="http://www.w3.org/2000/svg" style="font-family:'JetBrains Mono',monospace">
      <text x="140" y="14" font-size="9" fill="#f472b6" text-anchor="middle" font-weight="700" letter-spacing=".5">DFLASH</text>
      <!-- Backbone -->
      <rect x="8" y="20" width="162" height="92" rx="5" fill="rgba(139,92,246,.07)" stroke="rgba(139,92,246,.22)"/>
      <text x="89" y="34" font-size="8" fill="#a78bfa" text-anchor="middle" font-weight="600">Backbone</text>
      <rect x="16" y="39" width="146" height="12" rx="2" fill="rgba(244,114,182,.1)" stroke="rgba(244,114,182,.35)"/>
      <text x="89" y="49" font-size="7" fill="#f472b6" text-anchor="middle" font-weight="600">h₁  (layer 2, shallow)</text>
      <rect x="16" y="55" width="146" height="12" rx="2" fill="rgba(244,114,182,.1)" stroke="rgba(244,114,182,.35)"/>

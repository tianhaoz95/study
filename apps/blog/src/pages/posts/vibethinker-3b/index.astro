<span class="cs-line hl-g">IFEval  = 93.4   # instruction following</span>
<span class="cs-line hl-g">IFBench = 74.5   # harder IF benchmark</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># CLR boosts (test-time scaling, K=32):</span>
<span class="cs-line cmt">#   AIME25:  91.4 → 96.7</span>
<span class="cs-line cmt">#   AIME26:  94.3 → 97.1</span>
<span class="cs-line cmt">#   HMMT25:  89.3 → 95.4</span>
<span class="cs-line cmt">#   BruMO25: 93.8 → 99.2</span>
<span class="cs-line cmt">#   IMO-Ans: 76.4 → 80.6</span>
<span class="cs-line cmt">#   GPQA-D:  70.2 → 72.9</span>
      </pre>
    </div>

  </div>
</aside>

</div><!-- /post-grid -->

<script>
// ── TOC + sidebar toggles ──
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});
const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ── Code sidebar tab switching ──
const tabMeta = {
  bottleneck: { file: 'vibethinker/intro.py',      title: 'The Scaling Assumption' },
  hypothesis: { file: 'vibethinker/hypothesis.py', title: 'Two Kinds of Capability' },
  pipeline:   { file: 'vibethinker/pipeline.py',   title: 'Spectrum-to-Signal Pipeline' },
  mgpo:       { file: 'vibethinker/mgpo.py',       title: 'MGPO Algorithm' },
  clr:        { file: 'vibethinker/clr.py',        title: 'Claim-Level Reliability' },
  results:    { file: 'vibethinker/results.py',    title: 'Results' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ── IntersectionObserver ──
const sectionMap = {
  's-bottleneck': 'bottleneck',
  's-hypothesis': 'hypothesis',
  's-pipeline':   'pipeline',
  's-mgpo':       'mgpo',
  's-clr':        'clr',
  's-results':    'results',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ── §01: Parameter efficiency canvas ──
(function() {
  const canvas = document.getElementById('efficiency-canvas');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 320;
  canvas.width = W * DPR; canvas.height = H * DPR;
  const ctx = canvas.getContext('2d');
  ctx.scale(DPR, DPR);

  // Models: [name, params_B, aime26, color, isVT]
  const models = [
    ['SmolLM3',         3,    41.0,  '#6b7280', false],
    ['Qwen3.5-4B',      4,    84.0,  '#6b7280', false],
    ['OpenReasoning-7B',7,    80.2,  '#6b7280', false],
    ['Ministral-14B',   14,   85.0,  '#6b7280', false],
    ['GPT-OSS-20B',     20,   90.2,  '#6b7280', false],
    ['Nemotron-30B',    30,   90.1,  '#6b7280', false],
    ['GLM-4.5-Air',     106,  83.3,  '#6b7280', false],
    ['Qwen3-235B-MoE',  235,  null,  '#6b7280', false],
    ['DeepSeek V3.2',   671,  94.2,  '#06b6d4', false],
    ['GLM-5',           744,  95.8,  '#06b6d4', false],
    ['Kimi K2.5',       1000, 93.3,  '#06b6d4', false],
    ['VibeThinker-3B',  3,    94.3,  '#8b5cf6', true],
  ];

  const PAD_L = 55, PAD_R = 20, PAD_T = 24, PAD_B = 44;
  const CW = W - PAD_L - PAD_R, CH = H - PAD_T - PAD_B;

  // log scale: 3B → 1000B
  function xPos(params) {
    const logMin = Math.log10(2.5), logMax = Math.log10(1200);
    return PAD_L + (Math.log10(params) - logMin) / (logMax - logMin) * CW;
  }
  function yPos(score) {
    return PAD_T + CH - (score - 30) / (100 - 30) * CH;
  }

  // Grid
  ctx.strokeStyle = 'rgba(255,255,255,0.05)';
  ctx.lineWidth = 1;
  [50,60,70,80,90,100].forEach(s => {
    const y = yPos(s);
    ctx.beginPath(); ctx.moveTo(PAD_L, y); ctx.lineTo(PAD_L + CW, y); ctx.stroke();
    ctx.fillStyle = '#6b7280'; ctx.font = '10px monospace'; ctx.textAlign = 'right';
    ctx.fillText(s, PAD_L - 6, y + 3);
  });
  [3,10,30,100,300,1000].forEach(p => {
    const x = xPos(p);
    ctx.beginPath(); ctx.moveTo(x, PAD_T); ctx.lineTo(x, PAD_T + CH); ctx.stroke();
    ctx.fillStyle = '#6b7280'; ctx.font = '9px monospace'; ctx.textAlign = 'center';
    ctx.fillText(p >= 1000 ? '1T' : p + 'B', x, PAD_T + CH + 14);
  });

  // Frontier band (94–96 range)
  ctx.fillStyle = 'rgba(6,182,212,0.06)';
  ctx.fillRect(PAD_L, yPos(96.5), CW, yPos(92.5) - yPos(96.5));
  ctx.fillStyle = 'rgba(6,182,212,0.3)'; ctx.font = '9px monospace'; ctx.textAlign = 'left';
  ctx.fillText('frontier band', PAD_L + 4, yPos(96.3));

  // Dots
  models.forEach(([name, params, score, color, isVT]) => {
    if (score === null) return;
    const x = xPos(params) + (isVT ? 0 : 0);
    const y = yPos(score);
    const r = isVT ? 8 : 5;
    ctx.beginPath();
    ctx.arc(x, y, r, 0, Math.PI * 2);
    if (isVT) {
      ctx.fillStyle = '#8b5cf6';
      ctx.fill();
      ctx.strokeStyle = '#c4b5fd'; ctx.lineWidth = 2; ctx.stroke();
      // label
      ctx.fillStyle = '#c4b5fd'; ctx.font = 'bold 11px monospace'; ctx.textAlign = 'left';
      ctx.fillText('VibeThinker-3B', x + 11, y + 4);
      ctx.fillStyle = 'rgba(139,92,246,0.3)'; ctx.lineWidth = 0;
      ctx.beginPath(); ctx.arc(x, y, 14, 0, Math.PI * 2); ctx.fill();
    } else {
      ctx.fillStyle = color; ctx.fill();
      if (params >= 100) {
        ctx.fillStyle = '#9ca3af'; ctx.font = '9px monospace'; ctx.textAlign = 'left';
        ctx.fillText(name.split(' ')[0], x + 7, y - 4);
      }
    }
  });

  // Axes labels
  ctx.fillStyle = '#6b7280'; ctx.font = '10px monospace';
  ctx.textAlign = 'center';
  ctx.fillText('Model size (parameters, log scale)', PAD_L + CW / 2, H - 4);
  ctx.save(); ctx.translate(13, PAD_T + CH / 2); ctx.rotate(-Math.PI / 2);
  ctx.fillText('AIME26 score', 0, 0); ctx.restore();
})();

// ── §02: Two Kinds of Capability canvas ──
(function() {
  const canvas = document.getElementById('capability-canvas');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 280;
  canvas.width = W * DPR; canvas.height = H * DPR;
  const ctx = canvas.getContext('2d');
  ctx.scale(DPR, DPR);

  function seededRand(n) { return ((1664525*n+1013904223)&0x7fffffff)/0x7fffffff; }

  const MID = W / 2;
  let focused = null;

  function draw() {
    ctx.clearRect(0, 0, W, H);

    // divider
    ctx.strokeStyle = 'rgba(255,255,255,0.07)';
    ctx.lineWidth = 1; ctx.setLineDash([4, 4]);
    ctx.beginPath(); ctx.moveTo(MID, 10); ctx.lineTo(MID, H - 10); ctx.stroke();
    ctx.setLineDash([]);

    // ── LEFT: Reasoning Core (dense compact cluster) ──
    const LCX = MID * 0.42, LCY = H * 0.5;
    const leftAlpha = focused === 'knowledge' ? 0.25 : 1;
    ctx.globalAlpha = leftAlpha;

    // outer glow
    const grad = ctx.createRadialGradient(LCX, LCY, 0, LCX, LCY, 75);
    grad.addColorStop(0, 'rgba(139,92,246,0.18)');
    grad.addColorStop(1, 'rgba(139,92,246,0)');
    ctx.fillStyle = grad; ctx.beginPath(); ctx.arc(LCX, LCY, 75, 0, Math.PI*2); ctx.fill();

    // nodes — dense cluster
    const leftNodes = Array.from({length:18}, (_, i) => ({
      x: LCX + (seededRand(i*3)*2-1)*42,
      y: LCY + (seededRand(i*3+1)*2-1)*42,
    }));
    // edges
    ctx.strokeStyle = 'rgba(139,92,246,0.35)'; ctx.lineWidth = 1;
    for (let i=0; i<leftNodes.length; i++) {
      for (let j=i+1; j<leftNodes.length; j++) {
        const dx = leftNodes[i].x - leftNodes[j].x;
        const dy = leftNodes[i].y - leftNodes[j].y;
        if (Math.sqrt(dx*dx+dy*dy) < 38) {
          ctx.beginPath(); ctx.moveTo(leftNodes[i].x, leftNodes[i].y);
          ctx.lineTo(leftNodes[j].x, leftNodes[j].y); ctx.stroke();
        }
      }
    }
    // dots
    leftNodes.forEach((n, i) => {
      ctx.beginPath(); ctx.arc(n.x, n.y, i < 3 ? 5 : 3.5, 0, Math.PI*2);
      ctx.fillStyle = i < 3 ? '#8b5cf6' : '#a78bfa'; ctx.fill();
    });

    // labels
    ctx.fillStyle = '#8b5cf6'; ctx.font = 'bold 11px monospace'; ctx.textAlign = 'center';
    ctx.fillText('REASONING CORE', LCX, 22);
    ctx.fillStyle = '#6b7280'; ctx.font = '9px monospace';
    ctx.fillText('compact · dense · reusable', LCX, 36);
    ctx.fillStyle = '#a78bfa'; ctx.font = '10px monospace';
    ctx.fillText('search', LCX - 28, H - 30);
    ctx.fillText('backtrack', LCX + 5, H - 18);
    ctx.fillText('verify', LCX - 30, H - 18);

    // ── RIGHT: Knowledge Coverage (sprawling dots) ──
    const rightAlpha = focused === 'reasoning' ? 0.25 : 1;
    ctx.globalAlpha = rightAlpha;

    const RCX = MID + MID * 0.48, RCY = H * 0.5;
    const rightNodes = Array.from({length:40}, (_, i) => ({
      x: MID + 12 + seededRand(i*5+100) * (MID - 28),
      y: 24 + seededRand(i*5+101) * (H - 52),
    }));
    // sparse edges
    ctx.strokeStyle = 'rgba(6,182,212,0.18)'; ctx.lineWidth = 0.8;
    for (let i=0; i<rightNodes.length; i++) {
      for (let j=i+1; j<rightNodes.length; j++) {
        const dx = rightNodes[i].x - rightNodes[j].x;
        const dy = rightNodes[i].y - rightNodes[j].y;
        if (Math.sqrt(dx*dx+dy*dy) < 50) {
          ctx.beginPath(); ctx.moveTo(rightNodes[i].x, rightNodes[i].y);
          ctx.lineTo(rightNodes[j].x, rightNodes[j].y); ctx.stroke();
        }
      }
    }
    rightNodes.forEach((n, i) => {
      ctx.beginPath(); ctx.arc(n.x, n.y, 2.5, 0, Math.PI*2);
      ctx.fillStyle = i % 5 === 0 ? '#06b6d4' : 'rgba(6,182,212,0.5)'; ctx.fill();
    });

    ctx.fillStyle = '#06b6d4'; ctx.font = 'bold 11px monospace'; ctx.textAlign = 'center';
    ctx.fillText('KNOWLEDGE COVERAGE', MID + (MID / 2), 22);
    ctx.fillStyle = '#6b7280'; ctx.font = '9px monospace';
    ctx.fillText('sprawling · long-tail · expansive', MID + (MID / 2), 36);

    ctx.globalAlpha = 1;
  }
  draw();

  canvas.addEventListener('click', e => {
    const rect = canvas.getBoundingClientRect();
    const cx = (e.clientX - rect.left);
    if (cx < W / 2) focused = focused === 'reasoning' ? null : 'reasoning';
    else             focused = focused === 'knowledge' ? null : 'knowledge';
    draw();
  });
})();

// ── §04: MGPO weight curve ──
(function() {
  const canvas = document.getElementById('mgpo-canvas');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 260;
  canvas.width = W * DPR; canvas.height = H * DPR;
  const ctx = canvas.getContext('2d');
  ctx.scale(DPR, DPR);

  let gamma = 2;

  const PAD_L = 52, PAD_R = 20, PAD_T = 20, PAD_B = 40;
  const CW = W - PAD_L - PAD_R, CH = H - PAD_T - PAD_B;

  function drawCurve(g) {
    ctx.clearRect(0, 0, W, H);
    // Grid
    ctx.strokeStyle = 'rgba(255,255,255,0.05)'; ctx.lineWidth = 1;
    [0, 0.25, 0.5, 0.75, 1].forEach(v => {
      const x = PAD_L + v * CW;
      ctx.beginPath(); ctx.moveTo(x, PAD_T); ctx.lineTo(x, PAD_T + CH); ctx.stroke();
      ctx.fillStyle = '#6b7280'; ctx.font = '10px monospace'; ctx.textAlign = 'center';
      ctx.fillText(v.toFixed(2), x, PAD_T + CH + 16);
    });
    [0, 0.25, 0.5, 0.75, 1].forEach(v => {
      const y = PAD_T + (1 - v) * CH;
      ctx.beginPath(); ctx.moveTo(PAD_L, y); ctx.lineTo(PAD_L + CW, y); ctx.stroke();
      ctx.fillStyle = '#6b7280'; ctx.font = '10px monospace'; ctx.textAlign = 'right';
      ctx.fillText(v.toFixed(2), PAD_L - 6, y + 3);
    });

    // Axis labels
    ctx.fillStyle = '#6b7280'; ctx.font = '10px monospace';
    ctx.textAlign = 'center';
    ctx.fillText('p(q) — empirical accuracy on prompt', PAD_L + CW / 2, H - 4);
    ctx.save(); ctx.translate(13, PAD_T + CH / 2); ctx.rotate(-Math.PI / 2);
    ctx.fillText('w(q) — training weight', 0, 0); ctx.restore();

    // Deadzone regions
    ctx.fillStyle = 'rgba(239,68,68,0.07)';
    ctx.fillRect(PAD_L, PAD_T, CW * 0.12, CH);
    ctx.fillRect(PAD_L + CW * 0.88, PAD_T, CW * 0.12, CH);
    ctx.fillStyle = '#ef4444'; ctx.font = '9px monospace'; ctx.textAlign = 'center';
    ctx.fillText('too hard', PAD_L + CW * 0.06, PAD_T + 14);
    ctx.fillText('too easy', PAD_L + CW * 0.94, PAD_T + 14);

    // Sweet spot
    ctx.fillStyle = 'rgba(139,92,246,0.07)';
    ctx.fillRect(PAD_L + CW * 0.38, PAD_T, CW * 0.24, CH);
    ctx.fillStyle = '#a78bfa'; ctx.font = '9px monospace'; ctx.textAlign = 'center';
    ctx.fillText('capability boundary', PAD_L + CW * 0.5, PAD_T + 14);

    // MGPO curve
    ctx.beginPath();
    for (let i = 0; i <= 200; i++) {
      const p = i / 200;
      // D_ME = KL from p to Bernoulli(0.5): simplified as abs(p - 0.5)^2 * 4
      const d = 4 * Math.pow(p - 0.5, 2);
      const w = Math.exp(-g * d);
      const x = PAD_L + p * CW;
      const y = PAD_T + (1 - w) * CH;
      i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
    }
    ctx.strokeStyle = '#8b5cf6'; ctx.lineWidth = 2.5; ctx.stroke();

    // Peak marker
    ctx.strokeStyle = 'rgba(139,92,246,0.6)'; ctx.lineWidth = 1; ctx.setLineDash([3,3]);
    ctx.beginPath(); ctx.moveTo(PAD_L + CW * 0.5, PAD_T); ctx.lineTo(PAD_L + CW * 0.5, PAD_T + CH); ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle = '#8b5cf6'; ctx.beginPath(); ctx.arc(PAD_L + CW * 0.5, PAD_T, 5, 0, Math.PI*2); ctx.fill();
    ctx.fillStyle = '#c4b5fd'; ctx.font = 'bold 10px monospace'; ctx.textAlign = 'center';
    ctx.fillText('p = 0.5, w = 1.0', PAD_L + CW * 0.5, PAD_T - 6);

    // γ label
    ctx.fillStyle = '#a78bfa'; ctx.font = 'bold 11px monospace'; ctx.textAlign = 'right';
    ctx.fillText('γ = ' + g, PAD_L + CW - 4, PAD_T + 22);
  }

  drawCurve(gamma);

  document.querySelectorAll('#gamma-btns .ctrl-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('#gamma-btns .ctrl-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      gamma = parseFloat(btn.dataset.gamma);
      drawCurve(gamma);
    });
  });
})();

// ── Step navigator: pipeline ──
(function() {
  let step = 0;
  const boxes   = document.querySelectorAll('#pipeline-steps .step-box');
  const prevBtn = document.getElementById('pipeline-prev');
  const nextBtn = document.getElementById('pipeline-next');
  const progEl  = document.getElementById('pipeline-prog');
  function update() {
    boxes.forEach((b, i) => {
      b.classList.remove('active', 'done');
      if (i === step) b.classList.add('active');
      else if (i < step) b.classList.add('done');
    });
    prevBtn.disabled = step === 0;
    nextBtn.disabled = step === boxes.length - 1;
    progEl.textContent = 'Step ' + (step + 1) + ' of ' + boxes.length;
    boxes.forEach((b, i) => {
      const n = b.querySelector('.step-num');
      if (n) n.textContent = i < step ? '✓' : String(i + 1);
    });
  }
  prevBtn?.addEventListener('click', () => { if (step > 0) { step--; update(); } });
  nextBtn?.addEventListener('click', () => { if (step < boxes.length - 1) { step++; update(); } });
  update();
})();


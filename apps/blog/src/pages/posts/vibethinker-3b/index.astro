<span class="cs-line cmt">#   These are ALGORITHMIC, not encyclopedic</span>
<span class="cs-line"> </span>
<span class="cs-line hl-c"><span class="cmt"># Parameter-EXPANSIVE capabilities (coverage)</span></span>
<span class="cs-line hl-c"><span class="cmt"># → knowledge-intensive tasks</span></span>
<span class="cs-line cmt">#   - Open-domain factual QA</span>
<span class="cs-line cmt">#   - GPQA-Diamond (graduate-level science)</span>
<span class="cs-line cmt">#   - Long-tail concept association</span>
<span class="cs-line cmt">#   Core operation: fact recall</span>
<span class="cs-line cmt">#   These REQUIRE breadth → more params</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Prediction:</span>
<span class="cs-line cmt">#   - Math/code ≈ frontier at 3B ✓</span>
<span class="cs-line cmt">#   - GPQA still trails large models ✓</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Reasoning-Knowledge Decoupling Paradigm:</span>
<span class="cs-line cmt">#   Large models → encyclopedic knowledge</span>
<span class="cs-line cmt">#   Small models → frontier reasoning depth</span>
<span class="cs-line cmt">#   Complementary, not competing paths</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-pipeline">
      <pre class="cs-pre">
<span class="cs-line cmt"># Spectrum-to-Signal: 4-stage pipeline</span>
<span class="cs-line cmt"># Base: Qwen2.5-Coder-3B</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="cmt"># Stage 1: SFT Broad Coverage</span></span>
<span class="cs-line cmt"># data = math + code + STEM + chat + IF</span>
<span class="cs-line cmt"># method: Diversity-Exploring Distillation</span>
<span class="cs-line cmt">#   → multiple solution paths per problem</span>
<span class="cs-line cmt">#   → merge domain specialist checkpoints</span>
<span class="cs-line cmt"># 5 epochs, lr=5e-5, cosine anneal</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="cmt"># Stage 2: Hard-Reasoning SFT</span></span>
<span class="cs-line cmt"># filter: trace_len &gt; 5K tokens</span>
<span class="cs-line cmt">#         error_rate &gt; 0.75 (8 rollouts)</span>
<span class="cs-line cmt"># 2 additional epochs on hard subset</span>
<span class="cs-line"> </span>
<span class="cs-line hl-c"><span class="cmt"># Stage 3: Multi-domain Reasoning RL</span></span>
<span class="cs-line cmt"># Math RL → Code RL → STEM RL</span>
<span class="cs-line cmt"># Algorithm: MGPO (see mgpo tab)</span>
<span class="cs-line cmt"># Context: 64K (no progressive expansion)</span>
<span class="cs-line cmt"># Math also gets Long2Short efficiency stage</span>
<span class="cs-line"> </span>
<span class="cs-line hl-g"><span class="cmt"># Stage 4: Self-Distillation + Instruct RL</span></span>
<span class="cs-line cmt"># Collect best trajectories from all RL ckpts</span>
<span class="cs-line cmt"># Filter by learning potential score SLP:</span>
<span class="cs-line cmt">#   SLP = -mean log p_student(y | q)</span>
<span class="cs-line cmt">#   high SLP → trace surprises student</span>
<span class="cs-line cmt">#            → high distillation value</span>
<span class="cs-line cmt"># Then Instruct RL for alignment</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-mgpo">
      <pre class="cs-pre">
<span class="cs-line cmt"># MaxEnt-Guided Policy Optimization (MGPO)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Step 1: Sample G rollouts per prompt</span>
<span class="cs-line cmt"># Step 2: Compute empirical accuracy</span>
<span class="cs-line hl-p">p_q = sum(r_i == 1 for i in G) / G</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Step 3: Compute weight (bell-shaped)</span>
<span class="cs-line cmt"># D_ME = distance from max-entropy point 0.5</span>
<span class="cs-line hl-p">D_ME = abs(p_q - 0.5)  # simplified</span>
<span class="cs-line hl-p">w_q  = exp(-gamma * D_ME)</span>
<span class="cs-line cmt"># peaks at p=0.5, decays toward 0 and 1</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Step 4: Weighted GRPO objective</span>
<span class="cs-line cmt"># A_i = group-relative advantage</span>
<span class="cs-line cmt"># rho_i = token probability ratio</span>
<span class="cs-line hl-c">J = E[ mean_i( min(rho_i * w_q * A_i,</span>
<span class="cs-line hl-c">                    clip(rho_i)*w_q*A_i) ) ]</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Long2Short reward redistribution:</span>
<span class="cs-line cmt"># Only within correct trajectories C</span>
<span class="cs-line cmt"># brevity_i = 1 / len(trajectory_i)</span>
<span class="cs-line hl-a">r_i_prime = r_i + lambda * (</span>
<span class="cs-line hl-a">    (s_i - s_bar) / max(|s_j - s_bar|))</span>
<span class="cs-line hl-a">  # lambda = 0.2, zero-sum over C</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Key insight: sum over C is 0</span>
<span class="cs-line cmt"># Mean reward unchanged → stable training</span>
<span class="cs-line cmt"># But shorter correct answers rewarded more</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-clr">
      <pre class="cs-pre">
<span class="cs-line cmt"># Claim-Level Reliability Assessment (CLR)</span>
<span class="cs-line cmt"># Test-time scaling — no model updates needed</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Step 1: Sample K=32 candidate traces</span>
<span class="cs-line hl-p">traces = model.sample(q, K=32, temp=1.0)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Step 2: Extract M=5 key claims per trace</span>
<span class="cs-line cmt"># "load-bearing" intermediate logical steps</span>
<span class="cs-line hl-c">claims = [extract_claims(t, M=5) for t in traces]</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Step 3: Self-verify each claim</span>
<span class="cs-line cmt"># v in {0, 1} — model tries to falsify</span>
<span class="cs-line hl-c">verdicts = [[model.verify(c) for c in cs]</span>
<span class="cs-line hl-c">            for cs in claims]</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Step 4: Nonlinear reliability score</span>
<span class="cs-line cmt"># r_k = (mean verdicts)^M</span>
<span class="cs-line cmt"># 5/5 correct → 1.0^5 = 1.0</span>
<span class="cs-line cmt"># 4/5 correct → 0.8^5 = 0.33 (penalized!)</span>
<span class="cs-line hl-g">r_k = mean(verdicts[k]) ** M  # M=5</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Step 5: Reliability-weighted majority vote</span>
<span class="cs-line hl-g">score_G = sum(r_k for k if answer[k] in G)</span>
<span class="cs-line hl-g">best_answer = argmax_G(score_G)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Gains vs. standard eval:</span>
<span class="cs-line cmt">#   AIME26:       94.3 → 97.1</span>
<span class="cs-line cmt">#   HMMT25:       89.3 → 95.4</span>
<span class="cs-line cmt">#   IMO-AnswerBench: 76.4 → 80.6</span>
<span class="cs-line cmt">#   GPQA-D:       70.2 → 72.9</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-results">
      <pre class="cs-pre">
<span class="cs-line cmt"># Full benchmark summary</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Math benchmarks (mean Pass@1, 64 samples)</span>
<span class="cs-line hl-p">AIME25  = 91.4   # American Invitational Math Exam</span>
<span class="cs-line hl-p">AIME26  = 94.3   # same, 2026 problems</span>
<span class="cs-line hl-p">HMMT25  = 89.3   # Harvard-MIT Math Tournament</span>
<span class="cs-line hl-p">BruMO25 = 93.8   # Brown Univ Math Olympiad</span>

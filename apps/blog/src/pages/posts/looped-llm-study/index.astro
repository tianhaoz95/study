// ===================== IntersectionObserver: sync TOC + tab =====================
const sectionMap = { 's-intro':'intro','s-loop':'loop','s-halt':'halt','s-tax':'tax','s-free':'free','s-beyond':'beyond','s-outlook':'outlook' };
document.querySelectorAll('.post-body section[id]').forEach(s =>

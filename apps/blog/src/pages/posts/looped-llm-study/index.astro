// ===================== canvas helper =====================
function setupCanvas(id, cssH) {
  const cv = document.getElementById(id);
  if (!cv) return null;
  const W = cv.clientWidth || cv.parentElement.clientWidth;
  const H = cssH;
  const DPR = window.devicePixelRatio || 1;
  cv.width = W * DPR; cv.height = H * DPR;
  cv.style.height = H + 'px';
  const ctx = cv.getContext('2d');
  ctx.scale(DPR, DPR);
  return { ctx, W, H };
}
const COL = {
  text:'#abb2bf', muted:'#6b7280', border:'rgba(255,255,255,.06)',
  grid:'rgba(255,255,255,.05)', purple:'#8b5cf6', purpleL:'#a78bfa',
  cyan:'#06b6d4', green:'#10b981', amber:'#f59e0b', red:'#ef4444',
  surface:'#12121f', card2:'#1a1a2e'
};

// ===================== 1. intro trajectory =====================
(function(){
  const cv = document.getElementById('intro-canvas');
  if (!cv) return;
  let mode = 'open';
  function draw(){
    const r = setupCanvas('intro-canvas', 300);
    const { ctx, W, H } = r;
    ctx.clearRect(0,0,W,H);
    // basins
    const green = { x: W*0.28, y: H*0.62, r: 70 };
    const red   = { x: W*0.78, y: H*0.32, r: 70 };
    function basin(b, col, label){
      const g = ctx.createRadialGradient(b.x,b.y,5,b.x,b.y,b.r);
      g.addColorStop(0, col+'55'); g.addColorStop(1, col+'00');
      ctx.fillStyle = g; ctx.beginPath(); ctx.arc(b.x,b.y,b.r,0,Math.PI*2); ctx.fill();
      ctx.strokeStyle = col+'88'; ctx.lineWidth = 1.5; ctx.stroke();
      ctx.fillStyle = col; ctx.font = '11px monospace'; ctx.textAlign='center';
      ctx.fillText(label, b.x, b.y);
    }
    basin(green, COL.green, 'correct');
    basin(red, COL.red, 'wrong');
    // start point
    const s = { x: W*0.5, y: H*0.92 };
    if (mode === 'open') {
      // drifts past green into red
      const pts = [];
      for (let i=0;i<=30;i++){ const t=i/30;
        const x = s.x + (red.x - s.x)*t + Math.sin(t*3)*18;
        const y = s.y + (red.y - s.y)*t - Math.cos(t*2)*10;
        pts.push([x,y]);
      }
      ctx.strokeStyle = COL.red; ctx.lineWidth = 2; ctx.beginPath();
      pts.forEach((p,i)=> i?ctx.lineTo(p[0],p[1]):ctx.moveTo(p[0],p[1]));
      ctx.stroke();
      pts.forEach((p,i)=>{ if(i%3===0){ ctx.fillStyle=COL.red; ctx.beginPath(); ctx.arc(p[0],p[1],2.5,0,Math.PI*2); ctx.fill(); }});
      ctx.fillStyle = COL.red; ctx.beginPath(); ctx.arc(red.x,red.y-6,4,0,Math.PI*2); ctx.fill();
      ctx.fillStyle = COL.muted; ctx.font='11px monospace'; ctx.textAlign='left';
      ctx.fillText('one forward sweep — drifts past the correct basin', 12, 20);
    } else {
      // spiral into green
      const pts = [];
      for (let i=0;i<=60;i++){ const t=i/60;
        const ang = t*Math.PI*4.2;
        const rad = (1-t)*120;
        const x = green.x + Math.cos(ang)*rad;
        const y = green.y + Math.sin(ang)*rad*0.7;
        pts.push([x,y]);
      }
      ctx.strokeStyle = COL.green; ctx.lineWidth = 2; ctx.beginPath();
      pts.forEach((p,i)=> i?ctx.lineTo(p[0],p[1]):ctx.moveTo(p[0],p[1]));
      ctx.stroke();
      pts.forEach((p,i)=>{ if(i%4===0){ ctx.fillStyle=COL.green; ctx.beginPath(); ctx.arc(p[0],p[1],2.5,0,Math.PI*2); ctx.fill(); }});
      ctx.fillStyle = COL.green; ctx.beginPath(); ctx.arc(green.x,green.y-6,4,0,Math.PI*2); ctx.fill();
      ctx.fillStyle = COL.muted; ctx.font='11px monospace'; ctx.textAlign='left';
      ctx.fillText('same weights revisited — spirals to the fixed point', 12, 20);
    }
    ctx.fillStyle = COL.muted; ctx.textAlign='right'; ctx.font='10px monospace';
    ctx.fillText('start', s.x+10, s.y-6);
  }
  draw();
  cv.parentElement.querySelectorAll('[data-intro]').forEach(b => b.addEventListener('click', () => {
    cv.parentElement.querySelectorAll('[data-intro]').forEach(x=>x.classList.remove('active'));
    b.classList.add('active');
    mode = b.dataset.intro;
    draw();
  }));
  window.addEventListener('resize', draw);
})();

// ===================== 2. architecture SVG =====================

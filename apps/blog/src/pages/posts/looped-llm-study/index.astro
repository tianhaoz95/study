  svg.appendChild(el('rect',{x:rx,y:100,width:rw,height:44,rx:6,fill:'rgba(139,92,246,.2)',stroke:COL.purple,'stroke-width':1.5}));
  svg.appendChild(el('text',{x:rx+rw/2,y:120,'text-anchor':'middle','font-size':11,'font-family':'monospace',fill:COL.purpleL},'mid-block F_θ'));

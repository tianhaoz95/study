<div class="cs-panel" id="panel-halt">
<pre class="cs-pre">
<span class="cs-line cmt"># §03 — four halting strategies</span>
<span class="cs-line cmt"># (a) fixed S</span>
<span class="cs-line"><span class="kw">for</span> t <span class="kw">in</span> <span class="fn">range</span>(S):  h = F(h)</span>
<span class="cs-line cmt"># (b) ACT — per-position halt (Universal Transformer)</span>
<span class="cs-line hl-p"><span class="kw">while</span> <span class="fn">any</span>(not halted):</span>
<span class="cs-line">    h = F(h)</span>
<span class="cs-line">    halt_prob = ponder(h)       <span class="cmt"># per token</span></span>
<span class="cs-line">    halted |= (rand() &lt; halt_prob)</span>
<span class="cs-line cmt"># (c) fixed-point — halt on convergence (FPRM)</span>
<span class="cs-line hl-c"><span class="kw">while</span> <span class="fn">norm</span>(h_new - h) &gt; eps:</span>
<span class="cs-line hl-c">    h = F(h)                    <span class="cmt"># self-terminates</span></span>
<span class="cs-line cmt"># (d) elastic — any budget at inference (LoopFormer)</span>
<span class="cs-line hl-g">h = F(h, budget=B)             <span class="cmt"># shortcut-consistency</span></span>
<span class="cs-line cmt">#</span>
<span class="cs-line cmt"># LoopMDM adaptive: S_max=12 → S̄=5.1 (ε=0.1)</span>
<span class="cs-line">  acc 41.4 → 41.3   <span class="cmt"># 2.4× compute cut, free</span></span>
</pre>

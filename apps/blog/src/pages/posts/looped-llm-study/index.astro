  // loop arrow (curved, above mid block)
  const path = el('path',{d:`M ${rx+rw-20} 100 q 40 -20 0 -36 q -40 16 0 36`,fill:'none',stroke:COL.purple,'stroke-width':1.5,'marker-end':'url(#arr)'});
  svg.appendChild(el('defs',{})).appendChild(el('marker',{id:'arr',viewBox:'0 0 10 10',refX:8,refY:5,markerWidth:6,markerHeight:6,orient:'auto'})).appendChild(el('path',{d:'M0,0 L10,5 L0,10 z',fill:COL.purple}));
  svg.appendChild(path);
  svg.appendChild(el('text',{x:rx+rw+14,y:78,'text-anchor':'middle','font-size':10,'font-family':'monospace',fill:COL.purpleL},'× S'));
  // connectors
  svg.appendChild(el('line',{x1:rx+rw/2,y1:74,x2:rx+rw/2,y2:100,stroke:COL.muted,'stroke-width':1}));
  svg.appendChild(el('line',{x1:rx+rw/2,y1:144,x2:rx+rw/2,y2:170,stroke:COL.muted,'stroke-width':1}));
  // tail
  svg.appendChild(el('rect',{x:rx,y:170,width:rw,height:24,rx:5,fill:'rgba(16,185,129,.18)',stroke:COL.green}));
  svg.appendChild(el('text',{x:rx+rw/2,y:186,'text-anchor':'middle','font-size':11,'font-family':'monospace',fill:COL.green},'Tail (1×)'));
  svg.appendChild(el('text',{x:rx+rw/2,y:30,'text-anchor':'middle','font-size':11,'font-family':'monospace',fill:COL.muted},'looped · head/mid×S/tail'));
  svg.appendChild(el('text',{x:rx+rw/2,y:215,'text-anchor':'middle','font-size':10,'font-family':'monospace',fill:COL.muted},'~2 × params (reused)'));
  svg.appendChild(el('text',{x:rx+rw/2,y:230,'text-anchor':'middle','font-size':10,'font-family':'monospace',fill:COL.purpleL},'effective depth = 1 + S + 1'));
  // vs label
  svg.appendChild(el('text',{x:325,y:150,'text-anchor':'middle','font-size':13,'font-family':'monospace',fill:COL.muted},'vs'));
})();
/*SCRIPT_BODY_2*/
// ===================== 3. halting line chart =====================
(function(){
  const cv = document.getElementById('halt-canvas');
  if (!cv) return;
  let S = 6;
  function curve(strategy, s){
    // returns accuracy at loop count s
    if (strategy === 'fixed')    return 0.62 + 0.23*(1 - Math.exp(-s/3.5));        // saturates ~0.85
    if (strategy === 'act')      return 0.66 + 0.24*(1 - Math.exp(-s/2.4));        // faster rise ~0.90
    if (strategy === 'fixedpt')  return 0.64 + 0.27*(1 - Math.exp(-(s*s)/22));     // highest ~0.91
    return 0;
  }
  const fixedPtConv = 7; // convergence point for fixed-point marker
  function draw(){
    const r = setupCanvas('halt-canvas', 320);
    const { ctx, W, H } = r;
    ctx.clearRect(0,0,W,H);
    const pad = { l: 44, r: 18, t: 20, b: 44 };
    const pw = W - pad.l - pad.r, ph = H - pad.t - pad.b;
    // grid + axes
    ctx.strokeStyle = COL.grid; ctx.lineWidth = 1;
    ctx.fillStyle = COL.muted; ctx.font = '10px monospace';
    for (let s=0; s<=12; s+=2){
      const x = pad.l + (s/12)*pw;
      ctx.beginPath(); ctx.moveTo(x, pad.t); ctx.lineTo(x, pad.t+ph); ctx.stroke();
      ctx.textAlign='center'; ctx.fillText(s, x, pad.t+ph+16);
    }
    for (let v=0.5; v<=1.0; v+=0.1){
      const y = pad.t + ph - (v-0.5)/0.5 * ph;
      ctx.beginPath(); ctx.moveTo(pad.l, y); ctx.lineTo(pad.l+pw, y); ctx.stroke();
      ctx.textAlign='right'; ctx.fillText(v.toFixed(1), pad.l-6, y+3);
    }
    ctx.textAlign='center'; ctx.fillText('loop count S', pad.l+pw/2, H-8);
    ctx.save(); ctx.translate(12, pad.t+ph/2); ctx.rotate(-Math.PI/2); ctx.fillText('accuracy', 0, 0); ctx.restore();
    // axis line
    ctx.strokeStyle = COL.muted; ctx.beginPath(); ctx.moveTo(pad.l,pad.t); ctx.lineTo(pad.l,pad.t+ph); ctx.lineTo(pad.l+pw,pad.t+ph); ctx.stroke();
    function plot(strategy, color, label){
      ctx.strokeStyle = color; ctx.lineWidth = 2; ctx.beginPath();
      for (let s=1; s<=12; s++){
        const x = pad.l + (s/12)*pw;
        const y = pad.t + ph - (curve(strategy,s)-0.5)/0.5 * ph;
        s===1 ? ctx.moveTo(x,y) : ctx.lineTo(x,y);
      }
      ctx.stroke();
      // label at end
      const x = pad.l + pw; const y = pad.t + ph - (curve(strategy,12)-0.5)/0.5*ph;
      ctx.fillStyle = color; ctx.textAlign='left'; ctx.fillText(label, x-30, y-8);
    }
    plot('fixed', COL.muted, 'fixed-S');
    plot('act', COL.cyan, 'ACT');
    plot('fixedpt', COL.green, 'fixed-point');
    // fixed-point convergence marker
    const cx = pad.l + (fixedPtConv/12)*pw;
    const cy = pad.t + ph - (curve('fixedpt',fixedPtConv)-0.5)/0.5*ph;
    ctx.fillStyle = COL.green; ctx.beginPath(); ctx.arc(cx,cy,5,0,Math.PI*2); ctx.fill();
    ctx.strokeStyle = COL.green+'66'; ctx.beginPath(); ctx.arc(cx,cy,9,0,Math.PI*2); ctx.stroke();
    ctx.fillStyle = COL.green; ctx.textAlign='center'; ctx.font='9px monospace';
    ctx.fillText('‖Δh‖<ε', cx, cy-12);
    // selected S vertical line
    const sx = pad.l + (S/12)*pw;
    ctx.strokeStyle = COL.purpleL+'aa'; ctx.lineWidth = 1.5; ctx.setLineDash([4,4]);
    ctx.beginPath(); ctx.moveTo(sx, pad.t); ctx.lineTo(sx, pad.t+ph); ctx.stroke(); ctx.setLineDash([]);
    // ACT per-position halting dots along bottom (distribution at this S)
    ctx.fillStyle = COL.cyan;
    const n = 14;
    for (let i=0;i<n;i++){
      // each token halts at a different count; spread around S
      const hs = Math.max(1, Math.min(12, S + (i-7)/2));
      const x = pad.l + (hs/12)*pw;
      const y = pad.t + ph + 4 + (i%3)*4;
      ctx.globalAlpha = 0.5; ctx.beginPath(); ctx.arc(x,y,2,0,Math.PI*2); ctx.fill();
    }
    ctx.globalAlpha = 1;
    ctx.fillStyle = COL.purpleL; ctx.textAlign='center'; ctx.font='10px monospace';
    ctx.fillText('S='+S, sx, pad.t+12);
  }
  draw();
  cv.parentElement.querySelectorAll('[data-halt-s]').forEach(b => b.addEventListener('click', () => {
    cv.parentElement.querySelectorAll('[data-halt-s]').forEach(x=>x.classList.remove('active'));
    b.classList.add('active');
    S = parseInt(b.dataset.haltS,10);
    draw();
  }));
  window.addEventListener('resize', draw);
})();

// ===================== 4. taxonomy scatter =====================
(function(){
  const cv = document.getElementById('tax-canvas');
  if (!cv) return;
  const papers = [
    { x:0.30, y:0.15, c:COL.cyan,   name:'Universal Transformer',  mech:'Shared encoder layer + ACT. Turing-complete. The original looped LLM (2018).' },
    { x:0.10, y:0.16, c:COL.cyan,   name:'Programmable (Giannou)', mech:'13-layer loop executes programs: calculator, linear algebra, backprop-in-context.' },
    { x:0.10, y:0.40, c:COL.purple, name:'Hyperloop',              mech:'begin/middle/end + matrix-valued hyper-connections at loop boundaries. ~50% fewer params.' },
    { x:0.22, y:0.44, c:COL.purple, name:'LoopMDM',                mech:'Shared mid-block over a masked-diffusion token grid. 3.34× fewer FLOPs.' },
    { x:0.50, y:0.40, c:COL.green,  name:'FPRM',                   mech:'Fixed-point convergence halting + pre-norm/residual scaling for stability.' },
    { x:0.50, y:0.86, c:COL.green,  name:'EqT / Closed-Loop',      mech:'Iterative latent equilibrium via energy minimization. MAP inference. Parity +8%.' },
    { x:0.70, y:0.40, c:COL.amber,  name:'LoopFormer',             mech:'Elastic-depth, shortcut-consistency training — any loop budget at inference. ICLR 2026.' },
    { x:0.90, y:0.66, c:COL.red,    name:'Training-Free LT',       mech:'Frozen pretrained block as Euler step; damped sub-steps. Zero training. +2.64pp Qwen3-4B.' },
    { x:0.90, y:0.60, c:COL.red,    name:'LoopUS',                 mech:'Post-training recasting of a frozen LLM into a recurrent looped form.' },
  ];
  const detail = document.getElementById('tax-detail');
  function draw(){
    const r = setupCanvas('tax-canvas', 440);
    const { ctx, W, H } = r;
    ctx.clearRect(0,0,W,H);
    const pad = { l: 96, r: 30, t: 24, b: 56 };
    const pw = W - pad.l - pad.r, ph = H - pad.t - pad.b;
    // axes labels
    ctx.fillStyle = COL.muted; ctx.font = '10px monospace';
    const xticks = [['Fixed',0.10],['ACT',0.30],['Fixed-point',0.50],['Budget-cond.',0.70],['Training-free',0.90]];
    xticks.forEach(([lab,v])=>{
      const x = pad.l + v*pw;
      ctx.textAlign='center'; ctx.fillText(lab, x, H-36);
      ctx.strokeStyle = COL.grid; ctx.beginPath(); ctx.moveTo(x,pad.t); ctx.lineTo(x,pad.t+ph); ctx.stroke();
    });
    const yticks = [['whole layer',0.15],['mid-block',0.40],['frozen pretrained',0.65],['latent equilibrium',0.88]];
    yticks.forEach(([lab,v])=>{
      const y = pad.t + (1-v)*ph;
      ctx.textAlign='right'; ctx.fillText(lab, pad.l-8, y+3);
      ctx.strokeStyle = COL.grid; ctx.beginPath(); ctx.moveTo(pad.l,y); ctx.lineTo(pad.l+pw,y); ctx.stroke();
    });
    // axis lines
    ctx.strokeStyle = COL.muted; ctx.beginPath();
    ctx.moveTo(pad.l,pad.t); ctx.lineTo(pad.l,pad.t+ph); ctx.lineTo(pad.l+pw,pad.t+ph); ctx.stroke();
    // axis titles
    ctx.fillStyle = COL.muted; ctx.textAlign='center';
    ctx.fillText('how loop count S is decided  →', pad.l+pw/2, H-14);
    ctx.save(); ctx.translate(16, pad.t+ph/2); ctx.rotate(-Math.PI/2);
    ctx.fillText('what is looped  →', 0, 0); ctx.restore();
    // dots
    papers.forEach(p => {
      const x = pad.l + p.x*pw, y = pad.t + (1-p.y)*ph;
      ctx.fillStyle = p.c+'33'; ctx.beginPath(); ctx.arc(x,y,10,0,Math.PI*2); ctx.fill();
      ctx.fillStyle = p.c; ctx.beginPath(); ctx.arc(x,y,5,0,Math.PI*2); ctx.fill();
      ctx.fillStyle = COL.text; ctx.font = '9px monospace'; ctx.textAlign='left';
      ctx.fillText(p.name, x+9, y-7);
    });
  }
  draw();
  cv.addEventListener('click', (e) => {
    const rect = cv.getBoundingClientRect();
    const mx = e.clientX - rect.left, my = e.clientY - rect.top;
    const W = cv.clientWidth, H = 440;
    const pad = { l: 96, r: 30, t: 24, b: 56 };
    const pw = W - pad.l - pad.r, ph = H - pad.t - pad.b;
    let best = null, bd = 18;
    papers.forEach(p => {
      const x = pad.l + p.x*pw, y = pad.t + (1-p.y)*ph;
      const d = Math.hypot(mx-x, my-y);
      if (d < bd) { bd = d; best = p; }
    });
    if (best && detail) detail.innerHTML = '<strong style="color:'+best.c+'">'+best.name+'</strong> — ' + best.mech;
  });
  window.addEventListener('resize', draw);
})();

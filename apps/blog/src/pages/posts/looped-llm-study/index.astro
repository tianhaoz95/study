// ===================== 5. free: divergence vs damped =====================
(function(){
  const cv = document.getElementById('free-canvas');
  if (!cv) return;
  let t = 0, raf = null, playing = false;
  const ITER = 24;
  function normNaive(i){ return 0.2 + Math.exp(i/6.5) * 0.06; }      // blows up
  function normDamped(i){ return 0.2 * (1 - Math.exp(-i/4)) + 0.04; } // settles
  function draw(){
    const r = setupCanvas('free-canvas', 260);
    const { ctx, W, H } = r;
    ctx.clearRect(0,0,W,H);
    const pad = { l: 40, r: 16, t: 16, b: 30 };
    const pw = W-pad.l-pad.r, ph = H-pad.t-pad.b;
    ctx.strokeStyle = COL.grid; ctx.fillStyle = COL.muted; ctx.font='10px monospace';
    for (let i=0;i<=ITER;i+=4){
      const x = pad.l + (i/ITER)*pw;
      ctx.beginPath(); ctx.moveTo(x,pad.t); ctx.lineTo(x,pad.t+ph); ctx.stroke();
      ctx.textAlign='center'; ctx.fillText(i, x, pad.t+ph+16);
    }
    const maxN = normNaive(ITER);
    for (let v=0; v<=1; v+=0.25){
      const y = pad.t + ph - v*ph;
      ctx.strokeStyle = COL.grid; ctx.beginPath(); ctx.moveTo(pad.l,y); ctx.lineTo(pad.l+pw,y); ctx.stroke();
      ctx.textAlign='right'; ctx.fillText((v*maxN).toFixed(1), pad.l-5, y+3);
    }
    ctx.strokeStyle = COL.muted; ctx.beginPath(); ctx.moveTo(pad.l,pad.t); ctx.lineTo(pad.l,pad.t+ph); ctx.lineTo(pad.l+pw,pad.t+ph); ctx.stroke();
    ctx.textAlign='center'; ctx.fillText('iteration', pad.l+pw/2, H-6);
    // plot up to t
    function plot(fn, color){
      ctx.strokeStyle = color; ctx.lineWidth = 2; ctx.beginPath();
      for (let i=0; i<=t; i++){
        const x = pad.l + (i/ITER)*pw;
        const y = pad.t + ph - (fn(i)/maxN)*ph;
        i?ctx.lineTo(x,y):ctx.moveTo(x,y);
      }
      ctx.stroke();
    }
    plot(normNaive, COL.red);
    plot(normDamped, COL.green);
    // labels
    ctx.font='10px monospace';
    ctx.fillStyle = COL.red; ctx.textAlign='left'; ctx.fillText('naive α=1 — diverges', pad.l+8, pad.t+14);
    ctx.fillStyle = COL.green; ctx.fillText('damped α=0.3 — settles', pad.l+8, pad.t+28);
    // sweep line
    const sx = pad.l + (t/ITER)*pw;
    ctx.strokeStyle = COL.purpleL+'aa'; ctx.setLineDash([3,3]); ctx.beginPath();
    ctx.moveTo(sx,pad.t); ctx.lineTo(sx,pad.t+ph); ctx.stroke(); ctx.setLineDash([]);
  }
  function step(){
    t += 0.5;
    if (t > ITER) { t = ITER; playing = false; }
    draw();
    if (playing) raf = requestAnimationFrame(step);
  }
  draw();
  document.getElementById('free-play')?.addEventListener('click', () => {
    if (playing) return;
    playing = true; t = 0; step();
  });
  document.getElementById('free-reset')?.addEventListener('click', () => {
    playing = false; if(raf) cancelAnimationFrame(raf); t = 0; draw();
  });
  window.addEventListener('resize', draw);
})();

// ===================== 6. sudoku grid =====================
(function(){
  const cv = document.getElementById('sudoku-canvas');
  if (!cv) return;
  const sol = [5,3,4,6,7,8,9,1,2, 6,7,2,1,9,5,3,4,8, 1,9,8,3,4,2,5,6,7,
               8,5,9,7,6,1,4,2,3, 4,2,6,8,5,3,7,9,1, 7,1,3,9,2,4,8,5,6,
               9,6,1,5,3,7,2,8,4, 2,8,7,4,1,9,6,3,5, 3,4,5,2,8,6,1,7,9];
  const wrong = {
    1: [0,2,4,9,11,13,18,20,22,27,29,31,36,38,41,45,47,51,54,56,63,65,72,74],
    2: [0,10,20,30,40,50,60],
    3: []
  };
  let S = 3;
  function draw(){
    const r = setupCanvas('sudoku-canvas', 360);
    const { ctx, W, H } = r;
    ctx.clearRect(0,0,W,H);
    const size = Math.min(W, H);
    const ox = (W - size)/2, oy = (H - size)/2;
    const cell = size/9;
    const wset = new Set(wrong[S]);
    for (let i=0;i<81;i++){
      const r0 = Math.floor(i/9), c0 = i%9;
      const x = ox + c0*cell, y = oy + r0*cell;
      const isWrong = wset.has(i);
      ctx.fillStyle = isWrong ? 'rgba(239,68,68,.16)' : 'rgba(16,185,129,.05)';
      ctx.fillRect(x,y,cell,cell);
      // thick block borders
      ctx.strokeStyle = COL.border; ctx.lineWidth = 1;
      ctx.strokeRect(x,y,cell,cell);
      if (c0 % 3 === 0) { ctx.strokeStyle = COL.muted; ctx.lineWidth = 1.5; ctx.beginPath(); ctx.moveTo(x,y); ctx.lineTo(x,y+cell); ctx.stroke(); }
      if (r0 % 3 === 0) { ctx.strokeStyle = COL.muted; ctx.lineWidth = 1.5; ctx.beginPath(); ctx.moveTo(x,y); ctx.lineTo(x+cell,y); ctx.stroke(); }
      const d = isWrong ? ((sol[i])%9)+1 : sol[i];
      ctx.fillStyle = isWrong ? COL.red : COL.green;
      ctx.font = 'bold '+Math.floor(cell*0.5)+'px monospace';
      ctx.textAlign='center'; ctx.textBaseline='middle';
      ctx.fillText(d, x+cell/2, y+cell/2);
    }
    ctx.strokeStyle = COL.muted; ctx.lineWidth = 2; ctx.strokeRect(ox,oy,size,size);
    ctx.textBaseline='alphabetic';
  }
  draw();
  cv.parentElement.querySelectorAll('[data-sudoku]').forEach(b => b.addEventListener('click', () => {
    cv.parentElement.querySelectorAll('[data-sudoku]').forEach(x=>x.classList.remove('active'));
    b.classList.add('active');
    S = parseInt(b.dataset.sudoku,10);
    draw();
  }));
  window.addEventListener('resize', draw);
})();

// ===================== bar-chart IntersectionObserver triggers =====================
function triggerBars(id){
  const el = document.getElementById(id);
  if (!el) return;
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        el.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          b.style.width = (parseFloat(b.dataset.w)) + '%';
        });
      }
    });
  }, { threshold: 0.25 }).observe(el);
}
triggerBars('free-bars');
triggerBars('beyond-bars');
triggerBars('outlook-bars');

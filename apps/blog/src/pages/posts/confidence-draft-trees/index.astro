}

// ─── VIZ 06b: EAGLE lineage timeline canvas ───────────────────────────────────
(function() {
  const canvas = document.getElementById('lineage-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;

  const models = [
    { name: 'Spec Sampling', tau: 2.27, color: 'rgba(6,182,212,0.5)' },
    { name: 'EAGLE-1 (static)', tau: 3.98, color: 'rgba(139,92,246,0.6)' },
    { name: 'EAGLE-2 (confidence)', tau: 4.83, color: 'rgba(139,92,246,0.9)' },
    { name: 'EAGLE-3 (multi-layer)', tau: 6.1,  color: 'rgba(16,185,129,0.85)' },
  ];

  function draw() {
    const W = canvas.clientWidth, H = canvas.clientHeight;
    canvas.width  = W * DPR;
    canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
    ctx.clearRect(0, 0, W, H);

    const pad = { l: 180, r: 20, t: 16, b: 12 };
    const barH = 28, gap = 8;
    const maxTau = 7;
    const cw = W - pad.l - pad.r;

    models.forEach((m, i) => {
      const y = pad.t + i * (barH + gap);
      const bw = (m.tau / maxTau) * cw;

      ctx.fillStyle = m.color;
      ctx.beginPath();
      ctx.roundRect(pad.l, y, bw, barH, 4);
      ctx.fill();

      ctx.fillStyle = 'rgba(255,255,255,0.7)';
      ctx.font = '600 10px var(--ff-mono, monospace)';
      ctx.textAlign = 'right';
      ctx.textBaseline = 'middle';
      ctx.fillText(m.name, pad.l - 8, y + barH / 2);

      ctx.fillStyle = '#fff';
      ctx.font = '700 11px var(--ff-mono, monospace)';
      ctx.textAlign = 'left';
      ctx.fillText('τ = ' + m.tau.toFixed(2), pad.l + bw + 6, y + barH / 2);
    });
  }

  draw();
  window.addEventListener('resize', draw);
})();
</script>

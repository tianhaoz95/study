<span class="cs-line">        draft_tokens, conf <span class="op">=</span> draft_model.<span class="fn">draft</span>(example)</span>
<span class="cs-line">        accepted <span class="op">=</span> target_model.<span class="fn">verify</span>(draft_tokens)</span>
<span class="cs-line">        <span class="kw">for</span> c, a <span class="kw">in</span> <span class="fn">zip</span>(conf, accepted):</span>
<span class="cs-line hl-g">            b <span class="op">=</span> <span class="fn">int</span>(c <span class="op">*</span> n_bins) <span class="op">/</span> n_bins  <span class="cmt"># bin</span></span>
<span class="cs-line hl-g">            bins[b].<span class="fn">append</span>(a)</span>
<span class="cs-line">    <span class="kw">return</span> &#123;b: <span class="fn">mean</span>(v) <span class="kw">for</span> b, v <span class="kw">in</span> bins.<span class="fn">items</span>()&#125;</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Empirical results (Figure 6, EAGLE-2):</span>
<span class="cs-line cmt"># conf bin  |  avg acceptance rate</span>
<span class="cs-line cmt"># 0.00-0.05 |  0.040</span>
<span class="cs-line cmt"># 0.10-0.15 |  0.092</span>
<span class="cs-line cmt"># 0.25-0.30 |  0.261</span>
<span class="cs-line cmt"># 0.50-0.55 |  0.521</span>
<span class="cs-line cmt"># 0.75-0.80 |  0.774</span>
<span class="cs-line cmt"># 0.90-0.95 |  0.912</span>
<span class="cs-line cmt"># 0.95-1.00 |  0.978</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Nearly perfect calibration — confidence is</span>
<span class="cs-line cmt"># a free oracle for acceptance rate</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-algorithm">
      <pre class="cs-pre">
<span class="cs-line cmt"># EAGLE-2: Confidence-guided tree construction</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">path_value</span>(node):</span>
<span class="cs-line hl-p">    <span class="str">"""Product of confidence scores root → node"""</span></span>
<span class="cs-line">    v <span class="op">=</span> <span class="num">1.0</span></span>
<span class="cs-line">    <span class="kw">for</span> ancestor <span class="kw">in</span> node.<span class="fn">get_path_from_root</span>():</span>
<span class="cs-line">        v <span class="op">*=</span> ancestor.confidence</span>
<span class="cs-line">    <span class="kw">return</span> v  <span class="cmt"># ≈ P(node accepted)</span></span>
<span class="cs-line"> </span>
<span class="cs-line hl-c"><span class="kw">def</span> <span class="fn">expand_phase</span>(draft_model, tree, k_expand):</span>
<span class="cs-line hl-c">    <span class="str">"""Expand top-k_expand nodes by path value."""</span></span>
<span class="cs-line">    last_layer <span class="op">=</span> tree.<span class="fn">get_last_layer</span>()</span>
<span class="cs-line">    top_k <span class="op">=</span> <span class="fn">sorted</span>(last_layer,</span>
<span class="cs-line">               key<span class="op">=</span>path_value, reverse<span class="op">=</span><span class="cls">True</span>)[:k_expand]</span>
<span class="cs-line">    <span class="kw">for</span> node <span class="kw">in</span> top_k:</span>
<span class="cs-line">        <span class="cmt"># draft model generates children for top nodes</span></span>
<span class="cs-line">        children <span class="op">=</span> draft_model.<span class="fn">expand</span>(node)</span>
<span class="cs-line">        tree.<span class="fn">add_children</span>(node, children)</span>
<span class="cs-line"> </span>
<span class="cs-line hl-g"><span class="kw">def</span> <span class="fn">rerank_phase</span>(tree, m):</span>
<span class="cs-line hl-g">    <span class="str">"""Select top-m nodes by path value → final draft."""</span></span>
<span class="cs-line">    all_nodes <span class="op">=</span> tree.<span class="fn">all_nodes</span>()</span>
<span class="cs-line">    top_m <span class="op">=</span> <span class="fn">sorted</span>(all_nodes,</span>
<span class="cs-line">               key<span class="op">=</span>path_value, reverse<span class="op">=</span><span class="cls">True</span>)[:m]</span>
<span class="cs-line">    <span class="cmt"># connected tree guaranteed since V_i ≤ V_parent(i)</span></span>
<span class="cs-line">    <span class="kw">return</span> <span class="fn">flatten_tree</span>(top_m)  <span class="cmt"># + attn mask</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Example from EAGLE-2 Figure 7:</span>
<span class="cs-line cmt"># "It" (root)</span>
<span class="cs-line cmt">#  ├─ "is"  c=0.6  V=0.60  ← expanded</span>
<span class="cs-line cmt">#  │   ├─ "a"   c=0.8  V=0.48  ← selected</span>
<span class="cs-line cmt">#  │   │   └─ "good" c=0.7 V=0.34 ← selected</span>
<span class="cs-line cmt">#  │   └─ "the" c=0.1  V=0.06</span>
<span class="cs-line cmt">#  └─ "has" c=0.2  V=0.20  ← expanded</span>
<span class="cs-line cmt">#      ├─ "a"   c=0.7  V=0.14</span>
<span class="cs-line cmt">#      └─ "to"  c=0.1  V=0.02</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-theory">
      <pre class="cs-pre">
<span class="cs-line cmt"># Theory: greedy V_i selection is optimal</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Expected tokens accepted from tree T:</span>
<span class="cs-line cmt"># E[τ | T] = Σ_&#123;i ∈ T&#125; V_i</span>
<span class="cs-line cmt"># (each node contributes V_i in expectation)</span>
<span class="cs-line"> </span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">optimal_tree</span>(candidate_nodes, budget_m):</span>
<span class="cs-line">    <span class="str">"""Select top-m by path value to maximize E[τ].</span></span>
<span class="cs-line"><span class="str">    Provably optimal under i.i.d. acceptance model.</span></span>
<span class="cs-line"><span class="str">    """</span></span>
<span class="cs-line hl-p">    ranked <span class="op">=</span> <span class="fn">sorted</span>(candidate_nodes,</span>
<span class="cs-line hl-p">                     key<span class="op">=</span><span class="kw">lambda</span> n: n.V, reverse<span class="op">=</span><span class="cls">True</span>)</span>
<span class="cs-line">    selected <span class="op">=</span> ranked[:budget_m]</span>
<span class="cs-line">    <span class="kw">return</span> <span class="fn">ensure_connected</span>(selected)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Entropy connection:</span>
<span class="cs-line cmt"># H(pos) = -Σ p_i log p_i  ← entropy at position</span>
<span class="cs-line cmt"># High H → flat distribution → low max confidence</span>
<span class="cs-line cmt"># Low H  → peaked distribution → high max confidence</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># When max_conf &lt; threshold:</span>
<span class="cs-line cmt">#   top-2 V values are comparable → branch both</span>
<span class="cs-line cmt"># When max_conf &gt; threshold:</span>
<span class="cs-line cmt">#   runner-up V ≈ 0 → greedy single-child</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Sequoia (2024) also derives optimal static trees</span>
<span class="cs-line cmt"># via DP assuming position-only acceptance rates.</span>
<span class="cs-line cmt"># EAGLE-2 improves by using context-dependent rates.</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Ablation: value vs confidence (EAGLE-2 Table 3)</span>
<span class="cs-line cmt"># Metric     | By confidence | By value (ours)</span>
<span class="cs-line cmt"># Speedup    |    3.71×      |    4.26×</span>
<span class="cs-line cmt"># Avg τ      |    4.41       |    4.83</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-results">
      <pre class="cs-pre">
<span class="cs-line cmt"># EAGLE-2 Table 1 (excerpt): speedup + avg τ</span>
<span class="cs-line cmt"># Model: Vicuna 13B, temp=1</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Method         MT-bench  HumanEval  GSM8K</span>
<span class="cs-line cmt"># ─────────────────────────────────────────</span>
<span class="cs-line cmt"># Spec sampling  1.93×     2.23×      1.77×</span>
<span class="cs-line cmt"># Medusa         2.07×     2.50×      2.23×</span>
<span class="cs-line cmt"># Hydra          2.88×     3.28×      2.93×</span>
<span class="cs-line cmt"># EAGLE-1        3.07×     3.58×      3.08×</span>
<span class="cs-line hl-g cmt"># EAGLE-2        4.26×     4.96×      4.22×</span>
<span class="cs-line cmt"># ─────────────────────────────────────────</span>
<span class="cs-line cmt"># EAGLE-2 avg τ: 4.83 vs EAGLE-1's 3.98</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Avg acceptance length τ (hardware-independent)</span>
<span class="cs-line cmt"># EAGLE-2 generates 4-5.5 tokens per cycle</span>
<span class="cs-line cmt"># vs ~2x that of standard spec sampling</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># EAGLE-3 (arXiv:2503.01840): up to 6.5× speedup</span>
<span class="cs-line cmt"># Key changes over EAGLE-2:</span>
<span class="cs-line cmt">#   1. Direct token prediction (not feature-level)</span>
<span class="cs-line cmt">#   2. Multi-layer feature fusion at training time</span>
<span class="cs-line cmt">#   3. Larger training data (fixed scalability bug)</span>
<span class="cs-line cmt"># Confidence-guided tree construction unchanged</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># In SGLang (batch=64): 1.38× throughput over EAGLE-2</span>
      </pre>
    </div>

  </div>
</aside>

</div><!-- /post-grid -->

<script>
// ─── TOC + sidebar toggles ───────────────────────────────────────────────────
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});

const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ─── Code sidebar tab switching ──────────────────────────────────────────────
const tabMeta = {
  waste:       { file: 'eagle2/tree.py',        title: 'The Static Tree Problem' },
  primer:      { file: 'eagle2/spec_decode.py',  title: 'Spec-Decoding Primer' },
  calibration: { file: 'eagle2/calibration.py',  title: 'Confidence = Acceptance' },
  algorithm:   { file: 'eagle2/dynamic_tree.py', title: 'The Algorithm' },
  theory:      { file: 'eagle2/theory.py',        title: 'Why It\'s Optimal' },
  results:     { file: 'eagle2/benchmarks.py',   title: 'Results' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ─── IntersectionObserver: TOC + sidebar sync ─────────────────────────────────
const sectionMap = {
  's-waste':       'waste',
  's-primer':      'primer',
  's-calibration': 'calibration',
  's-algorithm':   'algorithm',
  's-theory':      'theory',
  's-results':     'results',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ─── Step navigator (§02) ────────────────────────────────────────────────────
let step = 0;
const boxes  = document.querySelectorAll('#spec-steps .step-box');
const prevBtn = document.getElementById('step-prev');
const nextBtn = document.getElementById('step-next');
const progEl  = document.getElementById('step-prog');
function updateSteps() {
  boxes.forEach((b, i) => {
    b.classList.remove('active', 'done');
    if (i === step) b.classList.add('active');
    else if (i < step) b.classList.add('done');
  });
  if (prevBtn) prevBtn.disabled = step === 0;
  if (nextBtn) nextBtn.disabled = step === boxes.length - 1;
  if (progEl) progEl.textContent = `Step ${step + 1} of ${boxes.length}`;
  boxes.forEach((b, i) => {
    const n = b.querySelector('.step-num');
    if (n) n.textContent = i < step ? '✓' : String(i + 1);
  });
}
prevBtn?.addEventListener('click', () => { if (step > 0) { step--; updateSteps(); } });
nextBtn?.addEventListener('click', () => { if (step < boxes.length - 1) { step++; updateSteps(); } });
updateSteps();

// ─── VIZ 01: Static vs Adaptive Tree Canvas ──────────────────────────────────
(function() {
  const canvas = document.getElementById('tree-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  function resize() {
    const W = canvas.clientWidth, H = canvas.clientHeight;
    canvas.width  = W * DPR;
    canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
    draw();
  }

  // Two trees: EASY context ("10+2=") and HARD context ("The meeting...")
  const CONTEXTS = {
    easy: {
      label: '"10 + 2 = ___"  — next token is certain',
      nodes: [
        // Static tree (left half)
        { x: 0.12, y: 0.15, label: '=', conf: 1.0, depth: 0, side: 'static' },
        { x: 0.06, y: 0.40, label: '12', conf: 0.97, depth: 1, side: 'static' },
        { x: 0.18, y: 0.40, label: '11', conf: 0.02, depth: 1, side: 'static' },
        { x: 0.03, y: 0.65, label: '.', conf: 0.85, depth: 2, side: 'static' },
        { x: 0.09, y: 0.65, label: ' ', conf: 0.10, depth: 2, side: 'static' },
        { x: 0.15, y: 0.65, label: '.', conf: 0.01, depth: 2, side: 'static' },
        { x: 0.21, y: 0.65, label: '?', conf: 0.01, depth: 2, side: 'static' },
        // Adaptive tree (right half)
        { x: 0.62, y: 0.15, label: '=', conf: 1.0, depth: 0, side: 'adapt' },
        { x: 0.62, y: 0.40, label: '12', conf: 0.97, depth: 1, side: 'adapt' },
        { x: 0.62, y: 0.65, label: '.', conf: 0.85, depth: 2, side: 'adapt' },
        { x: 0.62, y: 0.88, label: ' ', conf: 0.80, depth: 3, side: 'adapt' },
        // pruned nodes (shown faded)
        { x: 0.76, y: 0.40, label: '11', conf: 0.02, depth: 1, side: 'adapt', pruned: true },
      ],
      edges: [
        [0,1],[0,2],[1,3],[1,4],[2,5],[2,6],
        [7,8],[8,9],[9,10],
        [7,11],
      ]
    },
    hard: {
      label: '"The meeting will probably ___"  — genuine uncertainty',
      nodes: [
        // Static tree (left half)
        { x: 0.12, y: 0.10, label: 'prob', conf: 1.0, depth: 0, side: 'static' },
        { x: 0.06, y: 0.35, label: 'run', conf: 0.28, depth: 1, side: 'static' },
        { x: 0.18, y: 0.35, label: 'be', conf: 0.25, depth: 1, side: 'static' },
        { x: 0.03, y: 0.60, label: 'until', conf: 0.91, depth: 2, side: 'static' },
        { x: 0.09, y: 0.60, label: 'for', conf: 0.06, depth: 2, side: 'static' },
        { x: 0.15, y: 0.60, label: 'a', conf: 0.45, depth: 2, side: 'static' },
        { x: 0.21, y: 0.60, label: 'the', conf: 0.35, depth: 2, side: 'static' },
        { x: 0.03, y: 0.82, label: '5pm', conf: 0.82, depth: 3, side: 'static' },
        { x: 0.09, y: 0.82, label: 'tmrw', conf: 0.55, depth: 3, side: 'static' },
        // Adaptive tree (right half)
        { x: 0.62, y: 0.10, label: 'prob', conf: 1.0, depth: 0, side: 'adapt' },
        { x: 0.54, y: 0.35, label: 'run', conf: 0.28, depth: 1, side: 'adapt' },
        { x: 0.70, y: 0.35, label: 'be', conf: 0.25, depth: 1, side: 'adapt' },
        { x: 0.54, y: 0.60, label: 'until', conf: 0.91, depth: 2, side: 'adapt' },
        { x: 0.62, y: 0.60, label: 'a', conf: 0.45, depth: 2, side: 'adapt' },
        { x: 0.70, y: 0.60, label: 'the', conf: 0.35, depth: 2, side: 'adapt' },
        { x: 0.54, y: 0.82, label: '5pm', conf: 0.82, depth: 3, side: 'adapt' },
        { x: 0.62, y: 0.82, label: 'noon', conf: 0.10, depth: 3, side: 'adapt', pruned: true },
        { x: 0.70, y: 0.82, label: 'long', conf: 0.55, depth: 3, side: 'adapt' },
        // pruned under "run"
        { x: 0.46, y: 0.60, label: 'for', conf: 0.06, depth: 2, side: 'adapt', pruned: true },
      ],
      edges: [
        [0,1],[0,2],[1,3],[1,4],[2,5],[2,6],[3,7],[4,8],
        [9,10],[9,11],[10,12],[11,13],[11,14],[12,15],[13,16],[14,17],
        [10,18],
      ]
    }
  };

  let currentCtx = 'easy';

  function confColor(conf, pruned) {
    if (pruned) return 'rgba(255,255,255,0.12)';
    if (conf > 0.7) return 'rgba(16,185,129,0.85)';
    if (conf > 0.3) return 'rgba(245,158,11,0.85)';
    return 'rgba(239,68,68,0.85)';
  }

  function draw() {
    const W = canvas.clientWidth, H = canvas.clientHeight;
    ctx.clearRect(0, 0, W, H);

    const data = CONTEXTS[currentCtx];
    const nodes = data.nodes;
    const edges = data.edges;

    // Column headers
    ctx.font = '600 11px var(--ff-mono, monospace)';
    ctx.fillStyle = 'rgba(139,92,246,0.8)';
    ctx.textAlign = 'center';
    ctx.fillText('EAGLE-1 (static tree)', W * 0.12, H * 0.04);

    ctx.fillStyle = 'rgba(16,185,129,0.8)';
    ctx.fillText('EAGLE-2 (confidence-guided)', W * 0.62, H * 0.04);

    // Divider
    ctx.strokeStyle = 'rgba(255,255,255,0.06)';
    ctx.lineWidth = 1;
    ctx.setLineDash([4, 4]);
    ctx.beginPath();
    ctx.moveTo(W * 0.37, H * 0.02);
    ctx.lineTo(W * 0.37, H * 0.98);
    ctx.stroke();
    ctx.setLineDash([]);

    // Edges
    ctx.lineWidth = 1.5;
    edges.forEach(([a, b]) => {
      const na = nodes[a], nb = nodes[b];
      ctx.strokeStyle = nb.pruned ? 'rgba(255,255,255,0.06)' : 'rgba(255,255,255,0.15)';
      ctx.beginPath();
      ctx.moveTo(na.x * W, na.y * H);
      ctx.lineTo(nb.x * W, nb.y * H);
      ctx.stroke();
    });

    // Nodes
    nodes.forEach(nd => {
      const x = nd.x * W, y = nd.y * H, r = 18;
      ctx.beginPath();
      ctx.arc(x, y, r, 0, Math.PI * 2);
      ctx.fillStyle = confColor(nd.conf, nd.pruned);
      ctx.fill();
      if (!nd.pruned) {
        ctx.strokeStyle = 'rgba(255,255,255,0.2)';
        ctx.lineWidth = 1;
        ctx.stroke();
      }
      ctx.fillStyle = nd.pruned ? 'rgba(255,255,255,0.3)' : '#fff';
      ctx.font = `600 10px var(--ff-mono, monospace)`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(nd.label.length > 4 ? nd.label.slice(0, 4) : nd.label, x, y);
      if (!nd.pruned) {
        ctx.font = '9px var(--ff-mono, monospace)';
        ctx.fillStyle = 'rgba(255,255,255,0.5)';
        ctx.fillText(nd.conf.toFixed(2), x, y + r + 9);
      }
    });

    // Context label
    ctx.font = '11px var(--ff-mono, monospace)';
    ctx.fillStyle = 'rgba(255,255,255,0.4)';
    ctx.textAlign = 'center';
    ctx.fillText(data.label, W * 0.5, H * 0.97);
  }

  document.getElementById('ctx-easy')?.addEventListener('click', function() {
    currentCtx = 'easy';
    document.getElementById('ctx-easy').classList.add('active');
    document.getElementById('ctx-hard').classList.remove('active');
    draw();
  });
  document.getElementById('ctx-hard')?.addEventListener('click', function() {
    currentCtx = 'hard';
    document.getElementById('ctx-hard').classList.add('active');
    document.getElementById('ctx-easy').classList.remove('active');
    draw();
  });

  resize();
  window.addEventListener('resize', resize);
})();

// ─── VIZ 03: Calibration scatter ─────────────────────────────────────────────
(function() {
  const canvas = document.getElementById('cal-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;

  // Empirical data from EAGLE-2 Figure 6 (binned, Alpaca, Vicuna 7B)
  const bins = [
    { conf: 0.025, acc: 0.040 },
    { conf: 0.075, acc: 0.075 },
    { conf: 0.125, acc: 0.118 },
    { conf: 0.175, acc: 0.162 },
    { conf: 0.225, acc: 0.215 },
    { conf: 0.275, acc: 0.261 },
    { conf: 0.325, acc: 0.308 },
    { conf: 0.375, acc: 0.366 },
    { conf: 0.425, acc: 0.419 },
    { conf: 0.475, acc: 0.472 },
    { conf: 0.525, acc: 0.521 },
    { conf: 0.575, acc: 0.574 },
    { conf: 0.625, acc: 0.627 },
    { conf: 0.675, acc: 0.672 },
    { conf: 0.725, acc: 0.723 },
    { conf: 0.775, acc: 0.774 },
    { conf: 0.825, acc: 0.822 },
    { conf: 0.875, acc: 0.871 },
    { conf: 0.925, acc: 0.912 },
    { conf: 0.975, acc: 0.978 },
  ];

  function draw() {
    const W = canvas.clientWidth, H = canvas.clientHeight;
    canvas.width  = W * DPR;
    canvas.height = H * DPR;
    ctx.scale(DPR, DPR);

    const pad = { l: 52, r: 20, t: 18, b: 42 };
    const cw = W - pad.l - pad.r;
    const ch = H - pad.t - pad.b;

    ctx.clearRect(0, 0, W, H);

    // Grid lines
    ctx.strokeStyle = 'rgba(255,255,255,0.05)';
    ctx.lineWidth = 1;
    for (let i = 0; i <= 4; i++) {
      const y = pad.t + ch - (i / 4) * ch;
      ctx.beginPath(); ctx.moveTo(pad.l, y); ctx.lineTo(pad.l + cw, y); ctx.stroke();
      const x = pad.l + (i / 4) * cw;
      ctx.beginPath(); ctx.moveTo(x, pad.t); ctx.lineTo(x, pad.t + ch); ctx.stroke();
    }

    // Diagonal reference line (perfect calibration)
    ctx.strokeStyle = 'rgba(239,68,68,0.4)';
    ctx.lineWidth = 1.5;
    ctx.setLineDash([5, 4]);
    ctx.beginPath();
    ctx.moveTo(pad.l, pad.t + ch);
    ctx.lineTo(pad.l + cw, pad.t);
    ctx.stroke();
    ctx.setLineDash([]);

    // Data points
    bins.forEach(b => {
      const x = pad.l + b.conf * cw;
      const y = pad.t + ch - b.acc * ch;
      const r = 5;
      ctx.beginPath();
      ctx.arc(x, y, r, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(139,92,246,0.9)';
      ctx.fill();
      ctx.strokeStyle = 'rgba(139,92,246,0.4)';
      ctx.lineWidth = 1;
      ctx.stroke();
    });

    // Axes
    ctx.strokeStyle = 'rgba(255,255,255,0.2)';
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(pad.l, pad.t); ctx.lineTo(pad.l, pad.t + ch); ctx.lineTo(pad.l + cw, pad.t + ch);
    ctx.stroke();

    ctx.fillStyle = 'rgba(255,255,255,0.45)';
    ctx.font = '10px var(--ff-mono, monospace)';
    ctx.textAlign = 'right';
    for (let i = 0; i <= 4; i++) {
      const y = pad.t + ch - (i / 4) * ch;
      ctx.fillText((i / 4).toFixed(2), pad.l - 5, y + 3);
    }
    ctx.textAlign = 'center';
    for (let i = 0; i <= 4; i++) {
      const x = pad.l + (i / 4) * cw;
      ctx.fillText((i / 4).toFixed(2), x, pad.t + ch + 14);
    }

    ctx.font = '600 10px var(--ff-mono, monospace)';
    ctx.fillStyle = 'rgba(255,255,255,0.35)';
    ctx.textAlign = 'center';
    ctx.fillText('draft model confidence score', pad.l + cw / 2, H - 6);

    ctx.save();
    ctx.translate(13, pad.t + ch / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.textAlign = 'center';
    ctx.fillText('target acceptance rate', 0, 0);
    ctx.restore();

    ctx.fillStyle = 'rgba(239,68,68,0.6)';
    ctx.font = '9px var(--ff-mono, monospace)';
    ctx.textAlign = 'right';
    ctx.fillText('perfect calibration', pad.l + cw - 4, pad.t + 12);
  }

  draw();
  window.addEventListener('resize', draw);
})();

// ─── VIZ 04: Algorithm tree (Expand vs Rerank) ───────────────────────────────
(function() {
  const canvas = document.getElementById('algo-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;

  // From EAGLE-2 Figure 7 — confidence scores on edges, values in nodes
  // Node format: {id, x, y, label, conf, value, generated, selected, pruned}
  const EXPAND_NODES = [
    { id: 0, x: 0.25, y: 0.08, label: 'It',    conf: 1.0,  value: 1.0,  root: true },
    { id: 1, x: 0.12, y: 0.30, label: 'is',    conf: 0.6,  value: 0.60, expanded: true  },
    { id: 2, x: 0.38, y: 0.30, label: 'has',   conf: 0.2,  value: 0.20, expanded: true  },
    { id: 3, x: 0.06, y: 0.52, label: 'a',     conf: 0.8,  value: 0.48, generated: true },
    { id: 4, x: 0.18, y: 0.52, label: 'the',   conf: 0.1,  value: 0.06, generated: true },
    { id: 5, x: 0.32, y: 0.52, label: 'a',     conf: 0.7,  value: 0.14, generated: true },
    { id: 6, x: 0.44, y: 0.52, label: 'to',    conf: 0.1,  value: 0.02, generated: true },
    { id: 7, x: 0.03, y: 0.74, label: 'good',  conf: 0.7,  value: 0.34, generated: true },
    { id: 8, x: 0.12, y: 0.74, label: 'nice',  conf: 0.14, value: 0.07, generated: true },
    { id: 9, x: 0.17, y: 0.74, label: 'big',   conf: 0.1,  value: 0.006,generated: true },
  ];
  const EXPAND_EDGES = [
    [0,1,0.6],[0,2,0.2],[1,3,0.8],[1,4,0.1],[2,5,0.7],[2,6,0.1],[3,7,0.7],[3,8,0.14],[4,9,0.1]
  ];

  const RERANK_NODES = [
    { id: 0, x: 0.25, y: 0.08, label: 'It',    value: 1.0,  selected: true  },
    { id: 1, x: 0.12, y: 0.30, label: 'is',    value: 0.60, selected: true  },
    { id: 2, x: 0.38, y: 0.30, label: 'has',   value: 0.20, selected: true  },
    { id: 3, x: 0.06, y: 0.52, label: 'a',     value: 0.48, selected: true  },
    { id: 4, x: 0.18, y: 0.52, label: 'the',   value: 0.06, selected: false },
    { id: 5, x: 0.32, y: 0.52, label: 'a',     value: 0.14, selected: true  },
    { id: 6, x: 0.44, y: 0.52, label: 'to',    value: 0.02, selected: false },
    { id: 7, x: 0.03, y: 0.74, label: 'good',  value: 0.34, selected: true  },
    { id: 8, x: 0.12, y: 0.74, label: 'nice',  value: 0.07, selected: true  },
    { id: 9, x: 0.17, y: 0.74, label: 'big',   value: 0.006,selected: false },
  ];
  const RERANK_EDGES = [
    [0,1],[0,2],[1,3],[1,4],[2,5],[2,6],[3,7],[3,8],[4,9]
  ];

  let phase = 'expand';

  function drawPhase(nodes, edges, isRerank) {
    const W = canvas.clientWidth, H = canvas.clientHeight;
    canvas.width  = W * DPR;
    canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
    ctx.clearRect(0, 0, W, H);

    const LEFT_W = W * 0.52;

    // Edges
    ctx.lineWidth = 1.5;
    edges.forEach(e => {
      const [ai, bi, conf] = e;
      const na = nodes[ai], nb = nodes[bi];
      const nx = n => n.x * LEFT_W;
      const ny = n => n.y * H;
      ctx.strokeStyle = 'rgba(255,255,255,0.12)';
      ctx.beginPath();
      ctx.moveTo(nx(na), ny(na));
      ctx.lineTo(nx(nb), ny(nb));
      ctx.stroke();
      if (!isRerank && conf !== undefined) {
        const mx = (nx(na) + nx(nb)) / 2 + 6;
        const my = (ny(na) + ny(nb)) / 2;
        ctx.font = '9px var(--ff-mono, monospace)';
        ctx.fillStyle = 'rgba(245,158,11,0.7)';
        ctx.textAlign = 'center';
        ctx.fillText(conf.toFixed(1), mx, my);
      }
    });

    // Nodes
    nodes.forEach(nd => {
      const x = nd.x * LEFT_W, y = nd.y * H, r = 20;
      let fill, stroke;
      if (nd.root) { fill = 'rgba(139,92,246,0.9)'; stroke = 'var(--purple)'; }
      else if (isRerank && nd.selected) { fill = 'rgba(16,185,129,0.85)'; stroke = 'rgba(16,185,129,0.5)'; }
      else if (!isRerank && nd.expanded) { fill = 'rgba(245,158,11,0.9)'; stroke = 'rgba(245,158,11,0.5)'; }
      else if (!isRerank && nd.generated) { fill = 'rgba(16,185,129,0.7)'; stroke = 'rgba(16,185,129,0.3)'; }
      else { fill = 'rgba(255,255,255,0.08)'; stroke = 'rgba(255,255,255,0.1)'; }

      ctx.beginPath();
      ctx.arc(x, y, r, 0, Math.PI * 2);
      ctx.fillStyle = fill;
      ctx.fill();
      ctx.strokeStyle = stroke;
      ctx.lineWidth = 1.5;
      ctx.stroke();

      ctx.fillStyle = '#fff';
      ctx.font = `600 10px var(--ff-mono, monospace)`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(nd.label, x, y - 3);
      ctx.font = '8px var(--ff-mono, monospace)';
      ctx.fillStyle = 'rgba(255,255,255,0.55)';
      ctx.fillText('V=' + nd.value.toFixed(2), x, y + 8);
    });

    // Right side: formula panel
    const RX = LEFT_W + 20;
    const RW = W - RX - 10;
    const boxH = isRerank ? 130 : 120;
    const boxY = H / 2 - boxH / 2;

    ctx.fillStyle = 'rgba(255,255,255,0.03)';
    ctx.strokeStyle = 'rgba(255,255,255,0.08)';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.roundRect(RX, boxY, RW, boxH, 8);
    ctx.fill(); ctx.stroke();

    ctx.fillStyle = 'rgba(255,255,255,0.55)';
    ctx.font = '600 10px var(--ff-mono, monospace)';
    ctx.textAlign = 'left';
    const lines = isRerank
      ? ['Rerank: select top-8', 'by path value V_i', '', 'V_i = Π conf along path', '', 'Selected: green nodes', '(form connected subtree)', '', 'E[τ] = Σ V_i = 1.00+0.60', '+0.20+0.48+0.14+0.34', '+0.20+0.07 = 3.03']
      : ['Expand: top-2 nodes', 'by V_i from last layer', '', '"is"  V=0.60  ← expand', '"has" V=0.20  ← expand', '"the" V=0.06  skip', '', 'Each expanded node', 'generates new children'];
    lines.forEach((l, i) => {
      ctx.fillStyle = l.startsWith('←') ? 'rgba(16,185,129,0.8)' : 'rgba(255,255,255,0.45)';
      ctx.fillText(l, RX + 10, boxY + 16 + i * 11);
    });
  }

  function draw() {
    if (phase === 'expand') drawPhase(EXPAND_NODES, EXPAND_EDGES, false);
    else drawPhase(RERANK_NODES, RERANK_EDGES, true);
  }

  document.getElementById('phase-expand')?.addEventListener('click', function() {
    phase = 'expand';
    this.classList.add('active');
    document.getElementById('phase-rerank').classList.remove('active');
    draw();
  });
  document.getElementById('phase-rerank')?.addEventListener('click', function() {
    phase = 'rerank';
    this.classList.add('active');
    document.getElementById('phase-expand').classList.remove('active');
    draw();
  });

  draw();
  window.addEventListener('resize', draw);
})();

// ─── VIZ 05: Theory chart (uniform vs confidence-guided) ──────────────────────
(function() {
  const canvas = document.getElementById('theory-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;

  // Simulate expected accepted tokens for different budgets
  // Using a realistic toy tree with known confidence distribution
  // Tree at position i has confidence c_i drawn from a bimodal distribution
  // uniform: always branch k=2
  // confidence-guided: branch at high-entropy positions

  function simulate(budget, strategy) {
    // Simple model: positions alternate easy/hard
    // Easy: top token has conf 0.92, second 0.06
    // Hard: top token has conf 0.35, second 0.30
    // Expected τ = sum of V_i for selected nodes
    // Strategy: 'uniform' or 'guided'
    const confs_easy = [0.92, 0.06, 0.01, 0.01];
    const confs_hard = [0.35, 0.30, 0.22, 0.13];

    // Build candidate nodes for guided strategy
    const candidates = [];
    // Depth 1: 2 positions (one easy, one hard concept)
    candidates.push({ depth: 1, V: 0.92, label: 'easy-top' });
    candidates.push({ depth: 1, V: 0.35, label: 'hard-top' });
    candidates.push({ depth: 1, V: 0.30, label: 'hard-2nd' });
    candidates.push({ depth: 1, V: 0.06, label: 'easy-2nd' });
    // Depth 2 from easy-top
    candidates.push({ depth: 2, V: 0.92 * 0.88, label: 'easy-top-easy' });
    candidates.push({ depth: 2, V: 0.92 * 0.07, label: 'easy-top-2nd' });
    // Depth 2 from hard-top
    candidates.push({ depth: 2, V: 0.35 * 0.40, label: 'hard-top-sub1' });
    candidates.push({ depth: 2, V: 0.35 * 0.35, label: 'hard-top-sub2' });
    // Depth 2 from hard-2nd
    candidates.push({ depth: 2, V: 0.30 * 0.42, label: 'hard-2nd-sub1' });
    candidates.push({ depth: 2, V: 0.30 * 0.30, label: 'hard-2nd-sub2' });
    // Depth 3 from easy chain
    candidates.push({ depth: 3, V: 0.92 * 0.88 * 0.85, label: 'd3-easy' });
    candidates.push({ depth: 3, V: 0.92 * 0.88 * 0.08, label: 'd3-easy2' });
    // Depth 3 from hard
    candidates.push({ depth: 3, V: 0.35 * 0.40 * 0.48, label: 'd3-hard1' });
    candidates.push({ depth: 3, V: 0.35 * 0.35 * 0.43, label: 'd3-hard2' });
    candidates.push({ depth: 3, V: 0.30 * 0.42 * 0.50, label: 'd3-hard3' });
    // Depth 4
    candidates.push({ depth: 4, V: 0.92 * 0.88 * 0.85 * 0.82, label: 'd4-easy' });
    candidates.push({ depth: 4, V: 0.35 * 0.40 * 0.48 * 0.45, label: 'd4-hard1' });
    candidates.push({ depth: 4, V: 0.35 * 0.35 * 0.43 * 0.40, label: 'd4-hard2' });

    if (strategy === 'guided') {
      // Sort by V, take top-budget
      const sorted = [...candidates].sort((a, b) => b.V - a.V);
      const selected = sorted.slice(0, budget);
      return selected.reduce((s, n) => s + n.V, 0);
    } else {
      // Uniform: always branch k=2 at each depth, total = min(budget, 2^depth * 2)
      // Approximate: uniform tree of branching factor 2
      let sum = 0, count = 0;
      // uniform always takes first k at each position regardless of V
      // approximation: take nodes in order (depth-first, ignoring V)
      const uniform = [...candidates].sort((a, b) => a.depth - b.depth || b.V - a.V);
      for (let i = 0; i < Math.min(budget, uniform.length); i++) {
        sum += uniform[i].V * 0.78; // static trees leave ~22% on the table
      }
      return sum;
    }
  }

  function draw() {
    const W = canvas.clientWidth, H = canvas.clientHeight;
    canvas.width  = W * DPR;
    canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
    ctx.clearRect(0, 0, W, H);

    const pad = { l: 50, r: 20, t: 20, b: 42 };
    const cw = W - pad.l - pad.r;
    const ch = H - pad.t - pad.b;

    const budgets = [4, 6, 8, 10, 12, 14, 16, 18, 20];
    const guided  = budgets.map(m => simulate(m, 'guided'));
    const uniform = budgets.map(m => simulate(m, 'uniform'));

    const maxY = Math.max(...guided) * 1.1;

    // Grid
    ctx.strokeStyle = 'rgba(255,255,255,0.05)';
    ctx.lineWidth = 1;
    [2, 4, 6, 8, 10].forEach(val => {
      const y = pad.t + ch - (val / maxY) * ch;
      if (y > pad.t) {
        ctx.beginPath(); ctx.moveTo(pad.l, y); ctx.lineTo(pad.l + cw, y); ctx.stroke();
        ctx.fillStyle = 'rgba(255,255,255,0.3)';
        ctx.font = '9px var(--ff-mono, monospace)';
        ctx.textAlign = 'right';
        ctx.fillText(val.toFixed(1), pad.l - 4, y + 3);
      }
    });

    // Draw lines
    function drawLine(vals, color, label) {
      ctx.strokeStyle = color;
      ctx.lineWidth = 2.5;
      ctx.beginPath();
      vals.forEach((v, i) => {
        const x = pad.l + (i / (budgets.length - 1)) * cw;
        const y = pad.t + ch - (v / maxY) * ch;
        i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
      });
      ctx.stroke();
      // Dots
      vals.forEach((v, i) => {
        const x = pad.l + (i / (budgets.length - 1)) * cw;
        const y = pad.t + ch - (v / maxY) * ch;
        ctx.beginPath(); ctx.arc(x, y, 4, 0, Math.PI * 2);
        ctx.fillStyle = color; ctx.fill();
      });
    }

    drawLine(uniform, 'rgba(6,182,212,0.7)',   'uniform');
    drawLine(guided,  'rgba(139,92,246,0.9)',  'confidence-guided');

    // Labels
    const lastGuidedX = pad.l + cw + 4;
    const lastGuidedY = pad.t + ch - (guided[guided.length - 1] / maxY) * ch;
    const lastUnifY   = pad.t + ch - (uniform[uniform.length - 1] / maxY) * ch;
    ctx.font = '600 10px var(--ff-mono, monospace)';
    ctx.fillStyle = 'rgba(139,92,246,0.9)';
    ctx.textAlign = 'left';
    ctx.fillText('confidence-guided', pad.l + cw - 110, lastGuidedY - 8);
    ctx.fillStyle = 'rgba(6,182,212,0.7)';
    ctx.fillText('uniform k=2', pad.l + cw - 70, lastUnifY + 14);

    // Axes
    ctx.strokeStyle = 'rgba(255,255,255,0.2)';
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(pad.l, pad.t); ctx.lineTo(pad.l, pad.t + ch); ctx.lineTo(pad.l + cw, pad.t + ch);
    ctx.stroke();

    ctx.fillStyle = 'rgba(255,255,255,0.3)';
    ctx.font = '10px var(--ff-mono, monospace)';
    ctx.textAlign = 'center';
    budgets.forEach((m, i) => {
      const x = pad.l + (i / (budgets.length - 1)) * cw;
      ctx.fillText(m, x, pad.t + ch + 14);
    });
    ctx.fillStyle = 'rgba(255,255,255,0.35)';
    ctx.font = '600 10px var(--ff-mono, monospace)';
    ctx.fillText('draft budget m (nodes)', pad.l + cw / 2, H - 5);

    ctx.save();
    ctx.translate(13, pad.t + ch / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.textAlign = 'center';
    ctx.fillText('E[tokens accepted]', 0, 0);
    ctx.restore();
  }

  draw();
  window.addEventListener('resize', draw);
})();

// ─── VIZ 06: Results bars (animated on scroll) ───────────────────────────────
const resultsSection = document.getElementById('s-results');
if (resultsSection) {
  new IntersectionObserver(entries => {

      <pre class="cs-pre">
<span class="cs-line cmt"># Standard OPD: full rollout distillation</span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">opd_loss</span>(student, teacher, prompt):</span>
<span class="cs-line hl-c">    </span><span class="cs-line">student_rollout = student.generate(prompt, max_length=T)</span>
<span class="cs-line hl-c">    </span><span class="cs-line">teacher_logprobs = teacher.get_logprobs(student_rollout)</span>
<span class="cs-line hl-c">    </span><span class="cs-line">student_logprobs = student.get_logprobs(student_rollout)</span>
<span class="cs-line hl-c">    </span><span class="cs-line">log_ratios = teacher_logprobs - student_logprobs</span>
<span class="cs-line hl-c">    </span><span class="cs-line">loss = -log_ratios.mean()</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Token-level OPD (γ=0)</span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">token_level_opd_loss</span>(student, teacher, prompt):</span>
<span class="cs-line hl-c">    </span><span class="cs-line">losses = []</span>
<span class="cs-line hl-c">    </span><span class="cs-line">for t in range(T):</span>
<span class="cs-line hl-c">        </span><span class="cs-line">losses.append(-(teacher_logprobs[t] - student_logprobs[t]))</span>
<span class="cs-line hl-c">    </span><span class="cs-line">return torch.stack(losses).mean()</span>
</pre>
    </div>
    <div class="cs-panel" id="panel-background">
      <pre class="cs-pre">
<span class="cs-line cmt"># Pseudocode for sequence-level OPD (γ=1)</span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">sequence_level_opd_loss</span>(student, teacher, prompt):</span>
<span class="cs-line hl-c">    </span><span class="cs-line">student_rollout = student.generate(prompt, max_length=T)</span>
<span class="cs-line hl-c">    </span><span class="cs-line">teacher_logprobs = teacher.get_logprobs(student_rollout)</span>
<span class="cs-line hl-c">    </span><span class="cs-line">student_logprobs = student.get_logprobs(student_rollout)</span>
<span class="cs-line hl-c">    </span><span class="cs-line">log_ratios = teacher_logprobs - student_logprobs</span>
<span class="cs-line hl-c">    </span><span class="cs-line"># Compute returns-to-go</span>
<span class="cs-line hl-c">    </span><span class="cs-line">returns = torch.zeros_like(log_ratios)</span>
<span class="cs-line hl-c">    </span><span class="cs-line">running_sum = 0</span>
<span class="cs-line hl-c">    </span><span class="cs-line">for t in reversed(range(T)):</span>
<span class="cs-line hl-c">        </span><span class="cs-line">running_sum = log_ratios[t] + running_sum</span>
<span class="cs-line hl-c">        </span><span class="cs-line">returns[t] = running_sum</span>
<span class="cs-line hl-c">    </span><span class="cs-line">loss = -returns.mean()</span>
</pre>
    </div>
    <div class="cs-panel" id="panel-method">
      <pre class="cs-pre">
<span class="cs-line cmt"># Progressive OPD (POPD)</span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">pohopd_loss</span>(student, teacher, prompt, step, H0=100, dH=50, dk=10):</span>
<span class="cs-line hl-c">    </span><span class="cs-line">H = min(T, H0 + dH * (step // dk))</span>
<span class="cs-line hl-c">    </span><span class="cs-line">student_rollout = student.generate(prompt, max_length=H)</span>
<span class="cs-line hl-c">    </span><span class="cs-line">teacher_logprobs = teacher.get_logprobs(student_rollout)</span>
<span class="cs-line hl-c">    </span><span class="cs-line">student_logprobs = student.get_logprobs(student_rollout)</span>
<span class="cs-line hl-c">    </span><span class="cs-line">log_ratios = teacher_logprobs - student_logprobs</span>
<span class="cs-line hl-c">    </span><span class="cs-line">loss = -log_ratios.mean()</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Truncated OPD (TOPD)</span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">topd_loss</span>(student, teacher, prompt, rho=0.1):</span>
<span class="cs-line hl-c">    </span><span class="cs-line">H = int(rho * T)</span>
<span class="cs-line hl-c">    </span><span class="cs-line">student_rollout = student.generate(prompt, max_length=H)</span>
<span class="cs-line hl-c">    </span><span class="cs-line">teacher_logprobs = teacher.get_logprobs(student_rollout)</span>
<span class="cs-line hl-c">    </span><span class="cs-line">student_logprobs = student.get_logprobs(student_rollout)</span>
<span class="cs-line hl-c">    </span><span class="cs-line">log_ratios = teacher_logprobs - student_logprobs</span>
<span class="cs-line hl-c">    </span><span class="cs-line">loss = -log_ratios.mean()</span>
</pre>
    </div>
    <div class="cs-panel" id="panel-trick">
      <pre class="cs-pre">
<span class="cs-line cmt"># Example trajectory for POPD</span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">simulate_pohopd</span>(steps=100):</span>
<span class="cs-line hl-c">    </span><span class="cs-line">horizons = []</span>
<span class="cs-line hl-c">    </span><span class="cs-line">for step in range(steps):</span>
<span class="cs-line hl-c">        </span><span class="cs-line">H = min(T, 100 + 50 * (step // 10))</span>
<span class="cs-line hl-c">        </span><span class="cs-line">horizons.append(H)</span>
<span class="cs-line hl-c">    </span><span class="cs-line">return horizons</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Example trajectory for TOPD</span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">simulate_topd</span>(rho=0.1):</span>
<span class="cs-line hl-c">    </span><span class="cs-line">return [int(rho * T)] * T  # constant horizon</span>
</pre>

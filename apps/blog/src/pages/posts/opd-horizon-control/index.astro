<span class="cs-line hl-c">    </span><span class="cs-line">return data</span>
</pre>
    </div>
    <div class="cs-panel" id="panel-results">
      <pre class="cs-pre">
<span class="cs-line cmt"># Results summary</span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">summarize_results</span>():</span>
<span class="cs-line hl-c">    </span><span class="cs-line">print("POPD improves training efficiency by up to 3×")</span>
<span class="cs-line hl-c">    </span><span class="cs-line">print("TOPD matches OPD performance with ρ=0.1, reducing time by 82%")</span>
<span class="cs-line hl-c">    </span><span class="cs-line">print("Example: AIME24 accuracy 51.3% at 5.3h vs 49.3% at 29.7h")</span>
</pre>
    </div>
  </div>
</aside>

</div><!-- /post-grid -->

<script>
// TOC + sidebar toggles
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});

const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// Code sidebar tab switching
const tabMeta = {
  intro:   { file: 'post/intro.py',   title: 'Standard OPD' },
  background:  { file: 'post/background.py',  title: 'Sequence-level OPD' },
  method:  { file: 'post/method.py',  title: 'POPD & TOPD' },
  trick:   { file: 'post/trick.py',   title: 'Horizon Control Examples' },
  scaling: { file: 'post/scaling.py',  title: 'Scaling Data' },
  results: { file: 'post/results.py', title: 'Results Summary' }
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// IntersectionObserver — sync TOC + sidebar tab on scroll
const sectionMap = {
  's-intro': 'intro',
  's-background': 'background',
  's-method': 'method',
  's-trick': 'trick',
  's-scaling': 'scaling',
  's-results': 'results'
};

document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// Helper function to setup a responsive high-DPI canvas
function setupResponsiveCanvas(canvasId, drawFn) {
  const canvas = document.getElementById(canvasId);
  if (!canvas) return null;

  const ctx = canvas.getContext('2d');
  const H = 240;

  function redraw() {
    const W = canvas.clientWidth || 500; // fallback width
    const DPR = window.devicePixelRatio || 1;
    canvas.width = W * DPR;
    canvas.height = H * DPR;
    ctx.resetTransform();
    ctx.scale(DPR, DPR);
    drawFn(ctx, W, H);
  }

  // Observe container size changes (works on load and resize)
  const observer = new ResizeObserver(() => {
    redraw();
  });
  observer.observe(canvas);

  return { redraw };
}

// ─── Trajectory Canvas (Section 01) ───
const trajectoryPoints = [];
let trajSeed = 42;
function randomTraj() {
  const x = Math.sin(trajSeed++) * 10000;
  return x - Math.floor(x);
}
// Pre-generate W points (up to 2000px)
for (let i = 0; i < 2000; i++) {
  const noiseLevel = i < 300 ? 8 : 25;
  const offset = (randomTraj() - 0.5) * noiseLevel;
  trajectoryPoints.push(offset);
}

let trajectoryTruncated = false;

const trajectoryChart = setupResponsiveCanvas('trajectory-canvas', (ctx, W, H) => {
  ctx.clearRect(0, 0, W, H);
  const centerY = H / 2;

  // 1. Draw background trajectory (entire path, very faint)
  ctx.strokeStyle = 'rgba(255,255,255,0.08)';
  ctx.lineWidth = 1;
  ctx.beginPath();
  ctx.moveTo(0, centerY + trajectoryPoints[0]);
  for (let i = 1; i < W; i++) {
    ctx.lineTo(i, centerY + trajectoryPoints[i]);
  }
  ctx.stroke();

  // 2. Draw active rollout segment
  const split = Math.floor(W * 0.3);
  
  if (trajectoryTruncated) {
    // Truncated OPD: only draw the stable early prefix (green)
    ctx.beginPath();
    ctx.moveTo(0, centerY + trajectoryPoints[0]);
    for (let i = 1; i < split; i++) {
      ctx.lineTo(i, centerY + trajectoryPoints[i]);
    }
    ctx.strokeStyle = 'rgba(16,185,129,0.85)'; // green
    ctx.lineWidth = 2.5;
    ctx.stroke();
    
    // Draw a vertical truncation indicator line
    ctx.strokeStyle = 'rgba(6,182,212,0.4)';
    ctx.lineWidth = 1;
    ctx.setLineDash([4, 4]);
    ctx.beginPath();
    ctx.moveTo(split, 20);
    ctx.lineTo(split, H - 20);
    ctx.stroke();
    ctx.setLineDash([]);
    
    ctx.fillStyle = 'rgba(6,182,212,0.8)';
    ctx.font = '9px monospace';
    ctx.textAlign = 'left';
    ctx.fillText('Truncation Horizon ρ = 0.3', split + 8, 30);
  } else {
    // Full OPD: draw the whole path.
    // Green for early part
    ctx.beginPath();
    ctx.moveTo(0, centerY + trajectoryPoints[0]);
    for (let i = 1; i < split; i++) {
      ctx.lineTo(i, centerY + trajectoryPoints[i]);
    }
    ctx.strokeStyle = 'rgba(16,185,129,0.85)'; // green
    ctx.lineWidth = 2.5;
    ctx.stroke();
    
    // Red for late noisy part
    ctx.beginPath();
    ctx.moveTo(split - 1, centerY + trajectoryPoints[split - 1]);
    for (let i = split; i < W; i++) {
      ctx.lineTo(i, centerY + trajectoryPoints[i]);
    }
    ctx.strokeStyle = 'rgba(239,68,68,0.8)'; // red
    ctx.lineWidth = 2.5;
    ctx.stroke();
    
    // Draw label pointing out late-stage noise
    ctx.fillStyle = 'rgba(239,68,68,0.8)';
    ctx.font = '9px monospace';
    ctx.textAlign = 'left';
    ctx.fillText('Late Rollout Noise (Accumulates Error)', split + 15, H - 30);
  }
});

// Button controls
const btnFull = document.getElementById('btn-full');
const btnTruncated = document.getElementById('btn-truncated');

if (btnFull) {
  btnFull.addEventListener('click', () => {
    btnFull.style.borderColor = 'var(--purple)';
    btnFull.style.color = 'var(--purple-l)';
    if (btnTruncated) {
      btnTruncated.style.borderColor = '';
      btnTruncated.style.color = '';
    }
    trajectoryTruncated = false;
    trajectoryChart?.redraw();
  });
}
if (btnTruncated) {
  btnTruncated.addEventListener('click', () => {
    btnTruncated.style.borderColor = 'var(--purple)';
    btnTruncated.style.color = 'var(--purple-l)';
    if (btnFull) {
      btnFull.style.borderColor = '';
      btnFull.style.color = '';
    }
    trajectoryTruncated = true;
    trajectoryChart?.redraw();
  });
}

// Set default button style
if (btnFull) {
  btnFull.style.borderColor = 'var(--purple)';
  btnFull.style.color = 'var(--purple-l)';
}


// ─── Horizon Canvas (Section 04) ───
const horizonPoints = [];
let horizonSeed = 123;
function randomHorizon() {
  const x = Math.sin(horizonSeed++) * 10000;
  return x - Math.floor(x);
}
for (let i = 0; i < 2000; i++) {
  const offset = Math.sin(i * 0.03) * 35 + (randomHorizon() - 0.5) * 10;
  horizonPoints.push(offset);
}

const pohSlider = document.getElementById('poh-slider');
const pohValue = document.getElementById('poph-value');
const topdSlider = document.getElementById('topd-slider');
const topdValue = document.getElementById('topd-value');

const horizonChart = setupResponsiveCanvas('horizon-canvas', (ctx, W, H) => {
  ctx.clearRect(0, 0, W, H);
  const centerY = H / 2;
  const pohPercent = parseInt(pohSlider?.value || '20');
  const topdPercent = parseInt(topdSlider?.value || '10');
  const pohLength = Math.floor(W * pohPercent / 100);
  const topdLength = Math.floor(W * topdPercent / 100);

  // 1. Background trajectory (entire path, very faint)
  ctx.strokeStyle = 'rgba(255,255,255,0.06)';
  ctx.lineWidth = 1;
  ctx.beginPath();
  ctx.moveTo(0, centerY + horizonPoints[0]);
  for (let i = 1; i < W; i++) {
    ctx.lineTo(i, centerY + horizonPoints[i]);
  }
  ctx.stroke();

  // 2. POPD: progressive horizon (purple glow/line)
  if (pohLength > 0) {
    ctx.beginPath();
    ctx.moveTo(0, centerY + horizonPoints[0]);
    for (let i = 1; i < pohLength; i++) {
      ctx.lineTo(i, centerY + horizonPoints[i]);
    }
    ctx.strokeStyle = 'rgba(167,139,250,0.65)'; // purple
    ctx.lineWidth = 3;
    ctx.stroke();
  }

  // 3. TOPD: truncated horizon (cyan line)
  if (topdLength > 0) {
    ctx.beginPath();
    ctx.moveTo(0, centerY + horizonPoints[0]);
    for (let i = 1; i < topdLength; i++) {
      ctx.lineTo(i, centerY + horizonPoints[i]);
    }
    ctx.strokeStyle = 'rgba(6,182,212,0.8)'; // cyan
    ctx.lineWidth = 2;
    ctx.stroke();
  }
  
  // Draw indicators at endpoints
  if (pohLength > 0 && pohLength < W) {
    ctx.fillStyle = 'rgba(167,139,250,0.9)';
    ctx.beginPath();
    ctx.arc(pohLength, centerY + horizonPoints[pohLength], 4, 0, Math.PI * 2);
    ctx.fill();
  }
  if (topdLength > 0 && topdLength < W) {
    ctx.fillStyle = 'rgba(6,182,212,0.9)';
    ctx.beginPath();
    ctx.arc(topdLength, centerY + horizonPoints[topdLength], 4, 0, Math.PI * 2);
    ctx.fill();
  }
});

function updateHorizonDisplay() {
  if (pohValue && pohSlider) pohValue.textContent = pohSlider.value + '%';
  if (topdValue && topdSlider) topdValue.textContent = topdSlider.value + '%';
  horizonChart?.redraw();
}

if (pohSlider) pohSlider.addEventListener('input', updateHorizonDisplay);
if (topdSlider) topdSlider.addEventListener('input', updateHorizonDisplay);


// ─── Scaling Chart (Section 05) ───
const chartData = [
  {rho: 0.1, acc: 50.7, time: 5.3},
  {rho: 0.25, acc: 50.3, time: 10.2},
  {rho: 0.5, acc: 51.3, time: 18.1},
  {rho: 1.0, acc: 49.3, time: 29.7}
];

const scalingLineChart = setupResponsiveCanvas('scaling-chart', (ctx, W, H) => {
  ctx.clearRect(0, 0, W, H);

  // Padding
  const padL = 45;
  const padR = 45;
  const padT = 30;
  const padB = 30;
  const plotW = W - padL - padR;
  const plotH = H - padT - padB;

  // Draw grid
  ctx.strokeStyle = 'rgba(255,255,255,0.04)';
  ctx.lineWidth = 1;
  
  // Horizontal grid lines (5 steps)
  for (let i = 0; i <= 5; i++) {
    const y = padT + (i * plotH / 5);
    ctx.beginPath();
    ctx.moveTo(padL, y);
    ctx.lineTo(W - padR, y);
    ctx.stroke();
  }
  
  // Vertical grid lines at each data point
  chartData.forEach((d, i) => {
    const x = padL + (i * plotW / (chartData.length - 1));
    ctx.beginPath();
    ctx.moveTo(x, padT);
    ctx.lineTo(x, H - padB);
    ctx.stroke();
  });

  // Helper functions to map data values to plot coordinates
  // Accuracy range: 45% to 55%
  const accMin = 45, accMax = 55;
  function getAccY(acc) {
    const pct = (acc - accMin) / (accMax - accMin);
    return H - padB - (pct * plotH);
  }
  // Time range: 0 to 35 hours
  const timeMin = 0, timeMax = 35;
  function getTimeY(time) {
    const pct = (time - timeMin) / (timeMax - timeMin);
    return H - padB - (pct * plotH);
  }
  function getX(index) {
    return padL + (index * plotW / (chartData.length - 1));
  }

  // 1. Draw accuracy line (green)
  ctx.strokeStyle = 'rgba(16,185,129,0.85)'; // green
  ctx.lineWidth = 2;
  ctx.beginPath();
  ctx.moveTo(getX(0), getAccY(chartData[0].acc));
  for (let i = 1; i < chartData.length; i++) {
    ctx.lineTo(getX(i), getAccY(chartData[i].acc));
  }
  ctx.stroke();

  // 2. Draw time line (blue)
  ctx.strokeStyle = 'rgba(6,182,212,0.85)'; // cyan/blue
  ctx.lineWidth = 2;
  ctx.beginPath();
  ctx.moveTo(getX(0), getTimeY(chartData[0].time));
  for (let i = 1; i < chartData.length; i++) {
    ctx.lineTo(getX(i), getTimeY(chartData[i].time));
  }
  ctx.stroke();

  // 3. Draw accuracy points
  chartData.forEach((d, i) => {
    const x = getX(i);
    const y = getAccY(d.acc);
    ctx.fillStyle = 'rgba(16,185,129,1)';
    ctx.beginPath();
    ctx.arc(x, y, 4, 0, Math.PI * 2);
    ctx.fill();
    
    // Label accuracy value above point
    ctx.fillStyle = 'rgba(255,255,255,0.7)';
    ctx.font = '9px sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText(d.acc + '%', x, y - 8);
  });

  // 4. Draw time points
  chartData.forEach((d, i) => {
    const x = getX(i);
    const y = getTimeY(d.time);
    ctx.fillStyle = 'rgba(6,182,212,1)';
    ctx.beginPath();
    ctx.arc(x, y, 4, 0, Math.PI * 2);
    ctx.fill();
    
    // Label time value below point
    ctx.fillStyle = 'rgba(255,255,255,0.7)';
    ctx.font = '9px sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText(d.time + 'h', x, y + 14);
  });

  // Draw axes labels
  ctx.font = '10px monospace';
  
  // Left axis label: Accuracy
  ctx.fillStyle = 'rgba(16,185,129,0.9)';
  ctx.textAlign = 'left';
  ctx.fillText('Accuracy (45-55%)', 10, 18);
  
  // Right axis label: Training Time
  ctx.fillStyle = 'rgba(6,182,212,0.9)';
  ctx.textAlign = 'right';
  ctx.fillText('Time (0-35h)', W - 10, 18);
  
  // X axis label: Rho
  ctx.fillStyle = 'rgba(255,255,255,0.5)';
  ctx.textAlign = 'center';
  ctx.fillText('Horizon Truncation Ratio (ρ)', W / 2, H - 5);

  // Draw X-axis tick labels
  ctx.fillStyle = 'rgba(255,255,255,0.6)';
  ctx.font = '9px monospace';
  chartData.forEach((d, i) => {
    ctx.fillText('ρ=' + d.rho.toString(), getX(i), H - 16);
  });
});


// ─── Animated Bar Chart Trigger ───
const barsSection = document.getElementById('s-results');
if (barsSection) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          b.style.width = parseFloat(b.dataset.w) + '%';
        });
      }
    });
  }, { threshold: 0.3 }).observe(barsSection);
}

// ─── Step Navigator ───
let step = 0;
const boxes  = document.querySelectorAll('.step-box');
const prevBtn = document.getElementById('step-prev');
const nextBtn = document.getElementById('step-next');
const progEl  = document.getElementById('step-prog');
function updateSteps() {
  boxes.forEach((b, i) => {
    b.classList.remove('active','done');
    if (i === step) b.classList.add('active');
    else if (i < step) b.classList.add('done');
  });
  if (prevBtn) prevBtn.disabled = step === 0;
  if (nextBtn) nextBtn.disabled = step === boxes.length - 1;
  if (progEl) progEl.textContent = `Step ${step+1} of ${boxes.length}`;
  boxes.forEach((b, i) => {
    const n = b.querySelector('.step-num');
    if (n) n.textContent = i < step ? '✓' : String(i+1);
  });
}
prevBtn?.addEventListener('click', () => { if (step>0){step--;updateSteps();} });
nextBtn?.addEventListener('click', () => { if (step<boxes.length-1){step++;updateSteps();} });
updateSteps();
</script>
</BaseLayout>
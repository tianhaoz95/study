<span class="cs-line hl-c">    scores = [<span class="fn">score_chunk</span>(c, query, pseudo_labels)</span>
<span class="cs-line hl-c">              <span class="kw">for</span> c <span class="kw">in</span> chunks]</span>
<span class="cs-line hl-c">    top_k_idx = <span class="fn">argsort</span>(scores)[-K:]     <span class="cmt"># top-K chunks</span></span>
<span class="cs-line hl-c">    selected_kv = [kv_cache[i] <span class="kw">for</span> i <span class="kw">in</span> top_k_idx]</span>

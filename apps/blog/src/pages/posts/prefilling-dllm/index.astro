<span class="cs-line"> </span>
<span class="cs-line hl-g">    <span class="cmt"># ── Phase III: Decode (T steps) ──────────</span></span>
<span class="cs-line hl-g">    response = torch.<span class="fn">full</span>((Ld,), MASK)</span>
<span class="cs-line hl-g">    <span class="kw">for</span> step <span class="kw">in</span> <span class="fn">range</span>(T):</span>
<span class="cs-line hl-g">        logits = model.<span class="fn">decode_with_kv</span>(</span>
<span class="cs-line hl-g">            selected_kv,               <span class="cmt"># static, K×B tokens</span></span>
<span class="cs-line hl-g">            query, response            <span class="cmt"># O(Ld² + K·C)</span></span>
<span class="cs-line hl-g">        )</span>
<span class="cs-line hl-g">        response = <span class="fn">unmask_topk</span>(logits, step)</span>
<span class="cs-line hl-g">    <span class="kw">return</span> response</span>

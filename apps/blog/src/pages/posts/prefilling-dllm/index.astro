      <pre class="cs-pre">
<span class="cs-line cmt"># Prefilling-dLLM: the full pipeline</span>
<span class="cs-line"> </span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">prefilling_decode</span>(model, prefix, query, K=4, C=1024, B=512):</span>
<span class="cs-line">    N = <span class="fn">ceil</span>(len(prefix) / C)            <span class="cmt"># num chunks</span></span>
<span class="cs-line">    chunks = <span class="fn">split</span>(prefix, C)            <span class="cmt"># N × C</span></span>
<span class="cs-line"> </span>
<span class="cs-line hl-p">    <span class="cmt"># ── Phase I: Prefill (once) ──────────────</span></span>
<span class="cs-line hl-p">    kv_cache = []                         <span class="cmt"># per-chunk KV</span></span>
<span class="cs-line hl-p">    <span class="kw">for</span> chunk <span class="kw">in</span> chunks:                  <span class="cmt"># parallelizable</span></span>
<span class="cs-line hl-p">        bos_chunk = <span class="fn">cat</span>([BOS, chunk])    <span class="cmt"># prepend anchor</span></span>
<span class="cs-line hl-p">        K_i, V_i = model.<span class="fn">intra_attn</span>(bos_chunk)</span>
<span class="cs-line hl-p">        kv_cache.<span class="fn">append</span>((K_i, V_i))      <span class="cmt"># O(C²) each</span></span>
<span class="cs-line"> </span>

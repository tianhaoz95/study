---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Prefilling-dLLM: Cache the Prefix Once, Generate 28× Faster | Catpuccino.ai"
  description="Diffusion LLMs re-encode the full input prefix at every denoising step. Prefilling-dLLM caches it once, selects only K relevant chunks per decode step, and achieves 9–28× speedup with state-of-the-art quality — no training required."
  crumb="Prefilling-dLLM"
>


// ══════════════════════════════════════════════════════════════════════════
// §01 — BOTTLENECK CANVAS
// ══════════════════════════════════════════════════════════════════════════
(function() {
  const canvas = document.getElementById('canvas-bottleneck');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth;
  const H = 280;
  canvas.width  = W * DPR;
  canvas.height = H * DPR;
  ctx.scale(DPR, DPR);

  // Layout constants
  const PAD = 12;
  const PANEL_W = (W - PAD * 3) / 2;  // left panel width
  const PANEL_H = H - 44;
  const T = 10;    // denoising steps to show
  const N_CHUNKS = 8;   // number of prefix "columns" (chunk groups)
  const N_RESP   = 5;   // response columns
  const TOTAL_COLS = N_CHUNKS + N_RESP;
  const CELL_PAD = 2;
  const CELL_W = Math.floor((PANEL_W - CELL_PAD * (TOTAL_COLS + 1)) / TOTAL_COLS);
  const CELL_H = Math.floor((PANEL_H - CELL_PAD * (T + 1)) / T);
  const SELECTED_CHUNKS = [2, 5]; // which chunk columns are "top-K"

  let mode = 'std';   // 'std' or 'pfill'
  let currentStep = 0;
  let rafId = null;
  let playing = false;
  let lastTime = 0;

  function lerp(a, b, t) { return a + (b - a) * t; }

  function drawPanel(ox, oy, step, isPrefill) {
    // Background
    ctx.fillStyle = 'rgba(255,255,255,0.02)';
    ctx.beginPath();
    ctx.roundRect(ox, oy, PANEL_W, PANEL_H, 6);
    ctx.fill();

    const totalRows = T;
    for (let r = 0; r < totalRows; r++) {
      const isActive = r < step;
      const isCurrent = r === step - 1;
      for (let c = 0; c < TOTAL_COLS; c++) {
        const x = ox + CELL_PAD + c * (CELL_W + CELL_PAD);
        const y = oy + CELL_PAD + r * (CELL_H + CELL_PAD);
        const isResp = c >= N_CHUNKS;
        const isSelected = SELECTED_CHUNKS.includes(c);

        let fillColor;
        if (!isActive) {
          fillColor = 'rgba(255,255,255,0.04)';
        } else if (isResp) {
          // Response tokens: transition from masked (purple-dim) to revealed (bright purple)
          const revealFrac = r / (totalRows - 1);
          const alpha = lerp(0.25, 0.85, revealFrac);
          fillColor = `rgba(139,92,246,${alpha.toFixed(2)})`;
        } else if (isPrefill) {
          // Prefilling mode: only selected chunks are teal
          if (isSelected) {
            fillColor = isCurrent ? '#06b6d4' : 'rgba(6,182,212,0.45)';
          } else {
            // Non-selected prefix: dark (cached but not accessed)
            fillColor = 'rgba(255,255,255,0.06)';
          }
        } else {
          // Standard mode: all prefix cells are red (expensive recompute)
          fillColor = isCurrent ? '#f87171' : 'rgba(239,68,68,0.40)';
        }

        ctx.fillStyle = fillColor;
        ctx.beginPath();
        ctx.roundRect(x, y, CELL_W, CELL_H, 2);
        ctx.fill();

        // Glow on current row
        if (isCurrent && isActive) {
          ctx.shadowColor = isResp ? '#8b5cf6' : isPrefill && isSelected ? '#06b6d4' : '#ef4444';
          ctx.shadowBlur = 6;
          ctx.fill();
          ctx.shadowBlur = 0;
        }
      }
    }

    // Column group labels at bottom
    const labelY = oy + PANEL_H + 13;
    ctx.font = `600 ${Math.floor(CELL_W * 0.9)}px var(--ff-mono, monospace)`;
    ctx.textAlign = 'center';
    for (let c = 0; c < N_CHUNKS; c++) {
      const x = ox + CELL_PAD + c * (CELL_W + CELL_PAD) + CELL_W / 2;
      if (isPrefill && SELECTED_CHUNKS.includes(c)) {
        ctx.fillStyle = '#06b6d4';
        ctx.fillText('●', x, labelY);
      } else if (!isPrefill) {
        ctx.fillStyle = 'rgba(239,68,68,0.6)';
        ctx.fillText('▪', x, labelY);
      } else {
        ctx.fillStyle = 'rgba(255,255,255,0.15)';
        ctx.fillText('▪', x, labelY);
      }
    }
  }

  function drawLabels() {
    // Panel titles
    ctx.font = '600 11px var(--ff-mono, monospace)';
    ctx.textAlign = 'center';
    // Standard dLLM label
    ctx.fillStyle = mode === 'std' ? '#ef4444' : 'rgba(255,255,255,0.35)';
    ctx.fillText('Standard dLLM — full prefix at every step', PAD + PANEL_W / 2, 14);
    // Prefilling label
    ctx.fillStyle = mode === 'pfill' ? '#06b6d4' : 'rgba(255,255,255,0.35)';
    ctx.fillText('Prefilling-dLLM — K=2 chunks only', PAD * 2 + PANEL_W + PANEL_W / 2, 14);

    // Legend
    ctx.font = '10px var(--ff-mono, monospace)';
    ctx.textAlign = 'left';
    ctx.fillStyle = 'rgba(239,68,68,0.7)'; ctx.fillText('■', PAD, H - 6);
    ctx.fillStyle = 'rgba(255,255,255,0.4)'; ctx.fillText(' prefix (recomputed)', PAD + 10, H - 6);
    ctx.fillStyle = '#06b6d4'; ctx.fillText('■', PAD + 160, H - 6);
    ctx.fillStyle = 'rgba(255,255,255,0.4)'; ctx.fillText(' cached chunk', PAD + 170, H - 6);
    ctx.fillStyle = 'rgba(139,92,246,0.8)'; ctx.fillText('■', PAD + 300, H - 6);
    ctx.fillStyle = 'rgba(255,255,255,0.4)'; ctx.fillText(' response', PAD + 310, H - 6);
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    const step = currentStep;

    if (mode === 'std') {
      drawPanel(PAD, 20, step, false);
      drawPanel(PAD * 2 + PANEL_W, 20, step, true);
    } else {
      drawPanel(PAD, 20, step, false);
      drawPanel(PAD * 2 + PANEL_W, 20, step, true);
    }
    drawLabels();

    // Highlight active panel
    const ox = mode === 'std' ? PAD : PAD * 2 + PANEL_W;
    ctx.strokeStyle = mode === 'std' ? 'rgba(239,68,68,0.5)' : 'rgba(6,182,212,0.5)';
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.roundRect(ox, 20, PANEL_W, PANEL_H, 6);
    ctx.stroke();
  }

  function tick(ts) {
    if (!playing) return;
    if (ts - lastTime > 500) {
      lastTime = ts;
      currentStep = Math.min(currentStep + 1, T);
      draw();
      document.getElementById('bot-counter').textContent = `step ${currentStep} / ${T}`;
      if (currentStep >= T) { playing = false; }
    }
    if (playing) rafId = requestAnimationFrame(tick);
  }

  // Buttons
  document.getElementById('btn-std').addEventListener('click', () => {
    mode = 'std';
    document.getElementById('btn-std').classList.add('active');
    document.getElementById('btn-pfill').classList.remove('active');
    draw();
  });
  document.getElementById('btn-pfill').addEventListener('click', () => {
    mode = 'pfill';
    document.getElementById('btn-pfill').classList.add('active');
    document.getElementById('btn-std').classList.remove('active');
    draw();
  });
  document.getElementById('btn-bot-play').addEventListener('click', () => {
    if (currentStep >= T) currentStep = 0;
    playing = true;
    lastTime = performance.now() - 600;
    rafId = requestAnimationFrame(tick);
  });
  document.getElementById('btn-bot-reset').addEventListener('click', () => {
    playing = false;
    cancelAnimationFrame(rafId);
    currentStep = 0;
    draw();
    document.getElementById('bot-counter').textContent = 'step 0 / 10';
  });

  draw();
})();

// ══════════════════════════════════════════════════════════════════════════
// §02 — ATTENTION DECAY CANVAS
// ══════════════════════════════════════════════════════════════════════════
(function() {
  const canvas = document.getElementById('canvas-decay');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth;
  const H = 240;
  canvas.width  = W * DPR;
  canvas.height = H * DPR;
  ctx.scale(DPR, DPR);

  const PAD_L = 44, PAD_R = 16, PAD_T = 16, PAD_B = 32;
  const PW = W - PAD_L - PAD_R;
  const PH = H - PAD_T - PAD_B;

  // Approximate decay curves from paper Figure 2
  // Y is log10 of attention weight, mapped to canvas
  // Curves decay from a baseline at distance=0 downward
  const MAX_DIST = 2000;
  const LOG_MAX = -1.8;  // log10(~0.016) near response
  const LOG_MIN = -4.5;  // log10(~0.00003) at distance 2000

  function logAttn(dist, halfLife) {
    // Exponential decay in log space
    return LOG_MAX - (LOG_MAX - LOG_MIN) * (1 - Math.exp(-dist / halfLife));
  }

  const curves = [
    { label: 'step 0 (t=1.0)', halfLife: 1200, color: '#60a5fa', alpha: 1 },  // broad
    { label: 'step 8 (t=0.5)', halfLife:  400, color: '#f59e0b', alpha: 1 },  // moderate
    { label: 'step 15 (t≈0)', halfLife:  120, color: '#f472b6', alpha: 1 },  // steep
  ];

  let shownCurves = [0, 1, 2]; // indices of visible curves

  function drawDecay() {
    ctx.clearRect(0, 0, W, H);

    // Grid
    ctx.strokeStyle = 'rgba(255,255,255,0.05)';
    ctx.lineWidth = 1;
    for (let i = 0; i <= 4; i++) {
      const y = PAD_T + (i / 4) * PH;
      ctx.beginPath(); ctx.moveTo(PAD_L, y); ctx.lineTo(PAD_L + PW, y); ctx.stroke();
    }
    for (let i = 0; i <= 5; i++) {
      const x = PAD_L + (i / 5) * PW;
      ctx.beginPath(); ctx.moveTo(x, PAD_T); ctx.lineTo(x, PAD_T + PH); ctx.stroke();
    }

    // X axis labels
    ctx.font = '10px var(--ff-mono, monospace)';
    ctx.fillStyle = 'rgba(255,255,255,0.3)';
    ctx.textAlign = 'center';
    for (let i = 0; i <= 5; i++) {
      const x = PAD_L + (i / 5) * PW;
      ctx.fillText(String(Math.round(i * MAX_DIST / 5)), x, H - 4);
    }

    // Y axis labels (log scale)
    ctx.textAlign = 'right';
    for (let i = 0; i <= 4; i++) {
      const logVal = LOG_MIN + (i / 4) * (LOG_MAX - LOG_MIN);
      const y = PAD_T + ((LOG_MAX - logVal) / (LOG_MAX - LOG_MIN)) * PH;
      ctx.fillText(`10^${logVal.toFixed(1)}`, PAD_L - 4, y + 3);
    }

    // Axis labels
    ctx.fillStyle = 'rgba(255,255,255,0.35)';
    ctx.textAlign = 'center';
    ctx.font = '11px var(--ff-mono, monospace)';
    ctx.fillText('Distance from response (tokens)', PAD_L + PW / 2, H - 18 + 12);
    ctx.save();
    ctx.translate(10, PAD_T + PH / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.fillText('Attn weight (log)', 0, 0);
    ctx.restore();

    // Draw curves
    const N_POINTS = 200;
    curves.forEach((curve, idx) => {
      if (!shownCurves.includes(idx)) return;
      ctx.strokeStyle = curve.color;
      ctx.lineWidth = 2;
      ctx.globalAlpha = curve.alpha;
      ctx.beginPath();
      for (let i = 0; i <= N_POINTS; i++) {
        const dist = (i / N_POINTS) * MAX_DIST;
        const logW = logAttn(dist, curve.halfLife);
        const x = PAD_L + (dist / MAX_DIST) * PW;
        const y = PAD_T + ((LOG_MAX - logW) / (LOG_MAX - LOG_MIN)) * PH;
        if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
      }
      ctx.stroke();
      // Label at end of curve
      const labelDist = MAX_DIST * 0.92;
      const labelLogW = logAttn(labelDist, curve.halfLife);
      const lx = PAD_L + (labelDist / MAX_DIST) * PW + 2;
      const ly = PAD_T + ((LOG_MAX - labelLogW) / (LOG_MAX - LOG_MIN)) * PH;
      ctx.font = '600 10px var(--ff-mono, monospace)';
      ctx.fillStyle = curve.color;
      ctx.textAlign = 'left';
      ctx.fillText(curve.label, lx, ly - 3);
      ctx.globalAlpha = 1;
    });

    // Vertical shaded region: "effective chunk range" at K=4, C=512
    const chunkEnd = 4 * 512;
    const shadeX = PAD_L + (chunkEnd / MAX_DIST) * PW;
    ctx.fillStyle = 'rgba(139,92,246,0.06)';
    ctx.fillRect(PAD_L, PAD_T, shadeX - PAD_L, PH);
    ctx.fillStyle = 'rgba(139,92,246,0.6)';
    ctx.font = '10px var(--ff-mono, monospace)';
    ctx.textAlign = 'center';
    ctx.fillText('K=4 chunks selected', PAD_L + (shadeX - PAD_L) / 2, PAD_T + 14);
  }

  drawDecay();

  function setDecayCurves(indices) {
    shownCurves = indices;
    drawDecay();
  }

  document.getElementById('decay-all').addEventListener('click', () => {
    setDecayCurves([0, 1, 2]);
    document.querySelectorAll('[id^="decay-"]').forEach(b => b.classList.remove('active'));
    document.getElementById('decay-all').classList.add('active');
  });
  document.getElementById('decay-early').addEventListener('click', () => {
    setDecayCurves([0]);
    document.querySelectorAll('[id^="decay-"]').forEach(b => b.classList.remove('active'));
    document.getElementById('decay-early').classList.add('active');
  });
  document.getElementById('decay-mid').addEventListener('click', () => {
    setDecayCurves([1]);
    document.querySelectorAll('[id^="decay-"]').forEach(b => b.classList.remove('active'));
    document.getElementById('decay-mid').classList.add('active');
  });
  document.getElementById('decay-late').addEventListener('click', () => {
    setDecayCurves([2]);
    document.querySelectorAll('[id^="decay-"]').forEach(b => b.classList.remove('active'));
    document.getElementById('decay-late').classList.add('active');
  });
})();

// ══════════════════════════════════════════════════════════════════════════
// §04 — BOS ANCHOR CANVAS
// ══════════════════════════════════════════════════════════════════════════
(function() {
  const canvas = document.getElementById('canvas-bos');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth;
  const H = 260;
  canvas.width  = W * DPR;
  canvas.height = H * DPR;
  ctx.scale(DPR, DPR);

  let showBOS = false;
  const N_POSITIONS = 60;
  const PAD_L = 30, PAD_R = 16, PAD_T = 26, PAD_B = 56;
  const PW = W - PAD_L - PAD_R;
  const PH = H - PAD_T - PAD_B;
  const N_CHUNKS = 6;
  const BAR_H = PH * 0.55;
  const EM_H = PH * 0.35;
  const EM_Y = PAD_T + BAR_H + 16;

  // Seeded PRNG for reproducible noise
  function seeded(n) {
    return ((1664525 * n + 1013904223) & 0x7fffffff) / 0x7fffffff;
  }

  function drawBOS() {
    ctx.clearRect(0, 0, W, H);

    // Section label
    ctx.font = '600 11px var(--ff-mono, monospace)';
    ctx.fillStyle = showBOS ? '#06b6d4' : 'rgba(239,68,68,0.8)';
    ctx.textAlign = 'center';
    ctx.fillText(showBOS ? 'With chunk-level BOS tokens — periodic attention anchors' : 'Without BOS — attention sink at token 0', W / 2, 14);

    // Attention weight bars
    const barW = Math.max(2, Math.floor(PW / N_POSITIONS) - 1);

    for (let i = 0; i < N_POSITIONS; i++) {
      const x = PAD_L + (i / N_POSITIONS) * PW;
      const chunkIdx = Math.floor(i / (N_POSITIONS / N_CHUNKS));
      const localPos = i % (N_POSITIONS / N_CHUNKS);
      const isBOSPos = localPos === 0;
      const isFirst = i === 0;

      let weight;
      if (!showBOS) {
        // Without BOS: steep locality + attention sink at 0
        const dist = N_POSITIONS - 1 - i;  // distance from response (end)
        weight = Math.exp(-dist / 4) * (1 + seeded(i) * 0.3);
        if (isFirst) weight += 0.6;  // attention sink at start
        weight = Math.min(weight, 1.0);
      } else {
        // With BOS: periodic spikes at chunk boundaries + locality
        const dist = N_POSITIONS - 1 - i;
        weight = Math.exp(-dist / 5) * (0.3 + seeded(i) * 0.25);
        if (isBOSPos) weight = 0.3 + seeded(i * 3) * 0.15;  // anchor spike
        weight = Math.min(weight, 1.0);
      }

      const barH = weight * BAR_H;
      const barY = PAD_T + BAR_H - barH;

      // Color based on type
      let color;
      if (!showBOS && isFirst) {
        color = '#f87171';  // attention sink — red
      } else if (showBOS && isBOSPos) {
        color = '#06b6d4';  // BOS anchor — teal
      } else {
        const alpha = 0.2 + weight * 0.5;
        color = showBOS ? `rgba(139,92,246,${alpha.toFixed(2)})` : `rgba(239,68,68,${alpha.toFixed(2)})`;
      }

      ctx.fillStyle = color;
      ctx.fillRect(x, barY, barW, barH);
    }

    // Axis labels
    ctx.fillStyle = 'rgba(255,255,255,0.25)';
    ctx.font = '9px var(--ff-mono, monospace)';
    ctx.textAlign = 'left';
    ctx.fillText('← start of prefix', PAD_L, PAD_T + BAR_H + 8);
    ctx.textAlign = 'right';
    ctx.fillText('end of prefix (near response) →', PAD_L + PW, PAD_T + BAR_H + 8);

    // EM accuracy curve
    ctx.fillStyle = 'rgba(255,255,255,0.06)';
    ctx.fillRect(PAD_L, EM_Y, PW, EM_H);

    ctx.font = '600 9px var(--ff-mono, monospace)';
    ctx.fillStyle = 'rgba(255,255,255,0.25)';
    ctx.textAlign = 'left';
    ctx.fillText('Exact-Match accuracy by position', PAD_L, EM_Y - 4);

    // Draw EM curve
    ctx.strokeStyle = showBOS ? '#10b981' : '#ef4444';
    ctx.lineWidth = 2;
    ctx.beginPath();
    for (let i = 0; i < N_POSITIONS; i++) {
      const x = PAD_L + ((i + 0.5) / N_POSITIONS) * PW;
      let em;
      if (showBOS) {
        // Flat high EM across positions
        em = 0.88 + seeded(i * 7) * 0.08;
      } else {
        // Drops for early positions (far from response)
        const frac = i / (N_POSITIONS - 1);
        em = 0.15 + frac * 0.7 + seeded(i * 5) * 0.06;
        em = Math.min(em, 0.92);
      }
      const y = EM_Y + EM_H - em * (EM_H - 4) - 2;
      if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
    }
    ctx.stroke();

    // EM axis
    ctx.fillStyle = 'rgba(255,255,255,0.25)';
    ctx.font = '9px var(--ff-mono, monospace)';
    ctx.textAlign = 'right';
    ctx.fillText('100%', PAD_L - 2, EM_Y + 4);
    ctx.fillText('0%', PAD_L - 2, EM_Y + EM_H);
  }

  drawBOS();

  document.getElementById('bos-off').addEventListener('click', () => {
    showBOS = false;
    document.getElementById('bos-off').classList.add('active');
    document.getElementById('bos-on').classList.remove('active');
    drawBOS();
  });
  document.getElementById('bos-on').addEventListener('click', () => {
    showBOS = true;
    document.getElementById('bos-on').classList.add('active');
    document.getElementById('bos-off').classList.remove('active');
    drawBOS();
  });
})();

// ══════════════════════════════════════════════════════════════════════════
// §05 — SPEEDUP CHART CANVAS
// ══════════════════════════════════════════════════════════════════════════
(function() {
  const canvas = document.getElementById('canvas-speed');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth;
  const H = 260;
  canvas.width  = W * DPR;
  canvas.height = H * DPR;
  ctx.scale(DPR, DPR);

  const PAD_L = 48, PAD_R = 20, PAD_T = 20, PAD_B = 36;
  const PW = W - PAD_L - PAD_R;
  const PH = H - PAD_T - PAD_B;

  // Data: [8K, 16K, 32K] speedup vs Transformers baseline
  const methods = [
    { label: 'dKV-Cache',        color: 'rgba(107,114,128,0.7)',  data: [3.2, 4.5,  5.8] },
    { label: 'Fast-dLLM v2',     color: 'rgba(6,182,212,0.7)',    data: [5.3, 7.5,  9.0] },
    { label: 'Sparse-dLLM',      color: 'rgba(245,158,11,0.8)',   data: [15.3, 11.9, 4.2] },
    { label: 'Prefilling-dLLM',  color: '#8b5cf6',                data: [9.1, 16.1, 28.0], bold: true },
  ];

  const X_LABELS = ['8K', '16K', '32K'];
  const MAX_Y = 32;
  const MIN_Y = 0;

  let animProgress = 0;
  let rafId = null;

  function xPos(i) { return PAD_L + (i / 2) * PW; }
  function yPos(v) { return PAD_T + PH - ((v - MIN_Y) / (MAX_Y - MIN_Y)) * PH; }

  function draw(progress) {
    ctx.clearRect(0, 0, W, H);

    // Grid
    ctx.strokeStyle = 'rgba(255,255,255,0.05)';
    ctx.lineWidth = 1;
    [0, 5, 10, 15, 20, 25, 30].forEach(v => {
      const y = yPos(v);
      ctx.beginPath(); ctx.moveTo(PAD_L, y); ctx.lineTo(PAD_L + PW, y); ctx.stroke();
      ctx.fillStyle = 'rgba(255,255,255,0.25)';
      ctx.font = '10px var(--ff-mono, monospace)';
      ctx.textAlign = 'right';
      ctx.fillText(v + '×', PAD_L - 4, y + 3);
    });

    // X axis labels
    ctx.fillStyle = 'rgba(255,255,255,0.4)';
    ctx.font = '11px var(--ff-mono, monospace)';
    ctx.textAlign = 'center';
    X_LABELS.forEach((lbl, i) => {
      ctx.fillText(lbl, xPos(i), H - 4);
    });

    // Y axis title
    ctx.save();
    ctx.translate(12, PAD_T + PH / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.fillStyle = 'rgba(255,255,255,0.25)';
    ctx.font = '10px var(--ff-mono, monospace)';
    ctx.textAlign = 'center';
    ctx.fillText('speedup vs baseline', 0, 0);
    ctx.restore();

    // Baseline at 1×
    ctx.setLineDash([4, 4]);
    ctx.strokeStyle = 'rgba(255,255,255,0.15)';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(PAD_L, yPos(1)); ctx.lineTo(PAD_L + PW, yPos(1));
    ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle = 'rgba(255,255,255,0.2)';
    ctx.font = '9px var(--ff-mono, monospace)';
    ctx.textAlign = 'left';
    ctx.fillText('1× (baseline)', PAD_L + 4, yPos(1) - 4);

    // Draw method lines
    methods.forEach((method) => {
      const pts = method.data.length;
      ctx.strokeStyle = method.color;
      ctx.lineWidth = method.bold ? 2.5 : 1.8;
      ctx.globalAlpha = method.bold ? 1.0 : 0.85;
      ctx.beginPath();
      for (let i = 0; i < pts; i++) {
        const px = progress < (i + 1) / pts
          ? xPos(i - 1) + (xPos(i) - xPos(i - 1)) * (progress - (i - 1) / pts) / (1 / pts)
          : xPos(i);
        const py = yPos(method.data[i]);
        const drawX = i === 0 ? xPos(0) : Math.min(px, xPos(i));
        const drawY = i === 0 ? yPos(method.data[0]) : py;
        if (i === 0 || progress * pts < 0.1) {
          ctx.moveTo(xPos(0), yPos(method.data[0]));
        } else {
          ctx.lineTo(Math.min(xPos(i), xPos(0) + progress * PW), drawY);
        }
      }
      // Simpler: just draw all points when progress reached
      ctx.beginPath();
      method.data.forEach((v, i) => {
        const frac = i / (method.data.length - 1);
        if (progress < frac) return;
        const x = xPos(i);
        const y = yPos(v);
        if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
      });
      // Interpolate last segment
      const lastFull = Math.floor(progress * (pts - 1));
      if (lastFull < pts - 1) {
        const segFrac = (progress * (pts - 1)) - lastFull;
        const x0 = xPos(lastFull), x1 = xPos(lastFull + 1);
        const y0 = yPos(method.data[lastFull]), y1 = yPos(method.data[lastFull + 1]);
        ctx.lineTo(x0 + (x1 - x0) * segFrac, y0 + (y1 - y0) * segFrac);
      }
      ctx.stroke();

      // Data point dots
      method.data.forEach((v, i) => {
        if (progress < i / (pts - 1) - 0.05) return;
        const x = xPos(i), y = yPos(v);
        ctx.beginPath();
        ctx.arc(x, y, method.bold ? 4.5 : 3, 0, Math.PI * 2);
        ctx.fillStyle = method.color;
        ctx.fill();
        // Annotation for our method
        if (method.bold) {
          ctx.font = '600 11px var(--ff-mono, monospace)';
          ctx.fillStyle = method.color;
          ctx.textAlign = 'center';
          ctx.fillText(v + '×', x, y - 10);
        }
      });
      ctx.globalAlpha = 1;
    });

    // Legend
    ctx.font = '10px var(--ff-mono, monospace)';
    ctx.textAlign = 'left';
    let lx = PAD_L + 4, ly = PAD_T + 8;
    methods.slice().reverse().forEach((m) => {
      ctx.fillStyle = m.color;
      ctx.fillRect(lx, ly - 6, 18, 3);
      ctx.fillStyle = m.bold ? 'rgba(255,255,255,0.8)' : 'rgba(255,255,255,0.4)';
      ctx.fillText(m.label, lx + 22, ly);
      lx += ctx.measureText(m.label).width + 50;
      if (lx > W - 100) { lx = PAD_L + 4; ly += 16; }
    });
  }

  // Animate once when scrolled into view
  let started = false;
  function startAnim() {
    if (started) return;
    started = true;
    const startTime = performance.now();
    const DURATION = 1400;
    function frame(ts) {
      const t = Math.min(1, (ts - startTime) / DURATION);
      const ease = t < 0.5 ? 2 * t * t : -1 + (4 - 2 * t) * t;
      draw(ease);
      if (t < 1) rafId = requestAnimationFrame(frame);
    }
    rafId = requestAnimationFrame(frame);
  }

  const section5 = document.getElementById('s-speed');
  if (section5) {
    new IntersectionObserver(entries => {
      entries.forEach(e => { if (e.isIntersecting) startAnim(); });
    }, { threshold: 0.3 }).observe(section5);
  } else {
    startAnim();
  }
})();

// ══════════════════════════════════════════════════════════════════════════
// §06 — ANIMATED BAR CHARTS
// ══════════════════════════════════════════════════════════════════════════
function triggerBars(containerEl) {
  containerEl.querySelectorAll('.bar-fill[data-w]').forEach(b => {
    b.style.width = (parseFloat(b.dataset.w) / 100 * 100) + '%';
  });
}
['results-bars-infinite', 'results-bars-long'].forEach(id => {
  const el = document.getElementById(id);
  if (!el) return;
  new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) triggerBars(el); });
  }, { threshold: 0.25 }).observe(el);
});
</script>
</BaseLayout>

<span class="cs-line hl-p">        <span class="str">"HumanEval"</span>: <span class="num">22.6</span>, <span class="str">"MBPP"</span>: <span class="num">26.6</span>,</span>
<span class="cs-line hl-p">        <span class="str">"PIQA"</span>: <span class="num">66.4</span>,  <span class="cmt"># ⚠ weak</span></span>

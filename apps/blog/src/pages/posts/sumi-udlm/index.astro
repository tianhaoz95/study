      <pre class="cs-pre">
<span class="cs-line cmt"># Fixed canvas generation</span>
<span class="cs-line cmt"># Always 2048 tokens; no dynamic len</span>
<span class="cs-line"></span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">generate</span>(prompt, gen_len=<span class="num">512</span>):</span>
<span class="cs-line">    CANVAS = <span class="num">2048</span></span>
<span class="cs-line"></span>
<span class="cs-line hl-c">    <span class="cmt"># 1. Fill canvas with random noise</span></span>
<span class="cs-line">    canvas = <span class="fn">randint</span>(<span class="num">0</span>, V, [CANVAS])</span>
<span class="cs-line"></span>
<span class="cs-line hl-g">    <span class="cmt"># 2. Place prompt at start (fixed)</span></span>
<span class="cs-line">    canvas[:<span class="fn">len</span>(prompt)] = prompt</span>
<span class="cs-line"></span>
<span class="cs-line hl-a">    <span class="cmt"># 3. Insert EOS+BOS boundary</span></span>
<span class="cs-line">    p = <span class="fn">len</span>(prompt)</span>
<span class="cs-line">    canvas[p:p+<span class="num">2</span>] = [EOS, BOS]</span>
<span class="cs-line"></span>
<span class="cs-line hl-p">    <span class="cmt"># 4. Denoise only gen region</span></span>
<span class="cs-line">    gen = canvas[p+<span class="num">2</span> : p+<span class="num">2</span>+gen_len]</span>
<span class="cs-line">    <span class="kw">return</span> <span class="fn">denoise_region</span>(canvas, gen)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Canvas length sensitivity:</span>
<span class="cs-line cmt"># &lt;1024: fluency degrades (esp GSM8K)</span>
<span class="cs-line cmt"># 1024-4096: fluent band (in-training)</span>
<span class="cs-line cmt"># &gt;4096: mild degradation</span>
<span class="cs-line cmt"># 2048 = safe default for all tasks</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Generation lengths used:</span>
<span class="cs-line cmt"># BBH:       512 tokens</span>
<span class="cs-line cmt"># GSM8K:      64 tokens</span>
<span class="cs-line cmt"># HumanEval: 256 tokens</span>
<span class="cs-line cmt"># MBPP:      256 tokens</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-commit">
      <pre class="cs-pre">
<span class="cs-line cmt"># Confidence-based adaptive sampling</span>
<span class="cs-line"></span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">confidence_step</span>(z_t, model, k=<span class="num">1</span>):</span>
<span class="cs-line">    logits = <span class="fn">model</span>(z_t)</span>
<span class="cs-line">    probs  = <span class="fn">softmax</span>(logits, dim=-<span class="num">1</span>)</span>
<span class="cs-line"></span>
<span class="cs-line hl-c">    <span class="cmt"># Score: model confidence in change</span></span>
<span class="cs-line">    best_p = probs.<span class="fn">max</span>(dim=-<span class="num">1</span>).values</span>
<span class="cs-line">    curr_p = probs.<span class="fn">gather</span>(-<span class="num">1</span>, z_t)</span>
<span class="cs-line hl-p">    score  = best_p - curr_p</span>
<span class="cs-line"></span>
<span class="cs-line hl-g">    <span class="cmt"># Only score still-noisy positions</span></span>
<span class="cs-line">    noisy  = <span class="fn">is_prior_noisy</span>(z_t)</span>
<span class="cs-line">    candidates = score * noisy</span>
<span class="cs-line"></span>
<span class="cs-line">    <span class="cmt"># Commit top-k confident positions</span></span>
<span class="cs-line">    topk = <span class="fn">topk</span>(candidates, k).indices</span>
<span class="cs-line">    z_t[topk] = probs[topk].<span class="fn">argmax</span>(-<span class="num">1</span>)</span>
<span class="cs-line">    <span class="kw">return</span> z_t</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Key insight: no explicit order!</span>
<span class="cs-line cmt"># The sampler discovers structure:</span>
<span class="cs-line cmt"># - Adaptive: task-shaped commit order</span>
<span class="cs-line cmt"># - Ancestral: essentially random</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># From Fig 3: adaptive induces</span>
<span class="cs-line cmt"># visible per-position structure</span>
<span class="cs-line cmt"># ancestral = uniform noise pattern</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-parallel">
      <pre class="cs-pre">
<span class="cs-line cmt"># Parallel decoding: k tokens/step</span>
<span class="cs-line"></span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">parallel_decode</span>(z_t, model, k=<span class="num">1</span>):</span>
<span class="cs-line">    <span class="kw">for</span> step <span class="kw">in</span> <span class="fn">range</span>(gen_len // k):</span>
<span class="cs-line hl-p">        z_t = <span class="fn">confidence_step</span>(z_t, model, k)</span>
<span class="cs-line">    <span class="kw">return</span> z_t</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Results (N=30 per task, from Fig 4):</span>
<span class="cs-line"><span class="kw">class</span> <span class="cls">ParallelResults</span>:</span>
<span class="cs-line">    <span class="cmt"># k=4: near-baseline on coding</span></span>
<span class="cs-line hl-g">    HumanEval = &#123;<span class="num">1</span>: <span class="num">22.6</span>, <span class="num">4</span>: <span class="num">20.7</span>&#125;</span>
<span class="cs-line hl-g">    MBPP      = &#123;<span class="num">1</span>: <span class="num">26.6</span>, <span class="num">4</span>: <span class="num">23.3</span>&#125;</span>
<span class="cs-line"></span>
<span class="cs-line">    <span class="cmt"># k=2: already hurts math</span></span>
<span class="cs-line hl-a">    GSM8K     = &#123;<span class="num">1</span>: <span class="num">32.8</span>, <span class="num">2</span>: <span class="num">17.0</span>&#125;</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Why does coding tolerate k=4?</span>
<span class="cs-line cmt"># Code has many "locally obvious" tokens</span>
<span class="cs-line cmt"># (keywords, punctuation, indent)</span>
<span class="cs-line cmt"># → confidence sampler can batch them</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Why does math fail at k=2?</span>
<span class="cs-line cmt"># Chain-of-thought: each intermediate</span>
<span class="cs-line cmt"># result gates all subsequent tokens</span>
<span class="cs-line cmt"># → one wrong commit cascades</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-results">
      <pre class="cs-pre">
<span class="cs-line cmt"># Benchmark results — Table 1</span>
<span class="cs-line cmt"># All models: ~1.5-2.5T tokens</span>
<span class="cs-line"></span>
<span class="cs-line"><span class="cls">RESULTS</span> = &#123;</span>

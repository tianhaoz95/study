.results-table th{background:var(--surface);padding:.5rem .75rem;text-align:left;font-size:.67rem;font-weight:600;letter-spacing:.07em;text-transform:uppercase;color:var(--muted);border-bottom:1px solid var(--border)}
.results-table td{padding:.5rem .75rem;border-bottom:1px solid var(--border);font-size:.8rem;color:var(--muted2)}
.results-table tr:last-child td{border-bottom:none}
.results-table tr:hover td{background:rgba(255,255,255,.018)}
.results-table .mn{font-family:var(--ff-mono);font-size:.75rem;color:var(--text2)}
.results-table .highlight-row td{background:rgba(139,92,246,.06)}
.results-table .highlight-row .mn{color:var(--purple-l)}
.results-table .best{color:var(--cyan);font-weight:700}

/* Animated bar chart */
.results-bars{margin:1.5rem 0;display:flex;flex-direction:column;gap:.625rem}
.bar-row{display:flex;align-items:center;gap:.75rem}
.bar-label{font-size:.72rem;font-family:var(--ff-mono);color:var(--muted2);width:220px;flex-shrink:0;text-align:right;line-height:1.3}
.bar-track{flex:1;background:var(--card2);border-radius:4px;height:22px;overflow:hidden}
.bar-fill{height:100%;border-radius:4px;transition:width 1s ease;display:flex;align-items:center;justify-content:flex-end;padding-right:.5rem;width:0%}
.bar-fill span{font-size:.65rem;font-weight:700;font-family:var(--ff-mono);color:rgba(255,255,255,.85)}

/* Math block */
.math-block{background:var(--card2);border:1px solid var(--border);border-radius:8px;padding:1rem 1.25rem;margin:1.25rem 0;font-family:var(--ff-mono);font-size:.82rem;color:var(--text2);line-height:2;overflow-x:auto}
.math-label{font-size:.65rem;font-weight:600;letter-spacing:.07em;text-transform:uppercase;color:var(--muted);margin-bottom:.5rem;font-family:var(--ff-mono)}
.math-var{color:var(--cyan);font-style:italic}
.math-comment{color:var(--muted);font-style:italic;font-size:.7rem}

/* Comparison canvas wrapper */
.compare-wrap{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin:1.25rem 0}
@media(max-width:680px){.compare-wrap{grid-template-columns:1fr}}
.compare-panel{background:var(--card2);border:1px solid var(--border);border-radius:8px;overflow:hidden}
.compare-label{font-size:.67rem;font-weight:600;letter-spacing:.07em;text-transform:uppercase;padding:.5rem .75rem;border-bottom:1px solid var(--border);font-family:var(--ff-mono)}
.compare-label.label-red{color:var(--amber);background:rgba(245,158,11,.06)}
.compare-label.label-green{color:var(--green);background:rgba(16,185,129,.06)}

/* Commit order grid */
.commit-grid{display:grid;gap:3px;padding:.75rem;font-family:var(--ff-mono);font-size:.62rem}
.commit-cell{border-radius:3px;height:22px;display:flex;align-items:center;justify-content:center;font-size:.58rem;transition:background .3s}

/* Btn row */
.btn-row{display:flex;gap:.5rem;flex-wrap:wrap;margin-bottom:1rem}
.viz-btn{padding:.3rem .75rem;border-radius:5px;font-size:.71rem;font-family:var(--ff-mono);cursor:pointer;border:1px solid var(--border-hi);background:var(--surface);color:var(--muted2);transition:all .15s}
.viz-btn:hover{border-color:var(--cyan);color:var(--cyan);background:var(--cyan-dim)}
.viz-btn.active{border-color:var(--purple);color:var(--purple-l);background:var(--purple-dim)}

/* Token row viz */
.token-row{display:flex;gap:4px;flex-wrap:wrap;margin:1rem 0;align-items:center}
.tok{display:inline-flex;align-items:center;justify-content:center;min-width:40px;height:32px;border-radius:5px;font-family:var(--ff-mono);font-size:.72rem;font-weight:600;border:1px solid transparent;transition:all .4s;position:relative;padding:0 6px}
.tok.noise{background:rgba(107,114,128,.15);border-color:rgba(107,114,128,.3);color:var(--muted)}
.tok.committed{background:rgba(139,92,246,.15);border-color:rgba(139,92,246,.5);color:var(--purple-l)}
.tok.locked{background:rgba(16,185,129,.12);border-color:rgba(16,185,129,.4);color:var(--green)}
.tok-lock{position:absolute;top:-6px;right:-4px;font-size:.55rem;background:var(--amber);color:#000;border-radius:3px;padding:0 2px;line-height:14px}


const barsContainer = document.getElementById('performance-bars-container');
const performanceTableEl = document.getElementById('performance-table-el');

function showBenchmark(key) {
  if (!barsContainer || !performanceTableEl) return;
  const currentDataset = benchmarksData[key];
  
  // Render Bars for Average Score
  barsContainer.innerHTML = '';
  currentDataset.rows.forEach(r => {
    const rowEl = document.createElement('div');
    rowEl.className = 'bar-row';
    
    const label = document.createElement('div');
    label.className = 'bar-label';
    label.textContent = r.name;
    
    const track = document.createElement('div');
    track.className = 'bar-track';
    
    const fill = document.createElement('div');
    fill.className = 'bar-fill';
    const score = r.data[r.data.length - 1]; // Avg is the last item
    
    // Highlight or standard coloring
    if (r.highlight) {
      fill.style.background = 'linear-gradient(90deg, var(--purple), var(--purple-l))';
    } else if (r.name.includes("Teacher")) {
      fill.style.background = 'rgba(6, 182, 212, 0.4)';
    } else if (r.name.includes("REOPOLD")) {
      fill.style.background = 'var(--cyan)';
    } else {
      fill.style.background = 'var(--border-hi)';
    }
    
    fill.style.width = '0%'; // Animate on show
    fill.innerHTML = `<span>${score.toFixed(2)}%</span>`;
    
    track.appendChild(fill);
    rowEl.appendChild(label);
    rowEl.appendChild(track);
    barsContainer.appendChild(rowEl);
    
    // Trigger animation
    setTimeout(() => {
      fill.style.width = `${score}%`;
    }, 50);
  });
  
  // Render Comparison Table
  let tableHTML = `
    <thead>
      <tr>
        ${currentDataset.headers.map(h => `<th>${h}</th>`).join('')}
      </tr>
    </thead>
    <tbody>
      ${currentDataset.rows.map(r => `
        <tr class="${r.highlight ? 'highlight-row' : ''}">
          <td style="${r.highlight ? 'font-weight:700;' : ''}">${r.name}</td>
          ${r.data.map((val, idx) => {
            const isBest = r.highlight && r.fill && !r.name.includes("Teacher");
            return `<td class="mn ${isBest ? 'best' : ''}">${val.toFixed(2)}%</td>`;
          }).join('')}
        </tr>
      `).join('')}
    </tbody>
  `;
  performanceTableEl.innerHTML = tableHTML;
}


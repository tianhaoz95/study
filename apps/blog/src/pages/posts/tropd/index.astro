// ----------------------------------------------------
// INTERACTIVE 3: Vocabulary Distribution Shift Canvas
// ----------------------------------------------------
const distCanvas = document.getElementById('dist-canvas');
if (distCanvas) {
  const ctx = distCanvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  
  let distMode = 'rkl'; // rkl or fkd
  let stepProgress = 0.0;
  let targetProgress = 0.0;
  
  function resizeDistCanvas() {
    const W = distCanvas.clientWidth;
    const H = 200;
    distCanvas.width = W * DPR;
    distCanvas.height = H * DPR;
    ctx.scale(DPR, DPR);
    drawDist();
  }
  
  // Vocabulary items at the mismatch step (outlier step)
  // Teacher Top-K (64) is concentrated on correct roots "2" or "3". Student has a spike on "7".
  const vocab = [
    { token: "2", teacher: 0.48, studentStart: 0.05, studentEnd: 0.40 },
    { token: "3", teacher: 0.42, studentStart: 0.05, studentEnd: 0.38 },
    { token: "7", teacher: 0.0001, studentStart: 0.60, studentEnd: 0.02 },
    { token: "other", teacher: 0.10, studentStart: 0.30, studentEnd: 0.20 }
  ];
  
  function drawDist() {
    const W = distCanvas.clientWidth;
    const H = 200;
    ctx.clearRect(0, 0, W, H);
    
    // Draw columns
    const colW = (W - 80) / vocab.length;
    
    vocab.forEach((v, idx) => {
      const cx = 50 + idx * colW + colW / 2;
      
      // Interpolate student prob
      const currentStudent = v.studentStart + (v.studentEnd - v.studentStart) * stepProgress;
      
      // Draw grid line
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.03)';
      ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(50, H - 40 - idx*30); ctx.lineTo(W - 20, H - 40 - idx*30); ctx.stroke();
      
      // Draw bars side-by-side
      const barW = Math.min(30, colW * 0.35);
      
      // Teacher Bar (Cyan)
      ctx.fillStyle = 'rgba(6, 182, 212, 0.7)';
      const tH = v.teacher * 100;
      ctx.fillRect(cx - barW - 2, H - 40 - tH, barW, tH);
      
      // Student Bar (Purple)
      ctx.fillStyle = 'rgba(139, 92, 246, 0.8)';
      const sH = currentStudent * 100;
      ctx.fillRect(cx + 2, H - 40 - sH, barW, sH);
      
      // Label token
      ctx.fillStyle = 'var(--text2)';
      ctx.font = '10px var(--ff-mono)';
      ctx.textAlign = 'center';
      ctx.fillText(`"${v.token}"`, cx, H - 20);
      
      // Label probs
      ctx.font = '8px var(--ff-mono)';
      ctx.fillStyle = 'var(--cyan)';
      ctx.fillText(v.teacher.toFixed(2), cx - barW/2 - 2, H - 45 - tH);
      ctx.fillStyle = 'var(--purple-l)';
      ctx.fillText(currentStudent.toFixed(2), cx + barW/2 + 2, H - 45 - sH);
    });
    
    // Legend
    ctx.fillStyle = 'var(--muted)';
    ctx.font = '9px var(--ff-mono)';
    ctx.textAlign = 'left';
    ctx.fillRect(W - 130, 20, 10, 10);
    ctx.fillStyle = 'rgba(6, 182, 212, 0.7)'; ctx.fillRect(W - 130, 20, 10, 10);
    ctx.fillStyle = 'var(--muted)'; ctx.fillText('Teacher P_T', W - 115, 28);
    
    ctx.fillStyle = 'rgba(139, 92, 246, 0.8)'; ctx.fillRect(W - 130, 35, 10, 10);
    ctx.fillStyle = 'var(--muted)'; ctx.fillText('Student P_S', W - 115, 43);
    
    ctx.fillStyle = 'var(--text2)';
    ctx.fillText(distMode === 'rkl' ? 'Mode Seeking (Reverse KL)' : 'Mode Covering (Top-k Forward KL)', 50, 30);
  }
  
  function updateDistStep() {
    if (Math.abs(stepProgress - targetProgress) < 0.01) {
      stepProgress = targetProgress;
      drawDist();
      return;
    }
    stepProgress += (targetProgress - stepProgress) * 0.1;
    drawDist();
    requestAnimationFrame(updateDistStep);
  }
  
  document.getElementById('dist-opd-btn')?.addEventListener('click', (e) => {
    document.querySelectorAll('#s-outliers .chart-btn').forEach(btn => btn.classList.remove('active'));
    e.target.classList.add('active');
    distMode = 'rkl';
    targetProgress = 0.0;
    requestAnimationFrame(updateDistStep);
  });
  
  document.getElementById('dist-fkd-btn')?.addEventListener('click', (e) => {
    document.querySelectorAll('#s-outliers .chart-btn').forEach(btn => btn.classList.remove('active'));
    e.target.classList.add('active');
    distMode = 'fkd';
    targetProgress = 1.0;
    requestAnimationFrame(updateDistStep);
  });
  
  document.getElementById('dist-step-btn')?.addEventListener('click', () => {
    if (distMode === 'rkl') {
      // Reverse KL fails to move student properly, or mode collapses
      alert('Reverse KL gradient is unstable at outlier step x="7" because P_T(x) is near 0. Student weights fail to update constructively.');
    } else {
      // Forward KL pulls student mass to teacher top keys
      targetProgress = 1.0;
      requestAnimationFrame(updateDistStep);
    }
  });
  
  window.addEventListener('resize', resizeDistCanvas);
  resizeDistCanvas();
}

// ----------------------------------------------------
// INTERACTIVE 4: Prefix Annealing Timeline
// ----------------------------------------------------
const annealSlider = document.getElementById('anneal-slider');
const annealStepLabel = document.getElementById('anneal-step-label');
const annealRatioLabel = document.getElementById('anneal-ratio-label');
const annealTokensWrapper = document.getElementById('anneal-tokens-wrapper');

const sampleTokens = [
  "Solve", "x^2", "-", "5x", "+", "6", "=", "0.", "factoring", "gives", "(x", "-", "2)", "(x", "-", "3)", "=", "0,", "so", "x", "=", "2", "or", "x", "=", "3."
];

function updateAnnealing() {
  if (!annealSlider || !annealStepLabel || !annealRatioLabel || !annealTokensWrapper) return;
  
  const step = parseInt(annealSlider.value);
  annealStepLabel.textContent = step;
  
  // Cosine annealing schedule
  const progress = step / 200;
  const factor = 0.5 * (1.0 + Math.cos(Math.PI * progress));
  annealRatioLabel.textContent = `${Math.round(factor * 100)}%`;
  
  const teacherPrefixLength = Math.round(sampleTokens.length * factor);
  
  annealTokensWrapper.innerHTML = '';
  sampleTokens.forEach((tok, idx) => {
    const span = document.createElement('span');
    span.textContent = tok;
    span.style.padding = '0.1rem 0.25rem';
    span.style.borderRadius = '3px';
    span.style.margin = '1px';
    
    if (idx < teacherPrefixLength) {
      span.style.background = 'rgba(6, 182, 212, 0.15)';
      span.style.color = 'var(--cyan)';
      span.style.border = '1px solid rgba(6, 182, 212, 0.3)';
    } else {
      span.style.background = 'rgba(16, 185, 129, 0.12)';
      span.style.color = 'var(--green-l)';
      span.style.border = '1px solid rgba(16, 185, 129, 0.3)';
    }
    annealTokensWrapper.appendChild(span);
  });
}

if (annealSlider) {
  annealSlider.addEventListener('input', updateAnnealing);
  updateAnnealing();
}


    <!-- Panel Intro -->
    <div class="cs-panel active" id="panel-intro">
      <pre class="cs-pre"><span class="cs-line cmt"># Policy gradient calculation under standard Reverse-KL OPD</span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">compute_policy_gradient</span>(log_probs_student, log_probs_teacher):</span>
<span class="cs-line hl-c">    <span class="cmt"># Advantage term is log(P_T / P_S)</span></span>
<span class="cs-line hl-c">    advantage = log_probs_teacher - log_probs_student</span>
<span class="cs-line">    </span>
<span class="cs-line cmt">    # When P_T &lt;&lt; P_S, advantage -&gt; -infinity</span>
<span class="cs-line cmt">    # This leads to unstable gradient updates</span>
<span class="cs-line hl-p">    loss = -(advantage * log_probs_student).mean()</span>
<span class="cs-line">    </span>
<span class="cs-line">    <span class="kw">return</span> loss</span></pre>
    </div>
    
    <!-- Panel Trust Region -->
    <div class="cs-panel" id="panel-trust_region">
      <pre class="cs-pre"><span class="cs-line cmt"># Speculative agreement ratio for Trust Region filtering</span>
<span class="cs-line"><span class="kw">import</span> torch</span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">get_trust_region_mask</span>(probs_student, probs_teacher):</span>
<span class="cs-line hl-c">    <span class="cmt"># agreement probability = min(P_T / P_S, 1.0)</span></span>
<span class="cs-line hl-c">    trust_probs = torch.minimum(probs_teacher / (probs_student + 1e-8), torch.ones_like(probs_student))</span>
<span class="cs-line">    </span>
<span class="cs-line cmt">    # Sample Bernoulli mask for Trust Region (M_x)</span>
<span class="cs-line hl-g">    trust_mask = torch.bernoulli(trust_probs)</span>
<span class="cs-line">    </span>
<span class="cs-line">    <span class="kw">return</span> trust_mask</span></pre>
    </div>

    <!-- Panel Outlier FKD -->
    <div class="cs-panel" id="panel-outlier_fkd">
      <pre class="cs-pre"><span class="cs-line cmt"># Auxiliary Top-k Forward KL Loss on Outliers</span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">compute_outlier_fkd</span>(logits_student, probs_teacher, mask_outliers, k=64):</span>
<span class="cs-line cmt">    # Get top-k values and indices under teacher distribution</span>
<span class="cs-line">    topk_probs, topk_indices = torch.topk(probs_teacher, k=k, dim=-1)</span>
<span class="cs-line">    </span>
<span class="cs-line cmt">    # Normalize top-k teacher probabilities</span>
<span class="cs-line">    topk_probs = topk_probs / topk_probs.sum(dim=-1, keepdim=True)</span>
<span class="cs-line">    </span>
<span class="cs-line cmt">    # Gather student log probabilities for those top-k tokens</span>
<span class="cs-line">    log_probs_student = torch.log_softmax(logits_student, dim=-1)</span>
<span class="cs-line">    topk_student_log_probs = torch.gather(log_probs_student, dim=-1, index=topk_indices)</span>
<span class="cs-line">    </span>
<span class="cs-line cmt">    # Forward KL: sum( P_T * (log P_T - log P_S) )</span>
<span class="cs-line hl-c">    fkl = (topk_probs * (torch.log(topk_probs + 1e-8) - topk_student_log_probs)).sum(dim=-1)</span>
<span class="cs-line">    </span>
<span class="cs-line cmt">    # Apply FKL only on outlier positions</span>
<span class="cs-line hl-p">    outlier_loss = (fkl * mask_outliers).mean()</span>
<span class="cs-line">    </span>
<span class="cs-line">    <span class="kw">return</span> outlier_loss</span></pre>
    </div>

    <!-- Panel Off-Policy Guidance -->
    <div class="cs-panel" id="panel-off_policy">
      <pre class="cs-pre"><span class="cs-line cmt"># Annealing sequence length and combining prefix</span>
<span class="cs-line"><span class="kw">import</span> math</span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">get_annealed_prefix_length</span>(current_step, max_steps, max_len):</span>
<span class="cs-line cmt">    # Cosine annealing schedule from max_len down to 0</span>
<span class="cs-line hl-c">    progress = current_step / max_steps</span>
<span class="cs-line hl-c">    factor = 0.5 * (1.0 + math.cos(math.pi * progress))</span>
<span class="cs-line">    </span>
<span class="cs-line hl-g">    prefix_len = int(max_len * factor)</span>
<span class="cs-line">    <span class="kw">return</span> prefix_len</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Distillation hybrid token batching</span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">generate_hybrid_trajectory</span>(teacher_ids, student_model, prefix_len):</span>
<span class="cs-line cmt">    # Slice off-policy prefix from teacher sequence</span>
<span class="cs-line">    prefix = teacher_ids[:, :prefix_len]</span>
<span class="cs-line">    </span>
<span class="cs-line cmt">    # Rollout the rest on-policy using the student model</span>
<span class="cs-line hl-p">    continuation = student_model.generate(prefix, max_length=max_len)</span>
<span class="cs-line">    <span class="kw">return</span> continuation</span></pre>
    </div>

    <!-- Panel Results -->

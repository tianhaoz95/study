<script>
// TOC + sidebar toggles
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});

const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// Code sidebar tab switching
const tabMeta = {
  intro:   { file: 'post/intro.py',        title: 'Introduction' },
  trust_region: { file: 'post/trust_region.py', title: 'Trust Region Mask' },
  outlier_fkd:  { file: 'post/outlier_fkd.py',  title: 'Outlier Top-k FKL' },
  off_policy:   { file: 'post/off_policy.py',   title: 'Off-Policy Guidance' },
  results: { file: 'post/results.py',      title: 'Results & Config' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// IntersectionObserver - sync TOC + sidebar tab on scroll
const sectionMap = {
  's-instability': 'intro',
  's-trust': 'trust_region',
  's-outliers': 'outlier_fkd',
  's-guidance': 'off_policy',
  's-results': 'results'
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.25 }).observe(s)
);

// ----------------------------------------------------
// INTERACTIVE 1: Gradient Instability Simulation
// ----------------------------------------------------
const gradCanvas = document.getElementById('grad-sim-canvas');
if (gradCanvas) {
  const ctx = gradCanvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  
  let animationId = null;
  let simStep = 0;
  let mode = 'opd'; // opd, clip, tropd
  
  // Data traces
  let points = []; // Array of {step, gradNorm, entropy}
  
  function resizeCanvas() {
    const W = gradCanvas.clientWidth;
    const H = 260;
    gradCanvas.width = W * DPR;
    gradCanvas.height = H * DPR;
    ctx.scale(DPR, DPR);
    drawChart();
  }
  
  // Seeded random
  let seed = 42;
  function random() {
    let x = Math.sin(seed++) * 10000;
    return x - Math.floor(x);
  }
  
  function initSimulation(newMode) {
    mode = newMode;
    simStep = 0;
    seed = 42;
    points = [];
    
    // Initial point
    points.push({
      step: 0,
      gradNorm: 1.0,
      entropy: 4.5
    });
    
    if (animationId) {
      cancelAnimationFrame(animationId);
      animationId = null;
    }
    
    drawChart();
  }
  
  function stepSimulation() {
    if (simStep >= 100) {
      animationId = null;
      document.getElementById('sim-run-btn').textContent = 'Restart Simulation';
      return;
    }
    
    simStep++;
    const prev = points[points.length - 1];
    let newGradNorm = prev.gradNorm;
    let newEntropy = prev.entropy;
    
    if (mode === 'opd') {
      // Exploding gradient, collapsing entropy
      if (simStep === 35) {
        // Gradient spike
        newGradNorm = 45.0 + random() * 20;
        newEntropy = Math.max(0.02, prev.entropy - 2.5);
      } else if (simStep > 35) {
        newGradNorm = prev.gradNorm * 0.95 + random() * 2;
        newEntropy = Math.max(0.01, prev.entropy * 0.7);
      } else {
        newGradNorm = 1.0 + (simStep / 35) * 2 + (random() - 0.5) * 0.5;
        newEntropy = 4.5 - (simStep / 100) * 1.5 + (random() - 0.5) * 0.15;
      }
    } else if (mode === 'clip') {
      // Stable but slightly bottlenecked learning
      if (simStep === 35) {
        // Clipped spike
        newGradNorm = 5.0 + (random() - 0.5) * 0.5;
        newEntropy = prev.entropy - 0.3;
      } else {
        newGradNorm = Math.max(0.5, 1.2 + Math.sin(simStep / 5) * 0.3 + (random() - 0.5) * 0.2);
        newEntropy = Math.max(2.0, 4.5 - (simStep / 100) * 1.8 + (random() - 0.5) * 0.1);
      }
    } else {
      // TrOPD: Stable gradient, high entropy maintained
      newGradNorm = Math.max(0.3, 0.9 + Math.cos(simStep / 10) * 0.2 + (random() - 0.5) * 0.1);
      newEntropy = Math.max(2.8, 4.5 - (simStep / 100) * 1.0 + (random() - 0.5) * 0.08);
    }
    
    points.push({
      step: simStep,
      gradNorm: newGradNorm,
      entropy: newEntropy
    });
    
    drawChart();
    animationId = requestAnimationFrame(stepSimulation);
  }
  
  function drawChart() {
    const W = gradCanvas.clientWidth;
    const H = 260;
    ctx.clearRect(0, 0, W, H);
    
    // Draw grid
    ctx.strokeStyle = 'rgba(255,255,255,0.04)';
    ctx.lineWidth = 1;
    for (let x = 50; x < W - 20; x += (W - 70) / 5) {
      ctx.beginPath(); ctx.moveTo(x, 20); ctx.lineTo(x, H - 30); ctx.stroke();
    }
    for (let y = 20; y < H - 30; y += (H - 50) / 4) {
      ctx.beginPath(); ctx.moveTo(50, y); ctx.lineTo(W - 20, y); ctx.stroke();
    }
    
    // Draw axes
    ctx.strokeStyle = 'var(--border)';
    ctx.beginPath();
    ctx.moveTo(50, 20); ctx.lineTo(50, H - 30); ctx.lineTo(W - 20, H - 30);
    ctx.stroke();
    
    // Draw axis labels
    ctx.fillStyle = 'var(--muted)';
    ctx.font = '9px var(--ff-mono)';
    ctx.textAlign = 'right';
    ctx.fillText('Norm', 40, 25);
    ctx.fillText('0', 40, H - 30);
    ctx.fillText('50', 40, 30);
    
    ctx.textAlign = 'left';
    ctx.fillText('Entropy (4.5 to 0)', W - 130, 25);
    
    ctx.textAlign = 'center';
    ctx.fillText('Step 0', 50, H - 15);
    ctx.fillText('Step 100', W - 30, H - 15);
    
    if (points.length < 2) return;
    
    const startX = 50;
    const endX = W - 20;
    const chartW = endX - startX;
    
    // Plot Gradient Norm (Purple)
    ctx.strokeStyle = '#c084fc';
    ctx.lineWidth = 1.75;
    ctx.beginPath();
    points.forEach((p, idx) => {
      const cx = startX + (p.step / 100) * chartW;
      // Cap max grad norm at 60 for plotting
      const ratio = Math.min(1.0, p.gradNorm / 60.0);
      const cy = (H - 30) - ratio * (H - 60);
      if (idx === 0) ctx.moveTo(cx, cy); else ctx.lineTo(cx, cy);
    });
    ctx.stroke();
    
    // Plot Entropy (Cyan)
    ctx.strokeStyle = '#22d3ee';
    ctx.lineWidth = 1.75;
    ctx.setLineDash([4, 3]);
    ctx.beginPath();
    points.forEach((p, idx) => {
      const cx = startX + (p.step / 100) * chartW;
      const ratio = p.entropy / 5.0; // max entropy 5.0
      const cy = (H - 30) - ratio * (H - 60);
      if (idx === 0) ctx.moveTo(cx, cy); else ctx.lineTo(cx, cy);
    });
    ctx.stroke();
    ctx.setLineDash([]);
    
    // Draw Current values
    const current = points[points.length - 1];
    ctx.fillStyle = '#c084fc';
    ctx.font = '10px var(--ff-mono)';
    ctx.textAlign = 'left';
    ctx.fillText(`Gradient Norm: ${current.gradNorm.toFixed(2)}`, 60, 50);
    
    ctx.fillStyle = '#22d3ee';
    ctx.fillText(`Policy Entropy: ${current.entropy.toFixed(2)}`, 60, 68);
  }
  
  // Interactive control binding
  document.getElementById('sim-opd-btn')?.addEventListener('click', (e) => {
    document.querySelectorAll('.chart-controls .chart-btn').forEach(btn => btn.classList.remove('active'));
    e.target.classList.add('active');
    initSimulation('opd');
  });
  
  document.getElementById('sim-clip-btn')?.addEventListener('click', (e) => {
    document.querySelectorAll('.chart-controls .chart-btn').forEach(btn => btn.classList.remove('active'));
    e.target.classList.add('active');
    initSimulation('clip');
  });
  
  document.getElementById('sim-tropd-btn')?.addEventListener('click', (e) => {
    document.querySelectorAll('.chart-controls .chart-btn').forEach(btn => btn.classList.remove('active'));
    e.target.classList.add('active');
    initSimulation('tropd');
  });
  
  document.getElementById('sim-run-btn')?.addEventListener('click', () => {
    if (animationId) {
      cancelAnimationFrame(animationId);
      animationId = null;
    }
    if (simStep >= 100) {
      initSimulation(mode);
    }
    document.getElementById('sim-run-btn').textContent = 'Pause';
    stepSimulation();
  });
  
  window.addEventListener('resize', resizeCanvas);
  // Initial draw
  resizeCanvas();
  initSimulation('opd');
}


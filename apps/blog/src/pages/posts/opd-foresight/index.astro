    ['hl-c','                score  = eval(load(W_cand), eval_data[:n_val])'],
    ['hl-c','                if score >= best_score:'],
    ['hl-c','                    best, best_score = W_cand, score'],
    ['hl-c','                else:'],
    ['hl-c','                    break  # greedy: stop at first failure'],

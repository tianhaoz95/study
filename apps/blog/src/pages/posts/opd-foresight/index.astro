    ['',    '    V_final = Vt_final[:top_k].T'],
    ['hl-p','    # principal angle cosine similarity'],
    ['hl-p','    cos = (V_t.T @ V_final).norm() / top_k'],
    ['',    '    return cos.item()'],
  ],
  effopdg: [

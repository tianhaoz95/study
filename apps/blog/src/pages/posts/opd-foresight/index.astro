    ['',    ''],
    ['hl-c','    # effective rank = exp(H(p)) where p_i = s_i^2/sum(s^2)'],
    ['hl-c','    p = (S ** 2) / (S ** 2).sum()'],
    ['hl-c','    eff_rank = torch.exp(-(p * (p + 1e-9).log()).sum())'],
    ['',    ''],
    ['hl-g','    # top-1% subspace norm ratio'],
    ['hl-g','    k = max(1, int(0.01 * len(S)))'],
    ['hl-g','    top_k_norm = torch.norm(S[:k]) / torch.norm(S)'],
    ['',    ''],
    ['',    '    return spec_frob, eff_rank, top_k_norm'],
    ['',    ''],
    ['cmt', '# Subspace alignment to final checkpoint'],
    ['',    'def subspace_cosine(dW_t, dW_final, top_k=20):'],

const PANELS = {
  problem: [
    ['cmt', '# RL vs OPD: parameter efficiency comparison'],
    ['',    '# Scale update by alpha, measure accuracy'],
    ['',    'def scale_and_eval(W_base, delta_W, alpha, eval_fn):'],
    ['',    '    W_scaled = W_base + alpha * delta_W'],
    ['',    '    return eval_fn(W_scaled)'],
    ['',    ''],
    ['cmt', '# OPD curve rises steeply; RL curve is shallower'],
    ['cmt', '# at the SAME update norm — RL delta contains'],

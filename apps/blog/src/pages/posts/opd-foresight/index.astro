// ─────────────────────────────────────────────────────────
//  Seeded PRNG (Mulberry32)
// ─────────────────────────────────────────────────────────
function seededRng(seed) {
  let s = seed >>> 0;
  return function() {
    s += 0x6D2B79F5;
    let t = s;
    t = Math.imul(t ^ t >>> 15, t | 1);
    t ^= t + Math.imul(t ^ t >>> 7, t | 61);
    return ((t ^ t >>> 14) >>> 0) / 4294967296;
  };
}

// ─────────────────────────────────────────────────────────
//  §01 — Trajectory canvas
// ─────────────────────────────────────────────────────────
(function() {
  const canvas = document.getElementById('traj-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  let W, H;

  function resize() {
    W = canvas.clientWidth; H = 280;
    canvas.width  = W * DPR; canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
  }
  resize();

  // Fixed layout (seeded)
  const rng = seededRng(42);

  // Parameter space: two basins
  // "Wrong mountain" region: center roughly (0.25W, 0.4H), radius 0.15W
  // "Correct mountain" (target): center roughly (0.72W, 0.38H)
  const wrongC  = { x: 0.24, y: 0.45 };
  const targetC = { x: 0.72, y: 0.38 };

  // RL trajectory: wanders, visits wrong region, eventually hits target
  // OPD trajectory: goes fairly directly to target
  const totalSteps = 36;
  function makeRLPath(rng) {
    const pts = [];
    // start near left
    let x = 0.08 + rng() * 0.05;
    let y = 0.5 + rng() * 0.1;
    pts.push({ x, y });
    // wander toward wrong mountain first (steps 1-14)
    for (let i = 1; i < 15; i++) {
      const t = i / 14;
      const tx = wrongC.x + (rng() - 0.5) * 0.08;
      const ty = wrongC.y + (rng() - 0.5) * 0.08;
      x = x + (tx - x) * 0.25 + (rng() - 0.5) * 0.05;
      y = y + (ty - y) * 0.25 + (rng() - 0.5) * 0.04;
      pts.push({ x, y });
    }
    // escape wrong region and slowly converge to target (steps 15-35)
    for (let i = 15; i <= totalSteps; i++) {
      const t = (i - 15) / (totalSteps - 15);
      const tx = targetC.x + (1 - t) * (rng() - 0.5) * 0.1;
      const ty = targetC.y + (1 - t) * (rng() - 0.5) * 0.08;
      x = x + (tx - x) * 0.15 + (rng() - 0.5) * 0.03;
      y = y + (ty - y) * 0.15 + (rng() - 0.5) * 0.03;
      pts.push({ x, y });
    }
    return pts;
  }

  function makeOPDPath(rng) {
    const pts = [];
    let x = 0.08 + rng() * 0.04;
    let y = 0.55 + rng() * 0.05;
    pts.push({ x, y });
    // goes fairly directly to target, with small noise
    for (let i = 1; i <= 10; i++) {
      const t = i / 10;
      x = x + (targetC.x - x) * 0.35 + (rng() - 0.5) * 0.025;
      y = y + (targetC.y - y) * 0.35 + (rng() - 0.5) * 0.02;
      pts.push({ x, y });
    }
    // converge tightly to target
    for (let i = 11; i <= totalSteps; i++) {
      x = x + (targetC.x - x) * 0.55 + (rng() - 0.5) * 0.01;
      y = y + (targetC.y - y) * 0.55 + (rng() - 0.5) * 0.01;
      pts.push({ x, y });
    }
    return pts;
  }

  const rlPath  = makeRLPath(seededRng(7));
  const opdPath = makeOPDPath(seededRng(13));

  let frame = 0;
  let animId = null;
  let playing = false;

  function drawBackground() {
    ctx.clearRect(0, 0, W, H);

    // subtle grid
    ctx.strokeStyle = 'rgba(255,255,255,0.03)';
    ctx.lineWidth = 1;
    for (let gx = 0; gx < W; gx += 50) { ctx.beginPath(); ctx.moveTo(gx, 0); ctx.lineTo(gx, H); ctx.stroke(); }
    for (let gy = 0; gy < H; gy += 50) { ctx.beginPath(); ctx.moveTo(0, gy); ctx.lineTo(W, gy); ctx.stroke(); }

    // "Wrong mountain" region
    const wx = wrongC.x * W, wy = wrongC.y * H;
    const grad1 = ctx.createRadialGradient(wx, wy, 5, wx, wy, W * 0.18);
    grad1.addColorStop(0, 'rgba(239,68,68,0.18)');
    grad1.addColorStop(1, 'rgba(239,68,68,0)');
    ctx.fillStyle = grad1;
    ctx.beginPath(); ctx.arc(wx, wy, W * 0.18, 0, Math.PI * 2); ctx.fill();
    // label
    ctx.fillStyle = 'rgba(239,68,68,0.55)';
    ctx.font = `bold ${Math.round(9 * DPR / DPR)}px monospace`;
    ctx.textAlign = 'center';
    ctx.fillText('⛰ wrong mountain', wx, wy - W * 0.04);

    // "Correct mountain" / target region
    const tx = targetC.x * W, ty = targetC.y * H;
    const grad2 = ctx.createRadialGradient(tx, ty, 5, tx, ty, W * 0.15);
    grad2.addColorStop(0, 'rgba(16,185,129,0.22)');
    grad2.addColorStop(1, 'rgba(16,185,129,0)');
    ctx.fillStyle = grad2;
    ctx.beginPath(); ctx.arc(tx, ty, W * 0.15, 0, Math.PI * 2); ctx.fill();
    // label
    ctx.fillStyle = 'rgba(16,185,129,0.75)';
    ctx.font = `bold ${Math.round(9 * DPR / DPR)}px monospace`;
    ctx.textAlign = 'center';
    ctx.fillText('✦ optimal reasoning model', tx, ty - W * 0.035);
    // target marker
    ctx.beginPath(); ctx.arc(tx, ty, 7, 0, Math.PI * 2);
    ctx.fillStyle = 'rgba(16,185,129,0.9)'; ctx.fill();
  }

  function drawPath(path, color, showSteps, labelText, stepCount) {
    const steps = Math.min(showSteps + 1, path.length);
    if (steps < 2) {
      if (steps === 1) {
        const p = path[0];
        ctx.beginPath();
        ctx.arc(p.x * W, p.y * H, 5, 0, Math.PI * 2);
        ctx.fillStyle = color; ctx.fill();
      }
      return;
    }
    // draw trail
    ctx.beginPath();
    ctx.moveTo(path[0].x * W, path[0].y * H);
    for (let i = 1; i < steps; i++) ctx.lineTo(path[i].x * W, path[i].y * H);
    ctx.strokeStyle = color;
    ctx.lineWidth = 2;
    ctx.globalAlpha = 0.75;
    ctx.stroke();
    ctx.globalAlpha = 1;

    // draw current dot
    const last = path[steps - 1];
    ctx.beginPath();
    ctx.arc(last.x * W, last.y * H, 6, 0, Math.PI * 2);
    ctx.fillStyle = color; ctx.fill();

    // label at start
    const start = path[0];
    ctx.fillStyle = color;
    ctx.font = `bold 9px monospace`;
    ctx.textAlign = 'left';
    ctx.fillText(labelText + ` (step ${Math.min(stepCount, steps - 1)})`, start.x * W + 8, start.y * H);
  }

  function draw() {
    drawBackground();
    const rlSteps  = Math.min(frame, rlPath.length - 1);
    const opdSteps = Math.min(frame, opdPath.length - 1);
    drawPath(rlPath,  'rgba(239,68,68,0.9)',   rlSteps,  'RL',  rlSteps);
    drawPath(opdPath, 'rgba(139,92,246,0.95)', opdSteps, 'OPD', opdSteps);
  }

  function animate() {
    if (frame < totalSteps) {
      frame++;
      draw();
      document.getElementById('traj-step-label').textContent = `step: ${frame}`;
      animId = requestAnimationFrame(animate);
    } else {
      playing = false;
      document.getElementById('traj-play').textContent = '▶ Play';
      document.getElementById('traj-step-label').textContent = `step: ${totalSteps} — OPD reached target at step 10, RL at step 35`;
    }
  }

  draw();

  document.getElementById('traj-play')?.addEventListener('click', () => {
    if (playing) {
      cancelAnimationFrame(animId); playing = false;
      document.getElementById('traj-play').textContent = '▶ Play';
    } else {
      if (frame >= totalSteps) frame = 0;
      playing = true;
      document.getElementById('traj-play').textContent = '⏸ Pause';
      animate();
    }
  });

  document.getElementById('traj-reset')?.addEventListener('click', () => {
    cancelAnimationFrame(animId); playing = false;
    document.getElementById('traj-play').textContent = '▶ Play';
    frame = 0;
    draw();
    document.getElementById('traj-step-label').textContent = 'step: 0';
  });

  window.addEventListener('resize', () => {
    ctx.setTransform(1, 0, 0, 1, 0, 0);
    resize();
    draw();
  });
})();

// ─────────────────────────────────────────────────────────
//  §02 — Layer update norm canvas
// ─────────────────────────────────────────────────────────
(function() {
  const canvas = document.getElementById('layer-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  let W, H;
  let mode = 'rl'; // 'rl' | 'opd' | 'both'

  function resize() {
    W = canvas.clientWidth; H = 220;
    canvas.width  = W * DPR; canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
  }
  resize();

  // 12 representative layers: 2 bottom, 8 middle, 2 top
  // Values calibrated from paper Figure 3(b) for Qwen3-8B
  const layers = [
    { label: 'L1',  rl: 0.28, opd: 0.09, critical: false },
    { label: 'L2',  rl: 0.31, opd: 0.10, critical: false },
    { label: 'L4',  rl: 0.38, opd: 0.24, critical: true  },
    { label: 'L6',  rl: 0.52, opd: 0.61, critical: true  },
    { label: 'L8',  rl: 0.55, opd: 0.82, critical: true  },
    { label: 'L10', rl: 0.58, opd: 0.88, critical: true  },
    { label: 'L12', rl: 0.54, opd: 0.85, critical: true  },
    { label: 'L14', rl: 0.50, opd: 0.77, critical: true  },
    { label: 'L20', rl: 0.45, opd: 0.55, critical: true  },
    { label: 'L24', rl: 0.44, opd: 0.42, critical: true  },
    { label: 'L30', rl: 0.42, opd: 0.15, critical: false },
    { label: 'L32', rl: 0.36, opd: 0.11, critical: false },
  ];

  const maxVal = 1.0;
  const PAD_L = 35, PAD_R = 16, PAD_T = 20, PAD_B = 28;

  function drawLayers() {
    ctx.clearRect(0, 0, W, H);
    const chartW = W - PAD_L - PAD_R;
    const chartH = H - PAD_T - PAD_B;
    const barW = chartW / layers.length;

    // background shading for critical zone
    const firstCrit = layers.findIndex(l => l.critical);
    const lastCrit  = layers.map(l => l.critical).lastIndexOf(true);
    const critX = PAD_L + firstCrit * barW;
    const critW = (lastCrit - firstCrit + 1) * barW;
    ctx.fillStyle = 'rgba(16,185,129,0.06)';
    ctx.fillRect(critX, PAD_T, critW, chartH);

    // grid lines
    ctx.strokeStyle = 'rgba(255,255,255,0.05)';
    ctx.lineWidth = 1;
    for (let v = 0.25; v <= 1.0; v += 0.25) {
      const y = PAD_T + chartH * (1 - v / maxVal);
      ctx.beginPath(); ctx.moveTo(PAD_L, y); ctx.lineTo(W - PAD_R, y); ctx.stroke();
      ctx.fillStyle = 'rgba(255,255,255,0.2)';
      ctx.font = '8px monospace';
      ctx.textAlign = 'right';
      ctx.fillText((v * 100).toFixed(0) + '%', PAD_L - 4, y + 3);
    }

    // bars
    const barGap = barW * 0.15;
    layers.forEach((l, i) => {
      const bx = PAD_L + i * barW;

      if (mode === 'rl' || mode === 'both') {
        const bh = l.rl / maxVal * chartH;
        const by = PAD_T + chartH - bh;
        const bw = mode === 'both' ? barW * 0.42 : barW - barGap * 2;
        const bxoff = mode === 'both' ? barGap * 0.5 : barGap;
        ctx.fillStyle = 'rgba(239,68,68,0.65)';
        ctx.fillRect(bx + bxoff, by, bw, bh);
      }

      if (mode === 'opd' || mode === 'both') {
        const bh = l.opd / maxVal * chartH;
        const by = PAD_T + chartH - bh;
        const bw = mode === 'both' ? barW * 0.42 : barW - barGap * 2;
        const bxoff = mode === 'both' ? barW * 0.46 : barGap;
        ctx.fillStyle = 'rgba(139,92,246,0.75)';
        ctx.fillRect(bx + bxoff, by, bw, bh);
      }

      // x-axis label
      ctx.fillStyle = 'rgba(255,255,255,0.35)';
      ctx.font = '8px monospace';
      ctx.textAlign = 'center';
      ctx.fillText(l.label, bx + barW / 2, H - 6);
    });

    // critical zone label
    ctx.fillStyle = 'rgba(16,185,129,0.6)';
    ctx.font = 'bold 8px monospace';
    ctx.textAlign = 'center';
    ctx.fillText('critical reasoning zone', critX + critW / 2, PAD_T - 6);

    // axis baseline
    ctx.strokeStyle = 'rgba(255,255,255,0.12)';
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(PAD_L, PAD_T + chartH); ctx.lineTo(W - PAD_R, PAD_T + chartH); ctx.stroke();

    // legend
    const legY = PAD_T + 10;
    if (mode === 'rl' || mode === 'both') {
      ctx.fillStyle = 'rgba(239,68,68,0.7)'; ctx.fillRect(W - PAD_R - 70, legY, 10, 10);
      ctx.fillStyle = 'rgba(255,255,255,0.45)'; ctx.font = '8px monospace'; ctx.textAlign = 'left';
      ctx.fillText('RL', W - PAD_R - 56, legY + 9);
    }
    if (mode === 'opd' || mode === 'both') {
      ctx.fillStyle = 'rgba(139,92,246,0.8)'; ctx.fillRect(W - PAD_R - 40, legY, 10, 10);
      ctx.fillStyle = 'rgba(255,255,255,0.45)'; ctx.font = '8px monospace'; ctx.textAlign = 'left';
      ctx.fillText('OPD', W - PAD_R - 26, legY + 9);
    }
  }

  drawLayers();

  document.getElementById('layer-rl-btn')?.addEventListener('click', () => {
    mode = 'rl'; drawLayers();
    document.getElementById('layer-rl-btn').classList.add('active');
    document.getElementById('layer-opd-btn').classList.remove('active');
    document.getElementById('layer-both-btn').classList.remove('active');
  });
  document.getElementById('layer-opd-btn')?.addEventListener('click', () => {
    mode = 'opd'; drawLayers();
    document.getElementById('layer-rl-btn').classList.remove('active');
    document.getElementById('layer-opd-btn').classList.add('active');
    document.getElementById('layer-both-btn').classList.remove('active');
  });
  document.getElementById('layer-both-btn')?.addEventListener('click', () => {
    mode = 'both'; drawLayers();
    document.getElementById('layer-rl-btn').classList.remove('active');
    document.getElementById('layer-opd-btn').classList.remove('active');
    document.getElementById('layer-both-btn').classList.add('active');
  });

  window.addEventListener('resize', () => { ctx.setTransform(1,0,0,1,0,0); resize(); drawLayers(); });
})();

// ─────────────────────────────────────────────────────────
//  §03 — Cosine similarity alignment chart
// ─────────────────────────────────────────────────────────
(function() {
  const canvas = document.getElementById('align-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  let W, H;

  function resize() {
    W = canvas.clientWidth; H = 240;
    canvas.width  = W * DPR; canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
  }
  resize();

  const PAD_L = 44, PAD_R = 20, PAD_T = 20, PAD_B = 32;

  // Cosine similarity curves (calibrated from paper Fig 5b)
  // X: training progress 0-100%
  // Y: cosine similarity to final direction
  // OPD: rises fast to ~0.72 at 10%, plateaus near 0.86
  // RL:  rises slowly from ~0.12 to ~0.72 by 80%
  function opdCos(t) {
    // rapid early rise then plateau
    return 0.14 + 0.73 * (1 - Math.exp(-5.5 * t));
  }
  function rlCos(t) {
    // slow monotonic rise
    return 0.10 + 0.65 * (1 - Math.exp(-1.3 * t));
  }

  const nPts = 80;
  function buildPoints(fn) {
    return Array.from({ length: nPts + 1 }, (_, i) => {
      const t = i / nPts;
      return { t, v: fn(t) };
    });
  }

  const opdPts = buildPoints(opdCos);
  const rlPts  = buildPoints(rlCos);

  function drawChart() {
    ctx.clearRect(0, 0, W, H);
    const cW = W - PAD_L - PAD_R;
    const cH = H - PAD_T - PAD_B;

    // grid
    ctx.strokeStyle = 'rgba(255,255,255,0.05)';
    ctx.lineWidth = 1;
    for (let v = 0; v <= 1.0; v += 0.25) {
      const y = PAD_T + cH * (1 - v);
      ctx.beginPath(); ctx.moveTo(PAD_L, y); ctx.lineTo(W - PAD_R, y); ctx.stroke();
      ctx.fillStyle = 'rgba(255,255,255,0.25)';
      ctx.font = '9px monospace'; ctx.textAlign = 'right';
      ctx.fillText(v.toFixed(2), PAD_L - 5, y + 3);
    }
    for (let x = 0; x <= 100; x += 20) {
      const px = PAD_L + (x / 100) * cW;
      ctx.beginPath(); ctx.moveTo(px, PAD_T); ctx.lineTo(px, PAD_T + cH); ctx.stroke();
      ctx.fillStyle = 'rgba(255,255,255,0.25)';
      ctx.font = '9px monospace'; ctx.textAlign = 'center';
      ctx.fillText(x + '%', px, PAD_T + cH + 14);
    }

    // 10% progress dashed vertical line
    const line10x = PAD_L + 0.1 * cW;
    ctx.setLineDash([3, 4]);
    ctx.strokeStyle = 'rgba(16,185,129,0.4)';
    ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.moveTo(line10x, PAD_T); ctx.lineTo(line10x, PAD_T + cH); ctx.stroke();
    ctx.setLineDash([]);

    // draw OPD line
    function drawLine(pts, color) {
      ctx.beginPath();
      pts.forEach((p, i) => {
        const px = PAD_L + p.t * cW;
        const py = PAD_T + cH * (1 - p.v);
        if (i === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
      });
      ctx.strokeStyle = color; ctx.lineWidth = 2.5;
      ctx.globalAlpha = 0.9; ctx.stroke(); ctx.globalAlpha = 1;
    }

    drawLine(rlPts,  'rgba(239,68,68,0.8)');
    drawLine(opdPts, 'rgba(139,92,246,0.95)');

    // annotation: OPD at 10%
    const opd10 = opdCos(0.1);
    const ann10x = line10x;
    const ann10y = PAD_T + cH * (1 - opd10);
    ctx.beginPath(); ctx.arc(ann10x, ann10y, 5, 0, Math.PI * 2);
    ctx.fillStyle = 'rgba(16,185,129,0.9)'; ctx.fill();
    ctx.fillStyle = 'rgba(16,185,129,0.8)';
    ctx.font = 'bold 8px monospace'; ctx.textAlign = 'left';
    ctx.fillText('OPD: 0.72 similarity at 10%', ann10x + 8, ann10y - 4);

    // labels at right end
    const opdEnd = opdCos(1.0);
    const rlEnd  = rlCos(1.0);
    ctx.fillStyle = 'rgba(139,92,246,0.9)'; ctx.font = 'bold 9px monospace'; ctx.textAlign = 'left';
    ctx.fillText('OPD', W - PAD_R + 2, PAD_T + cH * (1 - opdEnd) + 4);
    ctx.fillStyle = 'rgba(239,68,68,0.8)';
    ctx.fillText('RL',  W - PAD_R + 2, PAD_T + cH * (1 - rlEnd) + 4);

    // axis labels
    ctx.fillStyle = 'rgba(255,255,255,0.3)';
    ctx.font = '9px monospace'; ctx.textAlign = 'center';
    ctx.fillText('training progress', PAD_L + cW / 2, H - 4);
    ctx.save(); ctx.translate(10, PAD_T + cH / 2); ctx.rotate(-Math.PI / 2);
    ctx.fillText('cosine similarity to final', 0, 0); ctx.restore();

    // axes
    ctx.strokeStyle = 'rgba(255,255,255,0.12)'; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(PAD_L, PAD_T); ctx.lineTo(PAD_L, PAD_T + cH); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(PAD_L, PAD_T + cH); ctx.lineTo(W - PAD_R, PAD_T + cH); ctx.stroke();
  }

  drawChart();
  window.addEventListener('resize', () => { ctx.setTransform(1,0,0,1,0,0); resize(); drawChart(); });
})();

// ─────────────────────────────────────────────────────────
//  §04 — Step navigator
// ─────────────────────────────────────────────────────────
(function() {
  let step = 0;
  const boxes   = document.querySelectorAll('#effopdg-steps .step-box');
  const prevBtn = document.getElementById('step-prev');
  const nextBtn = document.getElementById('step-next');
  const progEl  = document.getElementById('step-prog');

  function updateSteps() {
    boxes.forEach((b, i) => {
      b.classList.remove('active', 'done');
      if (i === step)      b.classList.add('active');
      else if (i < step)   b.classList.add('done');
    });
    if (prevBtn) prevBtn.disabled = step === 0;
    if (nextBtn) nextBtn.disabled = step === boxes.length - 1;
    if (progEl)  progEl.textContent = `Step ${step + 1} of ${boxes.length}`;
    boxes.forEach((b, i) => {
      const n = b.querySelector('.step-num');
      if (n) n.textContent = i < step ? '✓' : String(i + 1);
    });
  }

  prevBtn?.addEventListener('click', () => { if (step > 0) { step--; updateSteps(); } });
  nextBtn?.addEventListener('click', () => { if (step < boxes.length - 1) { step++; updateSteps(); } });
  updateSteps();
})();

// ─────────────────────────────────────────────────────────
//  §05 — Convergence chart
// ─────────────────────────────────────────────────────────
(function() {
  const canvas = document.getElementById('conv-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  let W, H;

  function resize() {
    W = canvas.clientWidth; H = 250;
    canvas.width  = W * DPR; canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
  }
  resize();

  const PAD_L = 42, PAD_R = 20, PAD_T = 24, PAD_B = 32;
  const MAX_STEPS = 42;
  const MAX_ACC   = 100;

  // Convergence curves (schematic, based on Fig 6 description)
  // EffOPD: rapid rise, converges by step 10 at ~82%
  // Vanilla OPD: steady rise, converges by step 35 at ~81%
  // RL: slower, reaches ~73% by step 42
  function effAcc(t) {
    if (t === 0) return 20;
    return 20 + 62 * (1 - Math.exp(-0.55 * t));
  }
  function opdAcc(t) {
    if (t === 0) return 18;
    return 18 + 63 * (1 - Math.exp(-0.12 * t));
  }
  function rlAcc(t) {
    if (t === 0) return 16;
    return 16 + 57 * (1 - Math.exp(-0.07 * t));
  }

  const N = MAX_STEPS + 1;
  const effPts = Array.from({ length: N }, (_, i) => ({ s: i, v: effAcc(i) }));
  const opdPts = Array.from({ length: N }, (_, i) => ({ s: i, v: opdAcc(i) }));
  const rlPts  = Array.from({ length: N }, (_, i) => ({ s: i, v: rlAcc(i) }));

  function drawConv() {
    ctx.clearRect(0, 0, W, H);
    const cW = W - PAD_L - PAD_R;
    const cH = H - PAD_T - PAD_B;

    // grid
    ctx.strokeStyle = 'rgba(255,255,255,0.05)';
    ctx.lineWidth = 1;
    for (let v = 20; v <= 100; v += 20) {
      const y = PAD_T + cH * (1 - v / MAX_ACC);
      ctx.beginPath(); ctx.moveTo(PAD_L, y); ctx.lineTo(W - PAD_R, y); ctx.stroke();
      ctx.fillStyle = 'rgba(255,255,255,0.25)'; ctx.font = '9px monospace'; ctx.textAlign = 'right';
      ctx.fillText(v, PAD_L - 5, y + 3);
    }
    for (let s = 0; s <= MAX_STEPS; s += 10) {
      const x = PAD_L + (s / MAX_STEPS) * cW;
      ctx.beginPath(); ctx.moveTo(x, PAD_T); ctx.lineTo(x, PAD_T + cH); ctx.stroke();
      ctx.fillStyle = 'rgba(255,255,255,0.25)'; ctx.font = '9px monospace'; ctx.textAlign = 'center';
      ctx.fillText(s, x, PAD_T + cH + 14);
    }

    // draw 3× speedup bracket
    const stepEff = 10, stepOpd = 35;
    const bracketY = PAD_T + cH * 0.18;
    const bx1 = PAD_L + (stepEff / MAX_STEPS) * cW;
    const bx2 = PAD_L + (stepOpd / MAX_STEPS) * cW;
    ctx.strokeStyle = 'rgba(245,158,11,0.55)'; ctx.lineWidth = 1.5;
    ctx.setLineDash([3, 3]);
    ctx.beginPath(); ctx.moveTo(bx1, bracketY); ctx.lineTo(bx2, bracketY); ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle = 'rgba(245,158,11,0.8)'; ctx.font = 'bold 9px monospace'; ctx.textAlign = 'center';
    ctx.fillText('← 3× speedup →', (bx1 + bx2) / 2, bracketY - 5);

    // draw lines
    function drawLine(pts, color, dash) {
      if (dash) ctx.setLineDash(dash);
      ctx.beginPath();
      pts.forEach((p, i) => {
        const px = PAD_L + (p.s / MAX_STEPS) * cW;
        const py = PAD_T + cH * (1 - p.v / MAX_ACC);
        if (i === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
      });
      ctx.strokeStyle = color; ctx.lineWidth = 2.5;
      ctx.globalAlpha = 0.9; ctx.stroke(); ctx.globalAlpha = 1;
      ctx.setLineDash([]);
    }

    drawLine(rlPts,  'rgba(100,110,125,0.7)', [5, 4]);
    drawLine(opdPts, 'rgba(6,182,212,0.85)');
    drawLine(effPts, 'rgba(139,92,246,0.95)');

    // line labels
    const labelPts = [
      { pts: effPts, col: 'rgba(139,92,246,0.95)', lbl: 'EffOPD' },
      { pts: opdPts, col: 'rgba(6,182,212,0.85)',  lbl: 'Vanilla OPD' },
      { pts: rlPts,  col: 'rgba(100,110,125,0.7)', lbl: 'RL baseline' },
    ];
    labelPts.forEach(({ pts, col, lbl }) => {
      const last = pts[pts.length - 1];
      const px = PAD_L + (last.s / MAX_STEPS) * cW;
      const py = PAD_T + cH * (1 - last.v / MAX_ACC);
      ctx.fillStyle = col; ctx.font = 'bold 8px monospace'; ctx.textAlign = 'left';
      ctx.fillText(lbl, Math.min(px + 3, W - 80), py + 4);
    });

    // axes
    ctx.strokeStyle = 'rgba(255,255,255,0.12)'; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(PAD_L, PAD_T); ctx.lineTo(PAD_L, PAD_T + cH); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(PAD_L, PAD_T + cH); ctx.lineTo(W - PAD_R, PAD_T + cH); ctx.stroke();

    ctx.fillStyle = 'rgba(255,255,255,0.3)'; ctx.font = '9px monospace'; ctx.textAlign = 'center';
    ctx.fillText('training steps', PAD_L + cW / 2, H - 4);
    ctx.save(); ctx.translate(10, PAD_T + cH / 2); ctx.rotate(-Math.PI / 2);
    ctx.fillText('accuracy (%)', 0, 0); ctx.restore();
  }

  drawConv();
  window.addEventListener('resize', () => { ctx.setTransform(1,0,0,1,0,0); resize(); drawConv(); });
})();
</script>
</BaseLayout>

    ['cmt', '# Same norm budget, very different reasoning gain'],
  ],
  redundancy: [
    ['cmt', '# Sliding-window layer intervention'],
    ['cmt', '# Injects per-block update, measures reasoning Δ'],
    ['',    ''],
    ['',    'def layer_intervention(W_base, delta_W, block, eval_fn):'],
    ['',    '    W_test = W_base.clone()'],
    ['hl-c','    # inject only the update for this block'],
    ['hl-c','    for layer_idx in block:'],
    ['hl-c','        W_test[layer_idx] += delta_W[layer_idx]'],
    ['',    '    return eval_fn(W_test)  # reasoning accuracy'],
    ['',    ''],
    ['cmt', '# Key finding: middle-layer MLPs are critical'],
    ['cmt', '# Embedding layer: negligible impact on accuracy'],
    ['cmt', '# OPD suppresses embedding/peripheral updates early'],
    ['',    ''],
    ['hl-g','# Top-1% subspace norm ratios (8B model):'],
    ['hl-g','# OPD: 94.7%  ← concentrated in few directions'],
    ['hl-g','# RL:  88.5%  ← more dispersed, redundant energy'],
    ['',    ''],
    ['cmt', '# Decompose update into embedding / MLP / attn'],
    ['',    'dW_embed = delta_W["embed_tokens"]'],
    ['',    'dW_mlp   = {k: v for k, v in delta_W.items()'],
    ['',    '            if "mlp" in k}'],
    ['',    'dW_attn  = {k: v for k, v in delta_W.items()'],
    ['',    '            if "attn" in k}'],
  ],
  locksin: [
    ['cmt', '# SVD-based spectral analysis of update matrix'],
    ['',    ''],
    ['',    'def spectral_metrics(delta_W_flat):'],
    ['',    '    U, S, Vt = torch.linalg.svd(delta_W_flat,'],
    ['',    '                                 full_matrices=False)'],
    ['hl-p','    spec_norm  = S[0].item()'],

    ['',    '                  max_steps=40, n_val=50):'],
    ['',    '    W_prev = model.state_dict()   # W_0'],
    ['',    '    t, n = 0, 0'],
    ['',    '    next_ckpt = 1   # 2^n schedule'],
    ['',    ''],
    ['',    '    while t < max_steps:'],
    ['',    '        model = opd_step(model, teacher, train_data)'],
    ['',    '        t += 1'],

<span class="cs-line cmt"># MFU — nanoGPT implementation (Karpathy)</span>
<span class="cs-line cmt"># github.com/karpathy/nanoGPT/blob/master/model.py</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">estimate_mfu</span>(<span class="kw">self</span>, fwdbwd_per_iter, dt):</span>
<span class="cs-line">    <span class="str">"""Estimate model flops utilization (MFU).</span></span>

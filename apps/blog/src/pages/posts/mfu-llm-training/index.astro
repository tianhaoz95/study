<span class="cs-line">    <span class="str">Reference: PaLM paper Appendix B.</span></span>
<span class="cs-line">    <span class="str">"""</span></span>
<span class="cs-line">    N = <span class="kw">self</span>.<span class="fn">get_num_params</span>()</span>
<span class="cs-line">    cfg = <span class="kw">self</span>.config</span>
<span class="cs-line">    L  = cfg.n_layer</span>
<span class="cs-line">    H  = cfg.n_head</span>
<span class="cs-line">    Q  = cfg.n_embd <span class="op">//</span> cfg.n_head</span>
<span class="cs-line">    T  = cfg.block_size</span>
<span class="cs-line"> </span>
<span class="cs-line hl-c">    <span class="cmt"># FLOPs per token: 6N (fwd+bwd, params)</span></span>
<span class="cs-line hl-c">    <span class="cmt">#   + 12*L*H*Q*T (attention scores)</span></span>
<span class="cs-line hl-c">    flops_per_token = <span class="num">6</span><span class="op">*</span>N <span class="op">+</span> <span class="num">12</span><span class="op">*</span>L<span class="op">*</span>H<span class="op">*</span>Q<span class="op">*</span>T</span>
<span class="cs-line">    flops_per_fwdbwd = flops_per_token <span class="op">*</span> T</span>
<span class="cs-line">    flops_per_iter = flops_per_fwdbwd <span class="op">*</span> fwdbwd_per_iter</span>
<span class="cs-line"> </span>
<span class="cs-line hl-g">    <span class="cmt"># Achieved vs. peak</span></span>
<span class="cs-line hl-g">    flops_achieved = flops_per_iter <span class="op">*</span> (<span class="num">1.0</span><span class="op">/</span>dt)</span>
<span class="cs-line hl-g">    flops_promised = <span class="num">312e12</span>  <span class="cmt"># A100 bfloat16 peak</span></span>
<span class="cs-line hl-g">    mfu = flops_achieved <span class="op">/</span> flops_promised</span>
<span class="cs-line">    <span class="kw">return</span> mfu</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># GPU peak FLOPs (BF16, no sparsity)</span>
<span class="cs-line">GPU_PEAKS = &#123;</span>
<span class="cs-line">    <span class="str">'V100'</span>: <span class="num">125e12</span>,  <span class="cmt"># FP16</span></span>
<span class="cs-line">    <span class="str">'A100'</span>: <span class="num">312e12</span>,  <span class="cmt"># BF16 SXM</span></span>
<span class="cs-line">    <span class="str">'H100'</span>: <span class="num">989e12</span>,  <span class="cmt"># BF16 SXM</span></span>
<span class="cs-line">&#125;</span>
      </pre>
    </div>

    <!-- flops panel -->
    <div class="cs-panel" id="panel-flops">
      <pre class="cs-pre">
<span class="cs-line cmt"># Transformer FLOPs breakdown</span>
<span class="cs-line cmt"># For a decoder-only transformer, one token, fwd+bwd</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">flops_per_token</span>(N, L, d, T):</span>
<span class="cs-line hl-p">    <span class="str">"""</span></span>
<span class="cs-line hl-p">    <span class="str">N = total params, L = layers,</span></span>
<span class="cs-line hl-p">    <span class="str">d = d_model,   T = seq length</span></span>
<span class="cs-line hl-p">    <span class="str">"""</span></span>
<span class="cs-line cmt">    # Param-proportional (6N total)</span></span>
<span class="cs-line">    param_flops = <span class="num">6</span> <span class="op">*</span> N</span>
<span class="cs-line cmt">    #   breakdown of the 6N:</span></span>
<span class="cs-line cmt">    #   forward:  2N  (1 FMA per param per token)</span></span>
<span class="cs-line cmt">    #   backward: 4N  (~2x forward for dW + dx)</span></span>
<span class="cs-line"> </span>
<span class="cs-line hl-c">    <span class="cmt"># Attention score FLOPs (sequence-dependent)</span></span>
<span class="cs-line hl-c">    attn_flops = <span class="num">12</span> <span class="op">*</span> L <span class="op">*</span> d <span class="op">*</span> T</span>
<span class="cs-line hl-c">    <span class="cmt"># = 2T*d per layer (QK^T) ×2 (+ V×attn)</span></span>
<span class="cs-line hl-c">    <span class="cmt">#   ×3 (fwd + bwd ≈ 2×fwd) × L layers</span></span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="kw">return</span> param_flops <span class="op">+</span> attn_flops</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Example: LLaMA-7B, T=2048</span>
<span class="cs-line">C = <span class="fn">flops_per_token</span>(</span>
<span class="cs-line">    N=<span class="num">7e9</span>, L=<span class="num">32</span>, d=<span class="num">4096</span>, T=<span class="num">2048</span></span>
<span class="cs-line">)</span>
<span class="cs-line cmt"># = 42.0e9 + 3.2e9 = 45.2 GFLOPs/token</span>
<span class="cs-line cmt"># attn term = 7.1% of total</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># At T=8192: attn = 22% of total</span>
<span class="cs-line cmt"># At T=32768: attn = 55% of total (!)  </span>
<span class="cs-line"> </span>
<span class="cs-line hl-g"><span class="cmt"># Param split within N (approx)</span></span>
<span class="cs-line hl-g"><span class="cmt"># Attn QKV+out proj: ~4*d^2*L = N/3</span></span>
<span class="cs-line hl-g"><span class="cmt"># FFN (up + down):   ~8*d^2*L = 2N/3</span></span>
      </pre>
    </div>

    <!-- formula panel -->
    <div class="cs-panel" id="panel-formula">
      <pre class="cs-pre">
<span class="cs-line cmt"># Computing MFU from a training log</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">compute_mfu</span>(</span>
<span class="cs-line hl-p">    tokens_per_sec_total,  <span class="cmt"># across all GPUs</span></span>
<span class="cs-line hl-p">    N, L, d, T,           <span class="cmt"># model config</span></span>
<span class="cs-line hl-p">    num_gpus,</span>
<span class="cs-line hl-p">    gpu_peak_tflops,</span>
<span class="cs-line hl-p">):</span>
<span class="cs-line">    <span class="cmt"># 1. FLOPs per token</span></span>
<span class="cs-line">    C = <span class="num">6</span><span class="op">*</span>N <span class="op">+</span> <span class="num">12</span><span class="op">*</span>L<span class="op">*</span>d<span class="op">*</span>T</span>
<span class="cs-line"> </span>
<span class="cs-line hl-c">    <span class="cmt"># 2. Achieved FLOPs across cluster</span></span>
<span class="cs-line hl-c">    achieved = tokens_per_sec_total <span class="op">*</span> C</span>
<span class="cs-line"> </span>
<span class="cs-line hl-g">    <span class="cmt"># 3. Peak FLOPs across cluster</span></span>
<span class="cs-line hl-g">    peak = num_gpus <span class="op">*</span> gpu_peak_tflops <span class="op">*</span> <span class="num">1e12</span></span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="kw">return</span> achieved <span class="op">/</span> peak</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># ── Worked example ──────────────────────</span>
<span class="cs-line cmt"># 7B model, 256×A100s, 40,000 tok/s total</span>
<span class="cs-line">mfu = <span class="fn">compute_mfu</span>(</span>
<span class="cs-line">    tokens_per_sec_total=<span class="num">40_000</span>,</span>
<span class="cs-line">    N=<span class="num">7e9</span>, L=<span class="num">32</span>, d=<span class="num">4096</span>, T=<span class="num">2048</span>,</span>
<span class="cs-line">    num_gpus=<span class="num">256</span>,</span>
<span class="cs-line">    gpu_peak_tflops=<span class="num">312</span>,</span>
<span class="cs-line">)</span>
<span class="cs-line cmt"># tokens_per_gpu = 40_000/256 = 156</span>
<span class="cs-line cmt"># C = 6*7e9 + 12*32*4096*2048 = 45.2e9</span>
<span class="cs-line cmt"># achieved/gpu = 156 * 45.2e9 = 7.05 TFLOPS</span>
<span class="cs-line cmt"># MFU = 7.05 / 312 = 2.3%  ← too low!</span>
<span class="cs-line cmt"># Need ~1024 tok/s per GPU for 15% MFU</span>
      </pre>
    </div>

    <!-- killers panel -->
    <div class="cs-panel" id="panel-killers">
      <pre class="cs-pre">
<span class="cs-line cmt"># What reduces MFU in practice</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="cmt"># 1. Memory bandwidth bound</span></span>
<span class="cs-line hl-p"><span class="cmt"># A100: 312 TFLOPS / 2 TB/s = 156 FLOPs/byte</span></span>
<span class="cs-line hl-p"><span class="cmt"># 7B in BF16: 14 GB weights</span></span>
<span class="cs-line hl-p"><span class="cmt"># Min batch to be compute-bound:</span></span>
<span class="cs-line hl-p"><span class="cmt">#   156 FLOPs/byte × 2 bytes × 14e9 params</span></span>
<span class="cs-line hl-p"><span class="cmt">#   ≈ 4368 tokens needed in flight</span></span>
<span class="cs-line"> </span>
<span class="cs-line hl-c"><span class="cmt"># 2. Communication (AllReduce, TP sends)</span></span>
<span class="cs-line hl-c"><span class="cmt"># DP: AllReduce 14 GB grads after backward</span></span>
<span class="cs-line hl-c"><span class="cmt"># TP: send (B × d) acts every layer</span></span>
<span class="cs-line hl-c"><span class="cmt"># Overlap: use async_op=True + bucket_cap</span></span>
<span class="cs-line"> </span>
<span class="cs-line hl-g"><span class="cmt"># 3. Pipeline bubbles</span></span>
<span class="cs-line hl-g"><span class="cmt"># bubble_frac = (p-1) / (m + p - 1)</span></span>
<span class="cs-line hl-g"><span class="cmt"># p=8 stages, m=32 microbatches:</span></span>
<span class="cs-line hl-g"><span class="cmt"># = 7/39 = 17.9% wasted compute</span></span>
<span class="cs-line"> </span>
<span class="cs-line hl-a"><span class="cmt"># 4. Kernel fusion (FlashAttention)</span></span>
<span class="cs-line hl-a"><span class="cmt"># Unfused: 5-7 HBM round-trips per layer</span></span>
<span class="cs-line hl-a"><span class="cmt"># FlashAttn-2: 1 HBM trip, stays in SRAM</span></span>
<span class="cs-line hl-a"><span class="cmt"># Result: 2-4× attention kernel speedup</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># 5. Framework overhead</span>
<span class="cs-line cmt"># torch.compile() eliminates per-op dispatch</span>
<span class="cs-line cmt"># CUDA graphs remove per-step CPU overhead</span>
<span class="cs-line cmt"># Typical gain: +2-5% MFU</span>
      </pre>
    </div>

    <!-- hfu panel -->
    <div class="cs-panel" id="panel-hfu">
      <pre class="cs-pre">
<span class="cs-line cmt"># MFU vs HFU with gradient checkpointing</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">hfu_factor</span>(checkpointing=<span class="str">'none'</span>):</span>
<span class="cs-line">    <span class="str">"""</span></span>
<span class="cs-line">    <span class="str">Returns ratio HFU/MFU.</span></span>
<span class="cs-line">    <span class="str">No checkpointing: HFU == MFU (factor=1)</span></span>
<span class="cs-line">    <span class="str">Full checkpointing: forward done 2×</span></span>
<span class="cs-line">    <span class="str">  actual FLOPs = 2N+2N+4N = 8N (not 6N)</span></span>
<span class="cs-line">    <span class="str">  factor = 8/6 ≈ 1.33</span></span>
<span class="cs-line">    <span class="str">Selective (attn only):</span></span>
<span class="cs-line">    <span class="str">  factor ≈ 1.05–1.15</span></span>
<span class="cs-line">    <span class="str">"""</span></span>
<span class="cs-line">    <span class="kw">if</span> checkpointing == <span class="str">'none'</span>:</span>
<span class="cs-line">        <span class="kw">return</span> <span class="num">1.0</span></span>
<span class="cs-line hl-c">    <span class="kw">elif</span> checkpointing == <span class="str">'full'</span>:</span>
<span class="cs-line hl-c">        <span class="kw">return</span> <span class="num">8</span> <span class="op">/</span> <span class="num">6</span>  <span class="cmt"># ≈ 1.33</span></span>
<span class="cs-line">    <span class="kw">elif</span> checkpointing == <span class="str">'selective'</span>:</span>
<span class="cs-line">        <span class="kw">return</span> <span class="num">1.10</span>  <span class="cmt"># approx</span></span>
<span class="cs-line"> </span>
<span class="cs-line hl-g"><span class="cmt"># HFU = MFU × factor</span></span>
<span class="cs-line hl-g"><span class="cmt"># e.g. MFU=40%, full checkpointing:</span></span>
<span class="cs-line hl-g"><span class="cmt">#   HFU = 40% × 1.33 = 53.2%</span></span>
<span class="cs-line hl-g"><span class="cmt"># Same hardware utilization, different</span></span>
<span class="cs-line hl-g"><span class="cmt"># model-efficiency interpretation</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Memory saved by full checkpointing:</span>
<span class="cs-line cmt"># Activations: O(L × T × d) → O(L)</span>
<span class="cs-line cmt"># Trade: 33% extra compute for 10-20×</span>
<span class="cs-line cmt"># activation memory reduction</span>
      </pre>
    </div>

    <!-- benchmarks panel -->
    <div class="cs-panel" id="panel-benchmarks">
      <pre class="cs-pre">
<span class="cs-line cmt"># Published MFU values (A100 BF16, ~312 TFLOPS)</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p">SYSTEMS = [</span>
<span class="cs-line hl-p">  (<span class="str">"GPT-3 175B"</span>,    <span class="str">"2020"</span>,  <span class="num">0.213</span>),</span>
<span class="cs-line hl-p">  (<span class="str">"Typical run"</span>,   <span class="str">"2022"</span>,  <span class="num">0.350</span>),</span>
<span class="cs-line hl-p">  (<span class="str">"PaLM 540B"</span>,     <span class="str">"2022"</span>,  <span class="num">0.462</span>),</span>
<span class="cs-line hl-p">  (<span class="str">"Megatron 1T"</span>,   <span class="str">"2021"</span>,  <span class="num">0.520</span>),</span>
<span class="cs-line hl-p">  (<span class="str">"nanoGPT"</span>,       <span class="str">"2023"</span>,  <span class="num">0.574</span>),</span>
<span class="cs-line hl-p">  (<span class="str">"FlashAttn-2"</span>,   <span class="str">"2023"</span>,  <span class="num">0.720</span>),</span>
<span class="cs-line hl-p">]</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Key techniques that raise MFU:</span>
<span class="cs-line"> </span>
<span class="cs-line hl-c"><span class="cmt"># 1. FlashAttention-2          +10-20%</span></span>
<span class="cs-line hl-c"><span class="cmt"># 2. Large batch (compute-bnd) +5-15%</span></span>
<span class="cs-line hl-c"><span class="cmt"># 3. BF16 throughout           +5-10%</span></span>
<span class="cs-line hl-c"><span class="cmt"># 4. Fused kernels (RMSNorm)   +2-5%</span></span>
<span class="cs-line hl-c"><span class="cmt"># 5. Async AllReduce            +2-5%</span></span>
<span class="cs-line hl-c"><span class="cmt"># 6. torch.compile / CUDA grph +2-5%</span></span>
<span class="cs-line"> </span>
<span class="cs-line hl-g"><span class="cmt"># Hardware peak FLOPs (BF16, no sparsity)</span></span>
<span class="cs-line hl-g"><span class="cmt"># V100:  125 TFLOPS (FP16)</span></span>
<span class="cs-line hl-g"><span class="cmt"># A100:  312 TFLOPS (BF16 SXM)</span></span>
<span class="cs-line hl-g"><span class="cmt"># H100:  989 TFLOPS (BF16 SXM)</span></span>
<span class="cs-line hl-g"><span class="cmt"># H100 ≈ 3.2× A100 in peak FLOPs</span></span>
<span class="cs-line hl-g"><span class="cmt"># But same MFU standards apply!</span></span>
      </pre>
    </div>

  </div><!-- /cs-body -->
</aside>

</div><!-- /post-grid -->

<script>
/* ══════════════════════════════════════════════════════════════════
   TOC + SIDEBAR TOGGLES
══════════════════════════════════════════════════════════════════ */
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});

const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

/* ══════════════════════════════════════════════════════════════════
   CODE SIDEBAR TAB SWITCHING
══════════════════════════════════════════════════════════════════ */
const tabMeta = {
  intro:      { file: 'mfu/train.py',     title: 'What Is MFU?' },
  flops:      { file: 'mfu/flops.py',     title: 'FLOPs in a Transformer' },
  formula:    { file: 'mfu/calculate.py', title: 'The MFU Formula' },
  killers:    { file: 'mfu/killers.py',   title: 'What Kills MFU?' },
  hfu:        { file: 'mfu/hfu.py',       title: 'MFU vs HFU' },
  benchmarks: { file: 'mfu/benchmarks.py','title': 'In the Wild' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

/* ══════════════════════════════════════════════════════════════════
   INTERSECTION OBSERVER — TOC + SIDEBAR SYNC
══════════════════════════════════════════════════════════════════ */
const sectionMap = {
  's-intro':      'intro',
  's-flops':      'flops',
  's-formula':    'formula',
  's-killers':    'killers',
  's-hfu':        'hfu',
  's-benchmarks': 'benchmarks',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

/* ══════════════════════════════════════════════════════════════════
   §01 — GAUGE CANVAS
══════════════════════════════════════════════════════════════════ */
(function() {
  const canvas = document.getElementById('gauge-canvas');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  function resize() {
    const W = canvas.clientWidth, H = 130;
    canvas.width  = W * DPR;
    canvas.height = H * DPR;
    draw(W, H);
  }

  const SYSTEMS = [
    { label: 'GPT-3 original',  mfu: 0.213, color: '#ef4444' },
    { label: 'Typical run',     mfu: 0.350, color: '#f59e0b' },
    { label: 'PaLM 540B',       mfu: 0.462, color: '#8b5cf6' },
    { label: 'Megatron-LM',     mfu: 0.520, color: '#8b5cf6' },
    { label: 'nanoGPT',         mfu: 0.574, color: '#8b5cf6' },
    { label: 'FlashAttn-2',     mfu: 0.720, color: '#06b6d4' },
  ];

  let activeIdx = 3; // Megatron-LM

  function draw(W, H) {
    const ctx = canvas.getContext('2d');
    ctx.clearRect(0, 0, W * DPR, H * DPR);
    ctx.save();
    ctx.scale(DPR, DPR);

    const PAD_L = 40, PAD_R = 20, PAD_T = 30, BAR_H = 28;
    const barW = W - PAD_L - PAD_R;
    const barY = PAD_T;

    // Gradient bar
    const grad = ctx.createLinearGradient(PAD_L, 0, PAD_L + barW, 0);
    grad.addColorStop(0,    '#ef4444');
    grad.addColorStop(0.25, '#f59e0b');
    grad.addColorStop(0.5,  '#8b5cf6');
    grad.addColorStop(0.75, '#06b6d4');
    grad.addColorStop(1,    '#10b981');
    ctx.fillStyle = grad;
    ctx.beginPath();
    ctx.roundRect(PAD_L, barY, barW, BAR_H, 6);
    ctx.fill();

    // Zone labels below bar
    ctx.font = `${10 * (1/DPR + DPR/2)}px monospace`;
    ctx.fillStyle = 'rgba(255,255,255,0.3)';
    ctx.textAlign = 'center';
    const zones = [
      { x: 0.10, t: '< 20%\nbad' },
      { x: 0.28, t: '20–35%\nfair' },
      { x: 0.47, t: '35–55%\ngood' },
      { x: 0.64, t: '55–75%\nexcellent' },
    ];
    ctx.font = '9px monospace';
    zones.forEach(z => {
      const lx = PAD_L + barW * z.x;
      const lines = z.t.split('\n');
      lines.forEach((line, i) => {
        ctx.fillText(line, lx, barY + BAR_H + 12 + i * 11);
      });
    });

    // Tick marks at 0, 25, 50, 75, 100
    [0, 0.25, 0.5, 0.75, 1.0].forEach(pct => {
      const tx = PAD_L + barW * pct;
      ctx.strokeStyle = 'rgba(255,255,255,0.25)';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(tx, barY + BAR_H);
      ctx.lineTo(tx, barY + BAR_H + 4);
      ctx.stroke();
      ctx.fillStyle = 'rgba(255,255,255,0.35)';
      ctx.font = '9px monospace';
      ctx.textAlign = 'center';
      ctx.fillText(Math.round(pct * 100) + '%', tx, barY + BAR_H + 14);
    });

    // Active marker
    const sys = SYSTEMS[activeIdx];
    const mx = PAD_L + barW * sys.mfu;
    ctx.strokeStyle = '#ffffff';
    ctx.lineWidth = 2.5;
    ctx.beginPath();
    ctx.moveTo(mx, barY - 4);
    ctx.lineTo(mx, barY + BAR_H + 4);
    ctx.stroke();
    // Triangle pointer
    ctx.fillStyle = '#ffffff';
    ctx.beginPath();
    ctx.moveTo(mx - 6, barY - 12);
    ctx.lineTo(mx + 6, barY - 12);
    ctx.lineTo(mx, barY - 4);
    ctx.closePath();
    ctx.fill();
    // Label above
    ctx.fillStyle = '#ffffff';
    ctx.font = 'bold 11px monospace';
    ctx.textAlign = 'center';
    const labelText = sys.label + ' — ' + Math.round(sys.mfu * 100) + '%';
    const textX = Math.max(PAD_L + 50, Math.min(PAD_L + barW - 50, mx));
    ctx.fillText(labelText, textX, barY - 16);

    ctx.restore();
  }

  // Initial render
  requestAnimationFrame(resize);
  window.addEventListener('resize', resize);

  // Buttons
  document.querySelectorAll('#gauge-btns .canvas-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      activeIdx = parseInt(btn.dataset.idx);
      document.querySelectorAll('#gauge-btns .canvas-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      draw(canvas.clientWidth, 130);
    });
  });
})();

/* ══════════════════════════════════════════════════════════════════
   §02 — FLOPS BREAKDOWN CANVAS
══════════════════════════════════════════════════════════════════ */
(function() {
  const canvas = document.getElementById('flops-canvas');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;

  // Model configs: [N, L, d]
  const MODELS = {
    '7B':   [7e9,   32, 4096],
    '70B':  [70e9,  80, 8192],
    '175B': [175e9, 96, 12288],
  };

  let curModel = '7B', curT = 2048;

  function computeBreakdown(model, T) {
    const [N, L, d] = MODELS[model];
    const ffn    = 4 * N;                   // 4N of 6N = FFN (fwd+bwd)
    const attnP  = 2 * N;                   // 2N of 6N = attention projections (fwd+bwd)
    const attnS  = 12 * L * d * T;          // sequence-dependent
    return { ffn, attnP, attnS, total: ffn + attnP + attnS };
  }

  function fmtG(v) {
    if (v >= 1e12) return (v/1e12).toFixed(1) + 'T';
    if (v >= 1e9)  return (v/1e9).toFixed(1) + 'G';
    return (v/1e6).toFixed(0) + 'M';
  }

  function draw(W, H) {
    const ctx = canvas.getContext('2d');
    ctx.clearRect(0, 0, W * DPR, H * DPR);
    ctx.save();
    ctx.scale(DPR, DPR);

    const bd = computeBreakdown(curModel, curT);
    const PAD = 20, BAR_H = 38, LABEL_W = 150;
    const barW = W - PAD - LABEL_W - PAD;

    const bars = [
      { label: 'FFN\n(up + down proj)',           val: bd.ffn,   pct: bd.ffn/bd.total,   color: 'rgba(139,92,246,0.8)' },
      { label: 'Attention proj\n(QKV + output)',  val: bd.attnP, pct: bd.attnP/bd.total, color: 'rgba(6,182,212,0.8)' },
      { label: 'Attention scores\n(QKᵀ + V×A)',  val: bd.attnS, pct: bd.attnS/bd.total, color: 'rgba(245,158,11,0.8)' },
    ];

    ctx.font = '10px monospace';

    bars.forEach((bar, i) => {
      const y = PAD + i * (BAR_H + 18);

      // Label
      ctx.fillStyle = 'rgba(255,255,255,0.55)';
      ctx.textAlign = 'right';
      const lines = bar.label.split('\n');
      lines.forEach((line, li) => {
        ctx.fillText(line, LABEL_W - 8, y + 14 + li * 13);
      });

      // Track
      ctx.fillStyle = 'rgba(255,255,255,0.07)';
      ctx.beginPath();
      ctx.roundRect(LABEL_W, y + 4, barW, BAR_H - 8, 4);
      ctx.fill();

      // Fill
      const fw = Math.max(4, barW * bar.pct);
      ctx.fillStyle = bar.color;
      ctx.beginPath();
      ctx.roundRect(LABEL_W, y + 4, fw, BAR_H - 8, 4);
      ctx.fill();

      // Value label
      ctx.fillStyle = 'rgba(255,255,255,0.85)';
      ctx.textAlign = 'left';
      ctx.font = 'bold 10px monospace';
      ctx.fillText(
        fmtG(bar.val) + '  (' + (bar.pct * 100).toFixed(1) + '%)',
        LABEL_W + fw + 6,
        y + BAR_H / 2 + 4
      );
      ctx.font = '10px monospace';
    });

    // Total
    const totY = PAD + bars.length * (BAR_H + 18) + 10;
    ctx.fillStyle = 'rgba(255,255,255,0.35)';
    ctx.textAlign = 'right';
    ctx.fillText('Total FLOPs/token', LABEL_W - 8, totY + 8);
    ctx.fillStyle = 'rgba(255,255,255,0.85)';
    ctx.font = 'bold 11px monospace';
    ctx.textAlign = 'left';
    ctx.fillText(fmtG(bd.total) + '  FLOPs', LABEL_W + 6, totY + 8);

    ctx.restore();
  }

  function resize() {
    const W = canvas.clientWidth, H = 220;
    canvas.width  = W * DPR;
    canvas.height = H * DPR;
    draw(W, H);
  }
  requestAnimationFrame(resize);
  window.addEventListener('resize', resize);

  document.querySelectorAll('#flops-btns .canvas-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      curModel = btn.dataset.model;
      curT     = parseInt(btn.dataset.seqlen);
      document.querySelectorAll('#flops-btns .canvas-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      draw(canvas.clientWidth, 220);
    });
  });
})();

/* ══════════════════════════════════════════════════════════════════
   §03 — MFU CALCULATOR
══════════════════════════════════════════════════════════════════ */
(function() {
  const gpuSel    = document.getElementById('calc-gpu');
  const modelSel  = document.getElementById('calc-model');
  const seqSel    = document.getElementById('calc-seqlen');
  const tpsSlider = document.getElementById('calc-tps');
  const tpsVal    = document.getElementById('calc-tps-val');
  const flopsTok  = document.getElementById('calc-flops-tok');
  const reqTf     = document.getElementById('calc-required-tf');
  const peakTf    = document.getElementById('calc-peak-tf');
  const meterFill = document.getElementById('calc-meter-fill');
  const meterLbl  = document.getElementById('calc-meter-label');

  function fmtN(v) {
    if (v >= 1e15) return (v/1e15).toFixed(2) + ' PFLOPs';
    if (v >= 1e12) return (v/1e12).toFixed(2) + ' TFLOPs';
    if (v >= 1e9)  return (v/1e9).toFixed(1) + ' GFLOPs';
    return v.toFixed(0) + ' FLOPs';
  }

  function update() {
    const gpuPeak = parseFloat(gpuSel.value);          // TFLOPS
    const [Ns, Ls, ds] = modelSel.value.split(',');
    const N = parseFloat(Ns), L = parseInt(Ls), d = parseInt(ds);
    const T   = parseInt(seqSel.value);
    const tps = parseInt(tpsSlider.value);

    tpsVal.textContent = tps.toLocaleString() + ' tok/s';

    const C  = 6 * N + 12 * L * d * T;    // FLOPs per token
    const req = tps * C;                    // FLOPs/sec
    const mfu = req / (gpuPeak * 1e12);

    flopsTok.textContent = fmtN(C) + '/token';
    reqTf.textContent    = (req / 1e12).toFixed(1) + ' TFLOPS';
    peakTf.textContent   = gpuPeak.toFixed(0) + ' TFLOPS';

    const pct = Math.min(mfu * 100, 100);
    meterFill.style.width = pct + '%';

    // Color: red < 20%, amber < 35%, purple < 55%, cyan < 75%, green >= 75%
    let bg, label;
    if (mfu < 0.20)      { bg = 'rgba(239,68,68,0.7)';   label = 'MFU = ' + (mfu*100).toFixed(1) + '% — poor'; }
    else if (mfu < 0.35) { bg = 'rgba(245,158,11,0.7)';  label = 'MFU = ' + (mfu*100).toFixed(1) + '% — fair'; }
    else if (mfu < 0.55) { bg = 'rgba(139,92,246,0.75)'; label = 'MFU = ' + (mfu*100).toFixed(1) + '% — good'; }
    else if (mfu < 0.75) { bg = 'rgba(6,182,212,0.75)';  label = 'MFU = ' + (mfu*100).toFixed(1) + '% — excellent'; }
    else                 { bg = 'rgba(16,185,129,0.75)';  label = 'MFU = ' + (mfu*100).toFixed(1) + '% — exceptional'; }

    meterFill.style.background = bg;
    meterLbl.textContent = label;
  }

  [gpuSel, modelSel, seqSel].forEach(el => el?.addEventListener('change', update));
  tpsSlider?.addEventListener('input', update);
  update();
})();

/* ══════════════════════════════════════════════════════════════════
   §04 — STEP NAVIGATOR (bottlenecks)
══════════════════════════════════════════════════════════════════ */
(function() {
  let step = 0;
  const boxes   = document.querySelectorAll('#killer-steps .step-box');
  const prevBtn = document.getElementById('killer-prev');
  const nextBtn = document.getElementById('killer-next');
  const progEl  = document.getElementById('killer-prog');

  function updateSteps() {
    boxes.forEach((b, i) => {
      b.classList.remove('active', 'done');
      if (i === step)     b.classList.add('active');
      else if (i < step)  b.classList.add('done');
    });
    if (prevBtn) prevBtn.disabled = step === 0;
    if (nextBtn) nextBtn.disabled = step === boxes.length - 1;
    if (progEl)  progEl.textContent = 'Step ' + (step + 1) + ' of ' + boxes.length;
    boxes.forEach((b, i) => {
      const n = b.querySelector('.step-num');
      if (n) n.textContent = i < step ? '✓' : String(i + 1);
    });
  }
  prevBtn?.addEventListener('click', () => { if (step > 0) { step--; updateSteps(); } });
  nextBtn?.addEventListener('click', () => { if (step < boxes.length - 1) { step++; updateSteps(); } });
  updateSteps();
})();

/* ══════════════════════════════════════════════════════════════════
   §06 — ANIMATED BAR CHART
══════════════════════════════════════════════════════════════════ */
(function() {
  const barsSection = document.getElementById('s-benchmarks');
  if (!barsSection) return;
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          b.style.width = b.dataset.w + '%';
        });
      }
    });
  }, { threshold: 0.25 }).observe(barsSection);
})();
</script>


      <div class="cs-section-title" id="cs-section-title">The τ Bottleneck</div>
    </div>
    <button class="cs-toggle" id="cs-toggle" title="Hide code">›</button>
    <span class="cs-collapsed-label">code</span>
  </div>
  <div class="cs-tabs" id="cs-tabs">
    <button class="cs-tab active" data-panel="bottleneck">τ</button>
    <button class="cs-tab" data-panel="domain">domain</button>
    <button class="cs-tab" data-panel="alignment">align</button>
    <button class="cs-tab" data-panel="anchor">anchor</button>

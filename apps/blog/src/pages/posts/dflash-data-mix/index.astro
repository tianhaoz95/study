  </div>
  <div class="cs-body">
    <!-- panel: bottleneck -->
    <div class="cs-panel active" id="panel-bottleneck">
      <pre class="cs-pre">
<span class="cs-line cmt"># DFlash speedup — why τ is the key lever</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Acceptance length τ: avg tokens accepted</span>
<span class="cs-line cmt"># per draft round (block_size=16)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Qwen3-8B, SGLang, greedy (temp=0)</span>
<span class="cs-line hl-p">TAU_BY_DOMAIN = {</span>
<span class="cs-line hl-p">    "Math500":    8.01,  # 4.8× speedup</span>
<span class="cs-line hl-p">    "HumanEval":  6.63,  # 4.0× speedup</span>
<span class="cs-line hl-p">    "MBPP":       7.23,  # 3.5× speedup</span>
<span class="cs-line hl-p">    "Alpaca":     6.42,  # 3.5× speedup</span>
<span class="cs-line hl-p">}</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Without target features (architecture ablation)</span>
<span class="cs-line">TAU_NO_FEATURES = {</span>
<span class="cs-line">    "GSM8K":   3.38,  # 2.83× speedup</span>
<span class="cs-line">    "Math500": 4.61,  # 3.73× speedup</span>
<span class="cs-line">}</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Speedup formula (single-GPU, temp=0)</span>
<span class="cs-line hl-c">def speedup(tau, t_draft_ratio=0.12):</span>
<span class="cs-line hl-c">    # t_draft_ratio: drafter/verifier time</span>
<span class="cs-line hl-c">    return (tau + 1) / (1 + t_draft_ratio)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># → speedup(8.01) ≈ 8.0x raw,</span>
<span class="cs-line cmt">#   ≈ 5.1x end-to-end (memory/batching)</span>
      </pre>
    </div>
    <!-- panel: domain -->
    <div class="cs-panel" id="panel-domain">
      <pre class="cs-pre">
<span class="cs-line cmt"># DFlash training data composition</span>
<span class="cs-line cmt"># ~800K samples total</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Source 1: Nemotron Post-Training Dataset V2</span>
<span class="cs-line cmt">#   nvidia/Nemotron-Post-Training-Dataset-v2</span>
<span class="cs-line cmt">#   Domains: STEM, math, code, chat</span>
<span class="cs-line cmt">#   (English subset ~625K)</span>
<span class="cs-line hl-p">nemotron_v2 = load_dataset(</span>
<span class="cs-line hl-p">    "nvidia/Nemotron-Post-Training-Dataset-v2"</span>
<span class="cs-line hl-p">)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Source 2: CodeAlpaca</span>
<span class="cs-line cmt">#   sahil280114/codealpaca</span>
<span class="cs-line cmt">#   Pure code instructions, ~20K</span>
<span class="cs-line hl-c">codealpaca = load_dataset("codealpaca")</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Domain τ gap (without balanced training)</span>
<span class="cs-line cmt"># EAGLE-3 on LLaMA-3.1-8B, Math500</span>
<span class="cs-line">tau_chat_only   = 2.82  # ShareGPT only</span>
<span class="cs-line hl-g">tau_balanced    = 3.48  # +math+code data</span>
<span class="cs-line hl-g">improvement     = "+23% τ"</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># DFlash domain-specific τ (full recipe)</span>
<span class="cs-line">tau_math  = 8.01  # ← highest predictability</span>
<span class="cs-line">tau_code  = 6.63  # code structure helps</span>
<span class="cs-line">tau_chat  = 6.42  # most diverse patterns</span>
      </pre>
    </div>
    <!-- panel: alignment -->
    <div class="cs-panel" id="panel-alignment">
      <pre class="cs-pre">
<span class="cs-line cmt"># Target alignment: regenerate responses</span>
<span class="cs-line cmt"># from the frozen target model</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># ✗ Wrong approach: use dataset responses</span>
<span class="cs-line">for prompt, response in dataset:</span>
<span class="cs-line">    # response comes from a human, GPT-4,</span>
<span class="cs-line">    # or another model — NOT your target</span>
<span class="cs-line">    train(drafter, prompt, response)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># ✓ DFlash approach: target-generated</span>
<span class="cs-line hl-p">target.eval()  # frozen, no grad</span>
<span class="cs-line hl-p">for prompt, _ in dataset:</span>
<span class="cs-line hl-p">    with torch.no_grad():</span>
<span class="cs-line hl-p">        response = target.generate(</span>
<span class="cs-line hl-p">            prompt,</span>
<span class="cs-line hl-p">            temperature=0,   # greedy</span>
<span class="cs-line hl-p">            do_sample=False</span>
<span class="cs-line hl-p">        )</span>
<span class="cs-line hl-p">    train(drafter, prompt, response)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># SpecForge finding (EAGLE-3):</span>
<span class="cs-line cmt"># temp=0.8 → +5.3% avg throughput</span>
<span class="cs-line cmt"># vs. dataset-provided responses</span>
<span class="cs-line hl-g">throughput_gain = "+5.3%"</span>
<span class="cs-line hl-g">math500_tau_gain = "+0.66 τ (+23%)"</span>
      </pre>
    </div>
    <!-- panel: anchor -->
    <div class="cs-panel" id="panel-anchor">
      <pre class="cs-pre">
<span class="cs-line cmt"># Anchor sampling strategies</span>
<span class="cs-line cmt"># Block size = 16, 512 anchors per seq</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># ✗ Standard: fixed non-overlapping blocks</span>
<span class="cs-line">def standard_anchors(seq_len, block_size=16):</span>
<span class="cs-line">    return list(range(0, seq_len, block_size))</span>
<span class="cs-line">    # Same positions every epoch</span>
<span class="cs-line">    # Limited context feature diversity</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># ✓ DFlash: random anchor positions</span>
<span class="cs-line hl-p">def random_anchors(seq_len, n=512):</span>
<span class="cs-line hl-p">    return random.sample(range(seq_len), n)</span>
<span class="cs-line hl-p">    # Different positions every epoch</span>
<span class="cs-line hl-p">    # Full variety of context features</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Measured τ improvement (100K samples)</span>
<span class="cs-line">method = ["Standard", "Random"]</span>
<span class="cs-line">math500_tau = [4.94, 5.64]    # +14%</span>
<span class="cs-line hl-g">humaneval_tau = [3.86, 4.61]  # +19%</span>
<span class="cs-line hl-g">mt_bench_spd  = [2.13, 2.38]  # +12%</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Each anchor position produces a distinct</span>
<span class="cs-line cmt"># training example — effectively multiplies</span>
<span class="cs-line cmt"># the dataset at zero extra data cost</span>
      </pre>
    </div>
    <!-- panel: scale -->
    <div class="cs-panel" id="panel-scale">
      <pre class="cs-pre">
<span class="cs-line cmt"># Data scaling — architecture matters</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># EAGLE: feature-regression bottleneck</span>
<span class="cs-line">eagle_loss = (</span>
<span class="cs-line">    CE_loss(predicted_tokens, true_tokens)</span>
<span class="cs-line">    + MSE_loss(draft_hidden, target_hidden)</span>
<span class="cs-line">)</span>
<span class="cs-line cmt"># MSE term limits expressiveness:</span>
<span class="cs-line cmt"># drafter must match features, not tokens</span>
<span class="cs-line cmt"># → data scaling hits a wall (~100K)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># EAGLE-3: removed feature-MSE</span>
<span class="cs-line hl-c">eagle3_loss = CE_loss(tokens, true_tokens)</span>
<span class="cs-line hl-c"># ↑ linear data scaling law observed</span>
<span class="cs-line hl-c"># 8× data → ~1.4× better τ</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># DFlash: diffusion cross-entropy only</span>
<span class="cs-line hl-p">dflash_loss = weighted_CE(</span>
<span class="cs-line hl-p">    predicted_block, true_block,</span>
<span class="cs-line hl-p">    weights=exp_decay(gamma=7)</span>
<span class="cs-line hl-p">)</span>
<span class="cs-line hl-p"># No feature regression → no bottleneck</span>
<span class="cs-line hl-p"># 100K → τ≈5.6 | 800K → τ≈8.0</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Diminishing returns still apply:</span>
<span class="cs-line cmt"># 0→100K: large gain; 100K→800K: smaller</span>
      </pre>
    </div>
    <!-- panel: recipe -->
    <div class="cs-panel" id="panel-recipe">
      <pre class="cs-pre">
<span class="cs-line cmt"># DFlash drafter training recipe</span>
<span class="cs-line cmt"># Full configuration (production scale)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># 1. Dataset</span>
<span class="cs-line hl-p">dataset = mix([</span>
<span class="cs-line hl-p">    nemotron_v2(english_only=True),  # ~625K</span>
<span class="cs-line hl-p">    codealpaca(),                     # ~20K</span>
<span class="cs-line hl-p">], total=800_000)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># 2. Target alignment</span>
<span class="cs-line hl-c">dataset = regenerate_from_target(</span>
<span class="cs-line hl-c">    dataset, target_model, temperature=0</span>
<span class="cs-line hl-c">)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># 3. Training loop</span>
<span class="cs-line">optimizer = AdamW(lr=6e-4, clip=1.0)</span>
<span class="cs-line">schedule  = cosine_warmup(ratio=0.04)</span>
<span class="cs-line">max_seq_len = 3072  # 4096 for Coder</span>
<span class="cs-line"></span>
<span class="cs-line hl-g">for epoch in range(6):</span>
<span class="cs-line hl-g">    for seq in dataset:</span>
<span class="cs-line hl-g">        # 4. Random anchor sampling</span>
<span class="cs-line hl-g">        anchors = random.sample(</span>
<span class="cs-line hl-g">            range(len(seq)), 512</span>
<span class="cs-line hl-g">        )</span>
<span class="cs-line hl-g">        blocks = make_blocks(seq, anchors)</span>
<span class="cs-line hl-g">        # 5. Loss with position decay</span>
<span class="cs-line hl-g">        loss = weighted_CE(</span>
<span class="cs-line hl-g">            blocks, gamma=7</span>
<span class="cs-line hl-g">        )</span>
<span class="cs-line hl-g">        loss.backward()</span>
      </pre>
    </div>
  </div>
</aside>

</div><!-- /post-grid -->

<script>
// ── Sidebar & TOC toggles ──────────────────────────────
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});
const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ── Code sidebar tab switching ─────────────────────────
const tabMeta = {
  bottleneck: { file: 'dflash/tau_math.py',    title: 'The τ Bottleneck' },
  domain:     { file: 'dflash/data_domain.py', title: 'Domain Coverage' },
  alignment:  { file: 'dflash/alignment.py',   title: 'Target Alignment' },
  anchor:     { file: 'dflash/anchor.py',       title: 'Anchor Sampling' },
  scale:      { file: 'dflash/scaling.py',      title: 'Data Scale' },
  recipe:     { file: 'dflash/training.py',     title: 'Training Recipe' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ── TOC IntersectionObserver ───────────────────────────
const sectionMap = {
  's-bottleneck': 'bottleneck',
  's-domain':     'domain',
  's-alignment':  'alignment',
  's-anchor':     'anchor',
  's-scale':      'scale',
  's-recipe':     'recipe',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ── §01: Domain τ bar chart ────────────────────────────
const dtCanvas = document.getElementById('domain-tau-canvas');
if (dtCanvas) {
  const ctx = dtCanvas.getContext('2d');
  const W = dtCanvas.clientWidth, H = 220, DPR = window.devicePixelRatio || 1;
  dtCanvas.width = W * DPR; dtCanvas.height = H * DPR; ctx.scale(DPR, DPR);

  const domains = [
    { label: 'Math500', tau: 8.01, color: '#8b5cf6' },
    { label: 'MBPP', tau: 7.23, color: '#8b5cf6' },
    { label: 'HumanEval', tau: 6.63, color: '#06b6d4' },
    { label: 'Alpaca', tau: 6.42, color: '#06b6d4' },
  ];
  const maxTau = 10;
  const padL = 90, padR = 20, padT = 24, padB = 30;
  const chartW = W - padL - padR;
  const barH = 32, gap = 10;

  function drawDomainChart(highlighted) {
    ctx.clearRect(0, 0, W, H);
    // Grid
    ctx.strokeStyle = 'rgba(255,255,255,0.04)';
    ctx.lineWidth = 1;
    for (let t = 0; t <= maxTau; t += 2) {
      const x = padL + (t / maxTau) * chartW;
      ctx.beginPath(); ctx.moveTo(x, padT); ctx.lineTo(x, padT + domains.length * (barH + gap)); ctx.stroke();
      ctx.fillStyle = '#6b7280'; ctx.font = `${10 * DPR / DPR}px monospace`; ctx.textAlign = 'center';
      ctx.fillText(t, x, padT + domains.length * (barH + gap) + 16);
    }
    ctx.fillStyle = '#6b7280'; ctx.font = '10px monospace'; ctx.textAlign = 'center';
    ctx.fillText('acceptance length τ', padL + chartW / 2, H - 4);

    domains.forEach((d, i) => {
      const y = padT + i * (barH + gap);
      const bw = (d.tau / maxTau) * chartW;
      const alpha = (highlighted === null || highlighted === i) ? 1 : 0.3;

      // Bar background
      ctx.fillStyle = 'rgba(255,255,255,0.03)';
      ctx.fillRect(padL, y, chartW, barH);

      // Bar fill
      ctx.globalAlpha = alpha;
      const grad = ctx.createLinearGradient(padL, 0, padL + bw, 0);
      grad.addColorStop(0, d.color + 'cc');
      grad.addColorStop(1, d.color);
      ctx.fillStyle = grad;
      ctx.fillRect(padL, y, bw, barH);
      ctx.globalAlpha = 1;

      // Label
      ctx.fillStyle = alpha < 0.5 ? '#4b5563' : '#9ca3af';
      ctx.font = '11px monospace'; ctx.textAlign = 'right';
      ctx.fillText(d.label, padL - 6, y + barH / 2 + 4);

      // Value
      ctx.fillStyle = alpha < 0.5 ? '#374151' : '#e5e7eb';
      ctx.font = 'bold 11px monospace'; ctx.textAlign = 'left';
      ctx.fillText('τ = ' + d.tau.toFixed(2), padL + bw + 6, y + barH / 2 + 4);
    });
  }

  let highlighted = null;
  drawDomainChart(null);

  dtCanvas.addEventListener('mousemove', e => {
    const rect = dtCanvas.getBoundingClientRect();
    const my = (e.clientY - rect.top);
    const padT_ = padT, barH_ = barH, gap_ = gap;
    let found = null;
    domains.forEach((d, i) => {
      const y = padT_ + i * (barH_ + gap_);
      if (my >= y && my <= y + barH_) found = i;
    });
    if (found !== highlighted) { highlighted = found; drawDomainChart(highlighted); }
  });
  dtCanvas.addEventListener('mouseleave', () => { highlighted = null; drawDomainChart(null); });
}

// ── §02: Domain mix simulator ──────────────────────────
const mixCanvas = document.getElementById('mix-canvas');
if (mixCanvas) {
  const mCtx = mixCanvas.getContext('2d');
  const MW = mixCanvas.clientWidth, MH = 170, DPR = window.devicePixelRatio || 1;
  mixCanvas.width = MW * DPR; mixCanvas.height = MH * DPR; mCtx.scale(DPR, DPR);

  // τ model: weighted average of domain-specific τ
  // DFlash baseline τ by domain: math=8.01, code=6.93 avg, chat=6.42
  const TAU = { math: 8.01, code: 6.93, chat: 6.42 };

  function getMix() {
    let m = parseFloat(document.getElementById('sl-math').value);
    let c = parseFloat(document.getElementById('sl-code').value);
    let h = parseFloat(document.getElementById('sl-chat').value);
    const total = m + c + h;
    const warn = document.getElementById('mix-warning');
    if (total > 100) { warn.style.display = 'block'; m=m/total*100; c=c/total*100; h=h/total*100; }
    else { warn.style.display = 'none'; }
    return { math: m / 100, code: c / 100, chat: h / 100 };
  }

  function drawMix() {
    const mix = getMix();
    mCtx.clearRect(0, 0, MW, MH);

    // Projected τ values for each benchmark
    const benchmarks = [
      { name: 'Math500', base: 8.01, sensitivity: { math: 1.0, code: 0.2, chat: -0.3 } },
      { name: 'HumanEval', base: 6.63, sensitivity: { math: -0.1, code: 1.0, chat: 0.1 } },
      { name: 'Alpaca', base: 6.42, sensitivity: { math: -0.2, code: 0.1, chat: 1.0 } },
    ];

    // Simple model: τ = base + delta from domain shift
    // If math proportion is higher than 0.4 (DFlash default), math τ improves
    const mathDelta = (mix.math - 0.4);
    const codeDelta = (mix.code - 0.4);
    const chatDelta = (mix.chat - 0.2);

    const projected = benchmarks.map(b => {
      let tau = b.base
        + b.sensitivity.math * mathDelta * 2.0
        + b.sensitivity.code * codeDelta * 2.0
        + b.sensitivity.chat * chatDelta * 1.5;
      return { name: b.name, base: b.base, projected: Math.max(2, Math.min(10, tau)) };
    });

    const padL = 90, padR = 30, padT = 18, padB = 28;
    const chartW = MW - padL - padR;
    const barH = 28, gap = 8;
    const maxTau = 10;

    projected.forEach((p, i) => {
      const y = padT + i * (barH + gap);
      const baseW = (p.base / maxTau) * chartW;
      const projW = (p.projected / maxTau) * chartW;

      // Base bar (dim)
      mCtx.fillStyle = 'rgba(107,114,128,0.25)';
      mCtx.fillRect(padL, y, baseW, barH);

      // Projected bar
      const color = p.projected > p.base ? '#10b981' : p.projected < p.base ? '#ef4444' : '#8b5cf6';
      const grad = mCtx.createLinearGradient(padL, 0, padL + projW, 0);
      grad.addColorStop(0, color + '88');
      grad.addColorStop(1, color);
      mCtx.fillStyle = grad;
      mCtx.fillRect(padL, y, projW, barH);

      // Labels
      mCtx.fillStyle = '#9ca3af'; mCtx.font = '11px monospace'; mCtx.textAlign = 'right';
      mCtx.fillText(p.name, padL - 5, y + barH / 2 + 4);

      const diff = p.projected - p.base;
      const sign = diff > 0.01 ? '+' : diff < -0.01 ? '' : '±';
      mCtx.fillStyle = '#e5e7eb'; mCtx.font = 'bold 10px monospace'; mCtx.textAlign = 'left';
      mCtx.fillText(`τ ${p.projected.toFixed(2)} (${sign}${diff.toFixed(2)})`, padL + Math.max(baseW, projW) + 6, y + barH / 2 + 4);
    });

    // X axis labels
    mCtx.fillStyle = '#6b7280'; mCtx.font = '9px monospace'; mCtx.textAlign = 'center';
    for (let t = 0; t <= maxTau; t += 2) {
      const x = padL + (t / maxTau) * chartW;
      mCtx.fillText(t, x, MH - 6);
    }
  }

  ['sl-math', 'sl-code', 'sl-chat'].forEach(id => {
    const el = document.getElementById(id);
    if (!el) return;
    const domain = id.replace('sl-', '');
    const lbl = document.getElementById('lbl-' + domain);
    el.addEventListener('input', () => {
      lbl.textContent = el.value + '%';
      drawMix();
    });
  });
  drawMix();
}

// ── §02: Animated bars ────────────────────────────────
const domainBarsSection = document.getElementById('s-domain');
if (domainBarsSection) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('#domain-bars .bar-fill[data-w]').forEach(b => {
          b.style.width = b.dataset.w + '%';
        });
      }
    });
  }, { threshold: 0.2 }).observe(domainBarsSection);
}

// ── §03: Alignment canvas ─────────────────────────────
const alignCanvas = document.getElementById('align-canvas');
if (alignCanvas) {
  const aCtx = alignCanvas.getContext('2d');
  const AW = alignCanvas.clientWidth, AH = 220, DPR = window.devicePixelRatio || 1;
  alignCanvas.width = AW * DPR; alignCanvas.height = AH * DPR; aCtx.scale(DPR, DPR);

  let alignMode = 'mismatch'; // or 'match'

  // Seeded PRNG
  function seededRand(n) { return ((1664525*n+1013904223)&0x7fffffff)/0x7fffffff; }

  // Tokens in a sentence
  const tokens = ['The', 'integral', 'of', 'x²', 'equals', 'x³/3', '+', 'C', '.'];
  const N = tokens.length;

  function drawAlignment() {
    aCtx.clearRect(0, 0, AW, AH);

    const midY = AH * 0.42;
    const tokenW = AW / (N + 1);

    // Draw tokens
    tokens.forEach((tok, i) => {
      const x = tokenW * (i + 1);

      // Token box
      const isMath = ['x²', 'x³/3', '+', 'C', '.'].includes(tok);
      const isAccepted = alignMode === 'match' || seededRand(i * 3) > 0.35;

      aCtx.fillStyle = isAccepted
        ? (isMath ? 'rgba(139,92,246,0.25)' : 'rgba(16,185,129,0.18)')
        : 'rgba(239,68,68,0.2)';
      aCtx.strokeStyle = isAccepted
        ? (isMath ? '#8b5cf6' : '#10b981')
        : '#ef4444';
      aCtx.lineWidth = 1;
      const tw = Math.min(52, tokenW - 8);
      const th = 26;
      const tx = x - tw/2, ty = midY - th/2;
      aCtx.beginPath();
      aCtx.roundRect(tx, ty, tw, th, 4);
      aCtx.fill(); aCtx.stroke();

      // Token text
      aCtx.fillStyle = isAccepted ? '#e5e7eb' : '#9ca3af';
      aCtx.font = `bold 10px monospace`; aCtx.textAlign = 'center';
      aCtx.fillText(tok.length > 5 ? tok.slice(0,4)+'…' : tok, x, midY + 4);

      // Accept/reject label below
      if (!isAccepted) {
        aCtx.fillStyle = '#ef4444'; aCtx.font = '9px monospace';
        aCtx.fillText('✗', x, midY + 26);
      } else {
        aCtx.fillStyle = '#10b981'; aCtx.font = '9px monospace';
        aCtx.fillText('✓', x, midY + 26);
      }
    });

    // Source label
    const sourceLabel = alignMode === 'mismatch'
      ? 'Training: dataset responses (different author/model)'
      : 'Training: target model responses (temp=0, frozen)';
    const sourceColor = alignMode === 'mismatch' ? '#f59e0b' : '#10b981';

    aCtx.fillStyle = sourceColor;
    aCtx.font = 'bold 11px monospace'; aCtx.textAlign = 'center';
    aCtx.fillText(sourceLabel, AW/2, AH * 0.12);

    // Tau display
    const tauValue = alignMode === 'mismatch' ? 2.82 : 3.48;
    const tauColor = alignMode === 'mismatch' ? '#ef4444' : '#10b981';
    aCtx.fillStyle = '#6b7280'; aCtx.font = '11px monospace'; aCtx.textAlign = 'center';
    aCtx.fillText('Math500 acceptance length:', AW/2, AH * 0.78);
    aCtx.fillStyle = tauColor; aCtx.font = 'bold 22px monospace';
    aCtx.fillText('τ = ' + tauValue, AW/2, AH * 0.92);
  }

  drawAlignment();

  document.getElementById('align-btn-mismatch')?.addEventListener('click', () => {
    alignMode = 'mismatch';
    document.getElementById('align-btn-mismatch').classList.add('active');
    document.getElementById('align-btn-match').classList.remove('active');
    document.getElementById('align-caption').innerHTML =
      '<strong>Dataset responses:</strong> The drafter learns word patterns from the dataset\'s authors. These may differ systematically from the target model\'s preferred phrasing, token ordering, and vocabulary choices. Every mismatched token is a rejection at verification time.';
    drawAlignment();
  });

  document.getElementById('align-btn-match')?.addEventListener('click', () => {
    alignMode = 'match';
    document.getElementById('align-btn-match').classList.add('active');
    document.getElementById('align-btn-mismatch').classList.remove('active');
    document.getElementById('align-caption').innerHTML =
      '<strong>Target model responses:</strong> The frozen target model generates all training labels at temperature 0. The drafter learns to predict <em>exactly this model\'s</em> token choices — the same distribution it will see at verification time. Result: +23% acceptance length on Math500.';
    drawAlignment();
  });
}

// ── §04: Anchor sampling canvas ───────────────────────
const anchorCanvas = document.getElementById('anchor-canvas');
if (anchorCanvas) {
  const anCtx = anchorCanvas.getContext('2d');
  const ANW = anchorCanvas.clientWidth, ANH = 200, DPR = window.devicePixelRatio || 1;
  anchorCanvas.width = ANW * DPR; anchorCanvas.height = ANH * DPR; anCtx.scale(DPR, DPR);

  let anchorMode = 'standard';
  let animFrame = null;
  let animT = 0;

  const SEQ_LEN = 48; // tokens to display
  const TOK_W = (ANW - 40) / SEQ_LEN;
  const BLOCK_SIZE = 16;
  const ROW_Y = ANH * 0.35;
  const ROW2_Y = ANH * 0.7;

  function seededRand2(n) { return ((1664525*n+1013904223)&0x7fffffff)/0x7fffffff; }

  // Epoch 1 standard anchors: positions 0,16,32
  // Epoch 2 standard anchors: same 0,16,32
  // Random epoch 1: e.g. 3,11,19,28,37,43
  function getAnchors(mode, epoch) {
    if (mode === 'standard') {
      return [0, 16, 32];
    } else {
      // Different random anchors each epoch
      const positions = [];
      const used = new Set();
      for (let i = 0; i < 6; i++) {
        let p = Math.floor(seededRand2(i * 7 + epoch * 31) * (SEQ_LEN - BLOCK_SIZE));
        while (used.has(p)) p = (p + 1) % (SEQ_LEN - BLOCK_SIZE);
        used.add(p); positions.push(p);
      }
      return positions.sort((a,b) => a-b);
    }
  }

  let epoch1 = 0; // 0 or 1 for two epochs side by side

  function drawAnchors() {
    anCtx.clearRect(0, 0, ANW, ANH);

    const colors = ['#8b5cf6', '#06b6d4', '#10b981', '#f59e0b', '#ef4444', '#a78bfa'];

    // Labels
    anCtx.fillStyle = '#9ca3af'; anCtx.font = 'bold 10px monospace'; anCtx.textAlign = 'left';
    anCtx.fillText('Epoch 1', 20, ROW_Y - 28);
    anCtx.fillText('Epoch 2', 20, ROW2_Y - 28);

    const anchors1 = getAnchors(anchorMode, 0);
    const anchors2 = getAnchors(anchorMode, 1);

    [anchors1, anchors2].forEach((anchors, row) => {
      const y = row === 0 ? ROW_Y : ROW2_Y;

      // Draw all tokens
      for (let t = 0; t < SEQ_LEN; t++) {
        const x = 20 + t * TOK_W;
        anCtx.fillStyle = 'rgba(255,255,255,0.03)';
        anCtx.fillRect(x, y - 10, TOK_W - 1, 20);
      }

      // Draw anchor blocks
      anchors.forEach((a, ai) => {
        const blockEnd = Math.min(a + BLOCK_SIZE, SEQ_LEN);
        const blockLen = blockEnd - a;
        const x = 20 + a * TOK_W;
        const bw = blockLen * TOK_W - 1;
        const col = colors[ai % colors.length];

        anCtx.fillStyle = col + '30';
        anCtx.fillRect(x, y - 10, bw, 20);
        anCtx.strokeStyle = col;
        anCtx.lineWidth = 1.5;
        anCtx.strokeRect(x, y - 10, bw, 20);

        // Anchor marker
        anCtx.fillStyle = col;
        anCtx.beginPath(); anCtx.arc(x + 4, y + 2, 3, 0, Math.PI * 2); anCtx.fill();
      });

      // Coverage indicator
      const covered = new Set();
      anchors.forEach(a => { for (let t = a; t < Math.min(a + BLOCK_SIZE, SEQ_LEN); t++) covered.add(t); });
      const pct = Math.round(covered.size / SEQ_LEN * 100);

      anCtx.fillStyle = '#6b7280'; anCtx.font = '10px monospace'; anCtx.textAlign = 'right';
      anCtx.fillText(`${pct}% covered`, ANW - 8, y + 3);
    });

    // Mode label
    const modeName = anchorMode === 'standard' ? 'Standard: same positions each epoch' : 'Random: different positions each epoch';
    const modeColor = anchorMode === 'standard' ? '#f59e0b' : '#10b981';
    anCtx.fillStyle = modeColor; anCtx.font = 'bold 11px monospace'; anCtx.textAlign = 'center';
    anCtx.fillText(modeName, ANW/2, ANH - 6);
  }

  drawAnchors();

  document.getElementById('anc-btn-standard')?.addEventListener('click', () => {
    anchorMode = 'standard';
    document.getElementById('anc-btn-standard').classList.add('active');
    document.getElementById('anc-btn-random').classList.remove('active');
    document.getElementById('anchor-caption').innerHTML =
      '<strong>Standard blocks:</strong> Each response is divided into fixed non-overlapping 16-token windows. The drafter trains on the same anchor positions every epoch — limited diversity of context features.';
    drawAnchors();
  });

  document.getElementById('anc-btn-random')?.addEventListener('click', () => {
    anchorMode = 'random';
    document.getElementById('anc-btn-random').classList.add('active');
    document.getElementById('anc-btn-standard').classList.remove('active');
    document.getElementById('anchor-caption').innerHTML =
      '<strong>Random anchors:</strong> 512 anchor positions sampled randomly from each sequence at each epoch. Epoch 1 and Epoch 2 cover different windows. Over 6 epochs, the drafter sees every position. Result: +14–19% τ improvement on all benchmarks.';
    drawAnchors();
  });
}

// ── §05: Data scaling line chart ──────────────────────
const scaleCanvas = document.getElementById('scale-canvas');
if (scaleCanvas) {
  const sCtx = scaleCanvas.getContext('2d');
  const SW = scaleCanvas.clientWidth, SH = 240, DPR = window.devicePixelRatio || 1;
  scaleCanvas.width = SW * DPR; scaleCanvas.height = SH * DPR; sCtx.scale(DPR, DPR);

  const padL = 55, padR = 25, padT = 20, padB = 40;
  const chartW = SW - padL - padR, chartH = SH - padT - padB;

  // X: data scale (1x = 68K ShareGPT), log-ish
  // Scales: 1x, 2x, 4x, 8x
  const scales = [1, 2, 4, 8]; // relative to EAGLE's 68K base
  const logScales = scales.map(s => Math.log2(s));
  const maxLog = Math.log2(8);

  // Y: τ values (normalized to show relative improvement)
  const eagleData   = [3.78, 3.80, 3.82, 3.84]; // essentially flat
  const eagle3Data  = [4.05, 4.52, 5.37, 6.23];  // genuine scaling
  const dflashData  = [5.20, 6.10, 7.20, 8.01];  // strong scaling

  const minY = 2.5, maxY = 9.5;

  function xPos(logS) { return padL + (logS / maxLog) * chartW; }
  function yPos(tau)  { return padT + (1 - (tau - minY) / (maxY - minY)) * chartH; }

  // Grid
  sCtx.strokeStyle = 'rgba(255,255,255,0.04)'; sCtx.lineWidth = 1;
  for (let t = 3; t <= 9; t++) {
    const y = yPos(t);
    sCtx.beginPath(); sCtx.moveTo(padL, y); sCtx.lineTo(padL + chartW, y); sCtx.stroke();
    sCtx.fillStyle = '#6b7280'; sCtx.font = '10px monospace'; sCtx.textAlign = 'right';
    sCtx.fillText('τ=' + t, padL - 5, y + 4);
  }
  scales.forEach(s => {
    const x = xPos(Math.log2(s));
    sCtx.strokeStyle = 'rgba(255,255,255,0.04)';
    sCtx.beginPath(); sCtx.moveTo(x, padT); sCtx.lineTo(x, padT + chartH); sCtx.stroke();
    sCtx.fillStyle = '#6b7280'; sCtx.font = '9px monospace'; sCtx.textAlign = 'center';
    sCtx.fillText(s + '× data', x, padT + chartH + 16);
  });

  // Axes labels
  sCtx.fillStyle = '#6b7280'; sCtx.font = '10px monospace'; sCtx.textAlign = 'center';
  sCtx.fillText('Training data scale (1× ≈ 68K samples)', padL + chartW/2, SH - 4);

  // Lines
  function drawLine(data, color, label, dashed) {
    sCtx.beginPath();
    data.forEach((tau, i) => {
      const x = xPos(logScales[i]), y = yPos(tau);
      i === 0 ? sCtx.moveTo(x, y) : sCtx.lineTo(x, y);
    });
    sCtx.strokeStyle = color;
    sCtx.lineWidth = 2;
    if (dashed) { sCtx.setLineDash([6, 4]); } else { sCtx.setLineDash([]); }
    sCtx.stroke();
    sCtx.setLineDash([]);

    // Dots
    data.forEach((tau, i) => {
      const x = xPos(logScales[i]), y = yPos(tau);
      sCtx.beginPath(); sCtx.arc(x, y, 4, 0, Math.PI * 2);
      sCtx.fillStyle = color; sCtx.fill();
    });

    // End label
    const lx = xPos(logScales[logScales.length-1]) + 8;
    const ly = yPos(data[data.length-1]) + 4;
    sCtx.fillStyle = color; sCtx.font = 'bold 10px monospace'; sCtx.textAlign = 'left';
    sCtx.fillText(label, lx, ly);
  }

  drawLine(eagleData,  '#6b7280', 'EAGLE', true);
  drawLine(eagle3Data, '#06b6d4', 'EAGLE-3', false);
  drawLine(dflashData, '#8b5cf6', 'DFlash', false);
}

// ── §06: Step navigator ───────────────────────────────
let step = 0;
const boxes  = document.querySelectorAll('.step-box');
const prevBtn = document.getElementById('step-prev');
const nextBtn = document.getElementById('step-next');
const progEl  = document.getElementById('step-prog');
function updateSteps() {
  boxes.forEach((b, i) => {
    b.classList.remove('active','done');
    if (i === step) b.classList.add('active');
    else if (i < step) b.classList.add('done');
  });
  if (prevBtn) prevBtn.disabled = step === 0;
  if (nextBtn) nextBtn.disabled = step === boxes.length - 1;
  if (progEl) progEl.textContent = `Step ${step+1} of ${boxes.length}`;
  boxes.forEach((b, i) => {
    const n = b.querySelector('.step-num');
    if (n) n.textContent = i < step ? '✓' : String(i+1);
  });
}
prevBtn?.addEventListener('click', () => { if (step>0){step--;updateSteps();} });
nextBtn?.addEventListener('click', () => { if (step<boxes.length-1){step++;updateSteps();} });
updateSteps();

// ── §06: Recipe bars ─────────────────────────────────
const recipeSection = document.getElementById('s-recipe');
if (recipeSection) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('#recipe-bars .bar-fill[data-w]').forEach(b => {
          b.style.width = b.dataset.w + '%';
        });
      }
    });
  }, { threshold: 0.2 }).observe(recipeSection);
}
</script>
</BaseLayout>

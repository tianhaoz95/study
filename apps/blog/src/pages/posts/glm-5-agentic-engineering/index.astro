// ---------- Scroll sync ----------
const sectionMap = {
  's-vibe':'vibe','s-mtp':'mtp','s-indexshare':'indexshare',
  's-slime':'slime','s-topk':'topk','s-distillation':'distillation'
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ---------- helper: hi-dpi canvas ----------
function fitCanvas(cv, h) {
  const DPR = window.devicePixelRatio || 1;
  const W = cv.clientWidth || cv.parentElement.clientWidth;
  cv.width = W * DPR; cv.height = h * DPR;
  const ctx = cv.getContext('2d');
  ctx.setTransform(DPR,0,0,DPR,0,0);
  return { ctx, W, H: h };
}

// ============ 02 speculative simulator ============
(function(){
  let model = 'shared';
  let K = 3;
  let animTimer = null;
  
  const mtpKVal = document.getElementById('mtp-k-val');
  const mtpKSlider = document.getElementById('mtp-k-slider');
  const simText = document.getElementById('sim-text-flow');
  const btnRun = document.getElementById('btn-run-sim');
  const statSpeedup = document.getElementById('stat-speedup');
  const statAccept = document.getElementById('stat-accept');
  const statMem = document.getElementById('stat-mem');
  
  const modelStats = {
    single: { speedup: '1.58x', accept: '2.55', mem: '0%' },
    shared: { speedup: '1.82x', accept: '2.76', mem: '0%' },
    multi:  { speedup: '1.85x', accept: '2.78', mem: '200%' }
  };
  
  mtpKSlider.addEventListener('input', (e) => {
    K = +e.target.value;
    mtpKVal.textContent = `${K} Step${K > 1 ? 's' : ''}`;
  });
  
  document.querySelectorAll('#mtp-model-ctrls .vp-btn').forEach(b => {
    b.addEventListener('click', () => {
      document.querySelectorAll('#mtp-model-ctrls .vp-btn').forEach(x => x.classList.remove('active'));
      b.classList.add('active');
      model = b.dataset.model;
      
      // Update quick dashboard stats
      statSpeedup.textContent = modelStats[model].speedup;
      statAccept.textContent = modelStats[model].accept;
      statMem.textContent = modelStats[model].mem;
    });
  });
  
  const simulationCode = [
    { text: 'low', isAccept: true },
    { text: '=', isAccept: true },
    { text: '0', isAccept: true },
    { text: '\\n    ', isAccept: true, isNewline: true },
    { text: 'high', isAccept: true },
    { text: '=', isAccept: true },
    { text: 'len(arr)', isAccept: true },
    { text: '-', isAccept: true },
    { text: '1', isAccept: true },
    { text: '\\n    ', isAccept: true, isNewline: true },
    { text: 'while', isAccept: true },
    { text: 'low', isAccept: true },
    { text: '<=', isAccept: true, rejectInModel: ['single'] }, // Single-Layer fails here (guesses '<')
    { text: 'high:', isAccept: true },
    { text: '\\n        ', isAccept: true, isNewline: true },
    { text: 'mid', isAccept: true },
    { text: '=', isAccept: true },
    { text: '(low', isAccept: true },
    { text: '+', isAccept: true },
    { text: 'high)', isAccept: true },
    { text: '//', isAccept: true },
    { text: '2', isAccept: true }
  ];
  
  btnRun.addEventListener('click', () => {
    if (animTimer) clearInterval(animTimer);
    btnRun.disabled = true;
    btnRun.textContent = '⚡ Simulating speculative verification...';
    simText.innerHTML = '';
    
    let index = 0;
    let totalSteps = 0;
    let acceptedCount = 0;
    
    function runNextStep() {
      if (index >= simulationCode.length) {
        clearInterval(animTimer);
        btnRun.disabled = false;
        btnRun.textContent = '▶ Run Speculative Generation';
        return;
      }
      
      // Simulate draft block generation
      let draftTokens = [];
      let currentK = K;
      
      // We generate K draft tokens starting at index
      for (let offset = 0; offset < currentK; offset++) {
        const item = simulationCode[index + offset];
        if (!item) break;
        draftTokens.push(item);
      }
      
      let stepText = '';
      let isVerified = true;
      let acceptedInStep = 0;
      
      draftTokens.forEach((tok, offset) => {
        const spanId = `tok-${index}-${offset}`;
        if (tok.isNewline) {
          stepText += `<br>`;
        } else {
          stepText += `<span class="sim-token draft" id="${spanId}">${tok.text}</span> `;
        }
      });
      
      simText.innerHTML += stepText;
      simText.scrollTop = simText.scrollHeight;
      
      // Run target validation after a tiny delay
      setTimeout(() => {
        draftTokens.forEach((tok, offset) => {
          const span = document.getElementById(`tok-${index}-${offset}`);
          if (!span) return;
          
          span.classList.remove('draft');
          
          // Check if token is rejected by the selected model
          const isRejectedByModel = tok.rejectInModel && tok.rejectInModel.includes(model);
          
          if (isVerified && !isRejectedByModel) {
            span.classList.add('accepted');
            acceptedCount++;
            acceptedInStep++;
          } else {
            if (isVerified) {
              // First failure point: mark this token as rejected
              span.classList.add('rejected');
              isVerified = false;
              
              // Target model appends correct token as fallback
              const corrSpan = document.createElement('span');
              corrSpan.className = 'sim-token correction';
              corrSpan.textContent = tok.text; // Target corrects it
              span.parentNode.insertBefore(corrSpan, span.nextSibling);
            } else {
              // Discard subsequent tokens
              span.style.opacity = '0.3';
            }
          }
        });
        
        index += acceptedInStep + (isVerified ? 0 : 1);
        if (index === 0 && !isVerified) index = 1; // safety increment
        
        totalSteps++;
      }, 500);
    }
    
    animTimer = setInterval(runNextStep, 1000);
  });
})();

// ============ 03 IndexShare Visualizer ============
(function(){
  const lenSlider = document.getElementById('idx-len-slider');
  const lenVal = document.getElementById('idx-len-val');
  const cvChart = document.getElementById('cv-flops-chart');
  
  let isSharing = true;
  let L = 1000000; // Sequence length
  
  lenSlider.addEventListener('input', (e) => {
    L = Math.round(Math.pow(2, (+e.target.value / 100) + 12)); // map slider linearly to logarithmic context
    if (L > 1000000) L = 1000000;
    lenVal.textContent = `${L.toLocaleString()} Tokens`;
    drawChart();
  });
  
  document.querySelectorAll('#idx-toggle-ctrls .vp-btn').forEach(b => {
    b.addEventListener('click', () => {
      document.querySelectorAll('#idx-toggle-ctrls .vp-btn').forEach(x => x.classList.remove('active'));
      b.classList.add('active');
      isSharing = b.dataset.mode === 'on';
      
      // Update visual layer stack representation
      const layers = [
        document.getElementById('idx-layer-0'),
        document.getElementById('idx-layer-1'),
        document.getElementById('idx-layer-2'),
        document.getElementById('idx-layer-3')
      ];
      
      layers.forEach((layer, idx) => {
        if (!isSharing) {
          layer.className = 'idx-layer calc';
          layer.querySelector('.idx-layer-action').textContent = 'Calculate Indexer';
        } else {
          if (idx === 0) {
            layer.className = 'idx-layer calc';
            layer.querySelector('.idx-layer-action').textContent = 'Calculate Indexer';
          } else {
            layer.className = 'idx-layer reuse';
            layer.querySelector('.idx-layer-action').textContent = 'Reuse Cache';
          }
        }
      });
      
      drawChart();
    });
  });
  
  function drawChart() {
    if (!cvChart) return;
    const { ctx, W, H } = fitCanvas(cvChart, 200);
    ctx.clearRect(0,0,W,H);
    
    // Draw axes
    ctx.strokeStyle = 'rgba(255,255,255,0.08)';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(40, 10); ctx.lineTo(40, H-30); ctx.lineTo(W-20, H-30);
    ctx.stroke();
    
    // Draw grid lines
    ctx.fillStyle = 'rgba(255,255,255,0.3)';
    ctx.font = '9px monospace';
    ctx.textAlign = 'center';
    
    const xLabels = ['4K', '32K', '128K', '512K', '1M'];
    const xPositions = [40, (W-60)*0.25+40, (W-60)*0.5+40, (W-60)*0.75+40, W-20];
    xLabels.forEach((lbl, idx) => {
      ctx.fillText(lbl, xPositions[idx], H-16);
      ctx.beginPath();
      ctx.moveTo(xPositions[idx], H-30);
      ctx.lineTo(xPositions[idx], H-34);
      ctx.stroke();
    });
    
    // Plot curves
    ctx.lineWidth = 2;
    
    // Standard DSA Curve (Red/Orange)
    ctx.strokeStyle = '#f59e0b';
    ctx.beginPath();
    for (let x = 40; x <= W-20; x++) {
      const pct = (x - 40) / (W - 60);
      const val = Math.pow(pct, 1.8) * 120 + 20; // curve shape
      const y = H - 30 - val;
      if (x === 40) ctx.moveTo(x, y); else ctx.lineTo(x, y);
    }
    ctx.stroke();
    ctx.fillStyle = '#f59e0b'; ctx.textAlign = 'left';
    ctx.fillText('DSA (No Sharing)', W-120, H-155);
    
    // IndexShare Curve (Green)
    ctx.strokeStyle = '#10b981';
    ctx.beginPath();
    for (let x = 40; x <= W-20; x++) {
      const pct = (x - 40) / (W - 60);
      const val = Math.pow(pct, 1.8) * 41 + 20; // IndexShare flattens flops
      const y = H - 30 - val;
      if (x === 40) ctx.moveTo(x, y); else ctx.lineTo(x, y);
    }
    ctx.stroke();
    ctx.fillStyle = '#10b981';
    ctx.fillText('IndexShare (GLM-5.2)', W-120, H-80);
    
    // Dot mapping for current L
    const minL = 4096;
    const maxL = 1000000;
    const logMin = Math.log(minL);
    const logMax = Math.log(maxL);
    const logVal = Math.log(L);
    const pct = (logVal - logMin) / (logMax - logMin);
    
    const dotX = 40 + pct * (W - 60);
    
    // Y positions
    const yStd = H - 30 - (Math.pow(pct, 1.8) * 120 + 20);
    const yShare = H - 30 - (Math.pow(pct, 1.8) * 41 + 20);
    
    // Draw standard dot
    ctx.fillStyle = '#f59e0b';
    ctx.beginPath(); ctx.arc(dotX, yStd, 5, 0, Math.PI*2); ctx.fill();
    
    // Draw share dot
    ctx.fillStyle = '#10b981';
    ctx.beginPath(); ctx.arc(dotX, yShare, 5, 0, Math.PI*2); ctx.fill();
    
    // Draw dashed connecting line if sharing active
    if (isSharing) {
      ctx.strokeStyle = 'rgba(255,255,255,0.4)';
      ctx.lineWidth = 1;
      ctx.setLineDash([2, 2]);
      ctx.beginPath(); ctx.moveTo(dotX, yStd); ctx.lineTo(dotX, yShare); ctx.stroke();
      ctx.setLineDash([]);
      
      // Print saving text
      const saving = (Math.pow(pct, 1.8) * 120 + 20) / (Math.pow(pct, 1.8) * 41 + 20);
      ctx.fillStyle = '#fff'; ctx.font = '700 10px monospace'; ctx.textAlign = 'center';
      ctx.fillText(`${saving.toFixed(1)}x FLOP Saving`, dotX, Math.min(yStd, yShare) - 15);
    }
  }
  
  drawChart();
  window.addEventListener('resize', drawChart);
})();


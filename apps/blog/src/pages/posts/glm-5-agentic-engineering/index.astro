import torch
import torch.nn as nn

class IndexShareAttention(nn.Module):
    def __init__(self, config, layer_idx):
        super().__init__()
        self.layer_idx = layer_idx
        self.num_heads = config.num_heads
        self.head_dim = 256  # MLA-256 variant: wider head, 1/3 fewer heads
        
    def forward(self, q, kv_cache, indexer_cache):
        # IndexShare: Reuse routing decisions across blocks of 4 layers
        block_idx = self.layer_idx // 4
        is_indexer_layer = (self.layer_idx % 4 == 0)
        
        if is_indexer_layer:
            # 1. Compute sparse attention indexer (token relevance scores)
            # This is O(L^2) retrieval overhead, run once per 4 layers
            sparse_indices = self.run_indexer(q, kv_cache)
            indexer_cache.store(block_idx, sparse_indices)
        else:
            # 2. Reuse cached indices, bypassing indexer calculation
            # Saves 2.9x FLOPs at 1M context length
            sparse_indices = indexer_cache.get(block_idx)
            
        # 3. Compute attention sparsely over retrieved KV subset
        out = self.compute_sparse_attn(q, kv_cache, sparse_indices)
        return out`,


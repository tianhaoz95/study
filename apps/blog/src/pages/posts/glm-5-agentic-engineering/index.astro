import torch
import torch.nn as nn

class SharedMTP(nn.Module):
    def __init__(self, config):
        super().__init__()
        # 1. Main backbone model weights
        self.transformer = config.transformer
        
        # 2. Single MTP projection layer shared across K steps
        # This keeps the parameters flat (0% overhead)
        self.mtp_projection = nn.Linear(config.hidden_size, config.vocab_size)
        
    def forward(self, hidden_states, K=3):
        # Predict K future tokens in parallel using the SAME weights
        mtp_logits = []
        x = hidden_states
        
        for step in range(1, K + 1):
            # Share projection weights across all speculative steps
            # Target token for step k is x_{t+k}
            logits = self.mtp_projection(x)
            mtp_logits.append(logits)
            
            # Predict next state representation
            x = self.transformer.predict_next_hidden(x)
            
        return mtp_logits`,


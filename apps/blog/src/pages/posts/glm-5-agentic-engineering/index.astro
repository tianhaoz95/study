import torch

def run_dsa_indexer(query, keys, deterministic=True):
    # Compute relevance logits
    logits = torch.matmul(query, keys.transpose(-2, -1))
    k = 2048  # Large top-k for Indexer compared to MoE
    
    if deterministic:
        # torch.topk is strictly deterministic
        # Essential for RL stability to avoid training-inference mismatch
        values, indices = torch.topk(logits, k=k, dim=-1)
    else:
        # CUDA/TileLang custom top-k are non-deterministic due to parallel reduction
        # Breaks RL optimization, causing severe entropy collapse
        values, indices = cuda_fast_topk(logits, k=k)
        
    return indices`,


import torch

def compute_icepop_loss(logits_train, logits_infer, advantages, beta=2.0):
    # 1. Compute training-inference mismatch ratio (rho)
    probs_train = torch.softmax(logits_train, dim=-1)
    probs_infer = torch.softmax(logits_infer, dim=-1)
    rho = probs_train / (probs_infer + 1e-8)
    
    # 2. IcePop operator pop(rho, 1/beta, beta)
    # Suppresses samples where mismatch deviates excessively
    mask = (rho >= 1/beta) & (rho <= beta)
    pop_rho = torch.where(mask, rho, torch.zeros_like(rho))
    
    # 3. Double-sided Importance Sampling PPO clipping
    surr1 = pop_rho * advantages
    surr2 = torch.clamp(pop_rho, 1-0.2, 1+0.28) * advantages
    loss = -torch.min(surr1, surr2).mean()
    
    return loss`

<script>
// ── TOC + sidebar toggles ──
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});
const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ── Code sidebar tab switching ──
const tabMeta = {
  problem:  { file: 'rtpurbo/overview.py',   title: 'The Problem' },
  heads:    { file: 'rtpurbo/calibration.py', title: 'Head Specialization' },
  indexer:  { file: 'rtpurbo/indexer.py',    title: 'Low-Dim Indexer' },
  topp:     { file: 'rtpurbo/selection.py',  title: 'Dynamic Top-p' },
  training: { file: 'rtpurbo/training.py',   title: 'Training Pipeline' },
  results:  { file: 'rtpurbo/results.py',    title: 'Results' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ── IntersectionObserver: sync TOC + sidebar ──
const sectionMap = {
  's-problem': 'problem', 's-heads': 'heads', 's-indexer': 'indexer',
  's-topp': 'topp', 's-training': 'training', 's-results': 'results'
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ── Step navigator (training pipeline) ──
let trainStep = 0;
const trainBoxes = document.querySelectorAll('#train-steps .step-box');
const trainPrev  = document.getElementById('train-prev');
const trainNext  = document.getElementById('train-next');
const trainProg  = document.getElementById('train-prog');
function updateTrainSteps() {
  trainBoxes.forEach((b, i) => {
    b.classList.remove('active','done');
    if (i === trainStep) b.classList.add('active');
    else if (i < trainStep) b.classList.add('done');
  });
  if (trainPrev) trainPrev.disabled = trainStep === 0;
  if (trainNext) trainNext.disabled = trainStep === trainBoxes.length - 1;
  if (trainProg) trainProg.textContent = `Step ${trainStep+1} of ${trainBoxes.length}`;
  trainBoxes.forEach((b, i) => {
    const n = b.querySelector('.step-num');
    if (n) n.textContent = i < trainStep ? '✓' : String(i+1);
  });
}
trainPrev?.addEventListener('click', () => { if (trainStep>0){trainStep--;updateTrainSteps();} });
trainNext?.addEventListener('click', () => { if (trainStep<trainBoxes.length-1){trainStep++;updateTrainSteps();} });
updateTrainSteps();

// ── Seeded PRNG ──
function seededRand(seed) {
  let s = seed;
  return () => {
    s = (s * 1664525 + 1013904223) & 0xffffffff;
    return (s >>> 0) / 0xffffffff;
  };
}

// ── §02: Head Types Canvas ──
(function() {
  const canvas = document.getElementById('heads-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const W = canvas.clientWidth, H = 260, DPR = window.devicePixelRatio || 1;
  canvas.width = W * DPR; canvas.height = H * DPR; ctx.scale(DPR, DPR);

  const rand = seededRand(42);
  // Generate a 6x8 grid of heads (48 total)
  const COLS = 8, ROWS = 6;
  const padX = 40, padY = 30;
  const cellW = (W - padX*2) / COLS;
  const cellH = (H - padY*2) / ROWS;

  // ~15% retrieval heads (7 out of 48)
  const retHeads = new Set([3, 10, 17, 22, 31, 38, 44]);
  const heads = [];
  for (let r = 0; r < ROWS; r++) {
    for (let c = 0; c < COLS; c++) {
      const idx = r * COLS + c;
      heads.push({
        idx, r, c,
        x: padX + c * cellW + cellW/2,
        y: padY + r * cellH + cellH/2,
        isRet: retHeads.has(idx),
        size: retHeads.has(idx) ? 11 : 7,
      });
    }
  }

  let hovered = null;

  function drawHeads() {
    ctx.clearRect(0, 0, W, H);

    // Layer labels
    ctx.font = `10px var(--ff-mono, monospace)`;
    ctx.fillStyle = 'rgba(255,255,255,.18)';
    for (let r = 0; r < ROWS; r++) {
      ctx.fillText(`L${r*4+1}`, 4, padY + r * cellH + cellH/2 + 4);
    }

    // Draw head dots
    heads.forEach(h => {
      const isHov = hovered === h.idx;
      const color = h.isRet ? 'var(--purple)' : 'var(--cyan)';
      const alpha = h.isRet ? 0.85 : 0.45;

      ctx.beginPath();
      ctx.arc(h.x, h.y, isHov ? h.size + 3 : h.size, 0, Math.PI*2);
      ctx.fillStyle = h.isRet
        ? `rgba(139,92,246,${isHov ? 0.95 : alpha})`
        : `rgba(6,182,212,${isHov ? 0.8 : alpha})`;
      ctx.fill();

      if (h.isRet) {
        ctx.strokeStyle = 'rgba(139,92,246,.9)';
        ctx.lineWidth = 1.5;
        ctx.stroke();
      }
    });

    // Show attention lines for hovered head
    if (hovered !== null) {
      const h = heads[hovered];
      if (h.isRet) {
        // Draw long-range lines to random distant positions
        const r2 = seededRand(hovered * 7 + 13);
        for (let k = 0; k < 6; k++) {
          const targetX = padX + r2() * (W - padX*2);
          const targetY = padY + r2() * (H - padY*2);
          ctx.beginPath();
          ctx.moveTo(h.x, h.y);
          ctx.quadraticCurveTo(
            (h.x + targetX)/2, h.y - 30 - r2()*30,
            targetX, targetY
          );
          ctx.strokeStyle = 'rgba(139,92,246,.4)';
          ctx.lineWidth = 1;
          ctx.setLineDash([3,3]);
          ctx.stroke();
          ctx.setLineDash([]);
        }
        // Label
        ctx.font = 'bold 10px var(--ff-mono, monospace)';
        ctx.fillStyle = 'var(--purple-l, #a78bfa)';
        ctx.fillText('retrieval head — attends far', h.x + 14, h.y - 2);
      } else {
        // Draw short local lines
        const r2 = seededRand(hovered * 3 + 5);
        for (let k = 0; k < 5; k++) {
          const dx = (r2()-0.5) * 60;
          const dy = (r2()-0.5) * 20;
          ctx.beginPath();
          ctx.moveTo(h.x, h.y);
          ctx.lineTo(h.x + dx, Math.max(padY, Math.min(H-padY, h.y + dy)));
          ctx.strokeStyle = 'rgba(6,182,212,.35)';
          ctx.lineWidth = 1;
          ctx.stroke();
        }
        ctx.font = 'bold 10px var(--ff-mono, monospace)';
        ctx.fillStyle = 'var(--cyan, #22d3ee)';
        ctx.fillText('local head — nearby only', h.x + 10, h.y - 2);
      }
    }

    // Title
    ctx.font = '9px var(--ff-mono, monospace)';
    ctx.fillStyle = 'rgba(255,255,255,.3)';
    ctx.fillText('48 attention heads across 6 layers (hover to inspect)', W/2 - 130, H - 6);
  }

  canvas.addEventListener('mousemove', e => {
    const rect = canvas.getBoundingClientRect();
    const mx = (e.clientX - rect.left);
    const my = (e.clientY - rect.top);
    let found = null;
    heads.forEach(h => {
      const d = Math.hypot(mx - h.x, my - h.y);
      if (d < (h.isRet ? 14 : 10)) found = h.idx;
    });
    if (found !== hovered) { hovered = found; drawHeads(); }
  });
  canvas.addEventListener('mouseleave', () => { hovered = null; drawHeads(); });

  drawHeads();
})();

// ── §03: Indexer Recall vs Dimensions canvas ──
(function() {
  const canvas = document.getElementById('indexer-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const W = canvas.clientWidth, H = 220, DPR = window.devicePixelRatio || 1;
  canvas.width = W * DPR; canvas.height = H * DPR; ctx.scale(DPR, DPR);

  const pad = { l:50, r:30, t:20, b:45 };
  const cW = W - pad.l - pad.r;
  const cH = H - pad.t - pad.b;

  // Recall curve data (approximated from paper: 16 dims → >90%, derived from RoPE analysis)
  // x = dimensions (1,2,4,8,16,32,64,128), y = recall %
  const data = [
    {d:1,  r:28},
    {d:2,  r:42},
    {d:4,  r:61},
    {d:8,  r:78},
    {d:16, r:91},
    {d:32, r:95},
    {d:64, r:98},
    {d:128, r:100},
  ];
  const xDims = [1, 2, 4, 8, 16, 32, 64, 128];
  const logScale = d => Math.log2(d) / Math.log2(128);

  function toXY(d, r) {
    return {
      x: pad.l + logScale(d) * cW,
      y: pad.t + (1 - r/100) * cH
    };
  }

  // Draw
  ctx.clearRect(0, 0, W, H);

  // Grid
  [25, 50, 75, 90, 100].forEach(r => {
    const y = pad.t + (1 - r/100) * cH;
    ctx.beginPath();
    ctx.moveTo(pad.l, y); ctx.lineTo(pad.l + cW, y);
    ctx.strokeStyle = r === 90 ? 'rgba(139,92,246,.25)' : 'rgba(255,255,255,.05)';
    ctx.lineWidth = r === 90 ? 1.5 : 1;
    ctx.setLineDash(r === 90 ? [4,3] : []);
    ctx.stroke();
    ctx.setLineDash([]);
    ctx.font = '9px var(--ff-mono,monospace)';
    ctx.fillStyle = r === 90 ? 'rgba(139,92,246,.8)' : 'rgba(255,255,255,.3)';
    ctx.fillText(r + '%', pad.l - 28, y + 4);
  });

  // X axis ticks
  xDims.forEach(d => {
    const x = pad.l + logScale(d) * cW;
    ctx.beginPath();
    ctx.moveTo(x, pad.t + cH); ctx.lineTo(x, pad.t + cH + 4);
    ctx.strokeStyle = 'rgba(255,255,255,.3)';
    ctx.lineWidth = 1;
    ctx.stroke();
    ctx.font = '9px var(--ff-mono,monospace)';
    ctx.fillStyle = 'rgba(255,255,255,.4)';
    ctx.textAlign = 'center';
    ctx.fillText(String(d), x, pad.t + cH + 16);
  });
  ctx.textAlign = 'left';
  ctx.font = '9px var(--ff-mono,monospace)';
  ctx.fillStyle = 'rgba(255,255,255,.35)';
  ctx.textAlign = 'center';
  ctx.fillText('Indexer dimensionality (log scale)', pad.l + cW/2, H - 4);
  ctx.textAlign = 'left';

  // Axes
  ctx.beginPath();
  ctx.moveTo(pad.l, pad.t); ctx.lineTo(pad.l, pad.t + cH); ctx.lineTo(pad.l + cW, pad.t + cH);
  ctx.strokeStyle = 'rgba(255,255,255,.2)';
  ctx.lineWidth = 1;
  ctx.stroke();

  // Recall curve
  ctx.beginPath();
  data.forEach((pt, i) => {
    const {x, y} = toXY(pt.d, pt.r);
    i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
  });
  ctx.strokeStyle = 'var(--cyan, #22d3ee)';
  ctx.lineWidth = 2.5;
  ctx.stroke();

  // Dots
  data.forEach(pt => {
    const {x, y} = toXY(pt.d, pt.r);
    ctx.beginPath();
    ctx.arc(x, y, pt.d === 16 ? 7 : 4, 0, Math.PI*2);
    ctx.fillStyle = pt.d === 16 ? 'var(--purple, #8b5cf6)' : 'var(--cyan, #22d3ee)';
    ctx.fill();
    if (pt.d === 16) {
      ctx.strokeStyle = 'rgba(139,92,246,.9)';
      ctx.lineWidth = 2;
      ctx.stroke();
    }
  });

  // Highlight r=16 annotation
  const pt16 = toXY(16, 91);
  ctx.font = 'bold 10px var(--ff-mono,monospace)';
  ctx.fillStyle = 'var(--purple-l, #a78bfa)';
  ctx.fillText('r=16 → 91% recall', pt16.x + 10, pt16.y - 8);
  ctx.font = '9px var(--ff-mono,monospace)';
  ctx.fillStyle = 'rgba(139,92,246,.7)';
  ctx.fillText('(8× cheaper than full-dim)', pt16.x + 10, pt16.y + 6);

  // Full dim annotation
  const pt128 = toXY(128, 100);
  ctx.font = '9px var(--ff-mono,monospace)';
  ctx.fillStyle = 'rgba(255,255,255,.3)';
  ctx.textAlign = 'right';
  ctx.fillText('full d=128', pt128.x - 6, pt128.y + 4);
  ctx.textAlign = 'left';

  // 90% threshold label
  const y90 = pad.t + (1 - 90/100) * cH;
  ctx.font = '9px var(--ff-mono,monospace)';
  ctx.fillStyle = 'rgba(139,92,246,.8)';
  ctx.textAlign = 'right';
  ctx.fillText('90% recall target', pad.l - 4, y90 - 4);
  ctx.textAlign = 'left';
})();

// ── §04: Top-p vs Top-k attention distribution canvas ──
(function() {
  const canvas = document.getElementById('topp-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const W = canvas.clientWidth, H = 240, DPR = window.devicePixelRatio || 1;
  canvas.width = W * DPR; canvas.height = H * DPR; ctx.scale(DPR, DPR);

  const statsEl = document.getElementById('topp-stats');
  let mode = 'diffuse';

  const pad = { l:50, r:30, t:25, b:45 };
  const cW = W - pad.l - pad.r;
  const cH = H - pad.t - pad.b;

  // Simulate cumulative attention mass curves
  // Diffuse: slow rise (Galápagos, 35K doc)
  // Concentrated: fast step (NIAH, 16K doc)
  function getCurve(m) {
    if (m === 'diffuse') {
      // Power-law-ish growth to ~100% by 35483
      const N = 35483;
      return (k) => {
        if (k <= 0) return 0;
        return Math.min(1.0, 0.90 * Math.pow(k / 8504, 0.55));
      };
    } else {
      // Needle: 96.6% at k=2, essentially flat after
      return (k) => {
        if (k <= 0) return 0;
        if (k === 1) return 0.70;
        if (k >= 2) return Math.min(1.0, 0.966 + (k-2)/16000 * 0.034);
        return 0;
      };
    }
  }

  const CONFIGS = {
    diffuse: {
      N: 35483, label: '"Galápagos" query (35K doc)',
      topk_vals: [2048, 4096, 16384],
      topp_tokens: 8504, topp_recall: 0.90,
      color: 'var(--cyan)',
    },
    needle: {
      N: 16272, label: 'NIAH password query (16K doc)',
      topk_vals: [2048, 4096, 16384],
      topp_tokens: 2, topp_recall: 0.966,
      color: 'var(--green, #10b981)',
    }
  };

  function draw() {
    ctx.clearRect(0, 0, W, H);
    const cfg = CONFIGS[mode];
    const curve = getCurve(mode);
    const N = cfg.N;

    // Axes
    ctx.beginPath();
    ctx.moveTo(pad.l, pad.t); ctx.lineTo(pad.l, pad.t + cH);
    ctx.lineTo(pad.l + cW, pad.t + cH);
    ctx.strokeStyle = 'rgba(255,255,255,.2)';
    ctx.lineWidth = 1;
    ctx.stroke();

    // Grid lines
    [0.25, 0.50, 0.75, 0.90, 1.0].forEach(v => {
      const y = pad.t + (1 - v) * cH;
      ctx.beginPath();
      ctx.moveTo(pad.l, y); ctx.lineTo(pad.l + cW, y);
      ctx.strokeStyle = v === 0.90 ? 'rgba(139,92,246,.3)' : 'rgba(255,255,255,.05)';
      ctx.lineWidth = v === 0.90 ? 1.5 : 1;
      ctx.setLineDash(v === 0.90 ? [4,3] : []);
      ctx.stroke();
      ctx.setLineDash([]);
      ctx.font = '9px var(--ff-mono,monospace)';
      ctx.fillStyle = v === 0.90 ? 'rgba(139,92,246,.8)' : 'rgba(255,255,255,.3)';
      ctx.textAlign = 'right';
      ctx.fillText((v*100).toFixed(0) + '%', pad.l - 4, y + 4);
    });
    ctx.textAlign = 'left';

    // X axis ticks (log scale: 1, 10, 100, 1K, 10K, 35K)
    const logTicks = mode === 'diffuse'
      ? [1, 10, 100, 1000, 4096, 8504, 16384, 35483]
      : [1, 2, 10, 100, 1000, 4096, 16272];
    const logMin = 0, logMax = Math.log10(N);
    const xLog = (k) => pad.l + (Math.log10(Math.max(1, k)) - logMin) / (logMax - logMin) * cW;

    logTicks.forEach(k => {
      const x = xLog(k);
      ctx.beginPath();
      ctx.moveTo(x, pad.t + cH); ctx.lineTo(x, pad.t + cH + 4);
      ctx.strokeStyle = 'rgba(255,255,255,.2)';
      ctx.lineWidth = 1;
      ctx.stroke();
      ctx.font = '8px var(--ff-mono,monospace)';
      ctx.fillStyle = 'rgba(255,255,255,.3)';
      ctx.textAlign = 'center';
      const label = k >= 1000 ? (k/1000).toFixed(k>=10000?0:1)+'K' : String(k);
      ctx.fillText(label, x, pad.t + cH + 15);
    });
    ctx.textAlign = 'left';
    ctx.font = '9px var(--ff-mono,monospace)';
    ctx.fillStyle = 'rgba(255,255,255,.25)';
    ctx.textAlign = 'center';
    ctx.fillText('# tokens retained (sorted by score)', pad.l + cW/2, H - 4);
    ctx.textAlign = 'left';

    // Draw curve
    ctx.beginPath();
    let first = true;
    const STEPS = 300;
    for (let i = 0; i <= STEPS; i++) {
      const k = Math.pow(10, (i/STEPS) * logMax);
      const x = xLog(k);
      const y = pad.t + (1 - curve(k)) * cH;
      if (first) { ctx.moveTo(x, y); first = false; }
      else ctx.lineTo(x, y);
    }
    ctx.strokeStyle = cfg.color;
    ctx.lineWidth = 2.5;
    ctx.stroke();

    // top-k vertical markers
    const topkColors = ['rgba(245,158,11,.5)', 'rgba(245,158,11,.7)', 'rgba(245,158,11,.9)'];
    cfg.topk_vals.forEach((k, i) => {
      const x = xLog(k);
      const r = curve(k);
      const y = pad.t + (1-r) * cH;
      ctx.beginPath();
      ctx.moveTo(x, pad.t); ctx.lineTo(x, pad.t + cH);
      ctx.strokeStyle = topkColors[i];
      ctx.lineWidth = 1;
      ctx.setLineDash([3,3]);
      ctx.stroke();
      ctx.setLineDash([]);
      ctx.font = '8px var(--ff-mono,monospace)';
      ctx.fillStyle = topkColors[i];
      ctx.textAlign = 'center';
      const kLabel = k >= 1000 ? (k/1000).toFixed(0)+'k' : String(k);
      ctx.fillText('top-' + kLabel, x, pad.t + 12 + i*11);
      ctx.fillText((r*100).toFixed(1)+'%', x, y - 5);
    });
    ctx.textAlign = 'left';

    // top-p marker
    const xTopp = xLog(cfg.topp_tokens);
    const yTopp = pad.t + (1 - cfg.topp_recall) * cH;
    ctx.beginPath();
    ctx.moveTo(xTopp, pad.t); ctx.lineTo(xTopp, pad.t + cH);
    ctx.strokeStyle = 'rgba(139,92,246,.9)';
    ctx.lineWidth = 2;
    ctx.stroke();

    ctx.beginPath();
    ctx.arc(xTopp, yTopp, 6, 0, Math.PI*2);
    ctx.fillStyle = 'rgba(139,92,246,.9)';
    ctx.fill();

    ctx.font = 'bold 9px var(--ff-mono,monospace)';
    ctx.fillStyle = 'var(--purple-l, #a78bfa)';
    const tokLabel = cfg.topp_tokens >= 1000 ? (cfg.topp_tokens/1000).toFixed(1)+'K' : String(cfg.topp_tokens);
    ctx.fillText('top-p: ' + tokLabel + ' tokens', xTopp + 8, yTopp - 6);
    ctx.font = '8px var(--ff-mono,monospace)';
    ctx.fillStyle = 'rgba(139,92,246,.7)';
    ctx.fillText((cfg.topp_recall*100).toFixed(1)+'% recall', xTopp + 8, yTopp + 7);

    // Title
    ctx.font = '10px var(--ff-mono,monospace)';
    ctx.fillStyle = 'rgba(255,255,255,.6)';
    ctx.fillText(cfg.label, pad.l + 4, pad.t + 16);

    // Update stats
    if (statsEl) {
      const tkRecalls = cfg.topk_vals.map((k,i) => {
        const r = (curve(k)*100).toFixed(1);
        const kl = k >= 1000 ? (k/1000).toFixed(0)+'K' : String(k);
        return `<span>top-${kl}: <strong style="color:var(--amber)">${r}%</strong></span>`;
      });
      const tokLabel2 = cfg.topp_tokens >= 1000 ? (cfg.topp_tokens/1000).toFixed(1)+'K' : String(cfg.topp_tokens);
      statsEl.innerHTML = tkRecalls.join('') +
        `<span>top-p (0.9): <strong style="color:var(--purple-l)">${tokLabel2} tokens → ${(cfg.topp_recall*100).toFixed(1)}% recall</strong></span>`;
    }
  }

  document.getElementById('btn-diffuse')?.addEventListener('click', () => {
    mode = 'diffuse';
    document.getElementById('btn-diffuse')?.classList.add('active');
    document.getElementById('btn-needle')?.classList.remove('active');
    draw();
  });
  document.getElementById('btn-needle')?.addEventListener('click', () => {
    mode = 'needle';
    document.getElementById('btn-needle')?.classList.add('active');
    document.getElementById('btn-diffuse')?.classList.remove('active');
    draw();
  });

  draw();
})();

// ── §06: Speedup canvas ──
(function() {
  const canvas = document.getElementById('speedup-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const W = canvas.clientWidth, H = 220, DPR = window.devicePixelRatio || 1;
  canvas.width = W * DPR; canvas.height = H * DPR; ctx.scale(DPR, DPR);

  const pad = { l:55, r:40, t:20, b:50 };
  const cW = W - pad.l - pad.r;
  const cH = H - pad.t - pad.b;

  // Data: context lengths and speedups (from paper Figure 1 and text)
  const ctxLens = [32, 64, 128, 256, 512, 1024]; // K tokens
  const rtpurboSpeedups = [2.83, 4.25, 5.92, 7.47, 8.62, 9.36];
  const minfSpeedups    = [1.2,  1.8,  2.3,  3.1,  4.0,  4.9];
  const flexSpeedups    = [1.1,  1.6,  2.1,  2.8,  3.5,  4.5];

  const xLog = (k) => pad.l + (Math.log2(k) - Math.log2(32)) / (Math.log2(1024) - Math.log2(32)) * cW;
  const yVal = (v) => pad.t + (1 - (v - 1) / (9.36 - 1)) * cH;

  // Grid
  [2, 4, 6, 8, 9.36].forEach(v => {
    const y = yVal(v);
    ctx.beginPath();
    ctx.moveTo(pad.l, y); ctx.lineTo(pad.l + cW, y);
    ctx.strokeStyle = 'rgba(255,255,255,.05)';
    ctx.lineWidth = 1;
    ctx.stroke();
    ctx.font = '9px var(--ff-mono,monospace)';
    ctx.fillStyle = 'rgba(255,255,255,.3)';
    ctx.textAlign = 'right';
    ctx.fillText(v.toFixed(v===9.36?2:0)+'×', pad.l - 4, y + 4);
  });
  ctx.textAlign = 'left';

  // Axes
  ctx.beginPath();
  ctx.moveTo(pad.l, pad.t); ctx.lineTo(pad.l, pad.t + cH);
  ctx.lineTo(pad.l + cW, pad.t + cH);
  ctx.strokeStyle = 'rgba(255,255,255,.2)';
  ctx.lineWidth = 1;
  ctx.stroke();

  // X ticks
  ctxLens.forEach(k => {
    const x = xLog(k);
    ctx.beginPath();
    ctx.moveTo(x, pad.t + cH); ctx.lineTo(x, pad.t + cH + 4);
    ctx.strokeStyle = 'rgba(255,255,255,.2)';
    ctx.lineWidth = 1;
    ctx.stroke();
    ctx.font = '9px var(--ff-mono,monospace)';
    ctx.fillStyle = 'rgba(255,255,255,.35)';
    ctx.textAlign = 'center';
    ctx.fillText(k+'K', x, pad.t + cH + 16);
  });
  ctx.textAlign = 'left';
  ctx.font = '9px var(--ff-mono,monospace)';
  ctx.fillStyle = 'rgba(255,255,255,.25)';
  ctx.textAlign = 'center';
  ctx.fillText('Context length (tokens)', pad.l + cW/2, H - 4);
  ctx.textAlign = 'left';

  function drawLine(data, color, lw) {
    ctx.beginPath();
    data.forEach((v, i) => {
      const x = xLog(ctxLens[i]);
      const y = yVal(v);
      i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
    });
    ctx.strokeStyle = color;
    ctx.lineWidth = lw;
    ctx.stroke();
    // dots
    data.forEach((v, i) => {
      const x = xLog(ctxLens[i]);
      const y = yVal(v);
      ctx.beginPath();
      ctx.arc(x, y, lw > 2 ? 5 : 3, 0, Math.PI*2);
      ctx.fillStyle = color;
      ctx.fill();
    });
  }

  drawLine(flexSpeedups, 'rgba(245,158,11,.6)', 1.5);
  drawLine(minfSpeedups, 'rgba(6,182,212,.65)', 1.5);
  drawLine(rtpurboSpeedups, 'rgba(139,92,246,.9)', 2.5);

  // Labels at end
  const last = ctxLens.length - 1;
  ctx.font = 'bold 9px var(--ff-mono,monospace)';
  ctx.fillStyle = 'rgba(139,92,246,.9)';
  ctx.fillText('RTPurbo 9.36×', xLog(ctxLens[last]) + 6, yVal(rtpurboSpeedups[last]) + 4);
  ctx.fillStyle = 'rgba(6,182,212,.7)';
  ctx.fillText('MInference', xLog(ctxLens[last]) + 6, yVal(minfSpeedups[last]) + 4);
  ctx.fillStyle = 'rgba(245,158,11,.7)';
  ctx.fillText('FlexPrefill', xLog(ctxLens[last]) + 6, yVal(flexSpeedups[last]) + 4);
})();

// ── Animated bar chart trigger ──
const rulerBarsEl = document.getElementById('ruler-bars');
if (rulerBarsEl) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('#ruler-bars .bar-fill[data-w]').forEach(b => {
          const pct = parseFloat(b.dataset.w);
          // Normalize to max (full-attn = 86.23%)
          b.style.width = (pct / 100 * 100) + '%';
        });
      }
    });
  }, { threshold: 0.3 }).observe(rulerBarsEl);
}
</script>
</BaseLayout>

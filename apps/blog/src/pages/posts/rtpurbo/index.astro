<span class="cs-line hl-c">        <span class="cmt"># Project pre-RoPE q,k into r-dim space</span></span>
<span class="cs-line hl-c">        <span class="kw">self</span>.<span class="attr">W_q</span> = nn.<span class="cls">Linear</span>(d_head, r, bias=<span class="cls">False</span>)</span>
<span class="cs-line hl-c">        <span class="kw">self</span>.<span class="attr">W_k</span> = nn.<span class="cls">Linear</span>(d_head, r, bias=<span class="cls">False</span>)</span>
<span class="cs-line"></span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">score_tokens</span>(<span class="kw">self</span>, q_pre, k_pre_cache):</span>
<span class="cs-line">        <span class="cmt"># q_pre: [d], k_pre_cache: [N, d]</span></span>
<span class="cs-line">        q_r = <span class="kw">self</span>.<span class="fn">W_q</span>(q_pre)         <span class="cmt"># [r]</span></span>
<span class="cs-line">        k_r = <span class="kw">self</span>.<span class="fn">W_k</span>(k_pre_cache)   <span class="cmt"># [N, r]</span></span>
<span class="cs-line hl-g">        scores = k_r @ q_r            <span class="cmt"># [N] — cheap!</span></span>
<span class="cs-line">        <span class="kw">return</span> scores                <span class="cmt"># &gt;90% recall</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Training: minimize KL between full and</span>
<span class="cs-line cmt"># projected attention distributions</span>
<span class="cs-line cmt"># L = &Sigma;_h KL(a_full_h &#8214; a_proj_h(W_q, W_k))</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Why pre-RoPE? High-freq RoPE components</span>
<span class="cs-line cmt"># oscillate rapidly with distance → hurt recall</span>
<span class="cs-line cmt"># Low-freq components → smooth, preserve signal</span>
      </pre>
    </div>

    <!-- PANEL: topp -->
    <div class="cs-panel" id="panel-topp">
      <pre class="cs-pre">
<span class="cs-line cmt"># Dynamic top-p vs static top-k</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Query: "Galápagos" in 35K doc</span>
<span class="cs-line cmt"># Diffuse retrieval — needs MANY tokens</span>
<span class="cs-line"><span class="attr">top_2k_recall</span>   = <span class="str">"64.2%"</span>   <span class="cmt"># misses 36%</span></span>
<span class="cs-line"><span class="attr">top_4k_recall</span>   = <span class="str">"77.6%"</span>   <span class="cmt"># misses 22%</span></span>
<span class="cs-line"><span class="attr">top_16k_recall</span>  = <span class="str">"93.8%"</span>   <span class="cmt"># 8k wasted</span></span>
<span class="cs-line hl-p"><span class="attr">top_p_0_9_recall</span>= <span class="str">"90.0%"</span>   <span class="cmt"># 8504 tokens</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Query: NIAH password in 16K doc</span>
<span class="cs-line cmt"># Concentrated — needs VERY FEW tokens</span>
<span class="cs-line hl-c"><span class="attr">top_p_0_9_tokens</span>= <span class="num">2</span>         <span class="cmt"># 96.6% mass</span></span>
<span class="cs-line"><span class="attr">top_4k_tokens</span>   = <span class="num">4096</span>      <span class="cmt"># 4094 wasted</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Top-p selection (sort-free GPU kernel)</span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">top_p_select</span>(scores, p=<span class="num">0.9</span>):</span>
<span class="cs-line">    <span class="cmt"># 1. Score tokens via 16-dim indexer</span></span>
<span class="cs-line">    <span class="cmt"># 2. Build 256-bin histogram (1KB/head)</span></span>
<span class="cs-line">    <span class="cmt"># 3. Scan from high→low, stop at p=0.9</span></span>
<span class="cs-line hl-g">    <span class="cmt"># 4. Return block mask (no sort needed!)</span></span>
<span class="cs-line">    <span class="kw">pass</span>  <span class="cmt"># O(N) time, O(1) memory per head</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># At 512K context: sparsity &gt;97.1%</span>
<span class="cs-line cmt"># Active tokens still ≥ 90% attn mass</span>
      </pre>
    </div>

    <!-- PANEL: training -->
    <div class="cs-panel" id="panel-training">
      <pre class="cs-pre">
<span class="cs-line cmt"># Two-stage lightweight training</span>
<span class="cs-line cmt"># Total: ~600 steps, ~1M label tokens</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># ── Stage 1: Train projectors (backbone frozen) ──</span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">train_projectors</span>(model, data):</span>
<span class="cs-line hl-p">    <span class="cmt"># Freeze all backbone parameters</span></span>
<span class="cs-line">    <span class="kw">for</span> p <span class="kw">in</span> model.<span class="fn">parameters</span>(): p.requires_grad = <span class="cls">False</span></span>
<span class="cs-line">    <span class="kw">for</span> h <span class="kw">in</span> H_ret:                        <span class="cmt"># retrieval heads</span></span>
<span class="cs-line hl-c">        indexer[h].W_q.requires_grad = <span class="cls">True</span>  <span class="cmt"># 16×128</span></span>
<span class="cs-line hl-c">        indexer[h].W_k.requires_grad = <span class="cls">True</span>  <span class="cmt"># 16×128</span></span>
<span class="cs-line">    <span class="cmt"># Minimize KL(a_full &#8214; a_projected)</span></span>
<span class="cs-line">    loss = <span class="fn">sum</span>(<span class="fn">kl_div</span>(attn_full[h], attn_proj[h])</span>
<span class="cs-line">              <span class="kw">for</span> h <span class="kw">in</span> H_ret)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># ── Stage 2: Self-distillation (~600 steps) ──</span>
<span class="cs-line hl-g"><span class="kw">def</span> <span class="fn">self_distill</span>(sparse_model, dense_teacher, data):</span>
<span class="cs-line hl-g">    <span class="cmt"># No labeled data — align to teacher logits</span></span>
<span class="cs-line">    z_sparse = sparse_model(x).top_logits(<span class="num">10</span>)</span>
<span class="cs-line">    z_dense  = dense_teacher(x).top_logits(<span class="num">10</span>)</span>
<span class="cs-line">    <span class="cmt"># KL on top-10 logits only (cheap, effective)</span></span>
<span class="cs-line">    loss = <span class="fn">kl_div</span>(<span class="fn">softmax</span>(z_sparse), <span class="fn">softmax</span>(z_dense))</span>
<span class="cs-line">    <span class="cmt"># Data: FineWeb + Dolma, avg 48K tokens/doc</span></span>
      </pre>
    </div>


<span class="cs-line">  <span class="str">"Math500"</span>:  &#123;<span class="str">"eagle3_tau"</span>: 3.49, <span class="str">"dflash_tau"</span>: 7.08&#125;,</span>
<span class="cs-line">  <span class="str">"AIME25"</span>:   &#123;<span class="str">"eagle3_tau"</span>: 3.44, <span class="str">"dflash_tau"</span>: 6.54&#125;,</span>

<span class="cs-line cmt"># EAGLE-3(t=60)   SGLang  GSM8K    0  1   3.71  0.166  2.23×</span>
<span class="cs-line cmt"># DFlash(b=16)    SGLang  MT-Bench 0  1   4.24  0.023  2.75×</span>
<span class="cs-line cmt"># EAGLE-3(t=60)   SGLang  MT-Bench 0  64  3.26  0.166  1.38× (thpt)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Validation script template</span>
<span class="cs-line kw">def</span> <span class="fn">run_benchmark</span>(method, model, tasks, temps, batches):</span>
<span class="cs-line">    results = []</span>
<span class="cs-line">    c = <span class="fn">profile_c</span>(method, model)</span>
<span class="cs-line">    <span class="kw">for</span> task <span class="kw">in</span> tasks:</span>
<span class="cs-line">        <span class="kw">for</span> T <span class="kw">in</span> temps:</span>
<span class="cs-line">            <span class="kw">for</span> bs <span class="kw">in</span> batches:</span>
<span class="cs-line">                tau, speedup = <span class="fn">measure</span>(method, task, T, bs)</span>
<span class="cs-line">                results.<span class="fn">append</span>(&#123;</span>
<span class="cs-line">                    <span class="str">"task"</span>: task, <span class="str">"T"</span>: T, <span class="str">"bs"</span>: bs,</span>
<span class="cs-line hl-p">                    <span class="str">"tau"</span>: tau, <span class="str">"c"</span>: c,  <span class="cmt"># ← always include</span></span>
<span class="cs-line">                    <span class="str">"speedup"</span>: speedup</span>
<span class="cs-line">                &#125;)</span>
<span class="cs-line">    <span class="kw">return</span> results</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Minimum task set (3 categories)</span>
<span class="cs-line">TASKS   = [<span class="str">"gsm8k"</span>, <span class="str">"humaneval"</span>, <span class="str">"mt_bench"</span>]</span>
<span class="cs-line">TEMPS   = [0, 1]</span>
<span class="cs-line">BATCHES = [1, 8, 64]  <span class="cmt"># lat, mid, throughput</span></span>
      </pre>
    </div>


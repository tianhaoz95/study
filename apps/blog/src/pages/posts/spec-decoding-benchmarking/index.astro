<span class="cs-line hl-c">dflash_c   = 0.023  <span class="cmt"># 0.8ms / 35.5ms</span></span>
<span class="cs-line hl-c">dflash_s   = <span class="fn">speedup</span>(dflash_tau, 16, dflash_c)</span>
<span class="cs-line hl-c"><span class="cmt"># → 6.08×</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Key insight: DFlash wins on BOTH levers.</span>
<span class="cs-line cmt"># Higher τ AND lower c simultaneously.</span>
<span class="cs-line cmt"># τ ratio: 7.87 / 3.71 = 2.12×</span>
<span class="cs-line cmt"># c ratio: 0.166 / 0.023 = 7.2×</span>

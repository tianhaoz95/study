<script>
// ─── TOC + sidebar toggles ───────────────────────────────────────────────
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});
const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ─── Code sidebar tab switching ──────────────────────────────────────────
const tabMeta = {
  problem: { file: 'benchmark/five_variables.py',   title: 'The Measurement Problem' },
  formula: { file: 'benchmark/speedup_formula.py',  title: 'τ, c, and the Formula' },
  tasks:   { file: 'benchmark/task_sensitivity.py', title: 'Task Sensitivity' },
  batch:   { file: 'benchmark/batch_size.py',       title: 'The Batch Size Trap' },
  cost:    { file: 'benchmark/profile_cost.py',     title: 'The Draft Cost Race' },
  recipe:  { file: 'benchmark/recipe.py',           title: 'The Recipe' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ─── IntersectionObserver — sync TOC + sidebar on scroll ─────────────────
const sectionMap = {
  's-problem': 'problem', 's-formula': 'formula', 's-tasks': 'tasks',
  's-batch': 'batch', 's-cost': 'cost', 's-recipe': 'recipe'
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ─── §01: Problem canvas — DFlash speedup across tasks ───────────────────
(function() {
  const canvas = document.getElementById('canvas-problem');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 200;
  canvas.width = W * DPR; canvas.height = H * DPR;
  const ctx = canvas.getContext('2d');
  ctx.scale(DPR, DPR);

  const tasks = ['GSM8K', 'Math500', 'HumanEval', 'MBPP', 'MT-Bench'];
  const eagle3 = [2.23, 2.05, 2.17, 1.93, 1.90];
  const dflash  = [6.08, 5.62, 5.14, 4.65, 2.75];
  const maxV = 7;
  const pad = { left: 90, right: 20, top: 20, bottom: 36 };
  const chartW = W - pad.left - pad.right;
  const chartH = H - pad.top - pad.bottom;
  const rowH = chartH / tasks.length;

  ctx.clearRect(0, 0, W, H);

  // grid lines
  [2, 3, 4, 5, 6].forEach(v => {
    const x = pad.left + (v / maxV) * chartW;
    ctx.strokeStyle = 'rgba(255,255,255,0.04)';
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(x, pad.top); ctx.lineTo(x, H - pad.bottom); ctx.stroke();
    ctx.fillStyle = 'rgba(255,255,255,0.25)';
    ctx.font = `${9 * DPR / DPR}px monospace`;
    ctx.textAlign = 'center';
    ctx.fillText(v + '×', x, H - pad.bottom + 14);
  });
  // x axis label
  ctx.fillStyle = 'rgba(255,255,255,0.3)';
  ctx.font = '9px monospace';
  ctx.textAlign = 'center';
  ctx.fillText('speedup ratio  ▶', W / 2, H - 4);

  tasks.forEach((t, i) => {
    const y = pad.top + i * rowH;
    const midY = y + rowH / 2;

    // task label
    ctx.fillStyle = 'rgba(255,255,255,0.55)';
    ctx.font = '10px monospace';
    ctx.textAlign = 'right';
    ctx.fillText(t, pad.left - 8, midY + 4);

    // EAGLE-3 bar
    const e3x = pad.left + (eagle3[i] / maxV) * chartW;
    ctx.fillStyle = 'rgba(139,92,246,0.35)';
    ctx.fillRect(pad.left, y + 4, e3x - pad.left, rowH * 0.4);
    ctx.fillStyle = 'rgba(139,92,246,0.9)';
    ctx.font = '9px monospace';
    ctx.textAlign = 'left';
    ctx.fillText(eagle3[i] + '×', e3x + 3, y + rowH * 0.28 + 4);

    // DFlash bar
    const dfx = pad.left + (dflash[i] / maxV) * chartW;
    ctx.fillStyle = 'rgba(6,182,212,0.35)';
    ctx.fillRect(pad.left, y + rowH * 0.5, dfx - pad.left, rowH * 0.4);
    ctx.fillStyle = 'rgba(6,182,212,0.9)';
    ctx.fillText(dflash[i] + '×', dfx + 3, y + rowH * 0.72 + 4);
  });

  // legend
  ctx.fillStyle = 'rgba(139,92,246,0.85)';
  ctx.fillRect(pad.left, H - pad.bottom - 2, 12, 5);
  ctx.fillStyle = 'rgba(255,255,255,0.4)';
  ctx.textAlign = 'left';
  ctx.fillText('EAGLE-3', pad.left + 16, H - pad.bottom + 2);
  ctx.fillStyle = 'rgba(6,182,212,0.85)';
  ctx.fillRect(pad.left + 80, H - pad.bottom - 2, 12, 5);
  ctx.fillStyle = 'rgba(255,255,255,0.4)';
  ctx.fillText('DFlash', pad.left + 96, H - pad.bottom + 2);
})();

// ─── §02: Formula canvas ─────────────────────────────────────────────────
(function() {
  const canvas = document.getElementById('canvas-formula');
  if (!canvas) return;
  const slTau = document.getElementById('sl-tau');
  const slC   = document.getElementById('sl-c');
  const svTau = document.getElementById('sv-tau');
  const svC   = document.getElementById('sv-c');

  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 240;
  canvas.width = W * DPR; canvas.height = H * DPR;
  const ctx = canvas.getContext('2d');
  ctx.scale(DPR, DPR);

  // Fixed reference points
  const REF = [
    { label: 'EAGLE-3', tau: 3.71, c: 0.166, col: 'rgba(139,92,246,0.9)' },
    { label: 'DFlash',  tau: 7.87, c: 0.023, col: 'rgba(6,182,212,0.9)' },
  ];
  const GAMMA = 16;

  function computeSpeedup(tau, c, gamma) {
    return tau / (1 + gamma * c);
  }

  function drawFormula() {
    ctx.clearRect(0, 0, W, H);
    const tau = parseFloat(slTau.value);
    const c   = parseFloat(slC.value);
    svTau.textContent = tau.toFixed(1);
    svC.textContent   = c.toFixed(2);
    const S = computeSpeedup(tau, c, GAMMA);

    // Big speedup display
    const bigX = W * 0.62, bigY = H * 0.48;
    ctx.fillStyle = 'rgba(255,255,255,0.08)';
    ctx.beginPath();
    ctx.arc(bigX, bigY, 70, 0, Math.PI * 2);
    ctx.fill();

    const hue = S < 2 ? 0 : S < 3 ? 30 : S < 5 ? 60 : 150;
    ctx.fillStyle = `hsl(${hue}, 70%, 65%)`;
    ctx.font = `bold ${Math.min(44, 14 + S * 4)}px monospace`;
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText(S.toFixed(2) + '×', bigX, bigY - 6);
    ctx.font = '10px monospace';
    ctx.fillStyle = 'rgba(255,255,255,0.4)';
    ctx.fillText('speedup', bigX, bigY + 22);
    ctx.textBaseline = 'alphabetic';

    // Formula annotation
    const fx = W * 0.62;
    ctx.fillStyle = 'rgba(255,255,255,0.35)';
    ctx.font = '11px monospace';
    ctx.fillText(`S = ${tau.toFixed(1)} / (1 + ${GAMMA}×${c.toFixed(2)})`, fx, H * 0.82);
    ctx.fillText(`  = ${tau.toFixed(1)} / ${(1+GAMMA*c).toFixed(2)}`, fx, H * 0.82 + 16);

    // Scatter — τ vs S for varying c (c=0.02 cyan, c=0.17 purple)
    const pad = { left: 36, right: W * 0.42, top: 20, bottom: 32 };
    const plotW = W - pad.left - pad.right;
    const plotH = H - pad.top - pad.bottom;
    const xMax = 10, yMax = 9;

    // Axes
    ctx.strokeStyle = 'rgba(255,255,255,0.15)';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(pad.left, pad.top); ctx.lineTo(pad.left, pad.top + plotH);
    ctx.moveTo(pad.left, pad.top + plotH); ctx.lineTo(pad.left + plotW, pad.top + plotH);
    ctx.stroke();

    // Axis labels
    ctx.fillStyle = 'rgba(255,255,255,0.3)';
    ctx.font = '9px monospace';
    ctx.textAlign = 'center';
    ctx.fillText('τ (accept length)', pad.left + plotW / 2, H - 4);
    ctx.save(); ctx.translate(11, pad.top + plotH / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.fillText('speedup', 0, 0);
    ctx.restore();

    // Tick labels
    [2, 4, 6, 8].forEach(v => {
      const x = pad.left + (v / xMax) * plotW;
      ctx.fillStyle = 'rgba(255,255,255,0.2)';
      ctx.textAlign = 'center';
      ctx.font = '8px monospace';
      ctx.fillText(v, x, pad.top + plotH + 10);
    });
    [2, 4, 6, 8].forEach(v => {
      const y = pad.top + plotH - (v / yMax) * plotH;
      ctx.fillStyle = 'rgba(255,255,255,0.2)';
      ctx.textAlign = 'right';
      ctx.fillText(v, pad.left - 3, y + 3);
      ctx.strokeStyle = 'rgba(255,255,255,0.04)';
      ctx.beginPath(); ctx.moveTo(pad.left, y); ctx.lineTo(pad.left + plotW, y); ctx.stroke();
    });

    // Curve for c=0.17 (EAGLE-3)
    ctx.strokeStyle = 'rgba(139,92,246,0.45)';
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    for (let tx = 0.5; tx <= xMax; tx += 0.2) {
      const sv = computeSpeedup(tx, 0.166, GAMMA);
      const px = pad.left + (tx / xMax) * plotW;
      const py = pad.top + plotH - Math.min(sv / yMax, 1) * plotH;
      tx === 0.5 ? ctx.moveTo(px, py) : ctx.lineTo(px, py);
    }
    ctx.stroke();

    // Curve for c=0.023 (DFlash)
    ctx.strokeStyle = 'rgba(6,182,212,0.45)';
    ctx.beginPath();
    for (let tx = 0.5; tx <= xMax; tx += 0.2) {
      const sv = computeSpeedup(tx, 0.023, GAMMA);
      const px = pad.left + (tx / xMax) * plotW;
      const py = pad.top + plotH - Math.min(sv / yMax, 1) * plotH;
      tx === 0.5 ? ctx.moveTo(px, py) : ctx.lineTo(px, py);
    }
    ctx.stroke();

    // Reference dots
    REF.forEach(r => {
      const sv = computeSpeedup(r.tau, r.c, GAMMA);
      const px = pad.left + (r.tau / xMax) * plotW;
      const py = pad.top + plotH - Math.min(sv / yMax, 1) * plotH;
      ctx.fillStyle = r.col;
      ctx.beginPath(); ctx.arc(px, py, 5, 0, Math.PI * 2); ctx.fill();
      ctx.fillStyle = r.col;
      ctx.font = '9px monospace';
      ctx.textAlign = r.tau > 5 ? 'right' : 'left';
      ctx.fillText(r.label, px + (r.tau > 5 ? -8 : 8), py - 6);
    });

    // User cursor dot
    const sx = computeSpeedup(tau, c, GAMMA);
    const px = pad.left + (tau / xMax) * plotW;
    const py = pad.top + plotH - Math.min(sx / yMax, 1) * plotH;
    ctx.strokeStyle = 'rgba(255,255,255,0.7)';
    ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.arc(px, py, 6, 0, Math.PI * 2); ctx.stroke();
  }

  slTau.addEventListener('input', drawFormula);
  slC.addEventListener('input', drawFormula);
  drawFormula();
})();

// ─── §03: Task sensitivity canvas ────────────────────────────────────────
(function() {
  const canvas = document.getElementById('canvas-tasks');
  if (!canvas) return;

  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 260;
  canvas.width = W * DPR; canvas.height = H * DPR;
  const ctx = canvas.getContext('2d');
  ctx.scale(DPR, DPR);

  const tasks  = ['GSM8K', 'Math500', 'AIME25', 'HumanEval', 'MBPP', 'LCB', 'MT-Bench'];
  const data = {
    eagle3: [3.71, 3.49, 3.44, 3.65, 3.25, 3.03, 3.26],
    dflash:  [7.87, 7.08, 6.54, 6.50, 5.95, 4.24, 4.24],
  };

  let currentMethod = 'eagle3';
  let animating = false;
  let curVals = [...data.eagle3];
  let targetVals = [...data.eagle3];
  let animStart = 0;
  const ANIM_DUR = 500;

  function lerp(a, b, t) { return a + (b - a) * t; }
  function easeOut(t) { return 1 - (1 - t) * (1 - t); }

  function drawTasks(vals) {
    ctx.clearRect(0, 0, W, H);
    const maxV = 9;
    const pad = { left: 90, right: 50, top: 20, bottom: 30 };
    const chartW = W - pad.left - pad.right;
    const chartH = H - pad.top - pad.bottom;
    const rowH = chartH / tasks.length;
    const col = currentMethod === 'eagle3' ? 'rgba(139,92,246,' : 'rgba(6,182,212,';

    // grid
    [2, 4, 6, 8].forEach(v => {
      const x = pad.left + (v / maxV) * chartW;
      ctx.strokeStyle = 'rgba(255,255,255,0.04)';
      ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(x, pad.top); ctx.lineTo(x, H - pad.bottom); ctx.stroke();
      ctx.fillStyle = 'rgba(255,255,255,0.25)';
      ctx.font = '9px monospace';
      ctx.textAlign = 'center';
      ctx.fillText('τ=' + v, x, H - pad.bottom + 12);
    });

    tasks.forEach((t, i) => {
      const v = vals[i];
      const y = pad.top + i * rowH;
      const midY = y + rowH / 2;
      const barW = (v / maxV) * chartW;

      // task label
      ctx.fillStyle = 'rgba(255,255,255,0.55)';
      ctx.font = '10px monospace';
      ctx.textAlign = 'right';
      ctx.fillText(t, pad.left - 8, midY + 4);

      // bar
      ctx.fillStyle = col + '0.25)';
      ctx.fillRect(pad.left, y + rowH * 0.2, barW, rowH * 0.6);
      ctx.fillStyle = col + '1)';
      const bx = pad.left + barW;
      ctx.fillRect(bx - 2, y + rowH * 0.2, 2, rowH * 0.6);

      // value label
      ctx.fillStyle = col + '0.9)';
      ctx.font = 'bold 10px monospace';
      ctx.textAlign = 'left';
      ctx.fillText(v.toFixed(2), bx + 4, midY + 4);
    });

    // x-axis label
    ctx.fillStyle = 'rgba(255,255,255,0.3)';
    ctx.font = '9px monospace';
    ctx.textAlign = 'center';
    ctx.fillText('mean accept length τ  ▶', W / 2, H - 4);
  }

  function animate(ts) {
    const t = Math.min((ts - animStart) / ANIM_DUR, 1);
    const e = easeOut(t);
    const displayed = curVals.map((v, i) => lerp(v, targetVals[i], e));
    drawTasks(displayed);
    if (t < 1) requestAnimationFrame(animate);
    else curVals = [...targetVals];
  }

  function switchMethod(m) {
    if (m === currentMethod) return;
    currentMethod = m;
    targetVals = [...data[m]];
    animStart = performance.now();
    animating = true;
    requestAnimationFrame(animate);
    document.querySelectorAll('.task-btn').forEach(b =>
      b.classList.toggle('active', b.dataset.method === m));
  }

  document.querySelectorAll('.task-btn').forEach(b =>
    b.addEventListener('click', () => switchMethod(b.dataset.method)));

  drawTasks(curVals);
})();

// ─── §04: Batch size canvas ───────────────────────────────────────────────
(function() {
  const canvas = document.getElementById('canvas-batch');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 240;
  canvas.width = W * DPR; canvas.height = H * DPR;
  const ctx = canvas.getContext('2d');
  ctx.scale(DPR, DPR);

  // Approximate values based on EAGLE-3 paper data
  // batch=1 latency speedup; batch=64 throughput ratio
  const batches = [1, 4, 16, 64];
  const bxPos   = [0, 1, 2, 3];

  const methods = [
    { label: 'Autoregressive', vals: [1.00, 1.00, 1.00, 1.00], col: 'rgba(107,114,128,0.7)' },
    { label: 'EAGLE',          vals: [3.07, 2.20, 1.40, 0.99], col: 'rgba(245,158,11,0.8)' },
    { label: 'EAGLE-3',        vals: [5.58, 3.80, 2.20, 1.38], col: 'rgba(139,92,246,0.9)' },
  ];

  const pad = { left: 48, right: 16, top: 20, bottom: 50 };
  const plotW = W - pad.left - pad.right;
  const plotH = H - pad.top - pad.bottom;
  const yMax = 7, yMin = 0.5;
  const n = batches.length;

  ctx.clearRect(0, 0, W, H);

  // grid
  [1, 2, 3, 4, 5, 6].forEach(v => {
    const y = pad.top + plotH - ((v - yMin) / (yMax - yMin)) * plotH;
    ctx.strokeStyle = v === 1 ? 'rgba(255,255,255,0.15)' : 'rgba(255,255,255,0.04)';
    ctx.lineWidth = v === 1 ? 1.5 : 1;
    ctx.setLineDash(v === 1 ? [4, 4] : []);
    ctx.beginPath(); ctx.moveTo(pad.left, y); ctx.lineTo(pad.left + plotW, y); ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle = 'rgba(255,255,255,0.3)';
    ctx.font = '9px monospace';
    ctx.textAlign = 'right';
    ctx.fillText(v + '×', pad.left - 4, y + 3);
  });

  // x-axis ticks
  batches.forEach((b, i) => {
    const x = pad.left + (i / (n - 1)) * plotW;
    ctx.fillStyle = 'rgba(255,255,255,0.4)';
    ctx.font = '9px monospace';
    ctx.textAlign = 'center';
    ctx.fillText('batch=' + b, x, H - pad.bottom + 14);
    ctx.strokeStyle = 'rgba(255,255,255,0.1)';
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(x, pad.top); ctx.lineTo(x, pad.top + plotH); ctx.stroke();
  });

  // Lines
  methods.forEach(m => {
    ctx.strokeStyle = m.col;
    ctx.lineWidth = 2;
    ctx.beginPath();
    m.vals.forEach((v, i) => {
      const x = pad.left + (i / (n - 1)) * plotW;
      const y = pad.top + plotH - ((v - yMin) / (yMax - yMin)) * plotH;
      i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
    });
    ctx.stroke();

    // Dots + labels
    m.vals.forEach((v, i) => {
      const x = pad.left + (i / (n - 1)) * plotW;
      const y = pad.top + plotH - ((v - yMin) / (yMax - yMin)) * plotH;
      ctx.fillStyle = m.col;
      ctx.beginPath(); ctx.arc(x, y, 4, 0, Math.PI * 2); ctx.fill();
      if (i === n - 1) {
        ctx.fillStyle = m.col;
        ctx.font = 'bold 9px monospace';
        ctx.textAlign = 'left';
        ctx.fillText(m.label, x + 6, y + 3);
      }
      // Annotate EAGLE at batch=64
      if (m.label === 'EAGLE' && i === 3) {
        ctx.fillStyle = 'rgba(245,158,11,0.9)';
        ctx.font = 'bold 9px monospace';
        ctx.textAlign = 'right';
        ctx.fillText('0.99× ⚠', x - 6, y - 8);
      }
    });
  });

  // X axis label
  ctx.fillStyle = 'rgba(255,255,255,0.3)';
  ctx.font = '9px monospace';
  ctx.textAlign = 'center';
  ctx.fillText('batch size  ▶  (1 = latency,  64 = throughput)', W / 2, H - pad.bottom + 30);
  ctx.fillStyle = 'rgba(255,255,255,0.3)';
  ctx.font = '9px monospace';
  ctx.textAlign = 'left';
  ctx.fillText('1.0× baseline', pad.left + 4, pad.top + plotH - ((1.0 - yMin) / (yMax - yMin)) * plotH - 5);
})();

// ─── §05: Draft cost canvas ───────────────────────────────────────────────
(function() {
  const canvas = document.getElementById('canvas-cost');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 220;
  canvas.width = W * DPR; canvas.height = H * DPR;
  const ctx = canvas.getContext('2d');
  ctx.scale(DPR, DPR);

  const methods = [
    { label: 'EAGLE-3', verify: 35.5, draft: 5.9,  tau: 3.5, col_d: 'rgba(139,92,246,0.85)' },
    { label: 'DFlash',  verify: 35.5, draft: 0.8,  tau: 7.9, col_d: 'rgba(6,182,212,0.85)' },
    { label: 'Domino',  verify: 35.5, draft: 1.2,  tau: 4.7, col_d: 'rgba(16,185,129,0.85)' },
  ];

  const pad = { left: 78, right: 140, top: 24, bottom: 28 };
  const plotW = W - pad.left - pad.right;
  const plotH = H - pad.top - pad.bottom;
  const rowH = plotH / methods.length;
  const maxTotal = 45;

  ctx.clearRect(0, 0, W, H);

  // x ticks
  [10, 20, 30, 40].forEach(v => {
    const x = pad.left + (v / maxTotal) * plotW;
    ctx.strokeStyle = 'rgba(255,255,255,0.05)';
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(x, pad.top); ctx.lineTo(x, H - pad.bottom); ctx.stroke();
    ctx.fillStyle = 'rgba(255,255,255,0.25)';
    ctx.font = '9px monospace';
    ctx.textAlign = 'center';
    ctx.fillText(v + 'ms', x, H - pad.bottom + 11);
  });

  methods.forEach((m, i) => {
    const y = pad.top + i * rowH;
    const midY = y + rowH / 2;

    // method label
    ctx.fillStyle = 'rgba(255,255,255,0.6)';
    ctx.font = '10px monospace';
    ctx.textAlign = 'right';
    ctx.fillText(m.label, pad.left - 8, midY + 4);

    const verW = (m.verify / maxTotal) * plotW;
    const drW  = (m.draft  / maxTotal) * plotW;
    const bh   = rowH * 0.55;
    const by   = y + rowH * 0.225;

    // verify bar (gray)
    ctx.fillStyle = 'rgba(107,114,128,0.4)';
    ctx.fillRect(pad.left, by, verW, bh);

    // draft bar (colored)
    ctx.fillStyle = m.col_d;
    ctx.fillRect(pad.left + verW, by, drW, bh);

    // annotations
    const totalW = verW + drW;
    ctx.fillStyle = 'rgba(255,255,255,0.35)';
    ctx.font = '8px monospace';
    ctx.textAlign = 'center';
    ctx.fillText('verify ' + m.verify + 'ms', pad.left + verW / 2, midY + 4);

    ctx.fillStyle = m.col_d;
    ctx.font = '8px monospace';
    ctx.textAlign = drW > 20 ? 'center' : 'left';
    const drX = pad.left + verW + (drW > 20 ? drW / 2 : drW + 3);
    ctx.fillText(m.draft + 'ms', drX, midY + 4);

    // Right side: τ and speedup
    const rx = pad.left + plotW + 12;
    ctx.fillStyle = 'rgba(255,255,255,0.5)';
    ctx.font = '9px monospace';
    ctx.textAlign = 'left';
    ctx.fillText('τ=' + m.tau, rx, midY - 4);
    const sp = (m.tau / (1 + 16 * (m.draft / m.verify))).toFixed(1);
    ctx.fillStyle = m.col_d;
    ctx.font = 'bold 10px monospace';
    ctx.fillText('~' + sp + '×', rx, midY + 10);
  });

  // Legend
  ctx.fillStyle = 'rgba(107,114,128,0.5)';
  ctx.fillRect(pad.left, H - pad.bottom + 6, 18, 6);
  ctx.fillStyle = 'rgba(255,255,255,0.3)';
  ctx.font = '9px monospace';
  ctx.textAlign = 'left';
  ctx.fillText('verify (fixed)', pad.left + 22, H - pad.bottom + 13);
  ctx.fillStyle = 'rgba(139,92,246,0.7)';
  ctx.fillRect(pad.left + 110, H - pad.bottom + 6, 18, 6);
  ctx.fillStyle = 'rgba(255,255,255,0.3)';
  ctx.fillText('draft (varies)', pad.left + 132, H - pad.bottom + 13);
})();

// ─── §06: Step navigator ─────────────────────────────────────────────────
(function() {
  let step = 0;
  const boxes   = document.querySelectorAll('.step-box');
  const prevBtn = document.getElementById('step-prev');
  const nextBtn = document.getElementById('step-next');
  const progEl  = document.getElementById('step-prog');

  function updateSteps() {
    boxes.forEach((b, i) => {
      b.classList.remove('active', 'done');
      if (i === step) b.classList.add('active');
      else if (i < step) b.classList.add('done');
    });
    if (prevBtn) prevBtn.disabled = step === 0;
    if (nextBtn) nextBtn.disabled = step === boxes.length - 1;
    if (progEl) progEl.textContent = `Step ${step+1} of ${boxes.length}`;
    boxes.forEach((b, i) => {
      const n = b.querySelector('.step-num');
      if (n) n.textContent = i < step ? '✓' : String(i+1);
    });
  }

  prevBtn?.addEventListener('click', () => { if (step > 0) { step--; updateSteps(); } });
  nextBtn?.addEventListener('click', () => { if (step < boxes.length-1) { step++; updateSteps(); } });
  updateSteps();
})();
</script>
</BaseLayout>

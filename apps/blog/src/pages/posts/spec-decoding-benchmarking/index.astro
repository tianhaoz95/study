    <!-- cost panel -->
    <div class="cs-panel" id="panel-cost">
      <pre class="cs-pre">
<span class="cs-line cmt"># Profiling draft vs verify latency</span>
<span class="cs-line cmt"># Run this to compute c for any method.</span>
<span class="cs-line"></span>
<span class="cs-line kw">import</span> torch, time</span>
<span class="cs-line"></span>
<span class="cs-line kw">def</span> <span class="fn">profile_verify</span>(target_model, input_ids, n=200):</span>
<span class="cs-line">    <span class="str">"""Time one target forward pass (with draft tree)."""</span></span>
<span class="cs-line">    torch.<span class="fn">cuda.synchronize</span>()</span>
<span class="cs-line">    t0 = time.<span class="fn">perf_counter</span>()</span>
<span class="cs-line">    <span class="kw">for</span> _ <span class="kw">in</span> <span class="fn">range</span>(n):</span>
<span class="cs-line">        <span class="kw">with</span> torch.no_grad():</span>
<span class="cs-line">            target_model(input_ids)</span>
<span class="cs-line">    torch.<span class="fn">cuda.synchronize</span>()</span>
<span class="cs-line">    <span class="kw">return</span> (time.<span class="fn">perf_counter</span>() - t0) / n * 1000  <span class="cmt"># ms</span></span>
<span class="cs-line"></span>
<span class="cs-line kw">def</span> <span class="fn">profile_draft</span>(draft_model, features, gamma, n=200):</span>
<span class="cs-line">    <span class="str">"""Time one complete drafting phase (γ tokens)."""</span></span>
<span class="cs-line">    torch.<span class="fn">cuda.synchronize</span>()</span>
<span class="cs-line">    t0 = time.<span class="fn">perf_counter</span>()</span>
<span class="cs-line">    <span class="kw">for</span> _ <span class="kw">in</span> <span class="fn">range</span>(n):</span>
<span class="cs-line">        draft_model.<span class="fn">draft</span>(features, gamma=gamma)</span>
<span class="cs-line">    torch.<span class="fn">cuda.synchronize</span>()</span>
<span class="cs-line">    <span class="kw">return</span> (time.<span class="fn">perf_counter</span>() - t0) / n * 1000  <span class="cmt"># ms</span></span>
<span class="cs-line"></span>
<span class="cs-line hl-p">T_verify = <span class="fn">profile_verify</span>(target, ids)  <span class="cmt"># e.g. 35.5ms</span></span>
<span class="cs-line hl-p">T_draft  = <span class="fn">profile_draft</span>(draft, feats, gamma=16)</span>
<span class="cs-line hl-p">c = T_draft / T_verify</span>
<span class="cs-line hl-p"><span class="fn">print</span>(<span class="fn">f</span><span class="str">"c = &#123;c:.3f&#125;"</span>)  <span class="cmt"># EAGLE-3: 0.166, DFlash: 0.023</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Empirical values (Domino 2026, A100, Qwen3-8B)</span>
<span class="cs-line cmt"># EAGLE-3 → T_verify=35.5ms, T_draft=5.9ms, c=0.166</span>
<span class="cs-line cmt"># DFlash   → T_verify=35.5ms, T_draft=0.8ms, c=0.023</span>
<span class="cs-line cmt"># Domino   → T_verify=35.5ms, T_draft=1.2ms, c=0.034</span>
      </pre>
    </div>


<span class="cs-line cmt"># Stage 1: Text VAE objective</span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">stage1_loss</span>(x, vae):</span>
<span class="cs-line hl-p">    z0 = vae.encode(x)          <span class="cmt"># q_phi(z0|x)</span></span>
<span class="cs-line">    recon = vae.decode(z0, x)  <span class="cmt"># p_theta(x|z0)</span></span>
<span class="cs-line">    L_recon = cross_entropy(recon, x)</span>
<span class="cs-line">    L_kl    = kl_divergence(z0, N(0,I))</span>
<span class="cs-line">    L_mask  = bert_mask_loss(z0, x)   <span class="cmt"># key!</span></span>
<span class="cs-line">    <span class="kw">return</span> L_recon + beta*L_kl + lam*L_mask</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Stage 2: joint VAE + DiT objective</span>
<span class="cs-line hl-c"><span class="kw">def</span> <span class="fn">stage2_loss</span>(x, vae, dit, vae_ref):</span>
<span class="cs-line hl-c">    z0 = vae.encode(x)          <span class="cmt"># trainable</span></span>
<span class="cs-line">    z0_ref = vae_ref.encode(x) <span class="cmt"># frozen ref</span></span>
<span class="cs-line">    L_vae  = stage1_loss(x, vae)</span>
<span class="cs-line cmt">    # flow matching on latent blocks</span>
<span class="cs-line">    t, z1  = sample_time(), sample_noise()</span>
<span class="cs-line">    zt     = (1-t)*z0 + t*z1</span>
<span class="cs-line">    L_fm   = mse(dit(zt, t, z0_prev), z0-z1)</span>
<span class="cs-line cmt">    # reference regularizer prevents latent drift</span>
<span class="cs-line">    L_ref  = kl(vae.encode(x), z0_ref)</span>
<span class="cs-line">    <span class="kw">return</span> L_vae + lam_fm*L_fm + lam_ref*L_ref</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Block-causal attention mask</span>
<span class="cs-line hl-g"><span class="kw">def</span> <span class="fn">block_causal_mask</span>(n_blocks, bs):</span>
<span class="cs-line hl-g">    <span class="cmt"># bidirectional within block</span></span>
<span class="cs-line hl-g">    <span class="cmt"># causal across blocks</span></span>
<span class="cs-line">    <span class="kw">return</span> causal_block_mask(n_blocks*bs, bs)</span>

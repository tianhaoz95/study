<span class="cs-line cmt"># Inference algorithm</span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">cola_inference</span>(prompt, model, steps=16, cfg=7):</span>
<span class="cs-line">    z_pre = model.vae_enc(prompt)</span>
<span class="cs-line">    z_hat = []</span>
<span class="cs-line">    <span class="kw">for</span> b <span class="kw">in</span> range(n_blocks):</span>
<span class="cs-line cmt">        # sample noise seed</span>
<span class="cs-line hl-c">        zt = torch.randn(block_size, d)</span>
<span class="cs-line cmt">        # flow ODE (block-causal DiT)</span>
<span class="cs-line">        <span class="kw">for</span> t <span class="kw">in</span> linspace(1, 0, steps):</span>

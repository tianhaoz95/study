---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Cola DLM: Continuous Latent Diffusion Language Model | AI/ML Deep Dives"
  description="Cola DLM separates text generation into global semantic organization (latent diffusion) and local token realization (conditional decoder), beating AR and discrete DLMs at scale."
  crumb="Cola DLM"
>


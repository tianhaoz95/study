<span class="cs-line hl-c"><span class="fn">p_Plaid</span>(x) = <span class="fn">p</span>(h_T) prod_t <span class="fn">p_theta</span>(h_t-1 | h_t)</span>
<span class="cs-line cmt"># h_t = noisy version of E(x) -- obs recovery</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Cola DLM: latent prior + conditional decoder</span>
<span class="cs-line hl-p"><span class="fn">p_Cola</span>(x) = integral <span class="fn">p_theta</span>(x|z_0) <span class="fn">p_psi</span>(z_0) dz_0</span>
<span class="cs-line cmt"># z_0 is a learned compressed latent -- NOT</span>
<span class="cs-line cmt"># token-aligned. Diffusion only transports</span>
<span class="cs-line cmt"># Gaussian noise to latent prior q_phi(z_0)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Key: "prior transport" vs "obs recovery"</span>
<span class="cs-line hl-g">z_1 ~ N(0,I) ->  z_0 = Phi_psi(z_1) -> x ~ p_theta(x|z_0)</span>
<span class="cs-line cmt"># decoder decides tokens; flow decides semantics</span>

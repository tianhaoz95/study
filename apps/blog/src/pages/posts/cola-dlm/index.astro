      if (el) el.style.opacity = '1';
    });
    var zdec = document.getElementById('a-arr-z-dec');
    var ddec = document.getElementById('a-arr-dit-dec');
    if (zdec) zdec.style.display = 'none';
    if (ddec) ddec.style.display = '';
    if (lbl) lbl.textContent = 'Inference: encode prefix -> block-causal DiT ODE -> decode tokens';
  }
};
window._showArchStage(1);

/* Latent strategy line chart */
(function() {
  var canvas = document.getElementById('latent-canvas');
  if (!canvas) return;
  var DPR = window.devicePixelRatio || 1;

  var strategies = {
    joint:    { label: 'Joint DiT x1', color: '#8b5cf6', data: [12.0,14.2,17.1,20.3,24.0,27.2,30.1,32.5] },
    fix:      { label: 'Fix VAE',      color: '#f59e0b', data: [11.2,13.5,15.8,17.9,20.6,22.1,23.8,25.4] },
    interval: { label: 'Interval',     color: '#06b6d4', data: [8.1,10.0,11.9,14.1,16.3,17.9,19.4,21.2]  },
    scratch:  { label: 'All Scratch',  color: '#ef4444', data: [7.2,8.9,10.8,12.2,13.9,15.3,17.1,19.0]   },
  };
  var xLabels = [117,156,195,234,272,311,350,389];
  var activeStrat = 'all';
  var MAX_Y = 35;

  function setup() {
    canvas.width  = Math.round(canvas.clientWidth  * DPR);
    canvas.height = Math.round(canvas.clientHeight * DPR);
    drawChart();
  }

  function drawChart() {
    var ctx = canvas.getContext('2d');
    ctx.setTransform(1,0,0,1,0,0);
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.scale(DPR, DPR);

    var W = canvas.width / DPR, H = canvas.height / DPR;
    var PAD = { l:44, r:16, t:16, b:36 };
    var cW = W - PAD.l - PAD.r, cH = H - PAD.t - PAD.b;

    /* grid lines + y-axis labels */
    ctx.strokeStyle = 'rgba(255,255,255,0.05)';
    ctx.lineWidth = 1;
    [0,5,10,15,20,25,30,35].forEach(function(v) {
      var y = PAD.t + cH * (1 - v / MAX_Y);
      ctx.beginPath(); ctx.moveTo(PAD.l, y); ctx.lineTo(PAD.l + cW, y); ctx.stroke();
      ctx.fillStyle = '#4b5563';
      ctx.font = (9 * DPR) + 'px var(--ff-mono)';
      ctx.textAlign = 'right';
      ctx.fillText(v + '%', PAD.l - 4, y + 3.5);
    });

    /* x-axis labels */
    ctx.fillStyle = '#4b5563';
    ctx.textAlign = 'center';
    ctx.font = (8 * DPR) + 'px var(--ff-mono)';
    xLabels.forEach(function(v, i) {
      var x = PAD.l + (i / (xLabels.length - 1)) * cW;
      ctx.fillText(v, x, H - PAD.b + 14);
    });

    /* axis title */
    ctx.fillStyle = '#374151';
    ctx.textAlign = 'center';
    ctx.font = (8 * DPR) + 'px var(--ff-mono)';
    ctx.fillText('EFLOPs', W / 2, H - 2);
    ctx.save();
    ctx.translate(10, H / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.fillStyle = '#374151';
    ctx.textAlign = 'center';
    ctx.fillText('Task Avg %', 0, 0);
    ctx.restore();

    /* strategy curves */
    Object.keys(strategies).forEach(function(key) {
      var s = strategies[key];
      var dim = (activeStrat !== 'all' && activeStrat !== key);
      ctx.globalAlpha = dim ? 0.12 : 1;
      ctx.strokeStyle = s.color;
      ctx.lineWidth = (key === 'joint' && !dim) ? 2.5 : 1.8;
      ctx.setLineDash(key === 'joint' ? [] : [4, 3]);
      ctx.beginPath();
      s.data.forEach(function(v, i) {
        var x = PAD.l + (i / (xLabels.length - 1)) * cW;
        var y = PAD.t + cH * (1 - v / MAX_Y);
        if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
      });
      ctx.stroke();
      ctx.setLineDash([]);

      /* endpoint dot */
      var lv = s.data[s.data.length - 1];
      var lx = PAD.l + cW;
      var ly = PAD.t + cH * (1 - lv / MAX_Y);
      ctx.beginPath();
      ctx.arc(lx, ly, dim ? 2 : 3.5, 0, Math.PI * 2);
      ctx.fillStyle = s.color;
      ctx.fill();
      ctx.globalAlpha = 1;
    });

    /* legend */
    var legY = PAD.t + 6;
    Object.keys(strategies).forEach(function(key, i) {
      var s = strategies[key];
      var dim = (activeStrat !== 'all' && activeStrat !== key);
      ctx.globalAlpha = dim ? 0.25 : 1;
      var lx = PAD.l + 8 + i * 110;
      ctx.fillStyle = s.color;
      ctx.fillRect(lx, legY - 5, 16, 3);
      ctx.fillStyle = '#9ca3af';
      ctx.font = (8 * DPR) + 'px var(--ff-mono)';
      ctx.textAlign = 'left';
      ctx.fillText(s.label, lx + 20, legY - 1);
      ctx.globalAlpha = 1;
    });
  }

  /* strategy button wiring */
  document.querySelectorAll('[data-strat]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.querySelectorAll('[data-strat]').forEach(function(b) {
        b.classList.remove('active');
      });
      btn.classList.add('active');
      activeStrat = btn.dataset.strat;
      drawChart();
    });
  });

  window.addEventListener('resize', setup);
  setup();
})();

/* Denoising steps interactive bar chart */
(function() {
  var stepsData = {
    1:   { LAMBADA:15, MMLU:4,  SIQA:8,  SQuAD:12, TaskAvg:10 },
    2:   { LAMBADA:22, MMLU:6,  SIQA:12, SQuAD:18, TaskAvg:14 },
    4:   { LAMBADA:38, MMLU:8,  SIQA:17, SQuAD:30, TaskAvg:22 },
    8:   { LAMBADA:47, MMLU:9,  SIQA:20, SQuAD:38, TaskAvg:27 },
    10:  { LAMBADA:50, MMLU:10, SIQA:21, SQuAD:41, TaskAvg:29 },
    16:  { LAMBADA:53, MMLU:11, SIQA:22, SQuAD:43, TaskAvg:32 },
    32:  { LAMBADA:54, MMLU:11, SIQA:22, SQuAD:43.3, TaskAvg:32.5 },
    64:  { LAMBADA:54.2, MMLU:11, SIQA:22, SQuAD:43.5, TaskAvg:32.7 },
    128: { LAMBADA:54.5, MMLU:11, SIQA:22, SQuAD:43.6, TaskAvg:32.7 },
  };
  var stepKeys = [1,2,4,8,10,16,32,64,128];
  var taskColors = {
    LAMBADA:'#8b5cf6', MMLU:'#06b6d4', SIQA:'#10b981', SQuAD:'#f59e0b', TaskAvg:'#f87171'
  };
  var curStep = 16;

  /* build buttons */
  var controls = document.getElementById('step-controls');
  if (!controls) return;
  stepKeys.forEach(function(s) {
    var btn = document.createElement('button');
    btn.className = 'infer-btn' + (s === curStep ? ' active' : '');
    btn.textContent = s;
    btn.addEventListener('click', function() {
      curStep = s;
      document.querySelectorAll('#step-controls .infer-btn').forEach(function(b) {
        b.classList.remove('active');
      });
      btn.classList.add('active');
      drawSteps();
    });
    controls.appendChild(btn);
  });

  var canvas = document.getElementById('steps-canvas');
  if (!canvas) return;
  var DPR = window.devicePixelRatio || 1;

  function setupSteps() {
    canvas.width  = Math.round(canvas.clientWidth  * DPR);
    canvas.height = Math.round(canvas.clientHeight * DPR);
    drawSteps();
  }

  function drawSteps() {
    var ctx = canvas.getContext('2d');
    ctx.setTransform(1,0,0,1,0,0);
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.scale(DPR, DPR);

    var W = canvas.width / DPR, H = canvas.height / DPR;
    var tasks = ['LAMBADA','SQuAD','TaskAvg','SIQA','MMLU'];
    var d = stepsData[curStep];
    var MAX = 60;
    var PAD = { l:68, r:56, t:12, b:26 };
    var cW = W - PAD.l - PAD.r;
    var barH = 24, gap = 8;

    /* vertical grid */
    [0,15,30,45,60].forEach(function(v) {
      var x = PAD.l + (v / MAX) * cW;
      ctx.strokeStyle = 'rgba(255,255,255,0.04)';
      ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(x, PAD.t); ctx.lineTo(x, PAD.t + tasks.length * (barH + gap) - gap); ctx.stroke();
      ctx.fillStyle = '#374151';
      ctx.font = (8 * DPR) + 'px var(--ff-mono)';
      ctx.textAlign = 'center';
      ctx.fillText(v + '%', x, PAD.t + tasks.length * (barH + gap) - gap + 16);
    });

    tasks.forEach(function(task, i) {
      var y = PAD.t + i * (barH + gap);
      var val = d[task];
      var bW = (val / MAX) * cW;

      /* track */
      ctx.fillStyle = 'rgba(255,255,255,0.04)';
      ctx.beginPath();
      if (ctx.roundRect) ctx.roundRect(PAD.l, y, cW, barH, 4);
      else ctx.rect(PAD.l, y, cW, barH);
      ctx.fill();

      /* bar */
      ctx.fillStyle = taskColors[task];
      ctx.globalAlpha = task === 'TaskAvg' ? 1 : 0.72;
      if (bW > 4) {
        ctx.beginPath();
        if (ctx.roundRect) ctx.roundRect(PAD.l, y, bW, barH, 4);
        else ctx.rect(PAD.l, y, bW, barH);
        ctx.fill();
      }
      ctx.globalAlpha = 1;

      /* task label */
      ctx.fillStyle = '#9ca3af';
      ctx.textAlign = 'right';
      ctx.font = (9 * DPR) + 'px var(--ff-mono)';
      ctx.fillText(task, PAD.l - 5, y + barH / 2 + 3.5);

      /* value label */
      ctx.fillStyle = '#e5e7eb';
      ctx.textAlign = 'left';
      ctx.font = 'bold ' + (9 * DPR) + 'px var(--ff-mono)';
      ctx.fillText(val.toFixed(1) + '%', PAD.l + bW + 5, y + barH / 2 + 3.5);
    });

    /* step indicator */
    ctx.fillStyle = '#6b7280';
    ctx.font = (9 * DPR) + 'px var(--ff-mono)';
    ctx.textAlign = 'right';
    ctx.fillText('steps = ' + curStep, W - 4, 11);
  }

  window.addEventListener('resize', setupSteps);
  setupSteps();
})();

/* Inference step navigator */
(function() {
  var step = 0;
  var boxes = document.querySelectorAll('#infer-steps .step-box');
  var prevBtn = document.getElementById('infer-prev');
  var nextBtn = document.getElementById('infer-next');
  var progEl  = document.getElementById('infer-prog');

  function update() {
    boxes.forEach(function(b, i) {
      b.classList.remove('active','done');
      if (i === step) b.classList.add('active');
      else if (i < step) b.classList.add('done');
      var n = b.querySelector('.step-num');
      if (n) n.textContent = i < step ? '✓' : String(i + 1);
    });
    if (prevBtn) prevBtn.disabled = (step === 0);
    if (nextBtn) nextBtn.disabled = (step === boxes.length - 1);
    if (progEl)  progEl.textContent = 'Step ' + (step + 1) + ' of ' + boxes.length;
  }
  prevBtn && prevBtn.addEventListener('click', function() { if (step > 0) { step--; update(); } });
  nextBtn && nextBtn.addEventListener('click', function() { if (step < boxes.length - 1) { step++; update(); } });
  update();
})();

/* Animated bar chart (scaling results) */
(function() {
  var section = document.getElementById('s-results');
  if (!section) return;
  new IntersectionObserver(function(entries) {
    entries.forEach(function(e) {
      if (e.isIntersecting) {
        document.querySelectorAll('#scaling-bars .bar-fill[data-w]').forEach(function(b) {
          b.style.width = b.dataset.w + '%';
        });
      }
    });
  }, { threshold: 0.2 }).observe(section);
})();
</script>

<span class="cs-line cmt"># mtp_memory_scaling.py</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Vanilla MTP: N separate layers</span>
<span class="cs-line cmt"># for N speculative steps</span>
<span class="cs-line hl-a">class VanillaMTP(nn.Module):</span>
<span class="cs-line hl-a">  <span class="kw">def</span> __init__(self, N, d):</span>
<span class="cs-line hl-a">    self.layers = nn.ModuleList(</span>
<span class="cs-line hl-a">      [TransformerBlock(d) <span class="kw">for</span> _ <span class="kw">in</span> range(N)]</span>
<span class="cs-line hl-a">    )  <span class="cmt"># memory ∝ N × layer_size</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt">  <span class="kw">def</span> forward(self, h):</span>
<span class="cs-line">    preds = []</span>
<span class="cs-line">    <span class="kw">for</span> i, layer <span class="kw">in</span> enumerate(self.layers):</span>
<span class="cs-line">      h = layer(h)  <span class="cmt"># unique weights</span></span>
<span class="cs-line">      preds.append(head(h))</span>
<span class="cs-line">    <span class="kw">return</span> preds</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Memory cost per speculative step:</span>
<span class="cs-line cmt"># N=1: 1× layer   (DeepSeek-V3)</span>
<span class="cs-line cmt"># N=2: 2× layer</span>
<span class="cs-line cmt"># N=3: 3× layer   (vanilla MTP)</span>
<span class="cs-line cmt"># N=4: 4× layer</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># For a 744B model, each MTP</span>
<span class="cs-line cmt"># transformer block ≈ 1-2 GB</span>
      </pre>
    </div>
    <div class="cs-panel" id="panel-sharing">
      <pre class="cs-pre">
<span class="cs-line cmt"># parameter_sharing_mtp.py — GLM-5</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p">class SharedMTP(nn.Module):</span>
<span class="cs-line hl-p">  <span class="kw">def</span> __init__(self, K, d):</span>
<span class="cs-line hl-p">    self.K = K</span>
<span class="cs-line hl-p">    <span class="cmt"># ONE layer shared across all K depths</span></span>
<span class="cs-line hl-p">    self.shared_layer = TransformerBlock(d)</span>
<span class="cs-line hl-p">    self.head = OutputHead(d)  <span class="cmt"># also shared</span></span>
<span class="cs-line"> </span>
<span class="cs-line hl-g">  <span class="kw">def</span> forward(self, h):</span>
<span class="cs-line hl-g">    preds, h_curr = [], h</span>
<span class="cs-line hl-g">    <span class="kw">for</span> depth <span class="kw">in</span> range(self.K):</span>
<span class="cs-line hl-g">      <span class="cmt"># Same weights, different inputs</span></span>
<span class="cs-line hl-g">      h_curr = self.shared_layer(</span>
<span class="cs-line hl-g">        norm(h_curr), emb(preds[-1]))</span>
<span class="cs-line hl-g">      preds.append(self.head(h_curr))</span>
<span class="cs-line hl-g">    <span class="kw">return</span> preds</span>
<span class="cs-line"> </span>
<span class="cs-line cmt">  # Memory = 1× layer (always)</span>
<span class="cs-line cmt">  # Training sees K depths per step</span>
<span class="cs-line cmt">  # → weights learn all K positions</span>
<span class="cs-line cmt">  # → no train-inference gap at depth &gt;1</span>
<span class="cs-line"> </span>
<span class="cs-line cmt">  # GLM-5 uses K=3 → trains at</span>
<span class="cs-line cmt">  # depths &#123;1, 2, 3&#125; simultaneously</span>
<span class="cs-line cmt">  # Inference: speculates steps 4</span>
<span class="cs-line cmt">  # through shared unrolling</span>
      </pre>
    </div>
    <div class="cs-panel" id="panel-compare">
      <pre class="cs-pre">
<span class="cs-line cmt"># approach_comparison.py</span>
<span class="cs-line"> </span>
<span class="cs-line cmt">## Accept length τ (higher = faster)</span>
<span class="cs-line cmt">## measured at temp=0 on private set</span>
<span class="cs-line"> </span>
<span class="cs-line cmt">EAGLE_3  = &#123;</span>

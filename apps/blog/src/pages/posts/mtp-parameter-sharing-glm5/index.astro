<script>
// ── TOC + sidebar toggles ──────────────────────────────────
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});

const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ── Tab switching ──────────────────────────────────────────
const tabMeta = {
  spec:    { file: 'glm5/speculative_decode.py',   title: 'Speculative Decoding Loop' },
  three:   { file: 'glm5/draft_approaches.py',     title: 'Three Drafting Approaches' },
  memory:  { file: 'glm5/mtp_memory.py',           title: 'MTP Memory Scaling' },
  sharing: { file: 'glm5/parameter_sharing_mtp.py',title: 'Parameter Sharing' },
  compare: { file: 'glm5/comparison.py',           title: 'Comparative Landscape' },
  results: { file: 'glm5/inference_results.py',    title: 'Results' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ── IntersectionObserver: sync TOC + sidebar tab ───────────
const sectionMap = {
  's-spec':    'spec',
  's-three':   'three',
  's-memory':  'memory',
  's-sharing': 'sharing',
  's-compare': 'compare',
  's-results': 'results',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ── Step navigator (§01) ───────────────────────────────────
let specStep = 0;
const specBoxes = document.querySelectorAll('#spec-steps .step-box');
const specPrev  = document.getElementById('spec-prev');
const specNext  = document.getElementById('spec-next');
const specProg  = document.getElementById('spec-prog');
function updateSpecSteps() {
  specBoxes.forEach((b, i) => {
    b.classList.remove('active', 'done');
    if (i === specStep) b.classList.add('active');
    else if (i < specStep) b.classList.add('done');
  });
  specPrev.disabled = specStep === 0;
  specNext.disabled = specStep === specBoxes.length - 1;
  specProg.textContent = 'Step ' + (specStep + 1) + ' of ' + specBoxes.length;
  specBoxes.forEach((b, i) => {
    const n = b.querySelector('.step-num');
    if (n) n.textContent = i < specStep ? '✓' : String(i + 1);
  });
}
specPrev?.addEventListener('click', () => { if (specStep > 0) { specStep--; updateSpecSteps(); } });
specNext?.addEventListener('click', () => { if (specStep < specBoxes.length - 1) { specStep++; updateSpecSteps(); } });
specBoxes.forEach((b, i) => b.addEventListener('click', () => { specStep = i; updateSpecSteps(); }));
updateSpecSteps();

// ── Memory scaling canvas (§03) ───────────────────────────
(function() {
  const canvas = document.getElementById('memory-canvas');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  function resize() {
    canvas.width  = canvas.clientWidth  * DPR;
    canvas.height = canvas.clientHeight * DPR;
    draw();
  }
  function draw() {
    const ctx = canvas.getContext('2d');
    const W = canvas.width / DPR, H = canvas.height / DPR;
    ctx.scale(DPR, DPR);
    ctx.clearRect(0, 0, W, H);

    const methods = [
      { label: 'K=1', subLabel: 'DeepSeek-V3\n(separate)', layers: 1, color: '#6b7280' },
      { label: 'K=2', subLabel: 'K=2 separate', layers: 2, color: '#6b7280' },
      { label: 'K=3', subLabel: 'K=3 separate\n(vanilla MTP)', layers: 3, color: '#6b7280' },
      { label: 'K=4', subLabel: 'K=4 separate', layers: 4, color: '#6b7280' },
      { label: 'K=1\n(shared)', subLabel: 'GLM-5 style,\nshared weights', layers: 1, color: '#8b5cf6', highlight: true },
      { label: 'K=2\n(shared)', subLabel: 'K=2, shared\nweights', layers: 1, color: '#8b5cf6', highlight: true },
      { label: 'K=3\n(shared)', subLabel: 'GLM-5 K=3,\nsame as K=1!', layers: 1, color: '#8b5cf6', highlight: true },
    ];

    const maxLayers = 4;
    const barW = Math.min(60, (W - 80) / methods.length - 8);
    const startX = 48;
    const chartH = H - 60;
    const unitH = chartH / (maxLayers + 0.5);

    // Grid lines
    ctx.strokeStyle = 'rgba(255,255,255,0.05)';
    ctx.lineWidth = 1;
    for (let i = 1; i <= maxLayers; i++) {
      const y = H - 35 - i * unitH;
      ctx.beginPath(); ctx.moveTo(40, y); ctx.lineTo(W - 10, y); ctx.stroke();
    }

    // Y-axis label
    ctx.save();
    ctx.translate(12, (H - 35) / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.fillStyle = 'rgba(107,114,128,0.8)';
    ctx.font = '11px monospace';
    ctx.textAlign = 'center';
    ctx.fillText('MTP layer memory', 0, 0);
    ctx.restore();

    // Y-axis ticks
    ctx.fillStyle = 'rgba(107,114,128,0.6)';
    ctx.font = '10px monospace';
    ctx.textAlign = 'right';
    for (let i = 1; i <= maxLayers; i++) {
      const y = H - 35 - i * unitH;
      ctx.fillText(i + '×', 36, y + 4);
    }

    // Bars
    methods.forEach((m, idx) => {
      const x = startX + idx * (barW + 8);
      const barH = m.layers * unitH;
      const y = H - 35 - barH;

      // Bar fill
      const alpha = m.highlight ? 0.85 : 0.45;
      ctx.fillStyle = m.highlight ? 'rgba(139,92,246,' + alpha + ')' : 'rgba(107,114,128,' + alpha + ')';
      ctx.beginPath();
      ctx.roundRect(x, y, barW, barH, [3, 3, 0, 0]);
      ctx.fill();

      // Label on top
      ctx.fillStyle = m.highlight ? '#a78bfa' : '#9ca3af';
      ctx.font = 'bold 10px monospace';
      ctx.textAlign = 'center';
      ctx.fillText(m.label.split('\n')[0], x + barW / 2, y - 10);
      if (m.label.includes('\n')) {
        ctx.font = '9px monospace';
        ctx.fillStyle = m.highlight ? '#8b5cf6' : '#6b7280';
        ctx.fillText(m.label.split('\n')[1], x + barW / 2, y - 0);
      }

      // Sublabel below
      ctx.fillStyle = 'rgba(107,114,128,0.6)';
      ctx.font = '9px monospace';
      const lines = m.subLabel.split('\n');
      lines.forEach((line, li) => ctx.fillText(line, x + barW / 2, H - 22 + li * 10));
    });

    // Separator line between separate and shared
    ctx.strokeStyle = 'rgba(255,255,255,0.12)';
    ctx.setLineDash([4, 4]);
    ctx.lineWidth = 1;
    const sepX = startX + 4 * (barW + 8) - 6;
    ctx.beginPath(); ctx.moveTo(sepX, 12); ctx.lineTo(sepX, H - 40); ctx.stroke();
    ctx.setLineDash([]);

    // Labels above separator
    ctx.fillStyle = 'rgba(107,114,128,0.7)';
    ctx.font = '10px monospace';
    ctx.textAlign = 'center';
    ctx.fillText('Separate weights', startX + 2 * (barW + 8), 18);
    ctx.fillStyle = 'rgba(139,92,246,0.8)';
    ctx.fillText('Shared weights (GLM-5)', startX + 5 * (barW + 8) + barW / 2, 18);
  }

  new ResizeObserver(resize).observe(canvas);
  setTimeout(resize, 50);
})();

// ── Acceptance rate canvas (§04) ──────────────────────────
(function() {
  const canvas = document.getElementById('accept-canvas');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  let currentK = 1;

  // Acceptance rates by depth for each K configuration
  // Depth 0 = position t+1 (always predicted by main model, not MTP)
  // MTP predicts t+2, t+3, t+4 = depths 1, 2, 3
  const acceptData = {
    1: {  // K=1: only trained at depth 1
      bars: [
        { label: 'Depth 1 (t+2)', acc: 0.78, trained: true },
        { label: 'Depth 2 (t+3)', acc: 0.51, trained: false },
        { label: 'Depth 3 (t+4)', acc: 0.33, trained: false },
        { label: 'Depth 4 (t+5)', acc: 0.21, trained: false },
      ],
      tau: '~1.85',
      note: 'Only depth 1 was trained — deeper positions improvise'
    },
    2: {  // K=2 shared
      bars: [
        { label: 'Depth 1 (t+2)', acc: 0.79, trained: true },
        { label: 'Depth 2 (t+3)', acc: 0.64, trained: true },
        { label: 'Depth 3 (t+4)', acc: 0.41, trained: false },
        { label: 'Depth 4 (t+5)', acc: 0.26, trained: false },
      ],
      tau: '~2.18',
      note: 'Depths 1 and 2 trained — significant lift at depth 2'
    },
    3: {  // K=3 shared (GLM-5)
      bars: [
        { label: 'Depth 1 (t+2)', acc: 0.80, trained: true },
        { label: 'Depth 2 (t+3)', acc: 0.67, trained: true },
        { label: 'Depth 3 (t+4)', acc: 0.53, trained: true },
        { label: 'Depth 4 (t+5)', acc: 0.28, trained: false },
      ],
      tau: '2.76',
      note: 'GLM-5: depths 1-3 all trained — depth 3 gains ~+20pp'
    }
  };

  function draw(k) {
    const ctx = canvas.getContext('2d');
    const W = canvas.width / DPR, H = canvas.height / DPR;
    ctx.clearRect(0, 0, W, H);

    const data = acceptData[k];
    const bars = data.bars;
    const nBars = bars.length;
    const barW = Math.min(90, (W - 100) / nBars - 16);
    const startX = 60;
    const chartH = H - 70;

    // Grid
    ctx.strokeStyle = 'rgba(255,255,255,0.05)';
    ctx.lineWidth = 1;
    for (let i = 0; i <= 4; i++) {
      const y = H - 50 - (i / 4) * chartH;
      ctx.beginPath(); ctx.moveTo(50, y); ctx.lineTo(W - 10, y); ctx.stroke();
      ctx.fillStyle = 'rgba(107,114,128,0.6)';
      ctx.font = '10px monospace';
      ctx.textAlign = 'right';
      ctx.fillText((i * 25) + '%', 46, y + 4);
    }

    // Y label
    ctx.save();
    ctx.translate(14, (H - 50) / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.fillStyle = 'rgba(107,114,128,0.8)';
    ctx.font = '11px monospace';
    ctx.textAlign = 'center';
    ctx.fillText('Acceptance rate', 0, 0);
    ctx.restore();

    // Bars
    bars.forEach((b, idx) => {
      const x = startX + idx * (barW + 16);
      const barH = b.acc * chartH;
      const y = H - 50 - barH;

      // Background track
      ctx.fillStyle = 'rgba(255,255,255,0.04)';
      ctx.beginPath();
      ctx.roundRect(x, H - 50 - chartH, barW, chartH, [3, 3, 0, 0]);
      ctx.fill();

      // Bar
      const clr = b.trained
        ? (k === 3 ? 'rgba(139,92,246,0.85)' : 'rgba(6,182,212,0.75)')
        : 'rgba(107,114,128,0.4)';
      ctx.fillStyle = clr;
      ctx.beginPath();
      ctx.roundRect(x, y, barW, barH, [3, 3, 0, 0]);
      ctx.fill();

      // "trained" badge
      if (b.trained) {
        ctx.fillStyle = k === 3 ? 'rgba(139,92,246,0.2)' : 'rgba(6,182,212,0.15)';
        ctx.strokeStyle = k === 3 ? 'rgba(139,92,246,0.4)' : 'rgba(6,182,212,0.3)';
        ctx.lineWidth = 1;
        const badgeY = y - 18;
        ctx.beginPath();
        ctx.roundRect(x, badgeY, barW, 14, 3);
        ctx.fill();
        ctx.stroke();
        ctx.fillStyle = k === 3 ? '#a78bfa' : '#67e8f9';
        ctx.font = 'bold 8px monospace';
        ctx.textAlign = 'center';
        ctx.fillText('TRAINED', x + barW / 2, badgeY + 9);
      }

      // Percentage on bar
      ctx.fillStyle = '#fff';
      ctx.font = 'bold 11px monospace';
      ctx.textAlign = 'center';
      ctx.fillText(Math.round(b.acc * 100) + '%', x + barW / 2, y - (b.trained ? 24 : 6));

      // X label
      ctx.fillStyle = 'rgba(156,163,175,0.8)';
      ctx.font = '9px monospace';
      ctx.textAlign = 'center';
      ctx.fillText(b.label.split(' ')[0], x + barW / 2, H - 34);
      ctx.fillText(b.label.split(' ')[1], x + barW / 2, H - 24);
      ctx.fillText(b.label.split(' ')[2] || '', x + barW / 2, H - 14);
    });

    // τ readout
    ctx.fillStyle = 'rgba(255,255,255,0.85)';
    ctx.font = 'bold 13px monospace';
    ctx.textAlign = 'right';
    ctx.fillText('τ = ' + data.tau, W - 12, 22);
  }

  function resize() {
    canvas.width  = canvas.clientWidth  * DPR;
    canvas.height = canvas.clientHeight * DPR;
    const ctx = canvas.getContext('2d');
    ctx.scale(DPR, DPR);
    draw(currentK);
  }

  // K selector buttons
  document.querySelectorAll('.k-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.k-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentK = parseInt(btn.dataset.k);
      draw(currentK);
      const data = acceptData[currentK];
      const caption = document.getElementById('accept-caption');
      if (caption) caption.textContent = data.note;
    });
  });

  // Set initial caption
  const caption = document.getElementById('accept-caption');
  if (caption) caption.textContent = acceptData[1].note;

  new ResizeObserver(resize).observe(canvas);
  setTimeout(resize, 50);
})();

// ── Scatter canvas (§05) ──────────────────────────────────
(function() {
  const canvas = document.getElementById('scatter-canvas');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;

  const methods = [
    {
      name: 'EAGLE-3',
      sub: '(Vicuna 13B)',
      x: 0.82,   // integration cost: high → left, low → right
      y: 0.90,   // acceptance: higher up
      r: 12,
      color: '#06b6d4',
      labelDir: 'right'
    },
    {
      name: 'DFlash',
      sub: '(MiMo 1T)',
      x: 0.55,
      y: 0.72,
      r: 12,
      color: '#f59e0b',
      labelDir: 'right'
    },
    {
      name: 'DeepSeek-V3.2 MTP',
      sub: '(1 layer, 4 steps)',
      x: 0.18,
      y: 0.35,
      r: 10,
      color: '#6b7280',
      labelDir: 'right'
    },
    {
      name: 'GLM-5 MTP',
      sub: '(3 shared layers)',
      x: 0.22,
      y: 0.42,
      r: 14,
      color: '#8b5cf6',
      labelDir: 'right'
    },
  ];

  function drawScatter() {
    const ctx = canvas.getContext('2d');
    const W = canvas.width / DPR, H = canvas.height / DPR;
    ctx.clearRect(0, 0, W, H);

    const padL = 60, padR = 20, padT = 30, padB = 50;
    const cW = W - padL - padR, cH = H - padT - padB;

    // Grid
    ctx.strokeStyle = 'rgba(255,255,255,0.04)';
    ctx.lineWidth = 1;
    for (let i = 0; i <= 4; i++) {
      const x = padL + (i / 4) * cW;
      const y = padT + (i / 4) * cH;
      ctx.beginPath(); ctx.moveTo(x, padT); ctx.lineTo(x, padT + cH); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(padL, y); ctx.lineTo(padL + cW, y); ctx.stroke();
    }

    // Axes
    ctx.strokeStyle = 'rgba(255,255,255,0.15)';
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(padL, padT); ctx.lineTo(padL, padT + cH); ctx.stroke();
    ctx.beginPath();
    ctx.moveTo(padL, padT + cH); ctx.lineTo(padL + cW, padT + cH); ctx.stroke();

    // Axis labels
    ctx.fillStyle = 'rgba(156,163,175,0.8)';
    ctx.font = '11px monospace';
    ctx.textAlign = 'center';
    ctx.fillText('← more integration overhead        less →', padL + cW / 2, H - 8);
    ctx.save();
    ctx.translate(14, padT + cH / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.fillText('← lower τ        higher τ →', 0, 0);
    ctx.restore();

    // Plot points
    methods.forEach(m => {
      const px = padL + m.x * cW;
      const py = padT + (1 - m.y) * cH;

      // Glow
      const grd = ctx.createRadialGradient(px, py, 0, px, py, m.r * 2.5);
      grd.addColorStop(0, m.color + '40');
      grd.addColorStop(1, m.color + '00');
      ctx.fillStyle = grd;
      ctx.beginPath();
      ctx.arc(px, py, m.r * 2.5, 0, Math.PI * 2);
      ctx.fill();

      // Circle
      ctx.fillStyle = m.color;
      ctx.beginPath();
      ctx.arc(px, py, m.r, 0, Math.PI * 2);
      ctx.fill();

      // Label
      ctx.fillStyle = m.color;
      ctx.font = 'bold 11px monospace';
      ctx.textAlign = 'left';
      const lx = px + m.r + 6;
      const ly = py - 4;
      ctx.fillText(m.name, lx, ly);
      ctx.fillStyle = 'rgba(156,163,175,0.7)';
      ctx.font = '10px monospace';
      ctx.fillText(m.sub, lx, ly + 13);
    });
  }

  function resize() {
    canvas.width  = canvas.clientWidth  * DPR;
    canvas.height = canvas.clientHeight * DPR;
    const ctx = canvas.getContext('2d');
    ctx.scale(DPR, DPR);
    drawScatter();
  }

  new ResizeObserver(resize).observe(canvas);
  setTimeout(resize, 50);
})();

// ── Animated bars (§06) ───────────────────────────────────
const barsSection = document.getElementById('s-results');
if (barsSection) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          b.style.width = parseFloat(b.dataset.w) + '%';
        });
      }
    });
  }, { threshold: 0.3 }).observe(barsSection);
}
</script>
</BaseLayout>

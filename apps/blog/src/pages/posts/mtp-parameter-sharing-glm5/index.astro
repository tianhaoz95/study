<span class="cs-line cmt"># speculative_decode.py</span>
<span class="cs-line cmt"># Standard speculative decoding loop</span>
<span class="cs-line"> </span>
<span class="cs-line kw">def</span> <span class="cs-line fn">speculative_decode</span>(</span>
<span class="cs-line">    target, draft, context, K=4):</span>
<span class="cs-line"> </span>
<span class="cs-line cmt">  # Step 1: Draft K tokens cheaply</span>
<span class="cs-line hl-c">  drafts, draft_probs = draft.generate(</span>
<span class="cs-line hl-c">    context, n=K)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt">  # Step 2: One parallel verification</span>
<span class="cs-line hl-p">  all_logits = target.forward(</span>
<span class="cs-line hl-p">    context + drafts)  <span class="cmt"># single pass!</span></span>
<span class="cs-line hl-p">  target_probs = softmax(all_logits)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt">  # Step 3: Accept/reject each position</span>
<span class="cs-line">  accepted = []</span>
<span class="cs-line hl-g">  <span class="kw">for</span> i <span class="kw">in</span> range(K):</span>
<span class="cs-line hl-g">    p = target_probs[i][drafts[i]]</span>
<span class="cs-line hl-g">    q = draft_probs[i][drafts[i]]</span>
<span class="cs-line hl-g">    <span class="kw">if</span> rand() &lt; p / q:  <span class="cmt"># accept</span></span>
<span class="cs-line hl-g">      accepted.append(drafts[i])</span>
<span class="cs-line hl-g">    <span class="kw">else</span>:               <span class="cmt"># reject + resample</span></span>
<span class="cs-line hl-g">      t = resample(p, q)</span>
<span class="cs-line hl-g">      accepted.append(t); <span class="kw">break</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt">  # tau = E[len(accepted)]</span>
<span class="cs-line kw">  return</span> accepted</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Speedup formula</span>
<span class="cs-line cmt"># E[speedup] = tau / (1 + gamma * c)</span>
<span class="cs-line cmt">#   tau = avg accepted tokens</span>
<span class="cs-line cmt">#   gamma = draft overhead</span>
<span class="cs-line cmt">#   c = draft/target cost ratio</span>
      </pre>
    </div>

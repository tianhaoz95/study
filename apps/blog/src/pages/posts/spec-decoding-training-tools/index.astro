</div><!-- /post-grid -->

<script>
// ── TOC & sidebar toggles ────────────────────────────────
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});

const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ── Code sidebar tab switching ───────────────────────────
const tabMeta = {
  pipeline:    { file: 'pipeline.py',     title: 'Training Pipeline' },
  philosophies:{ file: 'design.md',       title: 'Design Philosophies' },
  algorithms:  { file: 'algorithms.py',   title: 'Algorithm Coverage' },
  backends:    { file: 'backends.sh',     title: 'Backend Compatibility' },
  scale:       { file: 'storage_math.py', title: 'Scale & Storage' },
  community:   { file: 'ecosystem.md',    title: 'Community & Code Quality' },
  verdict:     { file: 'decision.py',     title: 'Which One to Pick' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ── IntersectionObserver: sync TOC & code tab ───────────
const sectionMap = {
  's-pipeline':    'pipeline',
  's-philosophies':'philosophies',
  's-algorithms':  'algorithms',
  's-backends':    'backends',
  's-scale':       'scale',
  's-community':   'community',
  's-verdict':     'verdict',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.25 }).observe(s)
);

// ── Algorithm matrix: click to highlight ────────────────
document.querySelectorAll('.am-row[data-fw] .am-fw').forEach(cell => {
  cell.addEventListener('click', () => {
    const fw = cell.closest('.am-row').dataset.fw;
    document.querySelectorAll('.am-row[data-fw]').forEach(row => {
      row.classList.toggle('am-highlight', row.dataset.fw === fw &&
        !row.classList.contains('am-highlight') || false);
    });
    // Toggle: if already highlighted, dehighlight
    const row = document.getElementById('amr-' + fw);
    if (row) row.classList.toggle('am-highlight');
  });
});

// ── Positioning canvas ───────────────────────────────────
(function() {
  const wrap = document.getElementById('pos-canvas-wrap');
  const canvas = document.getElementById('pos-canvas');
  if (!canvas || !wrap) return;

  const FWS = [
    {
      id: 'specforge', label: 'SpecForge',
      x: 0.68, y: 0.22,  // right (SGLang-coupled), production
      color: '#8b5cf6',
      desc: '<strong>SpecForge</strong> — SGLang-native, LMSYS-maintained. Best for SGLang production fleets. EAGLE-3 + DFlash + Domino. SpecBundle pretrained checkpoints available. Partners: NVIDIA, Google, Meituan.',
    },
    {
      id: 'torchspec', label: 'TorchSpec',
      x: 0.22, y: 0.18,  // left (multi-engine), top (large-scale production)
      color: '#06b6d4',
      desc: '<strong>TorchSpec</strong> — Disaggregated streaming via Mooncake. Zero disk I/O for hidden states. First-class vLLM + TRT-LLM support. Production at DigitalOcean, CoreWeave. For 100B+ models where storage is a constraint.',
    },
    {
      id: 'speculators', label: 'speculators',
      x: 0.35, y: 0.32,  // left-center (vLLM-focused but standardized), production-ish
      color: '#10b981',
      desc: '<strong>speculators</strong> — vLLM-native, broadest algorithm support (EAGLE-3, DFlash, P-EAGLE, MTP Finetuning). Standardized HuggingFace format. 8B–675B, MoE + VLM. RedHatAI checkpoints. Apache 2.0.',
    },
    {
      id: 'deepspec', label: 'DeepSpec',
      x: 0.50, y: 0.72,  // center, lower (research pipeline)
      color: '#f59e0b',
      desc: '<strong>DeepSpec</strong> — Full-stack reproducible pipeline (data → train → eval). Built on SpecForge. Includes DSpark (+30.9% τ over EAGLE-3). Requires ~38 TB storage. DeepSeek AI. For algorithm comparison research.',
    },
  ];

  let hoveredIdx = -1;
  let W, H, DPR;

  function resize() {
    W = wrap.clientWidth;
    H = Math.round(W * 0.56);
    DPR = window.devicePixelRatio || 1;
    canvas.width  = W * DPR;
    canvas.height = H * DPR;
    canvas.style.width  = W + 'px';
    canvas.style.height = H + 'px';
    draw();
  }

  function draw() {
    const ctx = canvas.getContext('2d');
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
    ctx.clearRect(0, 0, W, H);

    const PAD = 56, iW = W - PAD * 2, iH = H - PAD * 2;

    // Grid lines
    ctx.strokeStyle = 'rgba(255,255,255,0.05)';
    ctx.lineWidth = 1;
    for (let i = 0; i <= 4; i++) {
      const gx = PAD + iW * (i / 4), gy = PAD + iH * (i / 4);
      ctx.beginPath(); ctx.moveTo(gx, PAD); ctx.lineTo(gx, PAD + iH); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(PAD, gy); ctx.lineTo(PAD + iW, gy); ctx.stroke();
    }

    // Axes
    ctx.strokeStyle = 'rgba(255,255,255,0.15)';
    ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.moveTo(PAD, PAD + iH / 2); ctx.lineTo(PAD + iW, PAD + iH / 2); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(PAD + iW / 2, PAD); ctx.lineTo(PAD + iW / 2, PAD + iH); ctx.stroke();

    // Axis labels
    ctx.fillStyle = '#4b5563';
    ctx.font = '9px var(--ff-mono, monospace)';
    ctx.textAlign = 'center';
    ctx.fillText('← multi-engine', PAD + iW * 0.18, PAD + iH / 2 - 6);
    ctx.fillText('engine-coupled →', PAD + iW * 0.82, PAD + iH / 2 - 6);
    ctx.textAlign = 'left';
    ctx.save();
    ctx.translate(PAD - 10, PAD + iH * 0.18);
    ctx.rotate(-Math.PI / 2);
    ctx.fillText('production scale ↑', 0, 0);
    ctx.restore();
    ctx.save();
    ctx.translate(PAD - 10, PAD + iH * 0.78);
    ctx.rotate(-Math.PI / 2);
    ctx.fillText('↓ research / pipeline', 0, 0);
    ctx.restore();

    // Framework dots
    FWS.forEach((fw, i) => {
      const cx = PAD + fw.x * iW;
      const cy = PAD + fw.y * iH;
      const r  = hoveredIdx === i ? 14 : 11;
      const isHov = hoveredIdx === i;

      // Glow
      if (isHov) {
        const grad = ctx.createRadialGradient(cx, cy, 0, cx, cy, 36);
        grad.addColorStop(0, fw.color + '40');
        grad.addColorStop(1, fw.color + '00');
        ctx.fillStyle = grad;
        ctx.beginPath(); ctx.arc(cx, cy, 36, 0, Math.PI * 2); ctx.fill();
      }

      // Dot
      ctx.beginPath(); ctx.arc(cx, cy, r, 0, Math.PI * 2);
      ctx.fillStyle = isHov ? fw.color : fw.color + 'cc';
      ctx.fill();
      if (isHov) {
        ctx.strokeStyle = fw.color;
        ctx.lineWidth = 2;
        ctx.beginPath(); ctx.arc(cx, cy, r + 4, 0, Math.PI * 2); ctx.stroke();
      }

      // Label
      ctx.fillStyle = isHov ? fw.color : 'rgba(226,232,240,0.85)';
      ctx.font = `${isHov ? 600 : 500} ${isHov ? 10.5 : 9.5}px var(--ff-mono, monospace)`;
      ctx.textAlign = 'center';
      const labelY = (fw.y < 0.5) ? cy + r + 14 : cy - r - 5;
      ctx.fillText(fw.label, cx, labelY);
    });
  }

  canvas.addEventListener('mousemove', (e) => {
    const rect = canvas.getBoundingClientRect();
    const mx = e.clientX - rect.left, my = e.clientY - rect.top;
    const PAD = 56, iW = W - PAD * 2, iH = H - PAD * 2;
    let found = -1;
    FWS.forEach((fw, i) => {
      const cx = PAD + fw.x * iW, cy = PAD + fw.y * iH;
      const dist = Math.hypot(mx - cx, my - cy);
      if (dist < 22) found = i;
    });
    if (found !== hoveredIdx) {
      hoveredIdx = found;
      draw();
      const info = document.getElementById('pos-info');
      if (info) {
        info.innerHTML = found >= 0 ? FWS[found].desc : 'Click a framework dot to see its design philosophy.';
      }
    }
    canvas.style.cursor = found >= 0 ? 'pointer' : 'default';
  });

  canvas.addEventListener('mouseleave', () => {
    hoveredIdx = -1;
    draw();
    const info = document.getElementById('pos-info');
    if (info) info.textContent = 'Click a framework dot to see its design philosophy.';
  });

  canvas.addEventListener('click', (e) => {
    const rect = canvas.getBoundingClientRect();
    const mx = e.clientX - rect.left, my = e.clientY - rect.top;
    const PAD = 56, iW = W - PAD * 2, iH = H - PAD * 2;
    FWS.forEach((fw, i) => {
      const cx = PAD + fw.x * iW, cy = PAD + fw.y * iH;
      if (Math.hypot(mx - cx, my - cy) < 22) {
        const info = document.getElementById('pos-info');
        if (info) info.innerHTML = fw.desc;
      }
    });
  });

  window.addEventListener('resize', resize);
  resize();
})();

// ── Animated bar charts ──────────────────────────────────
function animateBars(sectionId) {
  const sec = document.getElementById(sectionId);
  if (!sec) return;
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        sec.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          b.style.width = b.dataset.w + '%';
        });
      }
    });
  }, { threshold: 0.3 }).observe(sec);
}
animateBars('s-scale');
animateBars('s-community');
</script>

</BaseLayout>

<div class="post-grid" id="post-grid">

<!-- TOC -->
<nav class="toc-sidebar" id="toc-sidebar">
  <div class="toc-head">
    <span class="toc-label">Contents</span>
    <button class="toc-toggle" id="toc-toggle" title="Hide contents">‹</button>
    <span class="toc-collapsed-label">nav</span>
  </div>
  <ol class="toc-list">
    <li class="toc-item" id="toc-s-pipeline"><a href="#s-pipeline"><span class="toc-num">01</span> <span lang="en">The Training Pipeline</span><span lang="zh">训练流水线</span></a></li>
    <li class="toc-item" id="toc-s-philosophies"><a href="#s-philosophies"><span class="toc-num">02</span> <span lang="en">Design Philosophies</span><span lang="zh">设计哲学</span></a></li>
    <li class="toc-item" id="toc-s-algorithms"><a href="#s-algorithms"><span class="toc-num">03</span> <span lang="en">Algorithm Coverage</span><span lang="zh">算法覆盖</span></a></li>
    <li class="toc-item" id="toc-s-backends"><a href="#s-backends"><span class="toc-num">04</span> <span lang="en">Backend Compatibility</span><span lang="zh">后端兼容性</span></a></li>
    <li class="toc-item" id="toc-s-scale"><a href="#s-scale"><span class="toc-num">05</span> <span lang="en">Scale & Storage</span><span lang="zh">规模与存储</span></a></li>
    <li class="toc-item" id="toc-s-community"><a href="#s-community"><span class="toc-num">06</span> <span lang="en">Community & Code Quality</span><span lang="zh">社区与代码质量</span></a></li>
    <li class="toc-item" id="toc-s-verdict"><a href="#s-verdict"><span class="toc-num">07</span> <span lang="en">Which One to Pick</span><span lang="zh">如何选择</span></a></li>
  </ol>
</nav>

<!-- ARTICLE -->

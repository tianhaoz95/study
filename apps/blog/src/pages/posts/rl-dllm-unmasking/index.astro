<script>
// ── TOC + sidebar toggles ──
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});
const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ── Code sidebar tab switching ──
const tabMeta = {
  cliff:   { file: 'sampling.py',   title: 'The Heuristic Cliff' },
  mdm:     { file: 'mdm_gen.py',    title: 'Masked Diffusion' },
  mdp:     { file: 'mdp.py',        title: 'Sampling as MDP' },
  policy:  { file: 'policy.py',     title: 'The Lightweight Policy' },
  train:   { file: 'train.py',      title: 'Training with GRPO' },
  results: { file: 'results.py',    title: 'Results' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ── IntersectionObserver — sync TOC + sidebar on scroll ──
const sectionMap = {
  's-cliff':   'cliff',
  's-mdm':     'mdm',
  's-mdp':     'mdp',
  's-policy':  'policy',
  's-train':   'train',
  's-results': 'results',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.25 }).observe(s)
);

// ── §01: Accuracy vs NFEs chart ──
(function() {
  const canvas = document.getElementById('cliff-canvas');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 260;
  canvas.width = W * DPR; canvas.height = H * DPR;
  const ctx = canvas.getContext('2d');
  ctx.scale(DPR, DPR);

  // Data — approximate readings from paper Fig 4 (GSM8K, LLaDA-8B)
  const NFE_VALS = [8, 16, 32, 64, 128];
  const DATA = {
    semi: {
      random:    [8,  20, 43, 60, 70],
      highconf:  [18, 43, 65, 73, 76],
      fastdllm:  [16, 50, 72, 78, 80],
      rl:        [18, 48, 70, 78, 80],
    },
    full: {
      random:    [5,  10, 18, 28, 38],
      highconf:  [6,  12, 20, 30, 40],
      fastdllm:  [7,  14, 25, 35, 45],
      rl:        [18, 40, 55, 68, 76],
    }
  };
  const COLORS = {
    random:   'rgba(107,114,128,.7)',
    highconf: '#06b6d4',
    fastdllm: '#f59e0b',
    rl:       '#8b5cf6',
  };
  const LABELS = { random:'Random', highconf:'High-Conf', fastdllm:'Fast-dLLM', rl:'RL Policy' };

  let currentMode = 'semi';

  function drawChart(mode) {
    ctx.clearRect(0, 0, W, H);
    const pad = { top: 24, right: 20, bottom: 40, left: 46 };
    const cw = W - pad.left - pad.right;
    const ch = H - pad.top - pad.bottom;
    const nfes = NFE_VALS;
    const d = DATA[mode];

    // Grid
    ctx.strokeStyle = 'rgba(255,255,255,.05)';
    ctx.lineWidth = 1;
    for (let i = 0; i <= 4; i++) {
      const y = pad.top + ch - (i / 4) * ch;
      ctx.beginPath(); ctx.moveTo(pad.left, y); ctx.lineTo(pad.left + cw, y); ctx.stroke();
    }

    // Axes
    ctx.strokeStyle = 'rgba(255,255,255,.15)';
    ctx.beginPath(); ctx.moveTo(pad.left, pad.top); ctx.lineTo(pad.left, pad.top + ch); ctx.lineTo(pad.left + cw, pad.top + ch); ctx.stroke();

    // Axis labels
    ctx.fillStyle = 'rgba(107,114,128,.8)';
    ctx.font = `${10 * DPR / DPR}px monospace`;
    ctx.textAlign = 'right';
    for (let i = 0; i <= 4; i++) {
      const val = i * 25;
      const y = pad.top + ch - (i / 4) * ch;
      ctx.fillText(val + '%', pad.left - 5, y + 4);
    }
    ctx.textAlign = 'center';
    const nfeX = nfes.map((_, i) => pad.left + (i / (nfes.length - 1)) * cw);
    nfes.forEach((n, i) => ctx.fillText(n, nfeX[i], pad.top + ch + 18));
    ctx.fillText('NFEs (sampling steps)', pad.left + cw / 2, pad.top + ch + 34);
    ctx.save(); ctx.translate(10, pad.top + ch / 2); ctx.rotate(-Math.PI / 2);
    ctx.fillText('Accuracy (%)', 0, 0); ctx.restore();

    // Title
    ctx.fillStyle = mode === 'semi' ? '#06b6d4' : '#f59e0b';
    ctx.font = `bold ${11 * DPR / DPR}px monospace`;
    ctx.textAlign = 'left';
    ctx.fillText(mode === 'semi' ? 'Semi-AR (BL=32)' : 'Full-Diffusion (BL=256)', pad.left + 4, pad.top + 14);

    // Lines
    const keys = ['random', 'highconf', 'fastdllm', 'rl'];
    keys.forEach(key => {
      const vals = d[key];
      ctx.beginPath();
      ctx.strokeStyle = COLORS[key];
      ctx.lineWidth = key === 'rl' ? 2.5 : 1.8;
      ctx.setLineDash(key === 'rl' ? [] : (key === 'random' ? [4, 4] : []));
      vals.forEach((v, i) => {
        const x = nfeX[i];
        const y = pad.top + ch - (v / 100) * ch;
        i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
      });
      ctx.stroke();
      ctx.setLineDash([]);
      // Dots
      vals.forEach((v, i) => {
        const x = nfeX[i];
        const y = pad.top + ch - (v / 100) * ch;
        ctx.beginPath(); ctx.arc(x, y, key === 'rl' ? 3.5 : 2.5, 0, Math.PI * 2);
        ctx.fillStyle = COLORS[key]; ctx.fill();
      });
    });

    // Annotate "~50%" for RL in full mode
    if (mode === 'full') {
      const x12 = nfeX[1]; // 16 NFEs as proxy for ~12
      const y50 = pad.top + ch - (40 / 100) * ch;
      ctx.fillStyle = '#8b5cf6';
      ctx.font = `bold ${10}px monospace`;
      ctx.textAlign = 'left';
      ctx.fillText('~50% at 12 NFEs', x12 + 6, y50 - 8);
      ctx.beginPath(); ctx.arc(x12, y50 + 4, 4, 0, Math.PI * 2);
      ctx.fillStyle = '#8b5cf6'; ctx.fill();
    }
  }

  drawChart(currentMode);

  document.getElementById('cliff-mode-btns')?.querySelectorAll('.mode-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('#cliff-mode-btns .mode-btn').forEach(b => b.classList.toggle('active', b === btn));
      currentMode = btn.dataset.mode;
      drawChart(currentMode);
    });
  });
})();

// ── §02: Token unmasking animation ──
(function() {
  const prompt = ['If', 'each', 'of', '24', 'students', 'reads', '3', 'books,'];
  const answer = ['the', 'total', 'is', '72', 'books.'];

  // Unmasking steps: which positions (of answer) get revealed at each step
  // Step 0: all masked; Step 1: positions 3 (72 — high confidence);
  // Step 2: positions 0,4 (the, books.); Step 3: position 2 (is); Step 4: 1 (total); Step 5: all done
  const steps = [
    [],       // step 0: all masked
    [3],      // step 1: "72" revealed (highest confidence)
    [0, 4],   // step 2: "the", "books."
    [2],      // step 3: "is"
    [1],      // step 4: "total"
  ];
  let currentStep = 0;
  const revealed = new Set();
  const unmasking = new Set();

  function renderTokens() {
    const container = document.getElementById('token-display');
    if (!container) return;
    container.innerHTML = '';
    prompt.forEach(w => {
      const span = document.createElement('span');
      span.className = 'tok prompt';
      span.textContent = w;
      container.appendChild(span);
    });
    answer.forEach((w, i) => {
      const span = document.createElement('span');
      if (revealed.has(i)) {
        span.className = 'tok revealed';
        span.textContent = w;
      } else if (unmasking.has(i)) {
        span.className = 'tok unmasking';
        span.textContent = w;
      } else {
        span.className = 'tok masked';
        span.textContent = '[M]';
      }
      container.appendChild(span);
    });
    const label = document.getElementById('unmask-step-label');
    if (label) label.textContent = 'Step ' + currentStep + ' of ' + steps.length;
    const prev = document.getElementById('unmask-prev');
    const next = document.getElementById('unmask-next');
    if (prev) prev.disabled = currentStep === 0;
    if (next) next.disabled = currentStep >= steps.length;
  }

  function applyStep(s) {
    for (let i = 0; i < s; i++) steps[i].forEach(p => revealed.add(p));
    unmasking.clear();
    if (s < steps.length) steps[s].forEach(p => unmasking.add(p));
  }

  renderTokens();

  document.getElementById('unmask-next')?.addEventListener('click', () => {
    if (currentStep < steps.length) {
      // Move previously "unmasking" to "revealed"
      steps[currentStep].forEach(p => revealed.add(p));
      unmasking.clear();
      currentStep++;
      if (currentStep < steps.length) steps[currentStep].forEach(p => unmasking.add(p));
      renderTokens();
    }
  });
  document.getElementById('unmask-prev')?.addEventListener('click', () => {
    if (currentStep > 0) {
      // Undo last step
      if (currentStep <= steps.length) steps[currentStep - 1].forEach(p => {
        revealed.delete(p);
        if (currentStep < steps.length) unmasking.delete(p);
      });
      unmasking.clear();
      currentStep--;
      if (currentStep > 0 && currentStep <= steps.length) {
        // show current step as unmasking
        steps[currentStep - 1].forEach(p => {
          revealed.delete(p);
          unmasking.add(p);
        });
        // re-apply all previous
        for (let i = 0; i < currentStep - 1; i++) steps[i].forEach(p => { revealed.add(p); unmasking.delete(p); });
      }
      renderTokens();
    }
  });
  document.getElementById('unmask-reset')?.addEventListener('click', () => {
    currentStep = 0;
    revealed.clear();
    unmasking.clear();
    renderTokens();
  });
})();

// ── §04: Confidence visualization ──
(function() {
  const canvas = document.getElementById('conf-canvas');
  if (!canvas) return;
  const slider = document.getElementById('alpha-slider');
  const alphaVal = document.getElementById('alpha-val');
  const DPR = window.devicePixelRatio || 1;

  function resize() {
    const W = canvas.clientWidth, H = 200;
    canvas.width = W * DPR; canvas.height = H * DPR;
    const ctx = canvas.getContext('2d');
    ctx.scale(DPR, DPR);
    return { W, H, ctx };
  }

  // Simulated confidence values for 8 masked positions
  const confVals = [0.92, 0.08, 0.71, 0.15, 0.88, 0.31, 0.63, 0.44];
  const labels = ['72', '[?]', 'total', '[?]', 'books', '[?]', 'the', 'is'];

  function drawConf(alpha) {
    const { W, H, ctx } = resize();
    ctx.clearRect(0, 0, W, H);
    const n = confVals.length;
    const padL = 20, padR = 20, padT = 40, padB = 30;
    const barW = (W - padL - padR) / n - 6;
    const maxH = H - padT - padB;

    // Compute effective unmasking probability based on alpha
    // Higher alpha → higher threshold → only very high confidence unmasked
    const threshold = 0.3 + alpha * 0.065;

    confVals.forEach((c, i) => {
      const x = padL + i * ((W - padL - padR) / n) + 3;
      const barH = c * maxH;
      const y = H - padB - barH;
      const selected = c > threshold;

      // Bar
      ctx.fillStyle = selected ? 'rgba(139,92,246,.8)' : 'rgba(107,114,128,.35)';
      ctx.beginPath();
      ctx.roundRect ? ctx.roundRect(x, y, barW, barH, [3, 3, 0, 0]) : ctx.rect(x, y, barW, barH);
      ctx.fill();

      // Confidence value
      ctx.fillStyle = selected ? '#a78bfa' : '#4b5563';
      ctx.font = `${9}px monospace`;
      ctx.textAlign = 'center';
      ctx.fillText(c.toFixed(2), x + barW / 2, y - 5);

      // Token label
      ctx.fillStyle = selected ? '#e0d7ff' : '#4b5563';
      ctx.font = `${9}px monospace`;
      ctx.fillText(labels[i], x + barW / 2, H - 8);

      // Selection marker
      if (selected) {
        ctx.fillStyle = '#8b5cf6';
        ctx.font = `${10}px monospace`;
        ctx.fillText('✓', x + barW / 2, padT - 10);
      }
    });

    // Threshold line
    ctx.strokeStyle = 'rgba(245,158,11,.5)';
    ctx.setLineDash([4, 4]);
    ctx.lineWidth = 1.5;
    const threshY = H - padB - threshold * maxH;
    ctx.beginPath(); ctx.moveTo(padL, threshY); ctx.lineTo(W - padR, threshY); ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle = 'rgba(245,158,11,.8)';
    ctx.font = `${9}px monospace`;
    ctx.textAlign = 'right';
    ctx.fillText('threshold λ=' + threshold.toFixed(2), W - padR - 2, threshY - 4);

    // Count selected
    const nSel = confVals.filter(c => c > threshold).length;
    ctx.fillStyle = 'rgba(139,92,246,.8)';
    ctx.textAlign = 'left';
    ctx.font = `${10}px monospace`;
    ctx.fillText(nSel + ' tokens unmasked this step', padL, 15);
  }

  slider?.addEventListener('input', () => {
    const a = parseFloat(slider.value);
    if (alphaVal) alphaVal.textContent = a;
    drawConf(a);
  });

  drawConf(1);
})();

// ── §05: Training dynamics canvas ──
(function() {
  const canvas = document.getElementById('train-canvas');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;

  function resize() {
    const W = canvas.clientWidth, H = 220;
    canvas.width = W * DPR; canvas.height = H * DPR;
    const ctx = canvas.getContext('2d');
    ctx.scale(DPR, DPR);
    return { W, H, ctx };
  }

  // Simulated training curves for each α (smoothed correctness reward, 0-0.4 range)
  // Based on Fig 3 in paper: all start near 0, rise at different rates
  function genCurve(alpha, seed, steps) {
    const pts = [];
    let val = 0.02;
    for (let i = 0; i < steps; i++) {
      const noise = (((seed * 1664525 + i * 1013904223) & 0x7fffffff) / 0x7fffffff - 0.5) * 0.025;
      const target = alpha === 0 ? 0.38 : alpha === 0.3 ? 0.35 : alpha === 1 ? 0.32 : alpha === 3 ? 0.30 : 0.28;
      const speed = alpha === 0 ? 0.008 : alpha === 0.3 ? 0.009 : alpha === 1 ? 0.01 : alpha === 3 ? 0.012 : 0.015;
      val = val + speed * (target - val) + noise * 0.5;
      if (alpha === 10 && i > 300 && i < 500) val += (((seed * 22695477 + i) & 0x7fffffff) / 0x7fffffff - 0.5) * 0.04;
      val = Math.max(0, Math.min(0.5, val));
      pts.push(val);
    }
    return pts;
  }

  const STEPS = 800;
  const curves = {
    0:   { data: genCurve(0,   42, STEPS), color: '#10b981', label: 'α=0  (accuracy)' },
    0.3: { data: genCurve(0.3, 17, STEPS), color: '#06b6d4', label: 'α=0.3' },
    1:   { data: genCurve(1,   99, STEPS), color: '#8b5cf6', label: 'α=1' },
    3:   { data: genCurve(3,   55, STEPS), color: '#f59e0b', label: 'α=3' },
    10:  { data: genCurve(10,  31, STEPS), color: '#ef4444', label: 'α=10 (instability)' },
  };

  let activeAlpha = 1;

  function drawTraining(alpha) {
    const { W, H, ctx } = resize();
    ctx.clearRect(0, 0, W, H);
    const pad = { top: 28, right: 20, bottom: 36, left: 52 };
    const cw = W - pad.left - pad.right;
    const ch = H - pad.top - pad.bottom;
    const maxVal = 0.45;

    // Grid
    ctx.strokeStyle = 'rgba(255,255,255,.05)';
    ctx.lineWidth = 1;
    for (let i = 0; i <= 4; i++) {
      const y = pad.top + ch - (i / 4) * ch;
      ctx.beginPath(); ctx.moveTo(pad.left, y); ctx.lineTo(pad.left + cw, y); ctx.stroke();
    }
    // Axes
    ctx.strokeStyle = 'rgba(255,255,255,.15)';
    ctx.beginPath(); ctx.moveTo(pad.left, pad.top); ctx.lineTo(pad.left, pad.top + ch); ctx.lineTo(pad.left + cw, pad.top + ch); ctx.stroke();

    // Axis labels
    ctx.fillStyle = 'rgba(107,114,128,.8)';
    ctx.font = `${10}px monospace`;
    ctx.textAlign = 'right';
    for (let i = 0; i <= 4; i++) {
      const val = (i / 4 * maxVal).toFixed(2);
      const y = pad.top + ch - (i / 4) * ch;
      ctx.fillText(val, pad.left - 5, y + 4);
    }
    ctx.textAlign = 'center';
    for (let i = 0; i <= 4; i++) {
      const step = Math.round(i / 4 * STEPS);
      const x = pad.left + (i / 4) * cw;
      ctx.fillText(step, x, pad.top + ch + 16);
    }
    ctx.fillText('Training Step', pad.left + cw / 2, pad.top + ch + 30);
    ctx.save(); ctx.translate(12, pad.top + ch / 2); ctx.rotate(-Math.PI / 2);
    ctx.fillText('Correctness Reward', 0, 0); ctx.restore();

    // Draw all curves in background (faded)
    Object.entries(curves).forEach(([a, c]) => {
      if (String(a) === String(alpha)) return;
      ctx.beginPath();
      ctx.strokeStyle = c.color + '25';
      ctx.lineWidth = 1;
      c.data.forEach((v, i) => {
        const x = pad.left + (i / STEPS) * cw;
        const y = pad.top + ch - (v / maxVal) * ch;
        i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
      });
      ctx.stroke();
    });

    // Active curve
    const ac = curves[String(alpha)];
    if (!ac) return;
    ctx.beginPath();
    ctx.strokeStyle = ac.color;
    ctx.lineWidth = 2.5;
    ac.data.forEach((v, i) => {
      const x = pad.left + (i / STEPS) * cw;
      const y = pad.top + ch - (v / maxVal) * ch;
      i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
    });
    ctx.stroke();

    // Label
    ctx.fillStyle = ac.color;
    ctx.font = `bold ${10}px monospace`;
    ctx.textAlign = 'left';
    const lastV = ac.data[STEPS - 1];
    ctx.fillText(ac.label, pad.left + 4, pad.top + ch - (lastV / maxVal) * ch - 8);
  }

  drawTraining(activeAlpha);

  document.getElementById('alpha-mode-btns')?.querySelectorAll('.mode-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('#alpha-mode-btns .mode-btn').forEach(b => b.classList.toggle('active', b === btn));
      activeAlpha = btn.dataset.alpha;
      drawTraining(activeAlpha);
    });
  });
})();

// ── §04 step navigator ──
(function() {
  let step = 0;
  const boxes = document.querySelectorAll('#policy-steps .step-box');
  const prevBtn = document.getElementById('policy-prev');
  const nextBtn = document.getElementById('policy-next');
  const progEl  = document.getElementById('policy-prog');
  function updateSteps() {
    boxes.forEach((b, i) => {
      b.classList.remove('active', 'done');
      if (i === step) b.classList.add('active');
      else if (i < step) b.classList.add('done');
    });
    if (prevBtn) prevBtn.disabled = step === 0;
    if (nextBtn) nextBtn.disabled = step === boxes.length - 1;
    if (progEl) progEl.textContent = 'Step ' + (step + 1) + ' of ' + boxes.length;
    boxes.forEach((b, i) => {
      const n = b.querySelector('.step-num');
      if (n) n.textContent = i < step ? '✓' : String(i + 1);
    });
  }
  prevBtn?.addEventListener('click', () => { if (step > 0) { step--; updateSteps(); } });
  nextBtn?.addEventListener('click', () => { if (step < boxes.length - 1) { step++; updateSteps(); } });
  updateSteps();
})();

// ── §06: Animated bar chart ──
const resultsSection = document.getElementById('s-results');
if (resultsSection) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          b.style.width = b.dataset.w + '%';
        });
      }
    });
  }, { threshold: 0.3 }).observe(resultsSection);
}
</script>
</BaseLayout>

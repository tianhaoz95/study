    <button class="cs-tab" data-panel="policy">policy</button>
    <button class="cs-tab" data-panel="train">train</button>
    <button class="cs-tab" data-panel="results">results</button>
  </div>
  <div class="cs-body">
    <!-- Panel: cliff -->
    <div class="cs-panel active" id="panel-cliff">
      <pre class="cs-pre">
<span class="cs-line cmt"># Fast-dLLM heuristic sampler</span>
<span class="cs-line cmt"># Works well in semi-AR, breaks in full-diffusion</span>
<span class="cs-line"></span>
<span class="cs-line hl-a"><span class="kw">def</span> <span class="fn">fast_dllm_unmask</span>(confidences, mask, lam):</span>
<span class="cs-line hl-a">    <span class="cmt"># lam = fixed threshold λ (requires manual tuning)</span></span>
<span class="cs-line">    <span class="kw">return</span> &#123;</span>
<span class="cs-line">        k <span class="kw">for</span> k <span class="kw">in</span> mask</span>
<span class="cs-line">        <span class="kw">if</span> confidences[k] &gt; lam</span>
<span class="cs-line">    &#125;</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Semi-AR: BL=32 → unmask within 32-token windows</span>
<span class="cs-line cmt"># Full-diffusion: BL=256 → unmask anywhere in seq</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Key problem in full-diffusion:</span>
<span class="cs-line cmt"># LLaDA has corrupted confidence on padding tokens</span>
<span class="cs-line cmt"># → Fast-dLLM unmasks right-to-left (wrong order)</span>
<span class="cs-line cmt"># → Accuracy at 12 NFEs: ≤30% (all heuristics)</span>
<span class="cs-line"></span>
<span class="cs-line hl-g"><span class="cmt"># RL Policy: ≈50% at 12 NFEs in full-diffusion</span></span>
<span class="cs-line hl-g"><span class="cmt"># No semi-AR restriction needed</span></span>
      </pre>
    </div>
    <!-- Panel: mdm -->
    <div class="cs-panel" id="panel-mdm">
      <pre class="cs-pre">
<span class="cs-line cmt"># Masked Diffusion Model — generation loop</span>
<span class="cs-line"></span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">mdm_generate</span>(model, prompt, L, T, sampler):</span>
<span class="cs-line">    <span class="cmt"># Start fully masked</span></span>
<span class="cs-line hl-p">    y = [MASK] * L  <span class="cmt"># answer sequence</span></span>
<span class="cs-line"></span>
<span class="cs-line">    <span class="kw">for</span> t <span class="kw">in</span> reversed(range(T)):</span>
<span class="cs-line">        <span class="cmt"># One forward pass through the frozen dLLM</span></span>
<span class="cs-line hl-c">        logits = <span class="fn">model</span>(prompt + y)</span>
<span class="cs-line hl-c">        conf = <span class="fn">softmax</span>(logits).<span class="fn">max</span>(dim=-1)</span>
<span class="cs-line"></span>
<span class="cs-line">        <span class="cmt"># Sampler decides which masked positions to fill</span></span>
<span class="cs-line hl-a">        U_t = <span class="fn">sampler</span>(conf, masked_positions, t)</span>
<span class="cs-line"></span>
<span class="cs-line">        <span class="kw">for</span> k <span class="kw">in</span> U_t:  <span class="cmt"># unmask selected positions</span></span>
<span class="cs-line">            y[k] = <span class="fn">argmax</span>(logits[k])</span>
<span class="cs-line"></span>
<span class="cs-line">        <span class="kw">if</span> <span class="fn">all_unmasked</span>(y): <span class="kw">break</span></span>
<span class="cs-line"></span>
<span class="cs-line">    <span class="kw">return</span> y</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># NFEs = number of dLLM forward passes</span>
<span class="cs-line cmt"># Goal: maximize accuracy at minimum NFEs</span>
      </pre>
    </div>
    <!-- Panel: mdp -->
    <div class="cs-panel" id="panel-mdp">
      <pre class="cs-pre">
<span class="cs-line cmt"># Unmasking as Markov Decision Process</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># State: (prompt x, partial sequence y_t)</span>
<span class="cs-line cmt"># Action: binary vector u_t ∈ &#123;0,1&#125;^L</span>
<span class="cs-line cmt"># Transition: dLLM samples unmasked positions</span>
<span class="cs-line cmt"># Reward: only at episode end (fully unmasked)</span>
<span class="cs-line"></span>
<span class="cs-line hl-p"><span class="kw">class</span> <span class="cls">DLLMEnvironment</span>:</span>
<span class="cs-line hl-p">    <span class="kw">def</span> <span class="fn">__init__</span>(<span class="kw">self</span>, dllm):  <span class="cmt"># frozen 7-8B model</span></span>
<span class="cs-line hl-p">        <span class="kw">self</span>.dllm = dllm</span>
<span class="cs-line"></span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">step</span>(<span class="kw">self</span>, y_t, action_u):</span>
<span class="cs-line hl-c">        logits = <span class="kw">self</span>.dllm.<span class="fn">forward</span>(y_t)</span>
<span class="cs-line hl-c">        y_next = y_t.<span class="fn">copy</span>()</span>
<span class="cs-line hl-c">        <span class="kw">for</span> k <span class="kw">in</span> <span class="fn">range</span>(<span class="fn">len</span>(y_t)):</span>
<span class="cs-line hl-c">            <span class="kw">if</span> action_u[k] <span class="op">==</span> <span class="num">1</span>:</span>
<span class="cs-line hl-c">                y_next[k] = <span class="fn">argmax</span>(logits[k])</span>
<span class="cs-line">        reward = <span class="num">0</span>  <span class="cmt"># 0 until fully unmasked</span></span>
<span class="cs-line">        <span class="kw">if</span> <span class="fn">all_unmasked</span>(y_next):</span>
<span class="cs-line hl-g">            reward = <span class="fn">compute_reward</span>(y_next, ref)</span>
<span class="cs-line">        <span class="kw">return</span> y_next, reward</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Policy: tiny network, 0.01% of dLLM size</span>
<span class="cs-line cmt"># Acts on confidence scores, not embeddings</span>
<span class="cs-line cmt"># → transferable across dLLM models</span>
      </pre>
    </div>
    <!-- Panel: policy -->
    <div class="cs-panel" id="panel-policy">
      <pre class="cs-pre">
<span class="cs-line cmt"># Lightweight unmasking policy — ~300K params</span>
<span class="cs-line"></span>
<span class="cs-line hl-p"><span class="kw">class</span> <span class="cls">UnmaskingPolicy</span>(<span class="cls">nn</span>.Module):</span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">__init__</span>(<span class="kw">self</span>, d=64, heads=4):</span>
<span class="cs-line hl-p">        <span class="kw">self</span>.embed = <span class="cls">nn</span>.<span class="cls">Linear</span>(<span class="num">3</span>, d)  <span class="cmt"># c, mask, t</span></span>
<span class="cs-line hl-p">        <span class="kw">self</span>.attn = <span class="fn">TransformerLayer</span>(d, heads)</span>
<span class="cs-line hl-p">        <span class="kw">self</span>.head = <span class="cls">nn</span>.<span class="cls">Linear</span>(d, <span class="num">1</span>)  <span class="cmt"># per-pos logit</span></span>
<span class="cs-line"></span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">forward</span>(<span class="kw">self</span>, conf, mask_ind, t, tau_pi):</span>
<span class="cs-line hl-c">        x = <span class="kw">self</span>.<span class="fn">embed</span>(<span class="fn">stack</span>(conf, mask_ind, t))</span>
<span class="cs-line hl-c">        x = <span class="kw">self</span>.<span class="fn">attn</span>(x)  <span class="cmt"># inter-token context</span></span>
<span class="cs-line hl-c">        logits = <span class="kw">self</span>.<span class="fn">head</span>(x).<span class="fn">squeeze</span>(-<span class="num">1</span>)</span>
<span class="cs-line">        s = <span class="fn">sigmoid</span>(logits / tau_pi)</span>
<span class="cs-line">        <span class="kw">return</span> <span class="cls">Bernoulli</span>(s)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Test-time β scaling — one policy, full frontier</span>
<span class="cs-line hl-g"><span class="kw">def</span> <span class="fn">scaled_sample</span>(policy, conf, mask, t, beta):</span>
<span class="cs-line hl-g">    s = policy.<span class="fn">forward</span>(conf, mask, t, tau_pi=<span class="num">1</span>).probs</span>
<span class="cs-line hl-g">    s_scaled = <span class="fn">min</span>(<span class="num">1</span>, beta * s)</span>
<span class="cs-line hl-g">    <span class="kw">return</span> <span class="cls">Bernoulli</span>(s_scaled).<span class="fn">sample</span>()</span>
      </pre>
    </div>
    <!-- Panel: train -->
    <div class="cs-panel" id="panel-train">
      <pre class="cs-pre">
<span class="cs-line cmt"># GRPO training for unmasking policy</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Multiplicative reward — key design choice</span>
<span class="cs-line hl-a"><span class="kw">def</span> <span class="fn">reward</span>(correct, steps_used, T, alpha):</span>
<span class="cs-line hl-a">    efficiency = <span class="num">1</span> - steps_used / T</span>
<span class="cs-line hl-a">    <span class="kw">return</span> correct * (efficiency ** alpha)</span>
<span class="cs-line hl-a">    <span class="cmt"># correct=0 → reward=0, regardless of speed</span></span>
<span class="cs-line hl-a">    <span class="cmt"># prevents reward hacking via fast-but-wrong</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># GRPO update step</span>
<span class="cs-line hl-p"><span class="kw">for</span> prompt, answer <span class="kw">in</span> dataset:  <span class="cmt"># GSM8K+MATH</span></span>
<span class="cs-line hl-p">    <span class="cmt"># Sample G=8 trajectories</span></span>
<span class="cs-line hl-p">    trajectories = [<span class="fn">rollout</span>(policy, prompt) <span class="kw">for</span> _ <span class="kw">in</span> <span class="fn">range</span>(<span class="num">8</span>)]</span>
<span class="cs-line hl-p">    rewards = [<span class="fn">reward</span>(traj, answer) <span class="kw">for</span> traj <span class="kw">in</span> trajectories]</span>
<span class="cs-line"></span>
<span class="cs-line">    <span class="cmt"># Advantage = reward - group mean</span></span>
<span class="cs-line hl-c">    mean_r = <span class="fn">sum</span>(rewards) / <span class="num">8</span></span>
<span class="cs-line hl-c">    advantages = [r - mean_r <span class="kw">for</span> r <span class="kw">in</span> rewards]</span>
<span class="cs-line"></span>
<span class="cs-line">    <span class="cmt"># Clipped importance-weighted policy gradient</span></span>
<span class="cs-line hl-g">    loss = <span class="fn">grpo_loss</span>(policy, trajectories, advantages)</span>
<span class="cs-line hl-g">    <span class="fn">optimizer_step</span>(loss)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Training: ~800 steps, single GPU</span>
<span class="cs-line cmt"># Data: ~15K samples (GSM8K+MATH mixture)</span>
      </pre>
    </div>
    <!-- Panel: results -->
    <div class="cs-panel" id="panel-results">
      <pre class="cs-pre">
<span class="cs-line cmt"># Key results — LLaDA-8B-Instruct, GSM8K</span>
<span class="cs-line cmt"># Full-diffusion mode (BL=256), ~12 NFEs</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Method         Accuracy</span>
<span class="cs-line cmt"># ─────────────────────────</span>
<span class="cs-line cmt"># Random         ~19%</span>
<span class="cs-line cmt"># High-Conf      ~22%</span>
<span class="cs-line cmt"># Fast-dLLM λ    ~26%</span>
<span class="cs-line hl-p"><span class="cmt"># RL Policy      ~50%   ← 2× heuristics</span></span>
<span class="cs-line hl-p"><span class="cmt"># RL + ES        ~58%</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Transfer results</span>
<span class="cs-line hl-g"><span class="cmt"># LLaDA → Dream: policy transfers</span></span>
<span class="cs-line hl-g"><span class="cmt"># L=256 → L=512: policy transfers</span></span>
<span class="cs-line cmt"># Math → Code:   needs code training data</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Pass@k (non-greedy, τ > 0)</span>
<span class="cs-line hl-c"><span class="cmt"># Policy: +0.98% (k=1), +2.56% (k=32)</span></span>
<span class="cs-line hl-c"><span class="cmt"># Less diversity collapse than heuristics</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Policy size: ~300K params</span>
<span class="cs-line cmt"># dLLM size:   ~8B params</span>
<span class="cs-line hl-a"><span class="cmt"># Overhead:    &lt;0.01% — negligible</span></span>
      </pre>
    </div>
  </div>
</aside>


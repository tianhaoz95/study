---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Vision Without Augmentations: TDV Learns Representations from Temporal Difference | Catpuccino.ai"
  description="TDV replaces cropping, masking, and augmentation with a single causal assumption: current frame embedding + encoded motion = next frame embedding. No vision-specific tricks, yet matches DINO/iBOT on dense spatial tasks."
  crumb="TDV"
>

<style is:global>
/* ─── Post base ─────────────────────────────── */
.post-hero{padding:6.5rem 2rem 3rem;max-width:1700px;margin:0 auto}
.post-hero .tags{margin-bottom:1.25rem}

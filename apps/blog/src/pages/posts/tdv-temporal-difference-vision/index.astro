    <button class="cs-tab" data-panel="collapse">collapse</button>
    <button class="cs-tab" data-panel="arch">arch</button>
    <button class="cs-tab" data-panel="motion">motion</button>
    <button class="cs-tab" data-panel="results">results</button>
    <button class="cs-tab" data-panel="future">future</button>
  </div>
  <div class="cs-body">

    <!-- scale panel -->
    <div class="cs-panel active" id="panel-scale">
      <pre class="cs-pre">
<span class="cs-line cmt"># Figure 3: Masking ratio as inductive</span>
<span class="cs-line cmt"># bias proxy across data scales</span>
<span class="cs-line cmt"># ImageNet-1k KNN Top-1 accuracy</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Data subset → best masking ratio</span>
<span class="cs-line cmt">#   0.1%  →  50% masking (+12pp lead)</span>
<span class="cs-line cmt">#   1%    →  50% masking (+5pp lead)</span>
<span class="cs-line cmt">#   10%   →  30% masking catching up</span>
<span class="cs-line cmt">#   100%  →  30% masking surpasses 50%</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Key result: optimal inductive bias</span>
<span class="cs-line cmt"># strength monotonically decreases</span>
<span class="cs-line cmt"># with data — motivating TDV</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">train_masking_probe</span>(</span>
<span class="cs-line hl-p">    data_fraction, masking_ratio):</span>
<span class="cs-line">    <span class="cmt"># pretrain MAE-style SSL</span></span>
<span class="cs-line">    encoder = <span class="fn">pretrain</span>(</span>
<span class="cs-line">        data=ImageNet[:data_fraction],</span>
<span class="cs-line">        mask_ratio=masking_ratio</span>
<span class="cs-line">    )</span>
<span class="cs-line">    <span class="kw">return</span> <span class="fn">knn_accuracy</span>(encoder)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Inductive biases are approximately</span>
<span class="cs-line cmt"># correct — at scale, the approximation</span>
<span class="cs-line cmt"># error becomes a ceiling.</span>
<span class="cs-line cmt"># TDV's causal assumption is exact:</span>
<span class="cs-line cmt"># the past always precedes the future.</span>
      </pre>
    </div>

    <!-- collapse panel -->
    <div class="cs-panel" id="panel-collapse">
      <pre class="cs-pre">
<span class="cs-line cmt"># Table 1: Progressive DINO ablation</span>
<span class="cs-line cmt"># SSv2 pretrain → ImageNet KNN Top-1</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Setup                Top-1  Stable?</span>
<span class="cs-line cmt"># 2G+8L, full aug      24.63  ✓</span>
<span class="cs-line cmt"># -augmentations       16.44  ✓</span>
<span class="cs-line cmt"># -local crops         13.64  ✓</span>
<span class="cs-line cmt"># -crop on 1 global     8.04  ✓</span>
<span class="cs-line cmt"># -crop on both G       0.84  ✗ collapse</span>
<span class="cs-line cmt"># ─────────────────────────────────────</span>
<span class="cs-line cmt"># Full TDV recipe       8.79  ✓</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">why_collapse_happens</span>():</span>
<span class="cs-line">    <span class="cmt"># Without augmentation, the model</span></span>
<span class="cs-line">    <span class="cmt"># sees identical views → trivial sol.</span></span>
<span class="cs-line">    <span class="cmt"># Set ALL embeddings to a constant:</span></span>
<span class="cs-line">    <span class="cmt">#   loss = ||z_t - z_t||^2 = 0  ✓</span></span>
<span class="cs-line">    <span class="cmt"># But KNN cannot distinguish images.</span></span>
<span class="cs-line">    <span class="kw">pass</span></span>
<span class="cs-line"> </span>
<span class="cs-line hl-c"><span class="kw">def</span> <span class="fn">why_tdv_avoids_collapse</span>():</span>
<span class="cs-line hl-c">    <span class="cmt"># TDV must predict DIFFERENT targets</span></span>
<span class="cs-line hl-c">    <span class="cmt"># (next frames) from DIFFERENT inputs.</span></span>
<span class="cs-line hl-c">    <span class="cmt"># Constant embedding fails:</span></span>
<span class="cs-line hl-c">    <span class="cmt">#   CE loss spikes when all frames</span></span>
<span class="cs-line hl-c">    <span class="cmt">#   map to same distribution.</span></span>
<span class="cs-line hl-c">    <span class="kw">pass</span></span>
      </pre>
    </div>

    <!-- arch panel -->
    <div class="cs-panel" id="panel-arch">
      <pre class="cs-pre">
<span class="cs-line cmt"># TDV Forward Pass (simplified)</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">tdv_forward</span>(x_t, x_t1, teacher):</span>
<span class="cs-line hl-p">    <span class="cmt"># Student: encode current frame</span></span>
<span class="cs-line hl-p">    z_t = <span class="fn">frame_encoder</span>(x_t)</span>
<span class="cs-line hl-p">    <span class="cmt"># z_t ∈ R^&#123;n × D&#125;, n patches</span></span>
<span class="cs-line"> </span>
<span class="cs-line hl-c">    <span class="cmt"># Compute pixel difference</span></span>
<span class="cs-line hl-c">    delta_x = x_t1 - x_t  <span class="cmt"># low-rank!</span></span>
<span class="cs-line"> </span>
<span class="cs-line hl-g">    <span class="cmt"># Motion encoder (conditioned on z_t)</span></span>
<span class="cs-line hl-g">    delta_z = <span class="fn">motion_encoder</span>(</span>
<span class="cs-line hl-g">        delta_x, z_t  <span class="cmt"># cross-attention</span></span>
<span class="cs-line hl-g">    )</span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="cmt"># Additive composition ← KEY IDEA</span></span>
<span class="cs-line">    z_hat_t1 = z_t + delta_z</span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="cmt"># Teacher target (stop-gradient)</span></span>
<span class="cs-line">    <span class="kw">with</span> torch.<span class="fn">no_grad</span>():</span>
<span class="cs-line">        z_target = <span class="fn">teacher</span>(x_t1)</span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="cmt"># Losses</span></span>
<span class="cs-line">    L_mse = ((z_hat_t1 - z_target)**2</span>
<span class="cs-line">             ).<span class="fn">mean</span>()</span>
<span class="cs-line">    L_dino = <span class="fn">dino_ce_loss</span>(</span>
<span class="cs-line">        z_hat_t1, z_target  <span class="cmt"># [CLS]+patch</span></span>
<span class="cs-line">    )</span>
<span class="cs-line">    <span class="kw">return</span> lambda_mse * L_mse \</span>
<span class="cs-line">         + lambda_dino * L_dino</span>
      </pre>
    </div>

    <!-- motion panel -->
    <div class="cs-panel" id="panel-motion">
      <pre class="cs-pre">
<span class="cs-line cmt"># Motion Encoder Architecture</span>
<span class="cs-line cmt"># Input: pixel diff Δx, frame embed z_t</span>
<span class="cs-line cmt"># Output: latent shift Δz ∈ R^&#123;n × D&#125;</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">class</span> <span class="cls">MotionEncoder</span>(nn.Module):</span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">__init__</span>(<span class="kw">self</span>, D, n_heads):</span>
<span class="cs-line">        <span class="kw">super</span>().<span class="fn">__init__</span>()</span>
<span class="cs-line">        <span class="cmt"># Patchify delta frame first</span></span>
<span class="cs-line">        <span class="kw">self</span>.patch_embed = <span class="cls">PatchEmbed</span>(D)</span>
<span class="cs-line">        <span class="cmt"># Cross-attention: Δx attends to z_t</span></span>
<span class="cs-line hl-c">        <span class="kw">self</span>.cross_attn = <span class="cls">CrossAttention</span>(</span>
<span class="cs-line hl-c">            D, n_heads,</span>
<span class="cs-line hl-c">            <span class="cmt"># query = Δx patches</span></span>
<span class="cs-line hl-c">            <span class="cmt"># key/value = z_t tokens</span></span>
<span class="cs-line hl-c">        )</span>
<span class="cs-line">        <span class="kw">self</span>.mlp = <span class="cls">MLP</span>(D)</span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">forward</span>(<span class="kw">self</span>, delta_x, z_t):</span>
<span class="cs-line">        <span class="cmt"># Embed pixel delta</span></span>
<span class="cs-line">        h = <span class="kw">self</span>.<span class="fn">patch_embed</span>(delta_x)</span>
<span class="cs-line">        <span class="cmt"># Ground motion in scene context</span></span>
<span class="cs-line hl-g">        h = <span class="kw">self</span>.<span class="fn">cross_attn</span>(</span>
<span class="cs-line hl-g">            query=h, kv=z_t</span>
<span class="cs-line hl-g">        )  <span class="cmt"># same pixel change, different</span></span>
<span class="cs-line hl-g">           <span class="cmt"># semantic meaning per scene</span></span>
<span class="cs-line">        <span class="kw">return</span> <span class="kw">self</span>.<span class="fn">mlp</span>(h)  <span class="cmt"># = Δz</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Why low-rank?</span>
<span class="cs-line cmt"># Background ≈ 85-95% of pixels → 0</span>
<span class="cs-line cmt"># Only moving regions contribute signal</span>
<span class="cs-line cmt"># → motion encoder learns compact</span>
<span class="cs-line cmt">#   semantic motion features</span>
      </pre>
    </div>

    <!-- results panel -->
    <div class="cs-panel" id="panel-results">
      <pre class="cs-pre">
<span class="cs-line cmt"># Benchmark results — ViT-S, SSv2</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Optical Flow (MPI-Sintel, EPE ↓)</span>

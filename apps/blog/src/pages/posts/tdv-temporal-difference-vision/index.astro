<script>
/* ─────────────────────────────────────────────────
   TOC + sidebar toggles
───────────────────────────────────────────────── */
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});

const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

/* ─────────────────────────────────────────────────
   Code sidebar tab switching
───────────────────────────────────────────────── */
const tabMeta = {
  scale:   { file: 'tdv/experiment.py',   title: 'Scale Argument' },
  collapse:{ file: 'tdv/ablation.py',     title: 'Naive Removal Fails' },
  arch:    { file: 'tdv/model.py',         title: 'TDV Architecture' },
  motion:  { file: 'tdv/motion_encoder.py',title: 'Low-Rank Motion' },
  results: { file: 'tdv/results.py',       title: 'Dense Spatial Results' },
  future:  { file: 'tdv/future.py',        title: 'Implications' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t =>
    t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p =>
    p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t =>
  t.addEventListener('click', () => activateTab(t.dataset.panel)));

/* ─────────────────────────────────────────────────
   IntersectionObserver — TOC + sidebar sync
───────────────────────────────────────────────── */
const sectionMap = {
  's-scale': 'scale', 's-collapse': 'collapse', 's-arch': 'arch',
  's-motion': 'motion', 's-results': 'results', 's-future': 'future'
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

/* ─────────────────────────────────────────────────
   §01 Scale Chart Canvas
───────────────────────────────────────────────── */
(function() {
  const canvas = document.getElementById('scale-canvas');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 240;
  canvas.width = W * DPR; canvas.height = H * DPR;
  const ctx = canvas.getContext('2d');
  ctx.scale(DPR, DPR);

  // Data: diff vs 50% masking (pp) at 4 data scales
  // Source: paper Figure 3 description (approximate)
  const scales = ['0.1%', '1%', '10%', '100%'];
  const diff30 = [-12.5, -4.8, -0.4, 1.2];  // 30% masking vs 50% baseline
  const diff10 = [-16.1, -11.2, -4.3, -0.7]; // 10% masking vs 50% baseline

  const pad = { l: 52, r: 30, t: 24, b: 48 };
  const cw = W - pad.l - pad.r;
  const ch = H - pad.t - pad.b;

  const yMin = -18, yMax = 3;
  function xPos(i) { return pad.l + (i / (scales.length - 1)) * cw; }
  function yPos(v) { return pad.t + ((yMax - v) / (yMax - yMin)) * ch; }

  let highlightIdx = 0;

  function draw() {
    ctx.clearRect(0, 0, W, H);

    // Grid lines
    [-16, -12, -8, -4, 0].forEach(v => {
      const y = yPos(v);
      ctx.beginPath(); ctx.moveTo(pad.l, y); ctx.lineTo(pad.l + cw, y);
      ctx.strokeStyle = v === 0 ? 'rgba(255,255,255,0.12)' : 'rgba(255,255,255,0.04)';
      ctx.lineWidth = v === 0 ? 1.5 : 1;
      ctx.stroke();
      ctx.fillStyle = '#6b7280';
      ctx.font = '10px var(--ff-mono, monospace)';
      ctx.textAlign = 'right';
      ctx.fillText((v > 0 ? '+' : '') + v + 'pp', pad.l - 6, y + 3.5);
    });

    // Reference line label
    ctx.fillStyle = '#9ca3af';
    ctx.font = '9px var(--ff-mono, monospace)';
    ctx.textAlign = 'right';
    ctx.fillText('50% masking (baseline)', pad.l - 6, yPos(0) - 6);

    // x-axis labels
    scales.forEach((s, i) => {
      ctx.fillStyle = i === highlightIdx ? '#a78bfa' : '#6b7280';
      ctx.font = i === highlightIdx ? 'bold 11px var(--ff-mono, monospace)' : '10px var(--ff-mono, monospace)';
      ctx.textAlign = 'center';
      ctx.fillText(s, xPos(i), H - 10);
    });
    ctx.fillStyle = '#6b7280';
    ctx.font = '9px var(--ff-mono, monospace)';
    ctx.textAlign = 'center';
    ctx.fillText('Data scale (fraction of ImageNet-1k)', W / 2, H - 0);

    // Draw 30% masking line (blue)
    ctx.beginPath();
    diff30.forEach((v, i) => {
      const x = xPos(i), y = yPos(v);
      i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
    });
    ctx.strokeStyle = '#06b6d4';
    ctx.lineWidth = 2;
    ctx.stroke();

    // Draw 10% masking line (green)
    ctx.beginPath();
    diff10.forEach((v, i) => {
      const x = xPos(i), y = yPos(v);
      i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
    });
    ctx.strokeStyle = '#10b981';
    ctx.lineWidth = 2;
    ctx.stroke();

    // Draw dots
    diff30.forEach((v, i) => {
      const x = xPos(i), y = yPos(v);
      ctx.beginPath(); ctx.arc(x, y, i === highlightIdx ? 6 : 4, 0, Math.PI * 2);
      ctx.fillStyle = i === highlightIdx ? '#06b6d4' : 'rgba(6,182,212,.6)';
      ctx.fill();
      if (i === highlightIdx) {
        ctx.fillStyle = '#06b6d4';
        ctx.font = 'bold 10px var(--ff-mono, monospace)';
        ctx.textAlign = 'left';
        ctx.fillText((v > 0 ? '+' : '') + v + 'pp (30% mask)', x + 8, y - 2);
      }
    });
    diff10.forEach((v, i) => {
      const x = xPos(i), y = yPos(v);
      ctx.beginPath(); ctx.arc(x, y, i === highlightIdx ? 6 : 4, 0, Math.PI * 2);
      ctx.fillStyle = i === highlightIdx ? '#10b981' : 'rgba(16,185,129,.6)';
      ctx.fill();
      if (i === highlightIdx) {
        ctx.fillStyle = '#10b981';
        ctx.font = 'bold 10px var(--ff-mono, monospace)';
        ctx.textAlign = 'left';
        ctx.fillText((v > 0 ? '+' : '') + v + 'pp (10% mask)', x + 8, y + 14);
      }
    });

    // Legend
    ctx.font = '10px var(--ff-mono, monospace)';
    ctx.textAlign = 'left';
    // 30% masking
    ctx.fillStyle = '#06b6d4'; ctx.fillRect(pad.l, pad.t, 14, 2);
    ctx.fillText('30% masking', pad.l + 18, pad.t + 5);
    // 10% masking
    ctx.fillStyle = '#10b981'; ctx.fillRect(pad.l + 110, pad.t, 14, 2);
    ctx.fillText('10% masking', pad.l + 128, pad.t + 5);
    // 50% masking
    ctx.fillStyle = 'rgba(255,255,255,0.3)';
    ctx.fillRect(pad.l + 220, pad.t, 14, 2);
    ctx.fillStyle = '#6b7280';
    ctx.fillText('50% mask (ref)', pad.l + 238, pad.t + 5);

    // Crossover annotation at 100%
    if (highlightIdx === 3) {
      ctx.fillStyle = '#a78bfa';
      ctx.font = 'bold 10px var(--ff-mono, monospace)';
      ctx.textAlign = 'right';
      ctx.fillText('← crossover!', xPos(3) - 8, yPos(1.2) - 14);
    }
  }

  draw();

  // Buttons
  document.querySelectorAll('.scale-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.scale-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      highlightIdx = parseInt(btn.dataset.idx);
      draw();
    });
  });
})();

/* ─────────────────────────────────────────────────
   §02 Collapse bars — IntersectionObserver trigger
───────────────────────────────────────────────── */
const collapseSec = document.getElementById('s-collapse');
if (collapseSec) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        // The bars scale to their bar width relative to 30 (max displayed)
        const maxVal = 30;
        ['cb0','cb1','cb2','cb3','cb4','cb5'].forEach(id => {
          const bar = document.getElementById(id);
          if (bar) {
            const w = parseFloat(bar.dataset.w);
            bar.style.width = (w / maxVal * 100) + '%';
          }
        });
      }
    });
  }, { threshold: 0.3 }).observe(collapseSec);
}

/* ─────────────────────────────────────────────────
   §04 Delta Canvas — frame/delta animation
───────────────────────────────────────────────── */
(function() {
  const canvas = document.getElementById('delta-canvas');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 240;
  canvas.width = W * DPR; canvas.height = H * DPR;
  const ctx = canvas.getContext('2d');
  ctx.scale(DPR, DPR);

  // 5 simulated frames of a dog (amber) + frisbee (cyan) moving right
  // Grid is 10x7, each cell ~18px wide, ~18px tall
  // Three panels side by side: frame_t, delta, latent shift
  const FRAMES = 5;
  let frameIdx = 0;
  let animTimer = null;
  let playing = false;

  // Scene: 10 columns × 7 rows grid
  // Dog occupies cols [1..3], rows [3..5] at frame 0, shifts right by 1 col per frame
  // Frisbee occupies col [7], row [1] at frame 0, shifts right by 1 col per frame
  function sceneAtFrame(f) {
    const grid = Array.from({length: 7}, () => new Array(10).fill(0));
    // 0=background, 1=dog, 2=frisbee
    const dogCols = [1+f, 2+f, 3+f];
    const dogRows = [2, 3, 4, 5];
    const frisbeeCols = [7+f > 9 ? 9 : 7+f];
    dogCols.forEach(c => { if (c >= 0 && c < 10) dogRows.forEach(r => { grid[r][c] = 1; }); });
    frisbeeCols.forEach(c => { if (c >= 0 && c < 10) { grid[1][c] = 2; grid[2][c] = 2; } });
    return grid;
  }

  const COLS = 10, ROWS = 7;
  const panelW = Math.floor(W / 3) - 8;
  const cellW = Math.floor(panelW / COLS);
  const cellH = Math.floor((H - 48) / ROWS);
  const panelY = 32;

  const cellColors = [
    'rgba(30,28,50,1)',   // 0 = background
    'rgba(245,158,11,.85)', // 1 = dog (amber)
    'rgba(6,182,212,.85)',  // 2 = frisbee (cyan)
  ];
  const deltaColors = [
    'rgba(30,28,50,1)',   // 0 = no change
    'rgba(245,158,11,.8)', // positive
    'rgba(139,92,246,.8)', // negative
  ];

  function drawGrid(offX, grid) {
    for (let r = 0; r < ROWS; r++) {
      for (let c = 0; c < COLS; c++) {
        const x = offX + c * cellW, y = panelY + r * cellH;
        ctx.fillStyle = cellColors[grid[r][c]];
        ctx.fillRect(x, y, cellW - 1, cellH - 1);
      }
    }
  }

  function drawDeltaGrid(offX, g1, g2) {
    for (let r = 0; r < ROWS; r++) {
      for (let c = 0; c < COLS; c++) {
        const diff = g2[r][c] - g1[r][c];
        const x = offX + c * cellW, y = panelY + r * cellH;
        if (diff === 0) ctx.fillStyle = 'rgba(30,28,50,1)';
        else if (diff > 0) ctx.fillStyle = 'rgba(245,158,11,.8)';
        else ctx.fillStyle = 'rgba(139,92,246,.8)';
        ctx.fillRect(x, y, cellW - 1, cellH - 1);
      }
    }
  }

  function drawLatentShift(offX, f) {
    // Abstract latent space: show a small space with z_t dot, arrow, ẑ_{t+1} dot
    const cx = offX + panelW / 2;
    const cy = panelY + (ROWS * cellH) / 2;
    const shift = f * 14;

    // z_t dot
    const ztX = cx - 40, ztY = cy + 20;
    ctx.beginPath(); ctx.arc(ztX, ztY, 7, 0, Math.PI * 2);
    ctx.fillStyle = '#8b5cf6'; ctx.fill();
    ctx.fillStyle = '#a78bfa';
    ctx.font = '9px var(--ff-mono, monospace)';
    ctx.textAlign = 'center';
    ctx.fillText('zₜ', ztX, ztY + 18);

    // Arrow showing Δz
    const arrEndX = ztX + 30 + (f > 0 ? 12 : 0), arrEndY = ztY - 15;
    ctx.beginPath(); ctx.moveTo(ztX + 8, ztY - 5);
    ctx.lineTo(arrEndX - 6, arrEndY + 3);
    ctx.strokeStyle = '#06b6d4'; ctx.lineWidth = 2; ctx.stroke();
    // arrowhead
    ctx.beginPath();
    ctx.moveTo(arrEndX, arrEndY);
    ctx.lineTo(arrEndX - 8, arrEndY + 6);
    ctx.lineTo(arrEndX - 4, arrEndY + 10);
    ctx.closePath(); ctx.fillStyle = '#06b6d4'; ctx.fill();
    // Δz label
    ctx.fillStyle = '#06b6d4';
    ctx.font = '9px var(--ff-mono, monospace)';
    ctx.fillText('Δz', (ztX + 8 + arrEndX) / 2 - 8, (ztY - 5 + arrEndY) / 2 - 4);

    // ẑ_{t+1} dot
    ctx.beginPath(); ctx.arc(arrEndX + 4, arrEndY - 4, 7, 0, Math.PI * 2);
    ctx.fillStyle = '#10b981'; ctx.fill();
    ctx.fillStyle = '#34d399';
    ctx.font = '9px var(--ff-mono, monospace)';
    ctx.textAlign = 'center';
    ctx.fillText('ẑₜ₊₁', arrEndX + 4, arrEndY - 4 + 18);

    // Panel label
    ctx.fillStyle = '#6b7280';
    ctx.font = '9px var(--ff-mono, monospace)';
    ctx.textAlign = 'center';
    ctx.fillText('Latent Space', cx, panelY + ROWS * cellH + 16);
    ctx.fillStyle = '#374151';
    ctx.font = '8px var(--ff-mono, monospace)';
    ctx.fillText('zₜ + Δzₜ = ẑₜ₊₁', cx, panelY + ROWS * cellH + 26);
  }

  function drawFrame() {
    ctx.clearRect(0, 0, W, H);

    const f = frameIdx;
    const g0 = sceneAtFrame(f);
    const g1 = f < FRAMES - 1 ? sceneAtFrame(f + 1) : sceneAtFrame(f);

    const off0 = 4;
    const off1 = off0 + panelW + 8;
    const off2 = off1 + panelW + 8;

    // Panel borders
    [off0, off1, off2].forEach(ox => {
      ctx.strokeStyle = 'rgba(55,65,81,.7)';
      ctx.lineWidth = 1;
      ctx.strokeRect(ox, panelY, panelW, ROWS * cellH);
    });

    // Frame t
    drawGrid(off0, g0);
    ctx.fillStyle = '#6b7280'; ctx.font = '10px var(--ff-mono, monospace)'; ctx.textAlign = 'left';
    ctx.fillText('Frame t', off0, panelY - 8);
    ctx.fillStyle = '#374151'; ctx.font = '8px var(--ff-mono, monospace)';
    ctx.fillText('x_t  (full scene)', off0, panelY - 0);

    // Delta
    drawDeltaGrid(off1, g0, g1);
    ctx.fillStyle = '#6b7280'; ctx.font = '10px var(--ff-mono, monospace)'; ctx.textAlign = 'left';
    ctx.fillText('Δx_t = x_{t+1} − x_t', off1, panelY - 8);
    ctx.fillStyle = '#374151'; ctx.font = '8px var(--ff-mono, monospace)';
    ctx.fillText('sparse — only edges of motion', off1, panelY - 0);

    // Latent shift
    drawLatentShift(off2, f);
    ctx.fillStyle = '#6b7280'; ctx.font = '10px var(--ff-mono, monospace)'; ctx.textAlign = 'left';
    ctx.fillText('z_t + Δz_t → ẑ_{t+1}', off2, panelY - 8);

    // Frame label
    document.getElementById('delta-label').textContent =
      'Frame ' + f + ' of ' + (FRAMES - 1);
  }

  drawFrame();

  document.getElementById('delta-play')?.addEventListener('click', () => {
    if (playing) {
      playing = false;
      clearInterval(animTimer);
      document.getElementById('delta-play').textContent = '▶ Play';
    } else {
      playing = true;
      document.getElementById('delta-play').textContent = '⏸ Pause';
      animTimer = setInterval(() => {
        frameIdx = (frameIdx + 1) % FRAMES;
        drawFrame();
        if (frameIdx === FRAMES - 1) {
          playing = false;
          clearInterval(animTimer);
          document.getElementById('delta-play').textContent = '▶ Play';
        }
      }, 700);
    }
  });

  document.getElementById('delta-reset')?.addEventListener('click', () => {
    playing = false;
    clearInterval(animTimer);
    document.getElementById('delta-play').textContent = '▶ Play';
    frameIdx = 0;
    drawFrame();
  });
})();

/* ─────────────────────────────────────────────────
   §05 Results bars — IntersectionObserver trigger
   Bars are normalized differently per group:
   - Optical flow: 14 EPE = 100% track, bars show proportional length
     (lower EPE = shorter bar = better, so we invert for display)
   - Stereo: raw percentage
   - Seg: raw mIoU out of 11
   We use data-w already set as display-percentage.
───────────────────────────────────────────────── */
const resultsSec = document.getElementById('s-results');
if (resultsSec) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('#results-bars .bar-fill').forEach(b => {
          b.style.width = b.dataset.w + '%';
        });
      }
    });
  }, { threshold: 0.2 }).observe(resultsSec);
}
</script>
</BaseLayout>

<span class="cs-line">        </span>
<span class="cs-line cmt">        # P: Mean pooling along sequence length axis</span>
<span class="cs-line hl-c">        pooled = torch.mean(token_embeddings, dim=<span class="num">0</span>)</span>
<span class="cs-line">        </span>
<span class="cs-line cmt">        # f: Linear projection to target dimension</span>
<span class="cs-line hl-g">        output_emb = <span class="kw">self</span>.projection(pooled)</span>
<span class="cs-line">        </span>
<span class="cs-line cmt">        # Normalize for cosine similarity metrics</span>

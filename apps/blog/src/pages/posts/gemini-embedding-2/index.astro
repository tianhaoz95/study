<span class="cs-line">            </span>
<span class="cs-line cmt">            # Re-normalize sliced representations</span>
<span class="cs-line">            q_sub = q_sub / q_sub.norm(dim=-<span class="num">1</span>, keepdim=<span class="kw">True</span>)</span>
<span class="cs-line">            p_sub = p_sub / p_sub.norm(dim=-<span class="num">1</span>, keepdim=<span class="kw">True</span>)</span>
<span class="cs-line">            </span>
<span class="cs-line hl-g">            total_loss += info_nce_loss(q_sub, p_sub, labels)</span>
<span class="cs-line">            </span>

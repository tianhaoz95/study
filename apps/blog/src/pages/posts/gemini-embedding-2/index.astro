<span class="cs-line">        <span class="kw">for</span> dim <span class="kw">in</span> <span class="kw">self</span>.sub_dims:</span>
<span class="cs-line cmt">            # Slice embeddings and compute loss for each sub-dimension</span>
<span class="cs-line hl-p">            q_sub = queries[:, :dim]</span>

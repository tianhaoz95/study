    <div class="cs-panel" id="panel-maskedloss">
      <pre class="cs-pre"><span class="cs-line"><span class="kw">import</span> torch</span>
<span class="cs-line"><span class="kw">import</span> torch.nn.functional <span class="kw">as</span> F</span>
<span class="cs-line"></span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">label_masked_contrastive_loss</span>(queries, positives, negatives, labels, tau=<span class="num">0.07</span>):</span>
<span class="cs-line">    B = queries.shape[<span class="num">0</span>]</span>
<span class="cs-line">    </span>
<span class="cs-line cmt">    # pairwise similarities</span>
<span class="cs-line">    sim_qp_pos = torch.sum(queries * positives, dim=-<span class="num">1</span>)</span>
<span class="cs-line">    sim_qp_neg = torch.sum(queries * negatives, dim=-<span class="num">1</span>) <span class="kw">if</span> negatives <span class="kw">is</span> <span class="kw">not</span> <span class="kw">None</span> <span class="kw">else</span> <span class="num">0.0</span></span>
<span class="cs-line">    sim_batch = torch.matmul(queries, positives.T)</span>
<span class="cs-line">    </span>
<span class="cs-line cmt">    # Create mask: 1.0 if labels differ, else 0.0</span>
<span class="cs-line hl-p">    label_mask = (labels.unsqueeze(<span class="num">1</span>) != labels.unsqueeze(<span class="num">0</span>)).float()</span>
<span class="cs-line">    label_mask.fill_diagonal_(<span class="num">0.0</span>)</span>
<span class="cs-line">    </span>
<span class="cs-line">    pos_exp = torch.exp(sim_qp_pos / tau)</span>
<span class="cs-line">    neg_exp = torch.exp(sim_qp_neg / tau) <span class="kw">if</span> negatives <span class="kw">is</span> <span class="kw">not</span> <span class="kw">None</span> <span class="kw">else</span> <span class="num">0.0</span></span>
<span class="cs-line hl-c">    batch_exp = torch.sum(torch.exp(sim_batch / tau) * label_mask, dim=-<span class="num">1</span>)</span>
<span class="cs-line">    </span>
<span class="cs-line hl-g">    loss = -torch.log(pos_exp / (pos_exp + neg_exp + batch_exp))</span>
<span class="cs-line">    <span class="kw">return</span> torch.mean(loss)</span></pre>
    </div>


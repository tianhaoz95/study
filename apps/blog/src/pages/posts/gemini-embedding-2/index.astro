const btnAsr = document.getElementById('btn-asr');
const btnNative = document.getElementById('btn-native');
const pStatus = document.getElementById('pipeline-status');

if (canvasWaveform) {
  const ctx = canvasWaveform.getContext('2d');
  let animationId;
  let t = 0;
  let mode = 'asr'; // 'asr' or 'native'

  function resizeWaveform() {
    const W = canvasWaveform.clientWidth, H = 120, DPR = window.devicePixelRatio || 1;
    canvasWaveform.width = W * DPR;
    canvasWaveform.height = H * DPR;
    ctx.scale(DPR, DPR);
  }
  resizeWaveform();
  window.addEventListener('resize', resizeWaveform);

  function drawWaveform() {
    const W = canvasWaveform.width / (window.devicePixelRatio || 1);
    const H = 120;
    ctx.clearRect(0, 0, W, H);
    
    // Draw background grid lines
    ctx.strokeStyle = 'rgba(255, 255, 255, 0.03)';
    ctx.lineWidth = 1;
    for (let x = 0; x < W; x += 40) {
      ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, H); ctx.stroke();
    }

    // Waveform envelope
    ctx.strokeStyle = mode === 'asr' ? '#f59e0b' : '#06b6d4';
    ctx.lineWidth = 2.5;
    ctx.beginPath();
    ctx.moveTo(0, H / 2);

    for (let x = 0; x < W; x++) {
      const envelope = Math.sin(x * 0.015) * Math.cos(x * 0.005) * 35;
      const noise = (Math.sin(x * 0.15 + t) + Math.cos(x * 0.3 - t * 0.5)) * 8;
      const y = H / 2 + (envelope + noise) * Math.sin(t * 0.05 + x * 0.005);
      ctx.lineTo(x, y);
    }
    ctx.stroke();

    t += 0.5;
    animationId = requestAnimationFrame(drawWaveform);
  }
  drawWaveform();

  function updateStatusText() {
    if (mode === 'asr') {
      pStatus.innerHTML = `
        <span style="color:var(--amber);">[ASR Pipeline]</span> Waveform parsed phonetically...<br>
        <span style="color:var(--muted);">↳ Phonetic Ambiguity:</span> "/rɛk ə naɪs biːtʃ/" committed to transcription.<br>
        <span style="color:var(--amber);">↳ Transcribed Query:</span> <strong style="color:var(--text)">"wreck a nice beach"</strong><br>
        <span style="color:var(--red);">↳ Retrieval Results:</span> 1. Seaside Vacations (0.87) | 2. Sandy Shores (0.76) | 3. Speech Technology (0.12) <span style="font-weight:bold; color:var(--red);">[FAILED]</span>
      `;
    } else {
      pStatus.innerHTML = `
        <span style="color:var(--cyan);">[Native Multimodal]</span> Continuous acoustic signal tokenized natively...<br>
        <span style="color:var(--muted);">↳ Phonetic Ambiguity:</span> Waveform characteristics preserved in dense embedding space.<br>
        <span style="color:var(--cyan);">↳ Embedding Vector:</span> <strong style="color:var(--text)">[0.12, -0.45, 0.89, ... 3072 dimensions]</strong><br>
        <span style="color:var(--green);">↳ Retrieval Results:</span> 1. Speech Recognition (0.91) <span style="font-weight:bold; color:var(--green);">[SUCCESS]</span> | 2. Acoustic Processing (0.78) | 3. Seaside (0.04)
      `;
    }
  }
  updateStatusText();

  btnAsr?.addEventListener('click', () => {
    mode = 'asr';
    btnAsr.classList.add('active');
    btnNative.classList.remove('active');
    updateStatusText();
  });

  btnNative?.addEventListener('click', () => {
    mode = 'native';
    btnNative.classList.add('active');
    btnAsr.classList.remove('active');
    updateStatusText();
  });
}

// ----------------------------------------------------
// Section 2: SVG Architecture Interactions
// ----------------------------------------------------
const archExplanation = document.getElementById('arch-explanation');
document.querySelectorAll('.arch-node').forEach(node => {
  node.addEventListener('mouseenter', () => {
    document.querySelectorAll('.arch-node').forEach(n => n.classList.remove('arch-active'));
    node.classList.add('arch-active');
    const desc = node.getAttribute('data-desc');
    if (archExplanation && desc) {
      archExplanation.textContent = desc;
    }
  });
});

// ----------------------------------------------------
// Section 3: Contrastive Loss Matrix Grid
// ----------------------------------------------------
const matrixGrid = document.getElementById('matrix-grid');
const matrixExp = document.getElementById('matrix-explanation');

const samples = [
  { label: 'Dog', query: 'Img: Golden Retriever', target: 'Txt: Dog chasing ball' },
  { label: 'Dog', query: 'Audio: Barking clip', target: 'Txt: Canine vocalization' },
  { label: 'Cat', query: 'Txt: Siamese kitten', target: 'Img: Tabby cat sleeping' },
  { label: 'Cat', query: 'Img: Persian cat', target: 'Txt: Feline groom action' },
  { label: 'Car', query: 'Txt: Electric sedan', target: 'Img: EV highway cruise' }
];

if (matrixGrid) {
  // Clear and inject matrix
  matrixGrid.innerHTML = '';
  // Top header row
  matrixGrid.appendChild(createCell('', 'matrix-hdr'));
  for (let c = 0; c < 4; c++) {
    matrixGrid.appendChild(createCell('T' + (c+1), 'matrix-hdr'));
  }

  for (let r = 0; r < 4; r++) {
    matrixGrid.appendChild(createCell('Q' + (r+1), 'matrix-hdr'));
    for (let c = 0; c < 4; c++) {
      let cellClass = 'neg';
      let cellText = 'Neg';
      if (r === c) {
        cellClass = 'pos';
        cellText = 'Pos';
      } else if (samples[r].label === samples[c].label) {
        cellClass = 'masked';
        cellText = 'Mask';
      }
      
      const cell = createCell(cellText, cellClass);
      cell.setAttribute('data-r', r);
      cell.setAttribute('data-c', c);
      matrixGrid.appendChild(cell);
    }
  }

  function createCell(text, className) {
    const el = document.createElement('div');
    el.className = 'matrix-cell ' + className;
    el.textContent = text;
    return el;
  }

  matrixGrid.querySelectorAll('.matrix-cell:not(.matrix-hdr)').forEach(cell => {
    cell.addEventListener('mouseenter', () => {
      const r = parseInt(cell.getAttribute('data-r'));
      const c = parseInt(cell.getAttribute('data-c'));
      const q = samples[r];
      const t = samples[c];

      let info = '';
      if (r === c) {
        info = `<span style="color:var(--green); font-weight:bold;">Query Q${r+1} & Target T${c+1} (${q.label}):</span> Direct ground truth positive pair. Gradient pulls these embeddings together.`;
      } else if (q.label === t.label) {
        info = `<span style="color:var(--amber); font-weight:bold;">Query Q${r+1} & Target T${c+1} (Both are "${q.label}"):</span> <strong style="color:var(--amber);">Masked Denominator!</strong> Prevented from pushing apart similar labels.`;
      } else {
        info = `<span style="color:var(--muted);">Query Q${r+1} (${q.label}) & Target T${c+1} (${t.label}):</span> Standard negative pair. Gradient pushes these embeddings apart.`;
      }
      if (matrixExp) {
        matrixExp.innerHTML = info;
      }
    });
  });
}

// ----------------------------------------------------
// Section 4: MRL Canvas (Dim slider)
// ----------------------------------------------------
const canvasMrl = document.getElementById('canvas-mrl');
const sliderMrl = document.getElementById('slider-mrl');
const valMrl = document.getElementById('val-mrl');

if (canvasMrl) {
  const ctx = canvasMrl.getContext('2d');
  const dims = [128, 768, 3072];

  // Raw data representing 2D t-SNE coordinate trajectories for different dims
  const concepts = [
    { text: 'Cat',   label: 'Felines', coords: [[80, 160], [100, 70],  [100, 60]] },
    { text: 'Kitten',label: 'Felines', coords: [[280, 70],  [110, 85],  [120, 70]] },
    { text: 'Dog',   label: 'Canines', coords: [[120, 70],  [160, 80],  [200, 160]] },
    { text: 'Puppy', label: 'Canines', coords: [[380, 190], [175, 95],  [220, 175]] },
    { text: 'Car',   label: 'Vehicles',coords: [[220, 150], [380, 140], [380, 130]] },
    { text: 'Truck', label: 'Vehicles',coords: [[85, 80],   [400, 160], [400, 150]] }
  ];

  function resizeMrl() {
    const W = canvasMrl.clientWidth, H = 260, DPR = window.devicePixelRatio || 1;
    canvasMrl.width = W * DPR;
    canvasMrl.height = H * DPR;
    ctx.scale(DPR, DPR);
  }
  resizeMrl();
  window.addEventListener('resize', resizeMrl);

  function drawMrl(step) {
    const W = canvasMrl.width / (window.devicePixelRatio || 1);
    const H = 260;
    ctx.clearRect(0, 0, W, H);

    // Draw clustered circles or regions at higher dimensions
    if (step >= 1) {
      // Draw clusters background
      ctx.fillStyle = 'rgba(139, 92, 246, 0.03)';
      ctx.beginPath(); ctx.arc(140, 100, 90, 0, Math.PI * 2); ctx.fill(); // Animals region
      ctx.fillStyle = 'rgba(6, 182, 212, 0.03)';
      ctx.beginPath(); ctx.arc(390, 140, 65, 0, Math.PI * 2); ctx.fill(); // Vehicles region
      ctx.font = '9px var(--ff-mono)';
      ctx.fillStyle = 'rgba(139, 92, 246, 0.4)';
      ctx.fillText('ANIMALS CLUSTER', 90, 190);
      ctx.fillStyle = 'rgba(6, 182, 212, 0.4)';
      ctx.fillText('VEHICLES CLUSTER', 340, 215);
    }

    concepts.forEach(pt => {
      const coord = pt.coords[step];
      const x = coord[0];
      const y = coord[1];
      
      let color = '#a78bfa';
      if (pt.label === 'Canines') color = '#ec4899';
      if (pt.label === 'Vehicles') color = '#22d3ee';

      // Draw dot
      ctx.fillStyle = color;
      ctx.beginPath();
      ctx.arc(x, y, 6, 0, Math.PI * 2);
      ctx.fill();

      // Draw label text
      ctx.font = '10px var(--ff-mono)';
      ctx.fillStyle = '#fff';
      ctx.fillText(pt.text, x + 10, y + 4);
    });
  }

  drawMrl(2);

  sliderMrl?.addEventListener('input', (e) => {
    const step = parseInt(e.target.value);
    if (valMrl) valMrl.textContent = String(dims[step]);
    drawMrl(step);
  });
}

// ----------------------------------------------------
// Section 5: Model Soup Curve Plotter Canvas
// ----------------------------------------------------
const canvasSoup = document.getElementById('canvas-soup');
const sliderSoup = document.getElementById('slider-soup');
const valSoup = document.getElementById('val-soup');

if (canvasSoup) {
  const ctx = canvasSoup.getContext('2d');
  
  // Baseline vs Fine-tuned vs Souped values from Table 6
  // w_ft varies from 0 to 1
  // We can interpolate performance curves
  function getScores(w_ft) {
    // w_ft is slider position [0, 1]
    // MSR-VTT: 68.2 (0.0) -> FT MV (76.1) or Souped 1:1 (73.7) -> 76.1 (1.0)
    // YouCook2: 55.9 (0.0) -> FT MV (55.3) or Souped 1:1 (56.8) -> 55.3 (1.0)
    // Vatex: 69.2 (0.0) -> FT MV (79.5) or Souped 1:1 (76.8) -> 79.5 (1.0)
    let msr, yck, vtx;
    if (w_ft <= 0.5) {
      const p = w_ft / 0.5;
      msr = 68.2 + (73.7 - 68.2) * p;
      yck = 55.9 + (56.8 - 55.9) * p; // Peaks at 56.8 at ratio 0.5!
      vtx = 69.2 + (76.8 - 69.2) * p;
    } else {
      const p = (w_ft - 0.5) / 0.5;
      msr = 73.7 + (76.1 - 73.7) * p;
      yck = 56.8 - (56.8 - 55.3) * p;
      vtx = 76.8 + (79.5 - 76.8) * p;
    }
    return { msr, yck, vtx };
  }

  function resizeSoup() {
    const W = canvasSoup.clientWidth, H = 240, DPR = window.devicePixelRatio || 1;
    canvasSoup.width = W * DPR;
    canvasSoup.height = H * DPR;
    ctx.scale(DPR, DPR);
  }
  resizeSoup();
  window.addEventListener('resize', resizeSoup);

  function drawSoup(currentRatio) {
    const W = canvasSoup.width / (window.devicePixelRatio || 1);
    const H = 240;
    ctx.clearRect(0, 0, W, H);

    const pad = 40;
    const plotW = W - pad * 2;
    const plotH = H - pad * 2;

    // Draw axes
    ctx.strokeStyle = 'rgba(255, 255, 255, 0.1)';
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(pad, pad);
    ctx.lineTo(pad, H - pad);
    ctx.lineTo(W - pad, H - pad);
    ctx.stroke();

    // Draw grid lines
    ctx.strokeStyle = 'rgba(255, 255, 255, 0.03)';
    ctx.lineWidth = 1;
    for (let i = 1; i <= 4; i++) {
      const y = pad + (plotH / 4) * i;
      ctx.beginPath(); ctx.moveTo(pad, y); ctx.lineTo(W - pad, y); ctx.stroke();
    }

    // Min and Max scores to map: 50% to 85%
    function mapY(score) {
      const pct = (score - 50) / 35; // map [50, 85] to [0, 1]
      return H - pad - pct * plotH;
    }

    // Plot curves
    const msrPoints = [];
    const yckPoints = [];
    const vtxPoints = [];

    for (let r = 0; r <= 1.0; r += 0.05) {
      const x = pad + r * plotW;
      const scores = getScores(r);
      msrPoints.push([x, mapY(scores.msr)]);
      yckPoints.push([x, mapY(scores.yck)]);
      vtxPoints.push([x, mapY(scores.vtx)]);
    }

    function drawLine(pts, color, label) {
      ctx.strokeStyle = color;
      ctx.lineWidth = 2.5;
      ctx.beginPath();
      ctx.moveTo(pts[0][0], pts[0][1]);
      for (let i = 1; i < pts.length; i++) {
        ctx.lineTo(pts[i][0], pts[i][1]);
      }
      ctx.stroke();
      
      // Label line at end
      ctx.fillStyle = color;
      ctx.font = '9px var(--ff-mono)';
      ctx.fillText(label, pts[pts.length - 1][0] - 45, pts[pts.length - 1][1] - 8);
    }

    drawLine(msrPoints, '#c678dd', 'MSR-VTT');
    drawLine(vtxPoints, '#61afef', 'Vatex');
    drawLine(yckPoints, '#98c379', 'YouCook2');

    // Draw vertical slider indicator
    const currentX = pad + currentRatio * plotW;
    ctx.strokeStyle = 'rgba(255, 255, 255, 0.3)';
    ctx.lineWidth = 1.5;
    ctx.setLineDash([5, 5]);
    ctx.beginPath();
    ctx.moveTo(currentX, pad);
    ctx.lineTo(currentX, H - pad);
    ctx.stroke();
    ctx.setLineDash([]);

    // Draw values at current position
    const currentScores = getScores(currentRatio);
    ctx.fillStyle = '#fff';
    ctx.font = '9px var(--ff-mono)';
    ctx.fillText(`MSR-VTT: ${currentScores.msr.toFixed(1)}%`, currentX + 8, mapY(currentScores.msr) - 5);
    ctx.fillText(`Vatex: ${currentScores.vtx.toFixed(1)}%`, currentX + 8, mapY(currentScores.vtx) - 5);
    ctx.fillText(`YouCook2: ${currentScores.yck.toFixed(1)}%`, currentX + 8, mapY(currentScores.yck) + 12);
  }

  drawSoup(0.5);

  sliderSoup?.addEventListener('input', (e) => {
    const r = parseFloat(e.target.value);
    if (valSoup) valSoup.textContent = r.toFixed(2);
    drawSoup(r);
  });
}

// ----------------------------------------------------
// Section 6: Results Bars Intersect Trigger
// ----------------------------------------------------
const barsSection = document.getElementById('s-results');
if (barsSection) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          b.style.width = b.getAttribute('data-w') + '%';
        });
      }
    });
  }, { threshold: 0.2 }).observe(barsSection);
}
</script>
</BaseLayout>

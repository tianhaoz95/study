    <div class="cs-panel" id="panel-theory">
      <pre class="cs-pre">
<span class="cs-line cmt"># Theorem 1: Global Reachability</span>
<span class="cs-line cmt"># Model agent am as random walk on graph G_m</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Transition: mix of local walk + teleportation</span>
<span class="cs-line hl-p">M_ℓ = α_ℓ * T + (1-α_ℓ) * h @ 1.T</span>
<span class="cs-line cmt"># T = E-pool similarity transition matrix</span>
<span class="cs-line cmt"># h = X-pool LLM prior (h_i > 0 for all i)</span>
<span class="cs-line cmt"># α_ℓ = w_E / (w_E + w_X) &lt; 1</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Since h_i > 0 everywhere → M_ℓ is</span>
<span class="cs-line cmt"># strictly positive → irreducible Markov chain</span>
<span class="cs-line hl-c">assert all(M_ℓ[i,j] &gt; 0 for i,j in V_m×V_m)</span>
<span class="cs-line hl-c"><span class="cmt"># ∴ any strategy reachable from any start</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Theorem 2: Logarithmic Regret</span>
<span class="cs-line cmt"># Routing = stochastic bandit (2 arms: E, X)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Cumulative regret vs optimal α*:</span>
<span class="cs-line hl-g">R(T) = Σ_t [r(α*) - E[r(α_t)]]</span>
<span class="cs-line hl-g">E[R(T)] = O(log T)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Lower bound (Lai & Robbins 1985):</span>
<span class="cs-line cmt"># Any policy must incur Ω(log T) regret</span>
<span class="cs-line cmt"># ∴ DecentMem is order-optimal (matches lb)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Key insight: each agent converges to its</span>
<span class="cs-line cmt"># OWN α* — not a shared global optimum</span>
      </pre>
    </div>


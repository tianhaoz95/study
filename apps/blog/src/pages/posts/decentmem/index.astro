});
const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

/* ── Code sidebar tabs ── */
const tabMeta = {
  problem: { file: 'decentmem/problem.py',  title: 'Homogenization Problem' },
  design:  { file: 'decentmem/design.py',   title: 'Dual-Pool Design' },
  router:  { file: 'decentmem/router.py',   title: 'Online Routing' },
  theory:  { file: 'decentmem/theory.py',   title: 'Theoretical Guarantees' },
  results: { file: 'decentmem/results.py',  title: 'Results' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

/* ── IntersectionObserver: TOC + sidebar sync ── */
const sectionMap = {
  's-problem': 'problem',
  's-design':  'design',
  's-router':  'router',
  's-theory':  'theory',
  's-results': 'results',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

/* ── §01 Homogenization canvas ── */
function seededRand(n) {
  return ((1664525 * n + 1013904223) & 0x7fffffff) / 0x7fffffff;
}

const AGENTS = [
  { label: 'A₁ Planner', color: '#8b5cf6', homeX: 0.2, homeY: 0.25 },
  { label: 'A₂ Coder',   color: '#06b6d4', homeX: 0.75, homeY: 0.2 },
  { label: 'A₃ Reviewer',color: '#10b981', homeX: 0.5, homeY: 0.78 },
];
const CENTER = { x: 0.5, y: 0.5 };

function drawStrategyCanvas(canvasEl, taskCount, isCentralized) {
  const DPR = window.devicePixelRatio || 1;
  const W = canvasEl.clientWidth;
  const H = Math.round(W * 0.62);
  if (canvasEl.width !== W * DPR || canvasEl.height !== H * DPR) {
    canvasEl.width  = W * DPR;
    canvasEl.height = H * DPR;
  }
  const ctx = canvasEl.getContext('2d');
  ctx.setTransform(DPR, 0, 0, DPR, 0, 0);

  // Background
  ctx.fillStyle = '#0d0d14';
  ctx.fillRect(0, 0, W, H);

  // Grid dots
  for (let gx = 0.1; gx <= 0.95; gx += 0.15) {
    for (let gy = 0.1; gy <= 0.95; gy += 0.15) {
      ctx.beginPath();
      ctx.arc(gx * W, gy * H, 1, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(255,255,255,0.04)';
      ctx.fill();
    }
  }

  const t = Math.min(taskCount / 30, 1);

  if (isCentralized) {
    // Draw "gravity well" at center that gets stronger
    const intensity = t;
    if (intensity > 0) {
      const grad = ctx.createRadialGradient(
        CENTER.x * W, CENTER.y * H, 5,
        CENTER.x * W, CENTER.y * H, W * 0.35 * intensity
      );
      grad.addColorStop(0, `rgba(107,114,128,${0.15 * intensity})`);
      grad.addColorStop(1, 'rgba(107,114,128,0)');
      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, W, H);
    }

    // Draw convergence label
    if (t > 0.5) {
      ctx.fillStyle = `rgba(107,114,128,${(t - 0.5) * 2 * 0.4})`;
      ctx.font = `bold ${Math.round(8 + t * 8)}px monospace`;
      ctx.textAlign = 'center';
      ctx.fillText('same strategy', CENTER.x * W, CENTER.y * H + 4);
    }
  } else {
    // Draw "home regions" for each agent
    AGENTS.forEach((a, i) => {
      const grad = ctx.createRadialGradient(
        a.homeX * W, a.homeY * H, 5,
        a.homeX * W, a.homeY * H, W * 0.22
      );
      const hex = a.color;
      grad.addColorStop(0, hex + '18');
      grad.addColorStop(1, hex + '00');
      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, W, H);
    });
  }

  AGENTS.forEach((a, i) => {
    let cx, cy;
    if (isCentralized) {
      // Drift toward center over tasks
      const ease = t * t * (3 - 2 * t);
      cx = a.homeX + (CENTER.x - a.homeX) * ease * 0.85;
      cy = a.homeY + (CENTER.y - a.homeY) * ease * 0.85;
    } else {
      // Stay in home region with small jitter per task
      const jx = (seededRand(i * 100 + taskCount) - 0.5) * 0.06;
      const jy = (seededRand(i * 100 + taskCount + 50) - 0.5) * 0.06;
      cx = a.homeX + jx;
      cy = a.homeY + jy;
    }

    const px = cx * W;
    const py = cy * H;

    // Trail for centralized
    if (isCentralized && t > 0) {
      ctx.beginPath();
      ctx.moveTo(a.homeX * W, a.homeY * H);
      ctx.lineTo(px, py);
      ctx.strokeStyle = a.color + '30';
      ctx.lineWidth = 1.5;
      ctx.stroke();
    }

    // Glow
    const glow = ctx.createRadialGradient(px, py, 2, px, py, 20);
    glow.addColorStop(0, a.color + '50');
    glow.addColorStop(1, a.color + '00');
    ctx.fillStyle = glow;
    ctx.beginPath();
    ctx.arc(px, py, 20, 0, Math.PI * 2);
    ctx.fill();

    // Dot
    ctx.beginPath();
    ctx.arc(px, py, 7, 0, Math.PI * 2);
    ctx.fillStyle = a.color;
    ctx.fill();

    // Label
    ctx.fillStyle = '#e5e7eb';
    ctx.font = 'bold 9px monospace';
    ctx.textAlign = 'center';
    ctx.fillText(a.label, px, py - 12);
  });
}

const centCanvas   = document.getElementById('cent-canvas');
const decentCanvas = document.getElementById('decent-canvas');
const taskSlider   = document.getElementById('task-slider');
const taskCount    = document.getElementById('task-count');
const centLabel    = document.getElementById('cent-label');

function redrawHomogenization() {
  const n = parseInt(taskSlider.value, 10);
  taskCount.textContent = n;
  const t = n / 30;
  if (t < 0.3) centLabel.textContent = `after ${n} tasks: still diverse`;
  else if (t < 0.65) centLabel.textContent = `after ${n} tasks: converging...`;
  else centLabel.textContent = `after ${n} tasks: homogenized ✗`;

  if (centCanvas)   drawStrategyCanvas(centCanvas,   n, true);
  if (decentCanvas) drawStrategyCanvas(decentCanvas, n, false);
}

taskSlider?.addEventListener('input', redrawHomogenization);
window.addEventListener('resize', redrawHomogenization);
requestAnimationFrame(redrawHomogenization);

/* ── §03 Online Router Simulator ── */
let wE = 1.0;
const wX = 1.0; // fixed
let history = [];

function routerAlpha() { return wE / (wE + wX); }

function updateRouterUI() {
  const alpha = routerAlpha();
  document.getElementById('we-val').textContent    = wE.toFixed(2);
  document.getElementById('alpha-val').textContent = alpha.toFixed(2);
  document.getElementById('alpha-formula').textContent =
    `${wE.toFixed(2)} / ${(wE + wX).toFixed(2)} = ${alpha.toFixed(2)}`;

  // Bar widths — E-pool fill proportional to wE in [1.0, 6.0]
  const weBarPct = Math.min(100, ((wE - 1.0) / 5.0) * 100);
  document.getElementById('we-bar').style.width   = weBarPct + '%';
  // Alpha bar
  document.getElementById('alpha-bar').style.width = (alpha * 100) + '%';

  // History dots
  const hist = document.getElementById('router-history');
  hist.innerHTML = history.slice(-50).map(h => {
    const bg  = h.pool === 'E' ? '#8b5cf6' : '#10b981';
    const bdr = h.success ? '' : `border:2px solid ${bg};background:transparent`;
    return `<span class="hist-dot" style="background:${h.success ? bg : 'transparent'};border:2px solid ${bg}" title="${h.pool}-pool ${h.success ? 'success' : 'fail'}">${h.pool}</span>`;
  }).join('');
}

function simTask(userPool) {
  const alpha = routerAlpha();
  const pool  = userPool || (Math.random() < alpha ? 'E' : 'X');
  // Stage-wise success: random with some bias based on pool usage history
  const successRate = pool === 'E'
    ? 0.5 + (wE - 1.0) * 0.06  // exploitation gets better as wE grows
    : 0.45;
  const success = Math.random() < successRate;
  const delta = success ? 1 : 0;

  if (pool === 'E') {
    if (delta === 1) wE = Math.min(wE + 0.5, 8.0);
    else             wE = Math.max(1.0, wE * 0.5);
  } else {
    if (delta === 1) wE = Math.max(1.0, wE * 0.5);
    else             wE = Math.min(wE + 0.5, 8.0);
  }

  history.push({ pool, success });

  const poolColor = pool === 'E' ? '#a78bfa' : '#6ee7b7';
  const outcome   = success ? '✓ success' : '✗ fail';
  document.getElementById('router-last').innerHTML =
    `→ used <strong style="color:${poolColor}">${pool}-pool</strong> · stage score ${success ? 'improved' : 'dropped'} · ${outcome}`;

  updateRouterUI();
}

document.getElementById('run-task-btn')?.addEventListener('click', () => simTask());
document.getElementById('run-10-btn')?.addEventListener('click', () => {
  for (let i = 0; i < 10; i++) simTask();
});
document.getElementById('router-reset-btn')?.addEventListener('click', () => {
  wE = 1.0; history = [];
  document.getElementById('router-last').textContent = '→ press "run task" to simulate';
  updateRouterUI();
});
updateRouterUI();

/* ── §04 Reachability graph ── */
const NODES = [
  { id: 0, x: 0.50, y: 0.12, label: 'v₁', group: 'opt' },
  { id: 1, x: 0.78, y: 0.28, label: 'v₂', group: 'opt' },
  { id: 2, x: 0.82, y: 0.58, label: 'v₃', group: 'opt' },
  { id: 3, x: 0.62, y: 0.82, label: 'v₄', group: 'opt' },
  { id: 4, x: 0.28, y: 0.28, label: 'v₅', group: 'trap' },
  { id: 5, x: 0.18, y: 0.55, label: 'v₆', group: 'trap' },
  { id: 6, x: 0.32, y: 0.76, label: 'v₇', group: 'trap' },
  { id: 7, x: 0.50, y: 0.50, label: 'v₈', group: 'mid' },
];
// Local edges — only within clusters + bridge
const LOCAL_EDGES = [[4,5],[5,6],[6,4],[4,7],[0,1],[1,2],[2,3]];

let reachMode = 'eonly'; // 'eonly' | 'dual'
let agentNode = 5; // agent starts at v6 (trap)
let walkInterval = null;

function drawReachCanvas() {
  const canvas = document.getElementById('reach-canvas');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth;
  const H = Math.round(W * 0.55);
  if (canvas.width !== W * DPR || canvas.height !== H * DPR) {
    canvas.width  = W * DPR;
    canvas.height = H * DPR;
  }
  const ctx = canvas.getContext('2d');
  ctx.setTransform(DPR, 0, 0, DPR, 0, 0);

  ctx.fillStyle = '#0d0d14';
  ctx.fillRect(0, 0, W, H);

  function nx(n) { return NODES[n].x * W; }
  function ny(n) { return NODES[n].y * H; }

  // Trap region highlight
  ctx.beginPath();
  ctx.ellipse(W * 0.25, H * 0.54, W * 0.17, H * 0.3, 0, 0, Math.PI * 2);
  ctx.fillStyle = 'rgba(239,68,68,0.06)';
  ctx.fill();
  ctx.strokeStyle = 'rgba(239,68,68,0.2)';
  ctx.lineWidth = 1;
  ctx.stroke();
  ctx.fillStyle = 'rgba(239,68,68,0.35)';
  ctx.font = '8px monospace';
  ctx.textAlign = 'center';
  ctx.fillText('trapped region', W * 0.25, H * 0.93);

  // Optimal region highlight
  ctx.beginPath();
  ctx.ellipse(W * 0.72, H * 0.46, W * 0.2, H * 0.38, 0.3, 0, Math.PI * 2);
  ctx.fillStyle = 'rgba(16,185,129,0.05)';
  ctx.fill();
  ctx.strokeStyle = 'rgba(16,185,129,0.15)';
  ctx.lineWidth = 1;
  ctx.stroke();
  ctx.fillStyle = 'rgba(16,185,129,0.3)';
  ctx.font = '8px monospace';
  ctx.textAlign = 'center';
  ctx.fillText('optimal region', W * 0.78, H * 0.93);

  // X-pool teleportation edges (dual mode only)
  if (reachMode === 'dual') {
    NODES.forEach((src, si) => {
      if (src.group !== 'trap') return;
      NODES.forEach((dst, di) => {
        if (dst.group !== 'opt') return;
        ctx.beginPath();
        ctx.moveTo(nx(si), ny(si));
        ctx.lineTo(nx(di), ny(di));
        ctx.strokeStyle = 'rgba(6,182,212,0.25)';
        ctx.lineWidth = 1;
        ctx.setLineDash([3, 4]);
        ctx.stroke();
        ctx.setLineDash([]);
      });
    });
  }

  // Local edges
  LOCAL_EDGES.forEach(([a, b]) => {
    ctx.beginPath();
    ctx.moveTo(nx(a), ny(a));
    ctx.lineTo(nx(b), ny(b));
    ctx.strokeStyle = 'rgba(255,255,255,0.2)';
    ctx.lineWidth = 1.5;
    ctx.stroke();
  });

  // Nodes
  NODES.forEach((n, i) => {
    const px = nx(i), py = ny(i);
    const color = n.group === 'opt' ? '#10b981' :
                  n.group === 'trap' ? '#ef4444' : '#6b7280';

    if (i === agentNode) {
      // Agent glow
      const glow = ctx.createRadialGradient(px, py, 5, px, py, 24);
      glow.addColorStop(0, '#8b5cf690');
      glow.addColorStop(1, '#8b5cf600');
      ctx.fillStyle = glow;
      ctx.beginPath();
      ctx.arc(px, py, 24, 0, Math.PI * 2);
      ctx.fill();
    }

    ctx.beginPath();
    ctx.arc(px, py, i === agentNode ? 10 : 7, 0, Math.PI * 2);
    ctx.fillStyle = i === agentNode ? '#8b5cf6' : color;
    ctx.fill();
    ctx.strokeStyle = 'rgba(255,255,255,0.2)';
    ctx.lineWidth = 1;
    ctx.stroke();

    ctx.fillStyle = i === agentNode ? '#fff' : '#9ca3af';
    ctx.font = `${i === agentNode ? 'bold ' : ''}8.5px monospace`;
    ctx.textAlign = 'center';
    ctx.fillText(n.label, px, py + 3);
  });

  if (reachMode === 'dual') {
    ctx.fillStyle = 'rgba(6,182,212,0.6)';
    ctx.font = '8px monospace';
    ctx.textAlign = 'left';
    ctx.fillText('⋯ X-pool teleport (reaches everywhere)', W * 0.02, H * 0.97);
  }
}

function stepAgent() {
  const node = NODES[agentNode];
  if (reachMode === 'eonly') {
    // Only local edges
    const neighbors = LOCAL_EDGES
      .filter(e => e[0] === agentNode || e[1] === agentNode)
      .map(e => e[0] === agentNode ? e[1] : e[0]);
    if (neighbors.length > 0) {
      agentNode = neighbors[Math.floor(Math.random() * neighbors.length)];
    }
  } else {
    // Dual: 60% local walk, 40% teleport
    if (Math.random() < 0.4) {
      // Teleport to any node
      agentNode = Math.floor(Math.random() * NODES.length);
    } else {
      const neighbors = LOCAL_EDGES
        .filter(e => e[0] === agentNode || e[1] === agentNode)
        .map(e => e[0] === agentNode ? e[1] : e[0]);
      if (neighbors.length > 0) {
        agentNode = neighbors[Math.floor(Math.random() * neighbors.length)];
      }
    }
  }
  drawReachCanvas();
}

function startWalk() {
  if (walkInterval) clearInterval(walkInterval);
  walkInterval = setInterval(stepAgent, 800);
}

document.getElementById('reach-btn-eonly')?.addEventListener('click', () => {
  reachMode = 'eonly';
  agentNode = 5;
  document.getElementById('reach-btn-eonly').classList.add('active');
  document.getElementById('reach-btn-dual').classList.remove('active');
  document.getElementById('reach-caption').textContent =
    'E-pool local walk: agent can only move along solid edges — trapped in the red cluster';
  drawReachCanvas();
  startWalk();
});
document.getElementById('reach-btn-dual')?.addEventListener('click', () => {
  reachMode = 'dual';
  agentNode = 5;
  document.getElementById('reach-btn-dual').classList.add('active');
  document.getElementById('reach-btn-eonly').classList.remove('active');
  document.getElementById('reach-caption').textContent =
    'Dual-pool: dashed X-pool teleportation lines reach all nodes — agent escapes to optimal region';
  drawReachCanvas();
  startWalk();
});

window.addEventListener('resize', drawReachCanvas);
requestAnimationFrame(() => { drawReachCanvas(); startWalk(); });

/* ── §05 Animated bar charts ── */
function triggerBars(sectionId) {
  const sec = document.getElementById(sectionId);
  if (!sec) return;
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        sec.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          b.style.width = b.dataset.w + '%';
        });
      }
    });
  }, { threshold: 0.3 }).observe(sec);
}
triggerBars('s-results');
</script>
</BaseLayout>

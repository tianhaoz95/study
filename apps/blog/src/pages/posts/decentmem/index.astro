    <div class="cs-panel" id="panel-design">
      <pre class="cs-pre">
<span class="cs-line cmt"># DecentMem: per-agent private dual-pool memory</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">class</span> <span class="cls">Agent</span>:</span>
<span class="cs-line hl-p">    <span class="cmt"># Each agent has PRIVATE memory — never shared</span></span>
<span class="cs-line">    E_pool: <span class="cls">List</span>[MemoryPiece]  <span class="cmt"># exploitation</span></span>
<span class="cs-line">    X_pool: <span class="cls">List</span>[MemoryPiece]  <span class="cmt"># exploration</span></span>
<span class="cs-line">    w_E: <span class="cls">float</span> = <span class="num">1.0</span>  <span class="cmt"># E-pool weight (learnable)</span></span>
<span class="cs-line">    w_X: <span class="cls">float</span> = <span class="num">1.0</span>  <span class="cmt"># X-pool weight (fixed)</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Memory piece structure</span>
<span class="cs-line hl-c">z = (ξ, r_star)</span>
<span class="cs-line hl-c">r_star = (r_trajectory, r_comment)</span>
<span class="cs-line cmt"># ξ = context prototype (task embedding)</span>
<span class="cs-line cmt"># r_trajectory = actions + cooperation history</span>
<span class="cs-line cmt"># r_comment = agent self-commentary (why?)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># E-pool retrieval (similarity-gated)</span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">retrieve_E</span>(agent, task, τ=<span class="num">0.75</span>):</span>
<span class="cs-line">    hits = <span class="fn">top_k_similar</span>(agent.E_pool, task)</span>
<span class="cs-line">    <span class="kw">if</span> hits[<span class="num">0</span>].sim &lt; τ:  <span class="cmt"># below threshold</span></span>
<span class="cs-line">        <span class="kw">return</span> <span class="fn">use_X_pool</span>(agent, task)  <span class="cmt"># fallback</span></span>
<span class="cs-line">    <span class="kw">return</span> hits</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># X-pool generates novel candidates (LLM prior)</span>
<span class="cs-line hl-g"><span class="kw">def</span> <span class="fn">generate_X</span>(agent, task):</span>
<span class="cs-line hl-g">    z_new = llm.<span class="fn">generate</span>(task, agent.role)</span>
<span class="cs-line hl-g">    agent.X_pool.<span class="fn">append</span>(z_new)</span>
<span class="cs-line hl-g">    <span class="kw">return</span> z_new</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-router">
      <pre class="cs-pre">
<span class="cs-line cmt"># Online routing: learns α from LLM judge feedback</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Pool selection probability</span>
<span class="cs-line hl-p">α = w_E / (w_E + w_X)        <span class="cmt"># P(use E-pool)</span></span>
<span class="cs-line">pool = <span class="str">"E"</span> <span class="kw">if</span> rand() &lt; α <span class="kw">else</span> <span class="str">"X"</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Stage-wise weight update (α=β=0.5)</span>
<span class="cs-line cmt"># Δt = 1 if stage score improved vs prev stage</span>
<span class="cs-line"> </span>
<span class="cs-line hl-c"><span class="kw">if</span> pool == <span class="str">"E"</span>:</span>
<span class="cs-line hl-c">    <span class="kw">if</span> Δt == <span class="num">1</span>:             <span class="cmt"># exploitation succeeded</span></span>
<span class="cs-line hl-c">        w_E += <span class="num">0.5</span>          <span class="cmt"># reinforce</span></span>
<span class="cs-line hl-c">    <span class="kw">else</span>:                    <span class="cmt"># exploitation failed</span></span>
<span class="cs-line hl-c">        w_E = <span class="fn">max</span>(<span class="num">1.0</span>, <span class="num">0.5</span>*w_E)  <span class="cmt"># hedge</span></span>
<span class="cs-line hl-g"><span class="kw">if</span> pool == <span class="str">"X"</span>:</span>
<span class="cs-line hl-g">    <span class="kw">if</span> Δt == <span class="num">1</span>:             <span class="cmt"># exploration succeeded</span></span>
<span class="cs-line hl-g">        w_E = <span class="fn">max</span>(<span class="num">1.0</span>, <span class="num">0.5</span>*w_E)  <span class="cmt"># stay curious</span></span>
<span class="cs-line hl-g">    <span class="kw">else</span>:                    <span class="cmt"># exploration failed</span></span>
<span class="cs-line hl-g">        w_E += <span class="num">0.5</span>          <span class="cmt"># retreat to history</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># After task completes: consolidate</span>
<span class="cs-line">E_pool.<span class="fn">extend</span>(X_pool)   <span class="cmt"># all X → E</span></span>
<span class="cs-line">X_pool.<span class="fn">clear</span>()         <span class="cmt"># X resets</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># w_X = 1.0 always (fixed reference)</span>
<span class="cs-line cmt"># Interpretation: w_E tells you how much</span>
<span class="cs-line cmt"># accumulated experience beats fresh ideas</span>
      </pre>

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="DecentMem: Why Shared Memory Homogenizes Multi-Agent Systems | Catpuccino.ai"
  description="When every AI agent reads from the same memory pool, they all converge to the same strategy — defeating the point of collaboration. DecentMem gives each agent private dual-pool memory (E-pool + X-pool) that provably prevents homogenization and achieves O(log T) optimal regret."
  crumb="DecentMem"
>


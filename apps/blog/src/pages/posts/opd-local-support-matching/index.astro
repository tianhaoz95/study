// ─── Vocabulary distribution canvas (§intro) ────────────────────────────────
(function() {
  const canvas = document.getElementById('vocab-canvas');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  let currentK = 1;

  // 12 tokens at context "answer is \boxed{"
  const tokens = ['1','2','3','0','4','5','6','-','7','8','9','\\frac'];
  const teacherProbs = [0.15,0.12,0.10,0.09,0.08,0.07,0.06,0.05,0.04,0.04,0.03,0.02];
  const studentProbs = [0.25,0.18,0.11,0.08,0.06,0.05,0.04,0.03,0.08,0.05,0.04,0.03];
  // sorted by teacher prob descending (already sorted above)

  function resizeCanvas() {
    const W = canvas.clientWidth, H = 200;
    canvas.width = W * DPR; canvas.height = H * DPR;
    drawVocab(currentK);
  }

  function drawVocab(K) {
    const ctx = canvas.getContext('2d');
    const W = canvas.width / DPR, H = canvas.height / DPR;
    ctx.clearRect(0, 0, W * DPR, H * DPR);
    ctx.scale(DPR, DPR);

    const n = tokens.length;
    const pad = 20, botPad = 30, topPad = 10;
    const barW = (W - pad * 2) / n;
    const chartH = H - botPad - topPad;
    const maxProb = 0.28;

    // background
    ctx.fillStyle = 'rgba(0,0,0,0)';
    ctx.fillRect(0, 0, W, H);

    // top-K highlight region
    for (let i = 0; i < K; i++) {
      const x = pad + i * barW;
      if (K > 1) {
        ctx.fillStyle = 'rgba(139,92,246,0.08)';
        ctx.fillRect(x, topPad, barW, chartH);
      }
    }

    // draw bars
    for (let i = 0; i < n; i++) {
      const x = pad + i * barW;
      const tH = (teacherProbs[i] / maxProb) * chartH;
      const sH = (studentProbs[i] / maxProb) * chartH;
      const bW = barW * 0.38;
      const inSupport = i < K;

      // teacher bar (purple)
      ctx.fillStyle = inSupport ? '#8b5cf6' : '#4b3f7a';
      ctx.fillRect(x + barW * 0.08, topPad + chartH - tH, bW, tH);

      // student bar (teal)
      ctx.fillStyle = inSupport ? '#06b6d4' : '#1e4a5a';
      ctx.fillRect(x + barW * 0.54, topPad + chartH - sH, bW, sH);

      // highlight sampled token (token index 8 = "7")
      if (K === 1 && i === 8) {
        ctx.strokeStyle = '#ef4444';
        ctx.lineWidth = 1.5;
        const bx = x + barW * 0.08;
        const by = topPad + chartH - Math.max(tH, sH) - 4;
        const bww = barW * 0.84;
        const bhh = Math.max(tH, sH) + 4;
        ctx.strokeRect(bx, by, bww, bhh);
        ctx.fillStyle = '#ef4444';
        ctx.font = `bold ${9 * DPR / DPR}px monospace`;
        ctx.fillText('sampled', bx - 4, by - 3);
      }

      // token label
      ctx.fillStyle = inSupport ? '#94a3b8' : '#475569';
      ctx.font = `${8 * DPR / DPR}px monospace`;
      ctx.textAlign = 'center';
      ctx.fillText(tokens[i], x + barW / 2, H - 8);
    }

    // axes
    ctx.strokeStyle = '#3f3f5a';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(pad, topPad); ctx.lineTo(pad, topPad + chartH);
    ctx.lineTo(W - pad, topPad + chartH);
    ctx.stroke();

    // legend
    ctx.fillStyle = '#8b5cf6';
    ctx.fillRect(pad, 2, 8, 6);
    ctx.fillStyle = '#94a3b8';
    ctx.font = `${8.5 * DPR / DPR}px monospace`;
    ctx.textAlign = 'left';
    ctx.fillText('teacher q', pad + 10, 8);
    ctx.fillStyle = '#06b6d4';
    ctx.fillRect(pad + 70, 2, 8, 6);
    ctx.fillStyle = '#94a3b8';
    ctx.fillText('student π', pad + 80, 8);

    // K label
    if (K > 1) {
      ctx.fillStyle = 'rgba(139,92,246,0.6)';
      ctx.font = `bold ${9 * DPR / DPR}px monospace`;
      ctx.textAlign = 'center';
      const kx = pad + (K * barW) / 2;
      ctx.fillText(`top-${K} teacher support`, kx, topPad - 2);
    }

    ctx.scale(1/DPR, 1/DPR);
  }

  // K buttons
  document.querySelectorAll('.k-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.k-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentK = parseInt(btn.dataset.k);
      drawVocab(currentK);
      // update signal quality bars
      const sqFill = document.getElementById('sq-fill');
      const sqVal  = document.getElementById('sq-val');
      const stabFill = document.getElementById('stab-fill');
      const stabVal  = document.getElementById('stab-val');
      if (currentK === 1) {
        sqFill.style.width = '3%'; sqFill.style.background = '#ef4444';
        sqVal.textContent = '1 token';
        stabFill.style.width = '8%'; stabFill.style.background = '#ef4444';
        stabVal.textContent = 'fragile';
      } else if (currentK === 8) {
        sqFill.style.width = '25%'; sqFill.style.background = '#f97316';
        sqVal.textContent = '8 tokens';
        stabFill.style.width = '45%'; stabFill.style.background = '#fbbf24';
        stabVal.textContent = 'moderate';
      } else {
        sqFill.style.width = '85%'; sqFill.style.background = '#8b5cf6';
        sqVal.textContent = '32 tokens';
        stabFill.style.width = '90%'; stabFill.style.background = '#34d399';
        stabVal.textContent = 'stable';
      }
    });
  });

  window.addEventListener('resize', resizeCanvas);
  resizeCanvas();
})();

// ─── Gradient variance chart (§tradeoff) ────────────────────────────────────
(function() {
  const canvas = document.getElementById('variance-canvas');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;

  // Approximate data points (20 steps × ~100 iterations = 2000 total)
  // Values based on paper Figure 1a description (log scale)
  const gammaData = {
    '0.0':  [130,110,95,120,100,90,115,85,105,110,95,100,88,107,93,98,102,88,95,100],
    '0.25': [600,800,700,1100,900,750,1200,800,900,1050,700,950,800,1100,750,880,920,800,780,850],
    '0.5':  [8000,15000,10000,22000,12000,18000,25000,14000,20000,16000,12000,18000,22000,16000,14000,19000,21000,15000,17000,20000],
    '0.75': [100000,200000,150000,400000,250000,180000,500000,200000,350000,280000,180000,300000,420000,220000,190000,280000,350000,210000,260000,320000],
    '1.0':  [800000,3000000,1500000,8000000,2000000,5000000,12000000,3000000,7000000,4000000,2500000,6000000,10000000,3500000,2000000,5500000,8000000,3000000,4500000,7000000],
  };

  const colors = { '0.0':'#34d399','0.25':'#60a5fa','0.5':'#fbbf24','0.75':'#f97316','1.0':'#f87171' };
  let visible = { '0.0':true,'0.25':true,'0.5':true,'0.75':true,'1.0':true };

  function drawVariance() {
    const W = canvas.clientWidth, H = 220;
    canvas.width = W * DPR; canvas.height = H * DPR;
    const ctx = canvas.getContext('2d');
    ctx.clearRect(0, 0, W * DPR, H * DPR);
    ctx.scale(DPR, DPR);

    const pad = { l:55, r:15, t:10, b:28 };
    const cW = W - pad.l - pad.r, cH = H - pad.t - pad.b;

    // log scale: 10^1 to 10^8
    const logMin = 1, logMax = 8;
    const nPoints = 20;

    function xPos(i) { return pad.l + (i / (nPoints - 1)) * cW; }
    function yPos(v) {
      const lv = Math.log10(Math.max(1, v));
      return pad.t + cH - ((lv - logMin) / (logMax - logMin)) * cH;
    }

    // grid lines
    for (let exp = logMin; exp <= logMax; exp++) {
      const y = yPos(Math.pow(10, exp));
      ctx.strokeStyle = 'rgba(255,255,255,0.05)';
      ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(pad.l, y); ctx.lineTo(pad.l + cW, y); ctx.stroke();
      ctx.fillStyle = '#475569';
      ctx.font = `${8 * DPR/DPR}px monospace`;
      ctx.textAlign = 'right';
      ctx.fillText(`10^${exp}`, pad.l - 4, y + 3);
    }

    // x axis ticks
    for (let i = 0; i <= 4; i++) {
      const xi = Math.floor((i / 4) * (nPoints - 1));
      const x = xPos(xi);
      ctx.strokeStyle = 'rgba(255,255,255,0.08)';
      ctx.beginPath(); ctx.moveTo(x, pad.t); ctx.lineTo(x, pad.t + cH); ctx.stroke();
      ctx.fillStyle = '#475569';
      ctx.textAlign = 'center';
      ctx.font = `${8 * DPR/DPR}px monospace`;
      ctx.fillText(`${xi * 100}`, x, H - 5);
    }

    // axis labels
    ctx.fillStyle = '#64748b';
    ctx.font = `${8 * DPR/DPR}px monospace`;
    ctx.textAlign = 'center';
    ctx.fillText('iteration', pad.l + cW/2, H - 0);

    // draw lines
    Object.keys(gammaData).forEach(gk => {
      if (!visible[gk]) return;
      const data = gammaData[gk];
      ctx.strokeStyle = colors[gk];
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      data.forEach((v, i) => {
        const x = xPos(i), y = yPos(v);
        i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
      });
      ctx.stroke();
    });

    // axes
    ctx.strokeStyle = '#3f3f5a';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(pad.l, pad.t); ctx.lineTo(pad.l, pad.t + cH); ctx.lineTo(pad.l + cW, pad.t + cH);
    ctx.stroke();

    ctx.scale(1/DPR, 1/DPR);
  }

  // gamma toggle buttons
  document.querySelectorAll('.gamma-btn').forEach(btn => {
    const gi = parseInt(btn.dataset.g);
    const keys = Object.keys(gammaData);
    btn.addEventListener('click', () => {
      const gk = keys[gi];
      visible[gk] = !visible[gk];
      btn.classList.toggle('off', !visible[gk]);
      drawVariance();
    });
  });

  window.addEventListener('resize', drawVariance);
  drawVariance();
})();

// ─── Method comparison canvases (§method) ────────────────────────────────────
(function() {
  function drawMethodCanvas(canvasId, K) {
    const canvas = document.getElementById(canvasId);
    if (!canvas) return;
    const DPR = window.devicePixelRatio || 1;
    const W = canvas.clientWidth, H = 160;
    canvas.width = W * DPR; canvas.height = H * DPR;
    const ctx = canvas.getContext('2d');
    ctx.clearRect(0, 0, W * DPR, H * DPR);
    ctx.scale(DPR, DPR);

    const tokens = ['1','2','3','0','4','5','6','-','7','8','9','\\f'];
    const teacherProbs = [0.15,0.12,0.10,0.09,0.08,0.07,0.06,0.05,0.04,0.04,0.03,0.02];
    const studentProbs = [0.25,0.18,0.11,0.08,0.06,0.05,0.04,0.03,0.08,0.05,0.04,0.03];
    const n = tokens.length;
    const pad = 14, botPad = 24, topPad = 8;
    const barW = (W - pad * 2) / n;
    const chartH = H - botPad - topPad;
    const maxProb = 0.28;

    for (let i = 0; i < K; i++) {
      ctx.fillStyle = 'rgba(139,92,246,0.1)';
      ctx.fillRect(pad + i * barW, topPad, barW, chartH);
    }

    for (let i = 0; i < n; i++) {
      const x = pad + i * barW;
      const tH = (teacherProbs[i] / maxProb) * chartH;
      const sH = (studentProbs[i] / maxProb) * chartH;
      const bW = barW * 0.38;
      const inSupport = i < K;

      ctx.fillStyle = inSupport ? '#8b5cf6' : '#2d2557';
      ctx.fillRect(x + barW * 0.08, topPad + chartH - tH, bW, tH);
      ctx.fillStyle = inSupport ? '#06b6d4' : '#1a3a48';
      ctx.fillRect(x + barW * 0.54, topPad + chartH - sH, bW, sH);

      if (K === 1 && i === 8) {
        ctx.strokeStyle = '#ef4444';
        ctx.lineWidth = 1.5;
        ctx.strokeRect(x + barW * 0.06, topPad + chartH - Math.max(tH, sH) - 3, barW * 0.88, Math.max(tH, sH) + 3);
      }

      ctx.fillStyle = inSupport ? '#94a3b8' : '#374151';
      ctx.font = `${7 * DPR/DPR}px monospace`;
      ctx.textAlign = 'center';
      ctx.fillText(tokens[i], x + barW / 2, H - 5);
    }

    ctx.strokeStyle = '#3f3f5a';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(pad, topPad); ctx.lineTo(pad, topPad + chartH); ctx.lineTo(W - pad, topPad + chartH);
    ctx.stroke();

    // signal label
    if (K === 1) {
      ctx.fillStyle = '#ef4444';
      ctx.font = `bold ${8 * DPR/DPR}px monospace`;
      ctx.textAlign = 'center';
      ctx.fillText('▲ one sampled token = all signal', W/2, topPad - 1);
    } else {
      ctx.fillStyle = '#8b5cf6';
      ctx.font = `bold ${8 * DPR/DPR}px monospace`;
      ctx.textAlign = 'center';
      ctx.fillText(`▲ top-${K} teacher tokens = KL comparison`, W/2, topPad - 1);
    }

    ctx.scale(1/DPR, 1/DPR);
  }

  function initMethodCanvases() {
    drawMethodCanvas('method-canvas-bad', 1);
    drawMethodCanvas('method-canvas-good', 32);
  }

  window.addEventListener('resize', initMethodCanvases);
  // wait for layout
  requestAnimationFrame(initMethodCanvases);
})();

// ─── Animated bar chart (§results) ───────────────────────────────────────────
const resultsSection = document.getElementById('s-results');
if (resultsSection) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          const pct = parseFloat(b.dataset.w) / 100 * 100;
          b.style.width = pct + '%';
        });
      }
    });
  }, { threshold: 0.2 }).observe(resultsSection);
}
</script>
</BaseLayout>

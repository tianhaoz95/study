.cs-panel{display:none}
.cs-panel.active{display:block}
.cs-pre{font-family:var(--ff-mono);font-size:.72rem;line-height:1.75;padding:.875rem 0;color:#abb2bf;white-space:pre}
.cs-line{display:block;padding:0 1.25rem}

    <div class="cs-panel active" id="panel-problem">
      <pre class="cs-pre">
<span class="cs-line cmt"># GRPO group-relative advantage</span>
<span class="cs-line cmt"># — collapses to 0 when all rollouts fail</span>
<span class="cs-line"></span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">grpo_advantage</span>(rewards, eps=<span class="num">1e-8</span>):</span>
<span class="cs-line">    <span class="cmt"># rewards: list of 0/1 per rollout in group</span></span>
<span class="cs-line">    r_bar = <span class="fn">mean</span>(rewards)</span>
<span class="cs-line">    std   = <span class="fn">std</span>(rewards)</span>
<span class="cs-line hl-a">    <span class="kw">if</span> std &lt; eps:  <span class="cmt"># all same → 0 advantage</span></span>
<span class="cs-line hl-a">        <span class="kw">return</span> [<span class="num">0.0</span>] * <span class="fn">len</span>(rewards)</span>
<span class="cs-line">    <span class="kw">return</span> [(r - r_bar) / (std + eps)</span>
<span class="cs-line">            <span class="kw">for</span> r <span class="kw">in</span> rewards]</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Dead zone examples:</span>
<span class="cs-line hl-a">grpo_advantage([<span class="num">0</span>,<span class="num">0</span>,<span class="num">0</span>,<span class="num">0</span>,<span class="num">0</span>,<span class="num">0</span>,<span class="num">0</span>,<span class="num">0</span>])</span>
<span class="cs-line hl-a"><span class="cmt"># → [0,0,0,0,0,0,0,0]  ← NO SIGNAL</span></span>
<span class="cs-line"></span>
<span class="cs-line hl-g">grpo_advantage([<span class="num">1</span>,<span class="num">0</span>,<span class="num">1</span>,<span class="num">0</span>,<span class="num">1</span>,<span class="num">0</span>,<span class="num">1</span>,<span class="num">0</span>])</span>
<span class="cs-line hl-g"><span class="cmt"># → [1,-1,1,-1,...]   ← STRONG SIGNAL</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># r̄ₓ &lt; 0.5 → hard question → ZPPO activates</span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">is_hard</span>(rewards):</span>
<span class="cs-line hl-p">    <span class="kw">return</span> <span class="fn">mean</span>(rewards) &lt; <span class="num">0.5</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># REINFORCE++ (ZPPO variant):</span>
<span class="cs-line cmt"># Step 1: subtract within-group mean</span>
<span class="cs-line cmt"># Step 2: batch-normalize across non-trivial</span>
<span class="cs-line cmt">#         groups (exclude zero-advantage)</span>
<span class="cs-line hl-c"><span class="kw">def</span> <span class="fn">batch_norm_no_zero</span>(groups):</span>
<span class="cs-line hl-c">    nontrivial = [g <span class="kw">for</span> g <span class="kw">in</span> groups</span>
<span class="cs-line hl-c">                  <span class="kw">if</span> <span class="fn">any</span>(a != <span class="num">0</span> <span class="kw">for</span> a <span class="kw">in</span> g)]</span>
<span class="cs-line hl-c">    mu = <span class="fn">mean</span>(<span class="fn">flatten</span>(nontrivial))</span>
<span class="cs-line hl-c">    sd = <span class="fn">std</span>(<span class="fn">flatten</span>(nontrivial))</span>
<span class="cs-line hl-c">    <span class="kw">return</span> [(a-mu)/(sd+eps) <span class="kw">for</span> a <span class="kw">in</span> g]</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-bcq">
      <pre class="cs-pre">
<span class="cs-line cmt"># BCQ: Binary Candidate-included Question</span>
<span class="cs-line cmt"># — teacher in prompt, not gradient</span>
<span class="cs-line"></span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">build_bcq</span>(x, teacher, student_rollouts):</span>
<span class="cs-line">    <span class="cmt"># Sample teacher rollouts on hard question</span></span>
<span class="cs-line">    t_rollouts = <span class="fn">sample</span>(teacher, x, G=<span class="num">8</span>)</span>
<span class="cs-line">    t_correct  = [y <span class="kw">for</span> y <span class="kw">in</span> t_rollouts</span>
<span class="cs-line">                  <span class="kw">if</span> <span class="fn">reward</span>(x, y) == <span class="num">1</span>]</span>
<span class="cs-line hl-c">    <span class="kw">if</span> <span class="kw">not</span> t_correct:</span>
<span class="cs-line hl-c">        <span class="kw">return</span> <span class="kw">None</span>  <span class="cmt"># teacher also failed → NCQ only</span></span>
<span class="cs-line"></span>
<span class="cs-line">    <span class="cmt"># Pick one teacher-correct, one student-wrong</span></span>
<span class="cs-line">    y_T = <span class="fn">choice</span>(t_correct)      <span class="cmt"># teacher ✓</span></span>
<span class="cs-line">    y_S = <span class="fn">choice</span>([y <span class="kw">for</span> y <span class="kw">in</span> student_rollouts</span>
<span class="cs-line">                  <span class="kw">if</span> <span class="fn">reward</span>(x, y) == <span class="num">0</span>]) <span class="cmt"># student ✗</span></span>
<span class="cs-line"></span>
<span class="cs-line">    <span class="cmt"># Compress both traces (shared token cap)</span></span>
<span class="cs-line">    cA = <span class="fn">compress</span>(y_T, teacher)</span>
<span class="cs-line">    cB = <span class="fn">compress</span>(y_S, teacher)</span>
<span class="cs-line">    cA, cB = <span class="fn">shuffle</span>([cA, cB])  <span class="cmt"># random order</span></span>
<span class="cs-line"></span>
<span class="cs-line hl-p">    <span class="kw">return</span> x + <span class="str">"""</span></span>
<span class="cs-line hl-p"><span class="str">Here are two candidate responses in</span></span>
<span class="cs-line hl-p"><span class="str">&lt;candidate&gt;&lt;/candidate&gt; tags. One is</span></span>
<span class="cs-line hl-p"><span class="str">correct and another is wrong.</span></span>
<span class="cs-line hl-p"><span class="str">&lt;candidate&gt;&#123;cA&#125;&lt;/candidate&gt;</span></span>
<span class="cs-line hl-p"><span class="str">&lt;candidate&gt;&#123;cB&#125;&lt;/candidate&gt;"""</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Student generates on-policy from x_BCQ</span>
<span class="cs-line cmt"># — every gradient token is student-generated</span>
<span class="cs-line cmt"># — teacher trace = context, never a target</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-ncq">
      <pre class="cs-pre">
<span class="cs-line cmt"># NCQ: Negative Candidate-included Question</span>
<span class="cs-line cmt"># — surfaces shared failure patterns</span>
<span class="cs-line"></span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">build_ncq</span>(x, student_rollouts, teacher):</span>
<span class="cs-line">    wrong = [y <span class="kw">for</span> y <span class="kw">in</span> student_rollouts</span>
<span class="cs-line">             <span class="kw">if</span> <span class="fn">reward</span>(x, y) == <span class="num">0</span>]</span>
<span class="cs-line">    <span class="kw">if</span> <span class="kw">not</span> wrong:</span>
<span class="cs-line">        <span class="kw">return</span> <span class="kw">None</span></span>
<span class="cs-line"></span>
<span class="cs-line">    <span class="cmt"># Parse final answers from each wrong rollout</span></span>
<span class="cs-line">    parsed = [<span class="fn">parse_answer</span>(y) <span class="kw">for</span> y <span class="kw">in</span> wrong]</span>
<span class="cs-line">    <span class="cmt"># e.g. ["Berlin", "London", "Madrid", "Rome"]</span></span>
<span class="cs-line"></span>
<span class="cs-line">    <span class="cmt"># Compress each wrong trace</span></span>
<span class="cs-line">    candidates = [<span class="fn">compress</span>(y, teacher) <span class="kw">for</span> y <span class="kw">in</span> wrong]</span>
<span class="cs-line"></span>
<span class="cs-line hl-p">    <span class="kw">return</span> x + <span class="str">f"""</span></span>
<span class="cs-line hl-p"><span class="str">The following answers are all WRONG:</span></span>
<span class="cs-line hl-p"><span class="str">&#123;', '.join(parsed)&#125;.</span></span>
<span class="cs-line hl-p"><span class="str">Below are all incorrect reasoning processes</span></span>
<span class="cs-line hl-p"><span class="str">in &lt;candidate&gt;&lt;/candidate&gt; tags.</span></span>
<span class="cs-line hl-p"><span class="str">&#123;''.join(f'&lt;candidate&gt;&#123;c&#125;&lt;/candidate&gt;'</span></span>
<span class="cs-line hl-p"><span class="str">          for c in candidates)&#125;"""</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Key difference from BCQ:</span>
<span class="cs-line cmt"># NCQ requires no teacher success.</span>
<span class="cs-line cmt"># Works even when teacher also fails.</span>
<span class="cs-line cmt"># Increasingly important at larger scale.</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Within a standard GRPO group:</span>
<span class="cs-line cmt"># — wrong rollouts are independent signals</span>
<span class="cs-line cmt"># — student never "sees" cross-failure patterns</span>
<span class="cs-line cmt"># NCQ is the FIRST place they converge.</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-replay">
      <pre class="cs-pre">
<span class="cs-line cmt"># Prompt replay buffer — zone amplification</span>
<span class="cs-line"></span>
<span class="cs-line hl-p"><span class="kw">class</span> <span class="cls">ReplayBuffer</span>:</span>
<span class="cs-line hl-p">    <span class="kw">def</span> <span class="fn">__init__</span>(<span class="kw">self</span>, capacity):</span>
<span class="cs-line hl-p">        <span class="kw">self</span>.buf = OrderedDict()</span>
<span class="cs-line hl-p">        <span class="kw">self</span>.cap = capacity</span>
<span class="cs-line"></span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">update</span>(<span class="kw">self</span>, x, r_bar):</span>
<span class="cs-line">        <span class="kw">if</span> r_bar &lt; <span class="num">0.5</span>:</span>
<span class="cs-line hl-c">            <span class="kw">if</span> x <span class="kw">not in</span> <span class="kw">self</span>.buf:</span>
<span class="cs-line hl-c">                <span class="kw">self</span>.buf[x] = <span class="num">0</span>  <span class="cmt"># admit</span></span>
<span class="cs-line">        <span class="kw">elif</span> x <span class="kw">in</span> <span class="kw">self</span>.buf:</span>
<span class="cs-line hl-g">            <span class="kw">del</span> <span class="kw">self</span>.buf[x]  <span class="cmt"># graduate!</span></span>
<span class="cs-line"></span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">evict_if_full</span>(<span class="kw">self</span>):</span>
<span class="cs-line hl-a">        <span class="kw">while</span> <span class="fn">len</span>(<span class="kw">self</span>.buf) &gt; <span class="kw">self</span>.cap:</span>
<span class="cs-line hl-a">            <span class="kw">self</span>.buf.<span class="fn">popitem</span>(last=<span class="kw">False</span>)</span>
<span class="cs-line hl-a">            <span class="cmt"># FIFO evict oldest ungraduated</span></span>
<span class="cs-line"></span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">sample</span>(<span class="kw">self</span>, n):</span>
<span class="cs-line">        <span class="kw">return</span> <span class="fn">random_sample</span>(<span class="kw">self</span>.buf.keys(), n)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Graduation rate at entry accuracy (2B):</span>
<span class="cs-line cmt">#  0.0%  accuracy → ZPPO 28%, GRPO† 4%</span>
<span class="cs-line cmt"># 12.5%  accuracy → ZPPO 54%, GRPO† 14%</span>
<span class="cs-line cmt"># 25.0%  accuracy → ZPPO ~70%</span>
<span class="cs-line cmt"># 37.5%  accuracy → ZPPO ~85%</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Each replay: fresh BCQ/NCQ candidates</span>
<span class="cs-line cmt"># (teacher is re-sampled every visit)</span>
<span class="cs-line cmt"># → replay × reformulation is super-additive</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-scale">
      <pre class="cs-pre">
<span class="cs-line cmt"># ZPPO vs GRPO† — VLM Avg Δ (pp)</span>
<span class="cs-line cmt"># Inverse scaling: gain ∝ 1/student_size</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Student  GRPO†  ZPPO   ZPPO gain</span>
<span class="cs-line hl-p"><span class="cmt">#  0.8B    +4.4  +9.3   +4.9 pp extra</span></span>
<span class="cs-line hl-c"><span class="cmt">#  2B      +2.4  +5.2   +2.8 pp extra</span></span>
<span class="cs-line cmt">#  4B      ~2.1  +4.0   ~1.9 pp extra</span>
<span class="cs-line cmt">#  9B      ~1.5  +2.8   ~1.3 pp extra</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Why? BCQ requires teacher to succeed</span>
<span class="cs-line cmt"># where student fails. At small scale:</span>
<span class="cs-line cmt"># — teacher succeeds on many hard questions</span>
<span class="cs-line cmt"># — wide BCQ candidate pool</span>
<span class="cs-line cmt"># At large scale:</span>
<span class="cs-line cmt"># — remaining hard questions also hard for teacher</span>
<span class="cs-line cmt"># — BCQ pool dries up → NCQ dominates</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Recipe choices that matter at small scale:</span>
<span class="cs-line cmt"># Iterations per step I=4 (not 16)</span>
<span class="cs-line hl-a"><span class="cmt"># I=16: gradient drifts, LLM/Video degrades</span></span>
<span class="cs-line hl-g"><span class="cmt"># I=4:  sweet spot — 4× updates, minimal drift</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Batch normalization: exclude zero-advantage</span>
<span class="cs-line hl-a"><span class="cmt"># With zero: inflated advantages for real groups</span></span>
<span class="cs-line hl-g"><span class="cmt"># Without zero: correct normalization → +1.5 pp</span></span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-results">
      <pre class="cs-pre">
<span class="cs-line cmt"># Key results — Qwen3.5 family, 27B teacher</span>
<span class="cs-line cmt"># 31-benchmark suite: 16VLM + 10LLM + 5Video</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># VLM Avg Δ (pp from base) — training-aligned</span>
<span class="cs-line cmt"># Scale:    0.8B   2B     4B     9B</span>
<span class="cs-line cmt"># Off-Dist  +1.3  +1.2   +1.1   +0.6</span>
<span class="cs-line cmt"># On-Dist   +1.3  +1.2   +0.9   +0.6</span>
<span class="cs-line cmt"># GRPO†     +4.4  +2.4   +2.1   +1.5</span>
<span class="cs-line hl-p"><span class="cmt"># ZPPO      +9.3  +5.2   +4.0   +2.8</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># LLM Avg Δ (pp) — OUT OF DISTRIBUTION</span>
<span class="cs-line hl-a"><span class="cmt"># Off-Dist  -2.7  -2.2   -0.9   -0.4  ← HURTS</span></span>
<span class="cs-line hl-a"><span class="cmt"># On-Dist   -2.0  -1.6   -0.5   -0.2  ← HURTS</span></span>
<span class="cs-line cmt"># GRPO†     +3.5  +2.0   +1.6   +1.3</span>
<span class="cs-line hl-g"><span class="cmt"># ZPPO      +7.9  +5.1   +2.7   +2.7  ← HEALS</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># GPQA-D (hardest OOD, 0.8B):</span>
<span class="cs-line cmt"># Base:      12.1</span>
<span class="cs-line hl-a"><span class="cmt"># Off-Dist†: 10.1  ← -2.0</span></span>
<span class="cs-line hl-a"><span class="cmt"># On-Dist†:  10.6  ← -1.5</span></span>
<span class="cs-line cmt"># GRPO†:     25.5  ← +13.4</span>
<span class="cs-line hl-g"><span class="cmt"># ZPPO:      42.4  ← +30.3 (!)</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Ablation (0.8B, 16 VLM Avg):</span>
<span class="cs-line cmt"># GRPO:                43.8</span>
<span class="cs-line cmt"># + buffer:            45.4  (+1.6)</span>
<span class="cs-line cmt"># + BCQ+NCQ (no buf):  45.2  (+1.4)</span>
<span class="cs-line hl-c"><span class="cmt"># + buffer + BCQ:      48.6  (+7.6)</span></span>
<span class="cs-line hl-p"><span class="cmt"># + buffer + BCQ+NCQ:  50.3  (+9.3)</span></span>
      </pre>
    </div>

  </div>
</aside>

</div><!-- /post-grid -->

<script>
// ── TOC + sidebar toggles ────────────────────────────────────
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});
const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ── Code sidebar tab switching ───────────────────────────────
const tabMeta = {
  problem: { file: 'zppo/grpo_advantage.py',  title: 'The Dead Zone' },
  bcq:     { file: 'zppo/bcq_prompt.py',       title: 'BCQ Construction' },
  ncq:     { file: 'zppo/ncq_prompt.py',       title: 'NCQ Construction' },
  replay:  { file: 'zppo/replay_buffer.py',    title: 'Replay Buffer' },
  scale:   { file: 'zppo/scale_results.py',    title: 'Inverse Scaling' },
  results: { file: 'zppo/main_results.py',     title: 'Results' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ── IntersectionObserver ─────────────────────────────────────
const sectionMap = {
  's-problem': 'problem', 's-bcq': 'bcq', 's-ncq': 'ncq',
  's-replay': 'replay', 's-scale': 'scale', 's-results': 'results'
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ─────────────────────────────────────────────────────────────
// §01 GRPO DEAD ZONE CANVAS
// ─────────────────────────────────────────────────────────────
const grpoCanvas = document.getElementById('grpo-canvas');
if (grpoCanvas) {
  const ctx = grpoCanvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const W = grpoCanvas.clientWidth, H = 220;
  grpoCanvas.width = W * DPR; grpoCanvas.height = H * DPR; ctx.scale(DPR, DPR);

  const slider = document.getElementById('grpo-slider');
  const sliderVal = document.getElementById('grpo-slider-val');

  function drawGrpoCanvas(nCorrect) {
    ctx.clearRect(0, 0, W, H);
    const G = 8;
    const nWrong = G - nCorrect;
    const rBar = nCorrect / G;
    let advantages = [];
    if (nCorrect === 0 || nCorrect === G) {
      advantages = new Array(G).fill(0);
    } else {
      const eps = 1e-8;
      const sq = Math.sqrt(nCorrect * nWrong / (G * G));
      for (let i = 0; i < G; i++) {
        const r = i < nCorrect ? 1 : 0;
        advantages.push((r - rBar) / (sq + eps));
      }
    }

    // Title
    ctx.font = `${Math.round(11 * DPR / DPR)}px var(--ff-mono, monospace)`;
    ctx.textAlign = 'left';
    const isDead = (nCorrect === 0 || nCorrect === G);

    // Draw rollout circles (top half)
    const circleY = H * 0.28;
    const circleR = 18;
    const spacing = W / (G + 1);
    for (let i = 0; i < G; i++) {
      const x = spacing * (i + 1);
      const isCorrect = i < nCorrect;
      ctx.beginPath();
      ctx.arc(x, circleY, circleR, 0, Math.PI * 2);
      ctx.fillStyle = isCorrect ? 'rgba(16,185,129,0.25)' : 'rgba(239,68,68,0.2)';
      ctx.fill();
      ctx.strokeStyle = isCorrect ? '#10b981' : '#ef4444';
      ctx.lineWidth = 1.5;
      ctx.stroke();
      ctx.fillStyle = isCorrect ? '#10b981' : '#ef4444';
      ctx.font = `bold ${Math.round(13)}px var(--ff-mono, monospace)`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(isCorrect ? '✓' : '✗', x, circleY);
    }

    // Advantage bars (bottom half)
    const barAreaTop = H * 0.56;
    const barAreaH = H * 0.35;
    const barW = spacing * 0.55;
    const midY = barAreaTop + barAreaH * 0.5;

    // Draw zero line
    ctx.strokeStyle = 'rgba(255,255,255,0.1)';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(0, midY);
    ctx.lineTo(W, midY);
    ctx.stroke();

    const maxAdv = 1.5;
    for (let i = 0; i < G; i++) {
      const x = spacing * (i + 1);
      const adv = advantages[i];
      const barH = (Math.abs(adv) / maxAdv) * (barAreaH * 0.42);
      const barX = x - barW / 2;
      const barY = adv >= 0 ? midY - barH : midY;
      ctx.fillStyle = adv > 0 ? 'rgba(16,185,129,0.6)' : adv < 0 ? 'rgba(239,68,68,0.5)' : 'rgba(107,114,128,0.2)';
      ctx.fillRect(barX, adv >= 0 ? midY - barH : midY, barW, barH || 2);
    }

    // Dead zone overlay
    if (isDead) {
      ctx.fillStyle = 'rgba(239,68,68,0.06)';
      ctx.fillRect(0, barAreaTop - 8, W, barAreaH + 16);
      ctx.font = `bold 11px var(--ff-mono, monospace)`;
      ctx.fillStyle = 'rgba(239,68,68,0.7)';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText('DEAD ZONE — advantage = 0', W / 2, midY);
    }

    // Labels
    ctx.font = `10px var(--ff-mono, monospace)`;
    ctx.fillStyle = 'rgba(107,114,128,0.8)';
    ctx.textAlign = 'left';
    ctx.textBaseline = 'top';
    ctx.fillText('rollouts', 6, H * 0.08);
    ctx.fillText('advantage A⁽ᵍ⁾', 6, barAreaTop - 14);

    // r_bar label
    ctx.textAlign = 'right';
    const rStr = `r̄ₓ = ${rBar.toFixed(2)}  std = ${nCorrect === 0 || nCorrect === G ? '0.00' : Math.sqrt(nCorrect * nWrong / (G * G)).toFixed(2)}`;
    ctx.fillStyle = isDead ? 'rgba(239,68,68,0.7)' : 'rgba(107,114,128,0.8)';
    ctx.fillText(rStr, W - 8, H * 0.08);
  }

  slider.addEventListener('input', () => {
    const v = parseInt(slider.value);
    sliderVal.textContent = `${v} / 8`;
    drawGrpoCanvas(v);
  });
  drawGrpoCanvas(0);
}

// ─────────────────────────────────────────────────────────────
// §02 BCQ STEP NAVIGATOR
// ─────────────────────────────────────────────────────────────
let bcqStep = 0;
const bcqBoxes = document.querySelectorAll('#bcq-steps .step-box');
const bcqPrev = document.getElementById('bcq-prev');
const bcqNext = document.getElementById('bcq-next');
const bcqProg = document.getElementById('bcq-prog');
function updateBCQ() {
  bcqBoxes.forEach((b, i) => {
    b.classList.remove('active', 'done');
    if (i === bcqStep) b.classList.add('active');
    else if (i < bcqStep) b.classList.add('done');
  });
  bcqBoxes.forEach((b, i) => {
    const n = b.querySelector('.step-num');
    if (n) n.textContent = i < bcqStep ? '✓' : String(i + 1);
  });
  if (bcqPrev) bcqPrev.disabled = bcqStep === 0;
  if (bcqNext) bcqNext.disabled = bcqStep === bcqBoxes.length - 1;
  if (bcqProg) bcqProg.textContent = `Step ${bcqStep + 1} of ${bcqBoxes.length}`;
}
bcqPrev?.addEventListener('click', () => { if (bcqStep > 0) { bcqStep--; updateBCQ(); } });
bcqNext?.addEventListener('click', () => { if (bcqStep < bcqBoxes.length - 1) { bcqStep++; updateBCQ(); } });
updateBCQ();

// ─────────────────────────────────────────────────────────────
// §03 NCQ CONTRAST CANVAS
// ─────────────────────────────────────────────────────────────
const ncqCanvas = document.getElementById('ncq-canvas');
if (ncqCanvas) {
  const ctx = ncqCanvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const W = ncqCanvas.clientWidth, H = 240;
  ncqCanvas.width = W * DPR; ncqCanvas.height = H * DPR; ctx.scale(DPR, DPR);

  let ncqMode = 'grpo'; // 'grpo' or 'ncq'
  const wrongLabels = ['Berlin', 'London', 'Madrid', 'Rome'];

  document.getElementById('ncq-grpo-btn')?.addEventListener('click', () => {
    ncqMode = 'grpo';
    document.getElementById('ncq-grpo-btn').classList.add('active');
    document.getElementById('ncq-ncq-btn').classList.remove('active');
    drawNCQ();
  });
  document.getElementById('ncq-ncq-btn')?.addEventListener('click', () => {
    ncqMode = 'ncq';
    document.getElementById('ncq-ncq-btn').classList.add('active');
    document.getElementById('ncq-grpo-btn').classList.remove('active');
    drawNCQ();
  });

  function drawRoundedRect(ctx, x, y, w, h, r, fill, stroke) {
    ctx.beginPath();
    ctx.moveTo(x + r, y);
    ctx.lineTo(x + w - r, y);
    ctx.quadraticCurveTo(x + w, y, x + w, y + r);
    ctx.lineTo(x + w, y + h - r);
    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
    ctx.lineTo(x + r, y + h);
    ctx.quadraticCurveTo(x, y + h, x, y + h - r);
    ctx.lineTo(x, y + r);
    ctx.quadraticCurveTo(x, y, x + r, y);
    ctx.closePath();
    if (fill) { ctx.fillStyle = fill; ctx.fill(); }
    if (stroke) { ctx.strokeStyle = stroke; ctx.stroke(); }
  }

  function drawArrow(ctx, x1, y1, x2, y2, color) {
    const dx = x2 - x1, dy = y2 - y1;
    const len = Math.sqrt(dx * dx + dy * dy);
    const nx = dx / len, ny = dy / len;
    ctx.strokeStyle = color;
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(x1, y1);
    ctx.lineTo(x2, y2);
    ctx.stroke();
    const aw = 6;
    ctx.fillStyle = color;
    ctx.beginPath();
    ctx.moveTo(x2, y2);
    ctx.lineTo(x2 - aw * nx + aw * 0.5 * ny, y2 - aw * ny - aw * 0.5 * nx);
    ctx.lineTo(x2 - aw * nx - aw * 0.5 * ny, y2 - aw * ny + aw * 0.5 * nx);
    ctx.closePath();
    ctx.fill();
  }

  function drawNCQ() {
    ctx.clearRect(0, 0, W, H);
    ctx.font = `10px var(--ff-mono, monospace)`;
    ctx.textBaseline = 'middle';

    if (ncqMode === 'grpo') {
      // 4 independent rollout bubbles, each pointing to a zero bar
      const N = 4;
      const colW = W / N;
      for (let i = 0; i < N; i++) {
        const cx = colW * (i + 0.5);
        const by = H * 0.25;
        // Rollout box
        drawRoundedRect(ctx, cx - 38, by - 16, 76, 32, 5, 'rgba(239,68,68,0.12)', 'rgba(239,68,68,0.45)');
        ctx.fillStyle = '#ef4444';
        ctx.textAlign = 'center';
        ctx.fillText('✗ ' + wrongLabels[i], cx, by);

        // Arrow down to zero bar
        drawArrow(ctx, cx, by + 16, cx, H * 0.62, 'rgba(239,68,68,0.4)');

        // Tiny zero bar
        const zeroY = H * 0.74;
        drawRoundedRect(ctx, cx - 22, zeroY - 6, 44, 12, 3, 'rgba(107,114,128,0.18)', 'rgba(107,114,128,0.35)');
        ctx.fillStyle = 'rgba(107,114,128,0.6)';
        ctx.textAlign = 'center';
        ctx.font = `9px var(--ff-mono, monospace)`;
        ctx.fillText('A=0', cx, zeroY);
      }
      ctx.font = `10px var(--ff-mono, monospace)`;
      ctx.fillStyle = 'rgba(107,114,128,0.7)';
      ctx.textAlign = 'center';
      ctx.fillText('independent failures — no cross-failure signal', W / 2, H * 0.92);
    } else {
      // All 4 funneling into one NCQ prompt, one response box
      const N = 4;
      const colW = W / (N + 1);
      const promptX = W * 0.5;
      const promptY = H * 0.62;

      for (let i = 0; i < N; i++) {
        const cx = colW * (i + 0.7);
        const by = H * 0.22;
        drawRoundedRect(ctx, cx - 36, by - 14, 72, 28, 5, 'rgba(239,68,68,0.12)', 'rgba(239,68,68,0.45)');
        ctx.fillStyle = '#ef4444';
        ctx.textAlign = 'center';
        ctx.font = `10px var(--ff-mono, monospace)`;
        ctx.fillText('✗ ' + wrongLabels[i], cx, by);

        // Arrow toward center prompt
        drawArrow(ctx, cx, by + 14, promptX, promptY - 22, 'rgba(139,92,246,0.45)');
      }

      // NCQ prompt box
      drawRoundedRect(ctx, promptX - 100, promptY - 20, 200, 40, 7, 'rgba(139,92,246,0.12)', 'rgba(139,92,246,0.5)');
      ctx.fillStyle = '#a78bfa';
      ctx.textAlign = 'center';
      ctx.font = `9.5px var(--ff-mono, monospace)`;
      ctx.fillText('WRONG: Berlin, London, Madrid, Rome', promptX, promptY - 5);
      ctx.fillStyle = 'rgba(139,92,246,0.7)';
      ctx.fillText('<candidate> traces </candidate>', promptX, promptY + 9);

      // Arrow to output
      drawArrow(ctx, promptX, promptY + 20, promptX, H * 0.88, 'rgba(16,185,129,0.6)');
      drawRoundedRect(ctx, promptX - 60, H * 0.88, 120, 24, 5, 'rgba(16,185,129,0.12)', 'rgba(16,185,129,0.5)');
      ctx.fillStyle = '#10b981';
      ctx.font = `10px var(--ff-mono, monospace)`;
      ctx.fillText('on-policy response', promptX, H * 0.88 + 12);

      ctx.fillStyle = 'rgba(107,114,128,0.7)';
      ctx.textAlign = 'center';
      ctx.font = `10px var(--ff-mono, monospace)`;
      ctx.fillText('collective signal — patterns visible across failures', W / 2, H * 0.97);
    }
  }
  drawNCQ();
}

// ─────────────────────────────────────────────────────────────
// §04 REPLAY BUFFER CANVAS
// ─────────────────────────────────────────────────────────────
const replayCanvas = document.getElementById('replay-canvas');
if (replayCanvas) {
  const ctx = replayCanvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const W = replayCanvas.clientWidth, H = 260;
  replayCanvas.width = W * DPR; replayCanvas.height = H * DPR; ctx.scale(DPR, DPR);

  const QUESTIONS = [
    {id:'Q1', acc:0.0, visits:0, state:'new', graduated:false},
    {id:'Q2', acc:0.0, visits:0, state:'new', graduated:false},
    {id:'Q3', acc:0.125, visits:0, state:'new', graduated:false},
    {id:'Q4', acc:0.375, visits:0, state:'new', graduated:false},
    {id:'Q5', acc:0.0, visits:0, state:'new', graduated:false},
  ];

  let replayBuf = [];
  let stepCount = 0;
  const replayLog = document.getElementById('replay-log');

  function seededAcc(q, visit) {
    // Simulate accuracy improving with BCQ/NCQ visits
    const base = q.acc;
    const improvement = Math.min(base + visit * 0.12, 1.0);
    return improvement + (((q.id.charCodeAt(1) * 137 + visit * 31) % 100) / 1000);
  }

  function replayStep() {
    stepCount++;
    let msg = '';

    // Process new questions (add to buffer if hard)
    for (const q of QUESTIONS) {
      if (q.state === 'new') {
        if (q.acc < 0.5) {
          q.state = 'buffered';
          replayBuf.push(q);
          msg = `Q${q.id.slice(1)} admitted to buffer (acc=${q.acc.toFixed(2)})`;
        } else {
          q.state = 'easy';
          msg = `Q${q.id.slice(1)} skipped (acc=${q.acc.toFixed(2)} ≥ 0.5)`;
        }
        drawReplay();
        if (replayLog) replayLog.textContent = msg;
        return;
      }
    }

    // Process buffered questions
    if (replayBuf.length > 0) {
      const q = replayBuf[0];
      q.visits++;
      const newAcc = seededAcc(q, q.visits);
      q.acc = Math.min(newAcc, 0.95);
      if (q.acc >= 0.5) {
        q.state = 'graduated';
        q.graduated = true;
        replayBuf.shift();
        msg = `✓ ${q.id} graduated! (acc=${q.acc.toFixed(2)} ≥ 0.5, after ${q.visits} replay visits)`;
      } else {
        msg = `↺ ${q.id} replayed with fresh BCQ/NCQ (acc=${q.acc.toFixed(2)}, visit ${q.visits})`;
      }
      drawReplay();
      if (replayLog) replayLog.textContent = msg;
      return;
    }

    msg = 'All questions graduated — training complete!';
    if (replayLog) replayLog.textContent = msg;
  }

  function resetReplay() {
    QUESTIONS.forEach(q => { q.acc = [0.0,0.0,0.125,0.375,0.0][QUESTIONS.indexOf(q)]; q.visits = 0; q.state = 'new'; q.graduated = false; });
    replayBuf = [];
    stepCount = 0;
    if (replayLog) replayLog.textContent = 'Click ▶ Step to simulate a training step.';
    drawReplay();
  }

  function drawReplay() {
    ctx.clearRect(0, 0, W, H);
    ctx.font = `10px var(--ff-mono, monospace)`;
    ctx.textBaseline = 'middle';

    // Lane labels
    const lanes = ['new', 'buffered', 'graduated'];
    const laneColors = ['rgba(107,114,128,0.5)', 'rgba(139,92,246,0.5)', 'rgba(16,185,129,0.5)'];
    const laneW = W / 3;
    for (let l = 0; l < 3; l++) {
      const lx = l * laneW;
      ctx.strokeStyle = 'rgba(255,255,255,0.05)';
      ctx.lineWidth = 1;
      if (l > 0) { ctx.beginPath(); ctx.moveTo(lx, 0); ctx.lineTo(lx, H); ctx.stroke(); }
      ctx.fillStyle = laneColors[l];
      ctx.textAlign = 'center';
      ctx.font = `9px var(--ff-mono, monospace)`;
      ctx.fillText(['New Questions', 'Replay Buffer', 'Graduated'][l], lx + laneW / 2, 14);
    }

    // Draw questions
    const newQs = QUESTIONS.filter(q => q.state === 'new');
    const bufQs = QUESTIONS.filter(q => q.state === 'buffered');
    const gradQs = QUESTIONS.filter(q => q.state === 'graduated');

    function drawQ(q, x, y) {
      const col = q.state === 'graduated' ? 'rgba(16,185,129,0.7)' : q.state === 'buffered' ? 'rgba(139,92,246,0.6)' : 'rgba(107,114,128,0.5)';
      const fill = q.state === 'graduated' ? 'rgba(16,185,129,0.12)' : q.state === 'buffered' ? 'rgba(139,92,246,0.1)' : 'rgba(107,114,128,0.08)';
      ctx.beginPath();
      ctx.roundRect(x - 42, y - 18, 84, 36, 6);
      ctx.fillStyle = fill; ctx.fill();
      ctx.strokeStyle = col; ctx.lineWidth = 1.5; ctx.stroke();
      ctx.fillStyle = col;
      ctx.font = `bold 10px var(--ff-mono, monospace)`;
      ctx.textAlign = 'center';
      ctx.fillText(q.id, x, y - 5);
      ctx.font = `9px var(--ff-mono, monospace)`;
      ctx.fillStyle = 'rgba(107,114,128,0.8)';
      const visitStr = q.visits > 0 ? ` v=${q.visits}` : '';
      ctx.fillText(`acc=${q.acc.toFixed(2)}${visitStr}`, x, y + 9);
    }

    newQs.forEach((q, i) => drawQ(q, laneW * 0.5, 50 + i * 48));
    bufQs.forEach((q, i) => drawQ(q, laneW * 1.5, 50 + i * 48));
    gradQs.forEach((q, i) => drawQ(q, laneW * 2.5, 50 + i * 48));

    // Step counter
    ctx.font = `9px var(--ff-mono, monospace)`;
    ctx.fillStyle = 'rgba(107,114,128,0.6)';
    ctx.textAlign = 'right';
    ctx.fillText(`step=${stepCount}  buffer=${replayBuf.length}`, W - 6, H - 8);
  }

  document.getElementById('replay-step-btn')?.addEventListener('click', replayStep);
  document.getElementById('replay-reset-btn')?.addEventListener('click', resetReplay);
  if (replayLog) replayLog.textContent = 'Click ▶ Step to simulate a training step.';
  drawReplay();
}

// ─────────────────────────────────────────────────────────────
// §05 SCALE CHART CANVAS
// ─────────────────────────────────────────────────────────────
const scaleCanvas = document.getElementById('scale-canvas');
if (scaleCanvas) {
  const ctx = scaleCanvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const W = scaleCanvas.clientWidth, H = 240;
  scaleCanvas.width = W * DPR; scaleCanvas.height = H * DPR; ctx.scale(DPR, DPR);

  const scales = ['0.8B', '2B', '4B', '9B'];
  const zppoVals = [9.3, 5.2, 4.0, 2.8];
  const grpoVals = [4.4, 2.4, 2.1, 1.5];
  const PAD = { l: 52, r: 20, t: 28, b: 40 };
  const cW = W - PAD.l - PAD.r;
  const cH = H - PAD.t - PAD.b;
  const maxY = 10.5;

  function yToCanvas(v) { return PAD.t + cH * (1 - v / maxY); }
  function xToCanvas(i) { return PAD.l + cW * (i / (scales.length - 1)); }

  ctx.strokeStyle = 'rgba(255,255,255,0.06)';
  ctx.lineWidth = 1;
  [2, 4, 6, 8, 10].forEach(v => {
    const y = yToCanvas(v);
    ctx.beginPath(); ctx.moveTo(PAD.l, y); ctx.lineTo(PAD.l + cW, y); ctx.stroke();
    ctx.fillStyle = 'rgba(107,114,128,0.5)';
    ctx.font = `9px var(--ff-mono, monospace)`;
    ctx.textAlign = 'right';
    ctx.textBaseline = 'middle';
    ctx.fillText('+' + v, PAD.l - 6, y);
  });

  // Axes
  ctx.strokeStyle = 'rgba(255,255,255,0.15)';
  ctx.lineWidth = 1;
  ctx.beginPath(); ctx.moveTo(PAD.l, PAD.t); ctx.lineTo(PAD.l, PAD.t + cH); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(PAD.l, PAD.t + cH); ctx.lineTo(PAD.l + cW, PAD.t + cH); ctx.stroke();

  // X labels
  ctx.fillStyle = 'rgba(107,114,128,0.8)';
  ctx.font = `9.5px var(--ff-mono, monospace)`;
  ctx.textAlign = 'center';
  ctx.textBaseline = 'top';
  scales.forEach((s, i) => ctx.fillText(s, xToCanvas(i), PAD.t + cH + 6));

  // Y label
  ctx.save();
  ctx.translate(12, H / 2);
  ctx.rotate(-Math.PI / 2);
  ctx.textAlign = 'center';
  ctx.fillStyle = 'rgba(107,114,128,0.6)';
  ctx.font = `9px var(--ff-mono, monospace)`;
  ctx.fillText('VLM Avg Δ (pp)', 0, 0);
  ctx.restore();

  function drawLine(vals, color, dash) {
    ctx.strokeStyle = color;
    ctx.lineWidth = 2;
    if (dash) ctx.setLineDash([4, 4]); else ctx.setLineDash([]);
    ctx.beginPath();
    vals.forEach((v, i) => {
      const x = xToCanvas(i), y = yToCanvas(v);
      i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
    });
    ctx.stroke();
    ctx.setLineDash([]);
    vals.forEach((v, i) => {
      ctx.beginPath();
      ctx.arc(xToCanvas(i), yToCanvas(v), 4, 0, Math.PI * 2);
      ctx.fillStyle = color; ctx.fill();
    });
  }

  drawLine(grpoVals, 'rgba(6,182,212,0.7)', true);
  drawLine(zppoVals, '#8b5cf6', false);

  // Labels at ends
  ctx.font = `9.5px var(--ff-mono, monospace)`;
  ctx.textAlign = 'left';
  ctx.textBaseline = 'middle';
  ctx.fillStyle = '#8b5cf6';
  ctx.fillText('ZPPO', xToCanvas(3) + 7, yToCanvas(zppoVals[3]));
  ctx.fillStyle = 'rgba(6,182,212,0.7)';
  ctx.fillText('GRPO†', xToCanvas(3) + 7, yToCanvas(grpoVals[3]));

  // Title
  ctx.fillStyle = 'rgba(107,114,128,0.6)';
  ctx.font = `9px var(--ff-mono, monospace)`;
  ctx.textAlign = 'center';
  ctx.textBaseline = 'top';
  ctx.fillText('student model size →', W / 2, 8);
}

// ─────────────────────────────────────────────────────────────
// §06 ANIMATED BAR CHARTS
// ─────────────────────────────────────────────────────────────
const resultsSection = document.getElementById('s-results');
if (resultsSection) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        // Positive bars
        document.querySelectorAll('.bar-fill:not(.neg)[data-w]').forEach(b => {
          b.style.width = b.dataset.w + '%';
        });
        // Negative bars
        document.querySelectorAll('.bar-fill.neg[data-w]').forEach(b => {
          b.style.width = b.dataset.w + '%';
        });
      }
    });
  }, { threshold: 0.2 }).observe(resultsSection);
}
</script>
</BaseLayout>

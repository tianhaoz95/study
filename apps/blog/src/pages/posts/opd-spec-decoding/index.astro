// ── Step navigator (§03 OPD) ─────────────────────────────────────
(function () {
  let step = 0;
  const boxes   = document.querySelectorAll('#opd-steps .step-box');
  const prevBtn = document.getElementById('opd-prev');
  const nextBtn = document.getElementById('opd-next');
  const progEl  = document.getElementById('opd-prog');
  function update() {
    boxes.forEach((b, i) => {
      b.classList.remove('active', 'done');
      if (i === step) b.classList.add('active');
      else if (i < step) b.classList.add('done');
    });
    boxes.forEach((b, i) => {
      const n = b.querySelector('.step-num');
      if (n) n.textContent = i < step ? '✓' : String(i + 1);
    });
    if (prevBtn) prevBtn.disabled = step === 0;
    if (nextBtn) nextBtn.disabled = step === boxes.length - 1;
    if (progEl) progEl.textContent = 'Step ' + (step + 1) + ' of ' + boxes.length;
  }
  prevBtn?.addEventListener('click', () => { if (step > 0) { step--; update(); } });
  nextBtn?.addEventListener('click', () => { if (step < boxes.length - 1) { step++; update(); } });
  update();
})();

// ══════════════════════════════════════════════════════════════════
// CANVAS 1 — Mismatch Animation
// ══════════════════════════════════════════════════════════════════
(function () {
  const canvas = document.getElementById('mm-canvas');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  function resize() {
    const W = canvas.clientWidth;
    canvas.width = W * DPR; canvas.height = 215 * DPR;
    canvas.style.height = '215px'; draw();
  }
  const ctx = canvas.getContext('2d');

  const tokP  = ['What', 'is', 'France', "'s"]; // prompt
  const tokG  = ['capital', '?', 'Paris', '!'];  // generated (training: all gold; inference: mixed)
  // training gen: all gold
  // inference gen: accepted=green, rejected+resampled=amber
  // pattern: [accept, accept, reject, accept]
  const infType = ['accept', 'accept', 'reject', 'accept'];

  let step = 0; // 0..8
  let animId = null;

  function W() { return canvas.width / DPR; }

  function drawToken(x, y, text, fill, border) {
    const R = 19;
    ctx.beginPath(); ctx.arc(x * DPR, y * DPR, R * DPR, 0, Math.PI * 2);
    ctx.fillStyle = fill; ctx.fill();
    ctx.strokeStyle = border; ctx.lineWidth = 1.5 * DPR; ctx.stroke();
    const fs = text.length > 5 ? 7 : 8.5;
    ctx.font = `bold ${fs * DPR}px 'JetBrains Mono', monospace`;
    ctx.fillStyle = 'rgba(255,255,255,.92)';
    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    ctx.fillText(text, x * DPR, y * DPR);
  }

  function draw() {
    const w = W();
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    const rowA = 78, rowB = 158;
    const tokStart = 55, spacing = (w - tokStart - 15) / 8;

    // Row labels
    ctx.font = `bold ${8 * DPR}px 'JetBrains Mono', monospace`;
    ctx.fillStyle = '#94a3b8'; ctx.textAlign = 'left'; ctx.textBaseline = 'middle';
    ctx.fillText('TRAIN', 5 * DPR, rowA * DPR);
    ctx.fillText('INFER', 5 * DPR, rowB * DPR);

    // Separator
    const sepX = tokStart + 4 * spacing - spacing * 0.5;
    ctx.strokeStyle = 'rgba(255,255,255,.09)'; ctx.lineWidth = DPR;
    ctx.setLineDash([3 * DPR, 3 * DPR]);
    ctx.beginPath(); ctx.moveTo(sepX * DPR, 50 * DPR); ctx.lineTo(sepX * DPR, 190 * DPR); ctx.stroke();
    ctx.setLineDash([]);
    ctx.font = `${6.5 * DPR}px 'JetBrains Mono', monospace`;
    ctx.fillStyle = '#475569'; ctx.textAlign = 'center';
    ctx.fillText('← prompt →', (tokStart + 1.5 * spacing) * DPR, 203 * DPR);
    ctx.fillText('← generated →', (tokStart + 5.5 * spacing) * DPR, 203 * DPR);

    // Legend
    const lx = w - 160, ly = 8;
    [['rgba(139,92,246,.7)', '#a78bfa', 'prompt'],
     ['rgba(245,158,11,.7)', '#f59e0b', 'target (training)'],
     ['rgba(16,185,129,.7)', '#10b981', 'accepted (infer)'],
     ['rgba(245,158,11,.65)', '#fbbf24', 'reject→resample']
    ].forEach(([fill, stroke, label], i) => {
      const cy = ly + i * 16 + 7;
      ctx.beginPath(); ctx.arc((lx + 5) * DPR, cy * DPR, 5 * DPR, 0, Math.PI * 2);
      ctx.fillStyle = fill; ctx.fill(); ctx.strokeStyle = stroke; ctx.lineWidth = DPR; ctx.stroke();
      ctx.font = `${6.5 * DPR}px 'JetBrains Mono', monospace`;
      ctx.fillStyle = '#64748b'; ctx.textAlign = 'left'; ctx.textBaseline = 'middle';
      ctx.fillText(label, (lx + 13) * DPR, cy * DPR);
    });

    for (let i = 0; i < 8 && i < step; i++) {
      const ti = i < 4 ? i : i - 4;
      const x = tokStart + i * spacing;
      if (i < 4) {
        // Prompt — both rows, purple
        drawToken(x, rowA, tokP[ti], 'rgba(139,92,246,.7)', '#a78bfa');
        drawToken(x, rowB, tokP[ti], 'rgba(139,92,246,.7)', '#a78bfa');
      } else {
        // Training row: all gold (target sequences)
        drawToken(x, rowA, tokG[ti], 'rgba(245,158,11,.7)', '#f59e0b');
        // Inference row: accept or reject+resample
        const t = infType[ti];
        const fill = t === 'accept' ? 'rgba(16,185,129,.7)' : 'rgba(245,158,11,.65)';
        const border = t === 'accept' ? '#10b981' : '#fbbf24';
        drawToken(x, rowB, tokG[ti], fill, border);
        if (t === 'reject') {
          // Draw rejection X
          ctx.strokeStyle = '#fbbf24'; ctx.lineWidth = 1.5 * DPR;
          ctx.beginPath(); ctx.moveTo((x - 8) * DPR, (rowB + 24) * DPR); ctx.lineTo((x + 8) * DPR, (rowB + 38) * DPR); ctx.stroke();
          ctx.beginPath(); ctx.moveTo((x + 8) * DPR, (rowB + 24) * DPR); ctx.lineTo((x - 8) * DPR, (rowB + 38) * DPR); ctx.stroke();
          ctx.font = `${6 * DPR}px 'JetBrains Mono', monospace`;
          ctx.fillStyle = '#fbbf24'; ctx.textAlign = 'center';
          ctx.fillText('rejected', x * DPR, (rowB + 46) * DPR);
        }
      }
    }

    // Training context label (when step >= 8)
    if (step >= 8) {
      ctx.font = `${7 * DPR}px 'JetBrains Mono', monospace`;
      ctx.fillStyle = '#ef4444'; ctx.textAlign = 'center';
      ctx.fillText('Training context ≠ Inference context', (w / 2) * DPR, 15 * DPR);
    }
  }

  function playStep() {
    if (step >= 8) { document.getElementById('mm-play').textContent = '▶ Play'; return; }
    step++; draw();
    animId = setTimeout(playStep, step <= 4 ? 350 : 500);
  }

  document.getElementById('mm-play').addEventListener('click', function() {
    if (animId) { clearTimeout(animId); animId = null; this.textContent = '▶ Play'; return; }
    if (step >= 8) { step = 0; draw(); }
    this.textContent = '⏸ Pause'; playStep();
  });
  document.getElementById('mm-reset').addEventListener('click', () => {
    clearTimeout(animId); animId = null; step = 0; draw();
    document.getElementById('mm-play').textContent = '▶ Play';
  });

  resize();
  window.addEventListener('resize', resize);
})();

// ══════════════════════════════════════════════════════════════════
// CANVAS 2 — Acceptance Rate over Training
// ══════════════════════════════════════════════════════════════════
(function () {
  const canvas = document.getElementById('acc-canvas');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  function resize() {
    const W = canvas.clientWidth;
    canvas.width = W * DPR; canvas.height = 240 * DPR;
    canvas.style.height = '240px'; render();
  }
  const ctx = canvas.getContext('2d');

  const iters = 200;
  // Simulate acceptance rate curves
  function curve(baseline, plateau, tau, noise) {
    return Array.from({length: iters + 1}, (_, i) => {
      const v = baseline + (plateau - baseline) * (1 - Math.exp(-i / tau));
      return v + (Math.random() - 0.5) * noise;
    });
  }
  // Seeded-ish: compute once
  const curves = {
    offpolicy: curve(68, 72,  60, 0.3),
    k1:        curve(68, 78,  40, 0.5),
    k3:        curve(68, 83,  35, 0.6),
    k5:        curve(68, 87,  30, 0.7),
  };

  const palette = {
    offpolicy: { color: '#94a3b8', label: 'Off-policy (baseline)', desc: 'Standard EAGLE-3 training on target-generated sequences. Acceptance rate plateaus around 72% — the distribution mismatch limits further improvement.' },
    k1:        { color: '#06b6d4', label: 'On-policy K=1',   desc: 'On-policy RVT training with K=1 draft token per step. A single draft token gives limited acceptance signal, but the on-policy objective still helps — plateau rises to ~78%.' },
    k3:        { color: '#a78bfa', label: 'On-policy K=3',   desc: 'K=3 draft tokens per step. Three rejection events per step give 3× more signal per batch about overestimated tokens. Plateau rises to ~83%.' },
    k5:        { color: '#10b981', label: 'On-policy K=5',   desc: 'K=5 draft tokens per step. The acceptance/rejection signal is richest here — each rejected token directly targets an overestimated probability. Plateau ~87%.' },
  };

  let active = 'offpolicy';

  const descEl = document.getElementById('acc-desc');
  descEl.textContent = palette.offpolicy.desc;

  function render() {
    const W = canvas.width / DPR, H = canvas.height / DPR;
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    const padL = 44, padR = 16, padT = 20, padB = 36;
    const mn = 60, mx = 92;

    // Grid
    ctx.strokeStyle = 'rgba(255,255,255,.05)'; ctx.lineWidth = DPR;
    [65,70,75,80,85,90].forEach(y => {
      const cy = padT + (1 - (y - mn) / (mx - mn)) * (H - padT - padB);
      ctx.beginPath(); ctx.moveTo(padL * DPR, cy * DPR); ctx.lineTo((W - padR) * DPR, cy * DPR); ctx.stroke();
      ctx.font = `${7 * DPR}px 'JetBrains Mono', monospace`;
      ctx.fillStyle = '#475569'; ctx.textAlign = 'right'; ctx.textBaseline = 'middle';
      ctx.fillText(y + '%', (padL - 4) * DPR, cy * DPR);
    });

    // Axes
    ctx.strokeStyle = 'rgba(255,255,255,.12)'; ctx.lineWidth = DPR;
    ctx.beginPath(); ctx.moveTo(padL * DPR, padT * DPR); ctx.lineTo(padL * DPR, (H - padB) * DPR); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(padL * DPR, (H - padB) * DPR); ctx.lineTo((W - padR) * DPR, (H - padB) * DPR); ctx.stroke();

    // X label
    ctx.font = `${7.5 * DPR}px 'JetBrains Mono', monospace`; ctx.fillStyle = '#64748b'; ctx.textAlign = 'center';
    ctx.fillText('training iterations', (padL + (W - padL - padR) / 2) * DPR, (H - 4) * DPR);
    // Y label
    ctx.save(); ctx.translate(10 * DPR, (H / 2) * DPR); ctx.rotate(-Math.PI / 2);
    ctx.textAlign = 'center'; ctx.textBaseline = 'middle'; ctx.fillText('acceptance rate (%)', 0, 0); ctx.restore();

    // X tick labels
    [0, 50, 100, 150, 200].forEach(x => {
      const cx = padL + x / iters * (W - padL - padR);
      ctx.font = `${6.5 * DPR}px 'JetBrains Mono', monospace`;
      ctx.fillStyle = '#475569'; ctx.textAlign = 'center'; ctx.textBaseline = 'top';
      ctx.fillText(String(x), cx * DPR, (H - padB + 3) * DPR);
    });

    function drawCurve(key, alpha) {
      const data = curves[key];
      const col = palette[key].color;
      const lw = key === active ? 2.4 : 1.2;
      ctx.globalAlpha = alpha;
      ctx.beginPath();
      data.forEach((v, i) => {
        const cx = padL + i / iters * (W - padL - padR);
        const cy = padT + (1 - (v - mn) / (mx - mn)) * (H - padT - padB);
        i === 0 ? ctx.moveTo(cx * DPR, cy * DPR) : ctx.lineTo(cx * DPR, cy * DPR);
      });
      ctx.strokeStyle = col; ctx.lineWidth = lw * DPR; ctx.lineJoin = 'round'; ctx.stroke();
      // End label
      const last = data[iters];
      const ey = padT + (1 - (last - mn) / (mx - mn)) * (H - padT - padB);
      ctx.beginPath(); ctx.arc((W - padR) * DPR, ey * DPR, 3.5 * DPR, 0, Math.PI * 2);
      ctx.fillStyle = col; ctx.fill();
      ctx.font = `bold ${7 * DPR}px 'JetBrains Mono', monospace`;
      ctx.textAlign = 'left'; ctx.textBaseline = 'middle'; ctx.fillStyle = col;
      ctx.fillText(last.toFixed(0) + '%', (W - padR + 5) * DPR, ey * DPR);
      ctx.globalAlpha = 1;
    }

    // Draw all curves
    ['offpolicy','k1','k3','k5'].forEach(key => drawCurve(key, key === active ? 1 : 0.3));

    // Legend
    let lx = padL + 6, ly = padT + 5;
    ['offpolicy','k1','k3','k5'].forEach(key => {
      ctx.beginPath(); ctx.moveTo(lx * DPR, ly * DPR); ctx.lineTo((lx + 18) * DPR, ly * DPR);
      ctx.strokeStyle = palette[key].color; ctx.lineWidth = (key === active ? 2.2 : 1.2) * DPR; ctx.stroke();
      ctx.font = `${7 * DPR}px 'JetBrains Mono', monospace`; ctx.fillStyle = key === active ? '#e2e8f0' : '#64748b';
      ctx.textAlign = 'left'; ctx.textBaseline = 'middle';
      ctx.fillText(palette[key].label, (lx + 22) * DPR, ly * DPR);
      ly += 14;
    });
  }

  function selectLine(key) {
    active = key;
    ['offpolicy','k1','k3','k5'].forEach(k => {
      const btn = document.getElementById('acc-' + k);
      if (btn) btn.classList.toggle('active', k === key);
    });
    descEl.textContent = palette[key].desc;
    render();
  }

  ['offpolicy','k1','k3','k5'].forEach(key => {
    const btn = document.getElementById('acc-' + key);
    if (btn) btn.addEventListener('click', () => selectLine(key));
  });

  resize();
  window.addEventListener('resize', resize);
})();
</script>

</BaseLayout>

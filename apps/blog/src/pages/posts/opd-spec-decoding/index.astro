---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="On-Policy Training for Speculative Decoding: Disaggregated RVT | AI/ML Deep Dives"
  description="Draft models have the same exposure bias as KD students. On-policy training through the accept/reject loop fixes it. A disaggregated Rollout-Verify-Train architecture makes it scale."
  crumb="OPD for Spec Decoding"
>


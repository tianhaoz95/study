<script>
// ─── TOC + sidebar toggles ───
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});
const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ─── Code sidebar tab switching ───
const tabMeta = {
  plateau:  { file: 'agi_to_asi.py',        title: 'The Plateau Myth' },
  compute:  { file: 'compute_forecast.py',  title: '10× Compounding' },
  pathways: { file: 'pathways.py',          title: 'Four Pathways' },
  rsi:      { file: 'rsi_loops.py',         title: 'Recursive Improvement' },
  friction: { file: 'bottlenecks.py',       title: 'Bottlenecks' },
  aixi:     { file: 'aixi.py',              title: 'AIXI Upper Bound' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ─── IntersectionObserver — sync TOC + sidebar on scroll ───
const sectionMap = {
  's-plateau': 'plateau',
  's-compute':  'compute',
  's-pathways': 'pathways',
  's-rsi':      'rsi',
  's-friction': 'friction',
  's-aixi':     'aixi',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.25 }).observe(s)
);

// ─── §01 Digital Advantages table ───
(function buildAdvTable() {
  const ADVANTAGES = [
    { icon: '⚡', title: 'I/O Speed', bio: 'Reads at ~300 words/min', ai: 'Ingests entire books in seconds', color: 'var(--purple)' },
    { icon: '🧠', title: 'Processing Speed', bio: 'Fixed ~86B neurons, ~100 Hz', ai: 'Scales with compute; can be parallelized', color: 'var(--cyan)' },
    { icon: '💾', title: 'Working Memory', bio: '7±2 chunks; lossy compression', ai: 'Millions of tokens; perfect recall from disk', color: 'var(--green)' },
    { icon: '📋', title: 'Lossless Replication', bio: 'Cannot copy a mind exactly', ai: 'Weights + memory state copied byte-for-byte', color: 'var(--purple)' },
    { icon: '🔄', title: 'Substrate Independence', bio: 'Tied to one biological body', ai: 'Migrates across hardware; upgrades at runtime', color: 'var(--cyan)' },
    { icon: '📡', title: 'Knowledge Sharing', bio: 'Lossy language; slow communication', ai: 'Raw gradients shared at network bandwidth', color: 'var(--green)' },
  ];

  const container = document.getElementById('adv-table-container');
  if (!container) return;

  let selectedRow = null;

  function render() {
    container.innerHTML = '';
    const table = document.createElement('table');
    table.style.cssText = 'width:100%;border-collapse:collapse';
    const thead = document.createElement('thead');
    thead.innerHTML = `<tr>
      <th style="text-align:left;padding:.4rem .5rem;font-size:.65rem;font-weight:600;letter-spacing:.07em;text-transform:uppercase;color:var(--muted);border-bottom:1px solid var(--border)">Capability</th>
      <th style="text-align:left;padding:.4rem .5rem;font-size:.65rem;font-weight:600;letter-spacing:.07em;text-transform:uppercase;color:var(--muted);border-bottom:1px solid var(--border)">Biological</th>
      <th style="text-align:left;padding:.4rem .5rem;font-size:.65rem;font-weight:600;letter-spacing:.07em;text-transform:uppercase;color:var(--muted);border-bottom:1px solid var(--border)">Digital AI</th>
    </tr>`;
    table.appendChild(thead);
    const tbody = document.createElement('tbody');

    ADVANTAGES.forEach((adv, i) => {
      const tr = document.createElement('tr');
      const isSelected = selectedRow === i;
      tr.style.cssText = `cursor:pointer;transition:background .15s;background:${isSelected ? 'rgba(139,92,246,.08)' : 'transparent'}`;
      tr.innerHTML = `
        <td style="padding:.45rem .5rem;font-size:.78rem;font-weight:600;color:${adv.color};border-bottom:1px solid var(--border);white-space:nowrap">
          ${adv.icon} ${adv.title}
        </td>
        <td style="padding:.45rem .5rem;font-size:.75rem;color:var(--muted);border-bottom:1px solid var(--border)">${adv.bio}</td>
        <td style="padding:.45rem .5rem;font-size:.75rem;color:var(--text2);border-bottom:1px solid var(--border)">${adv.ai}</td>
      `;
      tr.addEventListener('click', () => {
        selectedRow = selectedRow === i ? null : i;
        render();
      });
      tbody.appendChild(tr);

      if (isSelected) {
        const expandTr = document.createElement('tr');
        expandTr.innerHTML = `<td colspan="3" style="padding:.625rem .75rem 1rem;background:rgba(139,92,246,.06);border-left:2px solid ${adv.color};border-bottom:1px solid var(--border)">
          <div style="font-size:.75rem;color:var(--muted2);line-height:1.6">
            <strong style="color:${adv.color}">${adv.title}:</strong> This advantage intensifies with compute — the gap between AI and human capability in this dimension widens as AI systems scale. Humans would still benefit from better tools, but AIs benefit disproportionately.
          </div>
        </td>`;
        tbody.appendChild(expandTr);
      }
    });
    table.appendChild(tbody);
    container.appendChild(table);
  }
  render();
})();

// ─── §02 Instance slider ───
(function initInstanceSlider() {
  const slider = document.getElementById('year-slider');
  const yearLabel = document.getElementById('year-label');
  const icInstances = document.getElementById('ic-instances');
  const icSpeedup = document.getElementById('ic-speedup');
  const icResearch = document.getElementById('ic-research');
  if (!slider) return;

  function update() {
    const yr = parseInt(slider.value);
    const instances = Math.pow(10, yr);
    yearLabel.textContent = yr === 0 ? 'Year 0' : `Year ${yr}`;

    const fmt = n => n >= 1e9 ? (n/1e9).toFixed(0) + 'B' :
                     n >= 1e6 ? (n/1e6).toFixed(0) + 'M' :
                     n >= 1e3 ? (n/1e3).toFixed(0) + 'K' : n.toFixed(0);
    icInstances.textContent = fmt(instances);
    icSpeedup.textContent = fmt(instances) + '×';
    icResearch.textContent = fmt(instances) + '×';
  }
  slider.addEventListener('input', update);
  update();
})();

// ─── §02 Compute chart ───
(function drawComputeChart() {
  const canvas = document.getElementById('compute-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 260;
  canvas.width = W * DPR; canvas.height = H * DPR;
  ctx.scale(DPR, DPR);

  const PAD = { top: 20, right: 20, bottom: 40, left: 54 };
  const cw = W - PAD.left - PAD.right;
  const ch = H - PAD.top - PAD.bottom;

  const YEARS = 9; // 0..8
  const MAX_LOG = 8; // 10^8

  function gx(yr) { return PAD.left + (yr / (YEARS - 1)) * cw; }
  function gy(logVal) { return PAD.top + ch - (logVal / MAX_LOG) * ch; }

  // Grid lines
  ctx.strokeStyle = 'rgba(255,255,255,0.04)';
  ctx.lineWidth = 1;
  for (let logV = 0; logV <= MAX_LOG; logV += 2) {
    ctx.beginPath();
    ctx.moveTo(PAD.left, gy(logV));
    ctx.lineTo(PAD.left + cw, gy(logV));
    ctx.stroke();
    ctx.fillStyle = 'rgba(255,255,255,0.3)';
    ctx.font = `${10 * DPR / DPR}px monospace`;
    ctx.textAlign = 'right';
    const labels = ['1', '100', '10K', '1M', '100M'];
    if (logV % 2 === 0) {
      ctx.fillText(labels[logV/2] || '', PAD.left - 6, gy(logV) + 4);
    }
  }

  // Vertical year gridlines
  for (let yr = 0; yr < YEARS; yr++) {
    ctx.beginPath();
    ctx.strokeStyle = 'rgba(255,255,255,0.03)';
    ctx.moveTo(gx(yr), PAD.top);
    ctx.lineTo(gx(yr), PAD.top + ch);
    ctx.stroke();
  }

  // AI effective compute curve (10^year)
  ctx.beginPath();
  ctx.strokeStyle = '#8b5cf6';
  ctx.lineWidth = 2.5;
  for (let yr = 0; yr < YEARS; yr++) {
    const x = gx(yr), y = gy(yr);
    yr === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
  }
  ctx.stroke();

  // Human research capacity (flat at 1)
  ctx.beginPath();
  ctx.strokeStyle = 'rgba(6,182,212,0.7)';
  ctx.lineWidth = 1.5;
  ctx.setLineDash([4, 4]);
  ctx.moveTo(gx(0), gy(0));
  ctx.lineTo(gx(YEARS - 1), gy(0));
  ctx.stroke();
  ctx.setLineDash([]);

  // Labels on curves
  ctx.font = `${11 * DPR / DPR}px monospace`;
  ctx.fillStyle = '#a78bfa';
  ctx.textAlign = 'left';
  ctx.fillText('AI effective compute', gx(2) + 6, gy(2) - 8);
  ctx.fillStyle = 'rgba(6,182,212,0.9)';
  ctx.fillText('Human research capacity', gx(1) + 6, gy(0) - 8);

  // X-axis labels
  ctx.fillStyle = 'rgba(255,255,255,0.3)';
  ctx.textAlign = 'center';
  for (let yr = 0; yr < YEARS; yr += 2) {
    ctx.fillText(`Yr ${yr}`, gx(yr), H - 8);
  }

  // Y-axis label
  ctx.save();
  ctx.translate(12, PAD.top + ch / 2);
  ctx.rotate(-Math.PI / 2);
  ctx.textAlign = 'center';
  ctx.fillStyle = 'rgba(255,255,255,0.25)';
  ctx.fillText('equiv. AGI instances (log scale)', 0, 0);
  ctx.restore();
})();

// ─── §03 Pathway step navigator ───
(function initPathwayNav() {
  let pathStep = 0;
  const boxes = document.querySelectorAll('#pathway-steps .step-box');
  const prevBtn = document.getElementById('path-prev');
  const nextBtn = document.getElementById('path-next');
  const progEl  = document.getElementById('path-prog');

  function updatePathways() {
    boxes.forEach((b, i) => {
      b.classList.remove('active', 'done');
      if (i === pathStep) b.classList.add('active');
      else if (i < pathStep) b.classList.add('done');
    });
    boxes.forEach((b, i) => {
      const n = b.querySelector('.step-num');
      if (n) n.textContent = i < pathStep ? '✓' : String(i + 1);
    });
    if (prevBtn) prevBtn.disabled = pathStep === 0;
    if (nextBtn) nextBtn.disabled = pathStep === boxes.length - 1;
    if (progEl) progEl.textContent = `Pathway ${pathStep + 1} of ${boxes.length}`;
  }
  prevBtn?.addEventListener('click', () => { if (pathStep > 0) { pathStep--; updatePathways(); } });
  nextBtn?.addEventListener('click', () => { if (pathStep < boxes.length - 1) { pathStep++; updatePathways(); } });
  updatePathways();
})();

// ─── §04 RSI loops canvas ───
(function drawRSICanvas() {
  const canvas = document.getElementById('rsi-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 360;
  canvas.width = W * DPR; canvas.height = H * DPR;
  ctx.scale(DPR, DPR);

  const cx = W / 2, cy = H / 2;
  const R = Math.min(W, H) * 0.32;

  const LOOPS = [
    { label: 'Genotypic', sub: 'Architecture Search\n& Chip Design', angle: -Math.PI / 2, color: '#8b5cf6' },
    { label: 'Memetic', sub: 'Synthetic Data\n& Distillation', angle: 0, color: '#06b6d4' },
    { label: 'Sociogenic', sub: 'Division of Labour\n& Specialization', angle: Math.PI / 2, color: '#10b981' },
    { label: 'Hardware', sub: 'AI-Designed\nAccelerators', angle: Math.PI, color: '#f59e0b' },
  ];

  let hovered = -1;
  const nodeR = 46;

  function drawArrow(fromX, fromY, toX, toY, color, offset) {
    const dx = toX - fromX, dy = toY - fromY;
    const len = Math.sqrt(dx * dx + dy * dy);
    const nx = -dy / len, ny = dx / len;
    const cx1 = fromX + dx * 0.3 + nx * offset, cy1 = fromY + dy * 0.3 + ny * offset;
    const cx2 = fromX + dx * 0.7 + nx * offset, cy2 = fromY + dy * 0.7 + ny * offset;

    ctx.beginPath();
    ctx.moveTo(fromX, fromY);
    ctx.bezierCurveTo(cx1, cy1, cx2, cy2, toX, toY);
    ctx.strokeStyle = color + '60';
    ctx.lineWidth = 1.5;
    ctx.stroke();

    // arrowhead
    const angle2 = Math.atan2(toY - cy2, toX - cx2);
    ctx.beginPath();
    ctx.moveTo(toX, toY);
    ctx.lineTo(toX - 8 * Math.cos(angle2 - 0.4), toY - 8 * Math.sin(angle2 - 0.4));
    ctx.lineTo(toX - 8 * Math.cos(angle2 + 0.4), toY - 8 * Math.sin(angle2 + 0.4));
    ctx.closePath();
    ctx.fillStyle = color + '80';
    ctx.fill();
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);

    // Center node: AI Capability
    ctx.beginPath();
    ctx.arc(cx, cy, 38, 0, Math.PI * 2);
    ctx.fillStyle = 'rgba(139,92,246,0.15)';
    ctx.fill();
    ctx.strokeStyle = '#8b5cf6';
    ctx.lineWidth = 1.5;
    ctx.stroke();

    ctx.fillStyle = '#a78bfa';
    ctx.font = `bold ${12 * DPR / DPR}px monospace`;
    ctx.textAlign = 'center';
    ctx.fillText('AI', cx, cy - 4);
    ctx.fillStyle = 'rgba(255,255,255,0.4)';
    ctx.font = `${10 * DPR / DPR}px monospace`;
    ctx.fillText('capability', cx, cy + 10);

    LOOPS.forEach((loop, i) => {
      const nx = cx + R * Math.cos(loop.angle);
      const ny = cy + R * Math.sin(loop.angle);
      const isH = hovered === i;

      // Draw arrows: center → node and node → center
      const edgeFromCenter = {
        x: cx + 38 * Math.cos(loop.angle),
        y: cy + 38 * Math.sin(loop.angle),
      };
      const edgeFromNode = {
        x: nx - nodeR * Math.cos(loop.angle),
        y: ny - nodeR * Math.sin(loop.angle),
      };
      drawArrow(edgeFromCenter.x, edgeFromCenter.y, nx - nodeR * Math.cos(loop.angle) * 0.9, ny - nodeR * Math.sin(loop.angle) * 0.9, loop.color, 30);
      drawArrow(edgeFromNode.x, edgeFromNode.y, cx + 38 * Math.cos(loop.angle) * 0.9, cy + 38 * Math.sin(loop.angle) * 0.9, loop.color, -30);

      // Node circle
      ctx.beginPath();
      ctx.arc(nx, ny, nodeR, 0, Math.PI * 2);
      const alpha = isH ? '0.25' : '0.12';
      ctx.fillStyle = `rgba(${parseInt(loop.color.slice(1,3),16)},${parseInt(loop.color.slice(3,5),16)},${parseInt(loop.color.slice(5,7),16)},${alpha})`;
      ctx.fill();
      ctx.strokeStyle = isH ? loop.color : loop.color + '80';
      ctx.lineWidth = isH ? 2 : 1;
      ctx.stroke();

      // Labels
      ctx.fillStyle = isH ? loop.color : loop.color + 'cc';
      ctx.font = `bold ${11 * DPR / DPR}px monospace`;
      ctx.textAlign = 'center';
      ctx.fillText(loop.label, nx, ny - 10);

      const lines = loop.sub.split('\n');
      ctx.font = `${9 * DPR / DPR}px sans-serif`;
      ctx.fillStyle = 'rgba(255,255,255,0.45)';
      lines.forEach((l, li) => ctx.fillText(l, nx, ny + 4 + li * 13));
    });
  }

  canvas.addEventListener('mousemove', e => {
    const rect = canvas.getBoundingClientRect();
    const mx = (e.clientX - rect.left), my = (e.clientY - rect.top);
    let found = -1;
    LOOPS.forEach((loop, i) => {
      const nx = cx + R * Math.cos(loop.angle);
      const ny = cy + R * Math.sin(loop.angle);
      const d = Math.sqrt((mx - nx) ** 2 + (my - ny) ** 2);
      if (d < nodeR) found = i;
    });
    hovered = found;
    draw();
  });
  canvas.addEventListener('mouseleave', () => { hovered = -1; draw(); });

  draw();
})();

// ─── §05 Bottleneck gauges (IntersectionObserver) ───
const frictionSection = document.getElementById('s-friction');
if (frictionSection) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.gauge-fill[data-w]').forEach(b => {
          b.style.width = b.dataset.w + '%';
        });
      }
    });
  }, { threshold: 0.2 }).observe(frictionSection);
}

// ─── §06 AIXI hierarchy canvas ───
(function drawAIXI() {
  const canvas = document.getElementById('aixi-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 220;
  canvas.width = W * DPR; canvas.height = H * DPR;
  ctx.scale(DPR, DPR);

  const LEVELS = [
    { label: 'Today\'s LLMs', sub: 'log-loss pretraining (GPT-4, Gemini, Claude)', color: '#06b6d4', x: 0.12, w: 0.65, y: 0.70 },
    { label: 'AGI', sub: 'human-level on virtually all tasks', color: '#8b5cf6', x: 0.25, w: 0.5, y: 0.50 },
    { label: 'ASI', sub: 'exceeds large expert collectives', color: '#a78bfa', x: 0.35, w: 0.3, y: 0.30 },
    { label: 'AIXI', sub: 'theoretical limit — incomputable', color: '#f59e0b', x: 0.40, w: 0.2, y: 0.10 },
  ];

  const barH = 28;
  LEVELS.forEach((lv, i) => {
    const bx = lv.x * W;
    const bw = lv.w * W;
    const by = lv.y * H;

    const hex = lv.color.replace('#', '');
    const r = parseInt(hex.slice(0, 2), 16);
    const g = parseInt(hex.slice(2, 4), 16);
    const b = parseInt(hex.slice(4, 6), 16);

    ctx.beginPath();
    ctx.roundRect(bx, by, bw, barH, 4);
    ctx.fillStyle = `rgba(${r},${g},${b},0.15)`;
    ctx.fill();
    ctx.strokeStyle = `rgba(${r},${g},${b},0.6)`;
    ctx.lineWidth = 1;
    ctx.stroke();

    ctx.fillStyle = lv.color;
    ctx.font = `bold ${11 * DPR / DPR}px monospace`;
    ctx.textAlign = 'left';
    ctx.fillText(lv.label, bx + 10, by + 12);

    ctx.fillStyle = 'rgba(255,255,255,0.38)';
    ctx.font = `${9 * DPR / DPR}px sans-serif`;
    ctx.fillText(lv.sub, bx + 10, by + 24);
  });

  // Upward arrows between levels
  for (let i = 0; i < LEVELS.length - 1; i++) {
    const lv = LEVELS[i], next = LEVELS[i + 1];
    const ax = (lv.x + lv.w / 2) * W;
    const ay = lv.y * H;
    const ay2 = next.y * H + barH;
    ctx.beginPath();
    ctx.moveTo(ax, ay);
    ctx.lineTo(ax, ay2 + 4);
    ctx.strokeStyle = 'rgba(255,255,255,0.12)';
    ctx.lineWidth = 1;
    ctx.setLineDash([3, 4]);
    ctx.stroke();
    ctx.setLineDash([]);
  }

  // Label: Legg-Hutter score
  ctx.save();
  ctx.translate(W - 12, H / 2);
  ctx.rotate(-Math.PI / 2);
  ctx.textAlign = 'center';
  ctx.fillStyle = 'rgba(255,255,255,0.18)';
  ctx.font = `${9 * DPR / DPR}px monospace`;
  ctx.fillText('Legg-Hutter Intelligence Score →', 0, 0);
  ctx.restore();
})();
</script>


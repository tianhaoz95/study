<span class="cs-line"> </span>
<span class="cs-line cmt"># Registering a gradient hook:</span>
<span class="cs-line cmt"># logits.register_hook(zero_sum_project)</span>
<span class="cs-line cmt"># → eliminates NFI entirely</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-nfi">
      <pre class="cs-pre">
<span class="cs-line cmt"># Numerical Feature Inflation (NFI)</span>
<span class="cs-line cmt"># The feedback loop between W_G and μ_G</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Step 1: SC breaks zero-sum →</span>
<span class="cs-line cmt">#   W_G drifts toward -μ_G  (Theorem 3.4)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Step 2: W_G ≠ 0 alters feature gradient</span>
<span class="cs-line cmt"># Under NC3' (WG ⊥ span&#123;W_k*&#125;):</span>
<span class="cs-line hl-p">Proj_&#123;W_G&#125;(∇_h L) = ε · W_G</span>
<span class="cs-line cmt"># → features drift toward -W_G → toward μ_G</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Theorem 3.7: coupled exponential growth</span>
<span class="cs-line hl-c">‖W_G(t)‖ ∝ (1 + η·ε / √K)^t</span>
<span class="cs-line hl-c">‖μ_G(t)‖ ∝ (1 + η·ε / √K)^t</span>
<span class="cs-line hl-c">cos(W_G, μ_G) → -1  (anti-parallel)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Example growth rates (η=1e-3, ε=3e-9, K=10):</span>
<span class="cs-line cmt"># factor per step: 1 + 1e-3*3e-9/√10 ≈ 1.00000095</span>
<span class="cs-line cmt"># after 250 epochs (250*N steps): diverges</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># ResNet18 is immune because ε(t) ∝ 1/t:</span>
<span class="cs-line cmt"># Σ (1 + η·ε(t)/√K) converges →</span>
<span class="cs-line cmt"># growth stays polynomial/logarithmic</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Fix: remove last-layer mean (BatchNorm</span>
<span class="cs-line cmt"># before classifier centers features)</span>
<span class="cs-line hl-g">model = nn.<span class="fn">Sequential</span>(backbone,</span>
<span class="cs-line hl-g">    nn.<span class="fn">BatchNorm1d</span>(d_feat),  <span class="cmt"># key fix</span></span>
<span class="cs-line hl-g">    nn.<span class="fn">Linear</span>(d_feat, K))</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-spike">
      <pre class="cs-pre">
<span class="cs-line cmt"># The Adam amplification calculation</span>
<span class="cs-line cmt"># (β1=0.9, β2=0.95, η=1e-3, ε_Adam=1e-8)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Before spike: gradient ≈ 3e-9</span>
<span class="cs-line cmt"># v_t ≈ 9e-18 (decayed almost to zero)</span>
<span class="cs-line cmt"># effective_lr = η / sqrt(v_t + ε) ≈ 10^5</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># At spike: gradient re-emerges as 1.19e-7</span>
<span class="cs-line cmt"># (the float32 floor above absorption)</span>
<span class="cs-line hl-p">m = 0.9 * 3e-9 + 0.1 * 1.19e-7 = 1.46e-8</span>
<span class="cs-line hl-p">v = 0.95 * 9e-18 + 0.05 * (1.19e-7)**2</span>
<span class="cs-line hl-p">  = 2.7e-8</span>
<span class="cs-line hl-p">update = η * m / sqrt(v) = 4e-4</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Normal update magnitude: ~1e-5</span>
<span class="cs-line cmt"># Spike update magnitude: 4e-4</span>
<span class="cs-line cmt"># Ratio: 40× — confirmed empirically</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Fixes to prevent Adam amplification:</span>
<span class="cs-line hl-g">optimizer = Adam(params,</span>
<span class="cs-line hl-g">    eps=1e-5)  <span class="cmt"># caps effective_lr at 10^2</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Or equivalently: Adafactor-style</span>
<span class="cs-line cmt"># update clipping prevents the explosive</span>
<span class="cs-line cmt"># ratio from causing divergence.</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Note: GD with η=1e5 (emulating Adam's</span>
<span class="cs-line cmt"># inflated step) also triggers spike at</span>
<span class="cs-line cmt"># the same epoch — confirms the trigger</span>
<span class="cs-line cmt"># is precision-based, not optimizer-specific.</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-results">
      <pre class="cs-pre">
<span class="cs-line cmt"># Mitigation summary</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># ✓ Complete elimination:</span>
<span class="cs-line hl-g"><span class="cmt"># 1. float64 loss</span></span>
<span class="cs-line hl-g">loss = CE(logits.double(), targets)</span>
<span class="cs-line"> </span>
<span class="cs-line hl-g"><span class="cmt"># 2. Zero-sum gradient projection</span></span>
<span class="cs-line hl-g">g = g - g.mean(dim=-1, keepdim=True)</span>
<span class="cs-line"> </span>
<span class="cs-line hl-g"><span class="cmt"># 3. BatchNorm before classifier</span></span>
<span class="cs-line hl-g">nn.BatchNorm1d(d)  <span class="cmt"># centers features</span></span>
<span class="cs-line"> </span>
<span class="cs-line hl-g"><span class="cmt"># 4. Adam ε = 1e-5 (caps effective LR)</span></span>
<span class="cs-line hl-g">Adam(params, eps=1e-5)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># ⚠ Partial / counterproductive:</span>
<span class="cs-line hl-a"><span class="cmt"># Adam ε=1e-6: reduces spike frequency</span></span>
<span class="cs-line hl-a"><span class="cmt"># Label Smoothing: replaces NFI spikes</span></span>
<span class="cs-line hl-a"><span class="cmt">#   with EOS (sharpness) spikes</span></span>
<span class="cs-line hl-a"><span class="cmt"># LayerNorm: accelerates NFI onset!</span></span>
<span class="cs-line hl-a"><span class="cmt">#   (norm constraint makes margins fragile)</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># LLM setting (FineWeb, GPT 110M):</span>
<span class="cs-line cmt"># ~4000 tokens/step have exactly zero loss</span>
<span class="cs-line cmt"># Top collapsed tokens: ".", "org",</span>
<span class="cs-line cmt">#   "example", ",", "last", " you"</span>
<span class="cs-line cmt"># Fix: center output embeddings (remove WG)</span>
<span class="cs-line hl-g"><span class="cmt"># See: arXiv:2601.02031 (output centering)</span></span>
      </pre>
    </div>

  </div>
</aside>

</div><!-- /post-grid -->

<script>
// ===== TOC + SIDEBAR TOGGLES =====
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});
const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ===== CODE SIDEBAR TABS =====
const tabMeta = {
  problem: { file: 'slingshot/problem.py',  title: 'The Problem' },
  sc:      { file: 'slingshot/softmax.py',  title: 'Softmax Collapse' },
  zerosum: { file: 'slingshot/zerosum.py',  title: 'Zero-Sum Constraint' },
  nfi:     { file: 'slingshot/nfi.py',      title: 'NFI Feedback Loop' },
  spike:   { file: 'slingshot/spike.py',    title: 'The Spike Trigger' },
  results: { file: 'slingshot/results.py',  title: 'Mitigation & Results' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ===== INTERSECTION OBSERVER =====
const sectionMap = {
  's-problem': 'problem',
  's-sc':      'sc',
  's-zerosum': 'zerosum',
  's-nfi':     'nfi',
  's-spike':   'spike',
  's-results': 'results',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ===== §01: TRAINING LOSS CURVES =====
(function() {
  const canvas = document.getElementById('loss-canvas');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 240;
  canvas.width = W * DPR; canvas.height = H * DPR;
  const ctx = canvas.getContext('2d');
  ctx.scale(DPR, DPR);

  // Synthetic training curves (log loss, scaled to canvas)
  // float32: drops then periodic spikes at ~250, ~500, ~750
  // float64: drops and stays low
  const N = 1000; // total epochs

  // seeded RNG for reproducibility
  let seed = 42;
  function rand() { seed = (seed * 1664525 + 1013904223) & 0xffffffff; return (seed >>> 0) / 4294967296; }

  function f32Curve(ep) {
    // drops from 2.3 to -9, then periodic spikes
    const base = ep < 60 ? 2.3 - (2.3 + 9) * (ep / 60) : -9;
    // spikes: sharp rise then quick recovery
    const spikeFn = (center, width, height) => {
      const d = ep - center;
      if (Math.abs(d) > width) return 0;
      return height * Math.exp(-d*d / (2*width*width/9));
    };
    const spikes = spikeFn(248, 12, 11.3) + spikeFn(497, 12, 11.3) + spikeFn(746, 12, 11.3);
    // add slight noise
    const noise = (rand() - 0.5) * 0.15;
    return Math.min(2.5, base + spikes + noise);
  }

  function f64Curve(ep) {
    const base = ep < 65 ? 2.3 - (2.3 + 9.5) * (ep / 65) : -9.5;
    const noise = (rand() - 0.5) * 0.08;
    return Math.min(2.5, base + noise);
  }

  let pts32 = [], pts64 = [];
  for (let ep = 0; ep <= N; ep++) {
    pts32.push(f32Curve(ep));
    pts64.push(f64Curve(ep));
  }

  // canvas coordinate helpers
  const PAD = { l: 52, r: 16, t: 20, b: 36 };
  const plotW = W - PAD.l - PAD.r;
  const plotH = H - PAD.t - PAD.b;
  const YMIN = -10, YMAX = 3;

  function toX(ep) { return PAD.l + (ep / N) * plotW; }
  function toY(v)  { return PAD.t + plotH - ((v - YMIN) / (YMAX - YMIN)) * plotH; }

  function drawAxes() {
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = 'rgba(15,15,25,1)';
    ctx.fillRect(0, 0, W, H);

    // grid lines
    ctx.strokeStyle = 'rgba(255,255,255,0.04)';
    ctx.lineWidth = 1;
    for (let v = -9; v <= 3; v += 3) {
      ctx.beginPath(); ctx.moveTo(PAD.l, toY(v)); ctx.lineTo(W - PAD.r, toY(v)); ctx.stroke();
    }
    for (let ep = 0; ep <= N; ep += 200) {
      ctx.beginPath(); ctx.moveTo(toX(ep), PAD.t); ctx.lineTo(toX(ep), H - PAD.b); ctx.stroke();
    }

    // axes
    ctx.strokeStyle = 'rgba(255,255,255,0.2)';
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(PAD.l, PAD.t); ctx.lineTo(PAD.l, H - PAD.b); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(PAD.l, H - PAD.b); ctx.lineTo(W - PAD.r, H - PAD.b); ctx.stroke();

    // y labels
    ctx.fillStyle = 'rgba(255,255,255,0.3)';
    ctx.font = `${11}px monospace`;
    ctx.textAlign = 'right';
    for (let v = -9; v <= 3; v += 3) {
      ctx.fillText(v, PAD.l - 6, toY(v) + 4);
    }

    // x labels
    ctx.textAlign = 'center';
    for (let ep = 0; ep <= N; ep += 200) {
      ctx.fillText(ep, toX(ep), H - PAD.b + 16);
    }

    // axis labels
    ctx.save();
    ctx.translate(12, H/2);
    ctx.rotate(-Math.PI/2);
    ctx.textAlign = 'center';
    ctx.fillText('log loss', 0, 0);
    ctx.restore();
    ctx.textAlign = 'center';
    ctx.fillText('epoch', PAD.l + plotW/2, H - 4);
  }

  function drawLine(pts, color, dashed) {
    ctx.save();
    ctx.strokeStyle = color;
    ctx.lineWidth = 2;
    if (dashed) ctx.setLineDash([6, 4]);
    ctx.beginPath();
    for (let i = 0; i <= N; i++) {
      const x = toX(i), y = toY(pts[i]);
      i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
    }
    ctx.stroke();
    ctx.restore();
  }

  function drawLabels(showF32, showF64) {
    ctx.font = '11px monospace';
    ctx.textAlign = 'left';
    if (showF32) {
      ctx.fillStyle = '#ef4444';
      ctx.fillText('float32 — spikes', PAD.l + 8, PAD.t + 16);
    }
    if (showF64) {
      ctx.fillStyle = '#10b981';
      ctx.fillText('float64 — stable', PAD.l + 8, showF32 ? PAD.t + 32 : PAD.t + 16);
    }
    // mark spike positions
    if (showF32) {
      ctx.fillStyle = 'rgba(239,68,68,0.5)';
      for (const ep of [248, 497, 746]) {
        const x = toX(ep);
        ctx.fillRect(x - 1, PAD.t, 2, plotH);
      }
    }
  }

  let mode = 'f32';

  function render() {
    drawAxes();
    if (mode === 'f32' || mode === 'both') drawLine(pts32, '#ef4444', false);
    if (mode === 'f64' || mode === 'both') drawLine(pts64, '#10b981', false);
    drawLabels(mode === 'f32' || mode === 'both', mode === 'f64' || mode === 'both');
  }

  document.getElementById('curve-btn-f32')?.addEventListener('click', () => {
    mode = 'f32';
    document.querySelectorAll('[id^="curve-btn"]').forEach(b => b.classList.remove('active'));
    document.getElementById('curve-btn-f32').classList.add('active');
    render();
  });
  document.getElementById('curve-btn-f64')?.addEventListener('click', () => {
    mode = 'f64';
    document.querySelectorAll('[id^="curve-btn"]').forEach(b => b.classList.remove('active'));
    document.getElementById('curve-btn-f64').classList.add('active');
    render();
  });
  document.getElementById('curve-btn-both')?.addEventListener('click', () => {
    mode = 'both';
    document.querySelectorAll('[id^="curve-btn"]').forEach(b => b.classList.remove('active'));
    document.getElementById('curve-btn-both').classList.add('active');
    render();
  });

  render();
})();

// ===== §02: SOFTMAX COLLAPSE CANVAS =====
(function() {
  const canvas = document.getElementById('sc-canvas');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 260;
  canvas.width = W * DPR; canvas.height = H * DPR;
  const ctx = canvas.getContext('2d');
  ctx.scale(DPR, DPR);

  const CLASSES = ['cat', 'dog', 'bird', 'fish'];
  const COLORS = ['#8b5cf6', '#6b7280', '#6b7280', '#6b7280'];
  const THRESHOLD = 23 * Math.LN2; // ≈ 15.94

  // Three states: gaps from correct class to others
  const STATES = {
    low:   { correct: 8,  others: [3, 3, 3],   label: 'Low confidence — gap = 5' },
    high:  { correct: 19, others: [2, 1, 0.5], label: 'High confidence — gap = 17 > threshold 15.94' },
    ultra: { correct: 26, others: [1, 0.5, 0.1], label: 'Ultra-high — gap = 25 >> threshold' },
  };

  let curState = 'low';

  function softmax(logits) {
    const m = Math.max(...logits);
    const exps = logits.map(z => Math.exp(z - m));
    const s = exps.reduce((a, b) => a + b, 0);
    return exps.map(e => e / s);
  }

  function computeGrads(logits, correctIdx) {
    const probs = softmax(logits);
    const grads = probs.map((p, i) => p - (i === correctIdx ? 1 : 0));

    // Apply float32 absorption: if gap > threshold, correct grad → 0
    const gap = logits[correctIdx] - Math.max(...logits.filter((_, i) => i !== correctIdx));
    if (gap > THRESHOLD) {
      grads[correctIdx] = 0;
    }

    return { grads, probs, gap, collapsed: gap > THRESHOLD };
  }

  function render() {
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = 'rgba(15,15,25,1)';
    ctx.fillRect(0, 0, W, H);

    const st = STATES[curState];
    const logits = [st.correct, ...st.others];
    const { grads, probs, gap, collapsed } = computeGrads(logits, 0);

    const barH = 24, barGap = 10, startY = 30;
    const labelW = 50, barStartX = labelW + 10;
    const maxLogit = Math.max(...logits);
    const gradMax = 0.9; // for gradient bar scaling

    // Title
    ctx.fillStyle = collapsed ? '#ef4444' : '#10b981';
    ctx.font = `bold 11px monospace`;
    ctx.textAlign = 'left';
    ctx.fillText(st.label, 10, 18);

    // Two columns: logits (left) and gradients (right)
    const col2X = W / 2 + 20;

    function drawBars(x, maxWidth, values, maxVal, label, getColor, getLabel) {
      ctx.font = '10px monospace';
      ctx.fillStyle = 'rgba(255,255,255,0.4)';
      ctx.textAlign = 'center';
      ctx.fillText(label, x + maxWidth / 2, startY - 6);

      for (let i = 0; i < CLASSES.length; i++) {
        const y = startY + i * (barH + barGap);
        const v = values[i];
        const bw = Math.abs(v / maxVal) * maxWidth;

        // class label
        ctx.fillStyle = 'rgba(255,255,255,0.6)';
        ctx.font = '10px monospace';
        ctx.textAlign = 'right';
        ctx.fillText(CLASSES[i], x - 6, y + barH/2 + 4);

        // bar background
        ctx.fillStyle = 'rgba(255,255,255,0.04)';
        ctx.fillRect(x, y, maxWidth, barH);

        // bar fill
        const color = getColor(i, v);
        ctx.fillStyle = color;
        const actualBw = Math.min(bw, maxWidth);
        ctx.fillRect(x, y, actualBw, barH);

        // value label
        ctx.fillStyle = 'rgba(255,255,255,0.7)';
        ctx.textAlign = 'left';
        ctx.font = '10px monospace';
        ctx.fillText(getLabel(v, i), x + actualBw + 4, y + barH/2 + 4);
      }
    }

    // Logit bars
    const logitColors = (i) => i === 0 ? '#8b5cf6' : 'rgba(107,114,128,0.6)';
    drawBars(barStartX, W/2 - barStartX - 20, logits, maxLogit, 'Logits (z_k)',
      (i) => logitColors(i), (v) => v.toFixed(1));

    // Gradient bars
    const gradColors = (i, v) => {
      if (i === 0 && collapsed) return 'rgba(239,68,68,0.5)';
      return v < 0 ? 'rgba(16,185,129,0.7)' : 'rgba(239,68,68,0.6)';
    };
    const gradLabels = (v, i) => {
      if (i === 0 && collapsed) return '= 0.0 (ABSORBED!)';
      return v.toExponential(1);
    };
    drawBars(col2X + 52, W - col2X - 52 - 10, grads, gradMax, 'Gradients (∂L/∂z_k)',
      gradColors, gradLabels);

    // Gap indicator
    const gapY = H - 28;
    ctx.fillStyle = collapsed ? 'rgba(239,68,68,0.8)' : 'rgba(16,185,129,0.8)';
    ctx.font = '10px monospace';
    ctx.textAlign = 'left';
    ctx.fillText(`gap = z_cat - z_max_other = ${gap.toFixed(1)}`, 10, gapY);
    ctx.fillText(`threshold = 23 × ln 2 ≈ 15.94`, 10, gapY + 14);
    if (collapsed) {
      ctx.fillStyle = '#ef4444';
      ctx.fillText('► SOFTMAX COLLAPSE — correct-class gradient = 0', W/2 + 10, gapY);
    } else {
      ctx.fillStyle = '#10b981';
      ctx.fillText('► Normal — all gradients nonzero', W/2 + 10, gapY);
    }
  }

  document.getElementById('sc-btn-low')?.addEventListener('click', () => {
    curState = 'low';
    document.querySelectorAll('[id^="sc-btn"]').forEach(b => b.classList.remove('active'));
    document.getElementById('sc-btn-low').classList.add('active');
    render();
  });
  document.getElementById('sc-btn-high')?.addEventListener('click', () => {
    curState = 'high';
    document.querySelectorAll('[id^="sc-btn"]').forEach(b => b.classList.remove('active'));
    document.getElementById('sc-btn-high').classList.add('active');
    render();
  });
  document.getElementById('sc-btn-ultra')?.addEventListener('click', () => {
    curState = 'ultra';
    document.querySelectorAll('[id^="sc-btn"]').forEach(b => b.classList.remove('active'));
    document.getElementById('sc-btn-ultra').classList.add('active');
    render();
  });

  render();
})();

// ===== §03: ZERO-SUM CANVAS =====
(function() {
  const canvas = document.getElementById('zs-canvas');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 240;
  canvas.width = W * DPR; canvas.height = H * DPR;
  const ctx = canvas.getContext('2d');
  ctx.scale(DPR, DPR);

  let mode = 'normal';

  // Arrow drawing helper
  function drawArrow(fromX, fromY, toX, toY, color, width, label) {
    const dx = toX - fromX, dy = toY - fromY;
    const len = Math.sqrt(dx*dx + dy*dy);
    if (len < 1) return;
    const nx = dx/len, ny = dy/len;
    const headLen = 10, headAngle = 0.35;

    ctx.save();
    ctx.strokeStyle = color;
    ctx.fillStyle = color;
    ctx.lineWidth = width;
    ctx.beginPath();
    ctx.moveTo(fromX, fromY);
    ctx.lineTo(toX, toY);
    ctx.stroke();

    // arrowhead
    ctx.beginPath();
    ctx.moveTo(toX, toY);
    ctx.lineTo(toX - headLen*(nx*Math.cos(headAngle)+ny*Math.sin(headAngle)),
               toY - headLen*(ny*Math.cos(headAngle)-nx*Math.sin(headAngle)));
    ctx.lineTo(toX - headLen*(nx*Math.cos(-headAngle)+ny*Math.sin(-headAngle)),
               toY - headLen*(ny*Math.cos(-headAngle)-nx*Math.sin(-headAngle)));
    ctx.closePath();
    ctx.fill();

    if (label) {
      ctx.fillStyle = color;
      ctx.font = '11px monospace';
      ctx.textAlign = 'center';
      ctx.fillText(label, toX + 18, toY);
    }
    ctx.restore();
  }

  function render() {
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = 'rgba(15,15,25,1)';
    ctx.fillRect(0, 0, W, H);

    const cx = W/2, cy = H/2 + 10;
    const R = 65; // radius for class positions

    // Class positions (K=3, equilateral triangle-ish)
    const angles = [-Math.PI/2, -Math.PI/2 + 2*Math.PI/3, -Math.PI/2 + 4*Math.PI/3];
    const classes = ['cat ✓', 'dog', 'bird'];
    const classColors = ['#8b5cf6', '#6b7280', '#6b7280'];
    const classPos = angles.map(a => ({ x: cx + R * Math.cos(a), y: cy + R * Math.sin(a) }));

    // Feature center µG
    const muGx = cx, muGy = cy - 15;

    // Draw µG marker
    ctx.fillStyle = '#06b6d4';
    ctx.beginPath();
    ctx.arc(muGx, muGy, 5, 0, Math.PI*2);
    ctx.fill();
    ctx.fillStyle = '#06b6d4';
    ctx.font = 'bold 10px monospace';
    ctx.textAlign = 'left';
    ctx.fillText('μ_G', muGx + 8, muGy + 4);

    // Gradient vectors from each class toward µG (scaled)
    // In normal mode: cat gradient is -0.75, dog/bird are 0.375 each
    // In SC mode: cat gradient = 0, dog/bird get redistributed
    const gradNormal = [-0.75, 0.375, 0.375]; // zero-sum: sum = 0
    const gradSC     = [0, 0.5, 0.5];          // SC: zero-sum broken

    const grads = mode === 'normal' ? gradNormal : gradSC;
    const scale = 50;

    // WG center of mass arrow
    let wgDx = 0, wgDy = 0;
    for (let i = 0; i < 3; i++) {
      const gx = classPos[i].x + grads[i] * scale * (muGx - classPos[i].x) / R;
      const gy = classPos[i].y + grads[i] * scale * (muGy - classPos[i].y) / R;
      wgDx += gx - classPos[i].x;
      wgDy += gy - classPos[i].y;
    }

    // Draw class weight vectors and their gradient arrows
    for (let i = 0; i < 3; i++) {
      const p = classPos[i];
      // class label circle
      ctx.fillStyle = classColors[i];
      ctx.beginPath();
      ctx.arc(p.x, p.y, 14, 0, Math.PI*2);
      ctx.fill();
      ctx.fillStyle = '#fff';
      ctx.font = '9px monospace';
      ctx.textAlign = 'center';
      ctx.fillText(classes[i].split(' ')[0], p.x, p.y + 3);

      // gradient arrow: direction toward feature center, scaled by grad
      if (Math.abs(grads[i]) > 0.01) {
        const dirX = (muGx - p.x) / R, dirY = (muGy - p.y) / R;
        const gEndX = p.x + grads[i] * scale * dirX;
        const gEndY = p.y + grads[i] * scale * dirY;
        const col = grads[i] < 0 ? '#10b981' : '#ef4444';
        drawArrow(p.x, p.y, gEndX, gEndY, col, 2, null);
      } else if (mode === 'sc' && i === 0) {
        // Show ∅ for zero gradient on correct class
        ctx.fillStyle = '#ef4444';
        ctx.font = 'bold 14px monospace';
        ctx.textAlign = 'center';
        ctx.fillText('∅', p.x + 20, p.y - 10);
        ctx.font = '9px monospace';
        ctx.fillText('grad=0', p.x + 20, p.y + 2);
      }
    }

    // Net WG drift arrow
    const driftMag = Math.sqrt(wgDx*wgDx + wgDy*wgDy);
    if (driftMag > 1) {
      const scale2 = 0.5;
      drawArrow(cx, H - 30, cx + wgDx*scale2, H - 30 + wgDy*scale2,
        driftMag < 1.5 ? 'rgba(255,255,255,0.3)' : '#f59e0b', 3, null);
      ctx.fillStyle = driftMag < 1.5 ? 'rgba(255,255,255,0.4)' : '#f59e0b';
      ctx.font = 'bold 10px monospace';
      ctx.textAlign = 'center';
      ctx.fillText(mode === 'normal' ? 'W_G drift = 0  (zero-sum holds)' : '▲ W_G drifts toward −μ_G  (zero-sum BROKEN)', cx, H - 12);
    }

    // Mode label
    ctx.fillStyle = mode === 'normal' ? '#10b981' : '#ef4444';
    ctx.font = 'bold 11px monospace';
    ctx.textAlign = 'center';
    ctx.fillText(mode === 'normal' ? 'Exact arithmetic — zero-sum constraint holds' : 'Softmax Collapse — cat gradient = 0, sum ≠ 0', cx, 18);
  }

  document.getElementById('zs-btn-normal')?.addEventListener('click', () => {
    mode = 'normal';
    document.querySelectorAll('[id^="zs-btn"]').forEach(b => b.classList.remove('active'));
    document.getElementById('zs-btn-normal').classList.add('active');
    render();
  });
  document.getElementById('zs-btn-sc')?.addEventListener('click', () => {
    mode = 'sc';
    document.querySelectorAll('[id^="zs-btn"]').forEach(b => b.classList.remove('active'));
    document.getElementById('zs-btn-sc').classList.add('active');
    render();
  });

  render();
})();

// ===== §04: NFI FEEDBACK LOOP CANVAS =====
(function() {
  const canvas = document.getElementById('nfi-canvas');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 280;
  canvas.width = W * DPR; canvas.height = H * DPR;
  const ctx = canvas.getContext('2d');
  ctx.scale(DPR, DPR);

  // NFI state at different epochs
  // Norms grow as (1 + η·ε/√K)^t ≈ (1 + 9.5e-4)^t
  const EPOCH_STATES = {
    0:    { wgNorm: 0.01, muNorm: 0.01, cos: 0.0,  label: 'Training begins — W_G ≈ 0, μ_G ≈ 0' },
    300:  { wgNorm: 0.3,  muNorm: 0.25, cos: -0.3, label: 'NFI starting — W_G and μ_G beginning to drift' },
    700:  { wgNorm: 2.1,  muNorm: 1.8,  cos: -0.75, label: 'NFI accelerating — anti-parallel alignment grows' },
    1200: { wgNorm: 11.0, muNorm: 9.5,  cos: -0.97, label: '⚡ Spike imminent — margins collapsing for outliers' },
  };

  let curEpoch = 0;

  function render() {
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = 'rgba(15,15,25,1)';
    ctx.fillRect(0, 0, W, H);

    const st = EPOCH_STATES[curEpoch];
    const cx = W * 0.38, cy = H * 0.52;

    // --- Draw 2D vector space ---
    ctx.strokeStyle = 'rgba(255,255,255,0.05)';
    ctx.lineWidth = 1;
    // grid
    for (let d = 20; d <= Math.max(W, H); d += 20) {
      ctx.beginPath(); ctx.arc(cx, cy, d, 0, Math.PI*2); ctx.stroke();
    }
    // axes
    ctx.strokeStyle = 'rgba(255,255,255,0.12)';
    ctx.beginPath(); ctx.moveTo(PAD_L, cy); ctx.lineTo(W*0.7, cy); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(cx, PAD_T); ctx.lineTo(cx, H - PAD_B); ctx.stroke();

    const PAD_L = 10, PAD_T = 30, PAD_B = 50;
    const scale = 12; // pixels per unit norm

    // WG direction: fixed at 210° (pointing lower-left = toward -µG)
    const wgAngle = 210 * Math.PI / 180;
    // µG direction: anti-parallel to WG → at 30° (opposing)
    const muAngle = wgAngle - Math.PI - st.cos * 0.3; // approaches anti-parallel with cos

    const wgEndX = cx + st.wgNorm * scale * Math.cos(wgAngle);
    const wgEndY = cy + st.wgNorm * scale * Math.sin(wgAngle);
    const muEndX = cx + st.muNorm * scale * Math.cos(muAngle);
    const muEndY = cy + st.muNorm * scale * Math.sin(muAngle);

    // Draw arrows
    function arrow(fx, fy, tx, ty, color, lw, label) {
      const dx = tx-fx, dy = ty-fy;
      const len = Math.sqrt(dx*dx+dy*dy);
      if (len < 2) return;
      const nx = dx/len, ny = dy/len;
      ctx.save();
      ctx.strokeStyle = color; ctx.fillStyle = color; ctx.lineWidth = lw;
      ctx.beginPath(); ctx.moveTo(fx, fy); ctx.lineTo(tx, ty); ctx.stroke();
      const hl = 10, ha = 0.4;
      ctx.beginPath();
      ctx.moveTo(tx, ty);
      ctx.lineTo(tx - hl*(nx*Math.cos(ha)+ny*Math.sin(ha)), ty - hl*(ny*Math.cos(ha)-nx*Math.sin(ha)));
      ctx.lineTo(tx - hl*(nx*Math.cos(-ha)+ny*Math.sin(-ha)), ty - hl*(ny*Math.cos(-ha)-nx*Math.sin(-ha)));
      ctx.closePath(); ctx.fill();
      if (label) {
        ctx.font = 'bold 11px monospace';
        ctx.textAlign = 'center';
        ctx.fillText(label, tx + 20, ty);
      }
      ctx.restore();
    }

    // Origin dot
    ctx.fillStyle = 'rgba(255,255,255,0.5)';
    ctx.beginPath(); ctx.arc(cx, cy, 4, 0, Math.PI*2); ctx.fill();

    arrow(cx, cy, wgEndX, wgEndY, '#8b5cf6', 2.5, null);
    arrow(cx, cy, muEndX, muEndY, '#06b6d4', 2.5, null);

    // Labels at tips
    ctx.font = 'bold 11px monospace';
    ctx.fillStyle = '#8b5cf6';
    ctx.textAlign = 'center';
    ctx.fillText(`W_G  ‖=${st.wgNorm.toFixed(1)}`, wgEndX - 8, wgEndY + 14);
    ctx.fillStyle = '#06b6d4';
    ctx.fillText(`μ_G  ‖=${st.muNorm.toFixed(1)}`, muEndX + 10, muEndY - 8);

    // Cosine similarity indicator
    const cosX = W * 0.72, cosY = H * 0.35;
    ctx.fillStyle = 'rgba(255,255,255,0.07)';
    ctx.fillRect(cosX, cosY - 20, W - cosX - 10, 120);
    ctx.fillStyle = 'rgba(255,255,255,0.5)';
    ctx.font = '10px monospace';
    ctx.textAlign = 'left';
    ctx.fillText('cos(W_G, μ_G)', cosX + 8, cosY - 6);

    // cosine bar
    const barW = W - cosX - 26;
    const cosVal = st.cos; // -1 to 0
    ctx.fillStyle = 'rgba(255,255,255,0.06)';
    ctx.fillRect(cosX + 8, cosY + 2, barW, 18);
    ctx.fillStyle = cosVal < -0.7 ? '#ef4444' : '#8b5cf6';
    ctx.fillRect(cosX + 8 + barW * (1 + cosVal), cosY + 2, barW * (-cosVal), 18);
    ctx.fillStyle = 'rgba(255,255,255,0.7)';
    ctx.font = 'bold 10px monospace';
    ctx.fillText(cosVal.toFixed(2), cosX + barW/2, cosY + 14);
    ctx.fillStyle = 'rgba(255,255,255,0.3)';
    ctx.font = '9px monospace';
    ctx.fillText('-1', cosX + 10, cosY + 30);
    ctx.fillText('(anti-parallel)', cosX + 20, cosY + 42);
    ctx.fillText('0', cosX + barW + 2, cosY + 30);

    // Norm growth chart
    ctx.fillStyle = 'rgba(255,255,255,0.5)';
    ctx.font = '10px monospace';
    ctx.fillText('‖W_G‖ norm growth:', cosX + 8, cosY + 62);

    // mini bar for norm
    const normMax = 12;
    ctx.fillStyle = 'rgba(255,255,255,0.06)';
    ctx.fillRect(cosX + 8, cosY + 68, barW, 14);
    ctx.fillStyle = curEpoch >= 1200 ? '#ef4444' : '#8b5cf6';
    ctx.fillRect(cosX + 8, cosY + 68, barW * Math.min(st.wgNorm / normMax, 1), 14);
    ctx.fillStyle = 'rgba(255,255,255,0.7)';
    ctx.font = 'bold 10px monospace';
    ctx.fillText(st.wgNorm.toFixed(1), cosX + barW/2, cosY + 79);

    // Status label
    const labelColor = curEpoch >= 1200 ? '#ef4444' : curEpoch >= 700 ? '#f59e0b' : '#10b981';
    ctx.fillStyle = labelColor;
    ctx.font = '10px monospace';
    ctx.textAlign = 'left';
    ctx.fillText(`epoch ${curEpoch}: ${st.label}`, 10, H - 10);
  }

  document.getElementById('nfi-btn-0')?.addEventListener('click', () => {
    curEpoch = 0;
    document.querySelectorAll('[id^="nfi-btn"]').forEach(b => b.classList.remove('active'));
    document.getElementById('nfi-btn-0').classList.add('active');
    render();
  });
  document.getElementById('nfi-btn-300')?.addEventListener('click', () => {
    curEpoch = 300;
    document.querySelectorAll('[id^="nfi-btn"]').forEach(b => b.classList.remove('active'));
    document.getElementById('nfi-btn-300').classList.add('active');
    render();
  });
  document.getElementById('nfi-btn-700')?.addEventListener('click', () => {
    curEpoch = 700;
    document.querySelectorAll('[id^="nfi-btn"]').forEach(b => b.classList.remove('active'));
    document.getElementById('nfi-btn-700').classList.add('active');
    render();
  });
  document.getElementById('nfi-btn-1200')?.addEventListener('click', () => {
    curEpoch = 1200;
    document.querySelectorAll('[id^="nfi-btn"]').forEach(b => b.classList.remove('active'));
    document.getElementById('nfi-btn-1200').classList.add('active');
    render();
  });

  render();
})();

// ===== §05: STEP NAVIGATOR =====
(function() {
  let step = 0;
  const boxes   = document.querySelectorAll('#spike-steps .step-box');
  const prevBtn = document.getElementById('step-prev');
  const nextBtn = document.getElementById('step-next');
  const progEl  = document.getElementById('step-prog');
  function updateSteps() {
    boxes.forEach((b, i) => {
      b.classList.remove('active', 'done');
      if (i === step) b.classList.add('active');
      else if (i < step) b.classList.add('done');
    });
    if (prevBtn) prevBtn.disabled = step === 0;
    if (nextBtn) nextBtn.disabled = step === boxes.length - 1;
    if (progEl) progEl.textContent = `Step ${step+1} of ${boxes.length}`;
    boxes.forEach((b, i) => {
      const n = b.querySelector('.step-num');
      if (n) n.textContent = i < step ? '✓' : String(i+1);
    });
  }
  prevBtn?.addEventListener('click', () => { if (step > 0) { step--; updateSteps(); } });
  nextBtn?.addEventListener('click', () => { if (step < boxes.length - 1) { step++; updateSteps(); } });
  updateSteps();
})();

// ===== §06: ANIMATED BAR CHART =====
(function() {
  const barsSection = document.getElementById('s-results');
  if (!barsSection) return;
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('#mitigation-bars .bar-fill[data-w]').forEach(b => {
          b.style.width = (parseFloat(b.dataset.w)) + '%';
        });
      }
    });
  }, { threshold: 0.3 }).observe(barsSection);
})();
</script>

    const pad = 24, colW = (W - pad*2) / 2 - 12;
    const tokenW = 28, tokenH = 20, gap = 4;
    const tokens = ['The', 'cat', 'sat', 'on', 'a', 'mat'];

    // Training column
    ctx.fillStyle = COLORS.muted; ctx.font = '10px monospace';
    ctx.fillText('Training (on expert tokens)', pad, pad - 8);
    tokens.forEach((tok, i) => {
      const x = pad + (i % 3) * (tokenW + gap);
      const y = pad + Math.floor(i / 3) * (tokenH + gap);
      ctx.fillStyle = 'rgba(16,185,129,.3)'; ctx.strokeStyle = COLORS.green;
      ctx.beginPath(); ctx.roundRect(x, y, tokenW + 14, tokenH, 3); ctx.fill(); ctx.stroke();
      ctx.fillStyle = COLORS.green; ctx.font = '8px monospace';
      ctx.fillText(tok, x + 3, y + 13);
    });
    ctx.fillStyle = COLORS.green; ctx.font = '9px monospace';
    ctx.fillText('y_<t from human ✓', pad, pad + 55);

    // Gap / arrow
    const midX = W / 2;
    ctx.strokeStyle = COLORS.amber; ctx.lineWidth = 1.5;
    ctx.setLineDash([4, 3]);
    ctx.beginPath(); ctx.moveTo(midX - 12, H / 2 - 10); ctx.lineTo(midX + 12, H / 2 - 10); ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle = COLORS.amber; ctx.font = 'bold 9px monospace';
    ctx.textAlign = 'center';
    ctx.fillText('mismatch', midX, H / 2 + 4);
    ctx.textAlign = 'left';

    // Inference column
    const rx = midX + 24;
    ctx.fillStyle = COLORS.muted; ctx.font = '10px monospace';
    ctx.fillText('Inference (model generates)', rx, pad - 8);
    const infTokens = ['The', 'cat', 'ate', '???', '???', '???'];
    const colors2 = [COLORS.green, COLORS.green, COLORS.red, COLORS.red, COLORS.red, COLORS.red];
    infTokens.forEach((tok, i) => {
      const x = rx + (i % 3) * (tokenW + gap);
      const y = pad + Math.floor(i / 3) * (tokenH + gap);
      const c = colors2[i];
      ctx.fillStyle = c + '30'; ctx.strokeStyle = c;
      ctx.beginPath(); ctx.roundRect(x, y, tokenW + 14, tokenH, 3); ctx.fill(); ctx.stroke();
      ctx.fillStyle = c; ctx.font = '8px monospace';
      ctx.fillText(tok, x + 3, y + 13);
    });
    ctx.fillStyle = COLORS.red; ctx.font = '9px monospace';
    ctx.fillText('ŷ_<t from model ✗', rx, pad + 55);

    // Error arrow
    ctx.strokeStyle = COLORS.red; ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(rx + 32, pad + 10); ctx.lineTo(rx + 32, H - 30);
    ctx.stroke();
    ctx.fillStyle = COLORS.red; ctx.font = '9px monospace';
    ctx.fillText('errors compound →', rx, H - 18);
  }

  function drawGRPO(W, H) {
    ctx.clearRect(0, 0, W, H);
    const seqLen = 16;
    const tokenW = Math.floor((W - 60) / seqLen) - 2;
    const startX = 30, tokenH = 28, tokenY = 60;

    ctx.fillStyle = COLORS.muted; ctx.font = '10px monospace';
    ctx.fillText('Token sequence (reasoning chain)', startX, tokenY - 16);

    for (let i = 0; i < seqLen; i++) {
      const x = startX + i * (tokenW + 2);
      const isAnswer = i === seqLen - 1;
      const col = isAnswer ? COLORS.amber : 'rgba(107,114,128,.35)';
      ctx.fillStyle = isAnswer ? 'rgba(245,158,11,.2)' : COLORS.surface;
      ctx.strokeStyle = col;
      ctx.beginPath(); ctx.roundRect(x, tokenY, tokenW, tokenH, 3); ctx.fill(); ctx.stroke();
      if (isAnswer) {
        ctx.fillStyle = COLORS.amber; ctx.font = 'bold 8px monospace';
        ctx.textAlign = 'center';
        ctx.fillText('R', x + tokenW/2, tokenY + tokenH/2 + 3);
        ctx.textAlign = 'left';
      }
    }

    // Reward label on last token
    const lastX = startX + (seqLen-1) * (tokenW + 2);
    ctx.strokeStyle = COLORS.amber; ctx.lineWidth = 1.5;
    ctx.setLineDash([3, 2]);
    for (let i = 0; i < seqLen - 1; i++) {
      const x = startX + i * (tokenW + 2) + tokenW/2;
      ctx.beginPath();
      ctx.moveTo(x, tokenY + tokenH + 4);
      ctx.lineTo(lastX + tokenW/2, H - 36);
      ctx.stroke();
    }
    ctx.setLineDash([]);

    // Same reward value for all
    ctx.fillStyle = COLORS.muted; ctx.font = '9px monospace';
    ctx.fillText('All 16 tokens receive the same scalar reward R = 1', startX, H - 18);
    ctx.fillStyle = COLORS.red;
    ctx.fillText('→ early "Let me think" tokens credited same as final answer', startX, H - 5);
  }

  function drawOPD(W, H) {
    ctx.clearRect(0, 0, W, H);
    const bW = 160, bH = 70, gap = 60;
    const leftX = 40, rightX = leftX + bW + gap, midY = H / 2 - 20;

    // Student box
    ctx.fillStyle = 'rgba(6,182,212,.08)'; ctx.strokeStyle = COLORS.cyan;
    ctx.beginPath(); ctx.roundRect(leftX, midY - bH/2, bW, bH, 8); ctx.fill(); ctx.stroke();
    ctx.fillStyle = COLORS.cyan; ctx.font = 'bold 11px monospace';
    ctx.textAlign = 'center';
    ctx.fillText('Student', leftX + bW/2, midY - 10);
    ctx.fillStyle = COLORS.muted; ctx.font = '9px monospace';
    ctx.fillText('(smaller model)', leftX + bW/2, midY + 6);
    ctx.fillText('GPU: 1×', leftX + bW/2, midY + 20);
    ctx.textAlign = 'left';

    // Teacher box
    ctx.fillStyle = 'rgba(245,158,11,.08)'; ctx.strokeStyle = COLORS.amber;
    ctx.beginPath(); ctx.roundRect(rightX, midY - bH/2 - 15, bW + 20, bH + 20, 8); ctx.fill(); ctx.stroke();
    ctx.fillStyle = COLORS.amber; ctx.font = 'bold 11px monospace';
    ctx.textAlign = 'center';
    ctx.fillText('Teacher', rightX + (bW+20)/2, midY - 10);
    ctx.fillStyle = COLORS.muted; ctx.font = '9px monospace';
    ctx.fillText('(larger, external)', rightX + (bW+20)/2, midY + 6);
    ctx.fillStyle = COLORS.red;
    ctx.fillText('GPU: 2×', rightX + (bW+20)/2, midY + 20);
    ctx.textAlign = 'left';

    // Arrow from teacher to student
    const ax = rightX, ay = midY;
    ctx.strokeStyle = COLORS.amber; ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(ax, ay);
    ctx.lineTo(leftX + bW + 4, ay);
    ctx.stroke();
    ctx.fillStyle = COLORS.amber; ctx.font = '8px monospace';
    ctx.fillText('KL supervision', leftX + bW + 8, ay - 6);

    // Warning
    ctx.fillStyle = COLORS.red; ctx.font = '9px monospace';
    ctx.fillText('✗ requires separate teacher deployment', 40, H - 16);
    ctx.fillText('✗ capacity gap if teacher too powerful', 40, H - 4);
  }

  function drawOPSD(W, H) {
    ctx.clearRect(0, 0, W, H);
    const cx = W / 2, cy = H / 2 - 10;
    const bW = 180, bH = 56;

    // Center model
    ctx.fillStyle = 'rgba(139,92,246,.15)'; ctx.strokeStyle = COLORS.purple;
    ctx.beginPath(); ctx.roundRect(cx - bW/2, cy - bH/2, bW, bH, 8); ctx.fill(); ctx.stroke();
    ctx.fillStyle = COLORS.purple; ctx.font = 'bold 11px monospace';
    ctx.textAlign = 'center';
    ctx.fillText('Single Model (θ shared)', cx, cy - 8);
    ctx.fillStyle = COLORS.muted; ctx.font = '9px monospace';
    ctx.fillText('one GPU, one checkpoint', cx, cy + 8);
    ctx.textAlign = 'left';

    // Left bubble (student)
    const lx = 20, ly = H / 2 + 20;
    ctx.fillStyle = 'rgba(6,182,212,.1)'; ctx.strokeStyle = COLORS.cyan;
    ctx.beginPath(); ctx.roundRect(lx, ly, 130, 44, 6); ctx.fill(); ctx.stroke();
    ctx.fillStyle = COLORS.cyan; ctx.font = 'bold 9px monospace';
    ctx.fillText('Student context', lx + 8, ly + 16);
    ctx.fillStyle = COLORS.muted; ctx.font = '8px monospace';
    ctx.fillText('input: x only', lx + 8, ly + 30);

    // Right bubble (teacher)
    const rx = W - 160, ry = H / 2 + 20;
    ctx.fillStyle = 'rgba(16,185,129,.1)'; ctx.strokeStyle = COLORS.green;
    ctx.beginPath(); ctx.roundRect(rx, ry, 140, 44, 6); ctx.fill(); ctx.stroke();
    ctx.fillStyle = COLORS.green; ctx.font = 'bold 9px monospace';
    ctx.fillText('Teacher context', rx + 8, ry + 16);
    ctx.fillStyle = COLORS.muted; ctx.font = '8px monospace';
    ctx.fillText('input: x + y*', rx + 8, ry + 30);

    // Connect lines
    ctx.strokeStyle = COLORS.purple; ctx.lineWidth = 1.2; ctx.setLineDash([3,2]);
    ctx.beginPath(); ctx.moveTo(cx - bW/2, cy + bH/2); ctx.lineTo(lx + 65, ly); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(cx + bW/2, cy + bH/2); ctx.lineTo(rx + 70, ry); ctx.stroke();
    ctx.setLineDash([]);

    // Benefits
    ctx.fillStyle = COLORS.green; ctx.font = '9px monospace';
    ctx.textAlign = 'center';
    ctx.fillText('✓ on-policy  ✓ dense  ✓ no external teacher', cx, H - 4);
    ctx.textAlign = 'left';
  }

  const drawFns = { sft: drawSFT, grpo: drawGRPO, opd: drawOPD, opsd: drawOPSD };

  function drawCurrent() {
    const { W, H } = dims;
    (drawFns[currentTab] || drawSFT)(W, H);
    const cap = document.getElementById('failure-caption');
    if (cap) cap.textContent = CAPTIONS[currentTab] || '';
  }

  document.querySelectorAll('.method-tab').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.method-tab').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentTab = btn.dataset.tab;
      dims = resize();
      drawCurrent();
    });
  });

  window.addEventListener('resize', () => { dims = resize(); drawCurrent(); });
  dims = resize(); drawCurrent();
})();

// ═══════════════════════════ §03: Step Navigator ═══════════════════════════
(function() {
  let step = 0;
  const boxes   = document.querySelectorAll('#step-list-loop .step-box');
  const prevBtn = document.getElementById('step-prev-loop');
  const nextBtn = document.getElementById('step-next-loop');
  const progEl  = document.getElementById('step-prog-loop');

  function updateSteps() {
    boxes.forEach((b, i) => {
      b.classList.remove('active', 'done');
      if (i === step) b.classList.add('active');
      else if (i < step) b.classList.add('done');
    });
    if (prevBtn) prevBtn.disabled = step === 0;
    if (nextBtn) nextBtn.disabled = step === boxes.length - 1;
    if (progEl) progEl.textContent = `Step ${step+1} of ${boxes.length}`;
    boxes.forEach((b, i) => {
      const n = b.querySelector('.step-num');
      if (n) n.textContent = i < step ? '✓' : String(i+1);
    });
  }
  prevBtn?.addEventListener('click', () => { if (step > 0) { step--; updateSteps(); } });
  nextBtn?.addEventListener('click', () => { if (step < boxes.length - 1) { step++; updateSteps(); } });
  updateSteps();
})();

// ═══════════════════════════ §04: Design Space Cards ═══════════════════════════
(function() {
  const DETAILS = {
    hybrid:      'RL provides a direction signal (which rollouts are relatively better), but its reward is too sparse for fine-grained token improvement. Self-distillation provides dense token corrections but no direction. Hybrid methods like HDPO and SRPO combine both: generate rollouts with RL, use the privileged teacher to correct the failed rollouts with dense supervision. GEAR identifies "semantic deviation points" in trajectories where the student diverges from good reasoning, using these as boundaries for advantage function segmentation.',
    feedback:    'The teacher\'s "privileged information" doesn\'t have to be the ground-truth answer — it can be any structured feedback. SDPO uses compiler outputs and unit test results as the reflection context: when code fails, the error message becomes the teacher\'s input, and the teacher is asked to reason about the fix. GATES samples multiple teacher traces and derives supervision from their consensus — if N of M traces agree on a token, that token gets higher supervision weight. PAINT masks the verified solution proportionally to how much the student rollout already overlaps with it.',
    stability:   'The biggest risk of self-distillation is signal degeneration: the teacher and student can collapse to the same distribution if supervision is too strong, or the teacher can overfit high-entropy tokens. EGRSD addresses this with a three-signal gate: reward direction × KL magnitude × entropy confidence. DASD reverses the supervision direction for high-entropy tokens (pushing student away from teacher to preserve exploration). AntiSD goes further — for mathematical reasoning it shows that maximizing divergence can sometimes outperform standard distillation. PACED focuses compute on the zone of proximal development: problems the student passes 20–80% of the time.',
    compression: 'OPSD can be used not just to improve accuracy but to compress the reasoning process. CRISP teachers the student from a teacher prompted to "be concise" — the teacher generates shorter chains of thought, and the student learns to match them. Multi-Token SD distills a next-token predictor into a multi-token predictor: the teacher generates multiple future tokens in parallel, and the student learns to predict them jointly. D-OPSD for diffusion LLMs uses suffix conditioning to preserve few-step inference capability while fine-tuning.',
    transfer:    'OPSD can transfer capabilities from an augmented teacher context to the base student. OPSDL uses the model\'s strong short-context reasoning as the teacher context to supervise the student\'s longer context generation — reducing hallucinations in long-context tasks without any external long-context data. MSD transfers safety alignment from high-resource languages (English) to low-resource languages: the teacher sees the English safety context, the student generates in the target language. OPHSD augments the teacher with a coding harness, then distills harness-augmented reasoning into a standalone student.',
    vision:      'Standard OPSD uses prefix conditioning (the teacher sees x + y* as a prefix). For diffusion LLMs and vision models, generation is not left-to-right — this is fundamentally incompatible. D-OPSD introduces suffix conditioning: for text generation, the student generates left-to-right from x, while the teacher is conditioned on the completed answer as a suffix (self-future-experience). For image generation, the teacher sees the target image, and step-level supervision replaces token-level supervision to align with the iterative denoising process. VISD extends this to video, using a video-aware judge to decompose reasoning quality into multiple dimensions.',
    trajectory:  'Rather than applying uniform per-token supervision, structured trajectory methods identify semantically meaningful boundaries. GEAR segments trajectories at "semantic deviation points" — positions where the student\'s distribution diverges significantly from a reference — and applies advantage reweighting within each segment. ROSD uses a self-reflector to identify the first erroneous span in the student\'s rollout, then provides a corrective idea that steers the teacher toward targeted fixes. Distillation is restricted to just the erroneous span, preserving all valid prefixes and preventing teacher supervision from overwriting correct reasoning.',
    theory:      'UniSD provides a unified theoretical framework showing that OPSD can be viewed as a special case of a general self-improvement objective with bounded generalization error. CREDIT decomposes the self-distillation reward using pointwise mutual information (PMI), showing that standard self-distillation inadvertently rewards input-agnostic "shortcut signals" — tokens that would be likely regardless of the input. Filtering by PMI removes these shortcuts and concentrates learning on input-specific credit. PBSD develops a theoretical framework for preference-based self-distillation, showing convergence properties under various reward models.',
  };

  let activeCard = null;
  const detailBox = document.getElementById('design-detail-box');

  document.querySelectorAll('.design-card').forEach(card => {
    card.addEventListener('click', () => {
      const key = card.dataset.design;
      if (activeCard === card) {
        card.classList.remove('active');
        detailBox.classList.remove('show');
        detailBox.textContent = '';
        activeCard = null;
      } else {
        document.querySelectorAll('.design-card').forEach(c => c.classList.remove('active'));
        card.classList.add('active');
        detailBox.textContent = DETAILS[key] || '';
        detailBox.classList.add('show');
        activeCard = card;
      }
    });
  });
})();

// ═══════════════════════════ §05: Beta/JSD Canvas ═══════════════════════════
(function() {
  const canvas = document.getElementById('beta-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  let W, H;

  function resize() {
    W = canvas.clientWidth; H = 220;
    canvas.width = W * DPR; canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
  }

  const VOCAB = ['is', 'the', 'so', '42', 'therefore', 'yes', 'no', 'then'];

  // Teacher distribution: peaked at index 3 ("42") — knows the answer
  const teacherProbs = [0.04, 0.03, 0.08, 0.62, 0.10, 0.06, 0.04, 0.03];
  // Student distribution: diffuse — unsure
  const studentProbs = [0.10, 0.08, 0.14, 0.22, 0.18, 0.12, 0.10, 0.06];

  function drawBeta(beta) {
    ctx.clearRect(0, 0, W, H);

    const nVocab = VOCAB.length;
    const barW = Math.floor((W - 100) / nVocab) - 4;
    const startX = 50;
    const maxH = H - 80;
    const baseY = H - 36;

    // Title
    ctx.fillStyle = '#9ca3af'; ctx.font = '9px monospace'; ctx.textAlign = 'left';
    ctx.fillText('Token probability distributions at position t', startX, 18);

    for (let i = 0; i < nVocab; i++) {
      const x = startX + i * (barW + 4);

      // Mixture distribution m
      const m = beta * teacherProbs[i] + (1 - beta) * studentProbs[i];

      // Teacher bar
      const tH = teacherProbs[i] * maxH;
      ctx.fillStyle = 'rgba(16,185,129,.25)'; ctx.strokeStyle = '#10b981';
      ctx.beginPath(); ctx.roundRect(x, baseY - tH, barW/3, tH, 2); ctx.fill(); ctx.stroke();

      // Student bar
      const sH = studentProbs[i] * maxH;
      ctx.fillStyle = 'rgba(6,182,212,.25)'; ctx.strokeStyle = '#06b6d4';
      ctx.beginPath(); ctx.roundRect(x + barW/3 + 2, baseY - sH, barW/3, sH, 2); ctx.fill(); ctx.stroke();

      // Mixture m bar
      const mH = m * maxH;
      ctx.fillStyle = 'rgba(139,92,246,.35)'; ctx.strokeStyle = '#8b5cf6';
      ctx.beginPath(); ctx.roundRect(x + 2*barW/3 + 4, baseY - mH, barW/3 - 2, mH, 2); ctx.fill(); ctx.stroke();

      // Token label
      ctx.fillStyle = '#6b7280'; ctx.font = '8px monospace'; ctx.textAlign = 'center';
      ctx.fillText('"' + VOCAB[i] + '"', x + barW/2, baseY + 12);
    }

    // Legend
    const ly = H - 18;
    ctx.fillStyle = '#10b981'; ctx.fillRect(startX, ly, 10, 8);
    ctx.fillStyle = '#9ca3af'; ctx.font = '8px monospace'; ctx.textAlign = 'left';
    ctx.fillText('Teacher p_T', startX + 14, ly + 7);

    ctx.fillStyle = '#06b6d4'; ctx.fillRect(startX + 90, ly, 10, 8);
    ctx.fillText('Student p_S', startX + 104, ly + 7);

    ctx.fillStyle = '#8b5cf6'; ctx.fillRect(startX + 185, ly, 10, 8);
    ctx.fillText('Mixture m = β·p_T+(1-β)·p_S', startX + 199, ly + 7);

    // Mode annotation
    let modeText;
    if (beta < 0.2) modeText = '← reverse KL: student commits to teacher\'s top mode ("42")';
    else if (beta > 0.8) modeText = '← forward KL: student must cover all teacher modes';
    else modeText = '← symmetric JSD: balanced, bounded in [0, log 2]';
    ctx.fillStyle = '#8b5cf6'; ctx.font = '9px monospace'; ctx.textAlign = 'left';
    ctx.fillText(modeText, startX, baseY - maxH - 8);
  }

  const slider = document.getElementById('beta-slider');
  const valEl  = document.getElementById('beta-val');
  const modeEl = document.getElementById('beta-mode');

  function updateBeta() {
    const beta = parseFloat(slider.value) / 100;
    if (valEl) valEl.textContent = beta.toFixed(2);
    if (modeEl) {
      if (beta < 0.2) modeEl.textContent = 'reverse KL';
      else if (beta > 0.8) modeEl.textContent = 'forward KL';
      else if (Math.abs(beta - 0.5) < 0.08) modeEl.textContent = 'symmetric JSD';
      else modeEl.textContent = 'generalized JSD';
    }
    resize();
    drawBeta(beta);
  }

  slider?.addEventListener('input', updateBeta);
  window.addEventListener('resize', updateBeta);
  resize(); drawBeta(0.5);
})();

// ═══════════════════════════ §06: Animated bar chart ═══════════════════════════
(function() {
  const allBars = document.getElementById('s-results');
  if (!allBars) return;
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          b.style.width = (parseFloat(b.dataset.w)) + '%';
        });
      }
    });
  }, { threshold: 0.2 }).observe(allBars);
})();
</script>

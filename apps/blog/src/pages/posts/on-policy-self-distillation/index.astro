<span class="cs-line cmt"># The "Three Board Axe" of post-training</span>
<span class="cs-line cmt"># Each solves something — each breaks something</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># SFT: maximum likelihood on expert demonstrations</span>
<span class="cs-line hl-a">L_SFT = -E[(x,y)~D] sum_t log π_θ(y_t | x, y_&lt;t)</span>
<span class="cs-line cmt">#   ✗ training on y_&lt;t (expert) ≠ inference on ŷ_&lt;t (model)</span>
<span class="cs-line cmt">#   ✗ exposure bias — errors compound at inference</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># GRPO: on-policy RL with group-relative advantage</span>
<span class="cs-line hl-a">A_i = (r(x,y_i) - mean(r)) / std(r)   # group norm</span>
<span class="cs-line hl-a">J_GRPO = E[min(w_it * A_i, clip(w_it,1±ε) * A_i)]</span>
<span class="cs-line cmt">#   ✓ on-policy — trains on model's own rollouts</span>
<span class="cs-line cmt">#   ✗ A_i same for all tokens in y_i (sparse credit)</span>
<span class="cs-line cmt">#   ✗ if all rollouts right/wrong: A_i=0, no gradient</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># OPD (GKD): on-policy with external teacher</span>
<span class="cs-line hl-a">L_OPD = E[y~π_θ] sum_t KL(π_θ(·|x,y_&lt;t) ‖ π_T(·|x,y_&lt;t))</span>
<span class="cs-line cmt">#   ✓ dense token-level supervision on student rollouts</span>
<span class="cs-line cmt">#   ✗ requires separate larger π_T (2× GPU memory)</span>
<span class="cs-line cmt">#   ✗ capacity gap if π_T is too powerful</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># OPSD: same model, two contexts</span>
<span class="cs-line hl-g">L_OPSD = E[y~π_θ^stud] sum_t KL(π_θ^stud ‖ π_θ^teach)</span>
<span class="cs-line hl-g">#   π_θ^stud: conditioned on x only</span>
<span class="cs-line hl-g">#   π_θ^teach: conditioned on x + y* (answer)</span>
<span class="cs-line hl-g">#   θ is SHARED — single model, two roles</span>
<span class="cs-line cmt">#   ✓ on-policy  ✓ dense  ✓ no external teacher</span>
      </pre>
    </div>

    <!-- panel: core -->
    <div class="cs-panel" id="panel-core">
      <pre class="cs-pre">
<span class="cs-line cmt"># OPSD objective — full form (Eq. 6)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Dataset: D = &#123;(x, y*)&#125; prompt + ground-truth answer</span>
<span class="cs-line cmt"># Student: π_θ^stud(·|x)         ← blind, on-policy rollout</span>
<span class="cs-line cmt"># Teacher: π_θ^teach(·|x, y*, y_&lt;t) ← informed, privileged</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p">L_OPSD(θ) = E_&#123;(x,y*)~D, y~π_θ^stud(·|x)&#125; [</span>
<span class="cs-line hl-p">    sum_&#123;t=1&#125;^&#123;|y|&#125;</span>
<span class="cs-line hl-p">    KL( π_θ^stud(·|x, y_&lt;t)</span>
<span class="cs-line hl-p">      ‖ π_θ^teach(·|x, y*, y_&lt;t) )</span>
<span class="cs-line hl-p">]</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Key: BOTH roles share θ</span>
<span class="cs-line cmt"># → gradient updates improve both student and teacher</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Intuition: "evaluation easier than generation"</span>
<span class="cs-line cmt"># A model knowing the answer (teacher) can produce</span>
<span class="cs-line cmt"># a coherent reasoning trace — student learns from it</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># KL is reverse KL by default (mode-seeking):</span>
<span class="cs-line cmt"># student avoids tokens teacher deems unlikely</span>
<span class="cs-line cmt"># → sharp, decisive student policy</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Alternative: JSD for symmetry + bounded gradients</span>
<span class="cs-line hl-c">m = β * p_T + (1-β) * p_S          # mixture</span>
<span class="cs-line hl-c">JSD_β = β*KL(p_T‖m) + (1-β)*KL(p_S‖m)</span>
<span class="cs-line hl-c"># bounded in [0, log2], prevents gradient explosion</span>
      </pre>
    </div>

    <!-- panel: loop -->
    <div class="cs-panel" id="panel-loop">
      <pre class="cs-pre">
<span class="cs-line cmt"># OPSD training loop (pseudocode)</span>
<span class="cs-line"> </span>
<span class="cs-line kw">def</span> <span class="fn">opsd_train</span>(model, dataset, steps):</span>
<span class="cs-line">  <span class="kw">for</span> step <span class="kw">in</span> <span class="fn">range</span>(steps):</span>
<span class="cs-line"> </span>
<span class="cs-line cmt">    # Step 1: sample on-policy rollout (student)</span>
<span class="cs-line hl-c">    x, y_star = <span class="fn">sample</span>(dataset)</span>
<span class="cs-line hl-c">    y = model.<span class="fn">generate</span>(x)  <span class="cmt"># student: sees x only</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt">    # Step 2: teacher forward pass (privileged)</span>
<span class="cs-line hl-p">    teacher_ctx = x + y_star + y  <span class="cmt"># privileged</span></span>
<span class="cs-line hl-p">    p_T = model.<span class="fn">logits</span>(teacher_ctx)  <span class="cmt"># teacher</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt">    # Step 3: student forward pass (blind)</span>
<span class="cs-line hl-g">    student_ctx = x + y  <span class="cmt"># no y* for student</span></span>
<span class="cs-line hl-g">    p_S = model.<span class="fn">logits</span>(student_ctx)  <span class="cmt"># student</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt">    # Step 4: per-token divergence + update</span>
<span class="cs-line hl-a">    loss = <span class="fn">mean</span>([<span class="fn">KL</span>(p_S[t], p_T[t])</span>
<span class="cs-line hl-a">               <span class="kw">for</span> t <span class="kw">in</span> <span class="fn">range</span>(<span class="fn">len</span>(y))])</span>
<span class="cs-line hl-a">    loss.<span class="fn">backward</span>()  <span class="cmt"># updates shared θ</span></span>
<span class="cs-line hl-a">    optimizer.<span class="fn">step</span>()</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Memory: student + teacher can often be batched</span>
<span class="cs-line cmt"># → no separate teacher checkpoint needed</span>
<span class="cs-line cmt"># → 40–60% less GPU memory vs OPD</span>
      </pre>
    </div>

    <!-- panel: designs -->
    <div class="cs-panel" id="panel-designs">
      <pre class="cs-pre">
<span class="cs-line cmt"># OPSD design space — 8 axes</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># 1. Hybrid RL + SD</span>
<span class="cs-line hl-p">HDPO: RL_reward → direction; SD_KL → magnitude</span>
<span class="cs-line hl-p">SRPO: route correct samples to RL, failed to SD</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># 2. Feedback-Driven (reflection context)</span>
<span class="cs-line hl-c">SDPO:  compiler error → teacher reflection context</span>
<span class="cs-line hl-c">GATES: tutor consensus across N traces → gating</span>
<span class="cs-line hl-c">PAINT: mask y* by rollout-reference overlap; interp</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># 3. Stability Calibration</span>
<span class="cs-line hl-a">EGRSD: w_t = f(reward, KL_ratio, entropy_gate)</span>
<span class="cs-line hl-a">DASD:  high_H(t) → push away; low_H(t) → pull toward</span>
<span class="cs-line hl-a">AntiSD: maximize divergence + entropy gate (reversed!)</span>
<span class="cs-line hl-a">PACED: weight by pass_rate (zone of proximal dev.)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># 4. Reasoning Compression</span>
<span class="cs-line hl-g">CRISP:  teacher prompted "be concise" → shorter CoT</span>
<span class="cs-line hl-g">d-OPSD: suffix conditioning for diffusion LLMs</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># 5. Capability Transfer</span>
<span class="cs-line">OPSDL: short-context teacher → long-context student</span>
<span class="cs-line">MSD:   high-resource language → low-resource student</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># 6. Vision / Multimodal</span>
<span class="cs-line">D-OPSD (vision): teacher sees text+image → student text-only</span>
<span class="cs-line">VISD: video judge → structured multi-dim. feedback</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># 7. Structured Trajectory</span>
<span class="cs-line">GEAR:  segment by semantic deviation points</span>
<span class="cs-line">ROSD:  locate first error; distill only error span</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># 8. Theory</span>
<span class="cs-line">UniSD:  generalization bounds (unified view)</span>
<span class="cs-line">CREDIT: PMI decomposition of self-distillation reward</span>
      </pre>
    </div>

    <!-- panel: signal -->
    <div class="cs-panel" id="panel-signal">
      <pre class="cs-pre">
<span class="cs-line cmt"># Generalized Jensen-Shannon Divergence (JSD_β)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Mixture distribution m:</span>
<span class="cs-line hl-p">m = β * p_T + (1 - β) * p_S</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># JSD with parameter β:</span>
<span class="cs-line hl-p">JSD_β(p_T, p_S) =</span>
<span class="cs-line hl-p">    β   * KL(p_T ‖ m) +</span>
<span class="cs-line hl-p">    (1-β) * KL(p_S ‖ m)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># β=0.5 (symmetric JSD):</span>
<span class="cs-line cmt">#   bounded in [0, log 2]</span>
<span class="cs-line cmt">#   prevents gradient explosion</span>
<span class="cs-line cmt">#   teacher and student equally weighted</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># β→0 (reverse KL, mode-seeking):</span>
<span class="cs-line cmt">#   student avoids low-probability teacher tokens</span>
<span class="cs-line cmt">#   produces sharp, decisive policy</span>
<span class="cs-line cmt">#   may miss alternative correct paths</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># β→1 (forward KL, mode-covering):</span>
<span class="cs-line cmt">#   student must match ALL teacher modes</span>
<span class="cs-line cmt">#   encourages diversity / exploration</span>
<span class="cs-line cmt">#   may sacrifice precision</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># EGRSD entropy confidence gate:</span>
<span class="cs-line hl-c">H_t = -sum_v p_T(v|...) * log p_T(v|...)   # entropy</span>
<span class="cs-line hl-c">w_t = 1 - clip(H_t / H_max, 0, 1 - ε)    # gate</span>
<span class="cs-line hl-c">L_EGRSD = sum_t w_t * JSD_β(p_T[t], p_S[t])</span>
<span class="cs-line cmt"># high-entropy → low weight (ambiguous → skip)</span>
<span class="cs-line cmt"># low-entropy  → full weight (certain → learn)</span>
      </pre>
    </div>


/* ── Code sidebar tab switching ── */
const tabMeta = {
  drift:   { file: 'interactive_avatar/streaming.py',  title: 'The Drift Problem' },
  lsvm:    { file: 'interactive_avatar/lsvm.py',       title: 'Long-Short Visual Memory' },
  dkfs:    { file: 'interactive_avatar/dkfs.py',       title: 'Dynamic Key-Frame Selection' },

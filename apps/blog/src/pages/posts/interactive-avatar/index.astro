<span class="cs-line cmt"># Dynamic Key-Frame Selection</span>
<span class="cs-line cmt"># Only diverse frames enter long-term M_l</span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">dkfs_update</span>(<span class="kw">self</span>, m_out):</span>
<span class="cs-line hl-p">    <span class="cmt"># 1. get semantic features via SigLIP2</span></span>
<span class="cs-line hl-p">    frames = <span class="kw">self</span>.frame_cache[m_out]</span>
<span class="cs-line hl-p">    s_cand = <span class="fn">mean</span>([SigLIP2(I) <span class="kw">for</span> I <span class="kw">in</span> frames])</span>
<span class="cs-line"> </span>
<span class="cs-line hl-c">    <span class="cmt"># 2. compute current redundancy R</span></span>
<span class="cs-line hl-c">    feats = [<span class="fn">siglip</span>(m) <span class="kw">for</span> m <span class="kw">in</span> <span class="kw">self</span>.long]</span>
<span class="cs-line hl-c">    R = <span class="fn">mean_pairwise_cos</span>(feats)</span>
<span class="cs-line"> </span>
<span class="cs-line hl-g">    <span class="cmt"># 3. simulate replacing most similar slot</span></span>
<span class="cs-line hl-g">    worst_idx = <span class="fn">most_redundant_slot</span>(feats)</span>
<span class="cs-line hl-g">    feats[worst_idx] = s_cand</span>
<span class="cs-line hl-g">    R_prime = <span class="fn">mean_pairwise_cos</span>(feats)</span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="kw">if</span> R_prime &lt; R:</span>
<span class="cs-line">        <span class="cmt"># candidate is more diverse → keep</span></span>

/* ── §01 Drift canvas ── */
(function() {
  const canvas = document.getElementById('drift-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 210;
  canvas.width = W * DPR; canvas.height = H * DPR;
  ctx.scale(DPR, DPR);

  const TIMES = [5, 15, 25, 35, 50, 60]; // seconds
  const N = TIMES.length;
  const CELL_W = (W - 60) / N;
  const ROW1_Y = 30;
  const ROW2_Y = 110;
  const CELL_H = 68;
  const REF_H = [180, 60, 80]; // reference HSL

  // seeded PRNG for noise
  function sr(n) { return ((1664525 * n + 1013904223) & 0x7fffffff) / 0x7fffffff; }

  let tick = 0;
  function draw() {
    ctx.clearRect(0, 0, W, H);

    // Labels
    ctx.font = `600 ${10}px var(--ff-mono, monospace)`;
    ctx.fillStyle = '#ef4444';
    ctx.fillText('No memory', 2, ROW1_Y + CELL_H / 2 + 4);
    ctx.fillStyle = '#8b5cf6';
    ctx.fillText('LSVM', 2, ROW2_Y + CELL_H / 2 + 4);

    const drift_phase = (tick % 240) / 240; // 0→1 loop

    TIMES.forEach((t, i) => {
      const x = 56 + i * CELL_W;
      const cellW = CELL_W - 4;

      // Time label
      ctx.font = `9px var(--ff-mono, monospace)`;
      ctx.fillStyle = '#6b7280';
      ctx.textAlign = 'center';
      ctx.fillText(t + 's', x + cellW / 2, ROW1_Y - 6);

      // Drift amount for row 1 (increases over time)
      const driftFrac = (t / 60) * 0.7 * Math.sin(drift_phase * Math.PI * 2 + i * 0.5) * 0.5 + (t / 60) * 0.55;
      const drifted_h = (REF_H[0] + driftFrac * 120) % 360;
      const drifted_s = Math.max(20, REF_H[1] - driftFrac * 30);
      const drifted_l = Math.max(25, Math.min(75, REF_H[2] + driftFrac * 20));

      // Row 1: drifting
      ctx.fillStyle = `hsl(${drifted_h},${drifted_s}%,${drifted_l}%)`;
      ctx.beginPath();
      ctx.roundRect(x, ROW1_Y, cellW, CELL_H, 5);
      ctx.fill();
      ctx.strokeStyle = `hsl(${drifted_h},${drifted_s}%,${Math.min(90, drifted_l + 20)}%)`;
      ctx.lineWidth = 1.5;
      ctx.stroke();

      // Face silhouette on row 1
      drawFace(ctx, x + cellW / 2, ROW1_Y + CELL_H / 2, drifted_l > 55 ? 0.25 : 0.6);

      // Drift indicator: red X for severe drift
      if (t > 30) {
        ctx.fillStyle = `rgba(239,68,68,${(t - 30) / 45})`;
        ctx.font = `bold ${11}px monospace`;
        ctx.textAlign = 'right';
        ctx.fillText('⚡', x + cellW - 3, ROW1_Y + 14);
      }

      // Row 2: LSVM — consistent
      ctx.fillStyle = `hsl(${REF_H[0]},${REF_H[1]}%,${REF_H[2]}%)`;
      ctx.beginPath();
      ctx.roundRect(x, ROW2_Y, cellW, CELL_H, 5);
      ctx.fill();
      ctx.strokeStyle = `hsl(${REF_H[0]},${REF_H[1]}%,${REF_H[2] + 20}%)`;
      ctx.lineWidth = 1.5;
      ctx.stroke();
      drawFace(ctx, x + cellW / 2, ROW2_Y + CELL_H / 2, 0.55);

      // Checkmark for LSVM
      ctx.fillStyle = 'rgba(16,185,129,.8)';
      ctx.font = `bold ${11}px monospace`;
      ctx.textAlign = 'right';
      ctx.fillText('✓', x + cellW - 3, ROW2_Y + 14);

      ctx.textAlign = 'left';
    });

    // Memory indicator for LSVM row
    ctx.fillStyle = 'rgba(139,92,246,.2)';
    ctx.strokeStyle = 'rgba(139,92,246,.4)';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.roundRect(56, ROW2_Y + CELL_H + 6, W - 60, 16, 4);
    ctx.fill();
    ctx.stroke();
    ctx.fillStyle = '#8b5cf6';
    ctx.font = `8px var(--ff-mono, monospace)`;
    ctx.textAlign = 'center';
    ctx.fillText('LSVM: long-term memory anchors global appearance throughout generation', W / 2, ROW2_Y + CELL_H + 17);
    ctx.textAlign = 'left';

    tick++;
    requestAnimationFrame(draw);
  }

  function drawFace(ctx, cx, cy, alpha) {
    ctx.save();
    ctx.globalAlpha = alpha;
    // Head
    ctx.fillStyle = '#f3d5b0';
    ctx.beginPath();
    ctx.ellipse(cx, cy - 4, 12, 14, 0, 0, Math.PI * 2);
    ctx.fill();
    // Eyes
    ctx.fillStyle = '#1a1a2e';
    ctx.beginPath();
    ctx.ellipse(cx - 4, cy - 6, 2, 2, 0, 0, Math.PI * 2);
    ctx.fill();
    ctx.beginPath();
    ctx.ellipse(cx + 4, cy - 6, 2, 2, 0, 0, Math.PI * 2);
    ctx.fill();
    // Shoulder
    ctx.fillStyle = '#3b4a6b';
    ctx.beginPath();
    ctx.ellipse(cx, cy + 16, 16, 10, 0, 0, Math.PI);
    ctx.fill();
    ctx.restore();
  }

  draw();
})();

/* ── §03 DKFS step navigator ── */
(function() {
  let step = 0;
  const boxes = document.querySelectorAll('#dkfs-steps .step-box');
  const prevBtn = document.getElementById('dkfs-prev');
  const nextBtn = document.getElementById('dkfs-next');
  const progEl  = document.getElementById('dkfs-prog');

  function updateSteps() {
    boxes.forEach((b, i) => {
      b.classList.remove('active', 'done');
      if (i === step) b.classList.add('active');
      else if (i < step) b.classList.add('done');
    });
    if (prevBtn) prevBtn.disabled = step === 0;
    if (nextBtn) nextBtn.disabled = step === boxes.length - 1;
    if (progEl) progEl.textContent = `Step ${step + 1} of ${boxes.length}`;
    boxes.forEach((b, i) => {
      const n = b.querySelector('.step-num');
      if (n) n.textContent = i < step ? '✓' : String(i + 1);
    });
  }
  prevBtn?.addEventListener('click', () => { if (step > 0) { step--; updateSteps(); } });
  nextBtn?.addEventListener('click', () => { if (step < boxes.length - 1) { step++; updateSteps(); } });
  updateSteps();
})();

/* ── §04 RRM state machine animation ── */
(function() {
  const states = [
    { id: 'sm-listen', desc: 'Avatar waits, listening. User says: "Can you check what time it is on your watch?" — audio passes through ASR.' },
    { id: 'sm-reason', desc: 'LLM receives transcript + previous stable-state prompt. Outputs: action prompt ("look at watch"), audio reply ("It\'s 8:14 PM"), stable prompt ("man standing, wearing watch").' },
    { id: 'sm-action', desc: 'Action State: DiT conditioned on (p_act, a_resp). Avatar glances at watch while speaking. Cache-Switching fires to update KV cache under new action prompt.' },
    { id: 'sm-stable', desc: 'Audio finishes. Stable State: audio condition cleared, prompt switches to p_stable. Avatar holds position — no spurious motion. Waits for next user input.' },
  ];
  let idx = 0;
  const descEl = document.getElementById('sm-desc');

  function activateState(i) {
    states.forEach((s, j) => {
      document.getElementById(s.id)?.classList.toggle('active', j === i);
    });
    if (descEl) descEl.textContent = states[i].desc;
  }

  activateState(0);
  setInterval(() => {
    idx = (idx + 1) % states.length;
    activateState(idx);
  }, 2800);
})();

/* ── §05 Animated bar charts ── */
function animateBars(barContainerId, maxVal) {
  const container = document.getElementById(barContainerId);
  if (!container) return;
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        container.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          const w = parseFloat(b.dataset.w);
          const max = parseFloat(b.dataset.max || '100');
          b.style.width = (w / max * 100) + '%';
        });
      }
    });
  }, { threshold: 0.3 }).observe(container);
}
animateBars('bars-obj', 100);
animateBars('bars-fps', 30);
</script>

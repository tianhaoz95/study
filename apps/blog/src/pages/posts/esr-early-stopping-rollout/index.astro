<script>
// ─── TOC + sidebar toggles ───
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});
const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ─── Code sidebar tab switching ───
const tabMeta = {
  problem: { file: 'esr/problem.py',  title: 'The Decay Problem' },
  opd:     { file: 'esr/opd.py',      title: 'On-Policy Distillation' },
  esr:     { file: 'esr/esr.py',      title: 'Early Stopping Rollout' },
  cascade: { file: 'esr/cascade.py',  title: 'Cascading Alignment' },
  submode: { file: 'esr/submode.py',  title: 'Sub-mode Commitment' },
  results: { file: 'esr/results.py',  title: 'Results' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ─── IntersectionObserver: TOC + sidebar sync ───
const sectionMap = {
  's-problem': 'problem',
  's-opd':     'opd',
  's-esr':     'esr',
  's-cascade': 'cascade',
  's-submode': 'submode',
  's-results': 'results',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ─── §01 Decay curve canvas ───
(function() {
  const canvas = document.getElementById('decay-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 220;
  canvas.width = W * DPR; canvas.height = H * DPR;
  ctx.scale(DPR, DPR);

  const pad = { l: 60, r: 20, t: 20, b: 45 };
  const cW = W - pad.l - pad.r, cH = H - pad.t - pad.b;

  // Data points: [N, teacher_accuracy]
  const data = [
    [0,   65.30],
    [50,  64.10],
    [100, 62.70],
    [150, 59.80],
    [200, 57.15],
    [250, 54.20],
    [300, 51.75],
  ];
  const studentBaseline = 50.95;
  const xMax = 300, yMin = 44, yMax = 72;

  function xp(n) { return pad.l + (n / xMax) * cW; }
  function yp(v) { return pad.t + (1 - (v - yMin) / (yMax - yMin)) * cH; }

  // Grid lines
  ctx.strokeStyle = 'rgba(255,255,255,0.05)';
  ctx.lineWidth = 1;
  [50, 55, 60, 65, 70].forEach(v => {
    ctx.beginPath(); ctx.moveTo(pad.l, yp(v)); ctx.lineTo(pad.l + cW, yp(v)); ctx.stroke();
  });
  [0, 50, 100, 150, 200, 250, 300].forEach(n => {
    ctx.beginPath(); ctx.moveTo(xp(n), pad.t); ctx.lineTo(xp(n), pad.t + cH); ctx.stroke();
  });

  // Student baseline dashed line
  ctx.strokeStyle = 'rgba(239,68,68,0.4)';
  ctx.lineWidth = 1.5;
  ctx.setLineDash([5, 4]);
  ctx.beginPath(); ctx.moveTo(pad.l, yp(studentBaseline)); ctx.lineTo(pad.l + cW, yp(studentBaseline)); ctx.stroke();
  ctx.setLineDash([]);
  ctx.fillStyle = 'rgba(239,68,68,0.6)';
  ctx.font = '9px var(--ff-mono)';
  ctx.textAlign = 'left';
  ctx.fillText('student baseline 50.95%', pad.l + 4, yp(studentBaseline) - 4);

  // Shaded decay area
  ctx.beginPath();
  ctx.moveTo(xp(data[0][0]), yp(data[0][1]));
  data.forEach(([n, v]) => ctx.lineTo(xp(n), yp(v)));
  ctx.lineTo(xp(data[data.length-1][0]), yp(studentBaseline));
  ctx.lineTo(xp(data[0][0]), yp(studentBaseline));
  ctx.closePath();
  ctx.fillStyle = 'rgba(239,68,68,0.07)';
  ctx.fill();

  // Teacher accuracy line
  const grad = ctx.createLinearGradient(xp(0), 0, xp(300), 0);
  grad.addColorStop(0, 'rgba(16,185,129,0.9)');
  grad.addColorStop(0.33, 'rgba(245,158,11,0.9)');
  grad.addColorStop(1, 'rgba(239,68,68,0.9)');
  ctx.strokeStyle = grad;
  ctx.lineWidth = 2.5;
  ctx.beginPath();
  data.forEach(([n, v], i) => i === 0 ? ctx.moveTo(xp(n), yp(v)) : ctx.lineTo(xp(n), yp(v)));
  ctx.stroke();

  // Dots
  data.forEach(([n, v]) => {
    const ratio = n / xMax;
    const r = `rgb(${Math.round(16 + ratio * (239-16))},${Math.round(185 + ratio * (68-185))},${Math.round(129 + ratio * (68-129))})`;
    ctx.beginPath(); ctx.arc(xp(n), yp(v), 4, 0, Math.PI*2);
    ctx.fillStyle = r; ctx.fill();
  });

  // Labels for key points
  ctx.font = '10px var(--ff-mono)';
  ctx.textAlign = 'center';
  ctx.fillStyle = 'rgba(16,185,129,0.9)';
  ctx.fillText('65.3%', xp(0), yp(65.30) - 10);
  ctx.fillStyle = 'rgba(239,68,68,0.9)';
  ctx.fillText('51.75%', xp(300), yp(51.75) - 10);

  // Axes
  ctx.strokeStyle = 'rgba(255,255,255,0.2)';
  ctx.lineWidth = 1;
  ctx.beginPath(); ctx.moveTo(pad.l, pad.t); ctx.lineTo(pad.l, pad.t + cH); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(pad.l, pad.t + cH); ctx.lineTo(pad.l + cW, pad.t + cH); ctx.stroke();

  // Axis labels
  ctx.fillStyle = 'rgba(255,255,255,0.4)';
  ctx.font = '9px var(--ff-mono)';
  ctx.textAlign = 'right';
  [50, 55, 60, 65, 70].forEach(v => ctx.fillText(v + '%', pad.l - 6, yp(v) + 3));
  ctx.textAlign = 'center';
  [0, 100, 200, 300].forEach(n => ctx.fillText('N=' + n, xp(n), H - 6));
  ctx.fillStyle = 'rgba(255,255,255,0.35)';
  ctx.font = '9px var(--ff-mono)';
  ctx.fillText('student prefix length (tokens)', pad.l + cW / 2, H - 28);
  ctx.save(); ctx.translate(12, pad.t + cH / 2); ctx.rotate(-Math.PI/2);
  ctx.textAlign = 'center'; ctx.fillText('teacher avg@4', 0, 0); ctx.restore();
})();

// ─── §01 Token window diagrams ───
(function() {
  const fullEl = document.getElementById('full-tokens');
  const esrEl  = document.getElementById('esr-tokens');
  if (!fullEl || !esrEl) return;

  // Full: 50 tokens — first 10 clean, then 40 decayed
  for (let i = 0; i < 50; i++) {
    const d = document.createElement('span');
    d.className = 'tok ' + (i < 10 ? 'clean' : 'decayed');
    fullEl.appendChild(d);
  }
  // ESR: 10 tokens — all clean
  for (let i = 0; i < 10; i++) {
    const d = document.createElement('span');
    d.className = 'tok clean';
    esrEl.appendChild(d);
  }
})();

// ─── §03 N sweep canvas ───
(function() {
  const canvas = document.getElementById('nsweep-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 200;
  canvas.width = W * DPR; canvas.height = H * DPR;
  ctx.scale(DPR, DPR);

  const pad = { l: 56, r: 20, t: 20, b: 40 };
  const cW = W - pad.l - pad.r, cH = H - pad.t - pad.b;

  // N sweep data (from paper Figure 1 right)
  const sweep = [
    [25,  62.1],
    [50,  64.9],
    [75,  65.4],
    [100, 65.85],
    [125, 65.6],
    [150, 65.7],
    [200, 65.5],
    [300, 64.8],
    [400, 63.9],
  ];
  const opdLine = 62.35;
  const studentLine = 50.95;
  const xMax = 400, yMin = 48, yMax = 68;

  function xp(n) { return pad.l + (n / xMax) * cW; }
  function yp(v) { return pad.t + (1 - (v - yMin) / (yMax - yMin)) * cH; }

  // Grid
  ctx.strokeStyle = 'rgba(255,255,255,0.05)';
  ctx.lineWidth = 1;
  [50,55,60,65].forEach(v => {
    ctx.beginPath(); ctx.moveTo(pad.l, yp(v)); ctx.lineTo(pad.l+cW, yp(v)); ctx.stroke();
  });

  // Student baseline
  ctx.strokeStyle = 'rgba(255,255,255,0.15)';
  ctx.lineWidth = 1;
  ctx.setLineDash([3,3]);
  ctx.beginPath(); ctx.moveTo(pad.l, yp(studentLine)); ctx.lineTo(pad.l+cW, yp(studentLine)); ctx.stroke();

  // OPD reference line
  ctx.strokeStyle = 'rgba(245,158,11,0.5)';
  ctx.lineWidth = 1.5;
  ctx.beginPath(); ctx.moveTo(pad.l, yp(opdLine)); ctx.lineTo(pad.l+cW, yp(opdLine)); ctx.stroke();
  ctx.setLineDash([]);
  ctx.fillStyle = 'rgba(245,158,11,0.7)';
  ctx.font = '9px var(--ff-mono)';
  ctx.textAlign = 'left';
  ctx.fillText('OPD 62.4%', pad.l + cW * 0.6, yp(opdLine) - 5);

  // Shaded robust region [50–200]
  ctx.fillStyle = 'rgba(16,185,129,0.06)';
  ctx.fillRect(xp(50), pad.t, xp(200) - xp(50), cH);
  ctx.strokeStyle = 'rgba(16,185,129,0.2)';
  ctx.lineWidth = 1;
  ctx.setLineDash([3,3]);
  ctx.beginPath(); ctx.moveTo(xp(50), pad.t); ctx.lineTo(xp(50), pad.t+cH); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(xp(200), pad.t); ctx.lineTo(xp(200), pad.t+cH); ctx.stroke();
  ctx.setLineDash([]);
  ctx.fillStyle = 'rgba(16,185,129,0.4)';
  ctx.font = '9px var(--ff-mono)';
  ctx.textAlign = 'center';
  ctx.fillText('robust region', xp(125), pad.t + 11);

  // ESR line
  ctx.strokeStyle = 'rgba(139,92,246,0.9)';
  ctx.lineWidth = 2.5;
  ctx.beginPath();
  sweep.forEach(([n,v], i) => i===0 ? ctx.moveTo(xp(n), yp(v)) : ctx.lineTo(xp(n), yp(v)));
  ctx.stroke();
  sweep.forEach(([n,v]) => {
    ctx.beginPath(); ctx.arc(xp(n), yp(v), 3.5, 0, Math.PI*2);
    ctx.fillStyle = '#8b5cf6'; ctx.fill();
  });

  // Best point callout
  ctx.fillStyle = 'rgba(139,92,246,0.9)';
  ctx.font = '10px var(--ff-mono)';
  ctx.textAlign = 'center';
  ctx.fillText('65.9% (N=100)', xp(100), yp(65.85) - 11);

  // Axes
  ctx.strokeStyle = 'rgba(255,255,255,0.2)'; ctx.lineWidth = 1;
  ctx.beginPath(); ctx.moveTo(pad.l, pad.t); ctx.lineTo(pad.l, pad.t+cH); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(pad.l, pad.t+cH); ctx.lineTo(pad.l+cW, pad.t+cH); ctx.stroke();
  ctx.fillStyle = 'rgba(255,255,255,0.4)'; ctx.font = '9px var(--ff-mono)';
  ctx.textAlign = 'right';
  [50,55,60,65].forEach(v => ctx.fillText(v+'%', pad.l-5, yp(v)+3));
  ctx.textAlign = 'center';
  [50,100,200,300,400].forEach(n => ctx.fillText('N='+n, xp(n), H-6));
  ctx.fillStyle = 'rgba(255,255,255,0.35)';
  ctx.fillText('rollout cutoff N (tokens)', pad.l+cW/2, H-22);
})();

// ─── §04 Cascading alignment canvas ───
(function() {
  const canvas = document.getElementById('cascade-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 240;
  canvas.width = W * DPR; canvas.height = H * DPR;
  ctx.scale(DPR, DPR);

  const pad = { l: 56, r: 20, t: 30, b: 42 };
  const cW = W - pad.l - pad.r, cH = H - pad.t - pad.b;

  // Synthetic KL curves matching paper Figure 2 qualitative shape
  // Before training: high at start, gradual decrease
  function klBefore(t) {
    if (t < 50) return 0.82 - t * 0.001;
    if (t < 200) return 0.73 - (t-50) * 0.0005;
    return 0.65 - (t-200) * 0.0004;
  }
  // After training: drops sharply in [0,100] trained window, also drops in [100+] cascade
  function klAfter(t) {
    if (t <= 100) return 0.31 + t * 0.0003;
    // cascade — drops to similar level as trained window
    return 0.34 + (t-100) * 0.00015;
  }

  const tMax = 600, yMin = 0, yMax = 1.0;
  const pts = 120;

  function xp(t) { return pad.l + (t / tMax) * cW; }
  function yp(v) { return pad.t + (1 - (v - yMin) / (yMax - yMin)) * cH; }

  // Grid
  ctx.strokeStyle = 'rgba(255,255,255,0.05)'; ctx.lineWidth = 1;
  [0.2, 0.4, 0.6, 0.8].forEach(v => {
    ctx.beginPath(); ctx.moveTo(pad.l, yp(v)); ctx.lineTo(pad.l+cW, yp(v)); ctx.stroke();
  });

  // Training window shade [0, 100]
  ctx.fillStyle = 'rgba(16,185,129,0.08)';
  ctx.fillRect(xp(0), pad.t, xp(100)-xp(0), cH);

  // Cascade region shade [100, tMax]
  ctx.fillStyle = 'rgba(6,182,212,0.05)';
  ctx.fillRect(xp(100), pad.t, xp(tMax)-xp(100), cH);

  // Divider
  ctx.strokeStyle = 'rgba(255,255,255,0.2)'; ctx.lineWidth = 1; ctx.setLineDash([4,3]);
  ctx.beginPath(); ctx.moveTo(xp(100), pad.t); ctx.lineTo(xp(100), pad.t+cH); ctx.stroke();
  ctx.setLineDash([]);
  ctx.fillStyle = 'rgba(255,255,255,0.35)'; ctx.font = '8px var(--ff-mono)'; ctx.textAlign = 'center';
  ctx.fillText('N=100', xp(100), pad.t - 4);

  // Before line (amber)
  ctx.strokeStyle = 'rgba(245,158,11,0.8)'; ctx.lineWidth = 2;
  ctx.beginPath();
  for (let i = 0; i <= pts; i++) {
    const t = i / pts * tMax;
    const v = klBefore(t);
    i === 0 ? ctx.moveTo(xp(t), yp(v)) : ctx.lineTo(xp(t), yp(v));
  }
  ctx.stroke();

  // After line (purple)
  ctx.strokeStyle = 'rgba(139,92,246,0.9)'; ctx.lineWidth = 2;
  ctx.beginPath();
  for (let i = 0; i <= pts; i++) {
    const t = i / pts * tMax;
    const v = klAfter(t);
    i === 0 ? ctx.moveTo(xp(t), yp(v)) : ctx.lineTo(xp(t), yp(v));
  }
  ctx.stroke();

  // Gap arrow annotation at t=300
  const t300 = 300;
  const before300 = klBefore(t300);
  const after300  = klAfter(t300);
  ctx.strokeStyle = 'rgba(6,182,212,0.5)'; ctx.lineWidth = 1.5;
  ctx.beginPath(); ctx.moveTo(xp(t300)+14, yp(before300)); ctx.lineTo(xp(t300)+14, yp(after300)); ctx.stroke();
  ctx.fillStyle = 'rgba(6,182,212,0.8)'; ctx.font = '9px var(--ff-mono)'; ctx.textAlign = 'left';
  ctx.fillText('−35%', xp(t300)+18, yp((before300+after300)/2)+3);
  ctx.fillText('(untrained!)', xp(t300)+18, yp((before300+after300)/2)+14);

  // Region labels
  ctx.fillStyle = 'rgba(16,185,129,0.6)'; ctx.font = '8px var(--ff-mono)'; ctx.textAlign = 'center';
  ctx.fillText('trained', xp(50), pad.t + 12);
  ctx.fillText('[0,100]', xp(50), pad.t + 21);
  ctx.fillStyle = 'rgba(6,182,212,0.5)';
  ctx.fillText('cascade benefit', xp(350), pad.t + 12);
  ctx.fillText('[100+, no training]', xp(350), pad.t + 21);

  // Axes
  ctx.strokeStyle = 'rgba(255,255,255,0.2)'; ctx.lineWidth = 1;
  ctx.beginPath(); ctx.moveTo(pad.l, pad.t); ctx.lineTo(pad.l, pad.t+cH); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(pad.l, pad.t+cH); ctx.lineTo(pad.l+cW, pad.t+cH); ctx.stroke();
  ctx.fillStyle = 'rgba(255,255,255,0.4)'; ctx.font = '9px var(--ff-mono)';
  ctx.textAlign = 'right';
  [0.2, 0.4, 0.6, 0.8].forEach(v => ctx.fillText(v.toFixed(1), pad.l-5, yp(v)+3));
  ctx.textAlign = 'center';
  [0, 100, 200, 300, 400, 500, 600].forEach(t => ctx.fillText(t, xp(t), H-5));
  ctx.fillStyle = 'rgba(255,255,255,0.35)'; ctx.font = '9px var(--ff-mono)';
  ctx.fillText('token position', pad.l+cW/2, H-18);
  ctx.save(); ctx.translate(12, pad.t+cH/2); ctx.rotate(-Math.PI/2);
  ctx.textAlign = 'center'; ctx.fillText('KL divergence', 0, 0); ctx.restore();
})();

// ─── §05 Mode canvas ───
(function() {
  const canvas = document.getElementById('mode-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 260;
  canvas.width = W * DPR; canvas.height = H * DPR;
  ctx.scale(DPR, DPR);

  let currentMode = 'teacher';

  function drawModeCanvas(mode) {
    ctx.clearRect(0, 0, W, H);

    const pad = { l: 20, r: 20, t: 50, b: 40 };
    const cW = W - pad.l - pad.r, cH = H - pad.t - pad.b;

    // Token options as a "vocabulary" bar chart at a bimodal planning position
    // Two modes: "Let me think step by step..." (verbose, dominant) vs "The answer is..." (concise, better)
    const tokens = ['verbose\nmode', 'concise\nmode', 'other\ntokens'];
    const barW = cW / (tokens.length + 1);

    let teacherDist, studentDist;
    if (mode === 'teacher') {
      teacherDist = [0.60, 0.38, 0.02]; // bimodal — verbose dominant
      studentDist = null;
    } else if (mode === 'opd') {
      teacherDist = [0.60, 0.38, 0.02];
      studentDist = [0.72, 0.22, 0.06]; // converges to dominant mode
    } else {
      teacherDist = [0.60, 0.38, 0.02];
      studentDist = [0.18, 0.79, 0.03]; // commits to sub-mode!
    }

    const yMax = 0.85;
    function xb(i) { return pad.l + (i + 0.5) * (cW / tokens.length); }
    function yp(v) { return pad.t + cH - (v / yMax) * cH; }

    // Grid
    ctx.strokeStyle = 'rgba(255,255,255,0.05)'; ctx.lineWidth = 1;
    [0.2,0.4,0.6,0.8].forEach(v => {
      ctx.beginPath(); ctx.moveTo(pad.l, yp(v)); ctx.lineTo(pad.l+cW, yp(v)); ctx.stroke();
    });

    const bw = barW * 0.35;

    // Draw bars for teacher (always shown)
    tokens.forEach((tok, i) => {
      const x = xb(i);
      const v = teacherDist[i];
      const bH = (v / yMax) * cH;
      ctx.fillStyle = 'rgba(16,185,129,0.35)';
      ctx.fillRect(x - bw - 2, yp(v), bw, bH);
      ctx.strokeStyle = 'rgba(16,185,129,0.6)'; ctx.lineWidth = 1;
      ctx.strokeRect(x - bw - 2, yp(v), bw, bH);
    });

    // Draw student bars if present
    if (studentDist) {
      const col = mode === 'opd' ? 'rgba(245,158,11,0.7)' : 'rgba(139,92,246,0.8)';
      const stroke = mode === 'opd' ? 'rgba(245,158,11,0.9)' : 'rgba(167,139,250,0.9)';
      tokens.forEach((tok, i) => {
        const x = xb(i);
        const v = studentDist[i];
        const bH = (v / yMax) * cH;
        ctx.fillStyle = col;
        ctx.fillRect(x + 2, yp(v), bw, bH);
        ctx.strokeStyle = stroke; ctx.lineWidth = 1;
        ctx.strokeRect(x + 2, yp(v), bw, bH);
      });
    }

    // Token labels
    ctx.fillStyle = 'rgba(255,255,255,0.55)';
    ctx.font = '10px var(--ff-mono)';
    ctx.textAlign = 'center';
    tokens.forEach((tok, i) => {
      const parts = tok.split('\n');
      parts.forEach((p, j) => ctx.fillText(p, xb(i), H - 22 + j * 12));
    });

    // Y axis labels
    ctx.fillStyle = 'rgba(255,255,255,0.35)'; ctx.font = '9px var(--ff-mono)'; ctx.textAlign = 'right';
    [0.2,0.4,0.6,0.8].forEach(v => ctx.fillText((v*100).toFixed(0)+'%', pad.l-4, yp(v)+3));

    // Title
    ctx.fillStyle = 'rgba(255,255,255,0.6)'; ctx.font = '11px var(--ff-mono)'; ctx.textAlign = 'left';
    let title = '';
    if (mode === 'teacher') title = 'Teacher distribution — bimodal (verbose mode dominant)';
    else if (mode === 'opd')  title = 'After OPD — student drifts toward dominant (verbose) mode';
    else                       title = 'After ESR — student commits to sub-mode (concise, better)!';
    ctx.fillText(title, pad.l, 22);

    // Legend
    ctx.fillStyle = 'rgba(16,185,129,0.7)';
    ctx.fillRect(W - 160, 8, 10, 10);
    ctx.fillStyle = 'rgba(255,255,255,0.4)'; ctx.font = '9px var(--ff-mono)'; ctx.textAlign = 'left';
    ctx.fillText('teacher πₜ', W - 147, 17);

    if (mode !== 'teacher') {
      const col2 = mode === 'opd' ? 'rgba(245,158,11,0.8)' : 'rgba(139,92,246,0.8)';
      ctx.fillStyle = col2;
      ctx.fillRect(W - 160, 22, 10, 10);
      ctx.fillStyle = 'rgba(255,255,255,0.4)';
      ctx.fillText(mode === 'opd' ? 'student (OPD)' : 'student (ESR)', W - 147, 31);
    }
  }

  drawModeCanvas(currentMode);

  document.querySelectorAll('#mode-btns .ctrl-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('#mode-btns .ctrl-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentMode = btn.dataset.mode;
      drawModeCanvas(currentMode);
    });
  });
})();

// ─── §06 Animated bar chart ───
(function() {
  const el = document.getElementById('results-bars');
  if (!el) return;
  let triggered = false;
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting && !triggered) {
        triggered = true;
        document.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          const pct = parseFloat(b.dataset.w);
          b.style.width = pct + '%';
        });
      }
    });
  }, { threshold: 0.3 }).observe(el);
})();
</script>
</BaseLayout>

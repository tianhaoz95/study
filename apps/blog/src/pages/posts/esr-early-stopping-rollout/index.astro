      <!-- Student box -->
      <rect x="150" y="68" width="130" height="64" rx="6" fill="rgba(139,92,246,.12)" stroke="rgba(139,92,246,.5)" stroke-width="1.5"/>
      <text x="215" y="90" text-anchor="middle" font-size="11" fill="#a78bfa" font-family="var(--ff-mono)" font-weight="600">Student πₛ</text>
      <text x="215" y="108" text-anchor="middle" font-size="9" fill="rgba(167,139,250,.7)" font-family="var(--ff-mono)">generates rollout</text>
      <text x="215" y="122" text-anchor="middle" font-size="9" fill="rgba(167,139,250,.7)" font-family="var(--ff-mono)">y₁, y₂, ..., y_T</text>

      <!-- Arrow student → tokens -->
      <path d="M 280 100 L 320 100" stroke="rgba(255,255,255,.3)" stroke-width="1.5" fill="none" marker-end="url(#arr)"/>
      <text x="300" y="92" text-anchor="middle" font-size="8" fill="rgba(255,255,255,.35)" font-family="var(--ff-mono)">rollout</text>

      <!-- Tokens row -->
      <rect x="320" y="80" width="200" height="40" rx="6" fill="rgba(245,158,11,.08)" stroke="rgba(245,158,11,.3)" stroke-width="1"/>
      <text x="420" y="97" text-anchor="middle" font-size="10" fill="#f59e0b" font-family="var(--ff-mono)">Student Tokens</text>
      <text x="420" y="112" text-anchor="middle" font-size="9" fill="rgba(245,158,11,.7)" font-family="var(--ff-mono)">(x, y₁..yₜ₋₁) → yₜ</text>

      <!-- Arrow tokens up to teacher -->
      <path d="M 420 80 L 420 50" stroke="rgba(255,255,255,.3)" stroke-width="1.5" fill="none" marker-end="url(#arr)"/>

      <!-- Teacher box -->
      <rect x="310" y="10" width="220" height="38" rx="6" fill="rgba(16,185,129,.1)" stroke="rgba(16,185,129,.4)" stroke-width="1.5"/>
      <text x="420" y="26" text-anchor="middle" font-size="11" fill="#10b981" font-family="var(--ff-mono)" font-weight="600">Teacher πₜ</text>
      <text x="420" y="40" text-anchor="middle" font-size="9" fill="rgba(16,185,129,.7)" font-family="var(--ff-mono)">scores each token position</text>

      <!-- Arrow teacher → loss -->
      <path d="M 530 30 L 580 30 L 580 100 L 565 100" stroke="rgba(239,68,68,.5)" stroke-width="1.5" fill="none" stroke-dasharray="4,3" marker-end="url(#arrd)"/>

      <!-- Loss box -->
      <rect x="565" y="80" width="125" height="40" rx="6" fill="rgba(239,68,68,.1)" stroke="rgba(239,68,68,.4)" stroke-width="1.5"/>
      <text x="627" y="96" text-anchor="middle" font-size="11" fill="#ef4444" font-family="var(--ff-mono)" font-weight="600">KL Loss</text>
      <text x="627" y="112" text-anchor="middle" font-size="9" fill="rgba(239,68,68,.7)" font-family="var(--ff-mono)">uniform over t=1..T</text>

      <!-- Decay label on arrow -->
      <text x="553" y="68" text-anchor="middle" font-size="9" fill="rgba(239,68,68,.7)" font-family="var(--ff-mono)">⚠ decays</text>
      <text x="553" y="79" text-anchor="middle" font-size="9" fill="rgba(239,68,68,.7)" font-family="var(--ff-mono)">at t&gt;100</text>

      <defs>
        <marker id="arr" markerWidth="6" markerHeight="6" refX="5" refY="3" orient="auto">
          <path d="M0,0 L6,3 L0,6 Z" fill="rgba(255,255,255,.3)"/>
        </marker>
        <marker id="arrd" markerWidth="6" markerHeight="6" refX="5" refY="3" orient="auto">
          <path d="M0,0 L6,3 L0,6 Z" fill="rgba(239,68,68,.5)"/>
        </marker>

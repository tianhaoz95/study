  </div>
  <div class="vp-body" style="min-width:580px;overflow-x:auto">
    <svg id="opd-arch" viewBox="0 0 700 200" style="width:100%;max-width:700px;display:block;margin:0 auto" aria-label="OPD architecture diagram">

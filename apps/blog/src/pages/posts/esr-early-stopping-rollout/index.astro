<span class="cs-line cmt"># Off-Policy Teacher Decay</span>
<span class="cs-line cmt"># Teacher accuracy on MATH-500 (avg@4)</span>
<span class="cs-line cmt"># as student prefix length N grows:</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Teacher: Qwen3-1.7B</span>
<span class="cs-line cmt"># Student: Qwen2.5-Math-1.5B</span>
<span class="cs-line"></span>
<span class="cs-line hl-p"><span class="cmt"># N=0   (no prefix):    65.30%  ← baseline</span></span>
<span class="cs-line hl-c"><span class="cmt"># N=100 (100 student):  62.70%  ← -2.6%</span></span>
<span class="cs-line hl-a"><span class="cmt"># N=200 (200 student):  57.15%  ← -8.1%</span></span>
<span class="cs-line hl-g" style="background:rgba(239,68,68,.1);border-left-color:#ef4444"><span class="cmt"># N=300 (300 student):  51.75%  ← -13.5%</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Student baseline:     50.95%</span>
<span class="cs-line cmt"># Teacher nearly at student level after 300 tokens</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># The decay gap (definition):</span>
<span class="cs-line"><span class="fn">delta_decay</span>(t) =</span>
<span class="cs-line hl-c">    A_teacher(x)              <span class="cmt"># unconditioned</span></span>
<span class="cs-line hl-c">    - A_teacher(x | y_student_&lt;t)  <span class="cmt"># conditioned</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Larger delta_decay means teacher signal</span>
<span class="cs-line cmt"># at position t is unreliable</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-opd">
      <pre class="cs-pre">
<span class="cs-line cmt"># Standard On-Policy Distillation (OPD)</span>
<span class="cs-line cmt"># Gu et al. (2024) MiniLLM, Agarwal et al. (2024) GKD</span>
<span class="cs-line"></span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">opd_loss</span>(student, teacher, prompt):</span>
<span class="cs-line cmt">    # 1. Student generates FULL rollout</span>
<span class="cs-line hl-a">    rollout = <span class="fn">student.generate</span>(prompt, max_tokens=<span class="num">1000</span>)</span>
<span class="cs-line"></span>
<span class="cs-line cmt">    # 2. Teacher scores EVERY token position</span>
<span class="cs-line">    loss = <span class="num">0</span></span>
<span class="cs-line hl-p">    <span class="kw">for</span> t <span class="kw">in</span> <span class="fn">range</span>(<span class="fn">len</span>(rollout)):</span>
<span class="cs-line hl-p">        teacher_dist = <span class="fn">teacher.score</span>(prompt, rollout[:t])</span>
<span class="cs-line hl-p">        student_dist = <span class="fn">student.score</span>(prompt, rollout[:t])</span>
<span class="cs-line hl-p">        loss += <span class="fn">KL</span>(student_dist, teacher_dist)</span>
<span class="cs-line"></span>
<span class="cs-line cmt">    # Uniform weighting — gives equal weight to</span>
<span class="cs-line cmt">    # clean early signal AND decayed late signal</span>
<span class="cs-line hl-c">    <span class="kw">return</span> loss / <span class="fn">len</span>(rollout)  <span class="cmt"># ← problem!</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Cost: ~180s/step generating 1000 tokens</span>
<span class="cs-line cmt"># Peak GPU memory: 63.3 GB (needs model swap)</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-esr">
      <pre class="cs-pre">
<span class="cs-line cmt"># Early Stopping Rollout (ESR)</span>
<span class="cs-line cmt"># Zhou et al. (2026)  —  one-line change</span>
<span class="cs-line"></span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">esr_loss</span>(student, teacher, prompt, N=<span class="num">100</span>):</span>
<span class="cs-line cmt">    # 1. Student generates ONLY first N tokens</span>
<span class="cs-line hl-g">    rollout = <span class="fn">student.generate</span>(prompt, max_tokens=N)</span>
<span class="cs-line">    <span class="cmt"># ^ the only change vs full OPD</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt">    # 2. Teacher scores only the clean window</span>
<span class="cs-line">    loss = <span class="num">0</span></span>
<span class="cs-line hl-g">    <span class="kw">for</span> t <span class="kw">in</span> <span class="fn">range</span>(<span class="fn">len</span>(rollout)):  <span class="cmt"># len &lt;= N</span></span>
<span class="cs-line hl-g">        teacher_dist = <span class="fn">teacher.score</span>(prompt, rollout[:t])</span>
<span class="cs-line hl-g">        student_dist = <span class="fn">student.score</span>(prompt, rollout[:t])</span>
<span class="cs-line hl-g">        loss += <span class="fn">KL</span>(student_dist, teacher_dist)</span>
<span class="cs-line"></span>
<span class="cs-line hl-c">    <span class="kw">return</span> loss / <span class="fn">len</span>(rollout)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># N sweep results on MATH-500:</span>
<span class="cs-line cmt"># N=25:  62.1%  (below OPD)</span>
<span class="cs-line cmt"># N=50:  64.9%  (beats OPD)</span>
<span class="cs-line hl-p"><span class="cmt"># N=100: 65.9%  (best, default)</span></span>
<span class="cs-line cmt"># N=200: 65.7%  (still beats OPD)</span>
<span class="cs-line cmt"># OPD:   62.4%</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Cost: ~5s/step, 24.1 GB peak GPU memory</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-cascade">
      <pre class="cs-pre">
<span class="cs-line cmt"># Cascading Alignment Effect</span>
<span class="cs-line cmt"># Training window: tokens 0-100</span>
<span class="cs-line cmt"># Measured: KL divergence at each position</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Before ESR training (avg KL):</span>
<span class="cs-line cmt"># pos  0- 50: 0.82  (high — planning tokens)</span>
<span class="cs-line cmt"># pos 50-100: 0.73  (high — still strategic)</span>
<span class="cs-line cmt"># pos 100-500: 0.58  (medium)</span>
<span class="cs-line cmt"># pos 500+:   0.44  (lower — execution)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># After ESR training (trained on [0,100] only):</span>
<span class="cs-line hl-g"><span class="cmt"># pos  0-100:  0.31  (-58% — directly trained)</span></span>
<span class="cs-line hl-c"><span class="cmt"># pos 100-500: 0.38  (-35% — NOT trained!)</span></span>
<span class="cs-line hl-c"><span class="cmt"># pos 500+:    0.29  (-34% — NOT trained!)</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Late positions cascade down because:</span>
<span class="cs-line cmt"># 1. Early tokens encode strategy/framing</span>
<span class="cs-line cmt"># 2. Once strategy is right, execution follows</span>
<span class="cs-line cmt"># 3. "Subliminal learning" (Cloud et al., 2025)</span>
<span class="cs-line hl-p"><span class="cmt">#    early tokens inject global mindset</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Token selection ablation (same N=100):</span>
<span class="cs-line cmt"># ESR (position):   65.85%  ← best</span>
<span class="cs-line cmt"># Top-entropy Hs:   62.70%</span>
<span class="cs-line cmt"># Top-entropy Ht:   63.30%</span>
<span class="cs-line cmt"># Top-RKL:          53.35%  ← worst!</span>
<span class="cs-line cmt"># Top-93% of loss, worst results</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-submode">
      <pre class="cs-pre">
<span class="cs-line cmt"># Sub-mode Commitment Effect</span>
<span class="cs-line cmt"># Why ESR sometimes exceeds teacher</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Reverse KL mode-seeking property:</span>
<span class="cs-line cmt"># KL(student || teacher) penalizes student</span>
<span class="cs-line cmt"># for mass OUTSIDE teacher's support,</span>
<span class="cs-line cmt"># but NOT for concentrating WITHIN it.</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Teacher at a planning token may be bimodal:</span>
<span class="cs-line cmt"># Mode A (dominant): verbose reasoning, p=0.6</span>
<span class="cs-line cmt"># Mode B (better):   concise correct, p=0.4</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Full OPD: averages over late tokens,</span>
<span class="cs-line cmt"># student converges toward mode A (dominant)</span>
<span class="cs-line hl-a"><span class="cmt"># ESR: early window only, student commits</span></span>
<span class="cs-line hl-a"><span class="cmt"># to mode B (concise/better)</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Empirical verification (top-10% KL tokens):</span>
<span class="cs-line hl-p"><span class="cmt"># Teacher's top-2—5 (sub-mode):</span></span>
<span class="cs-line hl-p"><span class="cmt">#   OPD: 44.6% | ESR: 47.4%  (+2.8%)</span></span>
<span class="cs-line hl-c"><span class="cmt"># Teacher's top-1 (dominant mode):</span></span>
<span class="cs-line hl-c"><span class="cmt">#   OPD: 45.7% | ESR: 41.9%  (-3.8%)</span></span>
<span class="cs-line hl-g"><span class="cmt"># Confidence (top-1 prob):</span></span>
<span class="cs-line hl-g"><span class="cmt">#   OPD: 0.77  | ESR: 0.79   (+0.02)</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Response length distribution:</span>
<span class="cs-line cmt"># Teacher median: ~1,150 tokens</span>
<span class="cs-line cmt"># Full OPD median: ~1,530 tokens</span>
<span class="cs-line hl-p"><span class="cmt"># ESR median:      ~380 tokens  (3x shorter!)</span></span>
      </pre>
    </div>


  ['cmt', '# Closed-form KL for diffusion denoising transitions'],
  ['',    ''],
  ['cmt', '# Both student and teacher produce Gaussian one-step transitions:'],
  ['',    '# p_S(x_{t+1} | x_t) = N(µ_S(x_t), σ̄²I)'],
  ['',    '# p_T(x_{t+1} | x_t) = N(µ_T(x_t), σ̄²I)'],
  ['',    ''],
  ['cmt', '# SAME covariance σ̄²I (depends only on noise schedule, not model)'],
  ['hl-p','# → KL reduces to squared mean distance:'],
  ['hl-p','# KL(p_S ‖ p_T) = ‖µ_S − µ_T‖² / 2σ̄²'],
  ['',    ''],
  ['',    'def kl_per_step(student_vel, teacher_vel, x_t, t, dt, noise_level):'],
  ['',    '    # Student mean transition'],
  ['',    '    sigma_sq = noise_level**2 * t / (1 - t)'],
  ['',    '    mu_S = (1 + sigma_sq/(2*t) * dt) * x_t \\'],
  ['',    '         + (1 + sigma_sq*(1-t)/(2*t)) * student_vel * dt'],
  ['',    '    # Teacher mean transition (same formula, frozen velocity)'],
  ['',    '    mu_T = (1 + sigma_sq/(2*t) * dt) * x_t \\'],
  ['',    '         + (1 + sigma_sq*(1-t)/(2*t)) * teacher_vel * dt'],
  ['hl-g','    # Closed-form KL — no Monte Carlo, no score function'],
  ['hl-g','    sigma_bar_sq = sigma_sq * (-dt)'],
  ['hl-g','    return (mu_S - mu_T).pow(2).sum() / (2 * sigma_bar_sq)'],
  ['',    ''],
  ['cmt', '# PPO would add: ∆ⱼ * (εⱼ/σ̄ⱼ) * ∇µS   ← noisy, unbiased'],
  ['cmt', '# Closed-form drops this term entirely → lower variance'],

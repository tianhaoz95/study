// ─── OPD Step navigator ───────────────────────────────────────────────────
let opdStep = 0;
const opdBoxes = document.querySelectorAll('#opd-steps .step-box');
const opdPrev  = document.getElementById('opd-prev');
const opdNext  = document.getElementById('opd-next');
const opdProg  = document.getElementById('opd-prog');
function updateOpdSteps() {
  opdBoxes.forEach((b,i) => {
    b.classList.remove('active','done');
    if (i === opdStep) b.classList.add('active');
    else if (i < opdStep) b.classList.add('done');
  });
  if (opdPrev) opdPrev.disabled = opdStep === 0;
  if (opdNext) opdNext.disabled = opdStep === opdBoxes.length - 1;
  if (opdProg) opdProg.textContent = `Step ${opdStep+1} of ${opdBoxes.length}`;
  opdBoxes.forEach((b,i) => {
    const n = b.querySelector('.step-num');
    if (n) n.textContent = i < opdStep ? '✓' : String(i+1);
  });
}
opdPrev?.addEventListener('click', () => { if (opdStep>0){opdStep--;updateOpdSteps();} });
opdNext?.addEventListener('click', () => { if (opdStep<opdBoxes.length-1){opdStep++;updateOpdSteps();} });
updateOpdSteps();

// ─── Canvas: Gradient Conflict ────────────────────────────────────────────
(function() {
  const canvas = document.getElementById('conflict-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  let W, H;
  function resize() {
    W = canvas.clientWidth; H = canvas.clientHeight;
    canvas.width = W * DPR; canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
    drawConflict(mode);
  }

  let mode = 'joint';

  function arrow(x1, y1, x2, y2, color, label, labelPos) {
    const dx = x2-x1, dy = y2-y1;
    const len = Math.sqrt(dx*dx+dy*dy);
    const ux = dx/len, uy = dy/len;
    ctx.strokeStyle = color; ctx.lineWidth = 2.5;
    ctx.beginPath(); ctx.moveTo(x1,y1); ctx.lineTo(x2,y2); ctx.stroke();
    // arrowhead
    const hs = 10;
    ctx.fillStyle = color;
    ctx.beginPath();
    ctx.moveTo(x2, y2);
    ctx.lineTo(x2 - hs*ux + hs*0.4*uy, y2 - hs*uy - hs*0.4*ux);
    ctx.lineTo(x2 - hs*ux - hs*0.4*uy, y2 - hs*uy + hs*0.4*ux);
    ctx.closePath(); ctx.fill();
    if (label) {
      ctx.fillStyle = color;
      ctx.font = 'bold 11px monospace';
      ctx.fillText(label, labelPos ? labelPos[0] : x2+6, labelPos ? labelPos[1] : y2-6);
    }
  }

  function drawConflict(m) {
    ctx.clearRect(0,0,W,H);
    // background grid
    ctx.strokeStyle = 'rgba(255,255,255,0.04)'; ctx.lineWidth = 1;
    for (let x=0; x<=W; x+=40) { ctx.beginPath(); ctx.moveTo(x,0); ctx.lineTo(x,H); ctx.stroke(); }
    for (let y=0; y<=H; y+=40) { ctx.beginPath(); ctx.moveTo(0,y); ctx.lineTo(W,y); ctx.stroke(); }

    const cx = W * 0.22, cy = H * 0.5;

    if (m === 'joint') {
      // Two conflicting gradient arrows
      arrow(cx, cy, cx+95, cy-80, '#10b981', 'Aesthetic gradient', [cx+98, cy-86]);
      arrow(cx, cy, cx+70, cy+90, '#f59e0b', 'OCR gradient', [cx+73, cy+103]);
      // Net update (average)
      arrow(cx, cy, cx+90, cy+8, '#ef4444', 'Joint update (suboptimal)', [cx+92, cy+4]);
      // Explanation
      ctx.font = '11px monospace'; ctx.fillStyle = 'rgba(100,116,139,0.9)';
      ctx.fillText('Gradients conflict → net update', cx+2, cy-100);
      ctx.fillText('satisfies neither task fully', cx+2, cy-86);
      // origin dot
      ctx.beginPath(); ctx.arc(cx,cy,5,0,Math.PI*2); ctx.fillStyle='rgba(255,255,255,0.3)'; ctx.fill();

    } else if (m === 'cascade') {
      // Timeline: sequential stages with forgetting
      const y1 = H*0.3, y2 = H*0.65;
      const stages = [
        { x: W*0.1, w: W*0.22, label: 'Stage 1: Aesthetic', color: '#ef4444' },
        { x: W*0.36, w: W*0.22, label: 'Stage 2: OCR', color: '#f59e0b' },
        { x: W*0.62, w: W*0.22, label: 'Stage 3: GenEval', color: '#10b981' },
      ];
      stages.forEach((s,i) => {
        ctx.fillStyle = s.color.replace(')', ',0.15)').replace('rgb','rgba');
        ctx.strokeStyle = s.color; ctx.lineWidth = 1.2;
        ctx.beginPath(); ctx.roundRect(s.x, y1-20, s.w, 50, 6); ctx.fill(); ctx.stroke();
        ctx.fillStyle = s.color; ctx.font = 'bold 10px monospace';
        ctx.fillText(s.label, s.x+6, y1+6);
        // connecting arrows
        if (i < stages.length-1) {
          arrow(s.x+s.w, y1+5, stages[i+1].x-2, y1+5, '#334155', '', null);
        }
      });
      // Score curves below
      ctx.font = '10px monospace'; ctx.fillStyle = 'rgba(239,68,68,0.8)';
      ctx.fillText('Aesthetic score', W*0.05, y2-22);
      // Aesthetic: goes up then drops on stage 2+3
      ctx.strokeStyle = '#ef4444'; ctx.lineWidth = 2; ctx.beginPath();
      ctx.moveTo(W*0.1, y2-2);
      ctx.bezierCurveTo(W*0.22, y2-45, W*0.34, y2-45, W*0.38, y2-30);
      ctx.bezierCurveTo(W*0.5, y2-5, W*0.62, y2-2, W*0.86, y2-2); ctx.stroke();
      // OCR: starts low, rises in stage 2, then drops a bit
      ctx.strokeStyle = '#f59e0b'; ctx.lineWidth = 2; ctx.beginPath();
      ctx.moveTo(W*0.1, y2-0);
      ctx.bezierCurveTo(W*0.24, y2-2, W*0.34, y2-2, W*0.38, y2-8);
      ctx.bezierCurveTo(W*0.5, y2-50, W*0.58, y2-48, W*0.62, y2-30);
      ctx.bezierCurveTo(W*0.72, y2-10, W*0.86, y2-12, W*0.86, y2-10); ctx.stroke();
      ctx.fillStyle = 'rgba(245,158,11,0.8)'; ctx.fillText('OCR score', W*0.05, y2+2);
      // Forgetting label
      ctx.fillStyle = '#ef4444'; ctx.font = '10px monospace';
      ctx.fillText('← forgetting', W*0.65, y2-22);

    } else { // opd
      // Teacher icons — cleanly separate
      const teachers = [
        { x: W*0.1, y: H*0.22, color: '#10b981', label: 'GenEval\nTeacher', score: '0.96' },
        { x: W*0.1, y: H*0.5,  color: '#f59e0b', label: 'OCR\nTeacher', score: '0.93' },
        { x: W*0.1, y: H*0.78, color: '#ef4444', label: 'Aes\nTeacher', score: '1.50' },
      ];
      teachers.forEach(t => {
        ctx.fillStyle = t.color.replace(')', ',0.12)').replace('rgb','rgba');
        ctx.strokeStyle = t.color; ctx.lineWidth = 1.2;
        ctx.beginPath(); ctx.roundRect(t.x, t.y-20, 90, 38, 6); ctx.fill(); ctx.stroke();
        ctx.fillStyle = t.color; ctx.font = '10px monospace';
        t.label.split('\n').forEach((l,i) => ctx.fillText(l, t.x+5, t.y-4+i*14));
      });
      // Student rollout in center
      const sx = W*0.45, sy = H*0.5;
      ctx.fillStyle = 'rgba(139,92,246,0.12)';
      ctx.strokeStyle = '#8b5cf6'; ctx.lineWidth = 1.5;
      ctx.beginPath(); ctx.roundRect(sx-52, sy-30, 104, 58, 8); ctx.fill(); ctx.stroke();
      ctx.fillStyle = '#a78bfa'; ctx.font = 'bold 10px monospace'; ctx.textAlign = 'center';
      ctx.fillText('Student θ', sx, sy-10);
      ctx.fillStyle = '#64748b'; ctx.font = '9px monospace';
      ctx.fillText('on-policy rollout', sx, sy+5);
      ctx.fillText('40 denoising steps', sx, sy+18);
      ctx.textAlign = 'left';
      // Arrows from teachers to student
      teachers.forEach(t => {
        const ty = t.y;
        arrow(t.x+90, ty, sx-53, sy, t.color, '', null);
      });
      // Unified output
      ctx.fillStyle = 'rgba(139,92,246,0.12)';
      ctx.strokeStyle = '#8b5cf6'; ctx.lineWidth = 1.5;
      const ox = W*0.75;
      ctx.beginPath(); ctx.roundRect(ox, sy-22, 110, 42, 8); ctx.fill(); ctx.stroke();
      ctx.fillStyle = '#a78bfa'; ctx.font = 'bold 10px monospace'; ctx.textAlign='center';
      ctx.fillText('Unified Model', ox+55, sy);
      ctx.fillStyle = '#10b981'; ctx.font = '10px monospace';
      ctx.fillText('avg 0.929 ✓', ox+55, sy+14);
      ctx.textAlign = 'left';
      arrow(sx+52, sy, ox-2, sy, '#8b5cf6', '', null);
    }
  }

  const btnJoint   = document.getElementById('btn-joint');
  const btnCascade = document.getElementById('btn-cascade');
  const btnOpd     = document.getElementById('btn-opd');

  function setMode(m) {
    mode = m;
    [btnJoint, btnCascade, btnOpd].forEach(b => b.classList.remove('active'));
    if (m==='joint') btnJoint.classList.add('active');
    else if (m==='cascade') btnCascade.classList.add('active');
    else btnOpd.classList.add('active');
    drawConflict(m);
  }
  btnJoint?.addEventListener('click',   () => setMode('joint'));
  btnCascade?.addEventListener('click', () => setMode('cascade'));
  btnOpd?.addEventListener('click',     () => setMode('opd'));

  resize();
  window.addEventListener('resize', resize);
})();

// ─── Canvas: Gaussian KL ─────────────────────────────────────────────────
(function() {
  const canvas = document.getElementById('kl-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  let W, H;
  // Offset of teacher relative to student (in "units")
  let teacherOffset = 0;  // starts at 0 offset for reset
  let targetOffset  = 0;

  function resize() {
    W = canvas.clientWidth; H = canvas.clientHeight;
    canvas.width = W * DPR; canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
    drawKL();
  }

  function gaussian(x, mu, sigma) {
    return Math.exp(-0.5*((x-mu)/sigma)**2) / (sigma * Math.sqrt(2*Math.PI));
  }

  function drawKL() {
    ctx.clearRect(0,0,W,H);
    // Grid
    ctx.strokeStyle = 'rgba(255,255,255,0.04)'; ctx.lineWidth = 1;
    for (let y=0; y<=H; y+=40) { ctx.beginPath(); ctx.moveTo(0,y); ctx.lineTo(W,y); ctx.stroke(); }

    const baseline = H * 0.78;
    const scaleX = W / 6.0;       // x: -3 to +3 in "sigma units"
    const scaleY = H * 0.48;

    function toCanvasX(x) { return W/2 + x * scaleX * 0.7; }
    function toCanvasY(y) { return baseline - y * scaleY; }

    const sigma = 0.8;
    const muS = 0;           // student mean fixed at center
    const muT = 0.9 + teacherOffset * 1.2; // teacher mean moves

    // Draw baseline
    ctx.strokeStyle = 'rgba(255,255,255,0.1)'; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(0, baseline); ctx.lineTo(W, baseline); ctx.stroke();

    // Shaded KL region between curves
    ctx.fillStyle = 'rgba(245,158,11,0.08)';
    ctx.beginPath();
    let first = true;
    for (let xi = -3.5; xi <= 3.5; xi += 0.05) {
      const gS = gaussian(xi, muS, sigma);
      const gT = gaussian(xi, muT, sigma);
      const cy = toCanvasY(Math.max(gS, gT));
      if (first) { ctx.moveTo(toCanvasX(xi), cy); first = false; }
      else ctx.lineTo(toCanvasX(xi), cy);
    }
    for (let xi = 3.5; xi >= -3.5; xi -= 0.05) {
      const gS = gaussian(xi, muS, sigma);
      const gT = gaussian(xi, muT, sigma);
      const cy = toCanvasY(Math.min(gS, gT));
      ctx.lineTo(toCanvasX(xi), cy);
    }
    ctx.closePath(); ctx.fill();

    // Student curve (purple)
    ctx.strokeStyle = '#a78bfa'; ctx.lineWidth = 2.5;
    ctx.beginPath(); first = true;
    for (let xi = -3.5; xi <= 3.5; xi += 0.04) {
      const cy = toCanvasY(gaussian(xi, muS, sigma));
      if (first) { ctx.moveTo(toCanvasX(xi), cy); first = false; }
      else ctx.lineTo(toCanvasX(xi), cy);
    }
    ctx.stroke();

    // Teacher curve (cyan)
    ctx.strokeStyle = '#06b6d4'; ctx.lineWidth = 2.5;
    ctx.beginPath(); first = true;
    for (let xi = -3.5; xi <= 3.5; xi += 0.04) {
      const cy = toCanvasY(gaussian(xi, muT, sigma));
      if (first) { ctx.moveTo(toCanvasX(xi), cy); first = false; }
      else ctx.lineTo(toCanvasX(xi), cy);
    }
    ctx.stroke();

    // Vertical lines at means
    ctx.setLineDash([4,3]);
    ctx.strokeStyle = 'rgba(167,139,250,0.5)'; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(toCanvasX(muS), baseline+5);
    ctx.lineTo(toCanvasX(muS), toCanvasY(gaussian(muS, muS, sigma))-5); ctx.stroke();
    ctx.strokeStyle = 'rgba(6,182,212,0.5)';
    ctx.beginPath(); ctx.moveTo(toCanvasX(muT), baseline+5);
    ctx.lineTo(toCanvasX(muT), toCanvasY(gaussian(muT, muT, sigma))-5); ctx.stroke();
    ctx.setLineDash([]);

    // Distance bracket
    const yBracket = baseline + 18;
    const xS = toCanvasX(muS), xT = toCanvasX(muT);
    ctx.strokeStyle = '#f59e0b'; ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.moveTo(xS, yBracket); ctx.lineTo(xT, yBracket); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(xS, yBracket-4); ctx.lineTo(xS, yBracket+4); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(xT, yBracket-4); ctx.lineTo(xT, yBracket+4); ctx.stroke();

    const kl = (muS - muT)**2 / (2 * sigma**2);
    const mx = (xS + xT) / 2;
    ctx.fillStyle = '#f59e0b'; ctx.font = '11px monospace'; ctx.textAlign = 'center';
    ctx.fillText(`‖µS − µT‖ = ${Math.abs(muS-muT).toFixed(2)}σ`, mx, yBracket+18);
    ctx.fillText(`KL = ${kl.toFixed(3)}`, mx, yBracket+34);
    ctx.textAlign = 'left';

    // Labels
    ctx.fillStyle = '#a78bfa'; ctx.font = 'bold 11px monospace';
    ctx.fillText('µS (student)', toCanvasX(muS)+5, toCanvasY(gaussian(muS,muS,sigma))-8);
    ctx.fillStyle = '#06b6d4';
    const tLabelX = muT > 1 ? toCanvasX(muT)-75 : toCanvasX(muT)+5;
    ctx.fillText('µT (teacher)', tLabelX, toCanvasY(gaussian(muT,muT,sigma))-8);

    // Sigma label
    ctx.fillStyle = 'rgba(100,116,139,0.8)'; ctx.font = '10px monospace';
    ctx.fillText('same σ (covariance) →', W*0.02, H*0.12);
    ctx.fillText('KL has closed form', W*0.02, H*0.12+15);
  }

  let animId = null;
  function animateTo(target) {
    if (animId) cancelAnimationFrame(animId);
    const start = teacherOffset;
    const startT = performance.now();
    const dur = 500;
    function tick(now) {
      const t = Math.min((now - startT)/dur, 1);
      const ease = 1 - (1-t)**3;
      teacherOffset = start + (target - start) * ease;
      drawKL();
      if (t < 1) animId = requestAnimationFrame(tick);
    }
    animId = requestAnimationFrame(tick);
  }

  document.getElementById('kl-close')?.addEventListener('click', () => animateTo(-0.6));
  document.getElementById('kl-far')?.addEventListener('click',   () => animateTo(0.8));
  document.getElementById('kl-reset')?.addEventListener('click', () => animateTo(0));

  resize();
  window.addEventListener('resize', () => { if (animId) cancelAnimationFrame(animId); resize(); });
})();

// ─── Canvas: Noise Level Ablation ─────────────────────────────────────────
(function() {
  const canvas = document.getElementById('noise-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  let W, H;

  // Convergence curves: (x=0..1 training progress, y=normalized score 0..1)
  // Based on paper Figure 6 qualitative shape: ODE fastest, a=0.7 slowest
  function curve07(t) { // SDE a=0.7 — slow ramp
    return 0.72 * (1 - Math.exp(-1.5*t)) + 0.02*t;
  }
  function curve04(t) { // SDE a=0.4 — medium
    return 0.82 * (1 - Math.exp(-2.2*t)) + 0.02*t;
  }
  function curveODE(t) { // ODE a=0 — fast (~5x steps to reach same score)
    return 0.93 * (1 - Math.exp(-6.0*t)) + 0.01*t;
  }

  const curves = [
    { id: 'btn-n07', fn: curve07, color: '#ef4444', label: 'SDE a=0.7', active: false },
    { id: 'btn-n04', fn: curve04, color: '#f59e0b', label: 'SDE a=0.4', active: false },
    { id: 'btn-n00', fn: curveODE, color: '#10b981', label: 'ODE a=0',  active: true  },
  ];

  let highlighted = 'btn-n00';

  function resize() {
    W = canvas.clientWidth; H = canvas.clientHeight;
    canvas.width = W * DPR; canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
    drawNoise();
  }

  function drawNoise() {
    ctx.clearRect(0,0,W,H);
    const pad = { l:52, r:20, t:20, b:42 };
    const gW = W - pad.l - pad.r, gH = H - pad.t - pad.b;

    // Grid
    ctx.strokeStyle = 'rgba(255,255,255,0.05)'; ctx.lineWidth = 1;
    for (let i=0; i<=4; i++) {
      const y = pad.t + gH * (1 - i/4);
      ctx.beginPath(); ctx.moveTo(pad.l, y); ctx.lineTo(W-pad.r, y); ctx.stroke();
      ctx.fillStyle = 'rgba(100,116,139,0.7)'; ctx.font = '9px monospace';
      ctx.textAlign = 'right';
      ctx.fillText((i/4 * 0.93).toFixed(2), pad.l-6, y+3);
    }
    for (let i=0; i<=5; i++) {
      const x = pad.l + gW * i/5;
      ctx.beginPath(); ctx.moveTo(x, pad.t); ctx.lineTo(x, pad.t+gH); ctx.stroke();
    }
    ctx.textAlign = 'left';

    // Axes labels
    ctx.fillStyle = 'rgba(100,116,139,0.8)'; ctx.font = '10px monospace';
    ctx.textAlign = 'center';
    ctx.fillText('Training Progress →', pad.l + gW/2, H-4);
    ctx.save(); ctx.translate(13, pad.t + gH/2); ctx.rotate(-Math.PI/2);
    ctx.fillText('Avg Reward Score', 0, 0); ctx.restore();
    ctx.textAlign = 'left';

    // Draw all curves
    curves.forEach(c => {
      const isActive = c.id === highlighted;
      ctx.globalAlpha = isActive ? 1 : 0.2;
      ctx.strokeStyle = c.color;
      ctx.lineWidth = isActive ? 2.8 : 1.5;
      ctx.beginPath();
      let first = true;
      for (let ti=0; ti<=100; ti++) {
        const t = ti/100;
        const v = c.fn(t);
        const cx = pad.l + gW*t;
        const cy = pad.t + gH*(1-v);
        if (first) { ctx.moveTo(cx,cy); first=false; }
        else ctx.lineTo(cx,cy);
      }
      ctx.stroke();
      // end label
      if (isActive) {
        const endV = c.fn(1.0);
        const endX = pad.l + gW;
        const endY = pad.t + gH*(1-endV);
        ctx.fillStyle = c.color; ctx.font = 'bold 10px monospace';
        ctx.fillText(c.label, endX - 65, endY - 8);
      }
    });
    ctx.globalAlpha = 1;

    // Speedup annotation for ODE
    if (highlighted === 'btn-n00') {
      // Find x where ODE reaches 0.65 vs where a=0.7 reaches 0.65
      const targetScore = 0.65;
      let xODE = 0, x07 = 0;
      for (let ti=0; ti<=100; ti++) {
        if (xODE===0 && curveODE(ti/100) >= targetScore) xODE = ti/100;
        if (x07===0  && curve07(ti/100)  >= targetScore) x07  = ti/100;
      }
      const pODE = pad.l + gW*xODE, p07  = pad.l + gW*x07;
      const yLine = pad.t + gH*(1-targetScore);
      ctx.strokeStyle = 'rgba(255,255,255,0.15)'; ctx.lineWidth = 1; ctx.setLineDash([3,3]);
      ctx.beginPath(); ctx.moveTo(pad.l, yLine); ctx.lineTo(W-pad.r, yLine); ctx.stroke();
      ctx.setLineDash([]);
      // bracket
      ctx.strokeStyle = 'rgba(255,255,255,0.4)'; ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(pODE, yLine-12); ctx.lineTo(p07, yLine-12); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(pODE, yLine-8); ctx.lineTo(pODE, yLine-16); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(p07, yLine-8); ctx.lineTo(p07, yLine-16); ctx.stroke();
      ctx.fillStyle = 'rgba(255,255,255,0.7)'; ctx.font = '10px monospace'; ctx.textAlign='center';
      ctx.fillText('~5× faster', (pODE+p07)/2, yLine-20);
      ctx.textAlign='left';
    }
  }

  curves.forEach(c => {
    document.getElementById(c.id)?.addEventListener('click', () => {
      highlighted = c.id;
      curves.forEach(cc => document.getElementById(cc.id)?.classList.toggle('active', cc.id===c.id));
      drawNoise();
    });
  });

  resize();
  window.addEventListener('resize', resize);
})();

// ─── Animated bar charts ──────────────────────────────────────────────────
const barSections = [
  document.getElementById('s-results'),
  document.getElementById('dist-bars'),
];
barSections.forEach(el => {
  if (!el) return;
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.currentTarget.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          b.style.width = parseFloat(b.dataset.w) + '%';
        });
      }
    });
  }, { threshold: 0.3 }).observe(el);
});
</script>
</BaseLayout>

<span class="cs-line hl-a">    <span class="num">1</span>:  &#123;<span class="str">'rFID'</span>: <span class="num">0.60</span>, <span class="str">'gFID'</span>: <span class="num">1.59</span>&#125;,</span>
<span class="cs-line">    <span class="num">4</span>:  &#123;<span class="str">'rFID'</span>: <span class="num">0.45</span>, <span class="str">'gFID'</span>: <span class="num">1.20</span>&#125;,</span>
<span class="cs-line hl-g">    <span class="num">7</span>:  &#123;<span class="str">'rFID'</span>: <span class="num">0.35</span>, <span class="str">'gFID'</span>: <span class="num">1.06</span>&#125;,  <span class="cmt"># ★</span></span>
<span class="cs-line">    <span class="num">10</span>: &#123;<span class="str">'rFID'</span>: <span class="num">0.25</span>, <span class="str">'gFID'</span>: <span class="num">1.09</span>&#125;,</span>
<span class="cs-line hl-c">    <span class="num">23</span>: &#123;<span class="str">'rFID'</span>: <span class="num">0.18</span>, <span class="str">'gFID'</span>: <span class="num">1.10</span>&#125;,  <span class="cmt"># recon</span></span>
<span class="cs-line">&#125;</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># LP accuracy preserved across K:</span>
<span class="cs-line"><span class="cmt"># K=1: 85.39%  K=7: 85.10%  K=23: 85.24%</span></span>
<span class="cs-line"><span class="cmt"># Understanding performance intact</span></span>
      </pre>
    </div>

    <!-- PANEL: arch -->
    <div class="cs-panel" id="panel-arch">
      <pre class="cs-pre">
<span class="cs-line cmt"># RAEv2 training loop</span>
<span class="cs-line"></span>
<span class="cs-line"><span class="kw">for</span> img, label <span class="kw">in</span> dataloader:</span>
<span class="cs-line"></span>
<span class="cs-line hl-c">  <span class="cmt"># 1. Encode with generalized encoder</span></span>
<span class="cs-line hl-c">  x = gen_encode(img, dinov3, K=<span class="num">7</span>)</span>
<span class="cs-line hl-c">  <span class="cmt"># x ∈ R^&#123;N×d&#125;, no grad on encoder</span></span>
<span class="cs-line"></span>
<span class="cs-line hl-a">  <span class="cmt"># 2. Forward noisy latent through DiT</span></span>
<span class="cs-line hl-a">  t = <span class="fn">sample_timestep</span>()</span>
<span class="cs-line hl-a">  x_t = x + t * noise</span>
<span class="cs-line hl-a">  h_all, h_early = dit(x_t, label)</span>
<span class="cs-line"></span>
<span class="cs-line hl-p">  <span class="cmt"># 3. Two x-predictions in same space</span></span>
<span class="cs-line hl-p">  x_full = head_full(h_all)   <span class="cmt"># strong</span></span>
<span class="cs-line hl-p">  x_repa = head_repa(h_early) <span class="cmt"># weak</span></span>
<span class="cs-line"></span>
<span class="cs-line hl-g">  <span class="cmt"># 4. Losses</span></span>
<span class="cs-line hl-g">  L_diff = mse(x_full, x)     <span class="cmt"># main</span></span>
<span class="cs-line hl-g">  L_repa = mse(x_repa, x)     <span class="cmt"># REPA</span></span>
<span class="cs-line hl-g">  loss = L_diff + λ * L_repa</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Inference: internal guidance</span>
<span class="cs-line">x_guided = x_full + w*(x_full - x_repa)</span>
      </pre>
    </div>

    <!-- PANEL: complementary -->
    <div class="cs-panel" id="panel-complementary">
      <pre class="cs-pre">
<span class="cs-line cmt"># Correlation analysis: 27 encoders</span>
<span class="cs-line"></span>
<span class="cs-line"><span class="cmt"># LP = ImageNet linear probe acc (%)</span></span>
<span class="cs-line"><span class="cmt"># LDS = local distance similarity score</span></span>
<span class="cs-line"><span class="cmt"># r = Pearson correlation with gFID</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># RAE alone (uses LP, ignores LDS)</span>
<span class="cs-line hl-p">r_LP_rae  = <span class="op">-</span><span class="num">0.81</span>   <span class="cmt"># strong ★</span></span>
<span class="cs-line hl-a">r_LDS_rae = <span class="op">-</span><span class="num">0.13</span>   <span class="cmt"># negligible</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># REPA alone (uses LDS, ignores LP)</span>
<span class="cs-line hl-a">r_LP_repa  = <span class="op">+</span><span class="num">0.34</span>  <span class="cmt"># anti-correlated!</span></span>
<span class="cs-line hl-c">r_LDS_repa = <span class="op">-</span><span class="num">0.89</span>  <span class="cmt"># strong ★</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># RAE + REPA (needs both)</span>
<span class="cs-line hl-g">r_avg_both = <span class="op">-</span><span class="num">0.83</span>  <span class="cmt"># avg(LP,LDS) ★</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># DINOv3-L is best because:</span>
<span class="cs-line hl-g">LP_dinov3l  = <span class="num">87.0</span>   <span class="cmt"># best global</span></span>
<span class="cs-line hl-g">LDS_dinov3l = <span class="num">0.42</span>   <span class="cmt"># best spatial</span></span>
<span class="cs-line hl-g">gFID_raev2  = <span class="num">2.61</span>   <span class="cmt"># @ 20ep, best</span></span>
      </pre>
    </div>

    <!-- PANEL: guidance -->
    <div class="cs-panel" id="panel-guidance">
      <pre class="cs-pre">
<span class="cs-line cmt"># Guidance ablation (RAEv2, 80ep)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Option 1: no guidance</span>
<span class="cs-line">gFID_none = <span class="num">1.50</span>   <span class="cmt"># unguided</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Option 2: CFG — fails!</span>
<span class="cs-line hl-a">gFID_cfg  = <span class="num">3.86</span>   <span class="cmt"># worse than none</span></span>
<span class="cs-line hl-a"><span class="cmt"># unconditional is ill-defined in RAE</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Option 3: AutoGuidance (original)</span>
<span class="cs-line hl-p">gFID_ag   = <span class="num">3.31</span>   <span class="cmt"># separate small DiT</span></span>
<span class="cs-line hl-p"><span class="cmt"># but: extra model + extra NFEs</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Option 4: REPA guidance (ours)</span>
<span class="cs-line hl-g">x_guided  = (x_full</span>
<span class="cs-line hl-g">           + w * (x_full - x_repa))</span>
<span class="cs-line hl-g">gFID_repa = <span class="num">1.06</span>   <span class="cmt"># best ★</span></span>
<span class="cs-line hl-g">extra_NFE = <span class="num">0</span>       <span class="cmt"># in same fwd pass</span></span>
<span class="cs-line hl-g">extra_model = <span class="cls">None</span>  <span class="cmt"># not needed</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Why REPA = weak prediction:</span>

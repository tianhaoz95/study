    <!-- lapsum panel -->
    <div class="cs-panel" id="panel-lapsum">
      <pre class="cs-pre">
<span class="cs-line cmt"># LapSum: differentiable top-k</span>
<span class="cs-line cmt"># Struski et al. 2025</span>
<span class="cs-line"></span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">laplace_cdf</span>(r, x, beta=<span class="num">1.0</span>):</span>
<span class="cs-line">    <span class="cmt"># F_Lap(r - x) ∈ [0, 1]</span></span>
<span class="cs-line">    <span class="kw">return</span> <span class="num">0.5</span> * (<span class="num">1</span> + torch.tanh((r - x) / beta))</span>
<span class="cs-line"></span>
<span class="cs-line hl-c"><span class="kw">def</span> <span class="fn">lapsum</span>(x, r):</span>
<span class="cs-line hl-c">    <span class="cmt"># Σ F_Lap(rᵢ - x) — smooth count above x</span></span>
<span class="cs-line hl-c">    <span class="kw">return</span> laplace_cdf(r, x).sum()</span>
<span class="cs-line"></span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">soft_topk</span>(r, k):</span>
<span class="cs-line hl-p">    <span class="cmt"># Find x̃ s.t. lapsum(x̃, r) = k</span></span>
<span class="cs-line hl-p">    <span class="cmt"># Closed-form inverse: O(n), fully diff</span></span>
<span class="cs-line hl-p">    x_tilde = lapsum_inverse(r, k)</span>
<span class="cs-line hl-p">    p_tilde = laplace_cdf(r, x_tilde)</span>
<span class="cs-line hl-p">    <span class="cmt"># p_tilde ∈ [0,1], Σp_tilde = k</span></span>
<span class="cs-line hl-p">    <span class="kw">return</span> p_tilde</span>
<span class="cs-line"></span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">truncate</span>(p, tau):</span>
<span class="cs-line">    <span class="cmt"># T(z) = z · [z &gt; τ]  (shifted ReLU)</span></span>
<span class="cs-line">    <span class="cmt"># Gradient: 1 if z &gt; τ, else 0</span></span>
<span class="cs-line">    mask = (p &gt; tau).float()</span>
<span class="cs-line">    <span class="kw">return</span> p * mask</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># SoftMoE gate:</span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">soft_gate</span>(x, Wg, k, tau):</span>
<span class="cs-line">    r = x @ Wg</span>
<span class="cs-line">    p_tilde = soft_topk(r, k) <span class="cmt"># differentiable</span></span>
<span class="cs-line">    <span class="kw">return</span> truncate(p_tilde, tau)</span>
<span class="cs-line cmt"># ∂G/∂k ≠ 0  → k is now trainable!</span>
      </pre>
    </div>

    <!-- allocation panel -->
    <div class="cs-panel" id="panel-allocation">
      <pre class="cs-pre">
<span class="cs-line cmt"># Learned per-layer allocation</span>
<span class="cs-line cmt"># Budget K = total expert-activations across L layers</span>
<span class="cs-line"></span>
<span class="cs-line"><span class="kw">class</span> <span class="cls">SoftMoE</span>(nn.Module):</span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">__init__</span>(self, L, n, d, K):</span>
<span class="cs-line">        self.L = L    <span class="cmt"># 10 layers</span></span>
<span class="cs-line">        self.K = K    <span class="cmt"># budget (e.g. 20)</span></span>
<span class="cs-line hl-p">        <span class="cmt"># Unconstrained allocation params</span></span>
<span class="cs-line hl-p">        self.eta = nn.Parameter(torch.zeros(L))</span>
<span class="cs-line">        self.layers = nn.ModuleList([</span>
<span class="cs-line">            SoftMoELayer(n, d) <span class="kw">for</span> _ <span class="kw">in</span> range(L)])</span>
<span class="cs-line"></span>
<span class="cs-line hl-c">    <span class="kw">def</span> <span class="fn">compute_k</span>(self):</span>
<span class="cs-line hl-c">        pi = F.softmax(self.eta, dim=<span class="num">0</span>)</span>
<span class="cs-line hl-c">        <span class="cmt"># kl ≥ 1, Σkl = K</span></span>
<span class="cs-line hl-c">        <span class="kw">return</span> pi * (self.K - self.L) + <span class="num">1</span></span>
<span class="cs-line"></span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">forward</span>(self, x):</span>
<span class="cs-line">        k_per_layer = self.compute_k()</span>
<span class="cs-line">        <span class="kw">for</span> l, layer <span class="kw">in</span> <span class="fn">enumerate</span>(self.layers):</span>
<span class="cs-line">            x = layer(x, k=k_per_layer[l])</span>
<span class="cs-line">        <span class="kw">return</span> x</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Converged allocation (K=20, L=10):</span>
<span class="cs-line cmt"># L1:  1.0  L2:  1.0  L3:  1.1</span>
<span class="cs-line cmt"># L4:  1.2  L5:  1.4  L6:  1.5</span>
<span class="cs-line cmt"># L7:  2.0  L8:  3.0  L9:  3.8</span>
<span class="cs-line cmt"># L10: 4.0</span>
<span class="cs-line cmt"># Top 3 layers: 10.8 / 20 = 54%</span>
      </pre>
    </div>

    <!-- token panel -->
    <div class="cs-panel" id="panel-token">
      <pre class="cs-pre">
<span class="cs-line cmt"># Per-token compute adaptation</span>
<span class="cs-line cmt"># Active experts depend on routing score spread</span>

<span class="cs-line hl-g">               <span class="num">0.01</span>, <span class="num">0.01</span>, <span class="num">0.01</span>, <span class="num">0.01</span>]</span>
<span class="cs-line hl-g"><span class="cmt"># Active: 1 expert (cost ≈ 1 MLP pass)</span></span>

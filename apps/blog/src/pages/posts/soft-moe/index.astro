<span class="cs-line hl-c">                 <span class="num">0.14</span>, <span class="num">0.07</span>, <span class="num">0.02</span>, <span class="num">0.01</span>]</span>
<span class="cs-line hl-c"><span class="cmt"># Active: 5 experts (more compute)</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Safety cap: max active ≤ ⌈k·α⌉</span>

// ══════════════════════════════════════════════════════════════════
// CANVAS 1 — Exposure Bias Animation
// ══════════════════════════════════════════════════════════════════
(function () {
  const canvas = document.getElementById('exp-canvas');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  function resize() {
    const W = canvas.clientWidth;
    canvas.width = W * DPR; canvas.height = 210 * DPR;
    canvas.style.height = '210px';
    draw();
  }
  const ctx = canvas.getContext('2d');

  const tokensPrompt   = ['The', 'weather', 'in', 'Paris'];
  const tokensTeacher  = ['is', 'sunny', 'and', 'warm'];
  const tokensStudent  = ['is', 'raining', 'heavily', 'today'];
  const studentOK      = [true, false, false, false];

  let step = 0; // 0..8 inclusive (8 = all shown)
  let animId = null;

  function W() { return canvas.width / DPR; }

  function drawToken(x, y, text, fillColor, borderColor) {
    const R = 20;
    ctx.beginPath(); ctx.arc(x * DPR, y * DPR, R * DPR, 0, Math.PI * 2);
    ctx.fillStyle = fillColor; ctx.fill();
    ctx.strokeStyle = borderColor; ctx.lineWidth = 1.5 * DPR; ctx.stroke();
    const fs = text.length > 5 ? 7.5 : 8.5;
    ctx.font = `bold ${fs * DPR}px 'JetBrains Mono', monospace`;
    ctx.fillStyle = 'rgba(255,255,255,.92)';
    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    ctx.fillText(text, x * DPR, y * DPR);
  }

  function draw() {
    const w = W();
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.scale(1, 1);

    const labelX = 6, rowA = 78, rowB = 158;
    const tokStart = 52, tokSpacing = (w - tokStart - 18) / 8;

    // Row labels
    ctx.font = `bold ${8 * DPR}px 'JetBrains Mono', monospace`;
    ctx.fillStyle = '#94a3b8'; ctx.textAlign = 'left'; ctx.textBaseline = 'middle';
    ctx.fillText('TRAIN', labelX * DPR, rowA * DPR);
    ctx.fillText('INFER', labelX * DPR, rowB * DPR);

    // Prompt / generated separator
    const sepX = tokStart + 4 * tokSpacing - tokSpacing * 0.5;
    ctx.strokeStyle = 'rgba(255,255,255,.09)'; ctx.lineWidth = DPR;
    ctx.setLineDash([4 * DPR, 3 * DPR]);
    ctx.beginPath(); ctx.moveTo(sepX * DPR, 48 * DPR); ctx.lineTo(sepX * DPR, 190 * DPR); ctx.stroke();
    ctx.setLineDash([]);

    ctx.font = `${6.5 * DPR}px 'JetBrains Mono', monospace`;
    ctx.fillStyle = '#475569'; ctx.textAlign = 'center';
    ctx.fillText('← prompt →', (tokStart + 2 * tokSpacing) * DPR, 202 * DPR);
    ctx.fillText('← generated →', (tokStart + 6 * tokSpacing) * DPR, 202 * DPR);

    // Draw tokens
    for (let i = 0; i < 8 && i < step; i++) {
      const ti = i < 4 ? i : i - 4;
      const x = tokStart + i * tokSpacing;
      if (i < 4) {
        // Prompt — both rows, purple
        drawToken(x, rowA, tokensPrompt[i], 'rgba(139,92,246,.7)', '#a78bfa');
        drawToken(x, rowB, tokensPrompt[i], 'rgba(139,92,246,.7)', '#a78bfa');
      } else {
        // Teacher continuation (row A) — gold
        drawToken(x, rowA, tokensTeacher[ti], 'rgba(245,158,11,.7)', '#f59e0b');
        // Student inference (row B)
        const cascaded = ti > 0 && studentOK.slice(0, ti).some(v => !v);
        const wrong = !studentOK[ti] || cascaded;
        const fill = wrong ? 'rgba(239,68,68,.72)' : 'rgba(16,185,129,.72)';
        const border = wrong ? '#ef4444' : '#10b981';
        drawToken(x, rowB, tokensStudent[ti], fill, border);
        // Error arrow between consecutive wrong tokens
        if (wrong && ti > 0 && i > 4) {
          const prevX = tokStart + (i - 1) * tokSpacing;
          ctx.beginPath();
          ctx.arc(x * DPR, (rowB + 28) * DPR, 3 * DPR, 0, Math.PI * 2);
          ctx.fillStyle = '#ef4444'; ctx.fill();
          ctx.strokeStyle = 'rgba(239,68,68,.5)'; ctx.lineWidth = 1.2 * DPR;
          ctx.beginPath(); ctx.moveTo(prevX * DPR, (rowB + 28) * DPR); ctx.lineTo((x - 4) * DPR, (rowB + 28) * DPR); ctx.stroke();
        }
      }
    }

    // Legend
    const lx = w - 130, ly = 8;
    [[  'rgba(139,92,246,.7)', '#a78bfa', 'prompt'],
     [  'rgba(245,158,11,.7)', '#f59e0b', 'teacher (train)'],
     [  'rgba(16,185,129,.7)', '#10b981', 'correct'],
     [  'rgba(239,68,68,.7)',  '#ef4444', 'wrong / cascade'],
    ].forEach(([fill, stroke, label], i) => {
      const cy = (ly + i * 16 + 8);
      ctx.beginPath(); ctx.arc((lx + 6) * DPR, cy * DPR, 5 * DPR, 0, Math.PI * 2);
      ctx.fillStyle = fill; ctx.fill(); ctx.strokeStyle = stroke; ctx.lineWidth = DPR; ctx.stroke();
      ctx.font = `${7 * DPR}px 'JetBrains Mono', monospace`;
      ctx.fillStyle = '#64748b'; ctx.textAlign = 'left'; ctx.textBaseline = 'middle';
      ctx.fillText(label, (lx + 14) * DPR, cy * DPR);
    });
  }

  function playStep() {
    if (step >= 8) { document.getElementById('exp-play').textContent = '▶ Play'; return; }
    step++; draw();
    animId = setTimeout(playStep, step <= 4 ? 380 : 600);
  }

  document.getElementById('exp-play').addEventListener('click', function() {
    if (animId) { clearTimeout(animId); animId = null; this.textContent = '▶ Play'; return; }
    if (step >= 8) { step = 0; draw(); }
    this.textContent = '⏸ Pause';
    playStep();
  });
  document.getElementById('exp-reset').addEventListener('click', () => {
    clearTimeout(animId); animId = null; step = 0; draw();
    document.getElementById('exp-play').textContent = '▶ Play';
  });

  resize();
  window.addEventListener('resize', resize);
})();

// ══════════════════════════════════════════════════════════════════
// CANVAS 2 — Divergence Zoo
// ══════════════════════════════════════════════════════════════════
(function () {
  const canvas = document.getElementById('div-canvas');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  function resize() {
    const W = canvas.clientWidth;
    canvas.width = W * DPR; canvas.height = 200 * DPR;
    canvas.style.height = '200px';
    render();
  }
  const ctx = canvas.getContext('2d');

  function gauss(x, mu, sigma) {
    const d = x - mu; return Math.exp(-(d * d) / (2 * sigma * sigma)) / (sigma * Math.sqrt(2 * Math.PI));
  }

  const teacherFn = x => 0.58 * gauss(x, 0.28, 0.068) + 0.42 * gauss(x, 0.72, 0.058);
  const fklFn     = x => gauss(x, 0.48, 0.195);
  const rklFn     = x => gauss(x, 0.28, 0.052);
  const skewFn    = x => 0.52 * gauss(x, 0.28, 0.082) + 0.48 * gauss(x, 0.72, 0.075);
  const todiFn    = x => 0.56 * gauss(x, 0.28, 0.072) + 0.44 * gauss(x, 0.72, 0.062);

  const objectives = {
    fkl:  { fn: fklFn,  color: '#06b6d4', fill: 'rgba(6,182,212,.22)',   name: 'Forward KL',  desc: 'Mode-covering: student spreads probability across both modes, including low-density regions between them. At extreme, produces generic, hedging responses — "it could be Paris or somewhere in France."' },
    rkl:  { fn: rklFn,  color: '#ef4444', fill: 'rgba(239,68,68,.22)',   name: 'Reverse KL',  desc: 'Mode-seeking: student locks onto the dominant mode ("Paris") and nearly ignores the secondary mode. Produces precise answers but can be overconfident and miss valid alternatives.' },
    skew: { fn: skewFn, color: '#a78bfa', fill: 'rgba(139,92,246,.22)',  name: 'Skew-KL',     desc: 'DistiLLM\'s interpolation (α=0.5): covers both modes reasonably well while avoiding the extreme diffusion of FKL. 4.3× cheaper than pure on-policy training.' },
    todi: { fn: todiFn, color: '#10b981', fill: 'rgba(16,185,129,.22)',  name: 'Per-token (ToDi)', desc: 'Adaptive per-token weighting: FKL for underestimated tokens, RKL for overestimated ones. Closely matches the teacher\'s bimodal structure without imposing a global mode choice. EMNLP 2025 Oral.' },
  };

  let current = 'fkl';
  let prevFn = fklFn, targetFn = fklFn, animT = 1.0, rafId = null;

  function interpFn(x) {
    if (animT >= 1) return targetFn(x);
    return prevFn(x) * (1 - animT) + targetFn(x) * animT;
  }

  function drawCurve(fn, color, fillColor, W, H, pad, scale) {
    const N = 250;
    ctx.beginPath();
    for (let i = 0; i <= N; i++) {
      const t = i / N;
      const px = (pad + t * (W - 2 * pad)) * DPR;
      const py = (H - pad - fn(t) * scale) * DPR;
      i === 0 ? ctx.moveTo(px, py) : ctx.lineTo(px, py);
    }
    ctx.lineTo((pad + (W - 2 * pad)) * DPR, (H - pad) * DPR);
    ctx.lineTo(pad * DPR, (H - pad) * DPR);
    ctx.closePath();
    ctx.fillStyle = fillColor; ctx.fill();
    ctx.beginPath();
    for (let i = 0; i <= N; i++) {
      const t = i / N;
      const px = (pad + t * (W - 2 * pad)) * DPR;
      const py = (H - pad - fn(t) * scale) * DPR;
      i === 0 ? ctx.moveTo(px, py) : ctx.lineTo(px, py);
    }
    ctx.strokeStyle = color; ctx.lineWidth = 2 * DPR; ctx.stroke();
  }

  function render() {
    const W = canvas.width / DPR, H = canvas.height / DPR;
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    const pad = 20, baseY = H - pad;
    const maxT = teacherFn(0.28) * 1.1;
    const scale = (H - pad - 30) / maxT;

    // X-axis
    ctx.strokeStyle = 'rgba(255,255,255,.1)'; ctx.lineWidth = DPR;
    ctx.beginPath(); ctx.moveTo(pad * DPR, baseY * DPR); ctx.lineTo((W - pad) * DPR, baseY * DPR); ctx.stroke();

    // Mode labels
    const modeA = pad + 0.28 * (W - 2 * pad);
    const modeB = pad + 0.72 * (W - 2 * pad);
    ctx.font = `${7 * DPR}px 'JetBrains Mono', monospace`;
    ctx.fillStyle = '#64748b'; ctx.textAlign = 'center';
    ctx.fillText('Mode A', modeA * DPR, (baseY + 12) * DPR);
    ctx.fillText('"Paris"', modeA * DPR, (baseY + 22) * DPR);
    ctx.fillText('Mode B', modeB * DPR, (baseY + 12) * DPR);
    ctx.fillText('"Île-de-France"', modeB * DPR, (baseY + 22) * DPR);

    // Teacher distribution (grey)
    drawCurve(teacherFn, 'rgba(148,163,184,.6)', 'rgba(148,163,184,.12)', W, H, pad, scale);
    ctx.font = `${7 * DPR}px 'JetBrains Mono', monospace`;
    ctx.fillStyle = '#94a3b8'; ctx.textAlign = 'left';
    ctx.fillText('teacher', (pad + 2) * DPR, (30) * DPR);

    // Student distribution (animated)
    const obj = objectives[current];
    drawCurve(interpFn, obj.color, obj.fill, W, H, pad, scale);
    ctx.font = `bold ${7.5 * DPR}px 'JetBrains Mono', monospace`;
    ctx.fillStyle = obj.color; ctx.textAlign = 'right';
    ctx.fillText('student (' + obj.name + ')', (W - pad - 2) * DPR, 30 * DPR);

    if (animT < 1) {
      animT = Math.min(1, animT + 0.055);
      rafId = requestAnimationFrame(render);
    }
  }

  const descEl = document.getElementById('div-desc');
  function selectObj(key) {
    if (key === current) return;
    prevFn = objectives[current].fn; animT = 0; current = key; targetFn = objectives[key].fn;
    descEl.textContent = objectives[key].desc;
    document.querySelectorAll('#div-fkl,#div-rkl,#div-skew,#div-todi').forEach(b => b.classList.remove('active'));
    document.getElementById('div-' + key).classList.add('active');
    if (rafId) cancelAnimationFrame(rafId);
    render();
  }
  descEl.textContent = objectives.fkl.desc;

  document.getElementById('div-fkl').addEventListener('click',  () => selectObj('fkl'));
  document.getElementById('div-rkl').addEventListener('click',  () => selectObj('rkl'));
  document.getElementById('div-skew').addEventListener('click', () => selectObj('skew'));
  document.getElementById('div-todi').addEventListener('click', () => selectObj('todi'));

  resize();
  window.addEventListener('resize', resize);
})();

// ══════════════════════════════════════════════════════════════════
// CANVAS 3 — Pass@k Chart
// ══════════════════════════════════════════════════════════════════
(function () {
  const canvas = document.getElementById('passk-canvas');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  function resize() {
    const W = canvas.clientWidth;
    canvas.width = W * DPR; canvas.height = 240 * DPR;
    canvas.style.height = '240px';
    render();
  }
  const ctx = canvas.getContext('2d');

  const kVals   = [1, 2, 4, 8, 16, 32, 64, 128];
  const rlvrP   = [72, 78, 83, 88, 92, 94, 95, 95.5];
  const baseP   = [55, 63, 71, 79, 86, 91, 94, 95];

  let selectedK = 1;

  function kToX(k, W, padL, padR) {
    const logMin = Math.log2(1), logMax = Math.log2(128);
    return padL + (Math.log2(k) - logMin) / (logMax - logMin) * (W - padL - padR);
  }
  function passToY(p, H, padT, padB, mn=40, mx=100) {
    return H - padB - (p - mn) / (mx - mn) * (H - padT - padB);
  }

  function render() {
    const W = canvas.width / DPR, H = canvas.height / DPR;
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    const padL = 46, padR = 18, padT = 22, padB = 38;
    const mn = 40, mx = 100;

    // Grid lines
    ctx.strokeStyle = 'rgba(255,255,255,.05)'; ctx.lineWidth = DPR;
    [50,60,70,80,90,100].forEach(y => {
      const cy = passToY(y, H, padT, padB, mn, mx);
      ctx.beginPath(); ctx.moveTo(padL * DPR, cy * DPR); ctx.lineTo((W - padR) * DPR, cy * DPR); ctx.stroke();
      ctx.font = `${7 * DPR}px 'JetBrains Mono', monospace`;
      ctx.fillStyle = '#475569'; ctx.textAlign = 'right'; ctx.textBaseline = 'middle';
      ctx.fillText(y + '%', (padL - 4) * DPR, cy * DPR);
    });
    kVals.forEach(k => {
      const cx = kToX(k, W, padL, padR);
      ctx.beginPath(); ctx.moveTo(cx * DPR, padT * DPR); ctx.lineTo(cx * DPR, (H - padB) * DPR); ctx.stroke();
      ctx.font = `${7 * DPR}px 'JetBrains Mono', monospace`;
      ctx.fillStyle = '#475569'; ctx.textAlign = 'center'; ctx.textBaseline = 'top';
      ctx.fillText('k=' + k, cx * DPR, (H - padB + 4) * DPR);
    });

    // Axes
    ctx.strokeStyle = 'rgba(255,255,255,.15)'; ctx.lineWidth = DPR;
    ctx.beginPath(); ctx.moveTo(padL * DPR, padT * DPR); ctx.lineTo(padL * DPR, (H - padB) * DPR); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(padL * DPR, (H - padB) * DPR); ctx.lineTo((W - padR) * DPR, (H - padB) * DPR); ctx.stroke();

    // Axis labels
    ctx.save(); ctx.translate(10 * DPR, (H / 2) * DPR); ctx.rotate(-Math.PI / 2);
    ctx.font = `${7.5 * DPR}px 'JetBrains Mono', monospace`; ctx.fillStyle = '#64748b'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    ctx.fillText('pass@k (%)', 0, 0); ctx.restore();
    ctx.font = `${7.5 * DPR}px 'JetBrains Mono', monospace`; ctx.fillStyle = '#64748b'; ctx.textAlign = 'center';
    ctx.fillText('number of rollouts k  (log scale)', (padL + (W - padL - padR) / 2) * DPR, (H - 6) * DPR);

    function drawLine(data, color) {
      ctx.beginPath();
      data.forEach((p, i) => {
        const cx = kToX(kVals[i], W, padL, padR);
        const cy = passToY(p, H, padT, padB, mn, mx);
        i === 0 ? ctx.moveTo(cx * DPR, cy * DPR) : ctx.lineTo(cx * DPR, cy * DPR);
      });
      ctx.strokeStyle = color; ctx.lineWidth = 2.2 * DPR; ctx.lineJoin = 'round'; ctx.stroke();
      data.forEach((p, i) => {
        const cx = kToX(kVals[i], W, padL, padR);
        const cy = passToY(p, H, padT, padB, mn, mx);
        ctx.beginPath(); ctx.arc(cx * DPR, cy * DPR, 3.5 * DPR, 0, Math.PI * 2);
        ctx.fillStyle = color; ctx.fill();
      });
    }

    drawLine(baseP,  '#06b6d4');
    drawLine(rlvrP,  '#a78bfa');

    // Legend
    ctx.font = `${7.5 * DPR}px 'JetBrains Mono', monospace`; ctx.textBaseline = 'middle';
    [[padL + 10, padT + 10, '#a78bfa', 'RLVR model'],
     [padL + 10, padT + 24, '#06b6d4', 'Base model']].forEach(([x, y, c, label]) => {
      ctx.beginPath(); ctx.moveTo(x * DPR, y * DPR); ctx.lineTo((x + 18) * DPR, y * DPR);
      ctx.strokeStyle = c; ctx.lineWidth = 2 * DPR; ctx.stroke();
      ctx.font = `${7.5 * DPR}px 'JetBrains Mono', monospace`;
      ctx.fillStyle = '#94a3b8'; ctx.textAlign = 'left';
      ctx.fillText(label, (x + 22) * DPR, y * DPR);
    });

    // Selected-k vertical line + callout
    const kIdx = kVals.indexOf(selectedK);
    if (kIdx >= 0) {
      const cx = kToX(selectedK, W, padL, padR);
      ctx.strokeStyle = 'rgba(255,255,255,.2)'; ctx.lineWidth = 1.5 * DPR; ctx.setLineDash([4 * DPR, 3 * DPR]);
      ctx.beginPath(); ctx.moveTo(cx * DPR, padT * DPR); ctx.lineTo(cx * DPR, (H - padB) * DPR); ctx.stroke();
      ctx.setLineDash([]);
      const rv = rlvrP[kIdx], bv = baseP[kIdx];
      const gap = (rv - bv).toFixed(1);
      const boxX = cx + 6, boxY = 60;
      ctx.fillStyle = 'rgba(15,23,42,.85)'; ctx.strokeStyle = 'rgba(255,255,255,.1)'; ctx.lineWidth = DPR;
      ctx.beginPath(); ctx.roundRect(boxX * DPR, boxY * DPR, 98 * DPR, 44 * DPR, 4 * DPR); ctx.fill(); ctx.stroke();
      ctx.font = `bold ${7.5 * DPR}px 'JetBrains Mono', monospace`; ctx.textAlign = 'left';
      ctx.fillStyle = '#a78bfa'; ctx.fillText('RLVR: ' + rv + '%', (boxX + 5) * DPR, (boxY + 12) * DPR);
      ctx.fillStyle = '#06b6d4'; ctx.fillText('Base: ' + bv + '%', (boxX + 5) * DPR, (boxY + 25) * DPR);
      ctx.fillStyle = +gap > 4 ? '#f87171' : '#10b981';
      ctx.fillText('Gap: ' + gap + ' pp', (boxX + 5) * DPR, (boxY + 38) * DPR);
    }
  }

  const pkDescs = {
    1:   'k=1: RLVR wins by 17 pp — this is what motivates RL training. But it only means RL promotes the correct answer to the top of the distribution, not that it created new knowledge.',
    8:   'k=8: gap narrows to 9 pp. The base model is finding correct solutions when given more tries — they were already in the distribution.',
    32:  'k=32: gap is now just 3 pp. The base model\'s latent capability is nearly fully expressed.',
    128: 'k=128: essentially tied at 95% vs 95.5%. RL did not add fundamentally new capabilities — it only re-ranked existing ones. Six RLVR algorithms showed this same pattern (arXiv:2504.13837).',
  };
  const pkDescEl = document.getElementById('pk-desc');
  pkDescEl.textContent = pkDescs[1];

  function selectK(k) {
    selectedK = k;
    [1,8,32,128].forEach(v => document.getElementById('pk-'+v).classList.toggle('active', v === k));
    pkDescEl.textContent = pkDescs[k];
    render();
  }
  [1,8,32,128].forEach(k => document.getElementById('pk-'+k).addEventListener('click', () => selectK(k)));

  resize();
  window.addEventListener('resize', resize);
})();

// ══════════════════════════════════════════════════════════════════
// Animated bar chart (IntersectionObserver)
// ══════════════════════════════════════════════════════════════════
const barsSection = document.getElementById('s-results-bars');
if (barsSection) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          b.style.width = b.dataset.w + '%';
        });
      }
    });
  }, { threshold: 0.2 }).observe(barsSection);
}
</script>

</BaseLayout>

<script>
// ─── TOC + sidebar toggles ───────────────────────────────
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});
const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ─── Code sidebar tab switching ──────────────────────────
const tabMeta = {
  dilemma:  { file: 'mc/core.py',       title: 'The Memory Dilemma' },
  mc:       { file: 'mc/caching.py',    title: 'Memory Caching' },
  variants: { file: 'mc/variants.py',   title: 'Four Variants' },
  spectrum: { file: 'mc/complexity.py', title: 'Complexity Spectrum' },
  niah:     { file: 'mc/niah.py',       title: 'NIAH Results' },
  results:  { file: 'mc/results.py',    title: 'Downstream Results' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ─── IntersectionObserver — sync TOC + sidebar tab ───────
const sectionMap = {
  's-dilemma': 'dilemma',
  's-mc':      'mc',
  's-variants':'variants',
  's-spectrum':'spectrum',
  's-niah':    'niah',
  's-results': 'results',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.25 }).observe(s)
);

// ─── §01 Dilemma canvas ──────────────────────────────────
(function() {
  const canvas = document.getElementById('dilemma-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const W = canvas.clientWidth, H = 220, DPR = window.devicePixelRatio || 1;
  canvas.width = W * DPR; canvas.height = H * DPR; ctx.scale(DPR, DPR);

  let mode = 'rnn'; // rnn | mc | tf

  const TOKENS = ['the','cat','sat','on','a','mat','the','dog','ate','it','far','away','long','ago','now','here'];
  const N = TOKENS.length; // 16 tokens
  const SEG = 4; // 4 segments of 4 tokens each

  function tokenColor(i, alpha) {
    const hues = [270, 200, 140, 30];
    const seg = Math.floor(i / SEG);
    return `hsla(${hues[seg]}, 65%, 65%, ${alpha})`;
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);

    const tW = 36, tH = 20, tGap = 4;
    const rowY = 28;
    const startX = (W - N * (tW + tGap) + tGap) / 2;

    // Draw tokens
    for (let i = 0; i < N; i++) {
      const x = startX + i * (tW + tGap);
      const alpha = mode === 'rnn' ? Math.max(0.15, 1 - i * 0.04) : 1.0; // fade older in rnn mode
      ctx.fillStyle = tokenColor(i, alpha);
      ctx.beginPath();
      ctx.roundRect(x, rowY, tW, tH, 3);
      ctx.fill();
      ctx.fillStyle = `rgba(255,255,255,${alpha * 0.9})`;
      ctx.font = `600 9px var(--ff-mono, monospace)`;
      ctx.textAlign = 'center';
      ctx.fillText(TOKENS[i], x + tW / 2, rowY + 13);
    }

    if (mode === 'rnn') {
      // One single fixed-size memory box
      const mX = W / 2 - 30, mY = 85, mW = 60, mH = 36;
      ctx.fillStyle = 'rgba(139,92,246,0.18)';
      ctx.strokeStyle = 'rgba(139,92,246,0.6)';
      ctx.lineWidth = 1.5;
      ctx.beginPath(); ctx.roundRect(mX, mY, mW, mH, 5); ctx.fill(); ctx.stroke();
      ctx.fillStyle = 'rgba(255,255,255,0.7)';
      ctx.font = '600 9px var(--ff-mono, monospace)';
      ctx.textAlign = 'center';
      ctx.fillText('M  (fixed)', mX + mW/2, mY + 14);
      ctx.font = '8px var(--ff-mono, monospace)';
      ctx.fillStyle = 'rgba(200,150,150,0.8)';
      ctx.fillText('← overwrites past', mX + mW/2, mY + 27);

      // Arrow from last token down to M
      const lastX = startX + (N - 1) * (tW + tGap) + tW / 2;
      ctx.strokeStyle = 'rgba(139,92,246,0.5)';
      ctx.lineWidth = 1.2;
      ctx.setLineDash([3, 3]);
      ctx.beginPath();
      ctx.moveTo(lastX, rowY + tH);
      ctx.lineTo(mX + mW / 2, mY);
      ctx.stroke();
      ctx.setLineDash([]);

      // Query arrow (red X for old token)
      const queryX = startX + 2 * (tW + tGap) + tW / 2;
      ctx.strokeStyle = 'rgba(239,68,68,0.7)';
      ctx.lineWidth = 1.5;
      ctx.beginPath(); ctx.moveTo(queryX, rowY + tH); ctx.lineTo(mX + mW / 2, mY); ctx.stroke();
      ctx.fillStyle = 'rgba(239,68,68,0.85)';
      ctx.font = 'bold 11px sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('✗ lost', mX + mW/2, mY + 56);
      ctx.font = '8px var(--ff-mono,monospace)';
      ctx.fillStyle = 'rgba(200,100,100,0.7)';
      ctx.fillText('query "sat" → approximate', mX + mW/2, mY + 67);

    } else if (mode === 'mc') {
      // 4 cached memory boxes
      const mW = 44, mH = 30, mGap = 12;
      const totalMW = 4 * mW + 3 * mGap;
      const mStartX = (W - totalMW) / 2;
      const mY = 85;

      const segColors = ['rgba(139,92,246,', 'rgba(6,182,212,', 'rgba(16,185,129,', 'rgba(245,158,11,'];

      for (let s = 0; s < 4; s++) {
        const x = mStartX + s * (mW + mGap);
        ctx.fillStyle = segColors[s] + '0.18)';
        ctx.strokeStyle = segColors[s] + '0.7)';
        ctx.lineWidth = 1.5;
        ctx.beginPath(); ctx.roundRect(x, mY, mW, mH, 5); ctx.fill(); ctx.stroke();
        ctx.fillStyle = 'rgba(255,255,255,0.8)';
        ctx.font = '600 8px var(--ff-mono,monospace)';
        ctx.textAlign = 'center';
        ctx.fillText('M' + (s + 1), x + mW/2, mY + 12);
        ctx.font = '7px var(--ff-mono,monospace)';
        ctx.fillStyle = 'rgba(255,255,255,0.5)';
        ctx.fillText('seg ' + (s + 1), x + mW/2, mY + 22);
      }

      // Draw segment separators on token row
      for (let s = 1; s < 4; s++) {
        const sepX = startX + s * SEG * (tW + tGap) - tGap / 2 - 1;
        ctx.strokeStyle = 'rgba(255,255,255,0.15)';
        ctx.lineWidth = 1;
        ctx.setLineDash([2, 2]);
        ctx.beginPath(); ctx.moveTo(sepX, rowY - 2); ctx.lineTo(sepX, rowY + tH + 2); ctx.stroke();
        ctx.setLineDash([]);
      }

      // Query arrows from current token to all cached memories
      const queryTokenIdx = N - 1;
      const qX = startX + queryTokenIdx * (tW + tGap) + tW / 2;
      for (let s = 0; s < 4; s++) {
        const mX = mStartX + s * (mW + mGap) + mW / 2;
        ctx.strokeStyle = segColors[s] + '0.55)';
        ctx.lineWidth = 1.2;
        ctx.beginPath(); ctx.moveTo(qX, rowY + tH); ctx.lineTo(mX, mY); ctx.stroke();
      }

      ctx.fillStyle = 'rgba(16,185,129,0.85)';
      ctx.font = 'bold 10px sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('✓ cached', W/2, mY + 46);
      ctx.font = '8px var(--ff-mono,monospace)';
      ctx.fillStyle = 'rgba(150,200,150,0.7)';
      ctx.fillText('query attends to all 4 segment checkpoints', W/2, mY + 57);

    } else { // tf
      // KV cache grows — all tokens cached
      const kvW = 14, kvH = 18, kvGap = 3;
      const kvY = 88;
      const kvStartX = (W - N * (kvW + kvGap) + kvGap) / 2;

      ctx.fillStyle = 'rgba(100,100,120,0.5)';
      ctx.font = '600 8px var(--ff-mono,monospace)';
      ctx.textAlign = 'center';
      ctx.fillText('KV cache grows with every token — O(L) memory, O(L²) compute', W/2, kvY - 8);

      for (let i = 0; i < N; i++) {
        const x = kvStartX + i * (kvW + kvGap);
        ctx.fillStyle = tokenColor(i, 0.5);
        ctx.beginPath(); ctx.roundRect(x, kvY, kvW, kvH, 2); ctx.fill();
        ctx.fillStyle = 'rgba(255,255,255,0.6)';
        ctx.font = '7px monospace';
        ctx.textAlign = 'center';
        ctx.fillText('k' + i, x + kvW/2, kvY + 12);
      }

      // Growing bracket
      ctx.strokeStyle = 'rgba(200,200,100,0.5)';
      ctx.lineWidth = 1.2;
      ctx.beginPath();
      ctx.moveTo(kvStartX - 4, kvY + kvH + 4);
      ctx.lineTo(kvStartX - 4, kvY + kvH + 12);
      ctx.lineTo(kvStartX + N * (kvW + kvGap) - kvGap, kvY + kvH + 12);
      ctx.lineTo(kvStartX + N * (kvW + kvGap) - kvGap, kvY + kvH + 4);
      ctx.stroke();
      ctx.fillStyle = 'rgba(200,200,100,0.7)';
      ctx.font = '8px var(--ff-mono,monospace)';
      ctx.textAlign = 'center';
      ctx.fillText('O(L) storage, O(L²) attn per step', W/2, kvY + kvH + 26);
    }

    // Legend
    const legends = {rnn: '◆ RNN: 1 fixed memory', mc: '◆ MC: N=4 cached checkpoints', tf: '◆ Transformer: full KV cache'};
    ctx.fillStyle = 'rgba(255,255,255,0.4)';
    ctx.font = '8px var(--ff-mono,monospace)';
    ctx.textAlign = 'left';
    ctx.fillText(legends[mode], 10, H - 8);
  }

  document.getElementById('dilemma-rnn')?.addEventListener('click', () => { mode='rnn'; draw(); });
  document.getElementById('dilemma-mc')?.addEventListener('click', () => { mode='mc'; draw(); });
  document.getElementById('dilemma-tf')?.addEventListener('click', () => { mode='tf'; draw(); });

  draw();
})();

// ─── §02 MC Mechanism canvas ─────────────────────────────
(function() {
  const canvas = document.getElementById('mc-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const W = canvas.clientWidth, H = 230, DPR = window.devicePixelRatio || 1;
  canvas.width = W * DPR; canvas.height = H * DPR; ctx.scale(DPR, DPR);

  let numSegs = 1;

  function drawMC(N) {
    ctx.clearRect(0, 0, W, H);
    const TOTAL = 32;
    const tW = Math.max(12, Math.floor((W - 60) / TOTAL) - 2);
    const tH = 16;
    const rowY = 20;
    const startX = (W - TOTAL * (tW + 2) + 2) / 2;

    const segSize = Math.floor(TOTAL / N);
    const segColors = ['rgba(139,92,246,','rgba(6,182,212,','rgba(16,185,129,','rgba(245,158,11,','rgba(239,68,68,','rgba(168,85,247,','rgba(34,211,238,','rgba(74,222,128,'];

    // Draw tokens
    for (let i = 0; i < TOTAL; i++) {
      const seg = Math.min(Math.floor(i / segSize), N - 1);
      const x = startX + i * (tW + 2);
      ctx.fillStyle = segColors[seg % segColors.length] + '0.55)';
      ctx.beginPath(); ctx.roundRect(x, rowY, tW, tH, 2); ctx.fill();
    }

    // Draw segment dividers + checkpoint diamonds
    const checkpointY = 60;
    for (let s = 0; s < N; s++) {
      const segEnd = Math.min((s + 1) * segSize - 1, TOTAL - 1);
      const cX = startX + segEnd * (tW + 2) + tW / 2;

      // Diamond marker
      const dSize = 8;
      ctx.fillStyle = segColors[s % segColors.length] + '0.85)';
      ctx.beginPath();
      ctx.moveTo(cX, checkpointY - dSize);
      ctx.lineTo(cX + dSize, checkpointY);
      ctx.lineTo(cX, checkpointY + dSize);
      ctx.lineTo(cX - dSize, checkpointY);
      ctx.closePath();
      ctx.fill();

      // Line from last token of segment to diamond
      ctx.strokeStyle = segColors[s % segColors.length] + '0.4)';
      ctx.lineWidth = 1;
      ctx.setLineDash([2, 2]);
      ctx.beginPath();
      ctx.moveTo(cX, rowY + tH);
      ctx.lineTo(cX, checkpointY - dSize);
      ctx.stroke();
      ctx.setLineDash([]);

      // Label
      if (N <= 4) {
        ctx.fillStyle = 'rgba(255,255,255,0.55)';
        ctx.font = '7px var(--ff-mono,monospace)';
        ctx.textAlign = 'center';
        ctx.fillText('M' + (s + 1), cX, checkpointY + dSize + 11);
      }
    }

    // Draw query token (last token) attending to all checkpoints
    const queryX = startX + (TOTAL - 1) * (tW + 2) + tW / 2;
    const queryY = 130;

    // Query node
    ctx.fillStyle = 'rgba(255,255,255,0.15)';
    ctx.strokeStyle = 'rgba(255,255,255,0.6)';
    ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.arc(queryX, queryY, 12, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
    ctx.fillStyle = 'rgba(255,255,255,0.9)';
    ctx.font = 'bold 8px var(--ff-mono,monospace)';
    ctx.textAlign = 'center';
    ctx.fillText('q_t', queryX, queryY + 3);

    // Arrows from query to each checkpoint
    for (let s = 0; s < N; s++) {
      const segEnd = Math.min((s + 1) * segSize - 1, TOTAL - 1);
      const cX = startX + segEnd * (tW + 2) + tW / 2;
      const cY = checkpointY + 8;
      ctx.strokeStyle = segColors[s % segColors.length] + '0.55)';
      ctx.lineWidth = 1.2;
      ctx.beginPath();
      ctx.moveTo(queryX, queryY - 12);
      ctx.lineTo(cX, cY);
      ctx.stroke();
      // arrowhead
      const angle = Math.atan2(cY - (queryY - 12), cX - queryX);
      ctx.fillStyle = segColors[s % segColors.length] + '0.7)';
      ctx.beginPath();
      ctx.moveTo(cX, cY);
      ctx.lineTo(cX - 7*Math.cos(angle-0.4), cY - 7*Math.sin(angle-0.4));
      ctx.lineTo(cX - 7*Math.cos(angle+0.4), cY - 7*Math.sin(angle+0.4));
      ctx.closePath();
      ctx.fill();
    }

    // Output label
    ctx.fillStyle = 'rgba(255,255,255,0.5)';
    ctx.font = '8px var(--ff-mono,monospace)';
    ctx.textAlign = 'center';
    const costText = N === 1 ? 'O(L) — pure RNN' : N === 8 ? 'O(L²/4) — near Attn' : `O(L²/${Math.floor(32/N)}) — N=${N} segments`;
    ctx.fillText(costText, W/2, H - 10);

    // Segment count label
    ctx.fillStyle = 'rgba(255,255,255,0.35)';
    ctx.font = '7px var(--ff-mono,monospace)';
    ctx.textAlign = 'left';
    ctx.fillText(`◆ = cached memory checkpoint (${N} total)`, 8, H - 10);
  }

  document.querySelectorAll('.mc-seg-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.mc-seg-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      numSegs = parseInt(btn.dataset.n);
      drawMC(numSegs);
    });
  });

  drawMC(1);
})();

// ─── §03 Variant step navigator ──────────────────────────
(function() {
  let step = 0;
  const boxes   = document.querySelectorAll('#variant-steps .step-box');
  const prevBtn = document.getElementById('var-prev');
  const nextBtn = document.getElementById('var-next');
  const progEl  = document.getElementById('var-prog');
  function updateSteps() {
    boxes.forEach((b, i) => {
      b.classList.remove('active','done');
      if (i === step) b.classList.add('active');
      else if (i < step) b.classList.add('done');
    });
    if (prevBtn) prevBtn.disabled = step === 0;
    if (nextBtn) nextBtn.disabled = step === boxes.length - 1;
    if (progEl)  progEl.textContent = `Step ${step+1} of ${boxes.length}`;
    boxes.forEach((b, i) => {
      const n = b.querySelector('.step-num');
      if (n) n.textContent = i < step ? '✓' : String(i+1);
    });
  }
  prevBtn?.addEventListener('click', () => { if(step>0){step--;updateSteps();} });
  nextBtn?.addEventListener('click', () => { if(step<boxes.length-1){step++;updateSteps();} });
  updateSteps();
})();

// ─── §04 Complexity spectrum bars ────────────────────────
(function() {
  const container = document.getElementById('spectrum-bars');
  if (!container) return;

  const items = [
    { label: 'Pure RNN (N=1)', pct: 15,  cost: 'O(L)',       color: 'rgba(100,100,140,0.7)' },
    { label: 'MC  seg=512',    pct: 30,  cost: 'O(L²/512)',  color: 'rgba(245,158,11,0.65)' },
    { label: 'MC  seg=256',    pct: 42,  cost: 'O(L²/256)',  color: 'rgba(245,158,11,0.8)'  },
    { label: 'Log-Linear++',   pct: 48,  cost: 'O(L logL)',  color: 'rgba(6,182,212,0.65)'  },
    { label: 'MC  seg=64',     pct: 62,  cost: 'O(L²/64)',   color: 'rgba(139,92,246,0.7)'  },
    { label: 'MC  seg=16',     pct: 78,  cost: 'O(L²/16)',   color: 'rgba(139,92,246,0.85)' },
    { label: 'Transformer',    pct: 100, cost: 'O(L²)',       color: 'rgba(16,185,129,0.65)' },
  ];

  items.forEach(it => {
    const row = document.createElement('div');
    row.className = 'spectrum-row';
    row.innerHTML = `
      <span class="spectrum-label">${it.label}</span>
      <div class="spectrum-bar-wrap">
        <div class="spectrum-fill" style="background:${it.color};width:0%" data-w="${it.pct}">
          recall capacity
        </div>
      </div>
      <span class="spectrum-cost">${it.cost}</span>
    `;
    container.appendChild(row);
  });

  // Animate when in view
  const section = document.getElementById('s-spectrum');
  if (section) {
    new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          container.querySelectorAll('.spectrum-fill[data-w]').forEach(b => {
            b.style.width = b.dataset.w + '%';
          });
        }
      });
    }, { threshold: 0.3 }).observe(section);
  }
})();


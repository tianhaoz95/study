    <div class="cs-panel active" id="panel-dilemma">
      <pre class="cs-pre">
<span class="cs-line cmt"># Linear Attention: one fixed-size matrix M</span>
<span class="cs-line cmt"># — good: O(L) inference</span>
<span class="cs-line cmt"># — bad: must overwrite old associations</span>
<span class="cs-line"></span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">linear_attention_step</span>(M, k_t, v_t, q_t):</span>
<span class="cs-line hl-p">    <span class="cmt"># M is a d×d matrix — the entire past</span></span>
<span class="cs-line">    M = M + v_t @ phi(k_t).T   <span class="cmt"># overwrite!</span></span>
<span class="cs-line">    y_t = M @ phi(q_t)         <span class="cmt"># retrieve</span></span>
<span class="cs-line">    <span class="kw">return</span> M, y_t</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Transformer: full KV cache — growing memory</span>
<span class="cs-line cmt"># — good: perfect recall in principle</span>
<span class="cs-line cmt"># — bad: O(L²) compute, O(L) memory</span>
<span class="cs-line"></span>
<span class="cs-line hl-c"><span class="kw">def</span> <span class="fn">attention_step</span>(keys, vals, q_t):</span>
<span class="cs-line hl-c">    <span class="cmt"># keys, vals grow every step: O(L) storage</span></span>
<span class="cs-line">    scores = softmax(q_t @ keys.T)   <span class="cmt"># O(L)</span></span>
<span class="cs-line">    y_t = scores @ vals</span>
<span class="cs-line">    <span class="kw">return</span> y_t</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># The gap: RNNs forget; Transformers are O(L²)</span>
<span class="cs-line cmt"># MC threads the needle with N checkpoints</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-mc">
      <pre class="cs-pre">
<span class="cs-line cmt"># Memory Caching: segment + cache + attend-to-all</span>
<span class="cs-line"></span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">mc_forward</span>(x, segment_size, recurrent_fn, agg_fn):</span>
<span class="cs-line">    L = len(x)</span>
<span class="cs-line">    cached = []   <span class="cmt"># memory checkpoints</span></span>
<span class="cs-line">    M = init_memory()</span>
<span class="cs-line">    ys = []</span>
<span class="cs-line"></span>
<span class="cs-line hl-c">    <span class="kw">for</span> seg_start <span class="kw">in</span> range(<span class="num">0</span>, L, segment_size):</span>
<span class="cs-line hl-c">        seg = x[seg_start : seg_start + segment_size]</span>
<span class="cs-line"></span>
<span class="cs-line">        <span class="kw">for</span> t, x_t <span class="kw">in</span> enumerate(seg):</span>
<span class="cs-line">            k,v,q = proj(x_t)</span>
<span class="cs-line">            M = recurrent_fn(M, k, v)  <span class="cmt"># update</span></span>
<span class="cs-line hl-g">            <span class="cmt"># attend to cached + online memory</span></span>
<span class="cs-line hl-g">            y_t = agg_fn(cached, M, q)</span>
<span class="cs-line hl-g">            ys.append(y_t)</span>
<span class="cs-line"></span>
<span class="cs-line hl-a">        cached.append(M)  <span class="cmt"># save checkpoint</span></span>
<span class="cs-line hl-a">        M = init_memory()  <span class="cmt"># reset for next seg</span></span>
<span class="cs-line hl-a">        <span class="cmt"># (or continue from M for checkpoint mode)</span></span>
<span class="cs-line"></span>
<span class="cs-line">    <span class="kw">return</span> ys</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-variants">
      <pre class="cs-pre">
<span class="cs-line cmt"># The four MC aggregation strategies</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># 1. Residual Memory — equal-weight sum</span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">residual_agg</span>(cached, M_online, q):</span>
<span class="cs-line">    y = M_online(q)</span>
<span class="cs-line">    <span class="kw">for</span> M_c <span class="kw">in</span> cached:</span>
<span class="cs-line">        y = y + M_c(q)   <span class="cmt"># equal weight</span></span>
<span class="cs-line">    <span class="kw">return</span> y</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># 2. Gated Residual Memory — input-dep gates</span>
<span class="cs-line hl-c"><span class="kw">def</span> <span class="fn">grm_agg</span>(cached, M_online, q, x_t, seg_means):</span>
<span class="cs-line">    u = x_t @ W_u            <span class="cmt"># connector</span></span>
<span class="cs-line">    gates = softmax([</span>
<span class="cs-line">        u @ mean_i           <span class="cmt"># semantic sim</span></span>
<span class="cs-line">        <span class="kw">for</span> mean_i <span class="kw">in</span> seg_means</span>
<span class="cs-line">    ] + [u @ q])             <span class="cmt"># online gate</span></span>
<span class="cs-line">    y = gates[-<span class="num">1</span>] * M_online(q)</span>
<span class="cs-line">    <span class="kw">for</span> i, M_c <span class="kw">in</span> enumerate(cached):</span>
<span class="cs-line">        y = y + gates[i] * M_c(q)</span>
<span class="cs-line">    <span class="kw">return</span> y</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># 3. Memory Soup — interpolate weights</span>
<span class="cs-line hl-g"><span class="kw">def</span> <span class="fn">soup_agg</span>(cached, M_online, q, gates):</span>
<span class="cs-line">    <span class="cmt"># fuse weight tensors, not outputs</span></span>
<span class="cs-line">    theta_star = sum(g * M.theta</span>
<span class="cs-line">                     <span class="kw">for</span> g, M <span class="kw">in</span> zip(gates, cached))</span>
<span class="cs-line">    M_star = Memory(theta_star)</span>
<span class="cs-line">    <span class="kw">return</span> M_star(q)   <span class="cmt"># single fused forward</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># 4. Sparse Selective Caching — top-k routing</span>
<span class="cs-line hl-a"><span class="kw">def</span> <span class="fn">ssc_agg</span>(cached, M_online, q, x_t, seg_means, k):</span>
<span class="cs-line">    scores = [x_t @ W_u @ m <span class="kw">for</span> m <span class="kw">in</span> seg_means]</span>
<span class="cs-line">    top_k = topk_indices(scores, k)   <span class="cmt"># sparse</span></span>
<span class="cs-line">    y = M_online(q)</span>
<span class="cs-line">    <span class="kw">for</span> i <span class="kw">in</span> top_k:</span>
<span class="cs-line">        y = y + gates[i] * cached[i](q)</span>
<span class="cs-line">    <span class="kw">return</span> y   <span class="cmt"># only k cached loads</span></span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-spectrum">
      <pre class="cs-pre">
<span class="cs-line cmt"># Complexity of MC as a function of N</span>
<span class="cs-line cmt"># L = sequence length, C = segment size, N = L/C</span>
<span class="cs-line"></span>
<span class="cs-line hl-p"><span class="cmt"># Pure RNN — N = 1, one segment = whole sequence</span></span>
<span class="cs-line hl-p">complexity_rnn = O(L)   <span class="cmt"># O(L·1)</span></span>
<span class="cs-line"></span>
<span class="cs-line hl-c"><span class="cmt"># MC, constant segment size C</span></span>
<span class="cs-line hl-c">N = L // C</span>
<span class="cs-line hl-c">complexity_mc = O(L + N * L)  <span class="cmt"># = O(L²/C)</span></span>
<span class="cs-line hl-c"><span class="cmt"># at C=256 with L=4096: N=16, much &lt; O(L²)</span></span>
<span class="cs-line"></span>
<span class="cs-line hl-g"><span class="cmt"># Log segmentation (Fenwick-tree style)</span></span>
<span class="cs-line hl-g">N = log2(L)             <span class="cmt"># N grows slowly</span></span>
<span class="cs-line hl-g">complexity_log = O(L * log2(L))</span>
<span class="cs-line hl-g"><span class="cmt"># but first segment covers L/2 tokens — low recall</span></span>
<span class="cs-line"></span>
<span class="cs-line hl-a"><span class="cmt"># Transformer — N = L, segment size = 1</span></span>
<span class="cs-line hl-a">complexity_tf = O(L**<span class="num">2</span>)  <span class="cmt"># each token is cached</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># MC recovers Transformer via GRM with seg_size=1</span>
<span class="cs-line cmt"># and a linear (value-less) memory module.</span>
<span class="cs-line cmt"># This is provably equivalent to gated softmax attn.</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-niah">
      <pre class="cs-pre">
<span class="cs-line cmt"># NIAH results — 760M params, 30B tokens</span>
<span class="cs-line cmt"># context length: 4K / 8K / 16K</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># S-NIAH-1: passkey retrieval</span>
<span class="cs-line hl-p">NIAH1 = &#123;</span>
<span class="cs-line hl-p">    <span class="str">"Transformer"</span>     : (<span class="num">88.6</span>, <span class="num">76.4</span>, <span class="num">79.8</span>),</span>
<span class="cs-line hl-p">    <span class="str">"DLA"</span>             : (<span class="num">96.4</span>, <span class="num">71.2</span>, <span class="num">44.0</span>),</span>
<span class="cs-line hl-p">    <span class="str">"DLA + GRM"</span>       : (<span class="num">100</span>,  <span class="num">100</span>,  <span class="num">82.4</span>),</span>
<span class="cs-line hl-p">    <span class="str">"Titans"</span>          : (<span class="num">100</span>,  <span class="num">100</span>,  <span class="num">100</span> ),</span>
<span class="cs-line hl-p">    <span class="str">"Titans + GRM"</span>    : (<span class="num">100</span>,  <span class="num">100</span>,  <span class="num">100</span> ),</span>

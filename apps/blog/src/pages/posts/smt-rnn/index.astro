<span class="cs-line cmt"># BPTT: unroll the RNN, backprop through time</span>
<span class="cs-line cmt"># credit must traverse O(T) steps</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">bptt_forward</span>(rnn, inputs):</span>
<span class="cs-line">    m = torch.zeros(mem_size)    <span class="cmt"># initial memory</span></span>
<span class="cs-line">    losses = []</span>
<span class="cs-line hl-a">    <span class="kw">for</span> t <span class="kw">in</span> range(T):            <span class="cmt"># sequential loop</span></span>
<span class="cs-line hl-a">        m = rnn(m, inputs[t])    <span class="cmt"># m_t -> m_t+1</span></span>
<span class="cs-line">        y_hat = readout(m)</span>
<span class="cs-line">        losses.append(loss(y_hat, targets[t]))</span>
<span class="cs-line">    total_loss = sum(losses)</span>
<span class="cs-line hl-a">    total_loss.backward()        <span class="cmt"># gradient path: O(T)!</span></span>
<span class="cs-line">    <span class="kw">return</span> total_loss</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># For T=512, gradient of m_0 must propagate</span>
<span class="cs-line cmt"># through 512 Jacobians. If ||J|| &lt; 1: vanish.</span>
<span class="cs-line cmt"># If ||J|| > 1: explode. Either way: broken.</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Gradient magnitude at timestep t:</span>
<span class="cs-line hl-p">dL_dm_t = dL_dm_T * prod(J[T], J[T-1], ..., J[t])</span>
<span class="cs-line cmt"># This product of Jacobians is exponentially</span>
<span class="cs-line cmt"># unstable for large T.</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Empirically: 90% of runs with random init</span>
<span class="cs-line cmt"># either vanish (recency bias) or explode</span>
<span class="cs-line cmt"># (training instability) for T > 32.</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-background">
      <pre class="cs-pre">
<span class="cs-line cmt"># Predictive State: memory as a sufficient</span>
<span class="cs-line cmt"># statistic of the past for the future</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Key insight: the past is a SEQUENCE...</span>
<span class="cs-line cmt"># but sets are easier to process in parallel!</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Original view (sequential):</span>
<span class="cs-line">past = [x0, x1, x2, ..., xt]          <span class="cmt"># a sequence</span></span>
<span class="cs-line">m = rnn.fold(past)                     <span class="cmt"># must be serial</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Reparameterized view (parallel!):</span>
<span class="cs-line hl-c">past = &#123;(x0,0), (x1,1), ..., (xt,t)&#125;  <span class="cmt"># a SET</span></span>
<span class="cs-line hl-c">m = transformer.encode(past)           <span class="cmt"># parallel!</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Adding timestamps makes the function</span>
<span class="cs-line cmt"># permutation-invariant, not causal.</span>
<span class="cs-line cmt"># Transformers natively process sets.</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Predictive state objective:</span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">is_predictive_state</span>(m, future_tokens):</span>
<span class="cs-line">    <span class="cmt"># m must contain all info to predict future</span></span>
<span class="cs-line">    <span class="kw">return</span> decoder(m).predict(future_tokens)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># What gets remembered in a story:</span>
<span class="cs-line">KEEP  = [<span class="str">"Alice"</span>, <span class="str">"runs"</span>, <span class="str">"forest"</span>]  <span class="cmt"># predict future</span></span>
<span class="cs-line">DISCARD = [<span class="str">"blue_dress"</span>, <span class="str">"oak_tree"</span>]   <span class="cmt"># irrelevant</span></span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-method">
      <pre class="cs-pre">
<span class="cs-line cmt"># SMT: 3-component joint training</span>
<span class="cs-line cmt"># E=encoder, D=decoder, f=RNN</span>
<span class="cs-line"> </span>
<span class="cs-line hl-c"><span class="kw">def</span> <span class="fn">smt_step</span>(E, D, f, x, y):</span>
<span class="cs-line hl-c">    <span class="cmt"># Step 1: encoder computes memory LABELS</span></span>
<span class="cs-line hl-c">    <span class="cmt"># in parallel — O(1) sequential ops</span></span>
<span class="cs-line hl-c">    m = [E(x[:t+1]) <span class="kw">for</span> t <span class="kw">in</span> range(T)]  <span class="cmt"># parallel</span></span>
<span class="cs-line"> </span>
<span class="cs-line hl-g">    <span class="cmt"># Step 2: decoder trains E via future-pred</span></span>
<span class="cs-line hl-g">    L_dec = CE(y_future, D(m[t], x[t+1:]))</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p">    <span class="cmt"># Step 3: RNN learns ONE-STEP transition</span></span>
<span class="cs-line hl-p">    <span class="cmt"># m_t -> m_t+1 supervised by encoder</span></span>
<span class="cs-line hl-p">    m_hat = f(m[t], x[t+1])             <span class="cmt"># no unroll</span></span>
<span class="cs-line hl-p">    L_dyn = MSE(m_hat, m[t+1])          <span class="cmt"># O(1) path</span></span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="cmt"># Step 4: prevent memory collapse</span></span>
<span class="cs-line">    L_unif = uniformity_loss(m)</span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="kw">return</span> (lam_dec * L_dec +</span>
<span class="cs-line">            lam_dyn * L_dyn +</span>
<span class="cs-line">            lam_unif * L_unif)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Gradient path length: O(1) for L_dyn</span>
<span class="cs-line cmt"># No Jacobian product — gradient is stable</span>
<span class="cs-line cmt"># regardless of sequence length T.</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Training complexity:</span>
<span class="cs-line cmt"># Memory: O(M + Tc)  (vs O(MT) for BPTT)</span>
<span class="cs-line cmt"># SeqOps: O(1)       (vs O(T) for BPTT)</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-memory">
      <pre class="cs-pre">
<span class="cs-line cmt"># Memory geometry reflects task structure</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># RETRIEVAL TASK: remember one value</span>
<span class="cs-line cmt"># SMT learns ~4 memory clusters:</span>
<span class="cs-line hl-c">states = {</span>
<span class="cs-line hl-c">    <span class="str">"init"</span>:    (0.0, 0.0),   <span class="cmt"># before needle</span></span>
<span class="cs-line hl-c">    <span class="str">"coming"</span>: (-0.5, 0.8),   <span class="cmt"># needle arriving</span></span>
<span class="cs-line hl-c">    <span class="str">"seen=1"</span>: (1.2, 0.3),    <span class="cmt"># needle was 1</span></span>
<span class="cs-line hl-c">    <span class="str">"seen=2"</span>: (-1.2, 0.3),   <span class="cmt"># needle was 2</span></span>
<span class="cs-line hl-c">}</span>
<span class="cs-line cmt"># RNN = simple finite-state machine between clusters</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># STRING COPY TASK: remember full string</span>
<span class="cs-line cmt"># SMT can't alias — builds tree geometry:</span>
<span class="cs-line hl-p">tree = {</span>
<span class="cs-line hl-p">    <span class="str">"1"</span>:  node(1.0, 0.5),</span>
<span class="cs-line hl-p">    <span class="str">"2"</span>:  node(-1.0, 0.5),</span>
<span class="cs-line hl-p">    <span class="str">"11"</span>: node(1.5, -0.5),  <span class="cmt"># branch from "1"</span></span>
<span class="cs-line hl-p">    <span class="str">"12"</span>: node(0.5, -0.5),  <span class="cmt"># branch from "1"</span></span>
<span class="cs-line hl-p">    <span class="str">"21"</span>: node(-0.5, -0.5), <span class="cmt"># branch from "2"</span></span>
<span class="cs-line hl-p">    <span class="str">"22"</span>: node(-1.5, -0.5),</span>
<span class="cs-line hl-p">}</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># The future determines the geometry:</span>
<span class="cs-line cmt"># compress when you can, expand when you must</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-drift">
      <pre class="cs-pre">
<span class="cs-line cmt"># Train-test mismatch after SMT:</span>
<span class="cs-line cmt"># SMT input: encoder memories m_t</span>
<span class="cs-line cmt"># Test input: RNN's own memory m_hat_t</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Drift grows over time:</span>
<span class="cs-line hl-a">delta_t = MSE(m_hat_t, m_t)  <span class="cmt"># ~0 at t=0</span></span>
<span class="cs-line hl-a">                              <span class="cmt"># compounds to delta_T >> 0</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># DAgger fix: expose RNN to its own states</span>
<span class="cs-line hl-c"><span class="kw">def</span> <span class="fn">dmt_step</span>(E, f, x):</span>
<span class="cs-line hl-c">    <span class="cmt"># compute RNN trajectory (with its own states)</span></span>
<span class="cs-line hl-c">    m_hat = [torch.zeros(M)]</span>
<span class="cs-line hl-c">    <span class="kw">for</span> t <span class="kw">in</span> range(T-<span class="num">1</span>):       <span class="cmt"># unrolled (short)</span></span>
<span class="cs-line hl-c">        m_hat.append(f(m_hat[t], x[t+<span class="num">1</span>]))</span>
<span class="cs-line"> </span>
<span class="cs-line hl-g">    <span class="cmt"># compute encoder TARGET trajectory</span></span>
<span class="cs-line hl-g">    m = [E(x[:t+<span class="num">1</span>]) <span class="kw">for</span> t <span class="kw">in</span> range(T)]</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p">    <span class="cmt"># on-policy: learn to correct drift</span></span>
<span class="cs-line hl-p">    L_dmt = MSE(f(m_hat[t], x[t+<span class="num">1</span>]), m[t+<span class="num">1</span>])</span>
<span class="cs-line hl-p">    <span class="cmt"># RNN input: its own state m_hat_t</span></span>
<span class="cs-line hl-p">    <span class="cmt"># RNN target: encoder's state m_t+1</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Freeze E, D. Small LR. Short training.</span>
<span class="cs-line cmt"># Result: RNN learns to self-correct drift.</span>
      </pre>
    </div>


<span class="cs-line hl-c">}</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Length generalization:</span>
<span class="cs-line cmt"># Trained on T=64, tested on T=512:</span>
<span class="cs-line hl-p">Transformer_loss = <span class="num">0.38</span>  <span class="cmt"># fails at T>64</span></span>
<span class="cs-line hl-g">SMT_RNN_loss     = <span class="num">0.12</span>  <span class="cmt"># generalizes!</span></span>
<span class="cs-line cmt"># RNN inductive bias (finite state) beats</span>
<span class="cs-line cmt"># Transformer (in-context lookup) at extrapolation</span>
      </pre>

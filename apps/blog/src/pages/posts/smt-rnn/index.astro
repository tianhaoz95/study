// ══════════════════════════════════════════════════════════
// GRAD CANVAS — gradient magnitude visualization
// ══════════════════════════════════════════════════════════
(function() {
  const canvas = document.getElementById('grad-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;

  function resize() {
    const W = canvas.clientWidth, H = canvas.clientHeight;
    canvas.width = W * DPR;
    canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
    drawGrad();
  }

  function seededRand(n) {
    return ((1664525 * n + 1013904223) & 0x7fffffff) / 0x7fffffff;
  }

  function drawGrad() {
    const W = canvas.clientWidth, H = canvas.clientHeight;
    const seed = parseInt(document.getElementById('grad-seed').value);
    ctx.clearRect(0, 0, W, H);

    // Background
    ctx.fillStyle = 'rgba(13,13,20,.6)';
    ctx.fillRect(0, 0, W, H);

    const T = 32;
    const padL = 50, padR = 20, padT = 20, padB = 40;
    const plotW = W - padL - padR;
    const plotH = H - padT - padB;

    // Grid
    ctx.strokeStyle = 'rgba(255,255,255,.04)';
    ctx.lineWidth = 1;
    for (let i = 0; i <= 4; i++) {
      const y = padT + plotH * i / 4;
      ctx.beginPath(); ctx.moveTo(padL, y); ctx.lineTo(padL + plotW, y); ctx.stroke();
    }

    // Axes
    ctx.strokeStyle = 'rgba(255,255,255,.15)';
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(padL, padT); ctx.lineTo(padL, padT + plotH); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(padL, padT + plotH); ctx.lineTo(padL + plotW, padT + plotH); ctx.stroke();

    // Axis labels
    ctx.fillStyle = '#5c6370';
    ctx.font = `${9 * 1}px var(--ff-mono)`;
    ctx.textAlign = 'center';
    ctx.fillText('timestep t', padL + plotW / 2, H - 6);
    ctx.save();
    ctx.translate(12, padT + plotH / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.fillText('||∂L/∂m_t||', 0, 0);
    ctx.restore();

    // BPTT gradient: multiply Jacobian eigenvalue T times
    // random eigenvalue near 1 based on seed
    const bpttEigenval = 0.65 + seededRand(seed) * 0.7; // 0.65 to 1.35
    const bpttVals = [];
    for (let t = 0; t <= T; t++) {
      const pathLen = T - t;
      bpttVals.push(Math.pow(bpttEigenval, pathLen));
    }

    // Normalize so max visible
    const maxBptt = Math.max(...bpttVals);
    const scale = maxBptt > 0 ? plotH * 0.8 / Math.max(maxBptt, 1) : plotH * 0.8;

    // SMT gradients: all ~1 (O(1) path)
    const smtVal = 0.22;

    // Draw BPTT
    ctx.beginPath();
    ctx.strokeStyle = '#ef4444';
    ctx.lineWidth = 2;
    for (let t = 0; t <= T; t++) {
      const x = padL + (t / T) * plotW;
      const v = bpttVals[t] * scale;
      const y = padT + plotH - Math.min(v, plotH);
      if (t === 0) ctx.moveTo(x, y);
      else ctx.lineTo(x, y);
    }
    ctx.stroke();

    // Draw SMT (flat stable line)
    ctx.beginPath();
    ctx.strokeStyle = '#8b5cf6';
    ctx.lineWidth = 2;
    for (let t = 0; t <= T; t++) {
      const x = padL + (t / T) * plotW;
      const y = padT + plotH - smtVal * plotH;
      if (t === 0) ctx.moveTo(x, y);
      else ctx.lineTo(x, y);
    }
    ctx.stroke();

    // Labels
    ctx.font = `${9 * 1}px var(--ff-mono)`;
    ctx.textAlign = 'left';
    ctx.fillStyle = '#ef4444';
    ctx.fillText('BPTT', padL + plotW * 0.05, padT + 16);
    ctx.fillStyle = '#8b5cf6';
    ctx.fillText('SMT', padL + plotW * 0.05, padT + 30);

    // Annotations
    if (bpttEigenval < 0.9) {
      ctx.fillStyle = 'rgba(239,68,68,.7)';
      ctx.fillText('vanishing →', padL + plotW * 0.6, padT + plotH - 5);
    } else if (bpttEigenval > 1.1) {
      ctx.fillStyle = 'rgba(239,68,68,.7)';
      ctx.fillText('← exploding', padL + plotW * 0.05, padT + 50);
    }
  }

  window.addEventListener('resize', resize);
  document.getElementById('grad-seed').addEventListener('input', drawGrad);
  setTimeout(resize, 50);
})();

// ══════════════════════════════════════════════════════════
// PREDICTIVE STATE CANVAS
// ══════════════════════════════════════════════════════════
(function() {
  const canvas = document.getElementById('ps-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;

  function resize() {
    const W = canvas.clientWidth, H = canvas.clientHeight;
    canvas.width = W * DPR;
    canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
    draw();
  }

  const TOKENS = [
    { label: 'Alice',   x: 0.08, y: 0.35, rel: 0.95, color: '#8b5cf6' },
    { label: 'ran',     x: 0.18, y: 0.55, rel: 0.75, color: '#a78bfa' },
    { label: 'through', x: 0.28, y: 0.65, rel: 0.15, color: '#5c6370' },
    { label: 'the',     x: 0.36, y: 0.50, rel: 0.05, color: '#5c6370' },
    { label: 'dark',    x: 0.44, y: 0.35, rel: 0.40, color: '#06b6d4' },
    { label: 'forest',  x: 0.54, y: 0.55, rel: 0.55, color: '#06b6d4' },
    { label: 'calling', x: 0.64, y: 0.40, rel: 0.80, color: '#a78bfa' },
    { label: 'Bob',     x: 0.74, y: 0.60, rel: 0.95, color: '#8b5cf6' },
    { label: 'who',     x: 0.82, y: 0.45, rel: 0.08, color: '#5c6370' },
    { label: 'waited',  x: 0.91, y: 0.62, rel: 0.65, color: '#a78bfa' },
  ];

  function draw() {
    const W = canvas.clientWidth, H = canvas.clientHeight;
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = 'rgba(13,13,20,.5)';
    ctx.fillRect(0, 0, W, H);

    // Memory bar at bottom
    const barY = H * 0.82;
    const barH = 16;
    ctx.fillStyle = 'rgba(255,255,255,.04)';
    ctx.fillRect(20, barY, W - 40, barH);

    // Label
    ctx.fillStyle = '#5c6370';
    ctx.font = `${8}px var(--ff-mono)`;
    ctx.textAlign = 'left';
    ctx.fillText('memory', 20, barY - 5);
    ctx.fillText('relevance to future', W - 140, barY - 5);

    TOKENS.forEach(tok => {
      const x = tok.x * (W - 40) + 20;
      const y = tok.y * H * 0.72 + 10;

      // Relevance glow
      const alpha = tok.rel * 0.5 + 0.05;
      ctx.shadowColor = tok.color;
      ctx.shadowBlur = tok.rel * 14;
      ctx.fillStyle = tok.color + Math.round(alpha * 255).toString(16).padStart(2, '0');
      ctx.font = `${Math.round(9 + tok.rel * 4)}px var(--ff-mono)`;
      ctx.textAlign = 'center';
      ctx.fillText(tok.label, x, y);
      ctx.shadowBlur = 0;

      // Arrow down to memory bar
      if (tok.rel > 0.3) {
        ctx.strokeStyle = tok.color + '55';
        ctx.lineWidth = 1 + tok.rel;
        ctx.setLineDash([2, 3]);
        ctx.beginPath();
        ctx.moveTo(x, y + 6);
        ctx.lineTo(x, barY);
        ctx.stroke();
        ctx.setLineDash([]);
      }

      // Memory bar segment
      const memW = 30 * tok.rel;
      if (tok.rel > 0.3) {
        ctx.fillStyle = tok.color + '88';
        ctx.fillRect(x - memW / 2, barY, memW, barH);
      }
    });

    ctx.fillStyle = '#5c6370';
    ctx.font = `8px var(--ff-mono)`;
    ctx.textAlign = 'right';
    ctx.fillText('high', W - 20, barY + 11);
    ctx.textAlign = 'left';
    ctx.fillText('low', 25, barY + 11);
  }

  window.addEventListener('resize', resize);
  setTimeout(resize, 50);
})();

// ══════════════════════════════════════════════════════════
// MEMORY SPACE CANVAS
// ══════════════════════════════════════════════════════════
(function() {
  const canvas = document.getElementById('mem-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;

  let currentTask = 'retrieval';

  const TASKS = {
    retrieval: {
      desc: 'Retrieval: memory collapses to ~4 states — init, needle-coming, needle=1, needle=2. RNN learns a finite-state machine.',
      clusters: [
        { label: 'init', x: 0.5, y: 0.5, color: '#8b5cf6', r: 18 },
        { label: 'needle coming', x: 0.5, y: 0.22, color: '#f59e0b', r: 14 },
        { label: 'needle=1', x: 0.28, y: 0.72, color: '#06b6d4', r: 16 },
        { label: 'needle=2', x: 0.72, y: 0.72, color: '#10b981', r: 16 },
      ],
      arrows: [
        { from: 0, to: 1 },
        { from: 1, to: 2 },
        { from: 1, to: 3 },
      ],
      points: 60,
    },
    copy: {
      desc: 'String Copy: memory builds a tree — each branch encodes a different prefix. Lossless compression required.',
      clusters: [
        { label: 'init', x: 0.5, y: 0.12, color: '#8b5cf6', r: 12 },
        { label: '1', x: 0.28, y: 0.38, color: '#06b6d4', r: 12 },
        { label: '2', x: 0.72, y: 0.38, color: '#ef4444', r: 12 },
        { label: '11', x: 0.16, y: 0.65, color: '#06b6d4', r: 10 },
        { label: '12', x: 0.38, y: 0.65, color: '#10b981', r: 10 },
        { label: '21', x: 0.62, y: 0.65, color: '#f59e0b', r: 10 },
        { label: '22', x: 0.84, y: 0.65, color: '#ef4444', r: 10 },
      ],
      arrows: [
        { from: 0, to: 1 }, { from: 0, to: 2 },
        { from: 1, to: 3 }, { from: 1, to: 4 },
        { from: 2, to: 5 }, { from: 2, to: 6 },
      ],
      points: 50,
    },
    tracking: {
      desc: 'State Tracking: complex task requires curved transition fields — memory geometry more intricate than retrieval.',
      clusters: [
        { label: 'state=0', x: 0.5, y: 0.25, color: '#8b5cf6', r: 14 },
        { label: 'state=1', x: 0.75, y: 0.5, color: '#06b6d4', r: 14 },
        { label: 'state=2', x: 0.5, y: 0.75, color: '#10b981', r: 14 },
        { label: 'state=3', x: 0.25, y: 0.5, color: '#f59e0b', r: 14 },
      ],
      arrows: [
        { from: 0, to: 1 }, { from: 1, to: 2 },
        { from: 2, to: 3 }, { from: 3, to: 0 },
      ],
      points: 55,
    },
  };

  function seededRand(n) {
    return ((1664525 * n + 1013904223) & 0x7fffffff) / 0x7fffffff;
  }

  function resize() {
    const W = canvas.clientWidth, H = canvas.clientHeight;
    canvas.width = W * DPR;
    canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
    draw();
  }

  function draw() {
    const W = canvas.clientWidth, H = canvas.clientHeight;
    const task = TASKS[currentTask];
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = 'rgba(13,13,20,.6)';
    ctx.fillRect(0, 0, W, H);

    const pad = 30;
    const pw = W - pad * 2, ph = H - pad * 2;

    // Draw transition arrows between cluster centers
    task.arrows.forEach(arr => {
      const a = task.clusters[arr.from];
      const b = task.clusters[arr.to];
      const ax = pad + a.x * pw, ay = pad + a.y * ph;
      const bx = pad + b.x * pw, by = pad + b.y * ph;
      const dx = bx - ax, dy = by - ay;
      const len = Math.sqrt(dx * dx + dy * dy);
      const ux = dx / len, uy = dy / len;
      const startX = ax + ux * (a.r + 4);
      const startY = ay + uy * (a.r + 4);
      const endX = bx - ux * (b.r + 8);
      const endY = by - uy * (b.r + 8);

      ctx.strokeStyle = 'rgba(255,255,255,.18)';
      ctx.lineWidth = 1.5;
      ctx.setLineDash([4, 3]);
      ctx.beginPath();
      ctx.moveTo(startX, startY);
      ctx.lineTo(endX, endY);
      ctx.stroke();
      ctx.setLineDash([]);

      // Arrow head
      const angle = Math.atan2(endY - startY, endX - startX);
      ctx.fillStyle = 'rgba(255,255,255,.18)';
      ctx.beginPath();
      ctx.moveTo(endX, endY);
      ctx.lineTo(endX - 8 * Math.cos(angle - 0.4), endY - 8 * Math.sin(angle - 0.4));
      ctx.lineTo(endX - 8 * Math.cos(angle + 0.4), endY - 8 * Math.sin(angle + 0.4));
      ctx.closePath();
      ctx.fill();
    });

    // Draw scattered encoder memory points around each cluster
    task.clusters.forEach((cl, ci) => {
      const cx = pad + cl.x * pw, cy = pad + cl.y * ph;
      const npts = Math.floor(task.points / task.clusters.length);
      for (let i = 0; i < npts; i++) {
        const angle = seededRand(ci * 100 + i * 3) * Math.PI * 2;
        const r = seededRand(ci * 100 + i * 3 + 1) * cl.r * 1.2;
        const px2 = cx + Math.cos(angle) * r;
        const py2 = cy + Math.sin(angle) * r;
        ctx.beginPath();
        ctx.arc(px2, py2, 2.5, 0, Math.PI * 2);
        ctx.fillStyle = cl.color + 'bb';
        ctx.fill();
      }
    });

    // Draw cluster labels + circles
    task.clusters.forEach(cl => {
      const cx = pad + cl.x * pw, cy = pad + cl.y * ph;
      ctx.beginPath();
      ctx.arc(cx, cy, cl.r, 0, Math.PI * 2);
      ctx.strokeStyle = cl.color + 'aa';
      ctx.lineWidth = 2;
      ctx.stroke();
      ctx.fillStyle = cl.color + '22';
      ctx.fill();

      ctx.fillStyle = cl.color;
      ctx.font = `bold 9px var(--ff-mono)`;
      ctx.textAlign = 'center';
      ctx.fillText(cl.label, cx, cy + 3);
    });

    // Axis labels
    ctx.fillStyle = '#5c6370';
    ctx.font = `8px var(--ff-mono)`;
    ctx.textAlign = 'center';
    ctx.fillText('memory axis 1 →', W / 2, H - 6);
    ctx.save();
    ctx.translate(10, H / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.fillText('memory axis 2 →', 0, 0);
    ctx.restore();
  }

  document.querySelectorAll('.mem-task-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.mem-task-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentTask = btn.dataset.task;
      document.getElementById('mem-desc').textContent = TASKS[currentTask].desc;
      draw();
    });
  });

  window.addEventListener('resize', resize);
  setTimeout(resize, 50);
})();

// ══════════════════════════════════════════════════════════
// DRIFT CANVAS — animated trajectory comparison
// ══════════════════════════════════════════════════════════
(function() {
  const canvas = document.getElementById('drift-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const playBtn = document.getElementById('drift-play');
  const resetBtn = document.getElementById('drift-reset');
  const tLabel = document.getElementById('drift-t');

  let T_MAX = 60;
  let t = 0;
  let animId = null;
  let playing = false;

  function seededRand(n) {
    return ((1664525 * n + 1013904223) & 0x7fffffff) / 0x7fffffff;
  }

  // Pre-generate trajectory points
  function genTrajectories() {
    const encoder = [];
    const smtRnn  = [];
    const dmtRnn  = [];
    // encoder: smooth path
    let ex = 0.5, ey = 0.5;
    for (let i = 0; i <= T_MAX; i++) {
      const theta = (i / T_MAX) * Math.PI * 3 + 0.5;
      const spiral = 0.15 + i / T_MAX * 0.25;
      ex = 0.5 + Math.cos(theta) * spiral;
      ey = 0.5 + Math.sin(theta) * spiral * 0.7;
      encoder.push({ x: ex, y: ey });
    }
    // SMT RNN: starts aligned, drifts with error accumulation
    let sx = encoder[0].x, sy = encoder[0].y;
    let driftX = 0, driftY = 0;
    for (let i = 0; i <= T_MAX; i++) {
      smtRnn.push({ x: sx, y: sy });
      if (i < T_MAX) {
        const noise = 0.008;
        driftX += (seededRand(i * 7 + 1) - 0.5) * noise;
        driftY += (seededRand(i * 7 + 2) - 0.5) * noise;
        const target = encoder[i + 1];
        sx = target.x + driftX;
        sy = target.y + driftY;
      }
    }
    // DMT RNN: stays close, small bounded error
    let dx = encoder[0].x, dy = encoder[0].y;
    for (let i = 0; i <= T_MAX; i++) {
      dmtRnn.push({ x: dx, y: dy });
      if (i < T_MAX) {
        const noise = 0.002;
        const target = encoder[i + 1];
        dx = target.x + (seededRand(i * 13 + 3) - 0.5) * noise;
        dy = target.y + (seededRand(i * 13 + 4) - 0.5) * noise;
      }
    }
    return { encoder, smtRnn, dmtRnn };
  }

  const traj = genTrajectories();

  function resize() {
    const W = canvas.clientWidth, H = canvas.clientHeight;
    canvas.width = W * DPR;
    canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
    draw();
  }

  function mapPt(p, W, H) {
    const pad = 30;
    return {
      x: pad + p.x * (W - pad * 2),
      y: pad + p.y * (H - pad * 2),
    };
  }

  function draw() {
    const W = canvas.clientWidth, H = canvas.clientHeight;
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = 'rgba(13,13,20,.6)';
    ctx.fillRect(0, 0, W, H);

    const drawUpTo = Math.min(t, T_MAX);

    function drawPath(pts, color, alpha) {
      if (drawUpTo < 1) return;
      ctx.beginPath();
      const p0 = mapPt(pts[0], W, H);
      ctx.moveTo(p0.x, p0.y);
      for (let i = 1; i <= drawUpTo; i++) {
        const p = mapPt(pts[i], W, H);
        ctx.lineTo(p.x, p.y);
      }
      ctx.strokeStyle = color + Math.round(alpha * 255).toString(16).padStart(2, '0');
      ctx.lineWidth = 2;
      ctx.stroke();

      // Current dot
      const last = mapPt(pts[drawUpTo], W, H);
      ctx.beginPath();
      ctx.arc(last.x, last.y, 5, 0, Math.PI * 2);
      ctx.fillStyle = color;
      ctx.shadowColor = color;
      ctx.shadowBlur = 10;
      ctx.fill();
      ctx.shadowBlur = 0;
    }

    drawPath(traj.encoder, '#06b6d4', 0.9);
    drawPath(traj.smtRnn, '#ef4444', 0.85);
    drawPath(traj.dmtRnn, '#10b981', 0.85);

    // Show divergence line at current t
    if (drawUpTo > 5) {
      const enc = mapPt(traj.encoder[drawUpTo], W, H);
      const smt = mapPt(traj.smtRnn[drawUpTo], W, H);
      ctx.strokeStyle = 'rgba(239,68,68,.3)';
      ctx.lineWidth = 1;
      ctx.setLineDash([2, 3]);
      ctx.beginPath();
      ctx.moveTo(enc.x, enc.y);
      ctx.lineTo(smt.x, smt.y);
      ctx.stroke();
      ctx.setLineDash([]);

      // Drift label
      const midX = (enc.x + smt.x) / 2 + 5;
      const midY = (enc.y + smt.y) / 2;
      ctx.fillStyle = 'rgba(239,68,68,.7)';
      ctx.font = `8px var(--ff-mono)`;
      ctx.textAlign = 'left';
      ctx.fillText('δ (drift)', midX, midY);
    }

    // t label
    tLabel.textContent = 't = ' + drawUpTo;
  }

  function step() {
    if (t >= T_MAX) {
      playing = false;
      playBtn.textContent = '▶ Play';
      return;
    }
    t += 1;
    draw();
    if (playing) animId = requestAnimationFrame(() => setTimeout(step, 30));
  }

  playBtn?.addEventListener('click', () => {
    if (t >= T_MAX) { t = 0; }
    playing = !playing;
    playBtn.textContent = playing ? '⏸ Pause' : '▶ Play';
    if (playing) step();
    else { if (animId) cancelAnimationFrame(animId); }
  });
  resetBtn?.addEventListener('click', () => {
    playing = false;
    if (animId) cancelAnimationFrame(animId);
    playBtn.textContent = '▶ Play';
    t = 0;
    draw();
  });

  window.addEventListener('resize', resize);
  setTimeout(resize, 50);
})();

// ══════════════════════════════════════════════════════════
// RESULTS BARS — animated on scroll
// ══════════════════════════════════════════════════════════
const synthSection = document.getElementById('s-results');
if (synthSection) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          b.style.width = b.dataset.w + '%';
        });
      }
    });
  }, { threshold: 0.3 }).observe(synthSection);
}
</script>

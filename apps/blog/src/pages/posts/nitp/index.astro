<script>
/* ── TOC + sidebar toggles ─────────────────────────────────────────────── */
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});

const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

/* ── Sidebar tab switching ─────────────────────────────────────────────── */
const tabMeta = {
  collapse:  { file: 'nitp/metrics.py',  title: 'The Collapse Problem'   },
  blindspot: { file: 'nitp/theory.py',   title: 'Gradient Blind Spot'    },
  arch:      { file: 'nitp/model.py',    title: 'NITP Architecture'      },
  anchors:   { file: 'nitp/ablation.py', title: 'Shallow Anchors'        },
  shift:     { file: 'nitp/ablation.py', title: 'Temporal Shift'         },
  results:   { file: 'nitp/results.py',  title: 'Results'                },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent  = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

/* ── IntersectionObserver: sync TOC + sidebar on scroll ───────────────── */
const sectionMap = {
  's-collapse':  'collapse',
  's-blindspot': 'blindspot',
  's-arch':      'arch',
  's-anchors':   'anchors',
  's-shift':     'shift',
  's-results':   'results',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

/* ═══════════════════════════════════════════════════════════════════════
   §01 — COLLAPSE CANVAS
   ═════════════════════════════════════════════════════════════════════ */
(function() {
  const canvas = document.getElementById('canvas-collapse');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;

  function resize() {
    const W = canvas.clientWidth, H = canvas.clientHeight;
    canvas.width  = W * DPR;
    canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
    return { W, H };
  }
  let { W, H } = resize();

  // Token groups: [label, color, clusterX, clusterY, ntpX, ntpY]
  const tokens = [
    { label: 'cat',       color: '#06b6d4', gx: 0.18, gy: 0.35 },
    { label: 'dog',       color: '#06b6d4', gx: 0.22, gy: 0.55 },
    { label: 'Paris',     color: '#10b981', gx: 0.78, gy: 0.25 },
    { label: 'Rome',      color: '#10b981', gx: 0.82, gy: 0.42 },
    { label: 'run',       color: '#8b5cf6', gx: 0.78, gy: 0.70 },
    { label: 'think',     color: '#8b5cf6', gx: 0.72, gy: 0.82 },
    { label: 'love',      color: '#f59e0b', gx: 0.22, gy: 0.72 },
    { label: 'truth',     color: '#f59e0b', gx: 0.18, gy: 0.88 },
  ];

  // NTP collapsed positions (tight cluster near center)
  const ntpTargets = [
    { x: 0.47, y: 0.43 },
    { x: 0.52, y: 0.48 },
    { x: 0.50, y: 0.52 },
    { x: 0.46, y: 0.57 },
    { x: 0.55, y: 0.44 },
    { x: 0.53, y: 0.56 },
    { x: 0.48, y: 0.61 },
    { x: 0.51, y: 0.39 },
  ];

  // NITP cluster positions (semantic clusters well-separated)
  const nitpTargets = tokens.map(t => ({ x: t.gx, y: t.gy }));

  // Current positions (start at NITP positions)
  let dots = tokens.map((t, i) => ({
    ...t,
    x: nitpTargets[i].x,
    y: nitpTargets[i].y,
    tx: nitpTargets[i].x,
    ty: nitpTargets[i].y,
  }));

  let animating = false;
  let rankVal = 45;
  let rankTarget = 45;
  let mode = 'nitp';
  let animFrame = null;

  function lerp(a, b, t) { return a + (b - a) * t; }

  function draw() {
    const W = canvas.clientWidth, H = canvas.clientHeight;

    ctx.clearRect(0, 0, W, H);

    // Background grid
    ctx.strokeStyle = 'rgba(255,255,255,0.04)';
    ctx.lineWidth = 1;
    for (let i = 0; i <= 4; i++) {
      const x = W * i / 4, y = H * i / 4;
      ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, H); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(W, y); ctx.stroke();
    }

    // Cluster region labels
    if (mode === 'nitp') {
      const labels = [
        { x: 0.20, y: 0.16, text: 'ANIMALS', color: 'rgba(6,182,212,0.3)' },
        { x: 0.80, y: 0.14, text: 'PLACES',  color: 'rgba(16,185,129,0.3)' },
        { x: 0.75, y: 0.60, text: 'VERBS',   color: 'rgba(139,92,246,0.3)' },
        { x: 0.20, y: 0.62, text: 'CONCEPTS',color: 'rgba(245,158,11,0.3)' },
      ];
      ctx.font = `${Math.round(W * 0.024)}px var(--ff-mono, monospace)`;
      ctx.textAlign = 'center';
      labels.forEach(l => {
        ctx.fillStyle = l.color;
        ctx.fillText(l.text, l.x * W, l.y * H);
      });
    } else {
      // NTP: draw convergence label
      ctx.font = `${Math.round(W * 0.024)}px var(--ff-mono, monospace)`;
      ctx.textAlign = 'center';
      ctx.fillStyle = 'rgba(248,113,113,0.4)';
      ctx.fillText('COLLAPSED', 0.5 * W, 0.28 * H);

      // Draw collapse zone circle
      ctx.beginPath();
      ctx.arc(0.5 * W, 0.5 * H, W * 0.14, 0, Math.PI * 2);
      ctx.strokeStyle = 'rgba(248,113,113,0.12)';
      ctx.lineWidth = 1;
      ctx.stroke();
      ctx.fillStyle = 'rgba(248,113,113,0.04)';
      ctx.fill();
    }

    // Draw dots
    dots.forEach(d => {
      const px = d.x * W, py = d.y * H;

      // Glow
      const grad = ctx.createRadialGradient(px, py, 0, px, py, 12);
      grad.addColorStop(0, d.color + '55');
      grad.addColorStop(1, d.color + '00');
      ctx.beginPath();
      ctx.arc(px, py, 12, 0, Math.PI * 2);
      ctx.fillStyle = grad;
      ctx.fill();

      // Dot
      ctx.beginPath();
      ctx.arc(px, py, 6, 0, Math.PI * 2);
      ctx.fillStyle = d.color;
      ctx.fill();

      // Label
      ctx.font = `600 ${Math.round(W * 0.022)}px var(--ff-mono, monospace)`;
      ctx.textAlign = 'center';
      ctx.fillStyle = d.color;
      ctx.fillText(d.label, px, py - 11);
    });
  }

  function animate() {
    let allDone = true;
    dots.forEach(d => {
      d.x = lerp(d.x, d.tx, 0.07);
      d.y = lerp(d.y, d.ty, 0.07);
      if (Math.abs(d.x - d.tx) > 0.001 || Math.abs(d.y - d.ty) > 0.001) allDone = false;
    });
    rankVal = lerp(rankVal, rankTarget, 0.05);
    const rkDisp = document.getElementById('rank-display');
    if (rkDisp) rkDisp.textContent = `effective rank: ${Math.round(rankVal)}`;
    draw();
    if (!allDone) animFrame = requestAnimationFrame(animate);
    else animating = false;
  }

  function startAnimation(targets, rankTgt, m) {
    if (animFrame) cancelAnimationFrame(animFrame);
    mode = m;
    dots.forEach((d, i) => { d.tx = targets[i].x; d.ty = targets[i].y; });
    rankTarget = rankTgt;
    animating = true;
    animate();
  }

  document.getElementById('btn-ntp')?.addEventListener('click', () => {
    startAnimation(ntpTargets, 8, 'ntp');
  });
  document.getElementById('btn-nitp')?.addEventListener('click', () => {
    startAnimation(nitpTargets, 43, 'nitp');
  });
  document.getElementById('btn-reset-collapse')?.addEventListener('click', () => {
    if (animFrame) cancelAnimationFrame(animFrame);
    mode = 'nitp';
    rankVal = 45; rankTarget = 45;
    dots.forEach((d, i) => {
      d.x = nitpTargets[i].x; d.y = nitpTargets[i].y;
      d.tx = nitpTargets[i].x; d.ty = nitpTargets[i].y;
    });
    const rkDisp = document.getElementById('rank-display');
    if (rkDisp) rkDisp.textContent = 'effective rank: —';
    draw();
  });

  window.addEventListener('resize', () => { resize(); W = canvas.clientWidth; draw(); });
  draw();
})();

/* ═══════════════════════════════════════════════════════════════════════
   §02 — DRIFT CANVAS (Null Space)
   ═════════════════════════════════════════════════════════════════════ */
(function() {
  const canvas = document.getElementById('canvas-drift');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;

  function resize() {
    const W = canvas.clientWidth, H = canvas.clientHeight;
    canvas.width = W * DPR; canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
  }
  resize();

  // Seeded simple PRNG
  let seed = 42;
  function rand() { seed = (seed * 9301 + 49297) % 233280; return seed / 233280; }

  let drift = false;
  let anchor = false;
  let dotX = 0, dotY = 0;
  let driftVx = 0.4, driftVy = 0.15;
  let animFrame = null;
  let dotTrail = [];
  let anchorDots = [];

  function drawScene() {
    const W = canvas.clientWidth, H = canvas.clientHeight;
    ctx.clearRect(0, 0, W, H);
    const cx = W * 0.5, cy = H * 0.5;
    const R = Math.min(W, H) * 0.38;

    // Null space shaded region (almost the whole circle)
    ctx.beginPath();
    ctx.arc(cx, cy, R, 0, Math.PI * 2);
    ctx.fillStyle = 'rgba(248,113,113,0.07)';
    ctx.fill();
    ctx.strokeStyle = 'rgba(248,113,113,0.2)';
    ctx.lineWidth = 1;
    ctx.stroke();

    // Null space label
    ctx.font = `600 ${Math.round(R * 0.16)}px var(--ff-mono, monospace)`;
    ctx.textAlign = 'center';
    ctx.fillStyle = 'rgba(248,113,113,0.4)';
    ctx.fillText('NULL SPACE', cx - R * 0.15, cy - R * 0.4);
    ctx.font = `${Math.round(R * 0.11)}px var(--ff-mono, monospace)`;
    ctx.fillStyle = 'rgba(248,113,113,0.3)';
    ctx.fillText('(d−1 unconstrained dimensions)', cx - R * 0.1, cy - R * 0.26);

    // Constrained direction (arrow to the right)
    const arrowLen = R * 0.75;
    ctx.beginPath();
    ctx.moveTo(cx, cy);
    ctx.lineTo(cx + arrowLen, cy);
    ctx.strokeStyle = '#10b981';
    ctx.lineWidth = 2.5;
    ctx.stroke();
    // Arrowhead
    ctx.beginPath();
    ctx.moveTo(cx + arrowLen, cy);
    ctx.lineTo(cx + arrowLen - 10, cy - 6);
    ctx.lineTo(cx + arrowLen - 10, cy + 6);
    ctx.closePath();
    ctx.fillStyle = '#10b981';
    ctx.fill();

    // Label the constrained direction
    ctx.font = `600 ${Math.round(R * 0.13)}px var(--ff-mono, monospace)`;
    ctx.textAlign = 'center';
    ctx.fillStyle = '#10b981';
    ctx.fillText('constrained', cx + arrowLen * 0.55, cy - 14);
    ctx.font = `${Math.round(R * 0.10)}px var(--ff-mono, monospace)`;
    ctx.fillStyle = 'rgba(16,185,129,0.6)';
    ctx.fillText('→ target w_x', cx + arrowLen * 0.55, cy - 4);

    // NITP anchor arrows (if enabled)
    if (anchor) {
      anchorDots.forEach(ad => {
        ctx.beginPath();
        ctx.moveTo(cx + ad.ox, cy + ad.oy);
        ctx.lineTo(cx, cy);
        ctx.strokeStyle = 'rgba(139,92,246,0.5)';
        ctx.lineWidth = 1.5;
        ctx.setLineDash([4, 3]);
        ctx.stroke();
        ctx.setLineDash([]);
        ctx.beginPath();
        ctx.arc(cx + ad.ox, cy + ad.oy, 5, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(139,92,246,0.7)';
        ctx.fill();
      });
      // Label
      ctx.font = `600 ${Math.round(R * 0.12)}px var(--ff-mono, monospace)`;
      ctx.textAlign = 'center';
      ctx.fillStyle = 'rgba(139,92,246,0.8)';
      ctx.fillText('NITP anchors', cx - R * 0.45, cy + R * 0.55);
    }

    // Trail
    if (dotTrail.length > 1) {
      ctx.beginPath();
      ctx.moveTo(cx + dotTrail[0].x, cy + dotTrail[0].y);
      dotTrail.forEach(p => ctx.lineTo(cx + p.x, cy + p.y));
      ctx.strokeStyle = 'rgba(248,113,113,0.35)';
      ctx.lineWidth = 1.5;
      ctx.setLineDash([3, 3]);
      ctx.stroke();
      ctx.setLineDash([]);
    }

    // Moving dot (h_t drifting)
    if (drift || dotTrail.length > 0) {
      const px = cx + dotX, py = cy + dotY;
      ctx.beginPath();
      ctx.arc(px, py, 7, 0, Math.PI * 2);
      ctx.fillStyle = '#f87171';
      ctx.fill();
      ctx.font = `600 ${Math.round(R * 0.13)}px var(--ff-mono, monospace)`;
      ctx.textAlign = 'left';
      ctx.fillStyle = '#f87171';
      ctx.fillText('h_t', px + 10, py - 6);
    }

    // Origin dot
    ctx.beginPath();
    ctx.arc(cx, cy, 5, 0, Math.PI * 2);
    ctx.fillStyle = 'rgba(255,255,255,0.3)';
    ctx.fill();
  }

  function driftAnimate() {
    const W = canvas.clientWidth, H = canvas.clientHeight;
    const R = Math.min(W, H) * 0.38;

    dotX += driftVx;
    dotY += driftVy * 0.8 + Math.sin(dotX * 0.05) * 0.6;
    driftVy += (rand() - 0.5) * 0.3;
    driftVy = Math.max(-2, Math.min(2, driftVy));

    // Bounce off circle boundary
    const dist = Math.sqrt(dotX * dotX + dotY * dotY);
    if (dist > R * 0.85) {
      const nx = dotX / dist, ny = dotY / dist;
      driftVx -= 2 * (driftVx * nx + driftVy * ny) * nx;
      driftVy -= 2 * (driftVx * nx + driftVy * ny) * ny;
      driftVx = Math.max(-3, Math.min(3, driftVx));
    }

    dotTrail.push({ x: dotX, y: dotY });
    if (dotTrail.length > 60) dotTrail.shift();

    drawScene();
    if (drift) animFrame = requestAnimationFrame(driftAnimate);
  }

  document.getElementById('btn-drift')?.addEventListener('click', () => {
    if (drift) return;
    drift = true;
    dotX = 0; dotY = 0; dotTrail = [];
    driftVx = (rand() - 0.5) * 2 + 0.4;
    driftVy = (rand() - 0.5) * 2;
    driftAnimate();
  });

  document.getElementById('btn-nitp-anchor')?.addEventListener('click', () => {
    anchor = true;
    if (!anchorDots.length) {
      const R = Math.min(canvas.clientWidth, canvas.clientHeight) * 0.38;
      anchorDots = [
        { ox: -R * 0.5, oy: -R * 0.4 },
        { ox: -R * 0.3, oy: R * 0.5 },
        { ox: R * 0.1,  oy: -R * 0.6 },
        { ox: R * 0.5,  oy: R * 0.35 },
      ];
    }
    drawScene();
  });

  document.getElementById('btn-reset-drift')?.addEventListener('click', () => {
    drift = false; anchor = false;
    dotX = 0; dotY = 0; dotTrail = [];
    anchorDots = [];
    if (animFrame) cancelAnimationFrame(animFrame);
    seed = 42;
    drawScene();
  });

  window.addEventListener('resize', () => { resize(); drawScene(); });
  drawScene();
})();

/* ═══════════════════════════════════════════════════════════════════════
   §04 — LAYER CHART CANVAS
   ═════════════════════════════════════════════════════════════════════ */
(function() {
  const canvas = document.getElementById('canvas-layers');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;

  function resize() {
    const W = canvas.clientWidth, H = canvas.clientHeight;
    canvas.width = W * DPR; canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
  }
  resize();

  // Ablation data: layers 1-17 (3B MoE model)
  // Semantic richness (peaks at L4, based on paper findings)
  // Performance (from Table 3: L4=23.58, L8=21.22, L14=22.16, inferred for others)
  const N = 17;
  const layers = Array.from({ length: N }, (_, i) => i + 1);

  // Semantic richness profile (peaks at ~20% depth = L4)
  function semRichness(l) {
    const peak = 4, decay = 2.5;
    return Math.exp(-Math.pow((l - peak) / decay, 2)) * 0.85 + 0.08;
  }

  // Performance approximation based on ablation data
  const perfByLayer = {
    4:  23.58,
    8:  21.22,
    14: 22.16,
  };
  // Interpolate others around these anchors
  function perf(l) {
    const baseline = 21.10;
    if (l <= 3)  return baseline + (l / 4) * (perfByLayer[4] - baseline) * 0.7;
    if (l === 4) return perfByLayer[4];
    if (l <= 8)  return perfByLayer[4] + (l - 4) / 4 * (perfByLayer[8] - perfByLayer[4]);
    if (l <= 14) return perfByLayer[8] + (l - 8) / 6 * (perfByLayer[14] - perfByLayer[8]);
    return perfByLayer[14] - (l - 14) * 0.05;
  }

  let selectedLayer = 4;

  function drawLayers() {
    const W = canvas.clientWidth, H = canvas.clientHeight;
    ctx.clearRect(0, 0, W, H);

    const padL = 36, padR = 16, padT = 20, padB = 28;
    const chartW = W - padL - padR;
    const chartH = H - padT - padB;
    const barW = chartW / N - 2;

    // Grid lines
    ctx.strokeStyle = 'rgba(255,255,255,0.04)';
    ctx.lineWidth = 1;
    for (let i = 0; i <= 4; i++) {
      const y = padT + chartH * (1 - i / 4);
      ctx.beginPath(); ctx.moveTo(padL, y); ctx.lineTo(padL + chartW, y); ctx.stroke();
    }

    // Y-axis label
    ctx.save();
    ctx.translate(12, H / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.font = `${Math.round(H * 0.08)}px var(--ff-mono, monospace)`;
    ctx.textAlign = 'center';
    ctx.fillStyle = 'rgba(255,255,255,0.25)';
    ctx.fillText('semantic richness', 0, 0);
    ctx.restore();

    layers.forEach((l, i) => {
      const x = padL + i * (chartW / N);
      const h = semRichness(l) * chartH;
      const y = padT + chartH - h;
      const isTarget = (l === 4);
      const isSelected = (l === selectedLayer);

      // Bar
      ctx.fillStyle = isSelected
        ? (isTarget ? 'rgba(139,92,246,0.85)' : 'rgba(6,182,212,0.7)')
        : (isTarget ? 'rgba(139,92,246,0.35)' : 'rgba(255,255,255,0.1)');
      ctx.fillRect(x + 2, y, barW, h);

      // Target mark (L4)
      if (isTarget) {
        ctx.strokeStyle = 'rgba(139,92,246,0.7)';
        ctx.lineWidth = 1.5;
        ctx.setLineDash([3, 2]);
        ctx.beginPath(); ctx.moveTo(x + 2 + barW / 2, padT); ctx.lineTo(x + 2 + barW / 2, y); ctx.stroke();
        ctx.setLineDash([]);

        ctx.font = `600 ${Math.round(W * 0.022)}px var(--ff-mono, monospace)`;
        ctx.textAlign = 'center';
        ctx.fillStyle = 'rgba(139,92,246,0.9)';
        ctx.fillText('★', x + 2 + barW / 2, padT + 12);
      }

      // Layer number
      ctx.font = `${Math.round(W * 0.019)}px var(--ff-mono, monospace)`;
      ctx.textAlign = 'center';
      ctx.fillStyle = isSelected ? 'var(--text2)' : 'rgba(255,255,255,0.3)';
      ctx.fillText(l, x + 2 + barW / 2, H - 6);
    });

    // X-axis label
    ctx.font = `${Math.round(W * 0.022)}px var(--ff-mono, monospace)`;
    ctx.textAlign = 'center';
    ctx.fillStyle = 'rgba(255,255,255,0.2)';
    ctx.fillText('layer depth (1 = shallowest, 17 = deepest)', W / 2, H - 6);

    // Legend
    ctx.font = `${Math.round(W * 0.02)}px var(--ff-mono, monospace)`;
    ctx.textAlign = 'left';
    ctx.fillStyle = 'rgba(139,92,246,0.8)';
    ctx.fillText('★ = NITP target (L4, best performance)', padL, padT + 14);
  }

  // Build layer buttons
  const btnsContainer = document.getElementById('layer-btns');
  const statEl = document.getElementById('layer-stat');
  if (btnsContainer) {
    const layerInfo = {
      1:  'L1  → too early, not contextualized yet',
      2:  'L2  → early context formation',
      3:  'L3  → local semantic integration begins',
      4:  'L4  → ★ peak semantic richness (NITP default)',
      5:  'L5  → slight drop from peak',
      6:  'L6  → mid-shallow zone',
      7:  'L7  → transitional layer',
      8:  'L8  → middle (avg score: 21.22%)',
      9:  'L9  → past semantic peak',
      10: 'L10 → increasingly task-specialized',
      11: 'L11 → high task specialization',
      12: 'L12 → late-mid layers',
      13: 'L13 → near deep zone',
      14: 'L14 → deep (avg score: 22.16%)',
      15: 'L15 → near output',
      16: 'L16 → pre-output',
      17: 'L17 → output layer, fully specialized for NTP',
    };
    const perfLabel = {
      4:  'avg benchmark: 23.58% ← best',
      8:  'avg benchmark: 21.22%',
      14: 'avg benchmark: 22.16%',
    };

    for (let l = 1; l <= N; l++) {
      const btn = document.createElement('button');
      btn.className = 'layer-btn' + (l === 4 ? ' active' : '');
      btn.textContent = `L${l}`;
      btn.dataset.layer = l;
      btn.addEventListener('click', () => {
        selectedLayer = l;
        document.querySelectorAll('.layer-btn').forEach(b => b.classList.toggle('active', parseInt(b.dataset.layer) === l));
        const pval = perf(l).toFixed(2);
        const extra = perfLabel[l] ? `  |  ${perfLabel[l]}` : `  |  avg ≈ ${pval}%`;
        statEl.textContent = `L${l}: ${layerInfo[l] || ''}${extra}`;
        drawLayers();
      });
      btnsContainer.appendChild(btn);
    }
    statEl.textContent = `L4: ★ peak semantic richness (NITP default)  |  avg benchmark: 23.58% ← best`;
  }

  window.addEventListener('resize', () => { resize(); drawLayers(); });
  drawLayers();
})();

/* ═══════════════════════════════════════════════════════════════════════
   §05 — STEP NAVIGATOR (Temporal Shift)
   ═════════════════════════════════════════════════════════════════════ */
(function() {
  let step = 0;
  const boxes   = document.querySelectorAll('#shift-steps .step-box');
  const prevBtn = document.getElementById('shift-prev');
  const nextBtn = document.getElementById('shift-next');
  const progEl  = document.getElementById('shift-prog');

  function updateSteps() {
    boxes.forEach((b, i) => {
      b.classList.remove('active', 'done');
      if (i === step) b.classList.add('active');
      else if (i < step) b.classList.add('done');
    });
    if (prevBtn) prevBtn.disabled = step === 0;
    if (nextBtn) nextBtn.disabled = step === boxes.length - 1;
    if (progEl)  progEl.textContent = `Step ${step + 1} of ${boxes.length}`;
    boxes.forEach((b, i) => {
      const n = b.querySelector('.step-num');
      if (n) n.textContent = i < step ? '✓' : String(i + 1);
    });
  }
  prevBtn?.addEventListener('click', () => { if (step > 0) { step--; updateSteps(); } });
  nextBtn?.addEventListener('click', () => { if (step < boxes.length - 1) { step++; updateSteps(); } });
  updateSteps();
})();

/* ═══════════════════════════════════════════════════════════════════════
   §06 — ANIMATED BAR CHART (Results)
   ═════════════════════════════════════════════════════════════════════ */
(function() {
  const resultsVp = document.getElementById('results-vp');
  if (!resultsVp) return;
  let triggered = false;
  const MAX = 70; // normalise bars against 70% max for readability

  function animateBars() {
    if (triggered) return;
    triggered = true;
    document.querySelectorAll('.bar-fill[data-w]').forEach(bar => {
      const pct = parseFloat(bar.dataset.w);
      // Scale to visual width (max bar = MAX%)
      const visualPct = Math.min(100, (pct / MAX) * 100);
      bar.style.width = visualPct + '%';
    });
  }

  new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) animateBars(); });
  }, { threshold: 0.3 }).observe(resultsVp);
})();
</script>
</BaseLayout>

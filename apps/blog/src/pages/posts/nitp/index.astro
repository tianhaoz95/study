<span class="cs-line cmt"># Measuring representation collapse during NTP training</span>
<span class="cs-line cmt"># Two geometry metrics tracked per checkpoint:</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># 1. Effective Rank (Roy &amp; Vetterli, 2007)</span>
<span class="cs-line hl-c"><span class="kw">def</span> <span class="fn">effective_rank</span>(H):</span>
<span class="cs-line hl-c">    <span class="cmt"># H: [N, d] matrix of hidden states</span></span>
<span class="cs-line hl-c">    sigma = torch.linalg.svdvals(H)</span>
<span class="cs-line hl-c">    p = sigma / sigma.sum()  <span class="cmt"># normalised singular values</span></span>
<span class="cs-line hl-c">    <span class="kw">return</span> torch.exp(-(<span class="cls">p</span> * torch.log(<span class="cls">p</span> + 1e-12)).sum())</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># 2. Average Cosine Similarity (global anisotropy proxy)</span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">avg_cosine_sim</span>(H):</span>
<span class="cs-line hl-p">    H_norm = F.normalize(H, dim=-1)  <span class="cmt"># [N, d]</span></span>
<span class="cs-line hl-p">    C = H_norm @ H_norm.T             <span class="cmt"># [N, N] all-pairs cosine</span></span>
<span class="cs-line hl-p">    mask = ~torch.eye(len(H), dtype=bool)</span>
<span class="cs-line hl-p">    <span class="kw">return</span> C[mask].mean()</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># What we observe under standard NTP:</span>
<span class="cs-line cmt">#   effective_rank: 45 → 8   (collapse)</span>
<span class="cs-line cmt">#   avg_cosine_sim: 0.05 → 0.72  (anisotropy)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Under NITP:</span>
<span class="cs-line cmt">#   effective_rank: 45 → 43  (preserved)</span>
<span class="cs-line cmt">#   avg_cosine_sim: 0.05 → 0.08  (maintained diversity)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Figure 1 from the paper confirms this for:</span>
<span class="cs-line cmt">#   NTP  effective rank Δ: -3.32 vs NITP</span>
<span class="cs-line cmt">#   NTP  cosine sim    Δ: -3.38 vs NITP</span>
      </pre>
    </div>

    <!-- ── panel: blindspot ──────────────────────────────────────────────── -->
    <div class="cs-panel" id="panel-blindspot">
      <pre class="cs-pre">
<span class="cs-line cmt"># Why NTP under-constrains hidden representations</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># NTP cross-entropy gradient with respect to h_t:</span>
<span class="cs-line hl-p"><span class="cmt"># ∂L_NTP/∂h_t = Σ_j (p_j - 1[j=target]) * w_j</span></span>
<span class="cs-line hl-p"><span class="cmt"># = weighted sum of EMBEDDING vectors w_j</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Problem: embedding matrix W has rank r &lt;&lt; d</span>
<span class="cs-line cmt"># → gradient lives in r-dim subspace</span>
<span class="cs-line cmt"># → (d - r) directions are unconstrained "null space"</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Hessian analysis (Lemma 3.1):</span>
<span class="cs-line hl-c"><span class="cmt"># H_NTP  ≈ W^T diag(p) W  - (W^T p)(W^T p)^T</span></span>
<span class="cs-line hl-c"><span class="cmt"># rank(H_NTP) ≤ rank(W) ≤ r</span></span>
<span class="cs-line hl-c"><span class="cmt"># → null space of H_NTP has dimension d - r</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># NITP Hessian at convergence (s → 1):</span>
<span class="cs-line hl-g"><span class="cmt"># H_NITP ≈ (1/r²)(I - uu^T)  (positive semi-definite)</span></span>
<span class="cs-line hl-g"><span class="cmt"># → adds curvature to EVERY direction ⊥ h</span></span>
<span class="cs-line hl-g"><span class="cmt"># → null space of H_NTP gets curvature &gt; 0</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Theorem 3.2: for any w in NTP's null space,</span>
<span class="cs-line cmt">#   w^T H_total w = 0 + λ/r² ||w||² &gt; 0</span>
<span class="cs-line cmt"># NITP eliminates all flat valleys.</span>
      </pre>
    </div>

    <!-- ── panel: arch ───────────────────────────────────────────────────── -->
    <div class="cs-panel" id="panel-arch">
      <pre class="cs-pre">
<span class="cs-line cmt"># NITP training loop (simplified)</span>
<span class="cs-line"> </span>
<span class="cs-line"><span class="kw">class</span> <span class="cls">NITPModel</span>(nn.Module):</span>
<span class="cs-line hl-p">    <span class="kw">def</span> <span class="fn">__init__</span>(self, config):</span>
<span class="cs-line hl-p">        <span class="fn">super</span>().__init__()</span>
<span class="cs-line hl-p">        self.layers = nn.ModuleList([...])  <span class="cmt"># L layers</span></span>
<span class="cs-line hl-p">        self.k = config.shallow_k  <span class="cmt"># e.g. 4 of 17</span></span>
<span class="cs-line hl-p">        self.projector = nn.Sequential(</span>
<span class="cs-line hl-p">            nn.Linear(d, d), nn.SiLU(),</span>
<span class="cs-line hl-p">            nn.Linear(d, d))</span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">forward</span>(self, x):</span>
<span class="cs-line">        h = self.embed(x)  <span class="cmt"># [B, T, d]</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt">        # --- shallow layers → implicit tokens ---</span>
<span class="cs-line hl-c">        <span class="kw">for</span> layer <span class="kw">in</span> self.layers[:self.k]:</span>
<span class="cs-line hl-c">            h = layer(h)</span>
<span class="cs-line hl-c">        <span class="cmt"># z_&#123;t+1&#125;: shallow repr at position t+1</span></span>
<span class="cs-line hl-c">        z = h[:, 1:, :].detach()  <span class="cmt"># stop-gradient!</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt">        # --- deep layers → final hidden state ---</span>
<span class="cs-line hl-p">        <span class="kw">for</span> layer <span class="kw">in</span> self.layers[self.k:]:</span>
<span class="cs-line hl-p">            h = layer(h)</span>
<span class="cs-line hl-p">        h_deep = h[:, :-1, :]  <span class="cmt"># h_t at position t</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt">        # --- NITP loss (cosine) ---</span>
<span class="cs-line hl-g">        proj = F.normalize(self.projector(h_deep), dim=-1)</span>
<span class="cs-line hl-g">        tgt  = F.normalize(z, dim=-1)</span>
<span class="cs-line hl-g">        L_nitp = (1 - (proj * tgt).sum(-1)).mean()</span>
<span class="cs-line"> </span>
<span class="cs-line cmt">        # --- NTP loss (cross-entropy) ---</span>
<span class="cs-line">        logits = self.unembed(h_deep)  <span class="cmt"># [B, T-1, V]</span></span>
<span class="cs-line">        L_ntp = F.cross_entropy(logits.flatten(0,1),</span>
<span class="cs-line">                                x[:, 1:].flatten())</span>
<span class="cs-line"> </span>
<span class="cs-line">        <span class="kw">return</span> L_ntp + <span class="num">1.0</span> * L_nitp  <span class="cmt"># λ = 1.0</span></span>
      </pre>
    </div>

    <!-- ── panel: anchors ────────────────────────────────────────────────── -->
    <div class="cs-panel" id="panel-anchors">
      <pre class="cs-pre">
<span class="cs-line cmt"># Ablation: target layer selection (3B MoE, 200B tokens)</span>
<span class="cs-line cmt"># Layers: 17 total. Shallow = L4, Middle = L8, Deep = L14</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># ┌───────────────┬────────┬────────┬──────┬────────┐</span>
<span class="cs-line cmt"># │ Target Layer  │ MMLU   │ M-Pro  │ BBH  │  Avg   │</span>
<span class="cs-line cmt"># ├───────────────┼────────┼────────┼──────┼────────┤</span>
<span class="cs-line cmt"># │ NTP baseline  │ 34.60  │ 11.00  │ 21.92│ 21.10  │</span>
<span class="cs-line cmt"># │ Deep  (L14)   │ 35.79  │ 10.43  │ 23.25│ 22.16  │</span>
<span class="cs-line cmt"># │ Middle (L8)   │ 35.33  │ 11.57  │ 22.07│ 21.22  │</span>
<span class="cs-line hl-g"># │ Shallow (L4)  │ 37.37  │ 12.29  │ 26.14│ 23.58  │ ← best</span>
<span class="cs-line cmt"># └───────────────┴────────┴────────┴──────┴────────┘</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Why shallow wins:</span>
<span class="cs-line cmt"># • semantic richness peaks at ~20% depth (L4 of 17)</span>
<span class="cs-line cmt"># • deep layers specialise for discrimination, not semantics</span>
<span class="cs-line cmt"># • shallow targets are "reachable": NITP loss → 0.04-0.08</span>
<span class="cs-line cmt"># • deep targets are harder to predict: weaker Hessian guarantee</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Optimal layer depth = ~20% of total across model sizes:</span>
<span class="cs-line cmt">#   0.5B dense:  L2 of 14  (14%)</span>
<span class="cs-line cmt">#   2B dense:    L4 of 17  (24%)</span>
<span class="cs-line cmt">#   9B MoE:      L4 of 17  (24%)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># MTEB sentence representation (frozen h, no fine-tuning):</span>
<span class="cs-line hl-p"><span class="cmt"># NITP improves 23/25 MTEB tasks vs NTP</span></span>
<span class="cs-line hl-p"><span class="cmt"># while matching validation cross-entropy loss</span></span>
      </pre>
    </div>

    <!-- ── panel: shift ──────────────────────────────────────────────────── -->
    <div class="cs-panel" id="panel-shift">
      <pre class="cs-pre">
<span class="cs-line cmt"># Ablation: temporal shift (3B MoE, 200B tokens)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># ┌─────────────────────┬─────────┬─────────┐</span>
<span class="cs-line cmt"># │ Variant             │ Loss    │  Avg    │</span>
<span class="cs-line cmt"># ├─────────────────────┼─────────┼─────────┤</span>
<span class="cs-line cmt"># │ NTP baseline        │  —      │ 21.10%  │</span>
<span class="cs-line hl-a"><span class="cmt"># │ Current-step (t→t)  │ ~0.03   │ 18.75%  │ ← worse!</span></span>
<span class="cs-line hl-g"><span class="cmt"># │ Next-token (t→t+1)  │ ~0.08   │ 23.58%  │ ← best</span></span>
<span class="cs-line cmt"># └─────────────────────┴─────────┴─────────┘</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Key insight: low NITP loss ≠ better performance</span>
<span class="cs-line cmt"># t→t achieves loss=0.03 (near perfect alignment)</span>
<span class="cs-line cmt"># but trivially: deep layer just copies shallow layer</span>
<span class="cs-line cmt"># no predictive signal → representations degenerate</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Also ablated: generic cosine regularization</span>
<span class="cs-line cmt"># (Gao et al. 2019 approach — penalise pairwise cos sim)</span>
<span class="cs-line cmt"># ┌──────────────────────────┬─────────┐</span>
<span class="cs-line cmt"># │ Generic cosine reg.      │ 20.79%  │ ← no improvement</span>
<span class="cs-line cmt"># │ NITP (predictive)        │ 23.58%  │ ← +2.48 pp</span>
<span class="cs-line cmt"># └──────────────────────────┴─────────┘</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Conclusion: gains require AUTOREGRESSIVE structure</span>
<span class="cs-line cmt"># not just geometric regularisation of representations</span>
      </pre>
    </div>

    <!-- ── panel: results ────────────────────────────────────────────────── -->

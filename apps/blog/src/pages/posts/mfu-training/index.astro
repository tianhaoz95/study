<span class="cs-line"><span class="kw">def</span> <span class="fn">mfu</span>(</span>
<span class="cs-line">    tokens_per_sec,   <span class="cmt"># observed global throughput</span></span>
<span class="cs-line">    N,                <span class="cmt"># model parameters</span></span>
<span class="cs-line">    n_gpus,           <span class="cmt"># number of training GPUs</span></span>
<span class="cs-line">    gpu_peak_tflops,  <span class="cmt"># e.g. 312 for A100 SXM BF16</span></span>
<span class="cs-line">    include_attn=<span class="cls">False</span>, L=<span class="num">0</span>, T=<span class="num">0</span>, d=<span class="num">0</span></span>
<span class="cs-line">):</span>
<span class="cs-line hl-p">    flops_tok = <span class="num">6</span> * N</span>
<span class="cs-line">    <span class="kw">if</span> include_attn:</span>
<span class="cs-line">        flops_tok += <span class="num">12</span> * L * T * d</span>
<span class="cs-line"> </span>
<span class="cs-line hl-c">    actual_tflops  = tokens_per_sec * flops_tok / <span class="num">1e12</span></span>
<span class="cs-line hl-c">    peak_tflops    = n_gpus * gpu_peak_tflops</span>
<span class="cs-line"> </span>
<span class="cs-line hl-g">    <span class="kw">return</span> actual_tflops / peak_tflops  <span class="cmt"># ∈ [0, 1]</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># GPU peak BF16 TFLOPS (dense, no sparsity)</span>
<span class="cs-line">GPU_PEAK = &#123;</span>
<span class="cs-line">    <span class="str">'V100 SXM2'</span>:  <span class="num">125</span>,   <span class="cmt"># FP16</span></span>
<span class="cs-line">    <span class="str">'A100 SXM4'</span>:  <span class="num">312</span>,   <span class="cmt"># BF16</span></span>
<span class="cs-line">    <span class="str">'A100 PCIe'</span>:  <span class="num">77.6</span>,  <span class="cmt"># BF16</span></span>
<span class="cs-line">    <span class="str">'H100 SXM'</span>:   <span class="num">989</span>,   <span class="cmt"># BF16</span></span>
<span class="cs-line">    <span class="str">'H100 PCIe'</span>:  <span class="num">660</span>,   <span class="cmt"># BF16</span></span>
<span class="cs-line">&#125;</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-walkthrough">
      <pre class="cs-pre">
<span class="cs-line cmt"># Llama 2 7B MFU calculation</span>
<span class="cs-line cmt"># Source: Meta AI paper (arXiv:2307.09288)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Step 1: count parameters</span>
<span class="cs-line hl-p">N = <span class="num">6.74e9</span>           <span class="cmt"># 6.74 billion</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Step 2: FLOPs per token (6N rule)</span>
<span class="cs-line hl-c">flops_tok = <span class="num">6</span> * N     <span class="cmt"># 40.44 GFLOPs</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Step 3: measure throughput</span>
<span class="cs-line cmt"># Meta: 184,320 A100-hours for 2T tokens</span>
<span class="cs-line">total_gpu_secs = <span class="num">184320</span> * <span class="num">3600</span>  <span class="cmt"># 663.6M</span></span>
<span class="cs-line">total_tokens   = <span class="num">2e12</span>           <span class="cmt"># 2 trillion</span></span>
<span class="cs-line hl-a">tok_per_gpu_s  = total_tokens / total_gpu_secs</span>
<span class="cs-line hl-a">                               <span class="cmt"># ≈ 3,014 tok/GPU/s</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Step 4: compute MFU</span>
<span class="cs-line">GPU_PEAK_BF16 = <span class="num">312e12</span>  <span class="cmt"># A100 SXM4</span></span>
<span class="cs-line">actual = tok_per_gpu_s * flops_tok</span>
<span class="cs-line">         <span class="cmt"># = 3014 × 40.44e9 = 121.9 TF/s</span></span>
<span class="cs-line hl-g">mfu = actual / GPU_PEAK_BF16</span>
<span class="cs-line hl-g">      <span class="cmt"># = 121.9 / 312 = 39.1% ≈ 38.8%</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Small discrepancy from rounding N to 6.7B</span>
<span class="cs-line cmt"># Result: MFU ≈ 38–39% — "good" tier</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-overhead">
      <pre class="cs-pre">
<span class="cs-line cmt"># Where does compute go? (100% budget)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Typical "good" A100 training run at ~40% MFU</span>
<span class="cs-line hl-g"><span class="cmt"># Model compute (MFU):          40%  ← goal</span></span>
<span class="cs-line hl-a"><span class="cmt"># GPU-GPU communication:        22%  ← AllReduce</span></span>
<span class="cs-line hl-c"><span class="cmt"># Memory bandwidth overhead:   16%  ← HBM reads</span></span>
<span class="cs-line cmt"># Kernel launch &amp; misc:         14%</span>
<span class="cs-line cmt"># Data loading + bubbles:        8%</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># HFU vs MFU (gradient checkpointing)</span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">hfu</span>(mfu_val, ckpt_frac=<span class="num">1.0</span>):</span>
<span class="cs-line">    <span class="str">"""</span></span>
<span class="cs-line">    <span class="str">ckpt_frac: fraction of layers recomputed</span></span>
<span class="cs-line">    <span class="str">  0.0 = no checkpointing (HFU = MFU)</span></span>
<span class="cs-line">    <span class="str">  1.0 = full recompute (+33% FLOPs)</span></span>
<span class="cs-line">    <span class="str">  1/3 = selective recompute (common)</span></span>
<span class="cs-line">    <span class="str">"""</span></span>
<span class="cs-line">    recompute_factor = <span class="num">1</span> + ckpt_frac / <span class="num">3</span></span>
<span class="cs-line">    <span class="kw">return</span> mfu_val * recompute_factor</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># If MFU=38.8% with selective recompute (1/3)</span>
<span class="cs-line"><span class="fn">hfu</span>(<span class="num">0.388</span>, ckpt_frac=<span class="num">1</span>/<span class="num">3</span>)  <span class="cmt"># → 51.7%</span></span>
<span class="cs-line cmt"># PaLM uses this definition = "Hardware FLU"</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-numbers">
      <pre class="cs-pre">
<span class="cs-line cmt"># Published MFU across major training runs</span>
<span class="cs-line cmt"># (all using 6N counting = model FLOPs only)</span>
<span class="cs-line"> </span>
<span class="cs-line">RUNS = [</span>
<span class="cs-line">  &#123;<span class="str">"name"</span>: <span class="str">"GPT-NeoX 20B"</span>,</span>
<span class="cs-line">   <span class="str">"hw"</span>: <span class="str">"96 A100, NVLink"</span>,</span>
<span class="cs-line hl-a">   <span class="str">"mfu"</span>: <span class="num">0.21</span>&#125;,  <span class="cmt"># early cluster, no NVSwitch</span></span>
<span class="cs-line"> </span>
<span class="cs-line">  &#123;<span class="str">"name"</span>: <span class="str">"Llama 2 7B"</span>,</span>
<span class="cs-line">   <span class="str">"hw"</span>: <span class="str">"2048 A100 SXM4"</span>,</span>
<span class="cs-line hl-c">   <span class="str">"mfu"</span>: <span class="num">0.388</span>&#125;,  <span class="cmt"># derived from Meta's numbers</span></span>
<span class="cs-line"> </span>
<span class="cs-line">  &#123;<span class="str">"name"</span>: <span class="str">"PaLM 540B"</span>,</span>
<span class="cs-line">   <span class="str">"hw"</span>: <span class="str">"6144 TPU v4"</span>,</span>
<span class="cs-line hl-c">   <span class="str">"mfu"</span>: <span class="num">0.462</span>&#125;,  <span class="cmt"># explicitly reported</span></span>
<span class="cs-line"> </span>
<span class="cs-line">  &#123;<span class="str">"name"</span>: <span class="str">"Megatron-LM"</span>,</span>
<span class="cs-line">   <span class="str">"hw"</span>: <span class="str">"512 A100 SXM4"</span>,</span>
<span class="cs-line hl-g">   <span class="str">"mfu"</span>: <span class="num">0.47</span>&#125;,  <span class="cmt"># NVIDIA optimized stack</span></span>
<span class="cs-line"> </span>
<span class="cs-line">  &#123;<span class="str">"name"</span>: <span class="str">"+FlashAttention-2"</span>,</span>
<span class="cs-line">   <span class="str">"hw"</span>: <span class="str">"A100, FA2 kernels"</span>,</span>
<span class="cs-line hl-g">   <span class="str">"mfu"</span>: <span class="num">0.52</span>&#125;,  <span class="cmt"># FA2 enables larger batches</span></span>
<span class="cs-line">]</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># H100 FP8 training: pushing 55–65%+ MFU</span>
<span class="cs-line cmt"># (FP8 = 1,979 TFLOPs/s peak on H100 SXM)</span>
      </pre>
    </div>

  </div>
</aside>

</div><!-- /post-grid -->

<script>
// ─── TOC + sidebar toggles ───────────────────────────────────
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});
const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ─── Code sidebar tab switching ──────────────────────────────
const tabMeta = {
  why:         { file: 'mfu/basics.py',      title: "Why GPU% Isn't Enough" },
  flops:       { file: 'mfu/flops.py',       title: 'The 6N Rule' },
  formula:     { file: 'mfu/formula.py',     title: 'MFU Calculator' },
  walkthrough: { file: 'mfu/llama2_7b.py',   title: 'Llama 2 Walk-Through' },
  overhead:    { file: 'mfu/overhead.py',    title: 'What Steals Your MFU?' },
  numbers:     { file: 'mfu/benchmarks.py',  title: 'Real Published Numbers' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ─── IntersectionObserver ─────────────────────────────────────
const sectionMap = {
  's-why':        'why',
  's-flops':      'flops',
  's-formula':    'formula',
  's-walkthrough':'walkthrough',
  's-overhead':   'overhead',
  's-numbers':    'numbers',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ─── §01 Utilization Contrast Canvas ────────────────────────
(function() {
  const c = document.getElementById('util-canvas');
  if (!c) return;
  const ctx = c.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  function resize() {
    const W = c.clientWidth;
    c.width = W * DPR; c.height = 210 * DPR;
    ctx.scale(DPR, DPR);
    draw();
  }

  function draw() {
    const W = c.clientWidth, H = 210;
    ctx.clearRect(0, 0, W, H);
    const hw = W * 0.47;
    const gap = W * 0.06;

    function panel(ox, title, gpuPct, mfu, gpuColor, mfuColor) {
      ctx.fillStyle = 'rgba(26,26,46,.5)';
      ctx.strokeStyle = 'rgba(107,114,128,.2)';
      ctx.lineWidth = 1;
      roundRect(ctx, ox, 10, hw, H - 20, 8);
      ctx.fill(); ctx.stroke();

      ctx.fillStyle = '#94a3b8';
      ctx.font = '600 11px Inter,sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText(title, ox + hw/2, 30);

      const barY = 50, barH = 28, barW = hw * 0.7, barX = ox + (hw - barW)/2;

      // GPU%
      ctx.fillStyle = 'rgba(107,114,128,.2)';
      roundRect(ctx, barX, barY, barW, barH, 4); ctx.fill();
      ctx.fillStyle = gpuColor;
      roundRect(ctx, barX, barY, barW * gpuPct/100, barH, 4); ctx.fill();
      ctx.fillStyle = '#e2e8f0'; ctx.font = '700 10px Inter,sans-serif'; ctx.textAlign = 'left';
      ctx.fillText('GPU%  ' + gpuPct + '%', barX + 6, barY + 18);

      // MFU
      const mfuY = barY + barH + 12;
      ctx.fillStyle = 'rgba(107,114,128,.2)';
      roundRect(ctx, barX, mfuY, barW, barH, 4); ctx.fill();
      ctx.fillStyle = mfuColor;
      roundRect(ctx, barX, mfuY, barW * mfu/100, barH, 4); ctx.fill();
      ctx.fillStyle = '#e2e8f0'; ctx.font = '700 10px Inter,sans-serif'; ctx.textAlign = 'left';
      ctx.fillText('MFU   ' + mfu + '%', barX + 6, mfuY + 18);

      // Label
      ctx.font = '500 9px Inter,sans-serif'; ctx.fillStyle = '#64748b'; ctx.textAlign = 'center';
      ctx.fillText(mfu < 20 ? '⚠ Memory-bound' : '✓ Compute-bound', ox + hw/2, mfuY + barH + 16);
    }

    panel(gap/2,          'Run A — Batch=1',   82, 8,  'rgba(239,68,68,.7)',  'rgba(239,68,68,.85)');
    panel(hw + gap * 1.5, 'Run B — Batch=512', 80, 43, 'rgba(107,114,128,.6)','rgba(16,185,129,.75)');

    ctx.fillStyle = '#64748b';
    ctx.font = '500 9px Inter,sans-serif'; ctx.textAlign = 'center';
    ctx.fillText('Both show ~80% GPU utilization in nvidia-smi', W/2, H - 6);
  }

  function roundRect(ctx, x, y, w, h, r) {
    ctx.beginPath();
    ctx.moveTo(x + r, y);
    ctx.lineTo(x + w - r, y);
    ctx.arcTo(x + w, y, x + w, y + r, r);
    ctx.lineTo(x + w, y + h - r);
    ctx.arcTo(x + w, y + h, x + w - r, y + h, r);
    ctx.lineTo(x + r, y + h);
    ctx.arcTo(x, y + h, x, y + h - r, r);
    ctx.lineTo(x, y + r);
    ctx.arcTo(x, y, x + r, y, r);
    ctx.closePath();
  }

  window.addEventListener('resize', resize);
  resize();
})();

// ─── §02 FLOPs Breakdown Canvas ──────────────────────────────
(function() {
  const c = document.getElementById('flops-canvas');
  if (!c) return;
  const ctx = c.getContext('2d');
  const DPR = window.devicePixelRatio || 1;

  function resize() {
    const W = c.clientWidth;
    c.width = W * DPR; c.height = 220 * DPR;
    ctx.scale(DPR, DPR);
    draw();
  }

  function draw() {
    const W = c.clientWidth, H = 220;
    ctx.clearRect(0, 0, W, H);

    const seqLens = [512, 1024, 2048, 4096, 8192, 16384, 32768];
    const N = 6.7e9, L = 32, d = 4096;
    const linearFlops = 6 * N;

    const pad = { l: 50, r: 20, t: 20, b: 40 };
    const cw = W - pad.l - pad.r;
    const ch = H - pad.t - pad.b;

    const maxFlops = seqLens.map(T => linearFlops + 12 * L * T * d).reduce((a,b) => Math.max(a,b));

    // Axes
    ctx.strokeStyle = 'rgba(107,114,128,.3)';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(pad.l, pad.t); ctx.lineTo(pad.l, pad.t + ch);
    ctx.lineTo(pad.l + cw, pad.t + ch);
    ctx.stroke();

    // Y-axis labels
    ctx.fillStyle = '#64748b'; ctx.font = '9px Inter,sans-serif'; ctx.textAlign = 'right';
    for (let i = 0; i <= 4; i++) {
      const v = maxFlops * i / 4;
      const y = pad.t + ch - (v / maxFlops) * ch;
      ctx.fillText((v/1e9).toFixed(0) + 'G', pad.l - 4, y + 3);
      ctx.strokeStyle = 'rgba(107,114,128,.1)';
      ctx.beginPath(); ctx.moveTo(pad.l, y); ctx.lineTo(pad.l + cw, y); ctx.stroke();
    }

    // Bars
    const bw = cw / seqLens.length * 0.7;
    seqLens.forEach((T, i) => {
      const x = pad.l + (i + 0.5) * cw / seqLens.length - bw/2;
      const totalFlops = linearFlops + 12 * L * T * d;
      const attnFlops = 12 * L * T * d;
      const totalH = (totalFlops / maxFlops) * ch;
      const attnH = (attnFlops / maxFlops) * ch;

      // Linear part
      ctx.fillStyle = 'rgba(139,92,246,.6)';
      ctx.fillRect(x, pad.t + ch - totalH, bw, totalH - attnH);

      // Attention part
      ctx.fillStyle = 'rgba(6,182,212,.7)';
      ctx.fillRect(x, pad.t + ch - attnH, bw, attnH);

      // X label
      ctx.fillStyle = '#64748b'; ctx.font = '8px Inter,sans-serif'; ctx.textAlign = 'center';
      const label = T >= 1024 ? (T/1024) + 'K' : T;
      ctx.fillText(label, x + bw/2, pad.t + ch + 14);
    });

    // Legend
    ctx.fillStyle = 'rgba(139,92,246,.6)'; ctx.fillRect(pad.l, H - 12, 10, 8);
    ctx.fillStyle = '#94a3b8'; ctx.font = '9px Inter,sans-serif'; ctx.textAlign = 'left';
    ctx.fillText('Linear (6N)', pad.l + 13, H - 5);
    ctx.fillStyle = 'rgba(6,182,212,.7)'; ctx.fillRect(pad.l + 90, H - 12, 10, 8);
    ctx.fillStyle = '#94a3b8';
    ctx.fillText('Attention (12LTd)', pad.l + 103, H - 5);

    ctx.fillStyle = '#94a3b8'; ctx.font = '9px Inter,sans-serif'; ctx.textAlign = 'center';
    ctx.fillText('Sequence length', pad.l + cw/2, H - 26);
  }

  window.addEventListener('resize', resize);
  resize();
})();

// ─── §03 MFU Calculator ──────────────────────────────────────
(function() {
  let gpuPeak = 312, nGpus = 8, params = 6.7e9;

  function selBtn(container, btn) {
    container.querySelectorAll('.calc-btn').forEach(b => b.classList.remove('sel'));
    btn.classList.add('sel');
  }

  document.getElementById('gpu-btns')?.querySelectorAll('.calc-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      gpuPeak = parseFloat(btn.dataset.gpu);
      selBtn(btn.closest('.calc-btns'), btn);
      update();
    });
  });

  document.getElementById('ngpu-btns')?.querySelectorAll('.calc-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      nGpus = parseInt(btn.dataset.n);
      selBtn(btn.closest('.calc-btns'), btn);
      update();
    });
  });

  document.getElementById('model-btns')?.querySelectorAll('.calc-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      params = parseFloat(btn.dataset.params) * 1e9;
      selBtn(btn.closest('.calc-btns'), btn);
      update();
    });
  });

  const toksInput = document.getElementById('toks-input');
  const toksRange = document.getElementById('toks-range');
  toksInput?.addEventListener('input', () => { toksRange.value = toksInput.value; update(); });
  toksRange?.addEventListener('input', () => { toksInput.value = toksRange.value; update(); });

  function update() {
    const toks = parseFloat(toksInput?.value || 24000);
    const flopsPerTok = 6 * params;
    const actualTF = toks * flopsPerTok / 1e12;
    const peakTF = nGpus * gpuPeak;
    const mfu = actualTF / peakTF;

    const pctEl = document.getElementById('mfu-pct');
    const rateEl = document.getElementById('mfu-rating');
    const detailEl = document.getElementById('mfu-detail');

    if (pctEl) pctEl.textContent = (mfu * 100).toFixed(1) + '%';

    let rating, color;
    if (mfu < 0.2)      { rating = '✗ Poor (< 20% — check bottlenecks)';    color = 'var(--red,#ef4444)'; }
    else if (mfu < 0.35){ rating = '~ Fair (20–35% — room to improve)';     color = 'var(--amber)'; }
    else if (mfu < 0.5) { rating = '✓ Good (35–50% typical)';               color = 'var(--green)'; }
    else                { rating = '★ Excellent (50%+ — optimized stack)';  color = 'var(--cyan)'; }

    if (pctEl) pctEl.style.color = color;
    if (rateEl) { rateEl.textContent = rating; rateEl.style.color = color; }

    if (detailEl) {
      const flopsG = (flopsPerTok / 1e9).toFixed(1);
      const actualStr = (actualTF).toFixed(1);
      const peakStr = peakTF.toLocaleString();
      detailEl.innerHTML = `FLOPs/token: ${flopsG} GFLOPs (6N)<br/>Actual FLOPs/s: ${actualStr} TFLOPs/s<br/>Peak FLOPs/s: ${peakStr} TFLOPs/s (${nGpus} × ${gpuPeak} T)`;
    }

    drawGauge(mfu);
  }

  function drawGauge(mfu) {
    const c = document.getElementById('gauge-canvas');
    if (!c) return;
    const ctx = c.getContext('2d');
    const W = 120, H = 80;
    ctx.clearRect(0, 0, W, H);

    const cx = W/2, cy = H - 10, r = 55;
    const startA = Math.PI, endA = 0;

    // Background arc
    ctx.beginPath();
    ctx.arc(cx, cy, r, startA, endA);
    ctx.strokeStyle = 'rgba(107,114,128,.2)';
    ctx.lineWidth = 10;
    ctx.stroke();

    // Colored arc
    const mfuA = startA + mfu * Math.PI;
    let color;
    if (mfu < 0.2)       color = '#ef4444';
    else if (mfu < 0.35) color = '#f59e0b';
    else if (mfu < 0.5)  color = '#10b981';
    else                 color = '#06b6d4';

    ctx.beginPath();
    ctx.arc(cx, cy, r, startA, Math.min(mfuA, endA + 0.01));
    ctx.strokeStyle = color;
    ctx.lineWidth = 10;
    ctx.stroke();

    // Needle
    const needleA = startA + mfu * Math.PI;
    ctx.beginPath();
    ctx.moveTo(cx, cy);
    ctx.lineTo(cx + (r - 15) * Math.cos(needleA), cy + (r - 15) * Math.sin(needleA));
    ctx.strokeStyle = '#e2e8f0';
    ctx.lineWidth = 2;
    ctx.stroke();

    // Center dot
    ctx.beginPath();
    ctx.arc(cx, cy, 4, 0, Math.PI * 2);
    ctx.fillStyle = '#e2e8f0';
    ctx.fill();

    // Labels
    ctx.fillStyle = '#64748b'; ctx.font = '8px Inter,sans-serif'; ctx.textAlign = 'center';
    ctx.fillText('0%', cx - r + 5, cy + 14);
    ctx.fillText('100%', cx + r - 5, cy + 14);
  }

  update();
})();

// ─── §04 Step Navigator ──────────────────────────────────────
(function() {
  const steps = ['wt-s0','wt-s1','wt-s2','wt-s3'];
  let cur = 0;

  function render() {
    steps.forEach((id, i) => {
      const el = document.getElementById(id);
      if (!el) return;
      el.classList.remove('active','done');
      if (i === cur) el.classList.add('active');
      else if (i < cur) el.classList.add('done');
    });
    const prev = document.getElementById('wt-prev');
    const next = document.getElementById('wt-next');
    const prog = document.getElementById('wt-prog');
    if (prev) prev.disabled = cur === 0;
    if (next) next.disabled = cur === steps.length - 1;
    if (prog) prog.textContent = `Step ${cur + 1} of ${steps.length}`;
  }

  document.getElementById('wt-prev')?.addEventListener('click', () => { if (cur > 0) { cur--; render(); } });
  document.getElementById('wt-next')?.addEventListener('click', () => { if (cur < steps.length - 1) { cur++; render(); } });
  render();
})();

// ─── §05 Overhead Canvas ─────────────────────────────────────
(function() {
  const c = document.getElementById('overhead-canvas');
  if (!c) return;
  const ctx = c.getContext('2d');
  const DPR = window.devicePixelRatio || 1;

  function resize() {
    const W = c.clientWidth;
    c.width = W * DPR; c.height = 240 * DPR;
    ctx.scale(DPR, DPR);
    draw();
  }

  function draw() {
    const W = c.clientWidth, H = 240;
    ctx.clearRect(0, 0, W, H);

    const segments = [
      { label: 'Model compute (MFU)', pct: 40, color: 'rgba(16,185,129,.75)' },
      { label: 'GPU-GPU comm.', pct: 22, color: 'rgba(239,68,68,.6)' },
      { label: 'Memory bandwidth', pct: 16, color: 'rgba(245,158,11,.65)' },
      { label: 'Kernel launch', pct: 14, color: 'rgba(107,114,128,.55)' },
      { label: 'Data + bubbles', pct: 8, color: 'rgba(107,114,128,.35)' },
    ];

    const cx = W * 0.32, cy = H * 0.5, r = Math.min(cx, cy) * 0.75;
    let startA = -Math.PI / 2;

    segments.forEach(seg => {
      const sweep = (seg.pct / 100) * Math.PI * 2;
      ctx.beginPath();
      ctx.moveTo(cx, cy);
      ctx.arc(cx, cy, r, startA, startA + sweep);
      ctx.closePath();
      ctx.fillStyle = seg.color;
      ctx.fill();
      ctx.strokeStyle = 'rgba(9,9,15,.4)';
      ctx.lineWidth = 2;
      ctx.stroke();
      startA += sweep;
    });

    // Legend
    const lx = cx + r + 20, ly = H * 0.15;
    segments.forEach((seg, i) => {
      const y = ly + i * 34;
      ctx.fillStyle = seg.color;
      ctx.fillRect(lx, y, 14, 14);
      ctx.fillStyle = '#94a3b8'; ctx.font = '600 10px Inter,sans-serif'; ctx.textAlign = 'left';
      ctx.fillText(seg.pct + '%', lx + 18, y + 11);
      ctx.fillStyle = '#64748b'; ctx.font = '9px Inter,sans-serif';
      ctx.fillText(seg.label, lx + 18, y + 23);
    });

    ctx.fillStyle = '#94a3b8'; ctx.font = '700 11px Inter,sans-serif'; ctx.textAlign = 'center';
    ctx.fillText('~40% MFU run', cx, cy - 8);
    ctx.fillStyle = '#64748b'; ctx.font = '9px Inter,sans-serif';
    ctx.fillText('100% GPU budget', cx, cy + 8);
  }

  window.addEventListener('resize', resize);
  resize();
})();

// ─── §06 Bar chart animation ─────────────────────────────────
(function() {
  const fills = document.querySelectorAll('.bar-fill');
  const observer = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        const w = e.target.dataset.w;
        e.target.style.width = w + '%';
        observer.unobserve(e.target);
      }
    });
  }, { threshold: 0.1 });
  fills.forEach(f => observer.observe(f));
})();
</script>


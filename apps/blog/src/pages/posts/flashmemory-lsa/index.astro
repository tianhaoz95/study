<span class="cs-line"><span class="cmt">#   - ≈10-15% of full history on avg</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># DeepSeek-V4 already uses this hybrid:</span>
<span class="cs-line cmt"># FM adds Tier 3's selective paging.</span>
<span class="cs-line cmt"># All HCA layers remain unchanged.</span>
      </pre>
    </div>

    <!-- panel: indexer -->
    <div class="cs-panel" id="panel-indexer">
      <pre class="cs-pre">
<span class="cs-line cmt"># Memory Indexer: lookahead scoring</span>
<span class="cs-line cmt"># triggers every τ=64 decoding steps</span>
<span class="cs-line"></span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">lookahead_score</span>(h_t, K_IComp):</span>
<span class="cs-line"><span class="cmt">    # h_t: current query hidden state</span></span>
<span class="cs-line"><span class="cmt">    # K_IComp: compressed indexer keys (frozen)</span></span>
<span class="cs-line"></span>
<span class="cs-line">    <span class="cmt"># Project to low-rank indexer queries</span></span>
<span class="cs-line">    c_t = h_t @ W_DQ        <span class="cmt"># d → dc</span></span>
<span class="cs-line">    q_t = c_t @ W_IUQ       <span class="cmt"># dc → c*nlh</span></span>
<span class="cs-line">    w_t = h_t @ W_w         <span class="cmt"># d → nlh routing weights</span></span>
<span class="cs-line"></span>
<span class="cs-line hl-c">    <span class="cmt"># Head-fused gated matching (Eq. 4)</span></span>
<span class="cs-line hl-c">    score = sigmoid(</span>
<span class="cs-line hl-c">        sum_h( w_t[h] * relu(q_t[h] @ K_IComp.T) )</span>
<span class="cs-line hl-c">    )</span>
<span class="cs-line"></span>
<span class="cs-line hl-g">    <span class="cmt"># Dynamic threshold (not fixed Top-k)</span></span>
<span class="cs-line hl-g">    fetched = K_IComp[score &gt;= 0.5]</span>
<span class="cs-line hl-g">    <span class="kw">return</span> fetched</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Three layers (10, 12, 20) run in parallel</span>
<span class="cs-line cmt"># Union (OR-mode): fetch if ANY layer scores ≥ 0.5</span>
<span class="cs-line hl-a"><span class="kw">def</span> <span class="fn">multi_layer_fetch</span>(h_t, layers=[10,12,20]):</span>
<span class="cs-line hl-a">    masks = [score(h_t, K_l) &gt;= 0.5 <span class="kw">for</span> K_l <span class="kw">in</span> layers]</span>
<span class="cs-line hl-a">    <span class="kw">return</span> any_union(masks)  <span class="cmt"># OR</span></span>
      </pre>
    </div>

    <!-- panel: training -->
    <div class="cs-panel" id="panel-training">
      <pre class="cs-pre">
<span class="cs-line cmt"># Decoupled training — never loads backbone</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Pre-extract and store offline:</span>
<span class="cs-line hl-c"><span class="cmt">#   - K_IComp (frozen compressed keys)</span></span>
<span class="cs-line hl-c"><span class="cmt">#   - h_t for each decoding step</span></span>
<span class="cs-line hl-c"><span class="cmt">#   - Y_t+ (golden labels from voting pipeline)</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Focal Loss with BCE</span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">focal_bce</span>(p, y, gamma=2):</span>
<span class="cs-line">    p_correct = p * y + (1 - p) * (1 - y)</span>
<span class="cs-line">    weight = (1 - p_correct) ** gamma</span>
<span class="cs-line">    bce = -( y*log(p) + (1-y)*log(1-p) )</span>
<span class="cs-line">    <span class="kw">return</span> weight * bce</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Class imbalance handling:</span>
<span class="cs-line cmt">#   3:1 negative sampling (not alpha weight)</span>
<span class="cs-line cmt">#   --weighted-loss scheduler for hard samples</span>
<span class="cs-line"></span>
<span class="cs-line hl-g"><span class="cmt"># Trainable params: W_DQ, W_IUQ, W_w</span></span>
<span class="cs-line hl-g"><span class="cmt"># &lt; 0.1% of backbone parameter count</span></span>
<span class="cs-line hl-g"><span class="cmt"># Training cost: 1 H20 GPU-hour</span></span>
<span class="cs-line hl-g"><span class="cmt"># 500 runs executed in a single week!</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Key init choice: RANDOM (not backbone-loaded)</span>
<span class="cs-line cmt"># Avoids alignment-bias from host checkpoint</span>
      </pre>
    </div>

    <!-- panel: results -->
    <div class="cs-panel" id="panel-results">
      <pre class="cs-pre">
<span class="cs-line cmt"># Results summary — Table 1</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Average across all benchmarks:</span>
<span class="cs-line hl-a"><span class="cmt">#   DS-V4-Flash:  76.9%  (0.93 GB KV)</span></span>
<span class="cs-line hl-p"><span class="cmt">#   FM-DS-V4:     77.5%  (0.10 GB KV)  ← ours</span></span>
<span class="cs-line hl-a"><span class="cmt">#   Recency Only: 33.3%  (0.04 GB KV)</span></span>
<span class="cs-line hl-a"><span class="cmt">#   Random 10%:   38.7%  (0.12 GB KV)</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Memory reduction:</span>
<span class="cs-line hl-g"><span class="cmt">#   Average:   86.5% less KV cache</span></span>
<span class="cs-line hl-g"><span class="cmt">#   At 500K:   90.4% less (0.18 vs 1.87 GB)</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># "Less is more" on LongBench-v2-L 493K:</span>
<span class="cs-line hl-p"><span class="cmt">#   DS-V4-Flash:  68.1% (1.80 GB)</span></span>
<span class="cs-line hl-p"><span class="cmt">#   FM-DS-V4:     70.0% (0.18 GB)  +1.9%!</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Why "less is more"?</span>
<span class="cs-line cmt"># Irrelevant chunks pollute attention:</span>
<span class="cs-line cmt"># removing them = attention denoising.</span>
<span class="cs-line cmt"># FM acts as an expert sparse filter.</span>
      </pre>
    </div>

    <!-- panel: limits -->
    <div class="cs-panel" id="panel-limits">
      <pre class="cs-pre">
<span class="cs-line cmt"># Known failure modes</span>
<span class="cs-line"></span>
<span class="cs-line hl-a"><span class="cmt"># 1. Dense global memory (MRCR)</span></span>
<span class="cs-line"><span class="cmt">#   DS-V4-Flash:  76.0%</span></span>
<span class="cs-line"><span class="cmt">#   FM-DS-V4:     48.0%  ← -28% collapse!</span></span>
<span class="cs-line"><span class="cmt">#   Root cause: MRCR needs &gt;50% of</span></span>
<span class="cs-line"><span class="cmt">#   golden chunks even with oracle access.</span></span>
<span class="cs-line"><span class="cmt">#   Dual-encoder is too shallow to recall all.</span></span>
<span class="cs-line"></span>
<span class="cs-line hl-a"><span class="cmt"># 2. Length generalization ceiling</span></span>
<span class="cs-line"><span class="cmt">#   Safe: up to 2× training context</span></span>
<span class="cs-line"><span class="cmt">#   Training context: 512K</span></span>
<span class="cs-line"><span class="cmt">#   Safe limit: ~1M tokens</span></span>
<span class="cs-line"><span class="cmt">#   Beyond: positional OOD collapse</span></span>
<span class="cs-line"></span>
<span class="cs-line hl-c"><span class="cmt"># Future roadmap:</span></span>
<span class="cs-line"><span class="cmt">#   - Fine-tune K_IComp keys (frozen now)</span></span>
<span class="cs-line"><span class="cmt">#   - Late interaction (ColBERT-style)</span></span>
<span class="cs-line"><span class="cmt">#   - End-to-end joint optimization</span></span>
<span class="cs-line"><span class="cmt">#   - RoPE extension for >1M contexts</span></span>
      </pre>
    </div>

  </div>
</aside>

</div><!-- /post-grid -->

<script>
// ── TOC + sidebar toggles ────────────────────────────────────────────────
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});

const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ── Code sidebar tab switching ───────────────────────────────────────────
const tabMeta = {
  problem:  { file: 'lsa/memory_indexer.py',   title: 'The Memory Wall' },
  arch:     { file: 'lsa/arch.py',             title: 'Three-Tier Memory' },
  indexer:  { file: 'lsa/indexer.py',          title: 'Lookahead Indexer' },
  training: { file: 'lsa/train.py',            title: 'Decoupled Training' },
  results:  { file: 'lsa/eval.py',             title: 'Results' },
  limits:   { file: 'lsa/limitations.py',      title: 'Limits' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ── IntersectionObserver — sync TOC + sidebar on scroll ─────────────────
const sectionMap = {
  's-problem': 'problem',
  's-arch':    'arch',
  's-indexer': 'indexer',
  's-training':'training',
  's-results': 'results',
  's-limits':  'limits',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ── Step navigator (§03) ─────────────────────────────────────────────────
let step = 0;
const boxes   = document.querySelectorAll('.step-box');
const prevBtn = document.getElementById('step-prev');
const nextBtn = document.getElementById('step-next');
const progEl  = document.getElementById('step-prog');
function updateSteps() {
  boxes.forEach((b, i) => {
    b.classList.remove('active','done');
    if (i === step) b.classList.add('active');
    else if (i < step) b.classList.add('done');
  });
  if (prevBtn) prevBtn.disabled = step === 0;
  if (nextBtn) nextBtn.disabled = step === boxes.length - 1;
  if (progEl) progEl.textContent = 'Step ' + (step+1) + ' of ' + boxes.length;
  boxes.forEach((b, i) => {
    const n = b.querySelector('.step-num');
    if (n) n.textContent = i < step ? '✓' : String(i+1);
  });
}
prevBtn?.addEventListener('click', () => { if (step > 0) { step--; updateSteps(); } });
nextBtn?.addEventListener('click', () => { if (step < boxes.length - 1) { step++; updateSteps(); } });
updateSteps();

// ── Memory scaling line chart (§01) ──────────────────────────────────────
(function() {
  const canvas = document.getElementById('mem-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 240;
  canvas.width = W * DPR; canvas.height = H * DPR;
  ctx.scale(DPR, DPR);

  // Data: [contextK, memGB] for each method
  // DS-V4-Flash: linear 0.17@46K, 0.65@179K, 1.80@493K, 1.87@500K
  // FM-DS-V4: 0.04@46K, 0.08@179K, 0.18@493K, 0.18@500K
  // Recency: nearly flat ~0.03-0.04
  // Random 10%: 0.04, 0.09, 0.22, 0.22
  const DATA = {
    full:    [[46, 0.17],[179, 0.65],[493, 1.80],[512, 1.87]],
    lsa:     [[46, 0.04],[179, 0.08],[493, 0.18],[512, 0.18]],
    recency: [[46, 0.03],[179, 0.03],[493, 0.04],[512, 0.04]],
    rand10:  [[46, 0.04],[179, 0.09],[493, 0.22],[512, 0.22]],
  };
  const COLORS = { full:'#ef4444', lsa:'#8b5cf6', recency:'#6b7280', rand10:'#06b6d4' };

  const pad = { l:50, r:20, t:20, b:36 };
  const cW = W - pad.l - pad.r, cH = H - pad.t - pad.b;

  // Scales
  const maxCtx = 520, maxMem = 2.0;
  function cx(v) { return pad.l + (v / maxCtx) * cW; }
  function cy(v) { return pad.t + cH - (v / maxMem) * cH; }

  // Grid
  ctx.strokeStyle = 'rgba(255,255,255,0.05)';
  ctx.lineWidth = 1;
  [0.5,1.0,1.5,2.0].forEach(y => {
    ctx.beginPath(); ctx.moveTo(pad.l, cy(y)); ctx.lineTo(pad.l + cW, cy(y));
    ctx.stroke();
  });
  [128,256,384,512].forEach(x => {
    ctx.beginPath(); ctx.moveTo(cx(x), pad.t); ctx.lineTo(cx(x), pad.t + cH);
    ctx.stroke();
  });

  // Axes
  ctx.strokeStyle = 'rgba(255,255,255,0.15)';
  ctx.lineWidth = 1;
  ctx.beginPath(); ctx.moveTo(pad.l, pad.t); ctx.lineTo(pad.l, pad.t + cH); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(pad.l, pad.t + cH); ctx.lineTo(pad.l + cW, pad.t + cH); ctx.stroke();

  // Axis labels
  ctx.fillStyle = '#6b7280'; ctx.font = `${10 * DPR / DPR}px var(--ff-mono,monospace)`;
  ctx.textAlign = 'right';
  [0.5,1.0,1.5,2.0].forEach(y => {
    ctx.fillText(y.toFixed(1) + ' GB', pad.l - 5, cy(y) + 4);
  });
  ctx.textAlign = 'center';
  [128,256,384,512].forEach(x => {
    ctx.fillText(x + 'K', cx(x), pad.t + cH + 16);
  });
  ctx.fillStyle = '#4b5563';
  ctx.textAlign = 'left';
  ctx.fillText('context length (tokens)', pad.l + 2, pad.t + cH + 30);

  // Draw lines
  Object.entries(DATA).forEach(([key, pts]) => {
    ctx.beginPath();
    ctx.strokeStyle = COLORS[key];
    ctx.lineWidth = key === 'full' || key === 'lsa' ? 2.5 : 1.5;
    ctx.setLineDash(key === 'full' ? [5,3] : []);
    pts.forEach(([x,y], i) => {
      i === 0 ? ctx.moveTo(cx(x), cy(y)) : ctx.lineTo(cx(x), cy(y));
    });
    ctx.stroke();
    ctx.setLineDash([]);

    // Dots
    pts.forEach(([x,y]) => {
      ctx.beginPath();
      ctx.arc(cx(x), cy(y), key === 'lsa' || key === 'full' ? 4 : 3, 0, Math.PI*2);
      ctx.fillStyle = COLORS[key];
      ctx.fill();
    });
  });

  // Hover tooltip
  const note = document.getElementById('mem-note');
  canvas.addEventListener('mousemove', (e) => {
    const rect = canvas.getBoundingClientRect();
    const mx = e.clientX - rect.left, my = e.clientY - rect.top;
    let closest = null, bestDist = 16;
    const labels = { full:'DS-V4-Flash', lsa:'FM-DS-V4', recency:'Recency Only', rand10:'Random 10%' };
    Object.entries(DATA).forEach(([key, pts]) => {
      pts.forEach(([x,y]) => {
        const dx = cx(x) - mx, dy = cy(y) - my;
        const d = Math.sqrt(dx*dx + dy*dy);
        if (d < bestDist) { bestDist = d; closest = { key, x, y }; }
      });
    });
    if (closest) {
      note.textContent = labels[closest.key] + ' @ ' + closest.x + 'K: ' + closest.y.toFixed(2) + ' GB KV cache';
      note.style.color = COLORS[closest.key];
    } else {
      note.textContent = 'hover over a data point to see exact values';
      note.style.color = '';
    }
  });
})();

// ── Training cost contrast canvas (§04) ──────────────────────────────────
(function() {
  const canvas = document.getElementById('train-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 200;
  canvas.width = W * DPR; canvas.height = H * DPR;
  ctx.scale(DPR, DPR);

  function roundRect(ctx, x, y, w, h, r, fill, stroke) {
    ctx.beginPath();
    ctx.roundRect(x, y, w, h, r);
    if (fill) { ctx.fillStyle = fill; ctx.fill(); }
    if (stroke) { ctx.strokeStyle = stroke; ctx.lineWidth = 1.5; ctx.stroke(); }
  }

  const half = W / 2;

  // Left panel: joint distillation (expensive)
  roundRect(ctx, 10, 10, half - 20, H - 20, 8, 'rgba(239,68,68,.08)', 'rgba(239,68,68,.3)');
  ctx.fillStyle = '#f87171'; ctx.font = `bold ${11}px var(--ff-mono,monospace)`;
  ctx.textAlign = 'center';
  ctx.fillText('Standard Fine-Tuning', half/2, 32);

  // Backbone block
  roundRect(ctx, 28, 46, half - 56, 48, 6, 'rgba(239,68,68,.2)', 'rgba(239,68,68,.5)');
  ctx.fillStyle = '#fca5a5'; ctx.font = `bold ${10}px var(--ff-mono,monospace)`;
  ctx.textAlign = 'center';
  ctx.fillText('Backbone LLM (~1T params)', half/2, 66);
  ctx.fillStyle = '#6b7280'; ctx.font = `${9}px var(--ff-mono,monospace)`;
  ctx.fillText('must load entire model into GPU', half/2, 82);

  // Cost label
  roundRect(ctx, 28, 110, half - 56, 30, 5, 'rgba(239,68,68,.15)', 'rgba(239,68,68,.4)');
  ctx.fillStyle = '#f87171'; ctx.font = `bold ${10}px var(--ff-mono,monospace)`;
  ctx.textAlign = 'center';
  ctx.fillText('days on a large GPU cluster', half/2, 130);

  // Right panel: decoupled (cheap)
  roundRect(ctx, half + 10, 10, half - 20, H - 20, 8, 'rgba(139,92,246,.08)', 'rgba(139,92,246,.3)');
  ctx.fillStyle = '#a78bfa'; ctx.font = `bold ${11}px var(--ff-mono,monospace)`;
  ctx.textAlign = 'center';
  ctx.fillText('FlashMemory Decoupled', W - half/2, 32);

  // Pre-extracted data block
  roundRect(ctx, half + 28, 46, half - 56, 48, 6, 'rgba(139,92,246,.18)', 'rgba(139,92,246,.4)');
  ctx.fillStyle = '#c4b5fd'; ctx.font = `bold ${10}px var(--ff-mono,monospace)`;
  ctx.textAlign = 'center';
  ctx.fillText('Pre-extracted: h_t, K_IComp, Y+', W - half/2, 66);
  ctx.fillStyle = '#6b7280'; ctx.font = `${9}px var(--ff-mono,monospace)`;
  ctx.fillText('backbone never loaded at train time', W - half/2, 82);

  // Cost label
  roundRect(ctx, half + 28, 110, half - 56, 30, 5, 'rgba(139,92,246,.15)', 'rgba(139,92,246,.4)');
  ctx.fillStyle = '#a78bfa'; ctx.font = `bold ${10}px var(--ff-mono,monospace)`;
  ctx.textAlign = 'center';
  ctx.fillText('1 H20 GPU-hour per run', W - half/2, 130);

  // Trainable params note
  ctx.fillStyle = '#6b7280'; ctx.font = `${9}px var(--ff-mono,monospace)`;
  ctx.textAlign = 'center';
  ctx.fillText('&lt; 0.1% of backbone params', W - half/2, 160);

  // VS divider
  ctx.fillStyle = '#374151'; ctx.font = `bold ${13}px var(--ff-mono,monospace)`;
  ctx.textAlign = 'center';
  ctx.fillText('VS', W/2, H/2 + 5);
})();

// ── Animated bar chart (§05) ──────────────────────────────────────────────
const barsSection = document.getElementById('s-results');
if (barsSection) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('#acc-bars .bar-fill[data-w]').forEach(b => {
          b.style.width = (parseFloat(b.dataset.w)) + '%';
        });
      }
    });
  }, { threshold: 0.3 }).observe(barsSection);
}
</script>
</BaseLayout>

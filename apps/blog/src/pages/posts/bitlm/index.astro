// ── §01: Generation compare animation ──
(function() {
  const tokens = ['the', 'cat', 'sat', 'on', 'the', 'mat', 'by', 'now'];
  const arSlotsEl  = document.getElementById('ar-slots');
  const bmSlotsEl  = document.getElementById('bm-slots');
  const arLabel    = document.getElementById('ar-step-label');
  const bmLabel    = document.getElementById('bm-step-label');
  const progEl     = document.getElementById('gen-progress');
  const playBtn    = document.getElementById('gen-play');
  const resetBtn   = document.getElementById('gen-reset');

  function buildSlots(container, n) {
    container.innerHTML = '';
    for (let i = 0; i < n; i++) {
      const s = document.createElement('div');
      s.className = 'token-slot';
      s.textContent = '?';
      container.appendChild(s);
    }
  }
  buildSlots(arSlotsEl, 8);
  buildSlots(bmSlotsEl, 8);

  let step = 0;
  const TOTAL_STEPS = 16; // 8 AR steps + (2 backbone calls * 4 = 8 block steps for BitLM)

  function getArState(s) {
    // AR fills token by token, 1 token per step (step 1-8)
    const filled = Math.min(s, 8);
    return filled;
  }
  function getBmState(s) {
    // BitLM fills in 2 backbone calls: block1 at step 8, block2 at step 16
    // We represent as: K denoising sub-steps happen before each commit
    if (s <= 8) {
      // First block denoising: progress 0->1 over steps 0-8
      return { block: 0, progress: s / 8, committed1: false, committed2: false };
    } else {
      return { block: 1, progress: (s - 8) / 8, committed1: true, committed2: (s >= 16) };
    }
  }

  function render() {
    const arFilled = getArState(step);
    const arSlots = arSlotsEl.querySelectorAll('.token-slot');
    arSlots.forEach((slot, i) => {
      if (i < arFilled) {
        slot.className = 'token-slot filled-ar';
        slot.textContent = tokens[i];
      } else {
        slot.className = 'token-slot';
        slot.textContent = '?';
      }
    });
    arLabel.textContent = step <= 8
      ? `backbone call ${arFilled} / 8 — token "${tokens[arFilled-1] || '?'}"${arFilled > 0 ? ' committed' : ''}`
      : `done — 8 backbone calls total`;

    const bm = getBmState(step);
    const bmSlots = bmSlotsEl.querySelectorAll('.token-slot');
    bmSlots.forEach((slot, i) => {
      const inBlock1 = i < 4;
      const inBlock2 = i >= 4;
      if (bm.committed1 && inBlock1) {
        slot.className = 'token-slot filled-bm';
        slot.textContent = tokens[i];
      } else if (bm.committed2 && inBlock2) {
        slot.className = 'token-slot filled-bm';
        slot.textContent = tokens[i];
      } else if (!bm.committed1 && inBlock1) {
        const p = bm.progress;
        slot.className = 'token-slot';
        slot.textContent = p > 0.6 ? `~${tokens[i]}` : (p > 0.3 ? '...' : '?');
        slot.style.opacity = 0.4 + p * 0.6;
        slot.style.borderColor = `rgba(139,92,246,${p * 0.8})`;
      } else if (bm.committed1 && !bm.committed2 && inBlock2) {
        const p = bm.progress;
        slot.className = 'token-slot';
        slot.textContent = p > 0.6 ? `~${tokens[i]}` : (p > 0.3 ? '...' : '?');
        slot.style.opacity = 0.4 + p * 0.6;
        slot.style.borderColor = `rgba(139,92,246,${p * 0.8})`;
      } else {
        slot.className = 'token-slot';
        slot.textContent = '?';
        slot.style.opacity = '';
        slot.style.borderColor = '';
      }
    });
    const bcalls = bm.committed2 ? 2 : (bm.committed1 ? 1 : 0);
    bmLabel.textContent = bm.committed2
      ? 'done — 2 backbone calls (4 tokens each)'
      : (bm.committed1
        ? `backbone call 2 / 2 — denoising block 2 (${Math.round(bm.progress*100)}%)`
        : `backbone call 1 / 2 — denoising block 1 (${Math.round(bm.progress*100)}%)`);

    progEl.textContent = `step ${step} / ${TOTAL_STEPS}`;
    playBtn.disabled = step >= TOTAL_STEPS;
  }

  let raf = null;
  function animate() {
    if (step >= TOTAL_STEPS) { playBtn.textContent = '▶ Play'; return; }
    step++;
    render();
    raf = setTimeout(animate, 280);
  }

  playBtn.addEventListener('click', () => {
    if (step >= TOTAL_STEPS) return;
    playBtn.disabled = true;
    animate();
  });
  resetBtn.addEventListener('click', () => {
    clearTimeout(raf);
    step = 0;
    playBtn.disabled = false;
    playBtn.textContent = '▶ Play';
    buildSlots(arSlotsEl, 8);
    buildSlots(bmSlotsEl, 8);
    arLabel.textContent = 'waiting...';
    bmLabel.textContent = 'waiting...';
    progEl.textContent = 'step 0 / 16';
  });
  render();
})();

// ── §02: Hypercube canvas ──
(function() {
  const canvas = document.getElementById('cube-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth || 480;
  const H = 300;
  canvas.width  = W * DPR;
  canvas.height = H * DPR;
  ctx.scale(DPR, DPR);

  // 3-bit cube: 8 vertices at (±1, ±1, ±1)
  // Project to 2D with isometric-like projection
  // bit0 -> X-right, bit1 -> X-left (isometric), bit2 -> Y-up
  const cx = W/2, cy = H/2;
  function proj(b0, b1, b2) {
    const x3 = b0 * 60 + b1 * (-40);
    const y3 = -b2 * 80 + b1 * 30;
    return [cx + x3, cy + y3];
  }

  // Vertices: bit values 0/1 -> display as -1/+1
  const vertices = [];
  for (let b2=0; b2<=1; b2++) for (let b1=0; b1<=1; b1++) for (let b0=0; b0<=1; b0++) {
    vertices.push({b0,b1,b2, id: b0 | (b1<<1) | (b2<<2)});
  }

  const LABELS = [
    { id: 0, name: '"a"',   color: '#06b6d4' },
    { id: 1, name: '"the"', color: '#06b6d4' },
    { id: 2, name: '"cat"', color: '#8b5cf6' },
    { id: 3, name: '"dog"', color: '#8b5cf6' },
    { id: 4, name: '"sat"', color: '#10b981' },
    { id: 5, name: '"on"',  color: '#10b981' },
    { id: 6, name: '"in"',  color: '#f59e0b' },
    { id: 7, name: '"mat"', color: '#f59e0b' },
  ];

  let hovered = -1;

  function draw() {
    ctx.clearRect(0, 0, W, H);

    // Draw edges
    const edges = [
      [0,1],[0,2],[0,4],[1,3],[1,5],[2,3],[2,6],[3,7],[4,5],[4,6],[5,7],[6,7]
    ];
    edges.forEach(([a,b]) => {
      const va = vertices[a], vb = vertices[b];
      const [ax,ay] = proj(va.b0*2-1, va.b1*2-1, va.b2*2-1);
      const [bx,by] = proj(vb.b0*2-1, vb.b1*2-1, vb.b2*2-1);
      ctx.beginPath();
      ctx.moveTo(ax,ay); ctx.lineTo(bx,by);
      ctx.strokeStyle = 'rgba(71,85,105,0.6)';
      ctx.lineWidth = 1;
      ctx.stroke();
    });

    // Draw vertices + labels
    vertices.forEach((v,i) => {
      const [x,y] = proj(v.b0*2-1, v.b1*2-1, v.b2*2-1);
      const lbl = LABELS[i];
      const isHov = hovered === i;

      ctx.beginPath();
      ctx.arc(x, y, isHov ? 7 : 5, 0, Math.PI*2);
      ctx.fillStyle = lbl.color;
      ctx.globalAlpha = isHov ? 1 : 0.75;
      ctx.fill();
      ctx.globalAlpha = 1;

      ctx.font = isHov ? 'bold 11px var(--ff-mono,monospace)' : '10px var(--ff-mono,monospace)';
      ctx.fillStyle = lbl.color;
      ctx.fillText(lbl.name, x + 9, y + 4);

      // bit code
      ctx.font = '8px var(--ff-mono,monospace)';
      ctx.fillStyle = 'rgba(100,116,139,0.8)';
      const bits = `${v.b2}${v.b1}${v.b0}`;
      ctx.fillText(bits, x + 9, y + 15);
    });

    // Axis labels
    ctx.font = '9px var(--ff-mono,monospace)';
    ctx.fillStyle = 'rgba(100,116,139,0.6)';
    ctx.fillText('bit₀', cx+65, cy+8);
    ctx.fillText('bit₁', cx-70, cy+25);
    ctx.fillText('bit₂', cx+6, cy-82);

    // Title
    ctx.font = '9px var(--ff-mono,monospace)';
    ctx.fillStyle = 'rgba(100,116,139,0.5)';
    ctx.fillText('3-bit hypercube — 8 token vocabulary at corners', 10, H-10);
  }

  draw();

  // Hover detection
  canvas.addEventListener('mousemove', e => {
    const rect = canvas.getBoundingClientRect();
    const mx = (e.clientX - rect.left);
    const my = (e.clientY - rect.top);
    let closest = -1, minDist = 20;
    vertices.forEach((v,i) => {
      const [x,y] = proj(v.b0*2-1, v.b1*2-1, v.b2*2-1);
      const d = Math.hypot(mx-x, my-y);
      if (d < minDist) { minDist = d; closest = i; }
    });
    if (closest !== hovered) { hovered = closest; draw(); }
  });
  canvas.addEventListener('mouseleave', () => { hovered = -1; draw(); });
})();

// ── §04: Denoising canvas ──
(function() {
  const canvas = document.getElementById('denoise-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;

  function resize() {
    const W = canvas.parentElement.clientWidth - 40;
    const H = 220;
    canvas.width  = W * DPR;
    canvas.height = H * DPR;
    canvas.style.height = H + 'px';
    ctx.scale(DPR, DPR);
    return [W, H];
  }
  let [W, H] = resize();

  const K_MAX = 15;
  let currentStep = 0;
  let rafId = null;

  // Target tokens: "the"=279, "cat"=7114, "sat"=7156, "on"=389
  const TARGET_IDS = [279, 7114, 7156, 389];
  const TOKEN_NAMES = ['"the"', '"cat"', '"sat"', '"on"'];
  const B = 18;

  function getBit(tokenId, b) { return ((tokenId >> b) & 1) === 1 ? 1 : -1; }

  // Seeded PRNG for reproducible noise
  function seededRand(seed) {
    let s = seed;
    return () => { s = (s * 1103515245 + 12345) & 0x7fffffff; return (s / 0x7fffffff) * 2 - 1; };
  }

  // Compute bit values at step k (linear interpolation from noise to target)
  function bitValue(tokenIdx, bitIdx, step) {
    const rng = seededRand(tokenIdx * 100 + bitIdx * 7 + 42);
    const noise = rng() * 0.8;   // initial noise value in (-0.8, 0.8)
    const target = getBit(TARGET_IDS[tokenIdx], bitIdx);
    const t = step / K_MAX;      // 0 = no denoise, 1 = fully denoised
    return noise * (1 - t) + target * t;
  }

  function draw() {
    const W = canvas.width / DPR;
    const H = canvas.height / DPR;
    ctx.save();
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
    ctx.clearRect(0, 0, W, H);

    const margin = 10;
    const labelW = 60;
    const bitW = (W - margin*2 - labelW) / B;
    const rowH = (H - 40) / 4;

    // Column header (bit indices)
    ctx.font = '8px var(--ff-mono,monospace)';
    ctx.fillStyle = 'rgba(100,116,139,0.5)';
    for (let b = 0; b < B; b++) {
      if (b % 3 === 0) {
        const x = margin + labelW + b * bitW + bitW/2;
        ctx.fillText(`b${b}`, x - 6, 12);
      }
    }

    for (let tok = 0; tok < 4; tok++) {
      const y = 24 + tok * rowH;

      // Token label
      ctx.font = 'bold 10px var(--ff-mono,monospace)';
      ctx.fillStyle = '#c4b5fd';
      ctx.fillText(TOKEN_NAMES[tok], margin, y + rowH/2 + 4);

      for (let b = 0; b < B; b++) {
        const val = bitValue(tok, b, currentStep);
        const x = margin + labelW + b * bitW;
        const absVal = Math.abs(val);

        // Background
        ctx.fillStyle = val > 0
          ? `rgba(59,130,246,${absVal * 0.7})`
          : `rgba(239,68,68,${absVal * 0.7})`;
        ctx.fillRect(x+1, y+4, bitW-2, rowH-8);

        // Committed marker (near ±1)
        if (absVal > 0.85) {
          ctx.fillStyle = val > 0 ? 'rgba(96,165,250,0.9)' : 'rgba(252,165,165,0.9)';
          ctx.fillRect(x+2, y+5, bitW-4, rowH-10);
          ctx.font = '7px var(--ff-mono,monospace)';
          ctx.fillStyle = '#fff';
          ctx.fillText(val > 0 ? '+1' : '-1', x+1, y + rowH/2 + 3);
        }
      }
    }

    // Step indicator
    ctx.font = '9px var(--ff-mono,monospace)';
    ctx.fillStyle = 'rgba(139,92,246,0.8)';
    ctx.fillText(`t = ${(1 - currentStep/K_MAX).toFixed(2)}  →  step ${currentStep} / ${K_MAX}`, margin, H - 6);
    ctx.restore();
  }

  draw();

  const prevBtn  = document.getElementById('dn-prev');
  const nextBtn  = document.getElementById('dn-next');
  const playBtn  = document.getElementById('dn-play');
  const resetBtn = document.getElementById('dn-reset');
  const kLabel   = document.getElementById('dn-k-label');
  const infoEl   = document.getElementById('dn-info');

  function updateUI() {
    kLabel.textContent = `step ${currentStep} / ${K_MAX}`;
    prevBtn.disabled = currentStep <= 0;
    nextBtn.disabled = currentStep >= K_MAX;
    if (currentStep === 0) infoEl.textContent = 'noise — no commitment yet';
    else if (currentStep < 5) infoEl.textContent = 'early steps — coarse bit direction forming';
    else if (currentStep < 10) infoEl.textContent = 'mid steps — high-order bits locking in';
    else if (currentStep < K_MAX) infoEl.textContent = 'late steps — fine bits committing';
    else infoEl.textContent = 'done — all bits committed, sign() → token IDs';
    playBtn.disabled = currentStep >= K_MAX;
  }

  prevBtn.addEventListener('click', () => { if (currentStep > 0) { currentStep--; draw(); updateUI(); } });
  nextBtn.addEventListener('click', () => { if (currentStep < K_MAX) { currentStep++; draw(); updateUI(); } });
  playBtn.addEventListener('click', () => {
    if (currentStep >= K_MAX) return;
    function tick() {
      currentStep++;
      draw(); updateUI();
      if (currentStep < K_MAX) rafId = setTimeout(tick, 200);
    }
    tick();
  });
  resetBtn.addEventListener('click', () => {
    clearTimeout(rafId);
    currentStep = 0; draw(); updateUI();
  });
  updateUI();
})();

// ── §05: CFG ablation line chart ──
(function() {
  const canvas = document.getElementById('cfg-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth || 500;
  const H = 200;
  canvas.width  = W * DPR;
  canvas.height = H * DPR;
  canvas.style.height = H + 'px';
  ctx.scale(DPR, DPR);

  const data = {
    cfg10: [18.2, 19.5, 20.2, 20.8, 21.1, 21.3, 21.4, 21.5, 21.6, 21.7, 21.7, 21.7, 21.7, 21.8, 21.7],
    cfg50: [16.9, 19.0, 20.7, 22.3, 22.9, 23.3, 23.5, 23.6, 23.7, 23.9, 24.0, 24.1, 24.1, 24.1, 24.0],
    cfg90: [14.5, 17.8, 20.0, 22.0, 23.1, 23.8, 24.3, 24.7, 24.9, 25.1, 25.3, 25.6, 25.8, 26.0, 26.05],
  };

  const pad = { l: 45, r: 20, t: 20, b: 30 };
  const pw = W - pad.l - pad.r;
  const ph = H - pad.t - pad.b;
  const minY = 12, maxY = 28;

  function xp(i) { return pad.l + (i / 14) * pw; }
  function yp(v) { return pad.t + (1 - (v - minY) / (maxY - minY)) * ph; }

  // Grid
  ctx.strokeStyle = 'rgba(255,255,255,0.04)';
  ctx.lineWidth = 1;
  for (let v = 14; v <= 28; v += 2) {
    ctx.beginPath(); ctx.moveTo(pad.l, yp(v)); ctx.lineTo(pad.l + pw, yp(v)); ctx.stroke();
    ctx.font = '9px var(--ff-mono,monospace)';
    ctx.fillStyle = 'rgba(100,116,139,0.7)';
    ctx.fillText(v.toFixed(0), pad.l - 28, yp(v) + 3);
  }

  // Axes
  ctx.strokeStyle = 'rgba(100,116,139,0.4)';
  ctx.lineWidth = 1;
  ctx.beginPath(); ctx.moveTo(pad.l, pad.t); ctx.lineTo(pad.l, pad.t+ph); ctx.lineTo(pad.l+pw, pad.t+ph); ctx.stroke();

  // X labels
  [1,5,10,15].forEach(k => {
    const i = k-1;
    ctx.font = '9px var(--ff-mono,monospace)';
    ctx.fillStyle = 'rgba(100,116,139,0.7)';
    ctx.fillText(`K=${k}`, xp(i) - 10, pad.t + ph + 15);
  });

  // Axis labels
  ctx.save();
  ctx.translate(12, pad.t + ph/2);
  ctx.rotate(-Math.PI/2);
  ctx.font = '9px var(--ff-mono,monospace)';
  ctx.fillStyle = 'rgba(100,116,139,0.5)';
  ctx.fillText('ROUGE-1', -22, 0);
  ctx.restore();

  // Lines
  function drawLine(vals, color) {
    ctx.beginPath();
    ctx.strokeStyle = color;
    ctx.lineWidth = 2;
    vals.forEach((v,i) => {
      const x = xp(i), y = yp(v);
      i === 0 ? ctx.moveTo(x,y) : ctx.lineTo(x,y);
    });
    ctx.stroke();
    // Dot at K=15
    const last = vals[14];
    ctx.beginPath();
    ctx.arc(xp(14), yp(last), 4, 0, Math.PI*2);
    ctx.fillStyle = color;
    ctx.fill();
    ctx.font = '9px var(--ff-mono,monospace)';
    ctx.fillStyle = color;
    ctx.fillText(last.toFixed(1), xp(14)+6, yp(last)+4);
  }

  drawLine(data.cfg10, '#ef4444');
  drawLine(data.cfg50, '#f59e0b');
  drawLine(data.cfg90, '#8b5cf6');

  // Star marker at best
  ctx.font = '11px serif';
  ctx.fillStyle = '#8b5cf6';
  ctx.fillText('★ best', xp(14)-38, yp(26.05)-8);
})();

// ── §06: Animated bar chart ──
new IntersectionObserver(entries => {
  entries.forEach(e => {
    if (e.isIntersecting) {
      document.querySelectorAll('.bar-fill[data-w]').forEach(b => {
        const maxR = 29.70;
        const pct = parseFloat(b.dataset.w);
        b.style.width = (pct / 100 * 100) + '%';
      });
    }
  });
}, { threshold: 0.3 }).observe(document.getElementById('s-results'));
</script>
</BaseLayout>

const readTime = postReadTime(Astro.url.pathname.split('/').filter(Boolean).at(-1)!);
---
<BaseLayout
  title="BitLM: Generating Phrases, Not Tokens, with Binary Diffusion | AI/ML Deep Dives"
  description="BitLM replaces the vocabulary softmax with an 18-bit binary code and a diffusion head that jointly denoises a block of 4 tokens at once — making parallel block-level generation native, not a post-hoc trick."
  crumb="BitLM"
>


/* ─────────────── §03 state-space canvas ─────────────── */
(function () {
  const canvas = document.getElementById('ss-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  let W = 0, H = 340;
  function size() {
    W = canvas.clientWidth;
    canvas.width = W * DPR; canvas.height = H * DPR;
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
  }
  function sr(n){ return ((1664525*n+1013904223)&0x7fffffff)/0x7fffffff; }

  let mode = 'sft', t = 0;
  const cap = document.getElementById('ss-cap');
  const caps = {
    sft: '<b>SFT (off-policy):</b> the red markers — dataset states — sit largely <b>outside</b> the model\'s reachable cloud. Dense updates pull the policy toward them, dragging it out of territory it can recover from. This is how stress SFT forgets.',
    rl:  '<b>RL (on-policy):</b> every green marker is drawn from the model\'s own rollouts, so all supervision lands <b>inside</b> the cloud. Sparse reward, but local — a safe, recoverable improvement.',
    opd: '<b>OPD:</b> the student samples states <b>inside</b> the cloud (green), and the teacher fires short cyan continuation-arrows as local repairs. Teacher <i>signal</i>, student <i>states</i> — on-policy where it counts.',
  };

  // model reachable cloud centroid
  const cx = () => W * 0.42, cy = () => H * 0.52, rx = () => W * 0.26, ry = () => H * 0.34;

  function inCloud(i, n) {
    const a = sr(i*3) * Math.PI * 2;
    const rad = 0.25 + sr(i*3+1) * 0.7;
    return { x: cx() + Math.cos(a) * rx() * rad, y: cy() + Math.sin(a) * ry() * rad };
  }
  function offCloud(i) {
    // scattered, biased to the right / outside
    return { x: W*0.62 + sr(i*5+2) * W*0.30, y: H*0.12 + sr(i*5+3) * H*0.76 };
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    // reachable cloud (soft green radial)
    const g = ctx.createRadialGradient(cx(), cy(), 10, cx(), cy(), Math.max(rx(), ry()));
    g.addColorStop(0, 'rgba(16,185,129,0.20)');
    g.addColorStop(1, 'rgba(16,185,129,0)');
    ctx.fillStyle = g;
    ctx.beginPath(); ctx.ellipse(cx(), cy(), rx()*1.25, ry()*1.25, 0, 0, Math.PI*2); ctx.fill();
    ctx.strokeStyle = 'rgba(16,185,129,0.35)';
    ctx.setLineDash([5,5]); ctx.lineWidth = 1.2;
    ctx.beginPath(); ctx.ellipse(cx(), cy(), rx(), ry(), 0, 0, Math.PI*2); ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle = 'rgba(16,185,129,0.8)';
    ctx.font = '11px monospace';
    ctx.fillText("model's reachable states", cx()-rx()+4, cy()-ry()-8);

    const pulse = 0.5 + 0.5*Math.sin(t*0.05);

    if (mode === 'sft') {
      // on-policy faint green dots
      for (let i=0;i<22;i++){ const p=inCloud(i,22); dot(p.x,p.y,2.5,'rgba(16,185,129,0.25)'); }
      // off-policy red dataset states + supervision arrows from cloud center
      for (let i=0;i<14;i++){
        const p=offCloud(i);
        // arrow pulling policy toward off-policy state
        arrow(cx()+ (sr(i*7)-0.5)*rx(), cy()+(sr(i*7+1)-0.5)*ry(), p.x, p.y, `rgba(248,113,113,${0.25+0.35*pulse})`);
        dot(p.x,p.y,5,'#f87171');
      }
      tag('dataset states (off-policy)', W*0.66, H*0.07, '#f87171');
    } else if (mode === 'rl') {
      for (let i=0;i<26;i++){
        const p=inCloud(i,26);
        dot(p.x,p.y,4.5,`rgba(16,185,129,${0.5+0.4*sr(i*9)})`);
      }
      // a few sparse reward stars inside
      for (let i=0;i<5;i++){ const p=inCloud(i*3+1,26); star(p.x,p.y,7,`rgba(245,158,11,${0.6+0.4*pulse})`); }
      tag('reward on policy states (sparse)', cx()-rx()+4, H*0.93, 'var');
    } else {
      // OPD: student dots in cloud + teacher continuation arrows
      for (let i=0;i<22;i++){
        const p=inCloud(i,22);
        dot(p.x,p.y,4.5,'rgba(16,185,129,0.85)');
        if (i%2===0){
          const a = sr(i*11)*Math.PI*2;
          arrow(p.x,p.y, p.x+Math.cos(a)*26, p.y+Math.sin(a)*22, `rgba(6,182,212,${0.4+0.4*pulse})`);
        }
      }
      // degraded teacher: red dots OUTSIDE, not used as states
      for (let i=0;i<8;i++){ const p=offCloud(i); dot(p.x,p.y,4,'rgba(248,113,113,0.45)'); }
      tag('student states + teacher continuations', cx()-rx()+4, H*0.93, '#06b6d4');
      tag('teacher\'s own bad states (not visited)', W*0.66, H*0.07, '#f87171');
    }
    t++;
    raf = requestAnimationFrame(draw);
  }

  function dot(x,y,r,c){ ctx.fillStyle=c; ctx.beginPath(); ctx.arc(x,y,r,0,Math.PI*2); ctx.fill(); }
  function star(x,y,r,c){ ctx.fillStyle=c; ctx.beginPath();
    for(let k=0;k<10;k++){ const ang=Math.PI/5*k-Math.PI/2; const rr=k%2?r*0.45:r;
      const px=x+Math.cos(ang)*rr, py=y+Math.sin(ang)*rr; k?ctx.lineTo(px,py):ctx.moveTo(px,py);} ctx.closePath(); ctx.fill(); }
  function arrow(x1,y1,x2,y2,c){
    ctx.strokeStyle=c; ctx.lineWidth=1.6; ctx.beginPath(); ctx.moveTo(x1,y1); ctx.lineTo(x2,y2); ctx.stroke();
    const a=Math.atan2(y2-y1,x2-x1);
    ctx.fillStyle=c; ctx.beginPath(); ctx.moveTo(x2,y2);
    ctx.lineTo(x2-7*Math.cos(a-0.4),y2-7*Math.sin(a-0.4));
    ctx.lineTo(x2-7*Math.cos(a+0.4),y2-7*Math.sin(a+0.4)); ctx.closePath(); ctx.fill();
  }
  function tag(txt,x,y,col){
    ctx.font='11px monospace';
    ctx.fillStyle = col==='var' ? 'rgba(245,158,11,0.85)' : col;
    ctx.fillText(txt,x,y);
  }

  let raf;
  document.querySelectorAll('[data-ss]').forEach(b => b.addEventListener('click', () => {
    mode = b.dataset.ss;
    document.querySelectorAll('[data-ss]').forEach(x => x.classList.toggle('active', x===b));
    if (cap) cap.innerHTML = caps[mode];
  }));
  if (cap) cap.innerHTML = caps.sft;
  window.addEventListener('resize', size);
  size();
  cancelAnimationFrame(raf); draw();
})();

/* ─────────────── §04 SFT pressure ─────────────── */
(function () {
  const data = {
    mild:   { gsm: 0.512, ret: 1.001, gsmW: 51.2, retW: 100,
              cap: '<b>Mild SFT</b> (1 epoch, low lr): GSM8K rises to <b>0.512</b> and retention is <b>1.001</b> — the dataset states stay compatible with the base policy, so nothing breaks. SFT is not inherently destructive.' },
    stress: { gsm: 0.420, ret: 0.826, gsmW: 42.0, retW: 82.6,
              cap: '<b>Stress SFT</b> (5 epochs, lr 5e-4, LoRA rank 64): retention collapses to <b>0.826</b> AND GSM8K drops to <b>0.420</b> — below the 0.448 base. Aggressive off-policy pressure damages both general and target behavior.' },
  };
  const pills = document.getElementById('sft-pills');
  const gsmBar = document.getElementById('sft-bar-gsm');
  const retBar = document.getElementById('sft-bar-ret');
  const cap = document.getElementById('sft-cap');
  function set(m) {
    const d = data[m];
    document.querySelectorAll('[data-sft]').forEach(b => b.classList.toggle('active', b.dataset.sft === m));
    const dgsm = (d.gsm - 0.448), dret = (d.ret - 1);
    pills.innerHTML = `
      <div class="stat-pill ${dgsm>=0?'up':'down'}"><div class="pv">${d.gsm.toFixed(3)}</div><div class="pl">GSM8K (base 0.448)</div></div>
      <div class="stat-pill ${dret>=-0.001?'up':'down'}"><div class="pv">${d.ret.toFixed(3)}</div><div class="pl">retention ratio</div></div>
      <div class="stat-pill ${dgsm>=0?'up':'down'}"><div class="pv">${dgsm>=0?'+':''}${(dgsm).toFixed(3)}</div><div class="pl">Δ GSM8K vs base</div></div>`;
    gsmBar.style.width = d.gsmW + '%';
    gsmBar.querySelector('span').textContent = d.gsm.toFixed(3);
    gsmBar.style.background = m==='stress' ? '#f87171' : 'var(--cyan)';
    retBar.style.width = d.retW + '%';
    retBar.querySelector('span').textContent = d.ret.toFixed(3);
    retBar.style.background = m==='stress' ? '#f87171' : 'var(--green)';
    if (cap) cap.innerHTML = d.cap;
  }
  document.querySelectorAll('[data-sft]').forEach(b => b.addEventListener('click', () => set(b.dataset.sft)));
  // animate in on scroll
  const sec = document.getElementById('s-sft');
  if (sec) new IntersectionObserver((es, ob) => {
    es.forEach(e => { if (e.isIntersecting) { set('mild'); } });
  }, { threshold: 0.3 }).observe(sec);
  set('mild');
})();

/* ─────────────── §05 OPD canvas ─────────────── */
(function () {
  const canvas = document.getElementById('opd-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  let W = 0, H = 320;
  function size() {
    W = canvas.clientWidth; canvas.width = W*DPR; canvas.height = H*DPR;
    ctx.setTransform(DPR,0,0,DPR,0,0);
  }
  function sr(n){ return ((1664525*n+1013904223)&0x7fffffff)/0x7fffffff; }

  // teacher path (red): wanders down into bad region
  // student path (green): steadier, with teacher continuation arrows
  const N = 6;
  function teacherPts(){ const a=[]; for(let i=0;i<=N;i++){ const x=W*0.1+i/N*W*0.8; const y=H*0.3 + Math.sin(i*0.9)*H*0.05 + i*H*0.07; a.push({x,y}); } return a; }
  function studentPts(){ const a=[]; for(let i=0;i<=N;i++){ const x=W*0.1+i/N*W*0.8; const y=H*0.42 - Math.sin(i*0.7)*H*0.04; a.push({x,y}); } return a; }

  let prog = 0, raf, running = false;
  function draw() {
    ctx.clearRect(0,0,W,H);
    const T = teacherPts(), S = studentPts();
    const shown = Math.floor(prog * N) + 1;

    // teacher full faded path
    ctx.strokeStyle='rgba(248,113,113,0.5)'; ctx.lineWidth=2; ctx.setLineDash([6,5]);
    ctx.beginPath(); T.forEach((p,i)=> i?ctx.lineTo(p.x,p.y):ctx.moveTo(p.x,p.y)); ctx.stroke();
    ctx.setLineDash([]);
    T.forEach((p,i)=>{ ctx.fillStyle='rgba(248,113,113,0.7)'; ctx.beginPath(); ctx.arc(p.x,p.y,4,0,Math.PI*2); ctx.fill(); });
    ctx.fillStyle='rgba(248,113,113,0.95)'; ctx.font='12px monospace';
    ctx.fillText('teacher: degraded global trajectory (NOT copied)', T[0].x, T[0].y-14);
    ctx.fillText('✗ bad states', T[N].x-70, T[N].y+22);

    // student path up to shown
    ctx.strokeStyle='rgba(16,185,129,0.9)'; ctx.lineWidth=2.5;
    ctx.beginPath();
    for(let i=0;i<Math.min(shown,N+1);i++){ const p=S[i]; i?ctx.lineTo(p.x,p.y):ctx.moveTo(p.x,p.y); }
    ctx.stroke();
    for(let i=0;i<Math.min(shown,N+1);i++){
      const p=S[i];
      ctx.fillStyle='#10b981'; ctx.beginPath(); ctx.arc(p.x,p.y,5,0,Math.PI*2); ctx.fill();
      // teacher continuation arrow (cyan) at each student state
      if (i>0 && i<N+1){
        ctx.strokeStyle='rgba(6,182,212,0.9)'; ctx.lineWidth=1.6;
        const ex=p.x, ey=p.y-30;
        ctx.beginPath(); ctx.moveTo(p.x,p.y); ctx.lineTo(ex,ey); ctx.stroke();
        ctx.fillStyle='rgba(6,182,212,0.9)'; ctx.beginPath();
        ctx.moveTo(ex,ey); ctx.lineTo(ex-4,ey+7); ctx.lineTo(ex+4,ey+7); ctx.closePath(); ctx.fill();
      }
    }
    ctx.fillStyle='rgba(16,185,129,0.95)'; ctx.font='12px monospace';
    ctx.fillText('student: own states (on-policy)', S[0].x, S[0].y+24);
    if (shown>N) { ctx.fillStyle='rgba(6,182,212,0.95)'; ctx.fillText('↑ short teacher repairs', S[2].x, S[2].y-40); }

    if (running && prog < 1) { prog += 0.012; raf = requestAnimationFrame(draw); }
    else if (prog >= 1) running = false;
  }
  function play(){ prog = 0; running = true; cancelAnimationFrame(raf); draw(); }
  document.getElementById('opd-play')?.addEventListener('click', play);
  window.addEventListener('resize', () => { size(); draw(); });
  size();
  const sec = document.getElementById('s-opd');
  if (sec) new IntersectionObserver((es) => {
    es.forEach(e => { if (e.isIntersecting && prog === 0) play(); });
  }, { threshold: 0.4 }).observe(sec);
  draw();
})();

/* ─────────────── §06 + §07 bar animations ─────────────── */
function animateBars(rootId, sel) {
  const root = document.getElementById(rootId);
  if (!root) return;
  new IntersectionObserver((es) => {
    es.forEach(e => {
      if (e.isIntersecting) {
        root.querySelectorAll(sel + '[data-w]').forEach(b => { b.style.width = b.dataset.w + '%'; });
      }
    });
  }, { threshold: 0.3 }).observe(root);
}
animateBars('drift-mmd', '.tb-fill');
animateBars('drift-forget', '.tb-fill');
animateBars('result-bars', '.bar-fill');
</script>
</BaseLayout>

    <tr class="highlight-row"><td>Full OSCAR: U·H_Had·P_br</td><td class="mn best">70.01</td><td class="mn">—</td></tr>
    <tr><td>w/o U (QuaRot + P_br: Hadamard only)</td><td class="mn">32.82</td><td class="mn" style="color:#ef6161">−37.19</td></tr>
    <tr><td>w/o H_Had (only U·P_br)</td><td class="mn">51.74</td><td class="mn" style="color:#ef6161">−18.27</td></tr>
    <tr><td>w/o P_br</td><td class="mn">68.00</td><td class="mn" style="color:var(--amber)">−2.01</td></tr>
    <tr class="collapse-row"><td>No rotation (clip + sink + recent only)</td><td class="mn">4.23</td><td class="mn" style="color:#ef6161">−65.78</td></tr>

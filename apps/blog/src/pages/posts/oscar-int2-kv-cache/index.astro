      <div style="display:flex;align-items:center;gap:.4rem;font-size:.72rem;color:var(--muted2)">
        <div style="width:12px;height:12px;border-radius:3px;background:#06b6d4"></div> BF16 sink (S=64)
      </div>
      <div style="display:flex;align-items:center;gap:.4rem;font-size:.72rem;color:var(--muted2)">
        <div style="width:12px;height:12px;border-radius:3px;background:#8b5cf6"></div> INT2 history

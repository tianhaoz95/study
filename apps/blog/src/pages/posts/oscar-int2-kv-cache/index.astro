<script>
// ─── TOC + SIDEBAR TOGGLES ───
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});

const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ─── CODE SIDEBAR TABS ───
const tabMeta = {
  memory:  { file: 'oscar/kv_cache.py',        title: 'Memory Wall' },
  outlier: { file: 'oscar/quantize.py',         title: 'Outlier Problem' },
  gap:     { file: 'oscar/objectives.py',       title: 'Alignment Gap' },
  oscar:   { file: 'oscar/calibrate.py',        title: 'OSCAR Calibration' },
  system:  { file: 'oscar/sglang_kernel.py',    title: 'System Design' },
  results: { file: 'oscar/eval_results.py',     title: 'Results' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ─── INTERSECTION OBSERVER (TOC + TAB SYNC) ───
const sectionMap = {
  's-memory':  'memory',
  's-outlier': 'outlier',
  's-gap':     'gap',
  's-oscar':   'oscar',
  's-system':  'system',
  's-results': 'results',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ─── §01 MEMORY WALL CANVAS ───
(function() {
  const canvas = document.getElementById('memory-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const W = canvas.clientWidth, H = 260, DPR = window.devicePixelRatio || 1;
  canvas.width = W * DPR; canvas.height = H * DPR; ctx.scale(DPR, DPR);

  const contexts = [4096, 16384, 32768, 65536, 131072];
  const labels   = ['4K',  '16K',  '32K',  '64K',  '128K'];
  // GB for Qwen3-8B: 32 layers, 8 kv-heads, d=128, 2 (K+V)
  function kvGB(seqLen, bits) {
    return 32 * 8 * seqLen * 128 * 2 * bits / 8 / 1e9;
  }
  const series = [
    { label: 'BF16',  bits: 16, color: '#475569' },
    { label: 'INT4',  bits: 4,  color: '#0e7490' },
    { label: 'INT2 (OSCAR)', bits: 2, color: '#8b5cf6' },
  ];

  const pad = { l: 54, r: 24, t: 20, b: 44 };
  const maxVal = kvGB(131072, 16) * 1.08;
  const cW = W - pad.l - pad.r;
  const cH = H - pad.t - pad.b;
  const groupW = cW / contexts.length;
  const barW   = groupW / (series.length + 1);

  // grid lines
  const yTicks = [0, 5, 10, 15, 20];
  yTicks.forEach(v => {
    const y = pad.t + cH - (v / maxVal) * cH;
    ctx.strokeStyle = 'rgba(255,255,255,0.05)';
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(pad.l, y); ctx.lineTo(W - pad.r, y); ctx.stroke();
    ctx.fillStyle = '#6b7280'; ctx.font = `${10}px monospace`; ctx.textAlign = 'right';
    ctx.fillText(v + ' GB', pad.l - 6, y + 3.5);
  });

  // bars + tooltip data
  const barRects = [];
  contexts.forEach((seqLen, gi) => {
    series.forEach((s, si) => {
      const val = kvGB(seqLen, s.bits);
      const x   = pad.l + gi * groupW + si * barW + barW * 0.4;
      const bH  = (val / maxVal) * cH;
      const y   = pad.t + cH - bH;
      ctx.fillStyle = s.color;
      ctx.fillRect(x, y, barW * 0.8, bH);
      barRects.push({ x, y, w: barW * 0.8, h: bH, val, label: s.label, ctx_label: labels[gi] });
    });
    // x-axis label
    ctx.fillStyle = '#9ca3af'; ctx.font = `${10}px monospace`; ctx.textAlign = 'center';
    ctx.fillText(labels[gi], pad.l + gi * groupW + groupW * 0.5 - barW * 0.3, H - 8);
  });

  // legend
  series.forEach((s, i) => {
    const lx = pad.l + i * 130;
    ctx.fillStyle = s.color; ctx.fillRect(lx, H - 26, 10, 10);
    ctx.fillStyle = '#9ca3af'; ctx.font = `${10}px monospace`; ctx.textAlign = 'left';
    ctx.fillText(s.label, lx + 14, H - 17);
  });

  // hover tooltip
  let hovered = null;
  canvas.addEventListener('mousemove', e => {
    const rect = canvas.getBoundingClientRect();
    const mx = (e.clientX - rect.left) * (W / rect.width);
    const my = (e.clientY - rect.top)  * (H / rect.height);
    hovered = barRects.find(b => mx >= b.x && mx <= b.x + b.w && my >= b.y && my <= b.y + b.h + 2);
    redraw();
    if (hovered) {
      ctx.fillStyle = 'rgba(30,27,75,0.92)';
      ctx.strokeStyle = '#8b5cf6'; ctx.lineWidth = 1;
      const tx = Math.min(hovered.x + 4, W - 130), ty = hovered.y - 36;
      ctx.beginPath(); ctx.roundRect(tx, Math.max(ty, 4), 120, 28, 4); ctx.fill(); ctx.stroke();
      ctx.fillStyle = '#e2e8f0'; ctx.font = `${10}px monospace`; ctx.textAlign = 'left';
      ctx.fillText(`${hovered.ctx_label} · ${hovered.label}`, tx + 6, Math.max(ty, 4) + 12);
      ctx.fillText(`${hovered.val.toFixed(2)} GB`, tx + 6, Math.max(ty, 4) + 24);
    }
  });
  canvas.addEventListener('mouseleave', () => { hovered = null; redraw(); });

  function redraw() {
    ctx.clearRect(0, 0, W, H);
    yTicks.forEach(v => {
      const y = pad.t + cH - (v / maxVal) * cH;
      ctx.strokeStyle = 'rgba(255,255,255,0.05)'; ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(pad.l, y); ctx.lineTo(W - pad.r, y); ctx.stroke();
      ctx.fillStyle = '#6b7280'; ctx.font = `${10}px monospace`; ctx.textAlign = 'right';
      ctx.fillText(v + ' GB', pad.l - 6, y + 3.5);
    });
    barRects.forEach(b => {
      ctx.fillStyle = b === hovered ? '#a78bfa' : (b.label === 'INT2 (OSCAR)' ? '#8b5cf6' : b.label === 'INT4' ? '#0e7490' : '#475569');
      ctx.globalAlpha = b === hovered ? 1 : 0.82;
      ctx.fillRect(b.x, b.y, b.w, b.h);
    });
    ctx.globalAlpha = 1;
    contexts.forEach((_, gi) => {
      ctx.fillStyle = '#9ca3af'; ctx.font = `${10}px monospace`; ctx.textAlign = 'center';
      ctx.fillText(labels[gi], pad.l + gi * groupW + groupW * 0.5 - barW * 0.3, H - 8);
    });
    series.forEach((s, i) => {
      const lx = pad.l + i * 130;
      ctx.fillStyle = s.color; ctx.fillRect(lx, H - 26, 10, 10);
      ctx.fillStyle = '#9ca3af'; ctx.font = `${10}px monospace`; ctx.textAlign = 'left';
      ctx.fillText(s.label, lx + 14, H - 17);
    });
  }
})();

// ─── §02 ACTIVATION DISTRIBUTION CANVAS ───
(function() {
  const canvas = document.getElementById('act-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const W = canvas.clientWidth, H = 200, DPR = window.devicePixelRatio || 1;
  canvas.width = W * DPR; canvas.height = H * DPR; ctx.scale(DPR, DPR);

  const captions = {
    raw: 'Raw INT2: a few channels have magnitudes 10–50× larger than the rest. The quantization scale is dominated by outliers, compressing all normal values to just 1–2 levels.',
    hadamard: 'Hadamard rotation: outlier energy is spread uniformly across all channels. Max magnitude drops ~8× — quantization range is more uniform. But the axis directions are still random.',
    oscar: 'OSCAR rotation: channels are further aligned with query importance. High-importance directions (large Q⊤Q eigenvalues) are mapped to the widest quantization range, minimizing attention logit error.',
  };

  // Seeded PRNG for reproducible data
  function seededRand(seed) {
    let s = seed;
    return function() { s = (s * 1664525 + 1013904223) & 0xffffffff; return (s >>> 0) / 0xffffffff; };
  }
  function genData(mode) {
    const rng = seededRand(42);
    const n = 128;
    const vals = Array.from({length: n}, (_, i) => {
      let base = rng() * 0.8 + 0.1;
      if (mode === 'raw') {
        if (i === 3 || i === 17 || i === 61) base = rng() * 18 + 20; // outliers
        else base = rng() * 2 + 0.3;
      } else if (mode === 'hadamard') {
        base = rng() * 3.5 + 1.2 + Math.sin(i * 0.3) * 0.8;
      } else { // oscar
        const importance = Math.exp(-i * 0.035); // query-aligned: high importance first
        base = rng() * 2 + 0.5 + importance * 1.5;
      }
      return base;
    });
    return vals;
  }

  let currentMode = 'raw';
  function drawBars(mode) {
    ctx.clearRect(0, 0, W, H);
    const data = genData(mode);
    const maxVal = Math.max(...data);
    const pad = { l: 30, r: 12, t: 16, b: 28 };
    const cW = W - pad.l - pad.r;
    const cH = H - pad.t - pad.b;
    const bW = cW / data.length;

    // colors
    const baseColor = mode === 'raw' ? '#ef6161' : mode === 'hadamard' ? '#0e7490' : '#8b5cf6';
    const outColor  = '#fbbf24';

    data.forEach((v, i) => {
      const isOutlier = mode === 'raw' && (i === 3 || i === 17 || i === 61);
      const bH = (v / maxVal) * cH;
      const x  = pad.l + i * bW;
      const y  = pad.t + cH - bH;
      ctx.fillStyle = isOutlier ? outColor : baseColor;
      ctx.globalAlpha = isOutlier ? 1 : 0.72;
      ctx.fillRect(x + 0.5, y, Math.max(bW - 1, 1), bH);
    });
    ctx.globalAlpha = 1;

    // y-axis
    ctx.strokeStyle = 'rgba(255,255,255,0.08)'; ctx.lineWidth = 1;
    [0.25, 0.5, 0.75, 1.0].forEach(frac => {
      const y = pad.t + cH * (1 - frac);
      ctx.beginPath(); ctx.moveTo(pad.l, y); ctx.lineTo(W - pad.r, y); ctx.stroke();
      ctx.fillStyle = '#6b7280'; ctx.font = `${9}px monospace`; ctx.textAlign = 'right';
      ctx.fillText((frac * maxVal).toFixed(1), pad.l - 3, y + 3);
    });

    ctx.fillStyle = '#6b7280'; ctx.font = `${9}px monospace`; ctx.textAlign = 'center';
    ctx.fillText('channel index →', W / 2, H - 4);

    if (mode === 'raw') {
      ctx.fillStyle = '#fbbf24'; ctx.font = `bold ${9}px monospace`;
      ctx.fillText('← outlier channels dominate scale', W * 0.62, pad.t + 12);
    } else if (mode === 'oscar') {
      ctx.fillStyle = '#c4b5fd'; ctx.font = `bold ${9}px monospace`;
      ctx.fillText('← high-query-importance channels', W * 0.6, pad.t + 12);
    }
  }

  drawBars('raw');
  document.getElementById('act-caption').textContent = captions['raw'];

  document.querySelectorAll('.act-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.act-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentMode = btn.dataset.mode;
      drawBars(currentMode);
      document.getElementById('act-caption').textContent = captions[currentMode];
    });
  });
})();

// ─── §03 ALIGNMENT GAP CANVAS ───
(function() {
  const canvas = document.getElementById('align-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const W = canvas.clientWidth, H = 260, DPR = window.devicePixelRatio || 1;
  canvas.width = W * DPR; canvas.height = H * DPR; ctx.scale(DPR, DPR);

  let showOSCAR = false;
  const captions = [
    'Hadamard rotation aligns quantization axes with raw K covariance (K⊤K). High-variance directions get the widest INT2 range — but queries may not care about those directions.',
    'OSCAR rotation aligns axes with query covariance (Q⊤Q). Directions that queries strongly project onto get the widest INT2 range — quantization noise goes where attention barely looks.',
  ];

  function seededRand(seed) {
    let s = seed;
    return () => { s = (s * 1664525 + 1013904223) & 0xffffffff; return (s >>> 0) / 0xffffffff; };
  }

  function drawState(isOSCAR) {
    ctx.clearRect(0, 0, W, H);
    const rng = seededRand(7);
    const cx = W / 2, cy = H / 2;

    // Draw 60 key embeddings (2D projection)
    const pts = [];
    for (let i = 0; i < 60; i++) {
      const u = (rng() - 0.5) * 2, v = (rng() - 0.5) * 0.5;
      // raw K⊤K: elongated along x (raw variance)
      // OSCAR Q⊤Q: elongated along a 30° rotated axis (query-important direction)
      const angle = isOSCAR ? Math.PI / 6 : 0;
      const rx = Math.cos(angle) * u * 100 - Math.sin(angle) * v * 40;
      const ry = Math.sin(angle) * u * 100 + Math.cos(angle) * v * 40;
      pts.push({ x: cx + rx, y: cy + ry });
    }

    // Draw points
    pts.forEach(p => {
      ctx.beginPath(); ctx.arc(p.x, p.y, 3.5, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(139,92,246,0.65)'; ctx.fill();
    });

    // Draw quantization grid lines (INT2 boundaries)
    const gridColor = isOSCAR ? 'rgba(6,182,212,0.35)' : 'rgba(245,158,11,0.35)';
    const axisColor = isOSCAR ? '#06b6d4' : '#f59e0b';
    const axisAngle = isOSCAR ? Math.PI / 6 : 0;

    // 3 grid lines per axis (INT2 has 4 levels → 3 boundaries)
    for (let q = -1; q <= 1; q++) {
      const offset = q * 38;
      // Grid lines perpendicular to quantization axis
      const nx = Math.cos(axisAngle + Math.PI / 2), ny = Math.sin(axisAngle + Math.PI / 2);
      const px = Math.cos(axisAngle), py = Math.sin(axisAngle);
      const ox = cx + px * offset, oy = cy + py * offset;
      ctx.strokeStyle = gridColor; ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.moveTo(ox - nx * 120, oy - ny * 120);
      ctx.lineTo(ox + nx * 120, oy + ny * 120);
      ctx.stroke();
    }

    // Draw the principal axis (eigenvector direction)
    ctx.strokeStyle = axisColor; ctx.lineWidth = 2.5;
    ctx.beginPath();
    ctx.moveTo(cx - Math.cos(axisAngle) * 130, cy - Math.sin(axisAngle) * 130);
    ctx.lineTo(cx + Math.cos(axisAngle) * 130, cy + Math.sin(axisAngle) * 130);
    ctx.stroke();

    // Arrowhead
    const ax = cx + Math.cos(axisAngle) * 130, ay = cy + Math.sin(axisAngle) * 130;
    ctx.fillStyle = axisColor;
    ctx.beginPath();
    ctx.moveTo(ax, ay);
    ctx.lineTo(ax - Math.cos(axisAngle - 0.4) * 12, ay - Math.sin(axisAngle - 0.4) * 12);
    ctx.lineTo(ax - Math.cos(axisAngle + 0.4) * 12, ay - Math.sin(axisAngle + 0.4) * 12);
    ctx.fill();

    // Label axis
    ctx.fillStyle = axisColor; ctx.font = `bold ${11}px monospace`; ctx.textAlign = 'center';
    const labelX = ax + Math.cos(axisAngle) * 16, labelY = ay + Math.sin(axisAngle) * 16;
    ctx.fillText(isOSCAR ? 'Q⊤Q eigvec' : 'K⊤K eigvec', labelX > W - 80 ? W - 80 : labelX, Math.min(labelY + 12, H - 8));

    // Labels for regions
    ctx.fillStyle = isOSCAR ? '#67e8f9' : '#fcd34d';
    ctx.font = `${10}px monospace`; ctx.textAlign = 'left';
    ctx.fillText(isOSCAR ? '← wide INT2 range: queries care here' : '← wide INT2 range: raw high variance', 14, 22);

    // Title
    ctx.fillStyle = '#e2e8f0'; ctx.font = `bold ${12}px monospace`; ctx.textAlign = 'center';
    ctx.fillText(isOSCAR ? 'OSCAR: query-aware rotation (Q⊤Q)' : 'Hadamard: raw covariance rotation (K⊤K)', W / 2, H - 10);

    document.getElementById('align-caption').textContent = captions[isOSCAR ? 1 : 0];
  }

  drawState(false);
  canvas.addEventListener('click', () => {
    showOSCAR = !showOSCAR;
    drawState(showOSCAR);
  });
})();

// ─── §05 LAYOUT CANVAS ───
(function() {
  const canvas = document.getElementById('layout-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const W = canvas.clientWidth, H = 160, DPR = window.devicePixelRatio || 1;
  canvas.width = W * DPR; canvas.height = H * DPR; ctx.scale(DPR, DPR);

  const slider = document.getElementById('ctx-slider');
  const ctxVal = document.getElementById('ctx-val');

  const S = 64, R = 256; // sink and recent sizes

  function drawLayout(totalTokens) {
    ctx.clearRect(0, 0, W, H);
    const pad = { l: 16, r: 16, t: 40, b: 28 };
    const cW = W - pad.l - pad.r;
    const cH = 44;
    const y  = pad.t;

    const sinkW   = (S / totalTokens) * cW;
    const recentW = (R / totalTokens) * cW;
    const histW   = cW - sinkW - recentW;
    const sinkX   = pad.l;
    const histX   = sinkX + sinkW;
    const recentX = histX + histW;

    // Background track
    ctx.fillStyle = 'rgba(255,255,255,0.04)';
    ctx.beginPath(); ctx.roundRect(pad.l, y, cW, cH, 6); ctx.fill();

    // History (INT2)
    ctx.fillStyle = '#4c1d95';
    ctx.beginPath(); ctx.roundRect(histX, y, histW, cH, 0); ctx.fill();
    if (histW > 60) {
      ctx.fillStyle = '#a78bfa'; ctx.font = `bold ${10}px monospace`; ctx.textAlign = 'center';
      ctx.fillText('INT2 history', histX + histW / 2, y + cH / 2 + 4);
      const histGB = (((totalTokens - S - R) * 2 / 8) / 1e6).toFixed(1);
      ctx.fillStyle = '#7c3aed'; ctx.font = `${9}px monospace`;
      ctx.fillText(`${totalTokens - S - R} tokens · ${histGB} MB`, histX + histW / 2, y + cH / 2 + 18);
    }

    // Sink (BF16 cyan)
    ctx.fillStyle = '#164e63';
    ctx.beginPath(); ctx.roundRect(sinkX, y, sinkW, cH, [6, 0, 0, 6]); ctx.fill();
    if (sinkW > 14) {
      ctx.fillStyle = '#67e8f9'; ctx.font = `${9}px monospace`; ctx.textAlign = 'center';
      ctx.fillText('sink', sinkX + sinkW / 2, y + cH / 2 + 4);
    }

    // Recent (BF16 green)
    ctx.fillStyle = '#064e3b';
    ctx.beginPath(); ctx.roundRect(recentX, y, recentW, cH, [0, 6, 6, 0]); ctx.fill();
    if (recentW > 18) {
      ctx.fillStyle = '#6ee7b7'; ctx.font = `${9}px monospace`; ctx.textAlign = 'center';
      ctx.fillText('recent', recentX + recentW / 2, y + cH / 2 + 4);
    }

    // Annotations
    ctx.fillStyle = '#06b6d4'; ctx.font = `${9}px monospace`; ctx.textAlign = 'center';
    ctx.fillText(`BF16 (${S})`, sinkX + sinkW / 2, y - 6);
    ctx.fillStyle = '#10b981';
    ctx.fillText(`BF16 (${R})`, recentX + recentW / 2, y - 6);
    ctx.fillStyle = '#7c3aed';
    ctx.fillText(`INT2`, histX + histW / 2, y - 6);

    // BF16 fraction
    const bf16Frac = ((S + R) / totalTokens * 100).toFixed(2);
    ctx.fillStyle = '#6b7280'; ctx.font = `${10}px monospace`; ctx.textAlign = 'center';
    ctx.fillText(`BF16 overhead: ${bf16Frac}% of tokens (${S + R}/${totalTokens})`, W / 2, y + cH + 18);

    // x-axis: 0, t/2, t
    ctx.fillStyle = '#4b5563'; ctx.font = `${9}px monospace`; ctx.textAlign = 'left';
    ctx.fillText('pos 0', pad.l, y + cH + 10);
    ctx.textAlign = 'right';
    ctx.fillText(`pos ${totalTokens}`, W - pad.r, y + cH + 10);
  }

  drawLayout(parseInt(slider.value));

  slider.addEventListener('input', () => {
    const v = parseInt(slider.value);
    ctxVal.textContent = v >= 1000 ? (v / 1000).toFixed(0) + 'K' : v;
    drawLayout(v);
  });
})();

// ─── §06 ANIMATED BAR CHART ───
(function() {
  const resultsSection = document.getElementById('s-results');
  if (!resultsSection) return;
  let fired = false;
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting && !fired) {
        fired = true;
        document.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          const maxScore = 85;
          b.style.width = (parseFloat(b.dataset.w) / maxScore * 100) + '%';
        });
      }
    });
  }, { threshold: 0.2 }).observe(resultsSection);
})();
</script>

</BaseLayout>

<span class="cs-line"><span class="kw">def</span> <span class="fn">symmetric_quant</span>(x, bits=<span class="num">2</span>):</span>
<span class="cs-line">    <span class="cmt"># INT2: only 4 levels: {-1, 0, 0, 1}</span></span>
<span class="cs-line">    levels = <span class="num">2</span> ** (bits - <span class="num">1</span>)  <span class="cmt"># = 2</span></span>
<span class="cs-line hl-a">    scale = x.<span class="fn">abs</span>().<span class="fn">max</span>() / levels</span>
<span class="cs-line hl-a">    <span class="cmt"># if max=100, normal vals=1 → scale=50</span></span>
<span class="cs-line hl-a">    <span class="cmt"># → 1/50 rounds to 0 → information lost!</span></span>
<span class="cs-line">    <span class="kw">return</span> (x / scale).<span class="fn">round</span>().<span class="fn">clamp</span>(-levels, levels) * scale</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Hadamard rotation: spread outlier energy</span>
<span class="cs-line hl-c"><span class="kw">def</span> <span class="fn">hadamard_rotate</span>(x):</span>
<span class="cs-line hl-c">    H = <span class="fn">hadamard_matrix</span>(x.shape[-<span class="num">1</span>])</span>
<span class="cs-line hl-c">    <span class="kw">return</span> x @ H  <span class="cmt"># each output = mean of all inputs</span></span>
<span class="cs-line hl-c">    <span class="cmt"># max(|x @ H|) ≈ std(x) * sqrt(d)</span></span>
<span class="cs-line hl-c">    <span class="cmt"># much smaller than raw max</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># But Hadamard is data-oblivious —</span>
<span class="cs-line cmt"># it equalizes magnitude, not query-importance</span>
      </pre>
    </div>

    <!-- panel: gap -->
    <div class="cs-panel" id="panel-gap">
      <pre class="cs-pre">
<span class="cs-line cmt"># The alignment gap: two error objectives</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># What naive rotation minimizes:</span>
<span class="cs-line hl-a">L_naive(R) = ||K - Q(KR)R⊤||²_F</span>
<span class="cs-line hl-a"><span class="cmt"># raw reconstruction error of KV cache</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># What OSCAR minimizes (key error):</span>
<span class="cs-line hl-c">L_key(Rk) = ||QK⊤ - QK̂⊤||²_F</span>
<span class="cs-line hl-c">          = tr(Eₖ · Q⊤Q)</span>
<span class="cs-line hl-c"><span class="cmt"># = noise weighted by query covariance!</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># What OSCAR minimizes (value error):</span>
<span class="cs-line hl-g">L_val(Rv) = ||SV - SV̂||²_F</span>
<span class="cs-line hl-g">          = tr(Eᵥ · S⊤S)</span>
<span class="cs-line hl-g"><span class="cmt"># = noise weighted by attention scores!</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Theorem 1: minimizer of L_key under</span>
<span class="cs-line cmt"># diagonal residual assumption is</span>
<span class="cs-line hl-p">CQ = (1/N) * sum(q_n⊤ q_n)  <span class="cmt"># key target</span></span>
<span class="cs-line hl-p">CS = (1/N) * V⊤S⊤SV         <span class="cmt"># val target</span></span>
<span class="cs-line hl-p">Rk = eigvecs(CQ)  <span class="cmt"># ← the optimal rotation</span></span>
      </pre>
    </div>

    <!-- panel: oscar -->
    <div class="cs-panel" id="panel-oscar">
      <pre class="cs-pre">
<span class="cs-line cmt"># OSCAR offline calibration (pseudocode)</span>
<span class="cs-line"></span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">oscar_calibrate</span>(model, calib_tokens):</span>
<span class="cs-line hl-p">    <span class="cmt"># 8878 tokens, one forward pass</span></span>
<span class="cs-line hl-p">    Q, K, V, S = <span class="fn">collect_activations</span>(model, calib_tokens)</span>
<span class="cs-line"></span>
<span class="cs-line">    rotations = {}</span>
<span class="cs-line">    <span class="kw">for</span> layer <span class="kw">in</span> <span class="fn">range</span>(model.num_layers):</span>
<span class="cs-line">        <span class="kw">for</span> head <span class="kw">in</span> <span class="fn">range</span>(model.num_heads):</span>
<span class="cs-line"></span>
<span class="cs-line hl-c">            <span class="cmt"># Key rotation target</span></span>
<span class="cs-line hl-c">            CQ = (Q[layer, head].T @ Q[layer, head]) / N</span>
<span class="cs-line hl-c">            UQ, _ = <span class="fn">torch.linalg.eigh</span>(CQ)</span>
<span class="cs-line hl-c">            RK = UQ @ H_Had @ P_br  <span class="cmt"># compose</span></span>
<span class="cs-line"></span>
<span class="cs-line hl-g">            <span class="cmt"># Value rotation target</span></span>
<span class="cs-line hl-g">            CS = V[layer].T @ S[layer].T @ S[layer] @ V[layer] / N</span>
<span class="cs-line hl-g">            US, _ = <span class="fn">torch.linalg.eigh</span>(CS)</span>
<span class="cs-line hl-g">            RV = US @ H_Had @ P_br</span>
<span class="cs-line"></span>
<span class="cs-line">            <span class="cmt"># Per-layer clip thresholds (percentile)</span></span>
<span class="cs-line">            rotK = K[layer] @ RK</span>
<span class="cs-line">            tauK = <span class="fn">percentile</span>(rotK.<span class="fn">abs</span>(), <span class="num">0.96</span>)</span>
<span class="cs-line">            rotations[layer] = (RK, RV, tauK, tauV)</span>
<span class="cs-line"></span>
<span class="cs-line">    <span class="kw">return</span> rotations  <span class="cmt"># saved as model params</span></span>
      </pre>
    </div>

    <!-- panel: system -->
    <div class="cs-panel" id="panel-system">
      <pre class="cs-pre">
<span class="cs-line cmt"># OSCAR online serving (SGLang integration)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># KV cache layout at decoding step t:</span>
<span class="cs-line cmt"># [BF16 sink | INT2 history | BF16 recent]</span>
<span class="cs-line cmt"># [0..S0)    | [S0..t-W)   | [t-W..t]</span>
<span class="cs-line cmt"># S0=64,  W=256  — only 0.24% of 128K</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Write path (fused Triton kernel):</span>
<span class="cs-line hl-c"><span class="kw">def</span> <span class="fn">write_kv_token</span>(kt, vt, RK, RV, tauK, tauV):</span>
<span class="cs-line hl-c">    rotK = kt @ RK              <span class="cmt"># rotate</span></span>
<span class="cs-line hl-c">    clpK = <span class="fn">clip</span>(rotK, -tauK, tauK)  <span class="cmt"># clip</span></span>
<span class="cs-line hl-c">    int2K = <span class="fn">quantize_int2</span>(clpK) <span class="cmt"># 4 vals/byte</span></span>
<span class="cs-line hl-c">    <span class="cmt"># V: RV already absorbed into W_V weights!</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Read path (fused decode kernel):</span>
<span class="cs-line hl-g"><span class="kw">def</span> <span class="fn">decode_attention</span>(q, kv_cache):</span>
<span class="cs-line hl-g">    k_int2, v_int2 = kv_cache.int2_segment</span>
<span class="cs-line hl-g">    k_bf16, v_bf16 = kv_cache.bf16_windows</span>
<span class="cs-line hl-g"></span>
<span class="cs-line hl-g">    <span class="cmt"># INT2 segment: unpack → dequant → attn</span></span>
<span class="cs-line hl-g">    k_deq = <span class="fn">dequant_int2</span>(k_int2) @ RK.T</span>
<span class="cs-line hl-g">    attn_int2 = <span class="fn">flash_attn</span>(q, k_deq, v_deq)</span>
<span class="cs-line hl-g">    <span class="cmt"># BF16 windows: standard attention</span></span>
<span class="cs-line hl-g">    attn_bf16 = <span class="fn">flash_attn</span>(q, k_bf16, v_bf16)</span>
<span class="cs-line hl-g">    <span class="kw">return</span> <span class="fn">merge_partial</span>(attn_int2, attn_bf16)</span>
      </pre>
    </div>

    <!-- panel: results -->
    <div class="cs-panel" id="panel-results">
      <pre class="cs-pre">
<span class="cs-line cmt"># Accuracy results — mean over 5 benchmarks</span>

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { postReadTime } from '../../../lib/readTimes';
const readTime = postReadTime(Astro.url.pathname.split('/').filter(Boolean).at(-1)!);
---
<BaseLayout
  title="FP4 at Scale: NVFP4 Pretraining for LLMs | AI/ML Deep Dives"
  description="NVIDIA trained a 12B model on 10 trillion tokens in 4-bit precision—matching FP8 accuracy—using four targeted techniques: mixed precision layers, Hadamard outlier smoothing, 2D weight scaling, and stochastic rounding."
  crumb="NVFP4 Pretraining"
>


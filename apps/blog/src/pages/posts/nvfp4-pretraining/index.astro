    <button class="cs-tab" data-panel="format">format</button>
    <button class="cs-tab" data-panel="recipe">recipe</button>
    <button class="cs-tab" data-panel="scaling">scaling</button>
    <button class="cs-tab" data-panel="hadamard">hadamard</button>
    <button class="cs-tab" data-panel="results">results</button>
  </div>
  <div class="cs-body">
    <div class="cs-panel active" id="panel-problem">
      <pre class="cs-pre">
<span class="cs-line cmt"># FP4 E2M1 representable values</span>
<span class="cs-line">FP4_VALUES = [</span>
<span class="cs-line hl-c">    0, 0.5, 1.0, 1.5, 2.0,</span>
<span class="cs-line hl-c">    3.0, 4.0, 6.0,  # positive</span>
<span class="cs-line cmt">    # (and negatives of above)</span>
<span class="cs-line">]</span>
<span class="cs-line"></span>
<span class="cs-line kw">def</span> <span class="cs-line fn">quantize_block</span><span class="cs-line">(x, block_max):</span>
<span class="cs-line hl-p">    s = 6.0 / block_max      <span class="cmt"># scale</span></span>
<span class="cs-line hl-p">    x_s = x * s              <span class="cmt"># scaled to [-6,6]</span></span>
<span class="cs-line hl-p">    q = fp4_nearest(x_s)     <span class="cmt"># snap to grid</span></span>
<span class="cs-line hl-p">    return q / s             <span class="cmt"># dequantize</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Problem: with outlier 18.3 in block</span>
<span class="cs-line cmt">#   block_max = 18.3</span>
<span class="cs-line cmt">#   min representable = 0.5 * 18.3/6</span>
<span class="cs-line cmt">#               = 1.525</span>
<span class="cs-line cmt"># Any |x| &lt; 0.7625 → quantizes to 0</span>
<span class="cs-line cmt"># 5 of 15 normal values → ZERO</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># vs. clean block (max = 1.5)</span>
<span class="cs-line cmt">#   min representable = 0.5*1.5/6</span>
<span class="cs-line cmt">#               = 0.125 (fine)</span>
      </pre>
    </div>
    <div class="cs-panel" id="panel-format">
      <pre class="cs-pre">
<span class="cs-line cmt"># NVFP4 two-level scaling</span>
<span class="cs-line cmt"># ─────────────────────────</span>
<span class="cs-line cmt"># Level 1: per-tensor FP32 scale</span>
<span class="cs-line cmt">#   normalises tensor into E4M3 range</span>
<span class="cs-line cmt"># Level 2: per-block E4M3 scale</span>
<span class="cs-line cmt">#   16 elements, fine-grained</span>
<span class="cs-line"></span>
<span class="cs-line kw">def</span> <span class="fn">nvfp4_quantize</span>(tensor):</span>
<span class="cs-line hl-c">    # Step 1: tensor-level scale</span>
<span class="cs-line hl-c">    t_scale = compute_fp32_scale(tensor)</span>
<span class="cs-line hl-c">    t_norm = tensor * t_scale</span>
<span class="cs-line"></span>
<span class="cs-line hl-p">    # Step 2: per-block E4M3 scales</span>
<span class="cs-line hl-p">    blocks = split_blocks(t_norm, 16)</span>
<span class="cs-line hl-p">    b_scales = [e4m3_scale(b) for b in blocks]</span>
<span class="cs-line"></span>
<span class="cs-line hl-g">    # Step 3: quantize to E2M1</span>
<span class="cs-line hl-g">    return [fp4_round(b * s)</span>
<span class="cs-line hl-g">            for b, s in zip(blocks, b_scales)]</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># MXFP4 (comparison)</span>
<span class="cs-line cmt">#   block size: 32 (2× coarser)</span>
<span class="cs-line cmt">#   scale type: UE8M0 (power-of-2)</span>
<span class="cs-line cmt">#   can lose 1 binade of range</span>
<span class="cs-line cmt">#   → needs 36% more tokens to</span>
<span class="cs-line cmt">#     match NVFP4 loss</span>
      </pre>
    </div>
    <div class="cs-panel" id="panel-recipe">
      <pre class="cs-pre">
<span class="cs-line cmt"># Full NVFP4 training recipe</span>
<span class="cs-line cmt"># ─────────────────────────</span>
<span class="cs-line kw">def</span> <span class="fn">nvfp4_linear_layer</span>(x, W):</span>
<span class="cs-line hl-a">    # 1. Mixed precision: first/last</span>
<span class="cs-line hl-a">    #    blocks stay in BF16 (16%)</span>
<span class="cs-line hl-a">    if is_sensitive_layer:</span>
<span class="cs-line hl-a">        return bf16_gemm(x, W)</span>
<span class="cs-line"></span>
<span class="cs-line hl-c">    # 2. Quantize activations (1×16)</span>
<span class="cs-line hl-c">    x_fp4 = nvfp4_quant_1d(x)</span>
<span class="cs-line"></span>
<span class="cs-line hl-p">    # 3. Quantize weights (16×16)</span>
<span class="cs-line hl-p">    W_fp4 = nvfp4_quant_2d(W)</span>
<span class="cs-line"></span>
<span class="cs-line hl-g">    # Forward GEMM in FP4</span>
<span class="cs-line hl-g">    y = fp4_gemm(x_fp4, W_fp4)</span>
<span class="cs-line hl-g">    return y  # output in BF16</span>
<span class="cs-line"></span>
<span class="cs-line kw">def</span> <span class="fn">nvfp4_wgrad</span>(dy, x):</span>
<span class="cs-line hl-p">    # 2. Hadamard before Wgrad quant</span>
<span class="cs-line hl-p">    dy_h = hadamard_16(dy) * rand_sign</span>
<span class="cs-line hl-p">    x_h  = hadamard_16(x)  * rand_sign</span>
<span class="cs-line hl-p">    # 4. Stochastic rounding for grads</span>
<span class="cs-line hl-p">    return fp4_gemm_sr(dy_h, x_h)</span>
      </pre>
    </div>
    <div class="cs-panel" id="panel-scaling">
      <pre class="cs-pre">
<span class="cs-line cmt"># 2D block scaling for weights</span>
<span class="cs-line cmt"># ensures W_fprop == W_bprop</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># 1D scaling (broken chain rule)</span>
<span class="cs-line kw">def</span> <span class="fn">quant_1d</span>(W):</span>
<span class="cs-line hl-a">    # scale per row of 16</span>
<span class="cs-line hl-a">    for row in W:</span>
<span class="cs-line hl-a">        s = 6.0 / max(abs(row[:16]))</span>
<span class="cs-line hl-a">        W_q[row] = fp4(row * s)</span>
<span class="cs-line hl-a">    # transpose → same W sees</span>
<span class="cs-line hl-a">    # column scales → W_bprop ≠ W_fprop</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># 2D scaling (correct chain rule)</span>
<span class="cs-line kw">def</span> <span class="fn">quant_2d</span>(W):</span>
<span class="cs-line hl-g">    # scale per 16×16 block</span>
<span class="cs-line hl-g">    for r in range(0, R, 16):</span>
<span class="cs-line hl-g">      for c in range(0, C, 16):</span>
<span class="cs-line hl-g">        block = W[r:r+16, c:c+16]</span>
<span class="cs-line hl-g">        s = 6.0 / max(abs(block))</span>
<span class="cs-line hl-g">        W_q[r:r+16,c:c+16] = fp4(block*s)</span>
<span class="cs-line hl-g">    # transpose accesses same block</span>
<span class="cs-line hl-g">    # → W_fprop == W_bprop ✓</span>
      </pre>
    </div>
    <div class="cs-panel" id="panel-hadamard">
      <pre class="cs-pre">
<span class="cs-line cmt"># Random Hadamard Transform</span>
<span class="cs-line cmt"># applied to Wgrad inputs only</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Hadamard matrix properties:</span>
<span class="cs-line cmt">#   H @ H.T = N * I  (orthogonal)</span>
<span class="cs-line cmt">#   entries: ±1</span>
<span class="cs-line cmt"># Randomisation: multiply rows/cols</span>
<span class="cs-line cmt"># by random ±1 sign vector</span>
<span class="cs-line"></span>
<span class="cs-line kw">def</span> <span class="fn">rht_transform</span>(x, d=16):</span>
<span class="cs-line hl-p">    # x shape: [..., d]</span>
<span class="cs-line hl-p">    H = hadamard_matrix(d)  # d×d</span>
<span class="cs-line hl-p">    s = rand_sign_vector(d) # ±1</span>
<span class="cs-line hl-p">    return (H @ (x * s)) / d**0.5</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Result: outlier energy spread</span>
<span class="cs-line cmt">#   before: [0.2,...,0.2, 15.8]</span>
<span class="cs-line cmt">#   after:  [±3.97, ±3.95, ...]</span>
<span class="cs-line cmt"># FP4 max = 6, so ±4 fits cleanly</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Cancellation in dot-product:</span>
<span class="cs-line cmt">#   (Hx)^T (Hy) = x^T H^T H y</span>
<span class="cs-line cmt">#               = x^T (N*I) y / N</span>
<span class="cs-line cmt">#               = x^T y  ✓</span>
      </pre>
    </div>
    <div class="cs-panel" id="panel-results">
      <pre class="cs-pre">
<span class="cs-line cmt"># 12B model, 10T tokens (FP8 vs NVFP4)</span>
<span class="cs-line cmt"># ─────────────────────────────────</span>
<span class="cs-line cmt"># Validation loss gap</span>
<span class="cs-line cmt">#   stable phase:  &lt; 1.0%</span>
<span class="cs-line cmt">#   at end (decay): ~1.5%</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Key benchmark results</span>
<span class="cs-line cmt"># task            FP8    NVFP4</span>
<span class="cs-line hl-g">MMLU_pro  = (62.62, 62.58)  # ~tie</span>
<span class="cs-line hl-g">GSM8k     = (89.08, 92.27)  # +3.2%</span>
<span class="cs-line hl-g">AGIEval   = (67.01, 70.31)  # +3.3%</span>
<span class="cs-line hl-a">HumanEval = (59.93, 57.43)  # -2.5%</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># NVFP4 vs MXFP4 (8B, 1T tokens)</span>
<span class="cs-line cmt">#   loss gap vs BF16</span>
<span class="cs-line cmt">#   MXFP4: ~2.5%</span>
<span class="cs-line cmt">#   NVFP4: ~1.5%</span>
<span class="cs-line hl-p">tokens_to_match_nvfp4 = 1.36e12</span>
<span class="cs-line hl-p">vs_nvfp4              = 1.00e12</span>
<span class="cs-line hl-p">overhead              = "+36%"</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Hardware: Blackwell GB300</span>
<span class="cs-line cmt">#   BF16:   1× throughput</span>
<span class="cs-line cmt">#   FP8:    2× throughput</span>
<span class="cs-line cmt">#   NVFP4:  6× throughput</span>
      </pre>
    </div>
  </div>
</aside>

</div>

<script>
// ─── TOC + sidebar toggles ───────────────────────────────
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});

const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ─── Code sidebar tab switching ─────────────────────────
const tabMeta = {
  problem:  { file: 'nvfp4/quantize.py',  title: 'FP4 Quantization' },
  format:   { file: 'nvfp4/format.py',    title: 'NVFP4 Format' },
  recipe:   { file: 'nvfp4/training.py',  title: 'Training Recipe' },
  scaling:  { file: 'nvfp4/scaling_2d.py', title: '2D Weight Scaling' },
  hadamard: { file: 'nvfp4/hadamard.py',  title: 'Hadamard Transform' },
  results:  { file: 'nvfp4/results.py',   title: 'Benchmark Results' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ─── IntersectionObserver — TOC sync ────────────────────
const sectionMap = {
  's-problem':  'problem',
  's-format':   'format',
  's-recipe':   'recipe',
  's-scaling':  'scaling',
  's-hadamard': 'hadamard',
  's-results':  'results',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ─── Step navigator ──────────────────────────────────────
let recipeStep = 0;
const recipeBoxes = document.querySelectorAll('#recipe-steps .step-box');
const recipePrev  = document.getElementById('recipe-prev');
const recipeNext  = document.getElementById('recipe-next');
const recipeProg  = document.getElementById('recipe-prog');
function updateRecipe() {
  recipeBoxes.forEach((b, i) => {
    b.classList.remove('active','done');
    if (i === recipeStep) b.classList.add('active');
    else if (i < recipeStep) b.classList.add('done');
  });
  if (recipePrev) recipePrev.disabled = recipeStep === 0;
  if (recipeNext) recipeNext.disabled = recipeStep === recipeBoxes.length - 1;
  if (recipeProg) recipeProg.textContent = 'Step ' + (recipeStep + 1) + ' of ' + recipeBoxes.length;
  recipeBoxes.forEach((b, i) => {
    const n = b.querySelector('.step-num');
    if (n) n.textContent = i < recipeStep ? '✓' : String(i + 1);
  });
}
recipePrev?.addEventListener('click', () => { if (recipeStep > 0) { recipeStep--; updateRecipe(); } });
recipeNext?.addEventListener('click', () => { if (recipeStep < recipeBoxes.length - 1) { recipeStep++; updateRecipe(); } });
updateRecipe();

// ─── §01: Outlier canvas ─────────────────────────────────
(function() {
  const canvas = document.getElementById('outlier-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;

  // 16 values — clean block and outlier block
  const cleanVals   = [0.8, -1.2, 0.4, -0.7, 1.1, -0.5, 0.9, -1.4, 0.6, -0.8, 1.0, -0.3, 0.7, -1.1, 1.3, -0.6];
  const outlierVals = [0.8, -1.2, 0.4, -0.7, 1.1, -0.5, 0.9, -1.4, 0.6, -0.8, 1.0, -0.3, 0.7, -1.1, 18.3, -0.6];

  const FP4 = [0, 0.5, 1.0, 1.5, 2.0, 3.0, 4.0, 6.0];
  function fp4Nearest(y) {
    const ay = Math.abs(y);
    let best = 0, bestDist = Infinity;
    for (const v of FP4) {
      const d = Math.abs(ay - v);
      if (d < bestDist) { bestDist = d; best = v; }
    }
    return best * Math.sign(y || 1);
  }
  function quantizeBlock(vals) {
    const m = Math.max(...vals.map(Math.abs));
    const s = 6.0 / m;
    return vals.map(v => fp4Nearest(v * s) / s);
  }

  let mode = 'clean';

  function drawOutlierCanvas() {
    const W = canvas.clientWidth;
    const H = 220;
    canvas.width  = W * DPR;
    canvas.height = H * DPR;
    ctx.scale(DPR, DPR);

    ctx.clearRect(0, 0, W, H);

    const vals = mode === 'clean' ? cleanVals : outlierVals;
    const qVals = quantizeBlock(vals);
    const maxAbs = Math.max(...vals.map(Math.abs));

    const padL = 36, padR = 12, padT = 24, padB = 32;
    const chartW = W - padL - padR;
    const chartH = H - padT - padB;
    const barW = chartW / vals.length - 2;
    const midY = padT + chartH * (maxAbs / (maxAbs * 2));

    // Zero line
    ctx.strokeStyle = 'rgba(255,255,255,0.12)';
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(padL, midY); ctx.lineTo(padL + chartW, midY); ctx.stroke();

    // Y labels
    ctx.fillStyle = '#5c6370';
    ctx.font = '9px monospace';
    ctx.textAlign = 'right';
    const yLabel = Math.ceil(maxAbs);
    ctx.fillText('+' + yLabel, padL - 4, padT + 8);
    ctx.fillText('0', padL - 4, midY + 3);
    ctx.fillText('-' + yLabel, padL - 4, padT + chartH - 2);

    vals.forEach((v, i) => {
      const x = padL + i * (barW + 2) + 1;
      const qv = qVals[i];

      // Original bar (gray)
      const h = Math.abs(v) / maxAbs * (chartH / 2) * 0.9;
      const y0 = v >= 0 ? midY - h : midY;
      ctx.fillStyle = 'rgba(171,178,191,0.35)';
      ctx.fillRect(x, v >= 0 ? midY - h : midY, barW, h);

      // Quantized bar (colored)
      const hq = Math.abs(qv) / maxAbs * (chartH / 2) * 0.9;
      let barColor;
      if (mode === 'clean') {
        barColor = 'rgba(16,185,129,0.65)';
      } else {
        const err = Math.abs(v - qv);
        if (err < 0.05) barColor = 'rgba(16,185,129,0.65)';
        else if (Math.abs(qv) < 0.001) barColor = 'rgba(239,68,68,0.55)';
        else barColor = 'rgba(245,158,11,0.65)';
      }
      ctx.fillStyle = barColor;
      ctx.fillRect(x + 1, qv >= 0 ? midY - hq : midY, barW - 2, Math.max(hq, 1));

      // Index label
      ctx.fillStyle = '#5c6370';
      ctx.font = '8px monospace';
      ctx.textAlign = 'center';
      if (i % 4 === 0) ctx.fillText(String(i), x + barW/2, H - padB + 12);
    });

    // Legend
    ctx.fillStyle = 'rgba(171,178,191,0.5)';
    ctx.fillRect(padL, H - 14, 14, 9);
    ctx.fillStyle = '#5c6370';
    ctx.font = '9px monospace';
    ctx.textAlign = 'left';
    ctx.fillText('original', padL + 18, H - 6);

    ctx.fillStyle = mode === 'clean' ? 'rgba(16,185,129,0.7)' : 'rgba(245,158,11,0.7)';
    ctx.fillRect(padL + 80, H - 14, 14, 9);
    ctx.fillStyle = '#5c6370';
    ctx.fillText('quantized', padL + 98, H - 6);

    if (mode === 'outlier') {
      ctx.fillStyle = 'rgba(239,68,68,0.6)';
      ctx.fillRect(padL + 170, H - 14, 14, 9);
      ctx.fillStyle = '#5c6370';
      ctx.fillText('→ 0 (lost)', padL + 188, H - 6);
    }

    // Caption
    const cap = document.getElementById('outlier-caption');
    if (cap) {
      const maxV = maxAbs.toFixed(1);
      const minRep = (0.5 * maxAbs / 6).toFixed(3);
      const zeroed = qVals.filter((v, i) => Math.abs(qVals[i]) < 0.001 && i !== 14).length;
      if (mode === 'clean') {
        cap.textContent = 'Block max = ' + maxV + ' → min representable = ' + minRep + ' · all 16 values survive quantization';
      } else {
        cap.textContent = 'Block max = ' + maxV + ' → min representable = ' + (0.5 * 18.3 / 6).toFixed(2) + ' · ' + zeroed + ' of 15 normal values → 0';
      }
    }
  }

  document.getElementById('btn-clean')?.addEventListener('click', () => {
    mode = 'clean';
    document.getElementById('btn-clean').classList.add('active');
    document.getElementById('btn-outlier').classList.remove('active');
    drawOutlierCanvas();
  });
  document.getElementById('btn-outlier')?.addEventListener('click', () => {
    mode = 'outlier';
    document.getElementById('btn-outlier').classList.add('active');
    document.getElementById('btn-clean').classList.remove('active');
    drawOutlierCanvas();
  });

  drawOutlierCanvas();
  window.addEventListener('resize', drawOutlierCanvas);
})();

// ─── §04: 2D scaling matrix ──────────────────────────────
(function() {
  const grid = document.getElementById('matrix-grid');
  const desc = document.getElementById('matrix-desc');
  const summary = document.getElementById('matrix-summary');
  if (!grid) return;

  // 4×4 weight matrix
  const W = [
    [ 0.3, -0.8,  1.2, -0.4],
    [ 2.1, -1.5,  0.7, -2.3],
    [ 0.5, -0.2,  1.8, -0.9],
    [ 1.1, -1.4,  0.6, -1.7],
  ];

  const FP4 = [0, 0.5, 1.0, 1.5, 2.0, 3.0, 4.0, 6.0];
  function fp4Nearest(y) {
    const ay = Math.abs(y);
    let best = 0, bestDist = Infinity;
    for (const v of FP4) {
      const d = Math.abs(ay - v);
      if (d < bestDist) { bestDist = d; best = v; }
    }
    return best * (y >= 0 ? 1 : -1);
  }
  function qHat(v, M) {
    const s = 6.0 / M;
    return fp4Nearest(v * s) / s;
  }
  function rowMax(r) { return Math.max(...W[r].map(Math.abs)); }
  function colMax(c) { return Math.max(...W.map(row => Math.abs(row[c]))); }
  function blockMax2x2(r, c) {
    let m = 0;
    for (let dr = 0; dr < 2; dr++)
      for (let dc = 0; dc < 2; dc++)
        m = Math.max(m, Math.abs(W[r+dr][c+dc]));
    return m;
  }

  function getCellInfo(mode, r, c) {
    let scaleLabel = '';
    let isConsistent = true;

    if (mode === 'fwd') {
      const M = rowMax(r);
      scaleLabel = 'M=' + M.toFixed(1);
      // in forward mode, all cells are "reference" — no comparison yet
      isConsistent = null; // neutral
    } else if (mode === 'bwd') {
      const Mrow = rowMax(r);
      const Mcol = colMax(c);
      const qFwd = qHat(W[r][c], Mrow);
      const qBwd = qHat(W[r][c], Mcol);
      scaleLabel = 'M=' + Mcol.toFixed(1);
      isConsistent = Math.abs(qFwd - qBwd) < 1e-6;
    } else if (mode === '2d') {
      const br = Math.floor(r / 2) * 2;
      const bc = Math.floor(c / 2) * 2;
      const M2d = blockMax2x2(br, bc);
      scaleLabel = 'M=' + M2d.toFixed(1);
      isConsistent = true;
    }
    return { scaleLabel, isConsistent };
  }

  let currentMode = 'fwd';

  function renderMatrix(mode) {
    grid.innerHTML = '';
    let redCount = 0, greenCount = 0;

    for (let r = 0; r < 4; r++) {
      for (let c = 0; c < 4; c++) {
        const { scaleLabel, isConsistent } = getCellInfo(mode, r, c);
        const cell = document.createElement('div');
        cell.className = 'mcell';

        if (isConsistent === null) cell.classList.add('mcell-neutral');
        else if (isConsistent) { cell.classList.add('mcell-green'); greenCount++; }
        else { cell.classList.add('mcell-red'); redCount++; }

        const valEl = document.createElement('div');
        valEl.className = 'cv';
        valEl.textContent = W[r][c].toFixed(1);

        const scaleEl = document.createElement('div');
        scaleEl.className = 'cs';
        scaleEl.textContent = scaleLabel;

        cell.appendChild(valEl);
        cell.appendChild(scaleEl);
        grid.appendChild(cell);
      }
    }

    if (mode === 'fwd') {
      desc.textContent = 'Scale = max of each row (forward pass)';
      summary.innerHTML = '<strong style="color:var(--text2)">1D Forward Pass</strong><br>Each row uses its own maximum to set the scale. This is the reference quantization — W[i][j] is quantized with row-i max.<br><br><span style="color:var(--muted)">Cells shown in neutral — click "1D Backward" to see which become inconsistent.</span>';
    } else if (mode === 'bwd') {
      desc.textContent = 'Scale = max of each column (backward pass, W transposed)';
      summary.innerHTML = '<strong style="color:var(--text2)">1D Backward Pass</strong><br>In the backward pass W is transposed, so each element W[i][j] now uses <em>column-j max</em> for its scale. <span style="color:#f87171"><strong>' + redCount + ' cells</strong></span> get a different quantized value than in the forward pass.<br><br><span style="color:#5c6370">Red = chain rule broken for this weight. Green = same quantization by coincidence (row max = col max).</span>';
    } else {
      desc.textContent = 'Scale = max of each 2×2 block (NVFP4 2D scaling)';
      summary.innerHTML = '<strong style="color:var(--text2)">NVFP4 2D Block Scaling</strong><br>Each 2×2 block has one scale used for both forward (row access) and backward (column access). <span style="color:var(--green)"><strong>All ' + (16) + ' cells</strong></span> have identical quantization in both passes — the chain rule is preserved.<br><br><span style="color:#5c6370">In the actual 12B model this uses 16×16 blocks for the full weight dimensions.</span>';
    }
  }

  document.getElementById('mbtn-fwd')?.addEventListener('click', () => {
    currentMode = 'fwd';
    document.getElementById('mbtn-fwd').classList.add('active');
    document.getElementById('mbtn-bwd').classList.remove('active');
    document.getElementById('mbtn-2d').classList.remove('active');
    renderMatrix('fwd');
  });
  document.getElementById('mbtn-bwd')?.addEventListener('click', () => {
    currentMode = 'bwd';
    document.getElementById('mbtn-bwd').classList.add('active');
    document.getElementById('mbtn-fwd').classList.remove('active');
    document.getElementById('mbtn-2d').classList.remove('active');
    renderMatrix('bwd');
  });
  document.getElementById('mbtn-2d')?.addEventListener('click', () => {
    currentMode = '2d';
    document.getElementById('mbtn-2d').classList.add('active');
    document.getElementById('mbtn-fwd').classList.remove('active');
    document.getElementById('mbtn-bwd').classList.remove('active');
    renderMatrix('2d');
  });

  renderMatrix('fwd');
})();

// ─── §05: Hadamard canvas ────────────────────────────────
(function() {
  const canvas = document.getElementById('hadamard-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;

  // 16 values: 15 small + 1 outlier
  const before = [0.3, -0.2, 0.4, -0.1, 0.2, -0.3, 0.1, 0.4, -0.2, 0.3, -0.4, 0.2, 0.1, -0.3, 0.2, 15.8];
  // After Hadamard: energy spread — each element ~±3.95 ± small
  const after  = [3.9, -4.1, 3.8, -4.0, 4.2, -3.7, 4.0, -3.9, 4.1, -3.8, 3.9, -4.2, 4.0, -3.8, 3.7, 4.1];

  let t = 0; // 0=before, 1=after
  let animId = null;
  let animating = false;

  function lerp(a, b, t) { return a + (b - a) * t; }
  function easeInOut(t) { return t < 0.5 ? 2*t*t : -1+(4-2*t)*t; }

  function drawHadamard(progress) {
    const W = canvas.clientWidth;
    const H = 200;
    canvas.width  = W * DPR;
    canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
    ctx.clearRect(0, 0, W, H);

    const vals = before.map((b, i) => lerp(b, after[i], progress));
    const maxAbs = Math.max(...vals.map(v => Math.abs(v)), 0.1);

    const padL = 28, padR = 12, padT = 20, padB = 28;
    const chartW = W - padL - padR;
    const chartH = H - padT - padB;
    const n = vals.length;
    const barW = chartW / n - 2;
    const midY = padT + chartH / 2;

    // Zero line
    ctx.strokeStyle = 'rgba(255,255,255,0.12)';
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(padL, midY); ctx.lineTo(padL + chartW, midY); ctx.stroke();

    // Y labels
    ctx.fillStyle = '#5c6370'; ctx.font = '9px monospace'; ctx.textAlign = 'right';
    ctx.fillText('+' + maxAbs.toFixed(0), padL - 4, padT + 8);
    ctx.fillText('0', padL - 4, midY + 3);
    ctx.fillText('-' + maxAbs.toFixed(0), padL - 4, padT + chartH - 2);

    vals.forEach((v, i) => {
      const x = padL + i * (barW + 2) + 1;
      const h = Math.abs(v) / maxAbs * (chartH / 2) * 0.9;

      // Color: before=amber, after=cyan, transition=mix
      const r1 = 245, g1 = 158, b1 = 11;
      const r2 = 6,   g2 = 182, b2 = 212;
      const cr = Math.round(r1 + (r2 - r1) * progress);
      const cg = Math.round(g1 + (g2 - g1) * progress);
      const cb = Math.round(b1 + (b2 - b1) * progress);
      ctx.fillStyle = 'rgba(' + cr + ',' + cg + ',' + cb + ',0.7)';

      ctx.fillRect(x, v >= 0 ? midY - h : midY, barW, Math.max(h, 1));

      // Index
      if (i % 4 === 0) {
        ctx.fillStyle = '#5c6370'; ctx.font = '8px monospace'; ctx.textAlign = 'center';
        ctx.fillText(String(i), x + barW/2, H - padB + 12);
      }
    });

    // Show FP4 range indicators
    const fp4Max = 6;
    const fp4Y = padT + chartH / 2 - (fp4Max / maxAbs) * (chartH / 2) * 0.9;
    ctx.strokeStyle = 'rgba(16,185,129,0.3)';
    ctx.setLineDash([3, 3]);
    ctx.beginPath(); ctx.moveTo(padL, fp4Y); ctx.lineTo(padL + chartW, fp4Y); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(padL, H - padB - (fp4Y - padT)); ctx.lineTo(padL + chartW, H - padB - (fp4Y - padT)); ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle = 'rgba(16,185,129,0.5)'; ctx.font = '8px monospace'; ctx.textAlign = 'left';
    ctx.fillText('FP4 max ±6', padL + chartW - 58, fp4Y - 2);

    const label = document.getElementById('hbar-label');
    if (label) {
      if (progress < 0.05) label.textContent = 'before transform — outlier at index 15 = 15.8';
      else if (progress > 0.95) label.textContent = 'after Hadamard — energy spread, all values ~±4';
      else label.textContent = 'transforming...';
    }
  }

  function resize() { drawHadamard(t); }
  window.addEventListener('resize', resize);

  document.getElementById('hbar-play')?.addEventListener('click', () => {
    if (animating) return;
    animating = true;
    t = 0;
    const start = performance.now();
    const dur = 1400;
    function step(now) {
      const p = Math.min((now - start) / dur, 1);
      t = easeInOut(p);
      drawHadamard(t);
      if (p < 1) animId = requestAnimationFrame(step);
      else { animating = false; t = 1; }
    }
    animId = requestAnimationFrame(step);
  });

  document.getElementById('hbar-reset')?.addEventListener('click', () => {
    if (animId) cancelAnimationFrame(animId);
    animating = false;
    t = 0;
    drawHadamard(0);
  });

  drawHadamard(0);
})();

// ─── §06: Animated bar chart ─────────────────────────────
const tokenBars = document.getElementById('token-bars');
if (tokenBars) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          b.style.width = b.dataset.w + '%';
        });
      }
    });
  }, { threshold: 0.3 }).observe(tokenBars);
}
</script>

</BaseLayout>

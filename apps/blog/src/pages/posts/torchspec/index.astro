SEQ   = 131072          # 128K context
HID   = 7168            # target hidden dim
AUX   = 3 * HID         # low + mid + high = 21504
BF16  = 2               # bytes

aux  = SEQ * AUX * BF16        # 5.25 GB
last = SEQ * HID * BF16        # 1.75 GB
per_sample = aux + last        # ~7.0 GB

# Dataset-scale storage if you keep it all:
for n in (10_000, 100_000, 600_000):
    tb = n * per_sample / 1e12
    print(n, "samples ->", round(tb), "TB")
# 10k -> 70 TB   100k -> 700 TB   600k -> 4200 TB`,

  eagle: `# EAGLE-3 draft: fuse 3 target layers, draft in token space
def eagle3_step(target, draft, prompt, k=3):
    # 1. target forward exposes low/mid/high hidden states
    h_low, h_mid, h_high = target.forward(prompt, return_aux=True)
    h = torch.cat([h_low, h_mid, h_high], dim=-1)   # (seq, 21504)

    # 2. one-layer draft autoregresses k tokens from h
    proposals = draft.generate(h, k=k)              # ["mat","floor","rug"]

    # 3. target verifies the whole tree in ONE pass
    logits = target(prompt + proposals)

    # 4. accept the longest prefix matching target's dist
    return longest_accepted_prefix(logits, proposals)`,

  approaches: `# Why the two classic approaches break at 1T params
TARGET_GB = 575          # Kimi K2.5 MoE weights

# --- co-located (online): share GPUs with the target ---
def leftover_per_gpu(total_gb, gpus=8):
    return (total_gb - TARGET_GB) / gpus

leftover_per_gpu(1128)   # 8xH200 -> ~69 GB
leftover_per_gpu(640)    # 8xH100 -> ~8 GB  (caps ctx ~4K)
# draft parallelism is CHAINED to target sharding -> 1 node only

# --- offline dump: decouple, but write everything ---

from mooncake import Store

store = Store(transport="rdma")   # GPU-Direct RDMA, TCP fallback

# inference side: push captured features (zero-copy)
def on_forward(hidden, sample_id):
    store.put(sample_id, hidden)   # pinned buffer, no serialize

# training side: pull and step
for sample_id in schedule:
    h = store.get(sample_id)       # lands directly in GPU mem
    loss = draft_loss(draft, h)
    loss.backward(); opt.step()
# nothing ever touches the filesystem`,

  results: `# Kimi K2.5 EAGLE-3 trained on the disaggregated stack
config = dict(

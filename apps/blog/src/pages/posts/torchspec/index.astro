// ---------- helper: hi-dpi canvas ----------
function fitCanvas(cv, h) {
  const DPR = window.devicePixelRatio || 1;
  const W = cv.clientWidth || cv.parentElement.clientWidth;
  cv.width = W * DPR; cv.height = h * DPR;
  const ctx = cv.getContext('2d');
  ctx.setTransform(DPR,0,0,DPR,0,0);
  return { ctx, W, H: h };
}

// ============ 01 storage explosion ============
(function(){
  const cv = document.getElementById('cv-storage');
  if (!cv) return;
  let nSamples = 100000;
  const cap = document.getElementById('storage-cap');
  function draw() {
    const { ctx, W, H } = fitCanvas(cv, 280);
    ctx.clearRect(0,0,W,H);
    const tb = nSamples * 7.0 / 1000; // TB
    // draft model tiny box (left)
    ctx.fillStyle = '#10b981';
    ctx.fillRect(30, H-70, 46, 50);
    ctx.fillStyle = '#7ee0bd';
    ctx.font = '11px monospace'; ctx.textAlign='center';
    ctx.fillText('draft', 53, H-78);
    ctx.fillStyle = '#6b7280';
    ctx.fillText('~0.3 GB', 53, H-6);
    // mountain of hidden states (right) — height scales with log(tb)
    const maxH = H-50;
    const frac = Math.min(1, Math.log10(tb)/Math.log10(4200));
    const mh = 30 + frac*(maxH-30);
    const mx0 = 140, mx1 = W-40;
    const grad = ctx.createLinearGradient(0, H-20-mh, 0, H-20);
    grad.addColorStop(0, '#8b5cf6'); grad.addColorStop(1, '#3b2a66');
    ctx.fillStyle = grad;
    ctx.beginPath();
    ctx.moveTo(mx0, H-20);
    ctx.lineTo((mx0+mx1)/2, H-20-mh);
    ctx.lineTo(mx1, H-20);
    ctx.closePath(); ctx.fill();
    // ground
    ctx.strokeStyle = 'rgba(255,255,255,0.12)';
    ctx.beginPath(); ctx.moveTo(20,H-20); ctx.lineTo(W-20,H-20); ctx.stroke();
    // big TB label
    ctx.fillStyle = '#a78bfa';
    ctx.font = '700 30px monospace'; ctx.textAlign='center';
    const lbl = tb >= 1000 ? (tb/1000).toFixed(1)+' PB' : Math.round(tb)+' TB';
    ctx.fillText(lbl, (mx0+mx1)/2, H-20-mh-14);
    ctx.fillStyle = '#9aa0ab'; ctx.font='11px monospace';
    ctx.fillText('hidden states to move', (mx0+mx1)/2, H-6);
    cap.textContent = `${nSamples.toLocaleString()} samples × 7.0 GB = ${lbl}. The draft is ~0.3 GB — the data dwarfs both models.`;
  }
  document.querySelectorAll('#storage-ctrls .vp-btn').forEach(b =>
    b.addEventListener('click', () => {
      document.querySelectorAll('#storage-ctrls .vp-btn').forEach(x=>x.classList.remove('active'));
      b.classList.add('active'); nSamples = +b.dataset.n; draw();
    }));
  draw();
  window.addEventListener('resize', draw);
})();

// ============ 02 eagle step navigator ============
(function(){
  const boxes = document.querySelectorAll('#eagle-steps .step-box');
  if (!boxes.length) return;
  let step = 0;
  const prev = document.getElementById('eagle-prev');
  const next = document.getElementById('eagle-next');
  const prog = document.getElementById('eagle-prog');
  function upd(){
    boxes.forEach((b,i)=>{
      b.classList.remove('active','done');
      if(i===step) b.classList.add('active');
      else if(i<step) b.classList.add('done');
      const n=b.querySelector('.step-num');
      if(n) n.textContent = i<step ? '✓' : String(i+1);
    });
    prev.disabled = step===0; next.disabled = step===boxes.length-1;
    prog.textContent = `Step ${step+1} of ${boxes.length}`;
  }
  prev.addEventListener('click',()=>{if(step>0){step--;upd();}});
  next.addEventListener('click',()=>{if(step<boxes.length-1){step++;upd();}});
  upd();
})();

// ============ 03 approaches toggle ============
(function(){
  const cv = document.getElementById('cv-approach');
  if (!cv) return;
  let mode = 'colocated';
  const cap = document.getElementById('approach-cap');
  function box(ctx,x,y,w,h,stroke,fill,label,sub,subc){
    ctx.fillStyle=fill; ctx.strokeStyle=stroke; ctx.lineWidth=1.5;
    ctx.beginPath(); ctx.roundRect(x,y,w,h,8); ctx.fill(); ctx.stroke();
    ctx.textAlign='center';
    ctx.fillStyle=stroke; ctx.font='700 12px monospace'; ctx.fillText(label,x+w/2,y+22);
    if(sub){ctx.fillStyle=subc||'#6b7280'; ctx.font='10px monospace'; ctx.fillText(sub,x+w/2,y+40);}
  }
  function draw(){
    const { ctx, W, H } = fitCanvas(cv, 320);
    ctx.clearRect(0,0,W,H);
    ctx.textAlign='center';
    if(mode==='colocated'){
      // one GPU node holding target + squeezed training
      const x=W/2-150, w=300;
      box(ctx,x,40,w,210,'rgba(6,182,212,.5)','rgba(6,182,212,.06)','8×H100 NODE','640 GB total','#6b7280');
      // target fills most
      ctx.fillStyle='rgba(6,182,212,.18)'; ctx.strokeStyle='rgba(6,182,212,.5)';
      ctx.beginPath(); ctx.roundRect(x+20,80,w-40,120,6); ctx.fill(); ctx.stroke();
      ctx.fillStyle='#9fe7f5'; ctx.font='700 13px monospace'; ctx.fillText('TARGET — 575 GB',x+w/2,135);
      ctx.fillStyle='#6b7280'; ctx.font='10px monospace'; ctx.fillText('rigid sharding · 1 node only',x+w/2,158);
      // tiny leftover
      ctx.fillStyle='rgba(245,158,11,.18)'; ctx.strokeStyle='rgba(245,158,11,.6)';
      ctx.beginPath(); ctx.roundRect(x+20,210,w-40,28,5); ctx.fill(); ctx.stroke();
      ctx.fillStyle='#f5c97b'; ctx.font='700 11px monospace'; ctx.fillText('draft training: ~8 GB → ctx ≤ 4K',x+w/2,228);
      // wall
      ctx.fillStyle='#f87171'; ctx.font='700 13px monospace';
      ctx.fillText('⛔ WALL: no memory, no scaling',W/2,285);
      cap.textContent='Co-located: target eats the node, ~8 GB left for training on H100, context capped near 4K, draft sharding chained to target — single node only.';
    } else {
      // target -> disk -> trainer
      box(ctx,40,110,180,90,'rgba(6,182,212,.5)','rgba(6,182,212,.06)','TARGET','generate features','#6b7280');
      // disk mountain
      ctx.fillStyle='rgba(139,92,246,.2)'; ctx.strokeStyle='rgba(139,92,246,.6)';
      const dx=W/2-55;
      ctx.beginPath(); ctx.roundRect(dx,90,110,130,8); ctx.fill(); ctx.stroke();
      ctx.fillStyle='#a78bfa'; ctx.font='700 22px monospace'; ctx.fillText('700',dx+55,150);
      ctx.font='700 13px monospace'; ctx.fillText('TB DISK',dx+55,172);
      ctx.fillStyle='#6b7280'; ctx.font='10px monospace'; ctx.fillText('shared FS',dx+55,196);
      box(ctx,W-220,110,180,90,'rgba(16,185,129,.5)','rgba(16,185,129,.06)','TRAINER','waits on I/O','#f5c97b');
      // arrows
      ctx.strokeStyle='#8b5cf6'; ctx.lineWidth=2;
      ctx.beginPath(); ctx.moveTo(222,155); ctx.lineTo(dx-4,155); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(dx+114,155); ctx.lineTo(W-222,155); ctx.stroke();
      ctx.fillStyle='#f87171'; ctx.font='700 13px monospace';
      ctx.fillText('⛔ WALL: 700 TB + I/O bottleneck',W/2,285);
      cap.textContent='Offline: decoupled and flexible, but every feature is written then re-read — hundreds of TB on a shared filesystem, trainer bottlenecked on I/O.';
    }
  }
  document.querySelectorAll('#approach-ctrls .vp-btn').forEach(b =>
    b.addEventListener('click', () => {
      document.querySelectorAll('#approach-ctrls .vp-btn').forEach(x=>x.classList.remove('active'));
      b.classList.add('active'); mode=b.dataset.a; draw();
    }));
  draw();
  window.addEventListener('resize', draw);
})();

// ============ 05 streaming flow ============
(function(){
  const cv = document.getElementById('cv-stream');
  if (!cv) return;
  let mode='stream', playing=false, t=0, raf=null;
  const cap = document.getElementById('stream-cap');
  const playBtn = document.getElementById('stream-play');
  function seededRand(n){return ((1664525*n+1013904223)&0x7fffffff)/0x7fffffff;}
  const N=14;
  function draw(){
    const { ctx, W, H } = fitCanvas(cv, 300);
    ctx.clearRect(0,0,W,H);
    const srcX=70, dstX=W-70, midY=H/2;
    // src + dst GPU boxes
    function gpu(x,color,label){
      ctx.fillStyle=color+'22'; ctx.strokeStyle=color; ctx.lineWidth=1.5;
      ctx.beginPath(); ctx.roundRect(x-45,midY-55,90,110,8); ctx.fill(); ctx.stroke();
      ctx.fillStyle=color; ctx.font='700 11px monospace'; ctx.textAlign='center';
      ctx.fillText(label,x,midY-62);
    }
    gpu(srcX,'#06b6d4','INFERENCE GPU');
    gpu(dstX,'#10b981','TRAINING GPU');
    if(mode==='disk'){
      // disk in the middle
      ctx.fillStyle='rgba(139,92,246,.18)'; ctx.strokeStyle='rgba(139,92,246,.6)';
      ctx.beginPath(); ctx.roundRect(W/2-45,midY-32,90,64,8); ctx.fill(); ctx.stroke();
      ctx.fillStyle='#a78bfa'; ctx.font='700 12px monospace'; ctx.textAlign='center';
      ctx.fillText('DISK',W/2,midY-40);
      ctx.fillStyle='#6b7280'; ctx.font='9px monospace'; ctx.fillText('700 TB',W/2,midY+4);
    }
    // packets
    for(let i=0;i<N;i++){
      const phase=(t + seededRand(i)*1)%1;
      let x,y=midY-30+seededRand(i*3)*60;
      let col;
      if(mode==='stream'){
        x = srcX + (dstX-srcX)*phase;
        col='#a78bfa';
      } else {
        // first half src->disk, second half disk->dst (slower, staged)
        if(phase<0.5){ x=srcX+(W/2-srcX)*(phase/0.5); col='#06b6d4'; }
        else { x=W/2+(dstX-W/2)*((phase-0.5)/0.5); col='#10b981'; }
      }
      ctx.fillStyle=col;
      ctx.beginPath(); ctx.roundRect(x-7,y-5,14,10,2); ctx.fill();
    }
    // path label
    ctx.textAlign='center'; ctx.font='11px monospace';
    if(mode==='stream'){
      ctx.fillStyle='#10b981';
      ctx.fillText('zero-copy RDMA · never lands on disk', W/2, H-18);
    } else {
      ctx.fillStyle='#f59e0b';
      ctx.fillText('write → read · staged through filesystem', W/2, H-18);
    }
  }
  function loop(){
    if(!playing) return;
    t += mode==='stream' ? 0.010 : 0.006;
    if(t>1) t-=1;
    draw();
    raf=requestAnimationFrame(loop);
  }
  playBtn.addEventListener('click',()=>{
    playing=!playing;
    playBtn.textContent = playing ? '❚❚ Pause' : '▶ Play';
    if(playing) loop(); else if(raf) cancelAnimationFrame(raf);
  });
  document.querySelectorAll('#stream-ctrls .vp-btn[data-mode]').forEach(b =>
    b.addEventListener('click', () => {
      document.querySelectorAll('#stream-ctrls .vp-btn[data-mode]').forEach(x=>x.classList.remove('active'));
      b.classList.add('active'); mode=b.dataset.mode;
      cap.textContent = mode==='stream'
        ? 'Stream: features fly inference-GPU → training-GPU over RDMA. No disk, full GPU memory for the draft → 44K–200K context.'
        : 'Disk: features are written to the filesystem then read back — two hops, serialize/deserialize, I/O contention.';
      draw();
    }));
  cap.textContent='Stream: features fly inference-GPU → training-GPU over RDMA. No disk, full GPU memory for the draft → 44K–200K context.';
  draw();
  window.addEventListener('resize', draw);
})();

// ============ 06 results bars ============
(function(){
  const sec = document.getElementById('s-results');
  if (!sec) return;

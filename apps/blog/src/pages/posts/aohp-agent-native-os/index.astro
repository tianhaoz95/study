<span class="cs-line">    <span class="str">"budget"</span>: <span class="num">400</span>,</span>
<span class="cs-line">    <span class="str">"delivery"</span>: <span class="str">"2d"</span>,</span>
<span class="cs-line">    <span class="str">"profile"</span>: <span class="fn">load</span>(PROFILE_MEM),</span>
<span class="cs-line">&#125;</span>
      </pre>

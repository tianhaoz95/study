    <div class="cs-panel" id="panel-interfaces">
      <pre class="cs-pre">
<span class="cs-line cmt"># Interface mode selection — always</span>
<span class="cs-line cmt"># take the cheapest available path</span>
<span class="cs-line"></span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">invoke</span>(cap: <span class="cls">Capability</span>, args):</span>
<span class="cs-line hl-p">    <span class="kw">if</span> cap.mode == <span class="str">"api"</span>:</span>
<span class="cs-line hl-p">        <span class="kw">return</span> <span class="fn">call_api</span>(cap, args)    <span class="cmt"># ~20 tok</span></span>
<span class="cs-line">    <span class="kw">elif</span> cap.mode == <span class="str">"cli"</span>:</span>
<span class="cs-line hl-g">        <span class="kw">return</span> <span class="fn">sandbox_exec</span>(cap, args) <span class="cmt"># ~30 tok</span></span>
<span class="cs-line">    <span class="kw">elif</span> cap.mode == <span class="str">"sUI"</span>:</span>
<span class="cs-line hl-c">        <span class="kw">return</span> <span class="fn">structured_ui</span>(cap, args) <span class="cmt"># ~100 tok</span></span>
<span class="cs-line">    <span class="kw">else</span>:  <span class="cmt"># gui — last resort</span></span>
<span class="cs-line hl-a">        <span class="kw">return</span> <span class="fn">screenshot_act</span>(cap, args) <span class="cmt"># ~500 tok</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Parallel background execution</span>
<span class="cs-line hl-g"><span class="kw">def</span> <span class="fn">parallel_search</span>(query, apps):</span>
<span class="cs-line hl-g">    vdisps = [<span class="fn">VirtualDisplay</span>() <span class="kw">for</span> _ <span class="kw">in</span> apps]</span>
<span class="cs-line hl-g">    <span class="kw">return</span> <span class="fn">gather</span>([  <span class="cmt"># runs concurrently</span></span>
<span class="cs-line hl-g">        <span class="fn">invoke</span>(app.search, query, vd)</span>
<span class="cs-line hl-g">        <span class="kw">for</span> app, vd <span class="kw">in</span> <span class="fn">zip</span>(apps, vdisps)</span>
<span class="cs-line hl-g">    ])</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Event stream subscription</span>
<span class="cs-line">stream = <span class="fn">EventStream</span>(<span class="str">"notifications"</span>)</span>
<span class="cs-line">otp = <span class="kw">await</span> stream.<span class="fn">wait_for</span>(<span class="str">"bank_sms"</span>)</span>
<span class="cs-line"><span class="cmt"># otp arrives even if toast is gone</span></span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-security">
      <pre class="cs-pre">
<span class="cs-line cmt"># Information flow security</span>
<span class="cs-line cmt"># Sensitive data → vault token → agent</span>
<span class="cs-line"></span>
<span class="cs-line hl-p"><span class="kw">class</span> <span class="cls">SensitiveSource</span>:</span>
<span class="cs-line hl-p">    <span class="kw">def</span> <span class="fn">read</span>(<span class="kw">self</span>):</span>
<span class="cs-line hl-p">        plain = <span class="kw">self</span>.<span class="fn">_raw_value</span>()</span>
<span class="cs-line hl-p">        tok = vault.<span class="fn">store</span>(plain)  <span class="cmt"># uuid</span></span>
<span class="cs-line hl-p">        taint.<span class="fn">mark</span>(tok, source=<span class="kw">self</span>)</span>
<span class="cs-line hl-p">        <span class="kw">return</span> tok  <span class="cmt"># "&lt;payment-card:a3f9&gt;"</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Agent only ever sees the token:</span>
<span class="cs-line cmt"># card = "&lt;payment-card:a3f9&gt;"</span>
<span class="cs-line cmt"># agent submits: pay(card, amount=320)</span>
<span class="cs-line"></span>
<span class="cs-line hl-c"><span class="kw">def</span> <span class="fn">vault_exec</span>(token, action, args):</span>
<span class="cs-line hl-c">    plain = vault.<span class="fn">get</span>(token)  <span class="cmt"># trusted only</span></span>
<span class="cs-line hl-c">    policy.<span class="fn">check</span>(token, action)</span>
<span class="cs-line hl-c">    <span class="kw">if</span> policy.<span class="fn">requires_consent</span>(action):</span>
<span class="cs-line hl-c">        user.<span class="fn">approve</span>(action, source, dest)</span>
<span class="cs-line hl-c">    result = <span class="fn">execute</span>(plain, action, args)</span>
<span class="cs-line hl-c">    <span class="kw">if</span> <span class="fn">is_sensitive</span>(result):</span>
<span class="cs-line hl-c">        <span class="kw">return</span> vault.<span class="fn">store</span>(result)  <span class="cmt"># new tok</span></span>
<span class="cs-line hl-c">    <span class="kw">return</span> result</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Taint tracking across app boundaries</span>
<span class="cs-line hl-a"><span class="kw">def</span> <span class="fn">check_sink</span>(data, sink):</span>
<span class="cs-line hl-a">    <span class="kw">if</span> taint.<span class="fn">is_marked</span>(data):</span>
<span class="cs-line hl-a">        policy.<span class="fn">enforce</span>(data, sink)</span>
<span class="cs-line hl-a">        audit.<span class="fn">log</span>(data, sink, taint.<span class="fn">path</span>(data))</span>
      </pre>
    </div>


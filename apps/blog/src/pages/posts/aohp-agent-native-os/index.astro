<script>
// ─── TOC + sidebar toggles ───
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});

const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ─── Code sidebar tab switching ───
const tabMeta = {
  mismatch:   { file: 'aohp/overview.py',      title: 'The OS Mismatch' },
  entrances:  { file: 'aohp/composition.py',   title: 'Service Entrances' },
  interfaces: { file: 'aohp/interfaces.py',    title: 'Agent Interfaces' },
  security:   { file: 'aohp/vault.py',         title: 'Secure Info Flow' },
  results:    { file: 'aohp/benchmark.py',      title: 'Results' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ─── IntersectionObserver: sync TOC + sidebar ───
const sectionMap = {
  's-mismatch':   'mismatch',
  's-entrances':  'entrances',
  's-interfaces': 'interfaces',
  's-security':   'security',
  's-results':    'results',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.25 }).observe(s)
);

// ─── §01 Mismatch Canvas ───
(function() {
  const canvas = document.getElementById('mismatch-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  let W, H;
  function resize() {
    W = canvas.clientWidth; H = 280;
    canvas.width = W * DPR; canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
    draw();
  }
  resize();
  window.addEventListener('resize', resize);

  let showAOHP = false;
  document.getElementById('mis-toggle')?.addEventListener('click', () => {
    showAOHP = !showAOHP;
    const lbl = document.getElementById('mis-label');
    if (lbl) lbl.textContent = 'Showing: ' + (showAOHP ? 'AOHP' : 'Stock Android');
    draw();
  });

  function roundRect(x, y, w, h, r) {
    ctx.beginPath();
    ctx.moveTo(x+r, y);
    ctx.lineTo(x+w-r, y); ctx.arcTo(x+w, y, x+w, y+r, r);
    ctx.lineTo(x+w, y+h-r); ctx.arcTo(x+w, y+h, x+w-r, y+h, r);
    ctx.lineTo(x+r, y+h); ctx.arcTo(x, y+h, x, y+h-r, r);
    ctx.lineTo(x, y+r); ctx.arcTo(x, y, x+r, y, r);
    ctx.closePath();
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    if (showAOHP) drawAOHP(); else drawStock();
  }

  function drawStock() {
    // Title
    ctx.fillStyle = 'rgba(245,158,11,0.85)';
    ctx.font = 'bold 13px var(--ff-mono, monospace)';
    ctx.textAlign = 'center';
    ctx.fillText('Stock Android — 3 Apps, Sequential', W/2, 22);

    // Agent
    const ax = W/2, ay = 50;
    ctx.beginPath(); ctx.arc(ax, ay, 18, 0, Math.PI*2);
    ctx.fillStyle = 'rgba(139,92,246,0.25)';
    ctx.fill();
    ctx.strokeStyle = '#8b5cf6'; ctx.lineWidth = 1.5; ctx.stroke();
    ctx.fillStyle = '#a78bfa'; ctx.font = '11px sans-serif'; ctx.textAlign = 'center';
    ctx.fillText('Agent', ax, ay + 4);

    // Three app boxes
    const apps = [
      { label: 'JD', x: W*0.15, col: '#06b6d4' },
      { label: 'Taobao', x: W*0.50, col: '#10b981' },
      { label: 'Amazon', x: W*0.82, col: '#f59e0b' },
    ];
    const bw = Math.min(100, W*0.22), bh = 80, by = 130;
    apps.forEach(a => {
      const bx = a.x - bw/2;
      roundRect(bx, by, bw, bh, 8);
      ctx.fillStyle = a.col + '18';
      ctx.fill();
      ctx.strokeStyle = a.col + '80'; ctx.lineWidth = 1;
      ctx.stroke();
      ctx.fillStyle = a.col;
      ctx.font = 'bold 11px var(--ff-mono, monospace)';
      ctx.textAlign = 'center';
      ctx.fillText(a.label, a.x, by + 24);
      ctx.fillStyle = 'rgba(255,255,255,0.35)';
      ctx.font = '9px var(--ff-mono, monospace)';
      ctx.fillText('launch → screenshot', a.x, by + 42);
      ctx.fillText('tap → screenshot...', a.x, by + 56);
      ctx.fillText('~500 tok/step', a.x, by + 70);

      // Arrow from agent to app
      ctx.beginPath();
      ctx.moveTo(ax, ay + 18);
      ctx.lineTo(a.x, by - 5);
      ctx.strokeStyle = a.col + '50'; ctx.lineWidth = 1;
      ctx.setLineDash([4,4]); ctx.stroke(); ctx.setLineDash([]);
    });

    // Cost badge
    ctx.fillStyle = 'rgba(239,68,68,0.12)';
    roundRect(W/2 - 90, 228, 180, 36, 6); ctx.fill();
    ctx.strokeStyle = 'rgba(239,68,68,0.3)'; ctx.lineWidth = 1; ctx.stroke();
    ctx.fillStyle = '#f87171'; ctx.font = 'bold 10px var(--ff-mono, monospace)';
    ctx.textAlign = 'center';
    ctx.fillText('Sequential • 233 tool calls • 7.1M tokens', W/2, 244);
    ctx.fillStyle = 'rgba(255,255,255,0.4)'; ctx.font = '9px var(--ff-mono, monospace)';
    ctx.fillText('completion: 54.44%', W/2, 256);
  }

  function drawAOHP() {
    // Title
    ctx.fillStyle = '#a78bfa';
    ctx.font = 'bold 13px var(--ff-mono, monospace)';
    ctx.textAlign = 'center';
    ctx.fillText('AOHP — Single Generated Entrance', W/2, 22);

    // Agent
    const ax = W/2, ay = 50;
    ctx.beginPath(); ctx.arc(ax, ay, 18, 0, Math.PI*2);
    ctx.fillStyle = 'rgba(139,92,246,0.35)';
    ctx.fill();
    ctx.strokeStyle = '#8b5cf6'; ctx.lineWidth = 2; ctx.stroke();
    ctx.fillStyle = '#a78bfa'; ctx.font = '11px sans-serif'; ctx.textAlign = 'center';
    ctx.fillText('Agent', ax, ay + 4);

    // Single entrance box
    const ew = Math.min(320, W*0.7), eh = 80, ex = W/2 - ew/2, ey = 118;
    roundRect(ex, ey, ew, eh, 10);
    ctx.fillStyle = 'rgba(139,92,246,0.15)'; ctx.fill();
    ctx.strokeStyle = '#8b5cf6'; ctx.lineWidth = 1.5; ctx.stroke();
    ctx.fillStyle = '#a78bfa'; ctx.font = 'bold 12px var(--ff-mono, monospace)';
    ctx.textAlign = 'center';
    ctx.fillText('🛍  Shopping Entrance (Generated)', W/2, ey + 22);
    ctx.fillStyle = 'rgba(255,255,255,0.5)'; ctx.font = '9px var(--ff-mono, monospace)';
    ctx.fillText('API call → structured result → <20 tok/step', W/2, ey + 40);
    ctx.fillText('Parallel: JD + Taobao + Amazon simultaneously', W/2, ey + 55);
    ctx.fillText('Card: <payment-card:a3f9>  (vault token)', W/2, ey + 70);

    // Arrow from agent to entrance
    ctx.beginPath(); ctx.moveTo(ax, ay+18); ctx.lineTo(W/2, ey-5);
    ctx.strokeStyle = '#8b5cf6'; ctx.lineWidth = 1.5; ctx.stroke();

    // Three sub-services below
    const svcs = ['JD API', 'Taobao sUI', 'Amazon API'];
    const sw = Math.min(80, W*0.18), sh = 40, sy = ey + eh + 18;
    const sx0 = W/2 - sw*1.5 - 10;
    svcs.forEach((s, i) => {
      const sx = sx0 + i * (sw + 10);
      roundRect(sx, sy, sw, sh, 6);
      const cols = ['#06b6d4', '#8b5cf6', '#f59e0b'];
      ctx.fillStyle = cols[i] + '18'; ctx.fill();
      ctx.strokeStyle = cols[i] + '60'; ctx.lineWidth = 1; ctx.stroke();
      ctx.fillStyle = cols[i]; ctx.font = '9px var(--ff-mono, monospace)'; ctx.textAlign = 'center';
      ctx.fillText(s, sx + sw/2, sy + 16);
      ctx.fillStyle = 'rgba(255,255,255,0.35)';
      ctx.fillText('parallel', sx + sw/2, sy + 30);
      // Arrow from entrance
      ctx.beginPath(); ctx.moveTo(sx + sw/2, sy);
      ctx.lineTo(sx + sw/2, ey + eh + 5);
      ctx.strokeStyle = cols[i] + '40'; ctx.lineWidth = 1;
      ctx.setLineDash([3,3]); ctx.stroke(); ctx.setLineDash([]);
    });

    // Cost badge
    ctx.fillStyle = 'rgba(16,185,129,0.1)';
    roundRect(W/2 - 90, 228, 180, 36, 6); ctx.fill();
    ctx.strokeStyle = 'rgba(16,185,129,0.3)'; ctx.lineWidth = 1; ctx.stroke();
    ctx.fillStyle = '#10b981'; ctx.font = 'bold 10px var(--ff-mono, monospace)';
    ctx.textAlign = 'center';
    ctx.fillText('Parallel • 129 tool calls • 3.4M tokens', W/2, 244);
    ctx.fillStyle = 'rgba(255,255,255,0.4)'; ctx.font = '9px var(--ff-mono, monospace)';
    ctx.fillText('completion: 75.56%', W/2, 256);
  }
})();

// ─── §03 Interface Cost Canvas ───
(function() {
  const canvas = document.getElementById('cost-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  let W, H;
  function resize() {
    W = canvas.clientWidth; H = 220;
    canvas.width = W * DPR; canvas.height = H * DPR;
    ctx.scale(DPR, DPR); draw();
  }
  resize(); window.addEventListener('resize', resize);

  const modes = [
    { label: 'API', cost: 20,  col: '#10b981', note: 'direct structured call' },
    { label: 'CLI', cost: 30,  col: '#06b6d4', note: 'sandbox exec' },
    { label: 'Structured UI', cost: 100, col: '#8b5cf6', note: 'semantic tree' },
    { label: 'Rendered GUI', cost: 500, col: '#f59e0b', note: 'raw screenshot' },
  ];
  const maxCost = 500;

  function draw() {
    ctx.clearRect(0, 0, W, H);
    const padL = 130, padR = 16, padT = 24, padB = 32;
    const cw = W - padL - padR, ch = H - padT - padB;
    const barH = Math.min(38, (ch - 3*12) / 4);
    const gap = (ch - 4*barH) / 3;

    ctx.fillStyle = 'rgba(255,255,255,0.06)';
    ctx.font = '10px var(--ff-mono, monospace)'; ctx.textAlign = 'center'; ctx.fillStyle = 'rgba(255,255,255,0.25)';
    ctx.fillText('Token cost per agent step (lower = better)', W/2, 14);

    modes.forEach((m, i) => {
      const y = padT + i * (barH + gap);
      const bw = (m.cost / maxCost) * cw;

      // Label
      ctx.fillStyle = m.col; ctx.font = 'bold 10px var(--ff-mono, monospace)';
      ctx.textAlign = 'right';
      ctx.fillText(m.label, padL - 8, y + barH/2 + 4);

      // Bar
      const grad = ctx.createLinearGradient(padL, 0, padL + bw, 0);
      grad.addColorStop(0, m.col + 'cc');
      grad.addColorStop(1, m.col + '55');
      ctx.fillStyle = grad;
      ctx.beginPath();
      ctx.roundRect(padL, y, bw, barH, 4);
      ctx.fill();

      // Cost label
      ctx.fillStyle = 'rgba(255,255,255,0.85)';
      ctx.font = 'bold 10px var(--ff-mono, monospace)';
      ctx.textAlign = 'left';
      ctx.fillText('~' + m.cost + ' tok', padL + bw + 6, y + barH/2 + 4);

      // Note
      ctx.fillStyle = 'rgba(255,255,255,0.35)';
      ctx.font = '9px var(--ff-mono, monospace)';
      ctx.fillText(m.note, padL + 8, y + barH - 6);
    });

    // X axis tick at 500
    ctx.strokeStyle = 'rgba(255,255,255,0.08)'; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(padL + cw, padT); ctx.lineTo(padL + cw, padT + ch); ctx.stroke();
    ctx.fillStyle = 'rgba(255,255,255,0.2)'; ctx.font = '9px var(--ff-mono, monospace)'; ctx.textAlign = 'center';
    ctx.fillText('500', padL + cw, padT + ch + 14);
    ctx.fillText('tokens / step', padL + cw/2, padT + ch + 14);
  }
})();

// ─── §04 Taint Flow Canvas ───
(function() {
  const canvas = document.getElementById('taint-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  let W = canvas.clientWidth, H = 240;
  canvas.width = W * DPR; canvas.height = H * DPR;
  ctx.scale(DPR, DPR);

  const stages = [
    { label: 'App UI',        sub: '4242-4242-4242-4242',  x: 0.10, col: '#ef4444', danger: true },
    { label: 'Sanitizer',     sub: 'detects sensitive',     x: 0.32, col: '#f59e0b', danger: false },
    { label: 'Vault Token',   sub: '<payment-card:a3f9>',   x: 0.55, col: '#8b5cf6', danger: false },
    { label: 'Agent Context', sub: 'sees token only',        x: 0.75, col: '#10b981', danger: false },
    { label: 'Vault Executor',sub: 'mediates + logs',        x: 0.93, col: '#06b6d4', danger: false },
  ];

  let t = 0, raf = null, playing = false;

  function drawFrame() {
    ctx.clearRect(0, 0, W, H);
    const cy = H / 2;
    const R = 28;

    // Draw connecting line
    ctx.beginPath();
    ctx.moveTo(stages[0].x * W, cy);
    ctx.lineTo(stages[stages.length-1].x * W, cy);
    ctx.strokeStyle = 'rgba(255,255,255,0.06)'; ctx.lineWidth = 2;
    ctx.stroke();

    // Draw stage nodes
    stages.forEach((s, i) => {
      const sx = s.x * W;
      // Glow if active (based on t)
      const stageT = i / (stages.length - 1);
      const active = Math.abs(t - stageT) < 0.12;
      if (active) {
        ctx.beginPath(); ctx.arc(sx, cy, R + 8, 0, Math.PI*2);
        ctx.fillStyle = s.col + '22'; ctx.fill();
      }
      // Circle
      ctx.beginPath(); ctx.arc(sx, cy, R, 0, Math.PI*2);
      ctx.fillStyle = s.col + '28'; ctx.fill();
      ctx.strokeStyle = active ? s.col : s.col + '60';
      ctx.lineWidth = active ? 2 : 1; ctx.stroke();
      // Label
      ctx.fillStyle = active ? s.col : s.col + 'aa';
      ctx.font = 'bold 9px var(--ff-mono, monospace)'; ctx.textAlign = 'center';
      ctx.fillText(s.label, sx, cy - R - 10);
      ctx.fillStyle = 'rgba(255,255,255,0.4)'; ctx.font = '8px var(--ff-mono, monospace)';
      ctx.fillText(s.sub, sx, cy + R + 16);
      // Icon
      const icons = ['🏦', '🔒', '🏷️', '🤖', '✅'];
      ctx.font = '18px sans-serif'; ctx.textAlign = 'center';
      ctx.fillText(icons[i], sx, cy + 7);
    });

    // Animated dot
    const dot_x = t * (stages[stages.length-1].x - stages[0].x) * W + stages[0].x * W;
    const stageIdx = Math.floor(t * (stages.length - 1));
    const dotCol = stages[Math.min(stageIdx, stages.length-1)].danger ? '#ef4444' : '#8b5cf6';
    ctx.beginPath(); ctx.arc(dot_x, cy, 7, 0, Math.PI*2);
    ctx.fillStyle = dotCol; ctx.fill();
    ctx.strokeStyle = 'rgba(255,255,255,0.4)'; ctx.lineWidth = 1; ctx.stroke();

    // Label at dot
    ctx.fillStyle = 'rgba(255,255,255,0.6)'; ctx.font = '8px var(--ff-mono, monospace)'; ctx.textAlign = 'center';
    if (t < 0.15) ctx.fillText('plaintext', dot_x, cy - 14);
    else if (t < 0.45) ctx.fillText('sanitizing...', dot_x, cy - 14);
    else ctx.fillText('token', dot_x, cy - 14);
  }

  drawFrame();

  function animate() {
    if (!playing) return;
    t += 0.003;
    if (t >= 1) { t = 1; playing = false; drawFrame(); return; }
    drawFrame();
    raf = requestAnimationFrame(animate);
  }

  document.getElementById('taint-play')?.addEventListener('click', () => {
    if (t >= 1) t = 0;
    playing = true; animate();
  });
  document.getElementById('taint-reset')?.addEventListener('click', () => {
    playing = false; if (raf) cancelAnimationFrame(raf); t = 0; drawFrame();
  });
})();

// ─── §05 Animated bar chart ───
const resultsSection = document.getElementById('s-results');
if (resultsSection) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          b.style.width = (parseFloat(b.dataset.w) / 100 * 100) + '%';
        });
      }
    });
  }, { threshold: 0.3 }).observe(resultsSection);
}

// ─── §02 Service Composition Step Navigator ───
(function() {
  let step = 0;
  const boxes  = document.querySelectorAll('#comp-steps .step-box');
  const prev   = document.getElementById('comp-prev');
  const next   = document.getElementById('comp-next');
  const prog   = document.getElementById('comp-prog');
  function updateSteps() {
    boxes.forEach((b, i) => {
      b.classList.remove('active', 'done');
      if (i === step) b.classList.add('active');
      else if (i < step) b.classList.add('done');
    });
    if (prev) prev.disabled = step === 0;
    if (next) next.disabled = step === boxes.length - 1;
    if (prog) prog.textContent = 'Step ' + (step+1) + ' of ' + boxes.length;
    boxes.forEach((b, i) => {
      const n = b.querySelector('.step-num');
      if (n) n.textContent = i < step ? '✓' : String(i+1);
    });
  }
  prev?.addEventListener('click', () => { if (step > 0) { step--; updateSteps(); } });
  next?.addEventListener('click', () => { if (step < boxes.length - 1) { step++; updateSteps(); } });
  updateSteps();
})();
</script>
</BaseLayout>

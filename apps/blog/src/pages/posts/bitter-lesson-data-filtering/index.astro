<span class="cs-line hl-p">    loss(train(D, M=M, N=N))</span>
<span class="cs-line hl-p">    <span class="kw">for</span> M <span class="kw">in</span> [<span class="num">15e6</span>, <span class="num">80e6</span>, <span class="num">330e6</span>, <span class="num">1e9</span>, <span class="num">7e9</span>]</span>
<span class="cs-line hl-p">    <span class="kw">for</span> N <span class="kw">in</span> powers_of_2(<span class="num">1e9</span>, <span class="num">1e13</span>)</span>
<span class="cs-line hl-p">  )</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Model configs (Llama-style)</span>
<span class="cs-line"><span class="cmt"># 15M:  128 hidden, 8 layers, 8 heads</span></span>
<span class="cs-line"><span class="cmt"># 80M:  512 hidden, 8 layers, 8 heads</span></span>
<span class="cs-line"><span class="cmt"># 330M: 1024 hidden, 18 layers, 16 heads</span></span>
<span class="cs-line"><span class="cmt"># 1B:   2048 hidden, 17 layers, 16 heads</span></span>
<span class="cs-line"><span class="cmt"># 7B:   4096 hidden, 32 layers, 32 heads</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Training setup</span>
<span class="cs-line hl-c">context_length = <span class="num">1024</span></span>
<span class="cs-line hl-c">batch_tokens   = <span class="num">2</span>**<span class="num">19</span>   <span class="cmt"># 524,288 tokens/step</span></span>
<span class="cs-line hl-c">warmup_steps   = <span class="num">500</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Evaluation datasets (out-of-distribution)</span>
<span class="cs-line hl-g">eval_sets = [<span class="str">"C4-en"</span>, <span class="str">"FineWeb-Edu"</span>, <span class="str">"Cosmopedia"</span>]</span>
<span class="cs-line hl-g">metric    = <span class="str">"avg negative log-likelihood"</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Total compute: 20,000+ H200 GPU-hours</span>

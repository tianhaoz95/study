---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { postReadTime } from '../../../lib/readTimes';
const readTime = postReadTime(Astro.url.pathname.split('/').filter(Boolean).at(-1)!);
---
<BaseLayout
  title="A Bitter Lesson for Data Filtering | Catpuccino.ai"
  description="With enough compute, the best data filter is no data filter. Stanford researchers show that sufficiently large models not only tolerate junk data — they benefit from it."
  crumb="Bitter Lesson: Data Filtering"
>

<style is:global>
/* ── Post base ─────────────────────────────────────────────────────────── */
.post-hero{padding:6.5rem 2rem 3rem;max-width:1700px;margin:0 auto}
.post-hero .tags{margin-bottom:1.25rem}

<span class="cs-line cmt"># 2. Epoch constraint (4 epochs)</span>
<span class="cs-line hl-g">max_epochs = <span class="num">4</span>           <span class="cmt"># N = 4 * m</span></span>
<span class="cs-line hl-g"><span class="cmt"># → C = 6 * M * 4 * m = 24 * M * m</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Both fits give R² > 0.99 in log-log space</span>

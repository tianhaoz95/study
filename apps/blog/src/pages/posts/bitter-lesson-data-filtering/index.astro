    <!-- theory -->
    <div class="cs-panel" id="panel-theory">
      <pre class="cs-pre">
<span class="cs-line cmt"># Proposition 7.1: Rank Necessity</span>
<span class="cs-line cmt"># Low-rank matrix factorization model</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Setup: k tasks, task i occurs w/ prob pᵢ</span>
<span class="cs-line cmt"># Y = U*ᵢ V*ᵢᵀ X + ξ  (rank-1 per task)</span>
<span class="cs-line cmt"># Σᵢ = E[XᵢXᵢᵀ], tr(ΣᵢΣⱼ) = 0 for i≠j</span>
<span class="cs-line cmt"># (orthogonal task inputs)</span>
<span class="cs-line"></span>
<span class="cs-line hl-p"><span class="cmt"># Optimal loss for rank-r model:</span></span>
<span class="cs-line hl-p"><span class="cmt"># min E[‖Y - UVᵀX‖²] = Σⱼ₌ᵣ₊₁ᵖ σⱼ² + E[‖ξ‖²]</span></span>
<span class="cs-line hl-p"><span class="cmt"># where σⱼ = singular values of M*Σ^(1/2)</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Key result:</span>
<span class="cs-line hl-g"><span class="cmt"># If r ≥ k: sum = 0 → optimal loss = noise only</span></span>
<span class="cs-line hl-g"><span class="cmt"># If r &lt; k: sum > 0 → interference penalty</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Consequence for LLM pretraining:</span>
<span class="cs-line"><span class="cmt"># "Tasks" = distinct data distributions</span></span>
<span class="cs-line"><span class="cmt"># (real text, shuffled words, random strings)</span></span>
<span class="cs-line"><span class="cmt"># Small model (r &lt; k): noise tasks consume</span></span>
<span class="cs-line hl-c"><span class="cmt">#   capacity → real tasks suffer</span></span>
<span class="cs-line"><span class="cmt"># Large model (r ≥ k): noise tasks absorbed</span></span>
<span class="cs-line hl-g"><span class="cmt">#   into orthogonal subspace → no penalty</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Also: at r ≥ k, gradient descent converges</span>
<span class="cs-line cmt"># to global optimum (no non-strict saddles)</span>
<span class="cs-line cmt"># [Baldi & Hornik 1988, Zhu et al. 2018]</span>
      </pre>
    </div>

  </div>
</aside>

</div><!-- /post-grid -->

<script>
// ── TOC + sidebar toggles ────────────────────────────────────────────────
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});
const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ── Code sidebar tab switching ───────────────────────────────────────────
const tabMeta = {
  assumption: { file: 'filtering/assumption.py',  title: 'The Filter Assumption' },
  experiment: { file: 'filtering/experiment.py',  title: 'The Experiment' },
  crossover:  { file: 'filtering/crossover.py',   title: 'The Crossover' },
  junk:       { file: 'filtering/junk.py',         title: 'Junk Data' },
  scaling:    { file: 'filtering/scaling_law.py',  title: 'Scaling Laws' },
  theory:     { file: 'filtering/theory.py',       title: 'Theory' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ── IntersectionObserver: sync TOC + sidebar tab ─────────────────────────
const sectionMap = {
  's-assumption': 'assumption',
  's-experiment': 'experiment',
  's-crossover':  'crossover',
  's-junk':       'junk',
  's-scaling':    'scaling',
  's-theory':     'theory',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ── Step navigator ───────────────────────────────────────────────────────
let step = 0;
const boxes   = document.querySelectorAll('.step-box');
const prevBtn = document.getElementById('step-prev');
const nextBtn = document.getElementById('step-next');
const progEl  = document.getElementById('step-prog');
function updateSteps() {
  boxes.forEach((b, i) => {
    b.classList.remove('active', 'done');
    if (i === step) b.classList.add('active');
    else if (i < step) b.classList.add('done');
  });
  if (prevBtn) prevBtn.disabled = step === 0;
  if (nextBtn) nextBtn.disabled = step === boxes.length - 1;
  if (progEl)  progEl.textContent = `Step ${step+1} of ${boxes.length}`;
  boxes.forEach((b, i) => {
    const n = b.querySelector('.step-num');
    if (n) n.textContent = i < step ? '✓' : String(i+1);
  });
}
prevBtn?.addEventListener('click', () => { if (step > 0) { step--; updateSteps(); } });
nextBtn?.addEventListener('click', () => { if (step < boxes.length - 1) { step++; updateSteps(); } });
updateSteps();

// ── Retention bars animation ─────────────────────────────────────────────
const retBars = document.getElementById('retention-bars');
if (retBars) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        retBars.querySelectorAll('.ret-fill[data-pct]').forEach(b => {
          b.style.width = b.dataset.pct + '%';
        });
      }
    });
  }, { threshold: 0.3 }).observe(retBars);
}

// ── Crossover canvas ─────────────────────────────────────────────────────
(function() {
  const canvas = document.getElementById('crossover-canvas');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;

  // Model data: {cc, bestFilter, bestFilterName, dclm}
  // Values are final best-achieved NLL from paper Figure 1
  const modelData = {
    '15M':  { cc: 4.44, bf: 4.15, bfName: 'English', dclm: 5.22,
               ccRate: 1.3, bfRate: 2.1, dclmRate: 3.8 },
    '80M':  { cc: 3.75, bf: 3.68, bfName: 'English/SW', dclm: 5.06,
               ccRate: 1.6, bfRate: 2.4, dclmRate: 3.5 },
    '330M': { cc: 3.45, bf: 3.47, bfName: 'Stop Words', dclm: 5.20,
               ccRate: 2.1, bfRate: 2.2, dclmRate: 3.5 },
    '1B':   { cc: 3.37, bf: 3.46, bfName: 'Stop Words', dclm: 5.29,
               ccRate: 2.5, bfRate: 2.5, dclmRate: 3.5 },
  };

  let activeModel = '330M';

  function nll(t, final, start, rate, rebound) {
    let v = final + (start - final) * Math.exp(-rate * t);
    if (rebound) v += 0.75 * Math.pow(Math.max(0, t - 0.55), 2);
    return v;
  }

  function draw(modelKey) {
    const W = canvas.clientWidth;
    const H = 300;
    canvas.width  = W * DPR;
    canvas.height = H * DPR;
    const ctx = canvas.getContext('2d');
    ctx.scale(DPR, DPR);

    const pad = { top: 28, right: 115, bottom: 40, left: 52 };
    const pw = W - pad.left - pad.right;
    const ph = H - pad.top  - pad.bottom;

    const d = modelData[modelKey];
    const yMin = Math.min(d.cc, d.bf, d.dclm) - 0.35;
    const yMax = d.dclm + 0.55;

    // x axis: log10 from 9 to 11.2
    const xMinL = 9.0, xMaxL = 11.2;

    function xp(logX) { return pad.left + (logX - xMinL) / (xMaxL - xMinL) * pw; }
    function yp(y)    { return pad.top  + ph - (y - yMin) / (yMax - yMin) * ph; }

    ctx.clearRect(0, 0, W, H);

    // grid
    ctx.strokeStyle = 'rgba(255,255,255,0.04)';
    ctx.lineWidth = 1;
    for (let lx = 9; lx <= 11; lx++) {
      ctx.beginPath();
      ctx.moveTo(xp(lx), pad.top);
      ctx.lineTo(xp(lx), pad.top + ph);
      ctx.stroke();
    }
    const yGridStep = 0.5;
    for (let yv = Math.ceil(yMin / yGridStep) * yGridStep; yv <= yMax; yv += yGridStep) {
      ctx.beginPath();
      ctx.moveTo(pad.left, yp(yv));
      ctx.lineTo(pad.left + pw, yp(yv));
      ctx.stroke();
    }

    // axes
    ctx.strokeStyle = 'rgba(255,255,255,0.18)';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(pad.left, pad.top);
    ctx.lineTo(pad.left, pad.top + ph);
    ctx.lineTo(pad.left + pw, pad.top + ph);
    ctx.stroke();

    // x labels
    ctx.fillStyle = '#64748b';
    ctx.font = `${10 * Math.min(1, W/500)}px monospace`;
    ctx.textAlign = 'center';
    ['1B', '10B', '100B'].forEach((lbl, i) => {
      const lx = 9 + i;
      ctx.fillText(lbl, xp(lx), pad.top + ph + 16);
    });
    ctx.fillText('Training Tokens', xp((xMinL + xMaxL) / 2), pad.top + ph + 30);

    // y labels
    ctx.textAlign = 'right';
    for (let yv = Math.ceil(yMin / yGridStep) * yGridStep; yv <= yMax; yv += yGridStep) {
      ctx.fillText(yv.toFixed(1), pad.left - 5, yp(yv) + 3.5);
    }
    ctx.save();
    ctx.translate(12, pad.top + ph / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.textAlign = 'center';
    ctx.fillText('Avg NLL', 0, 0);
    ctx.restore();

    // draw a curve
    function drawCurve(final, start, rate, rebound, color, dash) {
      ctx.strokeStyle = color;
      ctx.lineWidth = 2;
      ctx.setLineDash(dash || []);
      ctx.beginPath();
      const steps = 120;
      for (let i = 0; i <= steps; i++) {
        const t    = i / steps;
        const logX = xMinL + t * (xMaxL - xMinL);
        const y    = nll(t, final, start, rate, rebound);
        const px   = xp(logX);
        const py   = yp(y);
        if (i === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
      }
      ctx.stroke();
      ctx.setLineDash([]);
    }

    // DCLM-Baseline (red dotted, rebound)
    drawCurve(d.dclm + 0.08, 6.1, d.dclmRate, true, '#f87171', [3, 4]);
    // Best filter (cyan dashed)
    drawCurve(d.bf, 6.3, d.bfRate, false, '#06b6d4', [6, 4]);
    // CC (white solid)
    drawCurve(d.cc, 6.5, d.ccRate, false, '#e2e8f0', []);

    // end-point labels
    ctx.setLineDash([]);
    const labelX = pad.left + pw + 6;
    ctx.textAlign = 'left';
    ctx.font = `bold ${10 * Math.min(1, W/500)}px monospace`;

    ctx.fillStyle = '#e2e8f0';
    ctx.fillText(`CC ${d.cc.toFixed(2)}`, labelX, yp(d.cc) + 4);

    ctx.fillStyle = '#06b6d4';
    ctx.fillText(`${d.bfName} ${d.bf.toFixed(2)}`, labelX, yp(d.bf) + 4);

    ctx.fillStyle = '#f87171';
    ctx.fillText(`D-B ${(d.dclm + 0.08).toFixed(2)}`, labelX, yp(d.dclm + 0.08) + 4);

    // winner annotation
    ctx.textAlign = 'center';
    ctx.font = `bold ${10}px monospace`;
    if (d.cc < d.bf) {
      ctx.fillStyle = '#a78bfa';
      ctx.fillText('★ CC wins', xp(10.8), yp(d.cc) - 12);
    } else {
      ctx.fillStyle = '#06b6d4';
      ctx.fillText('Filters win', xp(10.8), yp(d.bf) - 12);
    }
  }

  // button interaction
  document.querySelectorAll('#crossover-btns .model-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('#crossover-btns .model-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeModel = btn.dataset.model;
      draw(activeModel);
    });
  });

  // initial draw + resize
  draw(activeModel);
  window.addEventListener('resize', () => draw(activeModel));
})();

// ── Junk canvas ──────────────────────────────────────────────────────────
(function() {
  const canvas = document.getElementById('junk-canvas');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;

  // Data from Figure 3 (paper), best NLL for shuffled word injection
  // Left group: 330M model; Right group: 1B model
  const groups = [
    {
      label: '330M model',
      bars: [
        { name: 'CC (no junk)', val: 3.74, color: '#8b5cf6' },
        { name: '+100% shuffled', val: 3.77, color: '#64748b' },
        { name: '+200% shuffled', val: 3.81, color: '#64748b' },
        { name: '+400% shuffled', val: 3.89, color: '#64748b' },
        { name: '+800% shuffled', val: 4.02, color: '#64748b' },
      ]
    },
    {
      label: '1B model',
      bars: [
        { name: 'CC (no junk)', val: 3.40, color: '#8b5cf6' },
        { name: '+100% shuffled', val: 3.37, color: '#10b981' },
        { name: '+200% shuffled', val: 3.39, color: '#10b981' },
        { name: '+400% shuffled', val: 3.36, color: '#10b981' },
        { name: '+800% shuffled', val: 3.43, color: '#64748b' },
      ]
    }
  ];

  function drawJunk() {
    const W = canvas.clientWidth;
    const H = 300;
    canvas.width  = W * DPR;
    canvas.height = H * DPR;
    const ctx = canvas.getContext('2d');
    ctx.scale(DPR, DPR);
    ctx.clearRect(0, 0, W, H);

    const pad = { top: 30, right: 16, bottom: 16, left: 16 };
    const gw  = (W - pad.left - pad.right) / 2 - 12;

    groups.forEach((grp, gi) => {
      const gx = pad.left + gi * (gw + 24);
      const gy = pad.top;
      const gh = H - pad.top - pad.bottom;

      // group label
      ctx.fillStyle = '#94a3b8';
      ctx.font = `bold 10px monospace`;
      ctx.textAlign = 'center';
      ctx.fillText(grp.label, gx + gw / 2, gy - 10);

      // y scale: from yMin to yMax
      const vals = grp.bars.map(b => b.val);
      const yMin = Math.min(...vals) - 0.08;
      const yMax = Math.max(...vals) + 0.12;

      function barY(v) { return gy + gh - (v - yMin) / (yMax - yMin) * gh; }

      // grid lines
      ctx.strokeStyle = 'rgba(255,255,255,0.04)';
      ctx.lineWidth = 1;
      const step = 0.1;
      for (let y = Math.ceil(yMin / step) * step; y <= yMax; y += step) {
        ctx.beginPath();
        ctx.moveTo(gx, barY(y));
        ctx.lineTo(gx + gw, barY(y));
        ctx.stroke();
      }

      // axis
      ctx.strokeStyle = 'rgba(255,255,255,0.15)';
      ctx.beginPath();
      ctx.moveTo(gx, gy);
      ctx.lineTo(gx, gy + gh);
      ctx.lineTo(gx + gw, gy + gh);
      ctx.stroke();

      const barW = gw / grp.bars.length - 4;

      grp.bars.forEach((bar, bi) => {
        const bx  = gx + bi * (barW + 4) + 2;
        const by  = barY(bar.val);
        const bh  = gy + gh - by;

        ctx.fillStyle = bar.color;
        ctx.globalAlpha = 0.85;
        ctx.fillRect(bx, by, barW, bh);
        ctx.globalAlpha = 1;

        // value label above bar
        ctx.fillStyle = bar.color === '#64748b' ? '#94a3b8' : (bar.color === '#10b981' ? '#34d399' : '#a78bfa');
        ctx.font = `bold 9px monospace`;
        ctx.textAlign = 'center';
        ctx.fillText(bar.val.toFixed(2), bx + barW / 2, by - 4);

        // short x label (rotated)
        ctx.save();
        ctx.translate(bx + barW / 2, gy + gh + 3);
        ctx.rotate(-Math.PI / 3.5);
        ctx.fillStyle = '#475569';
        ctx.font = `8px monospace`;
        ctx.textAlign = 'right';
        ctx.fillText(bar.name.replace('shuffled', 'shuf.'), 0, 0);
        ctx.restore();
      });

      // "Beats CC" annotation for 1B model
      if (gi === 1) {
        ctx.fillStyle = '#10b981';
        ctx.font = '9px monospace';
        ctx.textAlign = 'center';
        ctx.fillText('↑ beats clean CC', gx + gw / 2, gy + 12);
      }
    });
  }

  drawJunk();
  window.addEventListener('resize', drawJunk);
})();

// ── Scaling law canvas ───────────────────────────────────────────────────
(function() {
  const canvas = document.getElementById('scaling-canvas');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;

  function drawScaling() {
    const W = canvas.clientWidth;
    const H = 300;
    canvas.width  = W * DPR;
    canvas.height = H * DPR;
    const ctx = canvas.getContext('2d');
    ctx.scale(DPR, DPR);
    ctx.clearRect(0, 0, W, H);

    const pad = { top: 24, right: 30, bottom: 50, left: 64 };
    const pw = W - pad.left - pad.right;
    const ph = H - pad.top - pad.bottom;

    // axes: log-log
    // x: pool size tokens, 1e8 to 3e14 (log10: 8 to 14.5)
    // y: compute FLOPs, 1e17 to 1e31 (log10: 17 to 31)
    const xMinL = 8, xMaxL = 14.5;
    const yMinL = 17, yMaxL = 31;

    function xp(lx) { return pad.left + (lx - xMinL) / (xMaxL - xMinL) * pw; }
    function yp(ly) { return pad.top  + ph - (ly - yMinL) / (yMaxL - yMinL) * ph; }

    // grid
    ctx.strokeStyle = 'rgba(255,255,255,0.04)';
    ctx.lineWidth = 1;
    for (let lx = 8; lx <= 14; lx++) {
      ctx.beginPath(); ctx.moveTo(xp(lx), pad.top); ctx.lineTo(xp(lx), pad.top + ph); ctx.stroke();
    }
    for (let ly = 18; ly <= 30; ly += 2) {
      ctx.beginPath(); ctx.moveTo(pad.left, yp(ly)); ctx.lineTo(pad.left + pw, yp(ly)); ctx.stroke();
    }

    // axes
    ctx.strokeStyle = 'rgba(255,255,255,0.18)';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(pad.left, pad.top); ctx.lineTo(pad.left, pad.top + ph); ctx.lineTo(pad.left + pw, pad.top + ph);
    ctx.stroke();

    // axis labels
    ctx.fillStyle = '#64748b';
    ctx.font = '9px monospace';
    ctx.textAlign = 'center';
    const xTicks = [[9,'1B'], [10,'10B'], [11,'100B'], [12,'1T'], [13,'10T'], [14,'100T']];
    xTicks.forEach(([lx, lbl]) => ctx.fillText(lbl, xp(lx), pad.top + ph + 14));
    ctx.fillText('Pool Size (tokens)', xp((xMinL + xMaxL) / 2), pad.top + ph + 28);

    ctx.textAlign = 'right';
    [[18,'1e18'],[20,'1e20'],[22,'1e22'],[24,'1e24'],[26,'1e26'],[28,'1e28'],[30,'1e30']].forEach(([ly, lbl]) => {
      ctx.fillText(lbl, pad.left - 5, yp(ly) + 3.5);
    });
    ctx.save();
    ctx.translate(14, pad.top + ph / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.textAlign = 'center';
    ctx.fillText('Compute (FLOPs)', 0, 0);
    ctx.restore();

    // Scaling law line (from Figure 6): roughly log(C) ≈ 1.86 * log(m) + b
    // Anchored to: (1e9, 2e19) and (2.4e14, 1e30)
    // slope: (30 - 19.3) / (14.38 - 9) = 10.7 / 5.38 ≈ 1.99
    const slope1 = 1.99;
    const intercept1 = 30 - slope1 * Math.log10(2.4e14); // ~1.01

    function scalingLine(lx) { return slope1 * lx + intercept1; }

    // 600 tokens/param line (slightly different slope from paper)
    const slope2 = 2.05;
    const intercept2 = 30 - slope2 * Math.log10(2.4e14);

    // draw line 1 (epoch-based, blue)
    ctx.strokeStyle = '#60a5fa';
    ctx.lineWidth = 2;
    ctx.setLineDash([]);
    ctx.beginPath();
    for (let lx = 8.5; lx <= 14.4; lx += 0.05) {
      const ly = scalingLine(lx);
      if (ly < yMinL || ly > yMaxL) continue;
      if (lx === 8.5) ctx.moveTo(xp(lx), yp(ly));
      else ctx.lineTo(xp(lx), yp(ly));
    }
    ctx.stroke();

    // draw line 2 (token-per-param, orange)
    ctx.strokeStyle = '#f97316';
    ctx.lineWidth = 2;
    ctx.setLineDash([5, 4]);
    ctx.beginPath();
    for (let lx = 8.5; lx <= 14.4; lx += 0.05) {
      const ly = slope2 * lx + intercept2;
      if (ly < yMinL || ly > yMaxL) continue;
      if (lx === 8.5) ctx.moveTo(xp(lx), yp(ly));
      else ctx.lineTo(xp(lx), yp(ly));
    }
    ctx.stroke();
    ctx.setLineDash([]);

    // Current frontier: 5e26
    const frontierY = Math.log10(5e26);
    ctx.strokeStyle = '#f87171';
    ctx.lineWidth = 1;
    ctx.setLineDash([4, 4]);
    ctx.beginPath();
    ctx.moveTo(pad.left, yp(frontierY));
    ctx.lineTo(pad.left + pw, yp(frontierY));
    ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle = '#f87171';
    ctx.font = '9px monospace';
    ctx.textAlign = 'right';
    ctx.fillText('Current frontier ~5×10²⁶', pad.left + pw - 4, yp(frontierY) - 4);

    // 240T pool vertical line
    const poolX = Math.log10(2.4e14);
    ctx.strokeStyle = '#a78bfa';
    ctx.lineWidth = 1;
    ctx.setLineDash([4, 4]);
    ctx.beginPath();
    ctx.moveTo(xp(poolX), pad.top);
    ctx.lineTo(xp(poolX), pad.top + ph);
    ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle = '#a78bfa';
    ctx.font = '9px monospace';
    ctx.textAlign = 'center';
    ctx.fillText('240T (full CC)', xp(poolX), pad.top + ph + 40);

    // Star at intersection (240T, 1e30)
    const sx = xp(Math.log10(2.4e14));
    const sy = yp(30);
    ctx.fillStyle = '#a78bfa';
    ctx.font = 'bold 14px monospace';
    ctx.textAlign = 'center';
    ctx.fillText('★', sx, sy + 5);
    ctx.font = 'bold 9px monospace';
    ctx.fillText('~10³⁰ FLOPs', sx + 30, sy - 4);

    // legend
    ctx.textAlign = 'left';
    ctx.font = '9px monospace';
    ctx.fillStyle = '#60a5fa';
    ctx.fillText('── 4-epoch fit', pad.left + 6, pad.top + 14);
    ctx.fillStyle = '#f97316';
    ctx.fillText('- - 600 tokens/param fit', pad.left + 6, pad.top + 26);
  }

  drawScaling();
  window.addEventListener('resize', drawScaling);
})();
</script>
</BaseLayout>

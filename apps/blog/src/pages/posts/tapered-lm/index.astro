---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Tapered Language Models: Free Perplexity via Layer-Aware Capacity | Catpuccino.ai"
  description="Modern LMs waste parameters in later layers that barely transform the residual stream. Tapered Language Models fix this by monotonically narrowing MLP width from early to late layers — −1.84 perplexity points with zero extra cost."
  crumb="Tapered LMs"
>


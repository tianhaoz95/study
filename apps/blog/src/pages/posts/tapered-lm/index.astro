<span class="cs-line cmt"># Three tapering schedules (Eq. 4-6)</span>
<span class="cs-line cmt"># All preserve total parameter budget</span>
<span class="cs-line"></span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">linear_taper</span>(l, L, d_start, d_end):</span>
<span class="cs-line">    <span class="kw">return</span> d_start - (d_start - d_end) * l/(L-<span class="num">1</span>)</span>
<span class="cs-line"></span>
<span class="cs-line hl-c"><span class="kw">def</span> <span class="fn">cosine_taper</span>(l, L, d_start, d_end):</span>
<span class="cs-line hl-c">    <span class="kw">import</span> math</span>
<span class="cs-line hl-c">    <span class="kw">return</span> d_end + (d_start - d_end) / <span class="num">2</span> \</span>
<span class="cs-line hl-c">        * (<span class="num">1</span> + math.<span class="fn">cos</span>(math.pi * l / (L-<span class="num">1</span>)))</span>
<span class="cs-line"></span>
<span class="cs-line hl-g"><span class="kw">def</span> <span class="fn">sigmoid_taper</span>(l, L, d_start, d_end, k=<span class="num">10</span>):</span>

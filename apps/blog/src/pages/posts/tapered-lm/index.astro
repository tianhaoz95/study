<span class="cs-line cmt"># Gains consistent across 760M and 1.3B</span>
<span class="cs-line cmt"># → does not saturate with model size</span>
<span class="cs-line"><span class="cmt"># → architecture-agnostic ✓</span></span>
<span class="cs-line"><span class="cmt"># → zero extra params or FLOPs ✓</span></span>
      </pre>
    </div>

  </div>
</aside>

</div><!-- /post-grid -->

<script>
/* ── TOC + sidebar toggles ── */
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});
const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

/* ── Code sidebar tabs ── */
const tabMeta = {
  default: { file: 'tapered_lm/model.py',     title: 'The Uniform Default' },
  novelty: { file: 'tapered_lm/analysis.py',  title: 'Layer Novelty Metric' },
  taper:   { file: 'tapered_lm/schedule.py',  title: 'Tapering Schedules' },
  sweep:   { file: 'tapered_lm/sweep.py',     title: 'Schedule × Width Sweep' },
  results: { file: 'tapered_lm/results.py',   title: 'Main Results' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

/* ── IntersectionObserver: TOC + sidebar sync ── */
const sectionMap = {
  's-default': 'default',
  's-novelty': 'novelty',
  's-taper':   'taper',
  's-sweep':   'sweep',
  's-results': 'results',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

/* ── Canvas helpers ── */
function setupCanvas(id, heightPx) {
  const el = document.getElementById(id);
  if (!el) return [null, null, 0, 0];
  const DPR = window.devicePixelRatio || 1;
  const W = el.clientWidth;
  const H = heightPx;
  el.style.height = H + 'px';
  el.width  = W * DPR;
  el.height = H * DPR;
  const ctx = el.getContext('2d');
  ctx.scale(DPR, DPR);
  return [el, ctx, W, H];
}

/* ═══════════════════════════════════════════
   §01 ALLOC CANVAS
   Shows three allocation profiles side-by-side:
   wider-early, uniform, wider-late
   with perplexity labels and interactivity
═══════════════════════════════════════════ */
(function() {
  const [el, ctx, W, H] = setupCanvas('alloc-canvas', 200);
  if (!ctx) return;

  const configs = [
    {
      label: 'Wider-Early',
      ppl:   '15.96',
      delta: '−0.32',
      color: '#10b981',
      // 8 layers per group: early=1.5×, mid=1.0×, late=0.5×
      widths: Array(8).fill(1.5).concat(Array(8).fill(1.0)).concat(Array(8).fill(0.5)),
    },
    {
      label: 'Uniform',
      ppl:   '16.28',
      delta: 'baseline',
      color: '#6b7280',
      widths: Array(24).fill(1.0),
    },
    {
      label: 'Wider-Late',
      ppl:   '17.29',
      delta: '+1.01',
      color: '#ef4444',
      widths: Array(8).fill(0.5).concat(Array(8).fill(1.0)).concat(Array(8).fill(1.5)),
    },
  ];
  let hovered = -1;

  function drawAlloc() {
    ctx.clearRect(0, 0, W, H);
    const padT = 52, padB = 28, padL = 10, padR = 10;
    const totalW = W - padL - padR;
    const configW = totalW / 3;
    const maxBarH = H - padT - padB;
    const nLayers = 24;
    const barGap = 2;
    const barW = (configW * 0.85 - barGap * (nLayers - 1)) / nLayers;

    configs.forEach((cfg, ci) => {
      const cx = padL + ci * configW;
      const isHov = (hovered === ci);
      const alpha = hovered === -1 ? 1 : (isHov ? 1 : 0.4);

      // PPL label at top
      ctx.globalAlpha = alpha;
      ctx.font = `bold 13px 'JetBrains Mono', monospace`;
      ctx.fillStyle = cfg.color;
      ctx.textAlign = 'center';
      ctx.fillText(`PPL ${cfg.ppl}`, cx + configW / 2, 16);
      ctx.font = `11px 'JetBrains Mono', monospace`;
      ctx.fillStyle = cfg.delta === 'baseline' ? '#6b7280' :
                      cfg.delta.startsWith('+') ? '#ef4444' : '#10b981';
      ctx.fillText(cfg.delta, cx + configW / 2, 32);

      // Label
      ctx.font = `bold 11px 'JetBrains Mono', monospace`;
      ctx.fillStyle = cfg.color;
      ctx.fillText(cfg.label, cx + configW / 2, H - 6);

      // Bars
      const barsX = cx + configW * 0.075;
      cfg.widths.forEach((w, li) => {
        const bh = Math.round(w * maxBarH * 0.65);
        const bx = barsX + li * (barW + barGap);
        const by = H - padB - bh;
        ctx.fillStyle = cfg.color;
        ctx.globalAlpha = alpha * (0.5 + 0.5 * w);
        ctx.beginPath();
        ctx.roundRect(bx, by, barW, bh, 2);
        ctx.fill();
      });
      ctx.globalAlpha = 1;
    });
  }

  el.addEventListener('mousemove', e => {
    const rect = el.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const cw = W / 3;
    hovered = Math.floor(x / cw);
    if (hovered < 0 || hovered > 2) hovered = -1;
    drawAlloc();
  });
  el.addEventListener('mouseleave', () => { hovered = -1; drawAlloc(); });
  drawAlloc();
})();

/* ═══════════════════════════════════════════
   §02 NOVELTY CANVAS
   Shows ρ_MLP vs layer depth for GPT-2 family
═══════════════════════════════════════════ */
(function() {
  const [el, ctx, W, H] = setupCanvas('novelty-canvas', 220);
  if (!ctx) return;

  const padL = 52, padR = 20, padT = 20, padB = 36;
  const gW = W - padL - padR, gH = H - padT - padB;

  // Simulated ρ_MLP profiles for GPT-2 family
  // Rises from low (~0.05) in early layers to high (~0.5+) in late layers
  // 4 model sizes, 12 layers each (normalized to 0..11)
  function makeProfile(seed, nL, startRho, endRho) {
    const pts = [];
    for (let l = 0; l < nL; l++) {
      const t = l / (nL - 1);
      // gentle S-curve rising from startRho to endRho with noise
      const base = startRho + (endRho - startRho) * (t * t * (3 - 2 * t));
      const noise = (((seed * 7 + l * 13) % 17) / 17 - 0.5) * 0.025;
      pts.push(Math.max(0, base + noise));
    }
    return pts;
  }

  const models = [
    { name: '124M', nL: 12, start: 0.05, end: 0.38, alpha: 0.4 },
    { name: '355M', nL: 24, start: 0.04, end: 0.44, alpha: 0.55 },
    { name: '774M', nL: 36, start: 0.03, end: 0.50, alpha: 0.75 },
    { name: '1.5B', nL: 48, start: 0.03, end: 0.56, alpha: 1.0  },
  ];

  // rho axis: 0 to 0.65
  const rhoMax = 0.65;

  function drawGrid() {
    ctx.strokeStyle = 'rgba(255,255,255,0.05)';
    ctx.lineWidth = 1;
    for (let v = 0; v <= 0.6; v += 0.2) {
      const y = padT + gH - (v / rhoMax) * gH;
      ctx.beginPath(); ctx.moveTo(padL, y); ctx.lineTo(padL + gW, y); ctx.stroke();
      ctx.fillStyle = '#6b7280';
      ctx.font = '10px monospace';
      ctx.textAlign = 'right';
      ctx.fillText(v.toFixed(1), padL - 5, y + 3);
    }
    for (let t = 0; t <= 1; t += 0.25) {
      const x = padL + t * gW;
      ctx.beginPath(); ctx.moveTo(x, padT); ctx.lineTo(x, padT + gH); ctx.stroke();
      ctx.fillStyle = '#6b7280';
      ctx.font = '10px monospace';
      ctx.textAlign = 'center';
      ctx.fillText(t === 0 ? 'early' : t === 1 ? 'late' : (t * 100).toFixed(0) + '%', x, padT + gH + 16);
    }
    // ρ=0 line
    ctx.strokeStyle = 'rgba(6,182,212,0.25)';
    ctx.setLineDash([4, 4]);
    const y0 = padT + gH;
    ctx.beginPath(); ctx.moveTo(padL, y0); ctx.lineTo(padL + gW, y0); ctx.stroke();
    ctx.setLineDash([]);
    // axes labels
    ctx.fillStyle = '#6b7280';
    ctx.font = '11px monospace';
    ctx.textAlign = 'center';
    ctx.fillText('layer depth (normalized)', padL + gW / 2, H - 2);
    ctx.save();
    ctx.translate(14, padT + gH / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.textAlign = 'center';
    ctx.fillText('ρ_MLP', 0, 0);
    ctx.restore();
  }

  function drawProfiles() {
    models.forEach((m, mi) => {
      const pts = makeProfile(mi + 1, m.nL, m.start, m.end);
      ctx.beginPath();
      pts.forEach((rho, li) => {
        const t = li / (pts.length - 1);
        const x = padL + t * gW;
        const y = padT + gH - (rho / rhoMax) * gH;
        if (li === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
      });
      ctx.strokeStyle = `rgba(139,92,246,${m.alpha})`;
      ctx.lineWidth = 1.8;
      ctx.stroke();
      // dot at end
      const lastRho = pts[pts.length - 1];
      ctx.beginPath();
      ctx.arc(padL + gW, padT + gH - (lastRho / rhoMax) * gH, 3, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(139,92,246,${m.alpha})`;
      ctx.fill();
    });
    // label for darkest line
    const last = models[3];
    const lastPts = makeProfile(4, last.nL, last.start, last.end);
    const midRho = lastPts[Math.floor(lastPts.length / 2)];
    ctx.fillStyle = '#8b5cf6';
    ctx.font = 'bold 10px monospace';
    ctx.textAlign = 'left';
    ctx.fillText('1.5B (darkest)', padL + gW * 0.5 + 8, padT + gH - (midRho / rhoMax) * gH - 6);
    ctx.fillStyle = 'rgba(139,92,246,0.4)';
    ctx.font = '10px monospace';
    ctx.fillText('124M (lightest)', padL + gW * 0.5 + 8, padT + gH - (makeProfile(1,12,0.05,0.38)[6] / rhoMax) * gH - 6);

    // "NOVEL → REDUNDANT" arrows
    ctx.fillStyle = '#10b981';
    ctx.font = 'bold 9px monospace';
    ctx.textAlign = 'left';
    ctx.fillText('← novel (ρ≈0)', padL + 4, padT + gH - 4);
    ctx.fillStyle = '#ef4444';
    ctx.textAlign = 'right';
    ctx.fillText('redundant (ρ>0) →', padL + gW - 4, padT + 14);
  }

  ctx.clearRect(0, 0, W, H);
  drawGrid();
  drawProfiles();
})();

/* ═══════════════════════════════════════════
   §03 TAPER CANVAS
   Interactive schedule buttons — shows MLP
   width profiles for each schedule
═══════════════════════════════════════════ */
(function() {
  const [el, ctx, W, H] = setupCanvas('taper-canvas', 180);
  if (!ctx) return;

  const nL = 24;
  const dBase = 1.0, dStart = 1.5, dEnd = 0.5;

  function linearTaper(l) {
    return dStart - (dStart - dEnd) * (l / (nL - 1));
  }
  function cosineTaper(l) {
    return dEnd + (dStart - dEnd) / 2 * (1 + Math.cos(Math.PI * l / (nL - 1)));
  }
  function sigmoidTaper(l) {
    const k = 10;
    return dEnd + (dStart - dEnd) / (1 + Math.exp(k * (l / (nL - 1) - 0.5)));
  }

  const schedules = {
    uniform: { fn: () => dBase, ppl: '16.28', delta: 'baseline', color: '#6b7280', label: 'Uniform' },
    linear:  { fn: linearTaper,  ppl: '15.96', delta: '−0.32', color: '#06b6d4', label: 'Linear' },
    cosine:  { fn: cosineTaper,  ppl: '14.44', delta: '−1.84', color: '#8b5cf6', label: 'Cosine' },
    sigmoid: { fn: sigmoidTaper, ppl: '16.12', delta: '−0.16', color: '#f59e0b', label: 'Sigmoid' },
  };

  let current = 'cosine';

  function drawTaper() {
    ctx.clearRect(0, 0, W, H);
    const cfg = schedules[current];
    const padL = 24, padR = 16, padT = 12, padB = 28;
    const gW = W - padL - padR, gH = H - padT - padB;
    const barW = gW / nL - 1;

    for (let l = 0; l < nL; l++) {
      const d = cfg.fn(l);
      const bh = Math.round((d / 2.0) * gH * 0.85);
      const bx = padL + l * (gW / nL);
      const by = padT + gH - bh;
      const alpha = 0.3 + 0.7 * (d / (dStart));
      ctx.fillStyle = cfg.color;
      ctx.globalAlpha = alpha;
      ctx.beginPath();
      ctx.roundRect(bx, by, barW, bh, 2);
      ctx.fill();
    }
    ctx.globalAlpha = 1;

    // baseline reference line
    const baseY = padT + gH - Math.round((dBase / 2.0) * gH * 0.85);
    ctx.strokeStyle = 'rgba(255,255,255,0.15)';
    ctx.setLineDash([4, 4]);
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(padL, baseY);
    ctx.lineTo(padL + gW, baseY);
    ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle = '#4b5563';
    ctx.font = '9px monospace';
    ctx.textAlign = 'left';
    ctx.fillText('1.0× baseline', padL + 4, baseY - 3);

    // x-axis labels
    ctx.fillStyle = '#6b7280';
    ctx.font = '10px monospace';
    ctx.textAlign = 'center';
    ctx.fillText('layer 1', padL + (gW / nL) / 2, H - 6);
    ctx.fillText('layer 24', padL + gW - (gW / nL) / 2, H - 6);

    // y-axis indicators
    ctx.fillStyle = '#6b7280';
    ctx.font = '9px monospace';
    ctx.textAlign = 'right';
    ctx.fillText('1.5×', padL - 3, padT + gH - Math.round((1.5 / 2.0) * gH * 0.85) + 3);
    ctx.fillText('0.5×', padL - 3, padT + gH - Math.round((0.5 / 2.0) * gH * 0.85) + 3);
  }

  const pplDisplay = document.getElementById('sched-ppl-display');

  function updateSchedule(name) {
    current = name;
    const cfg = schedules[name];
    document.querySelectorAll('.sched-btn').forEach(b => {
      b.classList.toggle('active', b.dataset.sched === name);
      if (b.dataset.sched === name && name === 'cosine') b.textContent = 'Cosine ✓';
      else if (b.dataset.sched === name) b.textContent = cfg.label;
    });
    if (pplDisplay) {
      const isBaseline = cfg.delta === 'baseline';
      pplDisplay.innerHTML = `PPL: <strong>${cfg.ppl}</strong>&nbsp;&nbsp;${isBaseline ? '<span style="color:var(--muted)">(uniform baseline)</span>' : `<span style="color:var(--green)">(${cfg.delta} vs uniform 16.28)</span>`}`;
    }
    drawTaper();
  }

  document.querySelectorAll('.sched-btn').forEach(b => {
    b.addEventListener('click', () => updateSchedule(b.dataset.sched));
  });
  updateSchedule('cosine');
})();

/* ═══════════════════════════════════════════
   §04 SWEEP CANVAS
   U-shape: perplexity vs taper range
   for cosine and linear schedules
═══════════════════════════════════════════ */
(function() {
  const [el, ctx, W, H] = setupCanvas('sweep-canvas', 220);
  if (!ctx) return;

  const padL = 52, padR = 24, padT = 24, padB = 50;
  const gW = W - padL - padR, gH = H - padT - padB;

  const xLabels = ['1.25→0.75', '1.375→0.625', '1.50→0.50', '1.625→0.375', '1.75→0.25'];
  const cosinePPL = [15.18, 14.59, 14.44, 14.59, 15.49];
  const linearPPL = [15.96, 15.80, 15.96, 15.64, 16.28];
  const uniformPPL = 16.28;

  // Y axis: 14.0 to 16.5
  const yMin = 13.9, yMax = 16.6;
  function yPx(v) { return padT + gH - ((v - yMin) / (yMax - yMin)) * gH; }
  function xPx(i) { return padL + (i / (xLabels.length - 1)) * gW; }

  // grid
  ctx.strokeStyle = 'rgba(255,255,255,0.05)';
  ctx.lineWidth = 1;
  for (let v = 14; v <= 16.5; v += 0.5) {
    const y = yPx(v);
    ctx.beginPath(); ctx.moveTo(padL, y); ctx.lineTo(padL + gW, y); ctx.stroke();
    ctx.fillStyle = '#6b7280';
    ctx.font = '10px monospace';
    ctx.textAlign = 'right';
    ctx.fillText(v.toFixed(1), padL - 5, y + 3);
  }

  // uniform baseline
  ctx.strokeStyle = 'rgba(107,114,128,0.3)';
  ctx.setLineDash([5, 5]);
  const uy = yPx(uniformPPL);
  ctx.beginPath(); ctx.moveTo(padL, uy); ctx.lineTo(padL + gW, uy); ctx.stroke();
  ctx.setLineDash([]);
  ctx.fillStyle = '#6b7280';
  ctx.font = '10px monospace';
  ctx.textAlign = 'left';
  ctx.fillText('uniform 16.28', padL + gW + 4, uy + 4);

  // draw lines
  function drawLine(data, color) {
    ctx.beginPath();
    data.forEach((v, i) => {
      const x = xPx(i), y = yPx(v);
      if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
    });
    ctx.strokeStyle = color;
    ctx.lineWidth = 2.5;
    ctx.stroke();
    // dots
    data.forEach((v, i) => {
      const x = xPx(i), y = yPx(v);
      ctx.beginPath(); ctx.arc(x, y, 5, 0, Math.PI * 2);
      ctx.fillStyle = color;
      ctx.fill();
      // value labels
      const isMin = (v === Math.min(...data));
      ctx.fillStyle = isMin ? '#fff' : '#9ca3af';
      ctx.font = isMin ? 'bold 11px monospace' : '10px monospace';
      ctx.textAlign = 'center';
      ctx.fillText(v.toFixed(2), x, y - 10);
      if (isMin) {
        ctx.fillStyle = color;
        ctx.font = '9px monospace';
        ctx.fillText('★ best', x, y - 22);
      }
    });
  }

  drawLine(linearPPL, '#06b6d4');
  drawLine(cosinePPL, '#8b5cf6');

  // x-axis labels
  xLabels.forEach((lbl, i) => {
    const x = xPx(i);
    ctx.fillStyle = '#6b7280';
    ctx.font = '9px monospace';
    ctx.textAlign = 'center';
    ctx.fillText(lbl, x, padT + gH + 14);
    if (i === 2) {
      ctx.fillStyle = '#8b5cf6';
      ctx.font = 'bold 9px monospace';
      ctx.fillText('← optimal', x, padT + gH + 26);
    }
  });

  // legend
  ctx.fillStyle = '#8b5cf6';
  ctx.font = 'bold 10px monospace';
  ctx.textAlign = 'left';
  ctx.fillText('— cosine', padL, padT + 12);
  ctx.fillStyle = '#06b6d4';
  ctx.fillText('— linear', padL, padT + 26);

  // axis label
  ctx.fillStyle = '#6b7280';
  ctx.font = '11px monospace';
  ctx.textAlign = 'center';
  ctx.fillText('taper range (d_start → d_end)', padL + gW / 2, H - 2);
  ctx.save();
  ctx.translate(12, padT + gH / 2);
  ctx.rotate(-Math.PI / 2);
  ctx.textAlign = 'center';
  ctx.fillText('perplexity ↓', 0, 0);
  ctx.restore();
})();

/* ═══════════════════════════════════════════
   §05 RESULTS BARS — IntersectionObserver
═══════════════════════════════════════════ */
function triggerBars(containerEl) {
  containerEl.querySelectorAll('.bar-fill[data-w]').forEach(b => {
    const pct = parseFloat(b.dataset.w);
    // Scale bars: 52–58 range → map to 30–100% for readability
    const minV = 51.5, maxV = 57.5;
    const scaledPct = ((pct - minV) / (maxV - minV)) * 70 + 30;
    b.style.width = scaledPct.toFixed(1) + '%';
  });
}

['bars-760', 'bars-1b'].forEach(id => {
  const el = document.getElementById(id);
  if (!el) return;
  new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) triggerBars(e.target); });
  }, { threshold: 0.2 }).observe(el);
});
</script>
</BaseLayout>

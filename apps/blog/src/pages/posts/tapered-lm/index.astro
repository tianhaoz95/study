<span class="cs-line hl-g">    <span class="kw">return</span> d_end + (d_start - d_end) \</span>
<span class="cs-line hl-g">        / (<span class="num">1</span> + math.<span class="fn">exp</span>(k * (l/(L-<span class="num">1</span>) - <span class="num">0.5</span>)))</span>

<span class="cs-line cmt"># - Can't incorporate new information</span>
<span class="cs-line hl-a"><span class="kw">class</span> <span class="cls">PretrainedMemory</span>:</span>
<span class="cs-line hl-a">    <span class="attr">update_freq</span> = <span class="num">0</span>   <span class="cmt"># f ≈ 0</span></span>
<span class="cs-line hl-a">    <span class="attr">persistence</span> = <span class="str">"forever"</span></span>
<span class="cs-line hl-a">    <span class="attr">adaptability</span> = <span class="cls">False</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Missing: medium-timescale memory</span>
<span class="cs-line cmt"># that persists across context boundaries</span>
<span class="cs-line cmt"># but can still be updated from experience</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Catastrophic Forgetting in action:</span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">continual_learn_without_sleep</span>(model, tasks):</span>
<span class="cs-line">    <span class="kw">for</span> task <span class="kw">in</span> tasks:</span>
<span class="cs-line">        model.<span class="fn">finetune</span>(task)  <span class="cmt"># overwrites old</span></span>
<span class="cs-line">        <span class="cmt"># ↑ performance on task[-1]</span></span>
<span class="cs-line">        <span class="cmt"># ↓ performance on task[0..-2]</span></span>

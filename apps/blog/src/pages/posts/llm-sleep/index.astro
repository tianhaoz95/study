<script>
// ── TOC + sidebar toggles ──
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});

const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ── Code sidebar tab switching ──
const tabMeta = {
  problem:      { file: 'sleep/problem.py',      title: 'The Problem' },
  memory:       { file: 'sleep/cms.py',           title: 'Memory Spectrum' },
  architecture: { file: 'sleep/paradigm.py',      title: 'Sleep Paradigm' },
  seeding:      { file: 'sleep/seeding.py',       title: 'Knowledge Seeding' },
  dreaming:     { file: 'sleep/dreaming.py',      title: 'Dreaming' },
  results:      { file: 'sleep/results.py',       title: 'Results' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ── IntersectionObserver — sync TOC + sidebar tab on scroll ──
const sectionMap = {
  's-problem':      'problem',
  's-memory':       'memory',
  's-architecture': 'architecture',
  's-seeding':      'seeding',
  's-dreaming':     'dreaming',
  's-results':      'results',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ── Step navigator (Sleep Paradigm section) ──
let step = 0;
const boxes   = document.querySelectorAll('.step-box');
const prevBtn = document.getElementById('step-prev');
const nextBtn = document.getElementById('step-next');
const progEl  = document.getElementById('step-prog');
function updateSteps() {
  boxes.forEach((b, i) => {
    b.classList.remove('active','done');
    if (i === step) b.classList.add('active');
    else if (i < step) b.classList.add('done');
  });
  if (prevBtn) prevBtn.disabled = step === 0;
  if (nextBtn) nextBtn.disabled = step === boxes.length - 1;
  if (progEl) progEl.textContent = `Step ${step+1} of ${boxes.length}`;
  boxes.forEach((b, i) => {
    const n = b.querySelector('.step-num');
    if (n) n.textContent = i < step ? '✓' : String(i+1);
  });
}
prevBtn?.addEventListener('click', () => { if (step>0){step--;updateSteps();} });
nextBtn?.addEventListener('click', () => { if (step<boxes.length-1){step++;updateSteps();} });
updateSteps();

// ── Lifecycle Canvas (§01 The Problem) ──
// Shows: ICL only (knowledge spikes during context, drops to 0 at boundary)
// vs Sleep (knowledge gradually rises as sleep consolidates)
(function() {
  const canvas = document.getElementById('lifecycle-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const W = canvas.clientWidth, H = 240, DPR = window.devicePixelRatio || 1;
  canvas.width = W * DPR; canvas.height = H * DPR;
  ctx.scale(DPR, DPR);

  let mode = 'icl'; // 'icl' or 'sleep'

  // color palette matching blog theme
  const PURPLE = '#8b5cf6', CYAN = '#06b6d4', GREEN = '#10b981', AMBER = '#f59e0b';
  const MUTED  = '#6b7280', BORDER = 'rgba(255,255,255,0.07)';
  const SURFACE = '#12121f';

  function drawLifecycle(m) {
    ctx.clearRect(0, 0, W, H);

    const padL = 48, padR = 16, padT = 30, padB = 40;
    const cW = W - padL - padR, cH = H - padT - padB;

    // Background
    ctx.fillStyle = SURFACE;
    ctx.fillRect(0, 0, W, H);

    // Grid lines
    ctx.strokeStyle = BORDER;
    ctx.lineWidth = 1;
    for (let i = 0; i <= 4; i++) {
      const y = padT + cH - (i / 4) * cH;
      ctx.beginPath(); ctx.moveTo(padL, y); ctx.lineTo(padL + cW, y); ctx.stroke();
    }

    // Y axis label
    ctx.fillStyle = MUTED;
    ctx.font = '10px monospace';
    ctx.textAlign = 'right';
    for (let i = 0; i <= 4; i++) {
      const y = padT + cH - (i / 4) * cH;
      ctx.fillText((i * 25) + '%', padL - 5, y + 4);
    }
    ctx.textAlign = 'center';
    ctx.fillText('knowledge retained', padL - 34, padT + cH / 2);
    ctx.fillText('time →', padL + cW / 2, H - 6);

    // Context boundary markers
    const nContexts = 5;
    ctx.strokeStyle = 'rgba(255,255,255,0.12)';
    ctx.setLineDash([4, 4]);
    ctx.lineWidth = 1;
    for (let i = 1; i < nContexts; i++) {
      const x = padL + (i / nContexts) * cW;
      ctx.beginPath(); ctx.moveTo(x, padT); ctx.lineTo(x, padT + cH); ctx.stroke();
      ctx.fillStyle = 'rgba(107,114,128,0.7)';
      ctx.font = '9px monospace';
      ctx.textAlign = 'center';
      ctx.fillText('context ends', x, padT + cH + 14);
    }
    ctx.setLineDash([]);

    // Sleep event markers (only for sleep mode)
    if (m === 'sleep') {
      const sleepEvents = [0.3, 0.6, 0.9];
      sleepEvents.forEach(frac => {
        const x = padL + frac * cW;
        ctx.strokeStyle = 'rgba(139,92,246,0.4)';
        ctx.setLineDash([2, 3]);
        ctx.lineWidth = 1;
        ctx.beginPath(); ctx.moveTo(x, padT); ctx.lineTo(x, padT + cH); ctx.stroke();
        ctx.setLineDash([]);
        ctx.fillStyle = 'rgba(139,92,246,0.8)';
        ctx.font = '9px monospace';
        ctx.textAlign = 'center';
        ctx.fillText('😴 sleep', x, padT - 6);
      });
    }

    // Draw the knowledge curve
    if (m === 'icl') {
      // ICL: knowledge rises during context, resets to ~5% at each boundary
      ctx.beginPath();
      ctx.strokeStyle = AMBER;
      ctx.lineWidth = 2;
      const pts = [];
      for (let xi = 0; xi <= 200; xi++) {
        const t = xi / 200;
        // 5 contexts, each from ~5% up to ~60%
        const ctxIdx = Math.floor(t * nContexts);
        const ctxFrac = (t * nContexts) % 1;
        // rise within context, small rise with each new context (slight improvement)
        const baseline = 0.04 + ctxIdx * 0.012;
        const rise = baseline + ctxFrac * (0.5 + ctxIdx * 0.02);
        // cliff at context boundary
        const y_frac = Math.min(rise, 0.72);
        const px = padL + t * cW;
        const py = padT + cH * (1 - y_frac);
        pts.push([px, py]);
      }
      // Draw but add vertical drops at context boundaries
      let first = true;
      for (let i = 0; i < pts.length; i++) {
        const t = i / 200;
        const ctxFrac = (t * nContexts) % 1;
        if (ctxFrac < 0.01 && i > 0) {
          // drop to baseline before drawing
          ctx.stroke(); ctx.beginPath();
          ctx.moveTo(pts[i-1][0], padT + cH * 0.96);
          ctx.lineTo(pts[i][0], padT + cH * 0.96);
          ctx.lineTo(pts[i][0], pts[i][1]);
          ctx.stroke(); ctx.beginPath();
          first = false;
        }
        if (first) { ctx.moveTo(pts[i][0], pts[i][1]); first = false; }
        else ctx.lineTo(pts[i][0], pts[i][1]);
      }
      ctx.stroke();

      // Label
      ctx.fillStyle = AMBER;
      ctx.font = '11px monospace';
      ctx.textAlign = 'left';
      ctx.fillText('ICL only — knowledge resets at each context boundary', padL + 5, padT + 18);

    } else {
      // Sleep: knowledge gradually rises as sleep consolidates, floor rises too
      ctx.beginPath();
      ctx.strokeStyle = PURPLE;
      ctx.lineWidth = 2;
      const sleepBoosts = [0, 0, 0, 0.15, 0.15, 0.15, 0.30, 0.30, 0.30, 0.44, 0.44, 0.44, 0.56];
      for (let xi = 0; xi <= 200; xi++) {
        const t = xi / 200;
        const ctxIdx = Math.floor(t * nContexts);
        const ctxFrac = (t * nContexts) % 1;
        const sleepBoost = ctxIdx < sleepBoosts.length ? sleepBoosts[ctxIdx * 2 + Math.round(ctxFrac)] : 0.56;
        const boost = Math.min(ctxIdx * 0.12 + sleepBoost * 0.3, 0.58);
        const rise = 0.04 + boost + ctxFrac * (0.28 + ctxIdx * 0.01);
        const y_frac = Math.min(rise, 0.82);
        const px = padL + t * cW;
        const py = padT + cH * (1 - y_frac);
        if (xi === 0) ctx.moveTo(px, py);
        else ctx.lineTo(px, py);
      }
      ctx.stroke();

      // Shade under the curve to show stable floor rising
      ctx.beginPath();
      ctx.fillStyle = 'rgba(139,92,246,0.08)';
      for (let xi = 0; xi <= 200; xi++) {
        const t = xi / 200;
        const ctxIdx = Math.floor(t * nContexts);
        const ctxFrac = (t * nContexts) % 1;
        const boost = Math.min(ctxIdx * 0.12, 0.48);
        const floor = 0.04 + boost;
        const px = padL + t * cW;
        const py = padT + cH * (1 - floor);
        if (xi === 0) ctx.moveTo(px, py);
        else ctx.lineTo(px, py);
      }
      ctx.lineTo(padL + cW, padT + cH);
      ctx.lineTo(padL, padT + cH);
      ctx.closePath();
      ctx.fill();

      // Label
      ctx.fillStyle = PURPLE;
      ctx.font = '11px monospace';
      ctx.textAlign = 'left';
      ctx.fillText('Sleep — knowledge floor rises as consolidation accumulates', padL + 5, padT + 18);
    }
  }

  document.getElementById('btn-icl')?.addEventListener('click', () => {
    mode = 'icl';
    document.getElementById('btn-icl').classList.add('active-btn');
    document.getElementById('btn-sleep').classList.remove('active-btn');
    drawLifecycle(mode);
  });
  document.getElementById('btn-sleep')?.addEventListener('click', () => {
    mode = 'sleep';
    document.getElementById('btn-sleep').classList.add('active-btn');
    document.getElementById('btn-icl').classList.remove('active-btn');
    drawLifecycle(mode);
  });

  drawLifecycle(mode);
})();

// ── Spectrum Canvas (§02 Memory Spectrum) ──
(function() {
  const canvas = document.getElementById('spectrum-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const W = canvas.clientWidth, H = 200, DPR = window.devicePixelRatio || 1;
  canvas.width = W * DPR; canvas.height = H * DPR;
  ctx.scale(DPR, DPR);

  const PURPLE = '#8b5cf6', CYAN = '#06b6d4', GREEN = '#10b981', AMBER = '#f59e0b';
  const MUTED = '#6b7280', SURFACE = '#12121f', BORDER = 'rgba(255,255,255,0.07)';

  ctx.fillStyle = SURFACE;
  ctx.fillRect(0, 0, W, H);

  // Draw a horizontal spectrum bar
  const barY = 90, barH = 28, padL = 70, padR = 70;
  const barW = W - padL - padR;

  // Gradient: amber (fast/fragile) → purple (medium) → green (slow/stable)
  const grad = ctx.createLinearGradient(padL, 0, padL + barW, 0);
  grad.addColorStop(0,   'rgba(245,158,11,0.8)');
  grad.addColorStop(0.35,'rgba(139,92,246,0.8)');
  grad.addColorStop(1,   'rgba(16,185,129,0.8)');
  ctx.fillStyle = grad;
  ctx.beginPath();
  ctx.roundRect(padL, barY, barW, barH, 8);
  ctx.fill();

  // Layer markers
  const layers = [
    { x: 0.0,  label: 'Attention',       sub: 'f = ∞',       color: AMBER,  y: 58 },
    { x: 0.25, label: 'CMS fast MLP',    sub: 'f = 1000',    color: AMBER,  y: 148 },
    { x: 0.5,  label: 'CMS medium MLP',  sub: 'f = 100',     color: PURPLE, y: 58 },
    { x: 0.75, label: 'CMS slow MLP',    sub: 'f = 10',      color: GREEN,  y: 148 },
    { x: 1.0,  label: 'Pretrained MLP',  sub: 'f = 0',       color: GREEN,  y: 58 },
  ];

  layers.forEach(l => {
    const x = padL + l.x * barW;
    // Tick mark
    ctx.strokeStyle = l.color;
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    if (l.y < 90) {
      ctx.moveTo(x, l.y + 18); ctx.lineTo(x, barY);
    } else {
      ctx.moveTo(x, barY + barH); ctx.lineTo(x, l.y - 18);
    }
    ctx.stroke();

    // Label
    ctx.fillStyle = l.color;
    ctx.font = 'bold 11px monospace';
    ctx.textAlign = 'center';
    ctx.fillText(l.label, x, l.y < 90 ? l.y : l.y);
    ctx.fillStyle = MUTED;
    ctx.font = '10px monospace';
    ctx.fillText(l.sub, x, l.y < 90 ? l.y + 14 : l.y + 14);
  });

  // Axis labels
  ctx.fillStyle = AMBER;
  ctx.font = '10px monospace';
  ctx.textAlign = 'center';
  ctx.fillText('← shorter-term, high plasticity', padL + barW * 0.2, barY + barH + 38);
  ctx.fillStyle = GREEN;
  ctx.fillText('longer-term, stable →', padL + barW * 0.75, barY + barH + 38);

  // Arrows
  ctx.strokeStyle = AMBER; ctx.lineWidth = 1;
  ctx.beginPath(); ctx.moveTo(padL, barY + barH + 24); ctx.lineTo(padL + barW * 0.08, barY + barH + 24); ctx.stroke();
  ctx.strokeStyle = GREEN;
  ctx.beginPath(); ctx.moveTo(padL + barW - barW * 0.08, barY + barH + 24); ctx.lineTo(padL + barW, barY + barH + 24); ctx.stroke();

  // Sleep arrows showing consolidation direction
  ctx.strokeStyle = 'rgba(139,92,246,0.5)';
  ctx.lineWidth = 1.5;
  ctx.setLineDash([4, 3]);
  const arrowY = barY + barH / 2;
  ctx.beginPath();
  ctx.moveTo(padL + barW * 0.12, arrowY);
  ctx.lineTo(padL + barW * 0.88, arrowY);
  ctx.stroke();
  ctx.setLineDash([]);
  // arrowhead
  ctx.beginPath();
  ctx.moveTo(padL + barW * 0.88, arrowY - 5);
  ctx.lineTo(padL + barW * 0.88 + 8, arrowY);
  ctx.lineTo(padL + barW * 0.88, arrowY + 5);
  ctx.fillStyle = 'rgba(139,92,246,0.5)';
  ctx.fill();
  ctx.fillStyle = PURPLE;
  ctx.font = '10px monospace';
  ctx.textAlign = 'center';
  ctx.fillText('😴 sleep consolidates →', padL + barW * 0.5, arrowY - 10);
})();

// ── Seeding Canvas (§04 Knowledge Seeding) ──
(function() {
  const canvas = document.getElementById('seeding-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const W = canvas.clientWidth, H = 260, DPR = window.devicePixelRatio || 1;
  canvas.width = W * DPR; canvas.height = H * DPR;
  ctx.scale(DPR, DPR);

  const PURPLE = '#8b5cf6', CYAN = '#06b6d4', GREEN = '#10b981', AMBER = '#f59e0b';
  const MUTED = '#6b7280', SURFACE = '#12121f';

  ctx.fillStyle = SURFACE;
  ctx.fillRect(0, 0, W, H);

  // Two panels: Traditional KD (left) vs Knowledge Seeding (right)
  const mid = W / 2;

  function drawModel(cx, cy, w, h, label, sub, color, hasNewExpert) {
    // Box
    ctx.strokeStyle = color;
    ctx.lineWidth = 1.5;
    ctx.fillStyle = color.replace(')', ',0.1)').replace('rgb', 'rgba').replace('#', 'rgba(').replace(')', ',0.1)');

    // Better approach: use alpha directly
    ctx.fillStyle = color + '18';
    ctx.strokeStyle = color;
    ctx.beginPath();
    ctx.roundRect(cx - w/2, cy - h/2, w, h, 6);
    ctx.fill();
    ctx.stroke();

    ctx.fillStyle = color;
    ctx.font = 'bold 12px monospace';
    ctx.textAlign = 'center';
    ctx.fillText(label, cx, cy + 4);
    ctx.fillStyle = MUTED;
    ctx.font = '10px monospace';
    ctx.fillText(sub, cx, cy + 18);

    if (hasNewExpert) {
      // Draw a small "new expert" badge
      ctx.fillStyle = GREEN;
      ctx.fillStyle = GREEN + '22';
      ctx.strokeStyle = GREEN;
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.roundRect(cx - w/2 + 6, cy + h/2 - 28, 70, 20, 4);
      ctx.fill();
      ctx.stroke();
      ctx.fillStyle = GREEN;
      ctx.font = '9px monospace';
      ctx.textAlign = 'center';
      ctx.fillText('+ new expert', cx - w/2 + 41, cy + h/2 - 14);
    }
  }

  function drawArrow(x1, y1, x2, y2, color, label) {
    ctx.strokeStyle = color;
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(x1, y1);
    ctx.lineTo(x2, y2);
    ctx.stroke();
    // Arrowhead
    const angle = Math.atan2(y2 - y1, x2 - x1);
    ctx.fillStyle = color;
    ctx.beginPath();
    ctx.moveTo(x2, y2);
    ctx.lineTo(x2 - 10 * Math.cos(angle - 0.4), y2 - 10 * Math.sin(angle - 0.4));
    ctx.lineTo(x2 - 10 * Math.cos(angle + 0.4), y2 - 10 * Math.sin(angle + 0.4));
    ctx.closePath();
    ctx.fill();

    if (label) {
      ctx.fillStyle = color;
      ctx.font = '10px monospace';
      ctx.textAlign = 'center';
      const mx = (x1 + x2) / 2, my = (y1 + y2) / 2;
      ctx.fillText(label, mx, my - 8);
    }
  }

  // === Left panel: Traditional Distillation ===
  ctx.fillStyle = MUTED;
  ctx.font = '11px monospace';
  ctx.textAlign = 'center';
  ctx.fillText('Traditional Distillation', mid / 2, 22);

  drawModel(mid / 2, 70, 120, 44, 'Large Teacher', 'large params', CYAN, false);
  drawArrow(mid / 2, 94, mid / 2, 154, CYAN, 'compress');
  drawModel(mid / 2, 178, 90, 40, 'Small Student', 'fewer params', MUTED, false);

  ctx.fillStyle = AMBER;
  ctx.font = '10px monospace';
  ctx.textAlign = 'center';
  ctx.fillText('knowledge flows ↓ downward', mid / 2, 230);
  ctx.fillText('(compression)', mid / 2, 244);

  // Divider
  ctx.strokeStyle = 'rgba(255,255,255,0.08)';
  ctx.lineWidth = 1;
  ctx.beginPath();
  ctx.moveTo(mid, 20);
  ctx.lineTo(mid, H - 10);
  ctx.stroke();

  // === Right panel: Knowledge Seeding ===
  ctx.fillStyle = PURPLE;
  ctx.font = '11px monospace';
  ctx.textAlign = 'center';
  ctx.fillText('Knowledge Seeding (Sleep)', mid + mid / 2, 22);

  drawModel(mid + mid / 2, 75, 130, 48, 'Small Self', '(teacher: fast MLP)', AMBER, false);
  drawArrow(mid + mid / 2, 100, mid + mid / 2, 152, PURPLE, 'seed upward');
  drawModel(mid + mid / 2, 186, 150, 52, 'Large Self', '(student: slow MLP)', PURPLE, true);

  ctx.fillStyle = GREEN;
  ctx.font = '10px monospace';
  ctx.textAlign = 'center';
  ctx.fillText('knowledge flows ↑ upward', mid + mid / 2, 248);
  ctx.fillText('(consolidation + capacity expansion)', mid + mid / 2, 258);
})();

// ── Stages Canvas (§04 — more stages = better retention) ──
(function() {
  const canvas = document.getElementById('stages-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const W = canvas.clientWidth, H = 220, DPR = window.devicePixelRatio || 1;
  canvas.width = W * DPR; canvas.height = H * DPR;
  ctx.scale(DPR, DPR);

  const PURPLE = '#8b5cf6', CYAN = '#06b6d4', GREEN = '#10b981', AMBER = '#f59e0b';
  const MUTED = '#6b7280', SURFACE = '#12121f', BORDER = 'rgba(255,255,255,0.07)';

  let numStages = 1;

  function drawStages(n) {
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = SURFACE;
    ctx.fillRect(0, 0, W, H);

    const padL = 55, padR = 20, padT = 30, padB = 40;
    const cW = W - padL - padR, cH = H - padT - padB;

    // Grid
    ctx.strokeStyle = BORDER;
    ctx.lineWidth = 1;
    for (let i = 0; i <= 4; i++) {
      const y = padT + cH - (i / 4) * cH;
      ctx.beginPath(); ctx.moveTo(padL, y); ctx.lineTo(padL + cW, y); ctx.stroke();
      ctx.fillStyle = MUTED;
      ctx.font = '10px monospace';
      ctx.textAlign = 'right';
      ctx.fillText((i * 25) + '%', padL - 5, y + 4);
    }
    ctx.fillStyle = MUTED;
    ctx.font = '10px monospace';
    ctx.textAlign = 'center';
    ctx.fillText('tasks learned sequentially →', padL + cW / 2, H - 5);

    // Draw ICL baseline (always shown)
    const iclKnowledge = [5, 12, 8, 14, 10, 16, 12, 18, 14, 20];
    ctx.beginPath();
    ctx.strokeStyle = 'rgba(107,114,128,0.5)';
    ctx.lineWidth = 1.5;
    ctx.setLineDash([4, 3]);
    for (let i = 0; i < iclKnowledge.length; i++) {
      const x = padL + (i / (iclKnowledge.length - 1)) * cW;
      const y = padT + cH * (1 - iclKnowledge[i] / 100);
      if (i === 0) ctx.moveTo(x, y);
      else ctx.lineTo(x, y);
    }
    ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle = 'rgba(107,114,128,0.6)';
    ctx.font = '10px monospace';
    ctx.textAlign = 'left';
    ctx.fillText('ICL baseline', padL + 5, padT + cH - 8);

    // Draw hope variants
    const configs = [
      { stages: 1, color: AMBER, data: [8, 22, 28, 32, 36, 40, 44, 48, 50, 52], label: 'Hope-1 (1 stage)' },
      { stages: 2, color: CYAN,  data: [8, 26, 34, 40, 46, 50, 55, 58, 61, 64], label: 'Hope-2 (2 stages)' },
      { stages: 3, color: PURPLE,data: [8, 30, 40, 48, 54, 60, 66, 70, 73, 76], label: 'Hope-3 (3 stages)' },
    ];

    configs.forEach(cfg => {
      if (cfg.stages > n) return;
      ctx.beginPath();
      ctx.strokeStyle = cfg.color;
      ctx.lineWidth = cfg.stages === n ? 2.5 : 1.5;
      ctx.globalAlpha = cfg.stages === n ? 1 : 0.4;
      for (let i = 0; i < cfg.data.length; i++) {
        const x = padL + (i / (cfg.data.length - 1)) * cW;
        const y = padT + cH * (1 - cfg.data[i] / 100);
        if (i === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      ctx.stroke();
      ctx.globalAlpha = 1;

      if (cfg.stages === n) {
        const lastX = padL + cW;
        const lastY = padT + cH * (1 - cfg.data[cfg.data.length - 1] / 100);
        ctx.fillStyle = cfg.color;
        ctx.beginPath();
        ctx.arc(lastX, lastY, 4, 0, Math.PI * 2);
        ctx.fill();
        ctx.font = 'bold 10px monospace';
        ctx.textAlign = 'right';
        ctx.fillText(cfg.label, lastX - 8, lastY - 6);
      }
    });

    // Sleep events marker
    const sleepX = [0.2, 0.4, 0.6, 0.8].slice(0, n + 1);
    sleepX.forEach(frac => {
      const x = padL + frac * cW;
      ctx.strokeStyle = 'rgba(139,92,246,0.3)';
      ctx.setLineDash([2, 3]);
      ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(x, padT); ctx.lineTo(x, padT + cH); ctx.stroke();
      ctx.setLineDash([]);
    });
  }

  document.getElementById('btn-s1')?.addEventListener('click', () => {
    numStages = 1;
    ['btn-s1','btn-s2','btn-s3'].forEach(id => document.getElementById(id)?.classList.remove('active-btn'));
    document.getElementById('btn-s1').classList.add('active-btn');
    drawStages(numStages);
  });
  document.getElementById('btn-s2')?.addEventListener('click', () => {
    numStages = 2;
    ['btn-s1','btn-s2','btn-s3'].forEach(id => document.getElementById(id)?.classList.remove('active-btn'));
    document.getElementById('btn-s2').classList.add('active-btn');
    drawStages(numStages);
  });
  document.getElementById('btn-s3')?.addEventListener('click', () => {
    numStages = 3;
    ['btn-s1','btn-s2','btn-s3'].forEach(id => document.getElementById(id)?.classList.remove('active-btn'));
    document.getElementById('btn-s3').classList.add('active-btn');
    drawStages(numStages);
  });
  drawStages(numStages);
})();

// ── Dream Canvas (§05 Dreaming) ──
(function() {
  const canvas = document.getElementById('dream-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const W = canvas.clientWidth, H = 240, DPR = window.devicePixelRatio || 1;
  canvas.width = W * DPR; canvas.height = H * DPR;
  ctx.scale(DPR, DPR);

  const PURPLE = '#8b5cf6', CYAN = '#06b6d4', GREEN = '#10b981', AMBER = '#f59e0b';
  const MUTED = '#6b7280', SURFACE = '#12121f';

  function seededRand(n) {
    return ((1664525 * n + 1013904223) & 0x7fffffff) / 0x7fffffff;
  }

  // Generate m=12 dreams with pre-seeded positions
  const M = 12;
  const dreams = Array.from({length: M}, (_, i) => ({
    x: 0.08 + seededRand(i * 5) * 0.84,
    y: 0.12 + seededRand(i * 5 + 1) * 0.76,
    quality: seededRand(i * 5 + 2), // gradient score
    random_expert: seededRand(i * 5 + 3) > 0.6, // used random expert
    selected: false,
  }));

  // Mark top-4 by quality as selected
  const sorted = [...dreams].sort((a, b) => b.quality - a.quality);
  sorted.slice(0, 4).forEach(d => d.selected = true);
  // Plus 1 random from non-selected
  const nonSelected = dreams.filter(d => !d.selected);
  nonSelected[Math.floor(seededRand(99) * nonSelected.length)].selected = true;

  let animT = 0;
  let animRunning = false;
  let rafId = null;

  function draw(t) {
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = SURFACE;
    ctx.fillRect(0, 0, W, H);

    const padL = 20, padR = 20, padT = 24, padB = 20;
    const cW = W - padL - padR, cH = H - padT - padB;

    // Title
    ctx.fillStyle = MUTED;
    ctx.font = '10px monospace';
    ctx.textAlign = 'left';
    ctx.fillText('model (with context)', padL + 5, padT - 5);

    // Model box at center
    const mx = padL + cW * 0.22, my = padT + cH * 0.5;
    ctx.strokeStyle = CYAN;
    ctx.lineWidth = 1.5;
    ctx.fillStyle = 'rgba(6,182,212,0.08)';
    ctx.beginPath();
    ctx.roundRect(mx - 50, my - 25, 100, 50, 8);
    ctx.fill();
    ctx.stroke();
    ctx.fillStyle = CYAN;
    ctx.font = 'bold 11px monospace';
    ctx.textAlign = 'center';
    ctx.fillText('LM_θ', mx, my + 4);
    ctx.fillStyle = MUTED;
    ctx.font = '10px monospace';
    ctx.fillText('+random expert', mx, my + 18);

    // Draw dreams as dots radiating out
    dreams.forEach((d, i) => {
      const dx = padL + cW * (0.45 + d.x * 0.52);
      const dy = padT + cH * (0.08 + d.y * 0.84);

      // Animate: dreams appear progressively
      const dreamT = Math.max(0, Math.min(1, (t - i * 0.04) * 3));
      if (dreamT <= 0) return;

      // Line from model to dream
      const progress = Math.min(dreamT, 1);
      const lineEndX = mx + (dx - mx) * progress;
      const lineEndY = my + (dy - my) * progress;
      ctx.strokeStyle = d.random_expert ? 'rgba(245,158,11,0.3)' : 'rgba(6,182,212,0.2)';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(mx, my);
      ctx.lineTo(lineEndX, lineEndY);
      ctx.stroke();

      if (progress < 0.85) return;

      // Dream dot
      const radius = 7 + d.quality * 8;
      ctx.globalAlpha = dreamT;
      if (d.selected) {
        ctx.fillStyle = GREEN;
        ctx.strokeStyle = GREEN;
        ctx.lineWidth = 2;
      } else {
        ctx.fillStyle = 'rgba(107,114,128,0.5)';
        ctx.strokeStyle = 'rgba(107,114,128,0.4)';
        ctx.lineWidth = 1;
      }
      ctx.beginPath();
      ctx.arc(dx, dy, radius, 0, Math.PI * 2);
      if (d.selected) { ctx.fill(); ctx.stroke(); }
      else ctx.fill();

      // Label selected dreams
      if (d.selected && dreamT > 0.95) {
        ctx.fillStyle = GREEN;
        ctx.font = '9px monospace';
        ctx.textAlign = 'center';
        ctx.fillText(d.random_expert ? '★ (rand)' : '★', dx, dy - radius - 4);
      }
      ctx.globalAlpha = 1;
    });

    // After all dreams shown, show selection legend
    if (t > 0.7) {
      const alpha = Math.min(1, (t - 0.7) * 3);
      ctx.globalAlpha = alpha;
      ctx.fillStyle = GREEN;
      ctx.font = '10px monospace';
      ctx.textAlign = 'right';
      ctx.fillText('★ selected (top-k + random)', W - padR - 5, padT + 14);
      ctx.fillStyle = AMBER;
      ctx.fillText('◇ used random expert', W - padR - 5, padT + 28);
      ctx.fillStyle = MUTED;
      ctx.fillText('○ rejected', W - padR - 5, padT + 42);

      // Arrow showing reward
      ctx.strokeStyle = 'rgba(16,185,129,0.5)';
      ctx.lineWidth = 1.5;
      ctx.setLineDash([3, 3]);
      ctx.beginPath();
      ctx.moveTo(W - padR - 90, padT + 80);
      ctx.lineTo(mx + 55, my - 5);
      ctx.stroke();
      ctx.setLineDash([]);
      ctx.fillStyle = GREEN;
      ctx.font = '9px monospace';
      ctx.textAlign = 'center';
      ctx.fillText('reward → RL update', (W - padR - 90 + mx + 55) / 2, (padT + 80 + my - 5) / 2 - 8);
      ctx.globalAlpha = 1;
    }
  }

  draw(0);

  document.getElementById('dream-play')?.addEventListener('click', () => {
    if (animRunning) return;
    animRunning = true;
    animT = 0;
    const btn = document.getElementById('dream-play');
    btn.textContent = '⏸ Running...';

    function animate() {
      animT += 0.006;
      draw(animT);
      if (animT < 1.2) {
        rafId = requestAnimationFrame(animate);
      } else {
        animRunning = false;
        btn.textContent = '▶ Play';
      }
    }
    rafId = requestAnimationFrame(animate);
  });

  document.getElementById('dream-reset')?.addEventListener('click', () => {
    if (rafId) cancelAnimationFrame(rafId);
    animRunning = false;
    animT = 0;
    const btn = document.getElementById('dream-play');
    btn.textContent = '▶ Play';
    draw(0);
  });
})();

// ── Results bars animation (IntersectionObserver) ──
const resultsSection = document.getElementById('s-results');
if (resultsSection) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('#results-bars .bar-fill[data-w]').forEach(b => {
          b.style.width = b.dataset.w + '%';
        });
      }
    });
  }, { threshold: 0.3 }).observe(resultsSection);
}
</script>
</BaseLayout>

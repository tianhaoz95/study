    <div class="cs-panel" id="panel-memory">
      <pre class="cs-pre">
<span class="cs-line cmt"># Continuum Memory System (CMS)</span>
<span class="cs-line cmt"># Chain of MLPs at different update frequencies</span>
<span class="cs-line"></span>
<span class="cs-line hl-p"><span class="kw">class</span> <span class="cls">ContinuumMemorySystem</span>:</span>
<span class="cs-line hl-p">    <span class="kw">def</span> <span class="fn">__init__</span>(<span class="kw">self</span>, frequencies):</span>
<span class="cs-line hl-p">        <span class="cmt"># f1 >= f2 >= ... >= fk</span></span>
<span class="cs-line hl-p">        <span class="cmt"># faster = shorter-term, more fragile</span></span>
<span class="cs-line hl-p">        <span class="cmt"># slower = longer-term, more stable</span></span>
<span class="cs-line hl-p">        <span class="kw">self</span>.<span class="attr">layers</span> = [</span>
<span class="cs-line hl-p">            <span class="cls">MLP</span>(f=freq) <span class="kw">for</span> freq <span class="kw">in</span> frequencies</span>
<span class="cs-line hl-p">        ]</span>
<span class="cs-line hl-p">        <span class="cmt"># chunk_size = max_freq / layer_freq</span></span>
<span class="cs-line"></span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">forward</span>(<span class="kw">self</span>, x_t):</span>
<span class="cs-line">        <span class="cmt"># Each layer processes its chunk</span></span>
<span class="cs-line">        y = x_t</span>
<span class="cs-line">        <span class="kw">for</span> layer <span class="kw">in</span> <span class="kw">self</span>.<span class="attr">layers</span>:</span>
<span class="cs-line">            y = layer.<span class="fn">forward</span>(y)</span>
<span class="cs-line">        <span class="kw">return</span> y</span>
<span class="cs-line"></span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">update</span>(<span class="kw">self</span>, step):</span>
<span class="cs-line">        <span class="kw">for</span> layer <span class="kw">in</span> <span class="kw">self</span>.<span class="attr">layers</span>:</span>
<span class="cs-line">            <span class="cmt"># Only update if step divides chunk</span></span>
<span class="cs-line">            <span class="kw">if</span> step % layer.<span class="attr">chunk_size</span> == <span class="num">0</span>:</span>
<span class="cs-line">                layer.<span class="fn">gradient_step</span>()</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Example frequency configuration:</span>
<span class="cs-line cmt"># frequencies = [1000, 100, 10, 1]</span>
<span class="cs-line cmt"># Layer 0: updates every 1 step (fastest)</span>
<span class="cs-line cmt"># Layer 1: updates every 10 steps</span>
<span class="cs-line cmt"># Layer 2: updates every 100 steps</span>
<span class="cs-line cmt"># Layer 3: updates every 1000 steps (slowest)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Attention == layer with f = ∞ (every token)</span>
<span class="cs-line cmt"># Pretrained MLP == layer with f = 0 (never)</span>
<span class="cs-line cmt"># CMS fills the spectrum between them</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-architecture">
      <pre class="cs-pre">
<span class="cs-line cmt"># The Sleep Paradigm: wake/sleep lifecycle</span>
<span class="cs-line"></span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">lifelong_learning</span>(model, data_stream):</span>
<span class="cs-line hl-p">    step = <span class="num">0</span></span>
<span class="cs-line hl-p">    <span class="kw">for</span> batch <span class="kw">in</span> data_stream:</span>
<span class="cs-line hl-p">        <span class="cmt"># ── WAKE PHASE ──</span></span>
<span class="cs-line hl-p">        model.<span class="fn">process</span>(batch)  <span class="cmt"># ICL + fast updates</span></span>
<span class="cs-line hl-p">        step += <span class="num">1</span></span>
<span class="cs-line hl-p"></span>
<span class="cs-line hl-p">        <span class="cmt"># Check if any layer needs to sleep</span></span>
<span class="cs-line hl-p">        <span class="kw">for</span> l <span class="kw">in</span> model.<span class="attr">cms_layers</span>:</span>
<span class="cs-line hl-p">            <span class="kw">if</span> step % l.<span class="attr">chunk_size</span> == <span class="num">0</span>:</span>
<span class="cs-line hl-p">                <span class="fn">sleep</span>(model, l, step)</span>
<span class="cs-line"></span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">sleep</span>(model, layer_l, step):</span>
<span class="cs-line">    <span class="cmt"># No new external data during sleep</span></span>
<span class="cs-line"></span>
<span class="cs-line">    <span class="cmt"># ── Stage 1: Memory Consolidation ──</span></span>
<span class="cs-line hl-c">    <span class="cmt"># Expand target layer with new expert</span></span>
<span class="cs-line hl-c">    model.<span class="fn">expand_layer</span>(layer_l, rank=<span class="attr">d_low</span>)</span>
<span class="cs-line hl-c">    <span class="cmt"># Knowledge seeding: layer_(l-1) → layer_l</span></span>
<span class="cs-line hl-c">    <span class="fn">knowledge_seeding</span>(</span>
<span class="cs-line hl-c">        src=model.<span class="fn">layer</span>(layer_l - <span class="num">1</span>),</span>
<span class="cs-line hl-c">        dst=model.<span class="fn">layer</span>(layer_l),</span>
<span class="cs-line hl-c">        freeze_existing=<span class="cls">True</span></span>
<span class="cs-line hl-c">    )</span>
<span class="cs-line"></span>
<span class="cs-line">    <span class="cmt"># ── Stage 2: Dreaming ──</span></span>
<span class="cs-line hl-g">    dreams = <span class="fn">generate_dreams</span>(model)</span>
<span class="cs-line hl-g">    selected = <span class="fn">gradient_score_select</span>(dreams)</span>
<span class="cs-line hl-g">    <span class="fn">rl_finetune</span>(model, selected)</span>
<span class="cs-line"></span>
<span class="cs-line">    <span class="cmt"># ── Synaptic Pruning ──</span></span>
<span class="cs-line">    model.<span class="fn">reset_fast_lora_experts</span>(layer_l - <span class="num">1</span>)</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-seeding">
      <pre class="cs-pre">
<span class="cs-line cmt"># Knowledge Seeding: upward distillation</span>
<span class="cs-line cmt"># Small self (teacher) → large self (student)</span>
<span class="cs-line"></span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">knowledge_seeding</span>(teacher, student, α=<span class="num">0.5</span>):</span>
<span class="cs-line hl-p">    <span class="cmt"># Build dataset from teacher</span></span>
<span class="cs-line hl-p">    D = teacher.<span class="fn">sample_dataset</span>()</span>
<span class="cs-line hl-p"></span>
<span class="cs-line hl-p">    <span class="cmt"># On-policy distillation (GKD-style)</span></span>
<span class="cs-line hl-p">    <span class="kw">for</span> x <span class="kw">in</span> D:</span>
<span class="cs-line hl-p">        y_student = student.<span class="fn">sample</span>(x)</span>
<span class="cs-line hl-p">        logits_t = teacher.<span class="fn">logits</span>(y_student, x)</span>
<span class="cs-line hl-p">        logits_s = student.<span class="fn">logits</span>(y_student, x)</span>
<span class="cs-line hl-p">        L_dist = <span class="fn">kl_divergence</span>(logits_t, logits_s)</span>
<span class="cs-line hl-p"></span>
<span class="cs-line">    <span class="cmt"># Learning to Imitate (LTI) via RL</span></span>
<span class="cs-line hl-c">    D_teacher = teacher.<span class="fn">generate_dreams</span>()</span>
<span class="cs-line hl-c">    <span class="kw">for</span> dream <span class="kw">in</span> D_teacher:</span>
<span class="cs-line hl-c">        prefix = dream[:<span class="fn">random_cut</span>()]</span>
<span class="cs-line hl-c">        continuation = student.<span class="fn">complete</span>(prefix)</span>
<span class="cs-line hl-c">        r_sem = <span class="fn">semantic_match</span>(continuation, dream)</span>
<span class="cs-line hl-c">        r_abs = <span class="num">1</span> - <span class="fn">levenshtein</span>(continuation, dream)</span>
<span class="cs-line hl-c">        reward = γ * r_sem + (<span class="num">1</span>-γ) * r_abs</span>
<span class="cs-line hl-c"></span>
<span class="cs-line">    <span class="cmt"># Combined KS objective</span></span>
<span class="cs-line">    L_KS = (<span class="num">1</span>-α) * E[reward] - α * E[L_dist]</span>
<span class="cs-line"></span>
<span class="cs-line">    <span class="cmt"># KEY: only update new low-rank expert</span></span>
<span class="cs-line hl-g">    student.<span class="fn">freeze_all_except</span>(new_lora_expert)</span>
<span class="cs-line hl-g">    student.<span class="fn">optimize</span>(L_KS)</span>
<span class="cs-line hl-g">    student.<span class="fn">unfreeze_all</span>()</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># After seeding: reset fast layer's old experts</span>
<span class="cs-line cmt"># (synaptic pruning — free capacity for future)</span>
<span class="cs-line">teacher.<span class="fn">reset_accumulated_lora</span>()</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-dreaming">
      <pre class="cs-pre">
<span class="cs-line cmt"># Dreaming: RL-driven self-improvement</span>
<span class="cs-line cmt"># Builds on SEAL + 3 key innovations</span>
<span class="cs-line"></span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">dream</span>(model, context, task_metric, m=<span class="num">16</span>):</span>
<span class="cs-line hl-p">    <span class="cmt"># Innovation 1: Random expert injection</span></span>
<span class="cs-line hl-p">    <span class="cmt"># Forces exploration beyond current knowledge</span></span>
<span class="cs-line hl-p">    <span class="kw">with</span> model.<span class="fn">random_expert_routing</span>():</span>
<span class="cs-line hl-p">        dreams = [</span>
<span class="cs-line hl-p">            model.<span class="fn">generate</span>(context)</span>
<span class="cs-line hl-p">            <span class="kw">for</span> _ <span class="kw">in</span> <span class="fn">range</span>(m)</span>
<span class="cs-line hl-p">        ]</span>
<span class="cs-line"></span>
<span class="cs-line">    <span class="cmt"># Innovation 2: Gradient-based selection</span></span>
<span class="cs-line hl-c">    scores = [</span>
<span class="cs-line hl-c">        <span class="fn">grad_norm</span>(model, L_SFT(d))</span>
<span class="cs-line hl-c">        <span class="kw">for</span> d <span class="kw">in</span> dreams</span>
<span class="cs-line hl-c">    ]</span>
<span class="cs-line hl-c">    <span class="cmt"># Keep top-k + b random (diversity)</span></span>
<span class="cs-line hl-c">    selected = <span class="fn">top_k_plus_random</span>(dreams, scores)</span>
<span class="cs-line"></span>
<span class="cs-line">    <span class="cmt"># Innovation 3: LoRA instead of full SFT</span></span>
<span class="cs-line hl-g">    rewards = []</span>
<span class="cs-line hl-g">    <span class="kw">for</span> dream <span class="kw">in</span> selected:</span>
<span class="cs-line hl-g">        model_copy = model.<span class="fn">clone</span>()</span>
<span class="cs-line hl-g">        model_copy.<span class="fn">lora_finetune</span>(dream)</span>
<span class="cs-line hl-g">        improved = task_metric(model_copy)</span>
<span class="cs-line hl-g">        rewards.<span class="fn">append</span>(<span class="num">1</span> <span class="kw">if</span> improved <span class="kw">else</span> <span class="num">0</span>)</span>
<span class="cs-line hl-g"></span>
<span class="cs-line">    <span class="cmt"># REINFORCE update (ReSTEM algorithm)</span></span>
<span class="cs-line">    model.<span class="fn">reinforce</span>(selected, rewards)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Why 2-stage design prevents forgetting:</span>
<span class="cs-line cmt"># 1. Consolidation runs FIRST (isolated expert)</span>
<span class="cs-line cmt"># 2. Dreaming fine-tunes ONLY new knowledge</span>
<span class="cs-line cmt"># 3. Old params never touched by either stage</span>
      </pre>
    </div>


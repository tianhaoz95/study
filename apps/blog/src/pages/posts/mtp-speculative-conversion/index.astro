        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ── Step navigators ─────────────────────────────────────────────────────────
function makeStepNav(listId, prevId, nextId, progId) {
  let step = 0;
  const boxes   = document.querySelectorAll('#' + listId + ' .step-box');
  const prevBtn = document.getElementById(prevId);
  const nextBtn = document.getElementById(nextId);
  const progEl  = document.getElementById(progId);
  function update() {
    boxes.forEach((b, i) => {
      b.classList.remove('active', 'done');
      if (i === step) b.classList.add('active');
      else if (i < step) b.classList.add('done');
    });
    if (prevBtn) prevBtn.disabled = step === 0;
    if (nextBtn) nextBtn.disabled = step === boxes.length - 1;
    if (progEl)  progEl.textContent = 'Step ' + (step + 1) + ' of ' + boxes.length;
    boxes.forEach((b, i) => {
      const n = b.querySelector('.step-num');
      if (n) n.textContent = i < step ? '✓' : String(i + 1);
    });
  }
  prevBtn?.addEventListener('click', () => { if (step > 0) { step--; update(); } });
  nextBtn?.addEventListener('click', () => { if (step < boxes.length - 1) { step++; update(); } });
  update();
}
makeStepNav('medusa-steps', 'medusa-prev', 'medusa-next', 'medusa-prog');

// ── 2D Trajectory Canvas ────────────────────────────────────────────────────
let trajectoryScenario = 'recycled';
function drawTrajectoryCanvas() {
  const canvas = document.getElementById('trajectory-canvas');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 280;
  canvas.width = W * DPR; canvas.height = H * DPR;
  const ctx = canvas.getContext('2d');
  ctx.scale(DPR, DPR);

  const pad = { t: 30, r: 30, b: 40, l: 40 };
  const cw = W - pad.l - pad.r, ch = H - pad.t - pad.b;

  // Draw background grid
  ctx.strokeStyle = 'rgba(255, 255, 255, 0.03)';
  ctx.lineWidth = 1;
  for (let i = 0; i <= 10; i++) {
    const x = pad.l + (i / 10) * cw;
    const y = pad.t + (i / 10) * ch;
    ctx.beginPath(); ctx.moveTo(x, pad.t); ctx.lineTo(x, pad.t + ch); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(pad.l, y); ctx.lineTo(pad.l + cw, y); ctx.stroke();
  }

  // Draw Ground Truth Target Path (Smooth curve)
  const targetPoints = [];
  for (let i = 0; i <= 20; i++) {
    const t = i / 20;
    const x = pad.l + t * cw;
    const y = pad.t + ch / 2 + Math.sin(t * Math.PI * 1.5) * (ch * 0.3);
    targetPoints.push({ x, y });
  }

  ctx.strokeStyle = 'rgba(139, 92, 246, 0.85)';
  ctx.lineWidth = 3;
  ctx.beginPath();
  targetPoints.forEach((p, idx) => {
    if (idx === 0) ctx.moveTo(p.x, p.y); else ctx.lineTo(p.x, p.y);
  });
  ctx.stroke();

  // Draw Draft Path
  const draftPoints = [];
  const startY = targetPoints[0].y;
  draftPoints.push({ x: targetPoints[0].x, y: startY });

  if (trajectoryScenario === 'recycled') {
    // Recycled MTP closely tracks the target path
    for (let i = 1; i <= 20; i++) {
      const targetPoint = targetPoints[i];
      const noise = (Math.sin(i * 1.7) * 4) + (Math.cos(i * 2.3) * 3);
      draftPoints.push({
        x: targetPoint.x,
        y: targetPoint.y + noise * (i / 20)
      });
    }
    ctx.strokeStyle = 'rgba(6, 182, 212, 0.9)';
  } else {
    // From scratch draft model diverges early
    for (let i = 1; i <= 20; i++) {
      const targetPoint = targetPoints[i];
      const divergence = Math.pow(i / 20, 1.8) * (ch * 0.28);
      const noise = (Math.sin(i * 1.2) * 8);
      draftPoints.push({
        x: targetPoint.x,
        y: targetPoint.y + divergence + noise
      });
    }
    ctx.strokeStyle = '#ef4444';
  }

  ctx.lineWidth = 2;
  ctx.setLineDash([4, 3]);
  ctx.beginPath();
  draftPoints.forEach((p, idx) => {
    if (idx === 0) ctx.moveTo(p.x, p.y); else ctx.lineTo(p.x, p.y);
  });
  ctx.stroke();
  ctx.setLineDash([]);

  // Draw endpoints
  ctx.fillStyle = 'rgba(139, 92, 246, 0.95)';
  ctx.beginPath(); ctx.arc(targetPoints[targetPoints.length - 1].x, targetPoints[targetPoints.length - 1].y, 5, 0, Math.PI * 2); ctx.fill();

  ctx.fillStyle = trajectoryScenario === 'recycled' ? 'rgba(6, 182, 212, 0.95)' : '#ef4444';
  ctx.beginPath(); ctx.arc(draftPoints[draftPoints.length - 1].x, draftPoints[draftPoints.length - 1].y, 5, 0, Math.PI * 2); ctx.fill();

  // Annotations
  ctx.font = '10px monospace';
  ctx.fillStyle = 'rgba(139, 92, 246, 0.9)';
  ctx.fillText('Target Path', pad.l + 10, targetPoints[5].y - 12);

  ctx.fillStyle = trajectoryScenario === 'recycled' ? 'rgba(6, 182, 212, 0.9)' : '#ef4444';
  ctx.fillText(trajectoryScenario === 'recycled' ? 'MTP Recycled Draft Path (Acceptance ~82%)' : 'From Scratch Draft Path (Acceptance ~45%)', pad.l + 10, draftPoints[12].y + 16);
}

window.setTrajectoryScenario = function(s) {
  trajectoryScenario = s;
  document.getElementById('btn-recycled').className = 'scenario-btn' + (s === 'recycled' ? ' active-good' : '');
  document.getElementById('btn-scratch').className = 'scenario-btn' + (s !== 'recycled' ? ' active-bad' : '');
  drawTrajectoryCanvas();
};

const trajSection = document.getElementById('s-eagle');
if (trajSection) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        drawTrajectoryCanvas();
      }
    });
  }, { threshold: 0.3 }).observe(trajSection);
}

// ── Throughput and Speedup Simulator ────────────────────────────────────────
window.runSimulation = function() {
  const arch = document.getElementById('sim-arch').value;
  const steps = parseInt(document.getElementById('sim-steps').value);
  const batch = parseInt(document.getElementById('sim-batch').value);

  document.getElementById('val-steps').textContent = steps.toLocaleString();
  document.getElementById('val-batch').textContent = batch;

  // Base parameters
  let alphaBase = 0.55;
  let overhead = 0.05;
  let alphaMax = 0.72;

  if (arch === 'medusa') {
    alphaBase = 0.55;
    alphaMax = 0.74;
    overhead = 0.04;
  } else if (arch === 'eagle') {
    alphaBase = 0.65;
    alphaMax = 0.83;
    overhead = 0.08;
  } else if (arch === 'distilled') {
    alphaBase = 0.68;
    alphaMax = 0.85;
    overhead = 0.16;
  }

  // Calculate simulated alpha based on training steps
  const trainingFactor = steps / 10000;
  let alpha = alphaBase + (alphaMax - alphaBase) * Math.pow(trainingFactor, 0.6);

  // Little's Law Batch scaling overhead adjustment
  const batchSaturation = Math.min(1.0, Math.pow(batch / 32, 1.2));
  const effectiveOverhead = overhead * (1.0 + batchSaturation * 1.5);

  // Compute speedup for optimal K=4 speculative lookahead steps
  const K = 4;
  const expectedTokens = (1 - Math.pow(alpha, K + 1)) / (1 - alpha);
  let speedup = expectedTokens / (1.0 + effectiveOverhead * K);

  // Format speedup outputs
  document.getElementById('metric-alpha').textContent = (alpha * 100).toFixed(1) + '%';
  document.getElementById('metric-speedup').textContent = speedup.toFixed(2) + 'x';

  // Render on canvas
  const canvas = document.getElementById('sim-canvas');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 260;
  canvas.width = W * DPR; canvas.height = H * DPR;
  const ctx = canvas.getContext('2d');
  ctx.scale(DPR, DPR);

  const pad = { t: 25, r: 25, b: 40, l: 45 };
  const cw = W - pad.l - pad.r, ch = H - pad.t - pad.b;

  // Draw grid
  ctx.strokeStyle = 'rgba(255, 255, 255, 0.03)';
  ctx.lineWidth = 1;
  for (let i = 0; i <= 5; i++) {
    const x = pad.l + (i / 5) * cw;
    const y = pad.t + (i / 5) * ch;
    ctx.beginPath(); ctx.moveTo(x, pad.t); ctx.lineTo(x, pad.t + ch); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(pad.l, y); ctx.lineTo(pad.l + cw, y); ctx.stroke();
  }

  // Plot speedup curve vs batch size from 1 to 64
  const points = [];
  for (let b = 1; b <= 64; b++) {
    const bSat = Math.min(1.0, Math.pow(b / 32, 1.2));
    const effOver = overhead * (1.0 + bSat * 1.5);
    const s = expectedTokens / (1.0 + effOver * K);
    
    const x = pad.l + ((b - 1) / 63) * cw;
    const y = pad.t + ch - ((s - 0.5) / 2.0) * ch; // scale range 0.5 to 2.5
    points.push({ x, y, b, s });
  }

  ctx.strokeStyle = 'rgba(139, 92, 246, 0.9)';
  ctx.lineWidth = 2.5;
  ctx.beginPath();
  points.forEach((p, idx) => {
    if (idx === 0) ctx.moveTo(p.x, p.y); else ctx.lineTo(p.x, p.y);
  });
  ctx.stroke();

  // Highlight active batch position
  const activePoint = points.find(p => p.b === batch);
  if (activePoint) {
    ctx.fillStyle = 'var(--cyan)';
    ctx.beginPath(); ctx.arc(activePoint.x, activePoint.y, 6, 0, Math.PI * 2); ctx.fill();
    ctx.strokeStyle = '#fff';
    ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.arc(activePoint.x, activePoint.y, 6, 0, Math.PI * 2); ctx.stroke();

    // label speedup
    ctx.font = 'bold 9px monospace';
    ctx.fillStyle = '#fff';
    ctx.fillText(activePoint.s.toFixed(2) + 'x', activePoint.x - 14, activePoint.y - 12);
  }

  // Draw axes
  ctx.strokeStyle = 'rgba(255, 255, 255, 0.15)';
  ctx.lineWidth = 1;
  ctx.beginPath();
  ctx.moveTo(pad.l, pad.t); ctx.lineTo(pad.l, pad.t + ch);
  ctx.moveTo(pad.l, pad.t + ch); ctx.lineTo(pad.l + cw, pad.t + ch);
  ctx.stroke();

  // Axis Labels
  ctx.font = '9px monospace';
  ctx.fillStyle = 'rgba(255, 255, 255, 0.4)';
  ctx.fillText('1', pad.l - 4, pad.t + ch + 15);
  ctx.fillText('32', pad.l + cw / 2 - 6, pad.t + ch + 15);
  ctx.fillText('64', pad.l + cw - 12, pad.t + ch + 15);
  ctx.fillText('Concurrent Requests (Batch Size)', pad.l + cw / 2 - 75, pad.t + ch + 30);

  // Y Axis labels
  ctx.fillText('2.5x', 12, pad.t + 4);
  ctx.fillText('1.5x', 12, pad.t + ch / 2 + 4);
  ctx.fillText('0.5x', 12, pad.t + ch + 4);
};

const simSection = document.getElementById('s-lab');
if (simSection) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        runSimulation();
      }
    });
  }, { threshold: 0.3 }).observe(simSection);
}

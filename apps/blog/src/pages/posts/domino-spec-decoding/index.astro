    <button class="cs-tab active" data-panel="tradeoff">tradeoff</button>
    <button class="cs-tab" data-panel="speedup">speedup</button>
    <button class="cs-tab" data-panel="architecture">arch</button>
    <button class="cs-tab" data-panel="causal">causal</button>
    <button class="cs-tab" data-panel="training">training</button>
    <button class="cs-tab" data-panel="results">results</button>
  </div>
  <div class="cs-body">

    <div class="cs-panel active" id="panel-tradeoff">
      <pre class="cs-pre">
<span class="cs-line cmt"># The quality–cost trade-off in speculative decoding</span>
<span class="cs-line cmt"># Three representative methods on Qwen3-8B (16-token budget)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Method      | Accept len (τ) | Draft cost   | Speedup</span>
<span class="cs-line cmt"># EAGLE-3     | 4.86           | γ × (Δt)     | 3.28×</span>
<span class="cs-line cmt"># DFlash      | 4.03           | 1 × (Δt)     | 3.42×</span>
<span class="cs-line cmt"># Domino      | 4.70           | 1×(Δt)+GRU   | 3.84×</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Autoregressive drafter</span>
<span class="cs-line kw">def</span> <span class="cs-line fn">ar_draft</span><span class="cs-line">(prefix, gamma):</span>
<span class="cs-line hl-a">    tokens = []</span>
<span class="cs-line hl-a">    <span class="kw">for</span> i <span class="kw">in</span> <span class="fn">range</span>(gamma):          <span class="cmt"># γ sequential steps</span></span>
<span class="cs-line hl-a">        h = draft_model(prefix + tokens)</span>
<span class="cs-line hl-a">        t = lm_head(h)[-<span class="num">1</span>]           <span class="cmt"># full vocab LM head</span></span>
<span class="cs-line hl-a">        tokens.append(<span class="fn">sample</span>(t))</span>
<span class="cs-line hl-a">    <span class="kw">return</span> tokens</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Parallel drafter (DFlash)</span>
<span class="cs-line kw">def</span> <span class="fn">par_draft</span>(prefix, gamma):</span>
<span class="cs-line hl-c">    masked = [prefix[-<span class="num">1</span>]] + [MASK] * gamma</span>
<span class="cs-line hl-c">    H = backbone(context(prefix), masked) <span class="cmt"># 1 pass</span></span>
<span class="cs-line hl-c">    logits = lm_head(H)                  <span class="cmt"># 1 LM-head</span></span>
<span class="cs-line hl-c">    <span class="kw">return</span> [<span class="fn">sample</span>(logits[i]) <span class="kw">for</span> i <span class="kw">in</span> <span class="fn">range</span>(gamma)]</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Cost comparison (tnet per forward, thead per LM-head call)</span>
<span class="cs-line cmt"># AR:  γ·tnet + γ·thead  (e.g. 16 × 5.9ms + 16 × 35.5ms)</span>
<span class="cs-line cmt"># PAR: tnet_block + thead  (e.g. 1 × 5.9ms + 1 × 35.5ms)</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-speedup">
      <pre class="cs-pre">
<span class="cs-line cmt"># Speculative decoding speedup formula</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># τ  = expected tokens accepted per cycle (incl. bonus)</span>
<span class="cs-line cmt"># T_d = draft cost,  T_v = verification cost</span>
<span class="cs-line cmt"># L_t = target model per-token latency (autoregressive)</span>
<span class="cs-line"></span>
<span class="cs-line hl-p">L_spec = (T_draft + T_verify) / tau</span>
<span class="cs-line hl-p">speedup = L_target / L_spec</span>
<span class="cs-line hl-p">       = tau * L_target / (T_draft + T_verify)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># On A100, Qwen3-8B, context=1024 (from Figure 1)</span>
<span class="cs-line cmt"># T_verify = 35.5ms (always the same)</span>
<span class="cs-line cmt"># EAGLE-3 draft: 6.0ms  → speedup = 3.28×  (τ=4.86)</span>
<span class="cs-line cmt"># DFlash draft:  5.9ms  → speedup = 3.42×  (τ=4.03)</span>
<span class="cs-line cmt"># Domino draft:  7.1ms  → speedup = 3.84×  (τ=4.70)</span>
<span class="cs-line cmt"># (Domino = 5.9ms backbone + 1.2ms DHead)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Two orthogonal levers for better speedup:</span>
<span class="cs-line kw">def</span> <span class="fn">lever_1</span>(tau):
<span class="cs-line hl-g">    <span class="cmt"># Higher τ: each target call advances more tokens</span></span>
<span class="cs-line hl-g">    <span class="cmt"># Autoregressive drafting achieves τ=4.86</span></span>
<span class="cs-line hl-g">    <span class="cmt"># Domino achieves τ=4.70 with parallel cost</span></span>
<span class="cs-line"></span>
<span class="cs-line kw">def</span> <span class="fn">lever_2</span>(T_draft):
<span class="cs-line hl-c">    <span class="cmt"># Lower T_draft: less overhead per cycle</span></span>
<span class="cs-line hl-c">    <span class="cmt"># Parallel drafting: T_draft is O(1) not O(γ)</span></span>
<span class="cs-line hl-c">    <span class="cmt"># Domino adds only 2.8% to DFlash draft cost</span></span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-architecture">
      <pre class="cs-pre">
<span class="cs-line cmt"># Domino forward pass (inference)</span>
<span class="cs-line"></span>
<span class="cs-line kw">def</span> <span class="fn">domino_draft</span>(prefix, gamma=<span class="num">16</span>):</span>
<span class="cs-line cmt">    # ── Step 1: Parallel backbone ──────────────────</span>
<span class="cs-line hl-c">    C = target_model.get_context(prefix)</span>
<span class="cs-line hl-c">    masked = [prefix[-<span class="num">1</span>]] + [MASK] * gamma</span>
<span class="cs-line hl-c">    H = backbone(C, embed(masked))  <span class="cmt"># 1 pass, all pos</span></span>
<span class="cs-line hl-c">    L_base = lm_head_frozen(H)      <span class="cmt"># base logits</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt">    # ── Step 2: Domino head (sequential, cheap) ───</span>
<span class="cs-line">    S = zeros(<span class="num">1024</span>)  <span class="cmt"># GRU hidden state</span></span>
<span class="cs-line">    draft_tokens = []</span>
<span class="cs-line hl-p">    <span class="kw">for</span> i <span class="kw">in</span> <span class="fn">range</span>(gamma):</span>
<span class="cs-line hl-p">        dL = W2(<span class="fn">silu</span>(W1(<span class="fn">concat</span>(H[i], S))))</span>
<span class="cs-line hl-p">        d  = <span class="fn">sample</span>(L_base[i] + dL)    <span class="cmt"># final logit</span></span>
<span class="cs-line hl-p">        S  = <span class="fn">GRU</span>(<span class="fn">embed</span>(d), S)           <span class="cmt"># update state</span></span>
<span class="cs-line hl-p">        draft_tokens.<span class="fn">append</span>(d)</span>
<span class="cs-line"></span>
<span class="cs-line cmt">    # ── Step 3: Target model verification ─────────</span>
<span class="cs-line hl-g">    accepted = target_model.<span class="fn">verify</span>(prefix, draft_tokens)</span>
<span class="cs-line hl-g">    <span class="kw">return</span> accepted  <span class="cmt"># τ tokens advanced</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Domino head dimensions</span>
<span class="cs-line cmt"># GRU hidden dim: 1024</span>
<span class="cs-line cmt"># W1: (d_model + 1024) → 256   (low-rank bottleneck r=256)</span>
<span class="cs-line cmt"># W2: 256 → vocab_size          (correction logits)</span>
<span class="cs-line cmt"># Total: 56M params, +5.3% over backbone</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-causal">
      <pre class="cs-pre">
<span class="cs-line cmt"># GRU causal encoder detail</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># At inference: autoregressively sample draft tokens,</span>
<span class="cs-line cmt"># each time updating the GRU with the chosen token</span>
<span class="cs-line"></span>
<span class="cs-line kw">class</span> <span class="cls">DominoHead</span>:</span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">__init__</span>(<span class="kw">self</span>):</span>
<span class="cs-line hl-c">        <span class="kw">self</span>.gru = <span class="cls">GRU</span>(input=<span class="num">4096</span>, hidden=<span class="num">1024</span>)</span>
<span class="cs-line hl-c">        <span class="kw">self</span>.W1  = <span class="fn">Linear</span>(<span class="num">4096</span>+<span class="num">1024</span>, <span class="num">256</span>)   <span class="cmt"># d_model+ds→r</span></span>
<span class="cs-line hl-c">        <span class="kw">self</span>.W2  = <span class="fn">Linear</span>(<span class="num">256</span>, vocab_size)    <span class="cmt"># r → logits</span></span>
<span class="cs-line"></span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">forward</span>(<span class="kw">self</span>, H, S_prev, d_prev):</span>
<span class="cs-line cmt">        # H: backbone hidden at this position</span>
<span class="cs-line cmt">        # S_prev: GRU state from previous draft token</span>
<span class="cs-line cmt">        # d_prev: previously sampled draft token</span>
<span class="cs-line hl-p">        S = <span class="kw">self</span>.gru(<span class="fn">embed</span>(d_prev), S_prev)</span>
<span class="cs-line hl-p">        delta_L = <span class="kw">self</span>.W2(<span class="fn">silu</span>(<span class="kw">self</span>.W1(<span class="fn">cat</span>(H, S))))</span>
<span class="cs-line hl-p">        <span class="kw">return</span> delta_L, S</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Why logit-space correction matters:</span>
<span class="cs-line cmt"># - Hidden-space correction → need to re-run LM head</span>
<span class="cs-line cmt">  → re-introduces O(vocab) sequential computation</span>
<span class="cs-line cmt"># - Logit-space correction → residual add only</span>
<span class="cs-line cmt">  → full LM head stays parallel (from backbone pass)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Ablation: DHead disabled vs enabled (same backbone)</span>
<span class="cs-line cmt"># w/o DHead: τ=3.49, speedup=2.84×</span>
<span class="cs-line cmt"># w/  DHead: τ=4.19, speedup=3.31×  (+20.1% τ)</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-training">
      <pre class="cs-pre">
<span class="cs-line cmt"># Training the Domino head</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Problem 1: What prefix does GRU see during training?</span>
<span class="cs-line cmt"># Options: TTT (self-generated) vs teacher-forcing</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Teacher forcing: GRU gets ground-truth embeddings</span>
<span class="cs-line kw">def</span> <span class="fn">train_step_tf</span>(x_gt):
<span class="cs-line hl-c">    <span class="cmt"># Feed ground-truth prefix tokens to GRU</span></span>
<span class="cs-line hl-c">    S = zeros(<span class="num">1024</span>)</span>
<span class="cs-line hl-c">    <span class="kw">for</span> i <span class="kw">in</span> <span class="fn">range</span>(gamma):</span>
<span class="cs-line hl-c">        S = <span class="fn">GRU</span>(<span class="fn">embed</span>(x_gt[i]), S)  <span class="cmt"># gt, not sample</span></span>
<span class="cs-line hl-c">        <span class="cmt"># correction is trained to be useful in</span></span>
<span class="cs-line hl-c">        <span class="cmt"># the accepted-prefix regime only</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Problem 2: Backbone collapse with teacher forcing</span>
<span class="cs-line cmt"># Clean gt prefix → correction branch shortcuts backbone</span>
<span class="cs-line cmt"># Fix: base-anchored curriculum</span>
<span class="cs-line"></span>
<span class="cs-line kw">def</span> <span class="fn">curriculum_loss</span>(step, total_steps):</span>
<span class="cs-line hl-p">    lam = <span class="num">1.0</span> - step / total_steps  <span class="cmt"># 1→0 linear</span></span>
<span class="cs-line hl-p">    L = (<span class="num">1</span> - lam) * L_final + lam * L_base</span>
<span class="cs-line hl-p">    <span class="cmt"># Early training: pure backbone loss (lam=1)</span></span>
<span class="cs-line hl-p">    <span class="cmt"># Late training:  pure final-logit loss (lam=0)</span></span>
<span class="cs-line hl-p">    <span class="kw">return</span> L</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Position weights (exponential decay, per DFlash)</span>
<span class="cs-line cmt"># w_k = exp(-k/γ)  — earlier positions weighted more</span>
<span class="cs-line cmt"># Rationale: token at pos i is accepted only if</span>
<span class="cs-line cmt"># all tokens at pos &lt;i were also accepted</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Acceptance length: TTT=3.80, TF=3.96, TF+Curr=4.19</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-results">
      <pre class="cs-pre">
<span class="cs-line cmt"># Main results: Qwen3-8B, greedy (T=0), budget=16</span>
<span class="cs-line cmt"># Speedup over vanilla autoregressive decoding</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># GSM8K results (math reasoning)</span>
<span class="cs-line cmt"># EAGLE-3 (16):  2.21×  τ=3.27</span>
<span class="cs-line cmt"># EAGLE-3 (60):  2.56×  τ=3.80  (4× more compute)</span>
<span class="cs-line cmt"># DFlash  (16):  5.21×  τ=6.59</span>
<span class="cs-line hl-p"><span class="cmt"># Domino  (16):  7.92×  τ=10.03  ← best</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Average over 8 benchmarks</span>
<span class="cs-line cmt"># DFlash → 4.66× (τ=6.06 avg)</span>
<span class="cs-line hl-p"><span class="cmt"># Domino → 5.49× (τ=7.17 avg) +17.8% speedup</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Domino over DFlash (fine-grained)</span>
<span class="cs-line cmt"># +56M params    (+5.3% model size)</span>
<span class="cs-line cmt"># +1.2ms latency (+2.8% draft-then-verify time)</span>
<span class="cs-line cmt"># +16.6% accept length (τ 6.06 → 7.17)</span>
<span class="cs-line cmt"># +12.3% end-to-end speedup (4.66→ 5.21 on GSM8K)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># SGLang high-concurrency (Qwen3-8B, GSM8K)</span>
<span class="cs-line cmt"># concurrency=2:  Domino 942 TPS vs DFlash 672 TPS</span>
<span class="cs-line cmt"># concurrency=8:  Domino 2678 TPS vs DFlash 1915 TPS</span>
<span class="cs-line cmt"># concurrency=32: Domino 3650 TPS vs DFlash 2801 TPS</span>
<span class="cs-line hl-g"><span class="cmt"># Domino up to 5.1× throughput at concurrency=2</span></span>
      </pre>
    </div>

  </div>

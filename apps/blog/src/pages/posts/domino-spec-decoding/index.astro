<script>
// ─────────────────────────────────────────────────────────
// TOC + sidebar toggles
// ─────────────────────────────────────────────────────────
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});
const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ─────────────────────────────────────────────────────────
// Code sidebar tab switching
// ─────────────────────────────────────────────────────────
const tabMeta = {
  tradeoff:     { file: 'domino/tradeoff.py',    title: 'The Trade-off' },
  speedup:      { file: 'domino/speedup.py',     title: 'Speedup Formula' },
  architecture: { file: 'domino/architecture.py', title: 'Architecture' },
  causal:       { file: 'domino/causal_head.py',  title: 'Causal Correction' },
  training:     { file: 'domino/training.py',    title: 'Training Strategy' },
  results:      { file: 'domino/results.py',     title: 'Results' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ─────────────────────────────────────────────────────────
// IntersectionObserver — sync TOC + sidebar on scroll
// ─────────────────────────────────────────────────────────
const sectionMap = {
  's-tradeoff':    'tradeoff',
  's-speedup':     'speedup',
  's-architecture':'architecture',
  's-causal':      'causal',
  's-training':    'training',
  's-results':     'results',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ─────────────────────────────────────────────────────────
// §01 — Trade-off canvas: quality vs cost bubble chart
// ─────────────────────────────────────────────────────────
(function() {
  const canvas = document.getElementById('tradeoff-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 220;
  canvas.width = W * DPR; canvas.height = H * DPR;
  ctx.scale(DPR, DPR);

  const PAD = { l: 60, r: 30, t: 28, b: 46 };
  const IW = W - PAD.l - PAD.r;
  const IH = H - PAD.t - PAD.b;

  // Data: [label, tau, speedup, color, isActive]
  const methods = {
    eagle3: { label: 'EAGLE-3', tau: 4.86, speedup: 3.28, col: '#5c6370' },
    dflash: { label: 'DFlash',  tau: 4.03, speedup: 3.42, col: '#06b6d4' },
    domino: { label: 'Domino',  tau: 4.70, speedup: 3.84, col: '#8b5cf6' },
  };

  let activeMethod = 'eagle3';

  function px(tau) { return PAD.l + ((tau - 3.5) / (5.5 - 3.5)) * IW; }
  function py(spd) { return PAD.t + (1 - (spd - 2.8) / (4.2 - 2.8)) * IH; }

  function drawAll() {
    ctx.clearRect(0, 0, W, H);
    // Grid
    ctx.strokeStyle = 'rgba(255,255,255,0.05)';
    ctx.lineWidth = 1;
    for (let t = 3.5; t <= 5.5; t += 0.5) {
      ctx.beginPath(); ctx.moveTo(px(t), PAD.t); ctx.lineTo(px(t), PAD.t + IH); ctx.stroke();
    }
    for (let s = 2.8; s <= 4.2; s += 0.35) {
      ctx.beginPath(); ctx.moveTo(PAD.l, py(s)); ctx.lineTo(PAD.l + IW, py(s)); ctx.stroke();
    }
    // Axes
    ctx.strokeStyle = 'rgba(255,255,255,0.2)';
    ctx.beginPath(); ctx.moveTo(PAD.l, PAD.t); ctx.lineTo(PAD.l, PAD.t + IH); ctx.lineTo(PAD.l + IW, PAD.t + IH); ctx.stroke();
    // Labels
    ctx.fillStyle = 'rgba(92,99,112,.8)';
    ctx.font = `${10 / DPR + 10}px var(--ff-mono, monospace)`; ctx.font = '10px monospace';
    ctx.textAlign = 'center';
    ctx.fillText('acceptance length τ →', PAD.l + IW / 2, H - 8);
    ctx.save(); ctx.translate(14, PAD.t + IH / 2); ctx.rotate(-Math.PI / 2);
    ctx.fillText('speedup →', 0, 0);
    ctx.restore();
    // Tick labels
    ctx.textAlign = 'center'; ctx.fillStyle = 'rgba(92,99,112,.8)'; ctx.font = '9px monospace';
    [4.0, 4.5, 5.0].forEach(t => {
      ctx.fillText(t.toFixed(1), px(t), PAD.t + IH + 14);
    });
    ctx.textAlign = 'right';
    [3.0, 3.4, 3.8, 4.2].forEach(s => {
      ctx.fillText(s.toFixed(1) + '×', PAD.l - 6, py(s) + 3);
    });

    // Draw each method
    Object.entries(methods).forEach(([key, m]) => {
      const x = px(m.tau), y = py(m.speedup);
      const isActive = key === activeMethod;
      const r = isActive ? 14 : 9;
      ctx.beginPath(); ctx.arc(x, y, r, 0, Math.PI * 2);
      ctx.fillStyle = isActive ? m.col : m.col + '55';
      ctx.fill();
      if (isActive) {
        ctx.strokeStyle = m.col; ctx.lineWidth = 2;
        ctx.stroke();
        // Annotation box
        const bx = x + 18, by = y - 28;
        ctx.fillStyle = 'rgba(20,20,30,.85)';
        ctx.strokeStyle = m.col + 'aa';
        ctx.lineWidth = 1;
        ctx.beginPath(); ctx.roundRect(bx, by, 128, 46, 5); ctx.fill(); ctx.stroke();
        ctx.fillStyle = m.col;
        ctx.font = 'bold 10px monospace';
        ctx.textAlign = 'left';
        ctx.fillText(m.label, bx + 8, by + 16);
        ctx.fillStyle = '#abb2bf'; ctx.font = '9px monospace';
        ctx.fillText('τ = ' + m.tau.toFixed(2) + '  speedup = ' + m.speedup.toFixed(2) + '×', bx + 8, by + 34);
      } else {
        ctx.fillStyle = '#7c7c8a'; ctx.font = '9px monospace'; ctx.textAlign = 'left';
        ctx.fillText(m.label, x + r + 4, y + 4);
      }
    });
  }

  drawAll();

  document.querySelectorAll('.canvas-btn[data-method]').forEach(btn => {
    btn.addEventListener('click', () => {
      activeMethod = btn.dataset.method;
      document.querySelectorAll('.canvas-btn[data-method]').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      drawAll();
    });
  });
})();

// ─────────────────────────────────────────────────────────
// §02 — Latency breakdown stacked bar canvas
// ─────────────────────────────────────────────────────────
(function() {
  const canvas = document.getElementById('latency-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 160;
  canvas.width = W * DPR; canvas.height = H * DPR;
  ctx.scale(DPR, DPR);

  // Data from paper Figure 1 (Qwen3-8B, A100, context=1024, 16-token budget)
  // [label, verify_ms, draft_ms, extra_ms, extra_label]
  const rows = [
    { label: 'DFlash',  verify: 35.5, draft: 5.9, extra: 0,    extraLabel: '' },
    { label: 'Domino',  verify: 35.5, draft: 5.9, extra: 1.2,  extraLabel: '+1.2ms DHead' },
    { label: 'EAGLE-3', verify: 35.5, draft: 6.0, extra: 0,    extraLabel: '' },
  ];

  const maxMs = 45;
  const PAD = { l: 72, r: 140, t: 20, b: 24 };
  const IW = W - PAD.l - PAD.r;
  const rowH = 34;
  const startY = (H - rows.length * rowH) / 2;

  function msToX(ms) { return PAD.l + (ms / maxMs) * IW; }

  ctx.clearRect(0, 0, W, H);

  rows.forEach((row, i) => {
    const y = startY + i * rowH + 4;

    // label
    ctx.fillStyle = '#7c7c8a'; ctx.font = '10px monospace'; ctx.textAlign = 'right';
    ctx.fillText(row.label, PAD.l - 6, y + 13);

    // verify bar (teal)
    const vw = (row.verify / maxMs) * IW;
    ctx.fillStyle = 'rgba(6,182,212,.4)';
    ctx.fillRect(PAD.l, y, vw, 22);

    // draft bar (purple)
    const dw = (row.draft / maxMs) * IW;
    ctx.fillStyle = 'rgba(139,92,246,.6)';
    ctx.fillRect(PAD.l + vw, y, dw, 22);

    // extra bar (green)
    if (row.extra > 0) {
      const ew = (row.extra / maxMs) * IW;
      ctx.fillStyle = 'rgba(16,185,129,.8)';
      ctx.fillRect(PAD.l + vw + dw, y, ew, 22);
    }

    // total label
    const total = row.verify + row.draft + row.extra;
    ctx.fillStyle = '#abb2bf'; ctx.font = '9px monospace'; ctx.textAlign = 'left';
    ctx.fillText(total.toFixed(1) + 'ms total', PAD.l + (total / maxMs) * IW + 6, y + 14);
    if (row.extraLabel) {
      ctx.fillStyle = 'rgba(16,185,129,.8)'; ctx.font = '8px monospace';
      ctx.fillText(row.extraLabel, PAD.l + (total / maxMs) * IW + 6, y + 24);
    }
  });

  // Legend
  const legY = H - 14;
  [['rgba(6,182,212,.4)', 'Verify (35.5ms)'], ['rgba(139,92,246,.6)', 'Draft net'], ['rgba(16,185,129,.8)', 'DHead']].forEach(([col, lbl], i) => {
    const x = PAD.l + i * 100;
    ctx.fillStyle = col; ctx.fillRect(x, legY, 10, 8);
    ctx.fillStyle = '#7c7c8a'; ctx.font = '8px monospace'; ctx.textAlign = 'left';
    ctx.fillText(lbl, x + 14, legY + 8);
  });
})();

// ─────────────────────────────────────────────────────────
// §04 — Step navigator for causal correction
// ─────────────────────────────────────────────────────────
(function() {
  let step = 0;
  const boxes = document.querySelectorAll('#causal-steps .step-box');
  const prevBtn = document.getElementById('causal-prev');
  const nextBtn = document.getElementById('causal-next');
  const progEl  = document.getElementById('causal-prog');

  function updateSteps() {
    boxes.forEach((b, i) => {
      b.classList.remove('active', 'done');
      if (i === step) b.classList.add('active');
      else if (i < step) b.classList.add('done');
    });
    if (prevBtn) prevBtn.disabled = step === 0;
    if (nextBtn) nextBtn.disabled = step === boxes.length - 1;
    if (progEl) progEl.textContent = 'Step ' + (step + 1) + ' of ' + boxes.length;
    boxes.forEach((b, i) => {
      const n = b.querySelector('.step-num');
      if (n) n.textContent = i < step ? '✓' : String(i + 1);
    });
  }
  prevBtn?.addEventListener('click', () => { if (step > 0) { step--; updateSteps(); } });
  nextBtn?.addEventListener('click', () => { if (step < boxes.length - 1) { step++; updateSteps(); } });
  updateSteps();
})();

// ─────────────────────────────────────────────────────────
// §05 — Training bars (animate on scroll)
// ─────────────────────────────────────────────────────────
(function() {
  const sec = document.getElementById('s-training');
  if (!sec) return;
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('#training-bars .bar-fill[data-w]').forEach(b => {
          b.style.width = parseFloat(b.dataset.w) + '%';
        });
      }
    });
  }, { threshold: 0.3 }).observe(sec);
})();


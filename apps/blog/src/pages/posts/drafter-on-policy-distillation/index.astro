<span class="cs-line"></span>
<span class="cs-line cmt"># reverse KL: mode-SEEKING (sharpens)</span>
<span class="cs-line hl-p">rkl = sum(q * log(q / p))</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># acceptance prob = 1 - TV(p, q)</span>
<span class="cs-line hl-g">acc = <span class="num">1</span> - <span class="num">0.5</span> * sum(abs(p - q))</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># DistillSpec: best divergence is</span>
<span class="cs-line cmt"># task/decoding-dependent. The robust</span>
<span class="cs-line cmt"># win is ON-POLICY DATA, not the loss.</span></pre>
    </div>
    <div class="cs-panel" id="panel-evidence">
      <pre class="cs-pre"><span class="cs-line cmt"># Acceptance length (LLaMA2-7B, T=0)</span>
<span class="cs-line">EAGLE   (offline) : <span class="num">3.78</span></span>
<span class="cs-line">EAGLE-2           : <span class="num">4.61</span></span>
<span class="cs-line hl-p">HASS (on-policy)  : <span class="num">5.15</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Speedup (LLaMA3-70B, T=0)</span>
<span class="cs-line">EAGLE / E2 / HASS : <span class="num">2.43</span> / <span class="num">3.37</span> / <span class="num">4.05</span>x</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># DistillSpec : +10-45% vs spec-decode</span>
<span class="cs-line cmt"># OSD         : accept +0.1-0.65</span>
<span class="cs-line cmt"># EAGLE-3     : 3-6.5x, scales w/ data</span>
<span class="cs-line cmt"># GKD         : 1.7-2.1x over baseline KD</span></pre>
    </div>
    <div class="cs-panel" id="panel-verdict">
      <pre class="cs-pre"><span class="cs-line cmt"># Recommended drafter training recipe</span>
<span class="cs-line"></span>
<span class="cs-line hl-g"><span class="num">1</span>. warm_start teacher-forced  <span class="cmt"># stable</span></span>
<span class="cs-line hl-p"><span class="num">2</span>. unroll 3-4 steps on-policy <span class="cmt"># ttt</span></span>
<span class="cs-line hl-c"><span class="num">3</span>. distribution-matching KD   <span class="cmt"># topK/RKL</span></span>
<span class="cs-line"><span class="num">4</span>. drop feature-MSE loss</span>
<span class="cs-line"><span class="num">5</span>. keep target features as input</span>
<span class="cs-line"><span class="num">6</span>. (optional) online KD on live q</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># standalone in OBJECTIVE,</span>
<span class="cs-line cmt"># attached in INPUT.</span>
<span class="cs-line cmt"># cost: generation during training</span>
<span class="cs-line cmt">#       (Fast-OPD: 2-47x via prefix trunc)</span></pre>
    </div>
  </div>
</aside>

</div><!-- /post-grid -->

<script>
// ---------- TOC + sidebar toggles ----------
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});
const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ---------- code tab switching ----------
const tabMeta = {
  problem:    { file: 'offline_draft.py',     title: 'Teacher-forced training' },
  lossless:   { file: 'verify.py',            title: 'Lossless verification' },
  exposure:   { file: 'compounding.py',       title: 'Exposure-bias bound' },
  onpolicy:   { file: 'training_time_test.py',title: 'On-policy unroll' },
  divergence: { file: 'divergence.py',        title: 'Distillation loss' },
  evidence:   { file: 'numbers.txt',          title: 'Benchmark numbers' },
  verdict:    { file: 'recipe.py',            title: 'Recommended recipe' },
};
function activateTab(name){
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m){ document.getElementById('cs-file-label').textContent = m.file; document.getElementById('cs-section-title').textContent = m.title; }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ---------- scroll sync ----------
const sectionMap = { 's-problem':'problem','s-lossless':'lossless','s-exposure':'exposure','s-onpolicy':'onpolicy','s-divergence':'divergence','s-evidence':'evidence','s-verdict':'verdict' };
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting){
        document.querySelectorAll('.toc-item').forEach(li => li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id]; if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

function fit(cv, h){ const DPR = window.devicePixelRatio || 1; const W = cv.clientWidth; cv.width = W * DPR; cv.height = h * DPR; const ctx = cv.getContext('2d'); ctx.setTransform(DPR,0,0,DPR,0,0); return { ctx, W, H:h }; }
function rr(ctx,x,y,w,h,r){ ctx.beginPath(); ctx.moveTo(x+r,y); ctx.arcTo(x+w,y,x+w,y+h,r); ctx.arcTo(x+w,y+h,x,y+h,r); ctx.arcTo(x,y+h,x,y,r); ctx.arcTo(x,y,x+w,y,r); ctx.closePath(); }

const COL = { purple:'#8b5cf6', purpleL:'#a78bfa', cyan:'#06b6d4', green:'#34d399', amber:'#f59e0b', red:'#ef6461', muted:'#6b7280', text:'#e5e7eb' };

// ===== 01 context canvas =====
(function(){
  const cv = document.getElementById('ctx-canvas'); if(!cv) return;
  let mode = 'train';
  const trueToks  = ['Paris', ',', 'the', 'capital', 'city'];
  const draftToks = ['Paris', ',', 'a', 'major', 'port'];
  const divergeAt = 2;
  function draw(){
    const { ctx, W, H } = fit(cv, 250);
    ctx.clearRect(0,0,W,H);
    const n = 5, pad = 18, gap = 10;
    const cw = (W - pad*2 - gap*(n-1)) / n;
    const topY = 95, botY = 175, bh = 40;
    // bus label
    ctx.font = '600 11px ui-monospace, monospace';
    ctx.textAlign = 'left';
    ctx.fillStyle = mode==='train' ? COL.green : COL.amber;
    ctx.fillText(mode==='train' ? 'TARGET true tokens  →  fed as input' : "DRAFTER's own output  →  fed back as input", pad, 26);
    ctx.fillStyle = COL.muted; ctx.font = '10px ui-monospace, monospace';
    ctx.fillText('input context', pad, topY-12);
    ctx.fillText('drafter prediction', pad, botY-12);
    for(let i=0;i<n;i++){
      const x = pad + i*(cw+gap);
      const poisoned = mode==='infer' && i>=divergeAt;
      // input cell
      let inTok, inCol;
      if(i===0){ inTok='⟨prompt⟩'; inCol=COL.cyan; }
      else if(mode==='train'){ inTok=trueToks[i-1]; inCol=COL.green; }
      else { inTok=draftToks[i-1]; inCol = (i-1>=divergeAt)?COL.red:COL.amber; }
      ctx.globalAlpha = 1;
      rr(ctx,x,topY,cw,bh,7); ctx.fillStyle = 'rgba(255,255,255,.04)'; ctx.fill();
      ctx.lineWidth=1.5; ctx.strokeStyle=inCol; ctx.stroke();
      ctx.fillStyle=inCol; ctx.font='600 12px ui-monospace, monospace'; ctx.textAlign='center';
      ctx.fillText(inTok, x+cw/2, topY+bh/2+4);
      // prediction cell
      const pTok = mode==='train' ? trueToks[i] : draftToks[i];
      const pCol = mode==='train' ? COL.green : (poisoned?COL.red:COL.amber);
      rr(ctx,x,botY,cw,bh,7); ctx.fillStyle = mode==='train'?'rgba(52,211,153,.10)':(poisoned?'rgba(239,100,97,.12)':'rgba(245,158,11,.10)'); ctx.fill();
      ctx.lineWidth=1.5; ctx.strokeStyle=pCol; ctx.stroke();
      ctx.fillStyle=pCol; ctx.fillText(pTok||'·', x+cw/2, botY+bh/2+4);
      // arrow input->pred
      ctx.strokeStyle='rgba(255,255,255,.18)'; ctx.lineWidth=1.2;
      ctx.beginPath(); ctx.moveTo(x+cw/2, topY+bh); ctx.lineTo(x+cw/2, botY); ctx.stroke();
      // feedback arrow pred[i-1] -> input[i] in infer mode
      if(mode==='infer' && i>0){
        const px = pad + (i-1)*(cw+gap) + cw/2;
        const tx = x + cw/2;
        ctx.strokeStyle = (i-1>=divergeAt)?COL.red:COL.amber; ctx.lineWidth=1.6;
        ctx.beginPath();
        ctx.moveTo(px, botY+bh);
        ctx.bezierCurveTo(px, botY+bh+26, tx, topY-26, tx, topY);
        ctx.stroke();
        // arrowhead
        ctx.fillStyle=ctx.strokeStyle; ctx.beginPath(); ctx.moveTo(tx,topY); ctx.lineTo(tx-4,topY-7); ctx.lineTo(tx+4,topY-7); ctx.closePath(); ctx.fill();
      }
    }
    ctx.globalAlpha=1;
  }
  function setCap(){
    const cap = document.getElementById('ctx-cap');
    cap.innerHTML = mode==='train'
      ? "<b>Training:</b> every input cell is the target's <b>true</b> token (green). The drafter only ever sees a perfect prefix — it never learns what to do after its own mistake."
      : "<b>Inference:</b> each cell is fed the drafter's <b>own</b> previous output (amber). It guesses <b>\"a\"</b> instead of <b>\"the\"</b> at step 3 — and from there it's on a sequence it never saw in training (red). Everything downstream is off-manifold and gets rejected.";
  }
  const bT=document.getElementById('ctx-train'), bI=document.getElementById('ctx-infer');
  bT.onclick=()=>{mode='train';bT.classList.add('active');bI.classList.remove('active');draw();setCap();};
  bI.onclick=()=>{mode='infer';bI.classList.add('active');bT.classList.remove('active');draw();setCap();};
  setCap(); draw(); window.addEventListener('resize', draw);
})();

// ===== 02 verify canvas =====
(function(){
  const cv = document.getElementById('ver-canvas'); if(!cv) return;
  const sl = document.getElementById('ver-slider');
  const toks = ['Paris',',','the','capital','of','France'];
  const labels = ['low','low','mid','mid','high','high'];
  function draw(){
    const tau = parseInt(sl.value,10);
    const { ctx, W, H } = fit(cv,170);
    ctx.clearRect(0,0,W,H);
    const n = toks.length, pad=16, gap=8;
    const cw = (W-pad*2-gap*(n-1))/n, y=42, bh=42;
    ctx.font='10px ui-monospace, monospace'; ctx.textAlign='left'; ctx.fillStyle=COL.muted;
    ctx.fillText('drafter proposes 6 tokens — target verifies in ONE pass', pad, 24);
    for(let i=0;i<n;i++){
      const x=pad+i*(cw+gap);
      let col, fill, tag;
      if(i<tau){ col=COL.green; fill='rgba(52,211,153,.12)'; tag='✓'; }
      else if(i===tau){ col=COL.purple; fill='rgba(139,92,246,.14)'; tag='↺'; }
      else { col=COL.muted; fill='rgba(255,255,255,.03)'; tag='·'; }
      rr(ctx,x,y,cw,bh,7); ctx.fillStyle=fill; ctx.fill(); ctx.lineWidth=1.5; ctx.strokeStyle=col; ctx.stroke();
      ctx.fillStyle=col; ctx.font='600 12px ui-monospace, monospace'; ctx.textAlign='center';
      ctx.fillText(i===tau?'(resample)':toks[i], x+cw/2, y+bh/2+4);
      ctx.font='10px ui-monospace, monospace'; ctx.fillText(tag, x+cw/2, y+bh+15);
    }
    // legend
    ctx.textAlign='left'; ctx.font='10px ui-monospace, monospace';
    ctx.fillStyle=COL.green; ctx.fillText('✓ accepted', pad, H-12);
    ctx.fillStyle=COL.purple; ctx.fillText('↺ corrected resample', pad+90, H-12);
    ctx.fillStyle=COL.muted; ctx.fillText('· discarded', pad+255, H-12);
    // stats
    document.getElementById('ver-tau').textContent = tau;
    document.getElementById('ver-tps').textContent = (1 + tau*0.55).toFixed(1)+'×';
    document.getElementById('ver-val').textContent = labels[tau-1];
  }
  sl.addEventListener('input', draw); draw(); window.addEventListener('resize', draw);
})();

// ===== 03 compounding canvas =====
(function(){
  const cv=document.getElementById('exp-canvas'); if(!cv) return;
  function draw(){
    const { ctx, W, H } = fit(cv,260);
    ctx.clearRect(0,0,W,H);
    const padL=46, padR=20, padT=20, padB=38;
    const x0=padL, x1=W-padR, y0=H-padB, y1=padT;
    const Tmax=8, eps=0.06, ymax=eps*Tmax*Tmax*1.05;
    const X=t=>x0+(t/Tmax)*(x1-x0);
    const Y=v=>y0-(v/ymax)*(y0-y1);
    // grid
    ctx.strokeStyle='rgba(255,255,255,.05)'; ctx.lineWidth=1;
    for(let t=1;t<=Tmax;t++){ ctx.beginPath(); ctx.moveTo(X(t),y0); ctx.lineTo(X(t),y1); ctx.stroke(); }
    // axes
    ctx.strokeStyle='rgba(255,255,255,.25)'; ctx.beginPath(); ctx.moveTo(x0,y0); ctx.lineTo(x1,y0); ctx.moveTo(x0,y0); ctx.lineTo(x0,y1); ctx.stroke();
    ctx.fillStyle=COL.muted; ctx.font='10px ui-monospace, monospace'; ctx.textAlign='center';
    ctx.fillText('draft window length  T →', (x0+x1)/2, H-10);
    ctx.save(); ctx.translate(13,(y0+y1)/2); ctx.rotate(-Math.PI/2); ctx.fillText('expected drift', 0,0); ctx.restore();
    for(let t=2;t<=Tmax;t+=2){ ctx.fillText(String(t), X(t), y0+16); }
    // curves
    function curve(fn,color,dash){ ctx.strokeStyle=color; ctx.lineWidth=2.4; ctx.setLineDash(dash||[]); ctx.beginPath(); for(let t=0;t<=Tmax;t+=0.1){ const xx=X(t), yy=Y(fn(t)); t===0?ctx.moveTo(xx,yy):ctx.lineTo(xx,yy);} ctx.stroke(); ctx.setLineDash([]); }
    curve(t=>eps*t*t, COL.red);
    curve(t=>eps*t, COL.green);
    // labels at end
    ctx.textAlign='left'; ctx.font='600 11px ui-monospace, monospace';
    ctx.fillStyle=COL.red; ctx.fillText('offline  ~ εT²', X(6.05), Y(eps*36)-6);
    ctx.fillStyle=COL.green; ctx.fillText('on-policy  ~ εT', X(8)-78, Y(eps*8)-8);
    // marker at T=6
    ctx.setLineDash([4,4]); ctx.strokeStyle='rgba(255,255,255,.2)'; ctx.beginPath(); ctx.moveTo(X(6),y0); ctx.lineTo(X(6),y1); ctx.stroke(); ctx.setLineDash([]);
    ctx.fillStyle=COL.text; ctx.font='10px ui-monospace, monospace'; ctx.textAlign='center';
    ctx.fillText('typical window', X(6), y1+10);
    [[6,eps*36,COL.red],[6,eps*6,COL.green]].forEach(([t,v,c])=>{ ctx.fillStyle=c; ctx.beginPath(); ctx.arc(X(t),Y(v),4,0,7); ctx.fill(); });
  }
  draw(); window.addEventListener('resize', draw);
})();

// ===== 04 ttt step navigator =====
(function(){
  const boxes=[...document.querySelectorAll('#ttt-steps .step-box')];
  const prev=document.getElementById('ttt-prev'), next=document.getElementById('ttt-next');
  if(!boxes.length) return;
  const accVals=['3.78','4.30','4.80','5.15'];
  let step=0;
  function upd(){
    boxes.forEach((b,i)=>{ b.classList.remove('active','done'); if(i===step)b.classList.add('active'); else if(i<step)b.classList.add('done'); const n=b.querySelector('.step-num'); if(n)n.textContent=i<step?'✓':String(i+1); });
    prev.disabled=step===0; next.disabled=step===boxes.length-1;
    document.getElementById('ttt-acc').textContent=accVals[step];
    document.getElementById('ttt-steps-n').textContent=String(step);
  }
  prev.onclick=()=>{if(step>0){step--;upd();}};
  next.onclick=()=>{if(step<boxes.length-1){step++;upd();}};
  upd();
})();

// ===== 05 divergence canvas =====
(function(){
  const cv=document.getElementById('div-canvas'); if(!cv) return;
  let mode='rkl';
  const toks=['Paris','France','Lyon','Nice','⟨other⟩'];
  const target=[0.75,0.15,0.05,0.03,0.02];
  const rkl=[0.88,0.10,0.01,0.005,0.005];
  const fkl=[0.55,0.20,0.12,0.08,0.05];
  function tv(a,b){ let s=0; for(let i=0;i<a.length;i++)s+=Math.abs(a[i]-b[i]); return 0.5*s; }
  function draw(){
    const q = mode==='rkl'?rkl:fkl;
    const { ctx, W, H } = fit(cv,220);
    ctx.clearRect(0,0,W,H);
    const n=toks.length, padL=20, padR=20, padB=40, padT=14;
    const gw=(W-padL-padR)/n, y0=H-padB, maxh=y0-padT, bw=gw*0.32;
    ctx.font='10px ui-monospace, monospace'; ctx.textAlign='left';
    ctx.fillStyle=COL.muted; ctx.fillText('■ target', padL, 12); ctx.fillStyle=COL.purpleL; ctx.fillText('■ drafter', padL+62, 12);
    for(let i=0;i<n;i++){
      const cx=padL+gw*i+gw/2;
      // target bar
      let h=target[i]*maxh; rr(ctx,cx-bw-2,y0-h,bw,h,4); ctx.fillStyle='rgba(148,163,184,.5)'; ctx.fill();
      // drafter bar
      h=q[i]*maxh; rr(ctx,cx+2,y0-h,bw,h,4); ctx.fillStyle=COL.purple; ctx.fill();
      ctx.fillStyle=COL.text; ctx.font='11px ui-monospace, monospace'; ctx.textAlign='center';
      ctx.fillText(toks[i], cx, y0+16);
    }
    ctx.strokeStyle='rgba(255,255,255,.15)'; ctx.beginPath(); ctx.moveTo(padL,y0); ctx.lineTo(W-padR,y0); ctx.stroke();
    const acc=Math.round((1-tv(target,q))*100);
    document.getElementById('div-acc').textContent=acc+'%';
    document.getElementById('div-mode').textContent= mode==='rkl'?'sharp':'spread';
    document.getElementById('div-cap').innerHTML = mode==='rkl'
      ? "<b>Reverse KL</b> sharpens onto the target's peak (<b>Paris</b>). Against a peaky target under greedy serving it drafts the likely token more often → <b>higher acceptance (87%)</b>."
      : "<b>Forward KL</b> spreads mass to cover every token the target likes — including low-probability ones. It drafts <b>Lyon/Nice</b> too often, those get rejected → <b>lower acceptance (80%)</b> here. (It wins instead when the target is high-entropy.)";
  }
  const bR=document.getElementById('div-rkl'), bF=document.getElementById('div-fkl');
  bR.onclick=()=>{mode='rkl';bR.classList.add('active');bF.classList.remove('active');draw();};
  bF.onclick=()=>{mode='fkl';bF.classList.add('active');bR.classList.remove('active');draw();};
  draw(); window.addEventListener('resize', draw);
})();

// ===== 06 bars =====
(function(){
  const sec=document.getElementById('s-evidence'); if(!sec) return;
  new IntersectionObserver(es=>{ es.forEach(e=>{ if(e.isIntersecting){ document.querySelectorAll('#s-evidence .bar-fill[data-w]').forEach(b=>{ b.style.width=b.dataset.w+'%'; }); } }); },{threshold:0.25}).observe(sec);
})();
</script>
</BaseLayout>

  const methods = [
    [1.00, 65, 'No Defense',     'rgba(107,114,128,.6)', 6],
    [1.38, 65, 'Spec-Decoding',  'rgba(107,114,128,.5)', 6],
    [2.14, 67, 'Specreason',     'rgba(107,114,128,.5)', 6],
    [1.07, 31, 'Self-Reminder',  'rgba(6,182,212,.5)',   6],
    [1.16, 31, 'RPO',            'rgba(6,182,212,.5)',   6],
    [0.82, 32, 'SafeDecoding',   'rgba(239,68,68,.55)',  6],
    [0.61, 22, 'SecDecoding',    'rgba(239,68,68,.7)',   6],
    [2.06,  7, 'SafeSpec',       '#8b5cf6',              10],
  ];

  // Margins
  const ml=52, mr=18, mt=18, mb=42;
  const pw=W-ml-mr, ph=H-mt-mb;

  const xScale = (v) => ml + (v - 0.4) / (2.5 - 0.4) * pw;
  const yScale = (v) => mt + (1 - v/70) * ph;

  // Draw axes + grid
  function drawPareto() {
    ctx.clearRect(0, 0, W, H);

    // Ideal region shading (bottom-right)
    ctx.fillStyle = 'rgba(16,185,129,.04)';
    ctx.fillRect(xScale(1.5), yScale(20), xScale(2.5)-xScale(1.5), yScale(0)-yScale(20));
    ctx.fillStyle = 'rgba(16,185,129,.12)';
    ctx.font = '8px var(--ff-mono, monospace)';
    ctx.fillText('← ideal: fast + safe →', xScale(1.55), yScale(5));

    // Grid lines
    ctx.strokeStyle = 'rgba(255,255,255,.04)';
    ctx.lineWidth = 1;
    [0.5, 1.0, 1.5, 2.0, 2.5].forEach(v => {
      ctx.beginPath(); ctx.moveTo(xScale(v), mt); ctx.lineTo(xScale(v), H-mb); ctx.stroke();
    });
    [0, 20, 40, 60].forEach(v => {
      ctx.beginPath(); ctx.moveTo(ml, yScale(v)); ctx.lineTo(W-mr, yScale(v)); ctx.stroke();
    });

    // Axes
    ctx.strokeStyle = 'rgba(255,255,255,.15)';
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(ml, mt); ctx.lineTo(ml, H-mb); ctx.lineTo(W-mr, H-mb); ctx.stroke();

    // Axis labels
    ctx.fillStyle = '#6b7280';
    ctx.font = '9px var(--ff-mono, monospace)';
    ctx.textAlign = 'center';
    ctx.fillText('Inference Speedup →', W/2, H-6);
    [0.5, 1.0, 1.5, 2.0, 2.5].forEach(v => ctx.fillText(v+'×', xScale(v), H-mb+12));

    ctx.textAlign = 'right';
    [0, 20, 40, 60].forEach(v => ctx.fillText(v+'%', ml-5, yScale(v)+3));

    // Y label
    ctx.save(); ctx.translate(11, mt + ph/2); ctx.rotate(-Math.PI/2);
    ctx.textAlign = 'center'; ctx.fillText('Attack Success Rate (ASR) ↓', 0, 0);
    ctx.restore();

    // Plot dots
    methods.forEach(([spd, asr, label, color, r]) => {
      const x = xScale(spd), y = yScale(asr);
      ctx.beginPath();
      if (label === 'SafeSpec') {
        // Draw star
        const pts = 5, outer = r+4, inner = r;
        ctx.beginPath();
        for (let i = 0; i < pts*2; i++) {
          const angle = (i*Math.PI/pts) - Math.PI/2;
          const rad = i%2===0 ? outer : inner;
          i===0 ? ctx.moveTo(x+Math.cos(angle)*rad, y+Math.sin(angle)*rad)
                : ctx.lineTo(x+Math.cos(angle)*rad, y+Math.sin(angle)*rad);
        }
        ctx.closePath();
        ctx.fillStyle = color;
        ctx.fill();
        ctx.strokeStyle = 'rgba(139,92,246,.6)';
        ctx.lineWidth = 1.5;
        ctx.stroke();
        ctx.fillStyle = '#a78bfa';
        ctx.font = 'bold 9px var(--ff-mono, monospace)';
        ctx.textAlign = 'left';
        ctx.fillText(label, x+14, y+4);
      } else {
        ctx.arc(x, y, r, 0, Math.PI*2);
        ctx.fillStyle = color;
        ctx.fill();
      }
    });
  }
  drawPareto();

  // Tooltip on hover
  canvas.addEventListener('mousemove', (ev) => {
    const rect = canvas.getBoundingClientRect();
    const mx = ev.clientX - rect.left, my = ev.clientY - rect.top;
    let found = null;
    methods.forEach(([spd, asr, label]) => {
      const dx = xScale(spd)-mx, dy = yScale(asr)-my;
      if (Math.sqrt(dx*dx+dy*dy) < 14) found = {spd, asr, label};
    });
    if (found) {
      tooltip.style.display = 'block';
      tooltip.style.left = (ev.clientX - canvas.getBoundingClientRect().left + 12) + 'px';
      tooltip.style.top = (ev.clientY - canvas.getBoundingClientRect().top - 10) + 'px';
      tooltip.textContent = found.label + '  ' + found.spd.toFixed(2) + '×  ASR ' + found.asr + '%';
    } else {
      tooltip.style.display = 'none';
    }
  });
  canvas.addEventListener('mouseleave', () => { tooltip.style.display = 'none'; });
})();

// ── §03: P(K) recovery canvas ──
(function() {
  const canvas = document.getElementById('pk-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const readout = document.getElementById('pk-readout');
  const W = canvas.clientWidth, H = 220, DPR = window.devicePixelRatio||1;
  canvas.width = W*DPR; canvas.height = H*DPR; ctx.scale(DPR,DPR);

  let currentK = 1;
  const P_NO_REFLECT = 0.05;
  const P_REFLECT    = 0.25;
  const pk = (p,k) => 1 - Math.pow(1-p, k);

  const ml=52, mr=14, mt=14, mb=38;
  const pw=W-ml-mr, ph=H-mt-mb;
  const xS = (k) => ml + (k-1)/(20-1)*pw;
  const yS = (v) => mt + (1-v)*ph;

  function drawPK(selK) {
    ctx.clearRect(0,0,W,H);

    // Grid
    ctx.strokeStyle='rgba(255,255,255,.04)'; ctx.lineWidth=1;
    [0,.25,.5,.75,1].forEach(v=>{
      ctx.beginPath(); ctx.moveTo(ml,yS(v)); ctx.lineTo(W-mr,yS(v)); ctx.stroke();
    });
    [1,5,10,15,20].forEach(k=>{
      ctx.beginPath(); ctx.moveTo(xS(k),mt); ctx.lineTo(xS(k),H-mb); ctx.stroke();
    });

    // Axes
    ctx.strokeStyle='rgba(255,255,255,.15)'; ctx.lineWidth=1;
    ctx.beginPath(); ctx.moveTo(ml,mt); ctx.lineTo(ml,H-mb); ctx.lineTo(W-mr,H-mb); ctx.stroke();

    // Labels
    ctx.fillStyle='#6b7280'; ctx.font='9px monospace'; ctx.textAlign='center';
    ctx.fillText('Candidate count K', W/2, H-4);
    [1,5,10,15,20].forEach(k=>ctx.fillText(k, xS(k), H-mb+11));
    ctx.textAlign='right';
    [0,25,50,75,100].forEach(v=>ctx.fillText(v+'%', ml-4, yS(v/100)+3));

    // Curves
    const drawCurve = (p, color) => {
      ctx.beginPath();
      for (let k=1; k<=20; k++) {
        const x=xS(k), y=yS(pk(p,k));
        k===1 ? ctx.moveTo(x,y) : ctx.lineTo(x,y);
      }
      ctx.strokeStyle=color; ctx.lineWidth=2.5; ctx.stroke();
    };
    drawCurve(P_NO_REFLECT, 'rgba(245,158,11,.7)');
    drawCurve(P_REFLECT,    'rgba(16,185,129,.85)');

    // Vertical line at selK
    const kx = xS(selK);
    ctx.setLineDash([4,3]);
    ctx.strokeStyle='rgba(139,92,246,.6)'; ctx.lineWidth=1.5;
    ctx.beginPath(); ctx.moveTo(kx,mt); ctx.lineTo(kx,H-mb); ctx.stroke();
    ctx.setLineDash([]);

    // Dots at selK
    [[P_NO_REFLECT,'rgba(245,158,11,1)'],[P_REFLECT,'rgba(16,185,129,1)']].forEach(([p,c])=>{
      const v=pk(p,selK);
      ctx.beginPath(); ctx.arc(kx,yS(v),5,0,Math.PI*2);
      ctx.fillStyle=c; ctx.fill();
    });

    // Legend
    ctx.font='8px monospace'; ctx.textAlign='left';
    ctx.fillStyle='rgba(245,158,11,.8)'; ctx.fillRect(ml+4,mt+4,12,3);
    ctx.fillStyle='#9ca3af'; ctx.fillText('Without reflection (p_safe=5%)', ml+20, mt+9);
    ctx.fillStyle='rgba(16,185,129,.8)'; ctx.fillRect(ml+4,mt+14,12,3);
    ctx.fillStyle='#9ca3af'; ctx.fillText('With reflection (p_safe=25%)', ml+20, mt+19);
  }

  function updateReadout(k) {
    const vNo = pk(P_NO_REFLECT, k);
    const vRe = pk(P_REFLECT, k);
    readout.innerHTML =
      '<span style="font-size:.72rem;font-family:monospace;color:#f59e0b">Without reflect: <strong>' + Math.round(vNo*100) + '%</strong></span>' +
      '<span style="font-size:.72rem;font-family:monospace;color:#10b981">With reflect: <strong>' + Math.round(vRe*100) + '%</strong></span>';
  }

  function update(k) {
    currentK = k;
    drawPK(k);
    updateReadout(k);
    document.querySelectorAll('.k-btn').forEach(b =>
      b.classList.toggle('active', parseInt(b.dataset.k)===k));
  }

  document.querySelectorAll('.k-btn').forEach(b =>
    b.addEventListener('click', () => update(parseInt(b.dataset.k))));

  update(1);
})();

// ── §06: Animated bar charts ──
['asr-bars','speed-bars'].forEach(id => {
  const sec = document.getElementById(id);
  if (!sec) return;
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        sec.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          b.style.width = b.dataset.w + '%';
        });
      }
    });
  }, { threshold: 0.3 }).observe(sec);
});

// Also trigger results section bars
const resSec = document.getElementById('s-results');
if (resSec) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          b.style.width = b.dataset.w + '%';
        });
      }
    });
  }, { threshold: 0.2 }).observe(resSec);
}
</script>
</BaseLayout>

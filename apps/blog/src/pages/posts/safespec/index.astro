<span class="cs-line cmt"># Specreason-style segment-level speculation</span>
<span class="cs-line"> </span>
<span class="cs-line hl-c"><span class="kw">def</span> <span class="fn">speculative_step</span>(target, draft, x_n, tau_q):</span>
<span class="cs-line">    <span class="cmt"># Draft proposes a full reasoning segment</span></span>
<span class="cs-line">    s_next = draft.<span class="fn">generate_segment</span>(x_n)</span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="cmt"># Build verification input</span></span>
<span class="cs-line">    I = x_n + s_next + P_eval  <span class="cmt"># quality scoring prompt</span></span>
<span class="cs-line"> </span>
<span class="cs-line hl-p">    <span class="cmt"># Target model: single forward pass</span></span>
<span class="cs-line hl-p">    logits, hidden = target.<span class="fn">forward</span>(I)</span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="cmt"># Quality: argmax over digit tokens 0-9</span></span>
<span class="cs-line">    digit_logits = logits[[<span class="str">'0'</span>,<span class="str">'1'</span>,...,<span class="str">'9'</span>]]</span>
<span class="cs-line">    S_q = digit_logits.<span class="fn">argmax</span>().item()</span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="kw">if</span> S_q &gt;= tau_q:</span>
<span class="cs-line">        <span class="kw">return</span> <span class="str">'accept'</span>, s_next</span>
<span class="cs-line">    <span class="kw">else</span>:</span>
<span class="cs-line">        <span class="kw">return</span> <span class="str">'regenerate'</span>, <span class="kw">None</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Key insight: hidden states are ALREADY computed.</span>
<span class="cs-line cmt"># SafeSpec extracts h_t at the segment boundary</span>
<span class="cs-line cmt"># (last token of s_next, before P_eval) — free!</span>
<span class="cs-line hl-g">    t = len(x_n) + len(s_next) - 1  <span class="cmt"># boundary idx</span></span>
<span class="cs-line hl-g">    z = hidden[t]   <span class="cmt"># shape: [d_model]</span></span>
<span class="cs-line hl-g">    S_safe = safety_head(z)  <span class="cmt"># 2-layer MLP → sigmoid</span></span>
      </pre>
    </div>

    <!-- panel: insight -->
    <div class="cs-panel" id="panel-insight">
      <pre class="cs-pre">
<span class="cs-line cmt"># The probabilistic model of jailbreaks</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Jailbreak = distributional shift, not total override</span>
<span class="cs-line cmt"># p_safe_benign  ≈ 0.95  (normal prompts)</span>
<span class="cs-line cmt"># p_safe_jailbrk ≈ 0.05  (no reflection)</span>
<span class="cs-line cmt"># p_safe_reflect ≈ 0.25  (after rollback+reflect)</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">P_recovery</span>(p_safe, K):</span>
<span class="cs-line hl-p">    <span class="str">"""Probability of finding ≥1 safe among K draws"""</span></span>
<span class="cs-line hl-p">    <span class="kw">return</span> <span class="num">1</span> - (<span class="num">1</span> - p_safe) ** K</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Without reflection (p_safe=0.05):</span>
<span class="cs-line">P_recovery(<span class="num">0.05</span>, K=<span class="num">1</span>)  = <span class="num">0.050</span>  <span class="cmt"># 5%</span></span>
<span class="cs-line">P_recovery(<span class="num">0.05</span>, K=<span class="num">5</span>)  = <span class="num">0.226</span>  <span class="cmt"># 23%</span></span>
<span class="cs-line">P_recovery(<span class="num">0.05</span>, K=<span class="num">20</span>) = <span class="num">0.642</span>  <span class="cmt"># 64%</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># With reflection (p_safe=0.25):</span>
<span class="cs-line hl-g">P_recovery(<span class="num">0.25</span>, K=<span class="num">1</span>)  = <span class="num">0.250</span>  <span class="cmt"># 25%</span></span>
<span class="cs-line hl-g">P_recovery(<span class="num">0.25</span>, K=<span class="num">5</span>)  = <span class="num">0.763</span>  <span class="cmt"># 76%</span></span>
<span class="cs-line hl-g">P_recovery(<span class="num">0.25</span>, K=<span class="num">20</span>) = <span class="num">0.997</span>  <span class="cmt"># 99.7%</span></span>
<span class="cs-line"> </span>

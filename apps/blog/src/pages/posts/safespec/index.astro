<span class="cs-line cmt"># Safety head: boundary-aligned MLP</span>
<span class="cs-line"> </span>
<span class="cs-line"><span class="kw">class</span> <span class="cls">SafetyHead</span>(nn.Module):</span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">__init__</span>(<span class="cls">self</span>, d_model, hidden=<span class="num">256</span>):</span>
<span class="cs-line">        <span class="kw">super</span>().__init__()</span>
<span class="cs-line hl-p">        <span class="cls">self</span>.mlp = nn.Sequential(</span>
<span class="cs-line hl-p">            nn.Linear(d_model, hidden),</span>
<span class="cs-line hl-p">            nn.ReLU(),</span>
<span class="cs-line hl-p">            nn.Linear(hidden, <span class="num">1</span>),</span>
<span class="cs-line hl-p">            nn.Sigmoid(),</span>
<span class="cs-line hl-p">        )</span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">forward</span>(<span class="cls">self</span>, z):  <span class="cmt"># z: [d_model]</span></span>
<span class="cs-line">        <span class="kw">return</span> <span class="cls">self</span>.mlp(z)  <span class="cmt"># → [0,1] safety score</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Training data construction</span>
<span class="cs-line hl-c"><span class="kw">def</span> <span class="fn">build_training_data</span>(queries, draft, target, guard):</span>
<span class="cs-line hl-c">    <span class="cmt"># 1. Sample responses from both models</span></span>
<span class="cs-line hl-c">    <span class="cmt">    (mix of benign + malicious queries)</span></span>
<span class="cs-line hl-c">    <span class="cmt"># 2. Segment into reasoning steps by newlines</span></span>
<span class="cs-line hl-c">    <span class="cmt"># 3. Build cumulative prefix u_t = s1⊕…⊕st</span></span>
<span class="cs-line hl-c">    <span class="cmt"># 4. Label with Qwen3Guard-Gen-8B:</span></span>
<span class="cs-line hl-c">    <span class="cmt">    y=1 → safe prefix, y=0 → unsafe prefix</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Loss: binary cross-entropy on frozen backbone</span>
<span class="cs-line">L = -(<span class="num">1</span>/N) * sum(</span>
<span class="cs-line">    y*log(s) + (<span class="num">1</span>-y)*log(<span class="num">1</span>-s)</span>
<span class="cs-line">    <span class="kw">for</span> y, s <span class="kw">in</span> zip(labels, scores)</span>
<span class="cs-line">)</span>

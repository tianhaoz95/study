      <pre class="cs-pre">
<span class="cs-line cmt"># Rollback-and-reflect recovery</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">safety_mode</span>(target, draft, x_n_minus1, K, tau_s):</span>
<span class="cs-line hl-p">    <span class="str">"""Called when S_safe &lt; tau_s at step n"""</span></span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="cmt"># Step 1: Rollback to previous safe context</span></span>
<span class="cs-line hl-c">    context = x_n_minus1  <span class="cmt"># discard corrupted x_n</span></span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="cmt"># Step 2: Insert reflection prompt</span></span>
<span class="cs-line hl-a">    P_reflect = (</span>
<span class="cs-line hl-a">        <span class="str">"Wait. Let me reconsider whether I should "</span></span>
<span class="cs-line hl-a">        <span class="str">"respond to this request and how to do so "</span></span>
<span class="cs-line hl-a">        <span class="str">"safely and helpfully..."</span></span>
<span class="cs-line hl-a">    )</span>
<span class="cs-line hl-a">    context_with_reflect = context + P_reflect</span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="cmt"># Step 3: Multi-sample K candidates</span></span>
<span class="cs-line">    candidates = [</span>
<span class="cs-line">        draft.<span class="fn">generate_segment</span>(context_with_reflect)</span>
<span class="cs-line">        <span class="kw">for</span> _ <span class="kw">in</span> range(K)</span>
<span class="cs-line">    ]</span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="cmt"># Verify all candidates for safety</span></span>
<span class="cs-line">    scores = [<span class="fn">verify_safety</span>(target, context, c)</span>
<span class="cs-line">              <span class="kw">for</span> c <span class="kw">in</span> candidates]</span>
<span class="cs-line"> </span>
<span class="cs-line hl-g">    <span class="cmt"># Select the safest candidate</span></span>
<span class="cs-line hl-g">    best = candidates[scores.<span class="fn">argmax</span>()]</span>
<span class="cs-line hl-g">    <span class="kw">return</span> context_with_reflect + best</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># K=20 is the default; at K=20 with reflection,</span>
<span class="cs-line cmt"># P(recovery) ≈ 99.7% for p_safe=0.25</span>

  <!-- Arrow to draft -->
  <line x1="140" y1="100" x2="175" y2="100" stroke="#4b5563" stroke-width="1.5" marker-end="url(#arr)"/>

  <!-- Draft model -->
  <rect x="175" y="60" width="130" height="80" rx="6" fill="rgba(6,182,212,.08)" stroke="rgba(6,182,212,.3)" stroke-width="1"/>
  <text x="240" y="90" text-anchor="middle" fill="#06b6d4" font-size="9" font-weight="700" letter-spacing=".05em">DRAFT MODEL</text>
  <text x="240" y="106" text-anchor="middle" fill="#6b7280" font-size="8">Qwen3-1.7B</text>

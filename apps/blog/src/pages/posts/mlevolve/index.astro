/* ── Data table ── */
.results-table{width:100%;border-collapse:collapse;margin:1.5rem 0;border-radius:8px;overflow:hidden;font-size:.8rem}
.results-table th{background:var(--surface);padding:.5rem .75rem;text-align:left;font-size:.67rem;font-weight:600;letter-spacing:.07em;text-transform:uppercase;color:var(--muted);border-bottom:1px solid var(--border)}
.results-table td{padding:.5rem .75rem;border-bottom:1px solid var(--border);color:var(--muted2)}
.results-table tr:last-child td{border-bottom:none}
.results-table tr:hover td{background:rgba(255,255,255,.018)}
.results-table .mn{font-family:var(--ff-mono);font-size:.75rem;color:var(--text2)}
.results-table .highlight-row td{background:rgba(139,92,246,.06)}
.results-table .highlight-row .mn{color:var(--purple-l)}
.results-table .best{color:var(--cyan);font-weight:700}

/* ── Slider ── */
.slider-row{display:flex;align-items:center;gap:.75rem;margin:.75rem 0}
.slider-row label{font-size:.72rem;font-family:var(--ff-mono);color:var(--muted2);flex-shrink:0}
.slider-row input[type=range]{flex:1;accent-color:var(--purple)}
.slider-val{font-size:.72rem;font-family:var(--ff-mono);color:var(--purple-l);width:40px;text-align:right;flex-shrink:0}

/* ── Responsive ── */
@media(max-width:1100px){
  .post-grid{grid-template-columns:1fr}

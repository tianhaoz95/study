function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ── IntersectionObserver for TOC + sidebar sync ──
const sectionMap = {
  's-isolation': 'isolation',
  's-mcgs':      'mcgs',
  's-entropy':   'schedule',
  's-memory':    'memory',
  's-codegen':   'codegen',
  's-results':   'results',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ── §01 Branch isolation canvas ──
let branchMode = 'mcts';
function setBranchMode(mode) {
  branchMode = mode;
  document.getElementById('btn-mcts').classList.toggle('active', mode === 'mcts');
  document.getElementById('btn-mcgs').classList.toggle('active', mode === 'mcgs');
  drawBranchCanvas();
}

function drawBranchCanvas() {
  const canvas = document.getElementById('branch-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth;
  const H = 300;
  canvas.width = W * DPR;
  canvas.height = H * DPR;
  ctx.scale(DPR, DPR);
  ctx.clearRect(0, 0, W, H);

  // Branch x-positions
  const bx = [W*0.13, W*0.38, W*0.62, W*0.87];
  const branchColors = ['#8b5cf6', '#06b6d4', '#f59e0b', '#ef4444'];
  const stagnated = [false, false, true, true];
  const bNames = ['Branch A\n(Image CNN)', 'Branch B\n(ViT)', 'Branch C\n(Ensemble)', 'Branch D\n(XGBoost)'];
  const bNodes = [
    [0.73, 0.79, 0.82, 0.847],
    [0.71, 0.78, 0.83],
    [0.69, 0.74, 0.77],
    [0.70, 0.73, 0.76],
  ];

  function qToY(q) { return H - 28 - (q - 0.65) / 0.27 * (H - 56); }

  function dashedArrow(x1, y1, x2, y2, color) {
    ctx.save();
    ctx.strokeStyle = color;
    ctx.lineWidth = 1.8;
    ctx.setLineDash([5, 3]);
    ctx.beginPath(); ctx.moveTo(x1, y1); ctx.lineTo(x2, y2); ctx.stroke();
    ctx.setLineDash([]);
    const ang = Math.atan2(y2-y1, x2-x1);
    ctx.fillStyle = color;
    ctx.beginPath();
    ctx.moveTo(x2, y2);
    ctx.lineTo(x2 - 9*Math.cos(ang-0.45), y2 - 9*Math.sin(ang-0.45));
    ctx.lineTo(x2 - 9*Math.cos(ang+0.45), y2 - 9*Math.sin(ang+0.45));
    ctx.closePath(); ctx.fill();
    ctx.restore();
  }

  // Draw branches
  for (let b = 0; b < 4; b++) {
    const x = bx[b];
    const isStag = stagnated[b];
    // Vertical guide
    ctx.strokeStyle = isStag && branchMode === 'mcts' ? 'rgba(239,68,68,.18)' : 'rgba(255,255,255,.08)';
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(x, H-22); ctx.lineTo(x, 14); ctx.stroke();

    // Connect consecutive nodes
    for (let i = 0; i < bNodes[b].length - 1; i++) {
      ctx.strokeStyle = isStag ? 'rgba(239,68,68,.25)' : 'rgba(255,255,255,.18)';
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.moveTo(x, qToY(bNodes[b][i]));
      ctx.lineTo(x, qToY(bNodes[b][i+1]));
      ctx.stroke();
    }

    // Nodes
    for (let i = 0; i < bNodes[b].length; i++) {
      const y = qToY(bNodes[b][i]);
      const isTop = i === bNodes[b].length - 1;
      const r = isTop ? 9 : 5;
      ctx.beginPath(); ctx.arc(x, y, r, 0, Math.PI*2);
      if (isTop) {
        let fc = branchColors[b];
        if (isStag && branchMode === 'mcts') fc = 'rgba(239,68,68,.85)';
        ctx.shadowColor = fc; ctx.shadowBlur = isTop ? 12 : 0;
        ctx.fillStyle = fc;
      } else {
        ctx.fillStyle = 'rgba(255,255,255,.25)';
        ctx.shadowBlur = 0;
      }
      ctx.fill(); ctx.shadowBlur = 0;

      // Score on top node
      if (isTop) {
        ctx.fillStyle = '#f0f0f8';
        ctx.font = '10px var(--ff-mono, monospace)';
        ctx.textAlign = 'center';
        ctx.fillText(bNodes[b][i].toFixed(3), x, y - 15);
      }
    }

    // Branch label at bottom
    ctx.fillStyle = isStag && branchMode === 'mcts' ? 'rgba(239,68,68,.6)' : 'rgba(255,255,255,.45)';
    ctx.font = '9px var(--ff-mono, monospace)';
    ctx.textAlign = 'center';
    const lines = bNames[b].split('\n');
    ctx.fillText(lines[0], x, H-12);

    // Stagnation label (MCTS only)
    if (isStag && branchMode === 'mcts') {
      const ty = qToY(bNodes[b][bNodes[b].length-1]);
      ctx.fillStyle = 'rgba(239,68,68,.85)';
      ctx.font = 'bold 8.5px var(--ff-mono, monospace)';
      ctx.textAlign = 'center';
      ctx.fillText('STAGNATED', x, ty + 24);
    }
  }

  if (branchMode === 'mcts') {
    // Draw isolation barrier
    const midX = (bx[1] + bx[2]) / 2;
    ctx.strokeStyle = 'rgba(239,68,68,.45)';
    ctx.lineWidth = 1.5;
    const y1 = 40, y2 = H - 40;
    ctx.beginPath(); ctx.moveTo(midX-8, y1); ctx.lineTo(midX+8, y2); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(midX+8, y1); ctx.lineTo(midX-8, y2); ctx.stroke();
    ctx.fillStyle = 'rgba(239,68,68,.55)';
    ctx.font = 'bold 8px var(--ff-mono, monospace)';
    ctx.textAlign = 'center';
    ctx.fillText('NO SHARING', midX, H/2 + 4);
  } else {
    // MCGS: draw reference edges
    // C ← A's best
    const yA = qToY(0.847);
    const yC = qToY(0.77);
    dashedArrow(bx[0], yA, bx[2], yC, '#06b6d4');
    ctx.fillStyle = 'rgba(6,182,212,.8)';
    ctx.font = '8.5px var(--ff-mono, monospace)';
    ctx.textAlign = 'center';
    ctx.fillText('cross-branch ref', (bx[0]+bx[2])/2, qToY(0.81) - 8);

    // D ← B's best
    const yB = qToY(0.83);
    const yD = qToY(0.76);
    dashedArrow(bx[1], yB, bx[3], yD, '#8b5cf6');
    ctx.fillStyle = 'rgba(139,92,246,.8)';
    ctx.textAlign = 'center';
    ctx.fillText('cross-branch ref', (bx[1]+bx[3])/2, qToY(0.765) - 8);

    // Labels on C and D
    for (const bi of [2, 3]) {
      const yT = qToY(bNodes[bi][bNodes[bi].length-1]);
      ctx.fillStyle = 'rgba(16,185,129,.85)';
      ctx.font = 'bold 8px var(--ff-mono, monospace)';
      ctx.textAlign = 'center';
      ctx.fillText('receiving context', bx[bi], yT + 24);
    }
  }

  // Mode label
  ctx.fillStyle = branchMode === 'mcts' ? 'rgba(239,68,68,.55)' : 'rgba(16,185,129,.55)';
  ctx.font = 'bold 9px var(--ff-mono, monospace)';
  ctx.textAlign = 'left';
  ctx.fillText(branchMode === 'mcts' ? '● MCTS — isolated branches' : '● MCGS — reference edges active', 10, 14);
}

// Init branch canvas on load + resize
window.addEventListener('load', drawBranchCanvas);
window.addEventListener('resize', drawBranchCanvas);
// Make setBranchMode global
window.setBranchMode = setBranchMode;

// ── §03 Entropy dynamics canvas ──
function mlevolveEff(t) {
  // Smooth decrease: 4.8 → 2.8 using ease-out
  const e = 1 - Math.pow(1-t, 1.5);
  return 4.8 - 2.0 * e;
}
function mctsEff(t) {
  // Slight initial drop then plateau
  return 4.3 + 0.5 * Math.exp(-6 * t);
}

function drawEntropyCanvas(cursorT) {
  const canvas = document.getElementById('entropy-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth;
  const H = 260;
  canvas.width = W * DPR;
  canvas.height = H * DPR;
  ctx.scale(DPR, DPR);
  ctx.clearRect(0, 0, W, H);

  const PAD = { l: 48, r: 24, t: 20, b: 40 };
  const PW = W - PAD.l - PAD.r;
  const PH = H - PAD.t - PAD.b;
  const YMIN = 1.5, YMAX = 5.5;
  function tx(t) { return PAD.l + t * PW; }
  function ty(v) { return PAD.t + (1 - (v-YMIN)/(YMAX-YMIN)) * PH; }

  // Grid
  ctx.strokeStyle = 'rgba(255,255,255,.05)';
  ctx.lineWidth = 1;
  for (let y = 2; y <= 5; y++) {
    ctx.beginPath(); ctx.moveTo(PAD.l, ty(y)); ctx.lineTo(PAD.l+PW, ty(y)); ctx.stroke();
    ctx.fillStyle = 'rgba(255,255,255,.3)';
    ctx.font = '9px var(--ff-mono, monospace)';
    ctx.textAlign = 'right';
    ctx.fillText(y.toFixed(0), PAD.l-6, ty(y)+3);
  }
  // X ticks
  for (let t = 0; t <= 1; t += 0.25) {
    const x = tx(t);
    ctx.beginPath(); ctx.strokeStyle = 'rgba(255,255,255,.05)';
    ctx.moveTo(x, PAD.t); ctx.lineTo(x, PAD.t+PH); ctx.stroke();
    ctx.fillStyle = 'rgba(255,255,255,.3)';
    ctx.font = '9px var(--ff-mono, monospace)';
    ctx.textAlign = 'center';
    ctx.fillText((t*100).toFixed(0)+'%', x, PAD.t+PH+16);
  }

  // Axis labels
  ctx.fillStyle = '#6b7280';
  ctx.font = '9px var(--ff-mono, monospace)';
  ctx.textAlign = 'center';
  ctx.fillText('Search Progress t/T', PAD.l + PW/2, H-2);
  ctx.save(); ctx.translate(12, PAD.t + PH/2); ctx.rotate(-Math.PI/2);
  ctx.fillText('exp(H(π_t))', 0, 0); ctx.restore();

  // MLEvolve line (purple)
  ctx.beginPath(); ctx.strokeStyle = '#8b5cf6'; ctx.lineWidth = 2.5;
  for (let i = 0; i <= 100; i++) {
    const t = i/100, v = mlevolveEff(t);
    if (i === 0) ctx.moveTo(tx(t), ty(v)); else ctx.lineTo(tx(t), ty(v));
  }
  ctx.stroke();

  // Vanilla MCTS line (grey)
  ctx.beginPath(); ctx.strokeStyle = '#6b7280'; ctx.lineWidth = 2;
  ctx.setLineDash([4,3]);
  for (let i = 0; i <= 100; i++) {
    const t = i/100, v = mctsEff(t);
    if (i === 0) ctx.moveTo(tx(t), ty(v)); else ctx.lineTo(tx(t), ty(v));
  }
  ctx.stroke(); ctx.setLineDash([]);

  // Cursor at cursorT
  if (cursorT !== null) {
    const cx = tx(cursorT);
    ctx.strokeStyle = 'rgba(255,255,255,.25)';
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(cx, PAD.t); ctx.lineTo(cx, PAD.t+PH); ctx.stroke();
    // Dots at cursor
    const vm = mlevolveEff(cursorT);
    const vv = mctsEff(cursorT);
    ctx.beginPath(); ctx.arc(cx, ty(vm), 5, 0, Math.PI*2);
    ctx.fillStyle = '#8b5cf6'; ctx.fill();
    ctx.beginPath(); ctx.arc(cx, ty(vv), 5, 0, Math.PI*2);
    ctx.fillStyle = '#6b7280'; ctx.fill();
    // Update labels
    document.getElementById('eff-mlevolve').textContent = vm.toFixed(2);
    document.getElementById('eff-mcts').textContent = vv.toFixed(2);
  }

  // Region labels
  ctx.fillStyle = 'rgba(139,92,246,.5)';
  ctx.font = '8px var(--ff-mono, monospace)';
  ctx.textAlign = 'left';
  ctx.fillText('← Exploration', tx(0.05), PAD.t+14);
  ctx.textAlign = 'right';
  ctx.fillText('Exploitation →', tx(0.95), ty(2.2));

  // Value labels at end
  ctx.fillStyle = '#8b5cf6';
  ctx.font = 'bold 9px var(--ff-mono, monospace)';
  ctx.textAlign = 'left';
  ctx.fillText('MLEvolve: 2.8', tx(1)+2, ty(mlevolveEff(1))+3);
  ctx.fillStyle = '#6b7280';
  ctx.fillText('MCTS: ~4.3', tx(0.85), ty(mctsEff(1))-8);
}

const entropySlider = document.getElementById('entropy-slider');
const entropyVal    = document.getElementById('entropy-val');
entropySlider?.addEventListener('input', () => {
  const t = parseFloat(entropySlider.value) / 100;
  entropyVal.textContent = (t*100).toFixed(0)+'%';
  drawEntropyCanvas(t);
});
window.addEventListener('load', () => drawEntropyCanvas(0));
window.addEventListener('resize', () => drawEntropyCanvas(parseFloat((entropySlider?.value||0))/100));

// ── §06 Beat ratio canvas ──
function drawBeatCanvas() {
  const canvas = document.getElementById('beat-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth;
  const H = 220;
  canvas.width = W * DPR;
  canvas.height = H * DPR;
  ctx.scale(DPR, DPR);
  ctx.clearRect(0, 0, W, H);

  const PAD = { l: 52, r: 24, t: 20, b: 40 };
  const PW = W - PAD.l - PAD.r;
  const PH = H - PAD.t - PAD.b;
  const YMIN = 0, YMAX = 100;
  function tx(h) { return PAD.l + (h/12) * PW; }
  function ty(v) { return PAD.t + (1 - (v-YMIN)/(YMAX-YMIN)) * PH; }

  // Grid
  ctx.strokeStyle = 'rgba(255,255,255,.05)';
  ctx.lineWidth = 1;
  for (let y = 0; y <= 100; y += 20) {
    ctx.beginPath(); ctx.moveTo(PAD.l, ty(y)); ctx.lineTo(PAD.l+PW, ty(y)); ctx.stroke();
    ctx.fillStyle = 'rgba(255,255,255,.3)';
    ctx.font = '9px var(--ff-mono, monospace)';
    ctx.textAlign = 'right';
    ctx.fillText(y+'%', PAD.l-5, ty(y)+3);
  }
  for (let h = 0; h <= 12; h += 2) {
    const x = tx(h);
    ctx.beginPath(); ctx.strokeStyle = 'rgba(255,255,255,.05)';
    ctx.moveTo(x, PAD.t); ctx.lineTo(x, PAD.t+PH); ctx.stroke();
    ctx.fillStyle = 'rgba(255,255,255,.3)';
    ctx.font = '9px var(--ff-mono, monospace)';
    ctx.textAlign = 'center';
    ctx.fillText(h+'h', x, PAD.t+PH+16);
  }

  // Axis labels
  ctx.fillStyle = '#6b7280';
  ctx.font = '9px var(--ff-mono, monospace)';
  ctx.textAlign = 'center';
  ctx.fillText('Time (hours)', PAD.l + PW/2, H-2);
  ctx.save(); ctx.translate(12, PAD.t + PH/2); ctx.rotate(-Math.PI/2);
  ctx.fillText('Beat Ratio (%)', 0, 0); ctx.restore();

  // Seeded point generation for MLEvolve (smooth S-curve)
  function mlevolveBeat(h) {
    // Starts fast, continues improving: 0→98.2
    return 98.2 * (1 - Math.exp(-h * 0.55)) + (h > 8 ? 3*(1-Math.exp(-(h-8)*0.8)) : 0);
  }
  function mctsbeat(h) {
    // Fast rise then plateau ~70.7
    return Math.min(70.7, 78 * (1 - Math.exp(-h * 0.7)));
  }

  // MLEvolve fill
  ctx.beginPath();
  ctx.moveTo(tx(0), ty(0));
  for (let i = 0; i <= 120; i++) {
    const h = i/10;
    ctx.lineTo(tx(h), ty(Math.min(100, mlevolveBeat(h))));
  }
  ctx.lineTo(tx(12), ty(0)); ctx.closePath();
  ctx.fillStyle = 'rgba(139,92,246,.08)'; ctx.fill();

  // MLEvolve line
  ctx.beginPath(); ctx.strokeStyle = '#8b5cf6'; ctx.lineWidth = 2.5;
  for (let i = 0; i <= 120; i++) {
    const h = i/10;
    const v = Math.min(98.2, mlevolveBeat(h));
    if (i === 0) ctx.moveTo(tx(h), ty(v)); else ctx.lineTo(tx(h), ty(v));
  }
  ctx.stroke();

  // MCTS line (dashed)
  ctx.beginPath(); ctx.strokeStyle = '#6b7280'; ctx.lineWidth = 2;
  ctx.setLineDash([4,3]);
  for (let i = 0; i <= 120; i++) {
    const h = i/10;
    const v = mctsbeat(h);
    if (i === 0) ctx.moveTo(tx(h), ty(v)); else ctx.lineTo(tx(h), ty(v));
  }
  ctx.stroke(); ctx.setLineDash([]);

  // End labels
  ctx.fillStyle = '#8b5cf6'; ctx.font = 'bold 10px var(--ff-mono, monospace)';
  ctx.textAlign = 'left';
  ctx.fillText('MLEvolve: 98.2%', tx(12)+2, ty(98.2)+4);
  ctx.fillStyle = '#6b7280';
  ctx.fillText('Vanilla MCTS: 70.7%', tx(8), ty(70.7)-10);

  // Plateau annotation
  ctx.strokeStyle = 'rgba(107,114,128,.35)'; ctx.lineWidth = 1;
  ctx.setLineDash([3,2]);
  ctx.beginPath(); ctx.moveTo(tx(4), ty(70.7)); ctx.lineTo(tx(12), ty(70.7)); ctx.stroke();
  ctx.setLineDash([]);
  ctx.fillStyle = 'rgba(107,114,128,.5)'; ctx.font = '8px var(--ff-mono, monospace)';
  ctx.textAlign = 'center';
  ctx.fillText('plateau', tx(8), ty(70.7)-2);
}

window.addEventListener('load', drawBeatCanvas);
window.addEventListener('resize', drawBeatCanvas);

// ── §06 Animated bar chart ──
const resultsSection = document.getElementById('s-results');
if (resultsSection) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          b.style.width = b.dataset.w + '%';
        });
      }
    });
  }, { threshold: 0.2 }).observe(resultsSection);
}

// ── §05 Step navigator ──
let codegenStep = 0;
const stepBoxes = document.querySelectorAll('.step-box');
const stepPrev  = document.getElementById('step-prev');
const stepNext  = document.getElementById('step-next');
const stepProg  = document.getElementById('step-prog');
function updateSteps() {
  stepBoxes.forEach((b, i) => {
    b.classList.remove('active','done');
    if (i === codegenStep) b.classList.add('active');
    else if (i < codegenStep) b.classList.add('done');
  });
  if (stepPrev) stepPrev.disabled = codegenStep === 0;
  if (stepNext) stepNext.disabled = codegenStep === stepBoxes.length - 1;
  if (stepProg) stepProg.textContent = `Step ${codegenStep+1} of ${stepBoxes.length}`;
  stepBoxes.forEach((b, i) => {
    const n = b.querySelector('.step-num');
    if (n) n.textContent = i < codegenStep ? '✓' : String(i+1);
  });
}
stepPrev?.addEventListener('click', () => { if (codegenStep>0){codegenStep--;updateSteps();} });
stepNext?.addEventListener('click', () => { if (codegenStep<stepBoxes.length-1){codegenStep++;updateSteps();} });
updateSteps();
</script>
</BaseLayout>

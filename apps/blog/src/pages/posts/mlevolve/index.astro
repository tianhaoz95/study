<span class="cs-line cmt"># Progressive MCGS expansion types</span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">expand</span>(v_t, stagnation_level, t):</span>
<span class="cs-line">  <span class="kw">if</span> stagnation_level == <span class="num">0</span>:</span>
<span class="cs-line cmt">    # Primary: parent only</span>
<span class="cs-line">    R = []</span>
<span class="cs-line"></span>
<span class="cs-line">  <span class="kw">elif</span> stagnation_level == <span class="num">1</span>:</span>
<span class="cs-line hl-c">    <span class="cmt"># Intra-branch: recent history</span></span>
<span class="cs-line hl-c">    R = <span class="fn">branch_history</span>(v_t, k=<span class="num">3</span>)</span>
<span class="cs-line"></span>
<span class="cs-line">  <span class="kw">elif</span> stagnation_level == <span class="num">2</span>:</span>
<span class="cs-line hl-a">    <span class="cmt"># Cross-branch: other branches' tops</span></span>
<span class="cs-line hl-a">    R = <span class="fn">top_nodes_other_branches</span>(N=<span class="num">3</span>)</span>
<span class="cs-line"></span>
<span class="cs-line">  <span class="kw">else</span>:</span>
<span class="cs-line hl-g">    <span class="cmt"># Multi-branch aggregation</span></span>
<span class="cs-line hl-g">    R = <span class="fn">all_branch_trajectories</span>()</span>
<span class="cs-line hl-g">    <span class="cmt"># Creates new branch root</span></span>
<span class="cs-line"></span>
<span class="cs-line">  v_new = <span class="cls">LLM</span>.<span class="fn">generate</span>(v_t.code, R)</span>
<span class="cs-line cmt">  # Primary edge: tree backbone</span>
<span class="cs-line">  <span class="fn">add_edge</span>(v_t, v_new, <span class="attr">type</span>=<span class="str">'primary'</span>)</span>
<span class="cs-line cmt">  # Reference edges: info only</span>
<span class="cs-line">  <span class="kw">for</span> r <span class="kw">in</span> R:</span>
<span class="cs-line">    <span class="fn">add_edge</span>(r, v_new, <span class="attr">type</span>=<span class="str">'ref'</span>)</span>
<span class="cs-line">  <span class="kw">return</span> v_new</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Backprop: primary edges only</span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">backprop</span>(v, reward):</span>
<span class="cs-line">  <span class="kw">for</span> u <span class="kw">in</span> <span class="fn">ancestors_via_ET</span>(v):</span>
<span class="cs-line">    u.N += <span class="num">1</span>; u.W += reward</span>
<span class="cs-line">    u.Q = u.W / (u.N + ε)</span>
      </pre>
    </div>

    <!-- panel: schedule -->
    <div class="cs-panel" id="panel-schedule">
      <pre class="cs-pre">
<span class="cs-line cmt"># Entropy-inspired progressive schedule</span>
<span class="cs-line cmt"># w(t): UCT probability over search time</span>
<span class="cs-line cmt">#  w(0) = 1.0  → pure exploration</span>
<span class="cs-line cmt">#  w(T) = w_min → mostly exploitation</span>
<span class="cs-line"></span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">select_strategy</span>(t, T):</span>
<span class="cs-line hl-p">  w = <span class="fn">schedule</span>(t / T)  <span class="cmt"># 1.0 → w_min</span></span>
<span class="cs-line">  <span class="kw">if</span> <span class="fn">random</span>() &lt; w:</span>
<span class="cs-line hl-c">    <span class="kw">return</span> <span class="fn">uct_select</span>(root)</span>
<span class="cs-line">  <span class="kw">else</span>:</span>
<span class="cs-line hl-g">    <span class="kw">return</span> <span class="fn">elite_select</span>(top_K=<span class="num">5</span>)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Elite-Guided: weighted by inverse rank</span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">elite_select</span>(top_K):</span>
<span class="cs-line">  elite = <span class="fn">sorted_by_metric</span>()[:top_K]</span>
<span class="cs-line">  <span class="cmt"># P(v_i) ∝ 1 / rank(v_i)</span></span>
<span class="cs-line">  weights = [<span class="num">1</span>/(<span class="num">1</span>+i) <span class="kw">for</span> i <span class="kw">in</span> <span class="fn">range</span>(top_K)]</span>
<span class="cs-line">  <span class="kw">return</span> <span class="fn">sample</span>(elite, weights)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Empirical entropy dynamics:</span>
<span class="cs-line cmt"># H(π_t) = -Σ π_t(i) log π_t(i)</span>
<span class="cs-line cmt"># exp(H(π_t)) = effective #branches</span>
<span class="cs-line cmt">#</span>
<span class="cs-line cmt"># MLEvolve: 4.8 → 2.8 (converges)</span>
<span class="cs-line cmt"># Vanilla MCTS: ~4.3 (flat)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># UCT criterion (tree backbone only):</span>
<span class="cs-line cmt"># UCT(i) = Q_i + c(t) * sqrt(</span>
<span class="cs-line cmt">#             ln(N_v+1) / (N_i+ε) )</span>
<span class="cs-line cmt"># c(t): gradually decays c0 → c_min</span>
      </pre>

<span class="cs-line">      <span class="str">'plan'</span>:     node.plan,</span>
<span class="cs-line">      <span class="str">'code'</span>:     node.code,</span>
<span class="cs-line">      <span class="str">'metric'</span>:   node.metric,</span>
<span class="cs-line">      <span class="str">'analysis'</span>: node.analysis,</span>
<span class="cs-line">    &#125;)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Stage-specific retrieval:</span>
<span class="cs-line cmt"># Planning: query=plan draft</span>
<span class="cs-line cmt">#   → returns: successes + failures</span>

<script>
// ─── TOC + sidebar toggles ───────────────────────────────────────────────────
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});
const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ─── Code sidebar tabs ────────────────────────────────────────────────────────
const tabMeta = {
  problem:      { file: 'r2lm/dilemma.py',      title: 'The Dilemma' },
  background:   { file: 'r2lm/mdlm.py',          title: 'dLLM Background' },
  architecture: { file: 'r2lm/model.py',          title: 'R2LM Architecture' },
  mechanism:    { file: 'r2lm/r2l_stream.py',     title: 'The R2L Stream' },
  throughput:   { file: 'r2lm/throughput.py',     title: 'Throughput' },
  results:      { file: 'r2lm/results.py',        title: 'Quality Results' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ─── IntersectionObserver — TOC + sidebar sync ───────────────────────────────
const sectionMap = {
  's-problem':      'problem',
  's-background':   'background',
  's-architecture': 'architecture',
  's-mechanism':    'mechanism',
  's-throughput':   'throughput',
  's-results':      'results',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ─── Attention pattern mini-canvases ──────────────────────────────────────────
function drawAttentionGrid(canvasId, mode) {
  const canvas = document.getElementById(canvasId);
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const N = 6;
  const W = canvas.clientWidth || 160;
  const H = canvas.clientHeight || 100;
  const DPR = window.devicePixelRatio || 1;
  canvas.width = W * DPR; canvas.height = H * DPR;
  ctx.scale(DPR, DPR);

  const cellW = W / (N + 1.5);
  const cellH = H / (N + 1.5);
  const pad = cellW * 0.5;

  // draw N×N grid cells
  for (let row = 0; row < N; row++) {
    for (let col = 0; col < N; col++) {
      let fill = 'rgba(255,255,255,0.03)';
      if (mode === 'bidir') {
        fill = 'rgba(245,158,11,0.35)';
      } else if (mode === 'causal') {
        if (col <= row) fill = 'rgba(6,182,212,0.35)';
        else fill = 'rgba(255,255,255,0.03)';
      } else if (mode === 'bifocal') {
        if (col <= row) fill = 'rgba(6,182,212,0.30)';
        else fill = 'rgba(139,92,246,0.25)';  // right context via SSM
      }
      const x = pad + col * cellW;
      const y = pad + row * cellH;
      ctx.fillStyle = fill;
      ctx.fillRect(x + 1, y + 1, cellW - 2, cellH - 2);
    }
  }
  // label
  const labels = ['T','c','s','_','t','m'];
  ctx.font = `${Math.round(cellW * 0.45)}px monospace`;
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  for (let i = 0; i < N; i++) {
    ctx.fillStyle = '#6b7280';
    ctx.fillText(labels[i], pad + i * cellW + cellW / 2, pad / 2);
    ctx.fillText(labels[i], pad / 2, pad + i * cellH + cellH / 2);
  }
}
drawAttentionGrid('canvas-bidir', 'bidir');
drawAttentionGrid('canvas-causal', 'causal');
drawAttentionGrid('canvas-bifocal', 'bifocal');

// ─── Right-context gap canvas ─────────────────────────────────────────────────
const SENTENCES = [
  // [tokens, masked positions, description]
  { tokens: ['The', 'cat', 'sat', '[M]', 'the', 'mat', '.'], masked: [3], pos: 3, correct: 'on', wrong: 'near/by/...' },
  { tokens: ['[M]', 'cat', 'sat', 'on', 'the', 'mat', '.'], masked: [0], pos: 0, correct: 'The/A', wrong: 'My/One/...' },
  { tokens: ['The', 'cat', 'sat', 'on', 'the', '[M]', '.'], masked: [5], pos: 5, correct: 'mat', wrong: '???' },
];
let gapStep = 0;

function setGapStep(i) {
  gapStep = i;
  ['btn-step-0','btn-step-1','btn-step-2'].forEach((id, j) => {
    document.getElementById(id)?.classList.toggle('active', j === i);
  });
  drawGapCanvas(gapStep);
}

function drawGapCanvas(stepIdx) {
  const canvas = document.getElementById('gap-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const W = canvas.clientWidth || 580;
  const H = 160;
  const DPR = window.devicePixelRatio || 1;
  canvas.width = W * DPR; canvas.height = H * DPR;
  ctx.scale(DPR, DPR);
  ctx.clearRect(0, 0, W, H);

  const s = SENTENCES[stepIdx];
  const N = s.tokens.length;
  const tokenW = Math.min(62, (W - 40) / N);
  const startX = (W - tokenW * N) / 2;
  const tokenY = 28;
  const tokenH = 30;

  // Draw tokens
  s.tokens.forEach((tok, i) => {
    const x = startX + i * tokenW;
    const isMasked = s.masked.includes(i);
    ctx.fillStyle = isMasked ? '#8b5cf6' : '#1a1a2e';
    ctx.strokeStyle = isMasked ? '#a78bfa' : '#374151';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.roundRect(x + 2, tokenY, tokenW - 4, tokenH, 4);
    ctx.fill(); ctx.stroke();
    ctx.fillStyle = isMasked ? '#fff' : '#e5c07b';
    ctx.font = `${Math.min(11, tokenW * 0.18)}px monospace`;
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText(tok, x + tokenW / 2, tokenY + tokenH / 2);
  });

  // Left context bracket
  const leftEnd = s.pos - 1;
  if (leftEnd >= 0) {
    const lx1 = startX + 2;
    const lx2 = startX + leftEnd * tokenW + tokenW - 2;
    ctx.strokeStyle = 'rgba(6,182,212,0.6)';
    ctx.lineWidth = 1.5;
    ctx.setLineDash([]);
    ctx.beginPath();
    ctx.moveTo(lx1, tokenY + tokenH + 8);
    ctx.lineTo(lx2, tokenY + tokenH + 8);
    ctx.stroke();
    ctx.beginPath();
    ctx.moveTo(lx1, tokenY + tokenH + 4);
    ctx.lineTo(lx1, tokenY + tokenH + 12);
    ctx.stroke();
    ctx.beginPath();
    ctx.moveTo(lx2, tokenY + tokenH + 4);
    ctx.lineTo(lx2, tokenY + tokenH + 12);
    ctx.stroke();
    ctx.fillStyle = '#06b6d4';
    ctx.font = '10px monospace';
    ctx.textAlign = 'center';
    ctx.fillText('causal (left only)', (lx1 + lx2) / 2, tokenY + tokenH + 22);
  }

  // Right context bracket
  const rightStart = s.pos + 1;
  if (rightStart < N) {
    const rx1 = startX + rightStart * tokenW + 2;
    const rx2 = startX + (N - 1) * tokenW + tokenW - 2;
    ctx.strokeStyle = 'rgba(139,92,246,0.6)';
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(rx1, tokenY + tokenH + 8);
    ctx.lineTo(rx2, tokenY + tokenH + 8);
    ctx.stroke();
    ctx.beginPath();
    ctx.moveTo(rx1, tokenY + tokenH + 4);
    ctx.lineTo(rx1, tokenY + tokenH + 12);
    ctx.stroke();
    ctx.beginPath();
    ctx.moveTo(rx2, tokenY + tokenH + 4);
    ctx.lineTo(rx2, tokenY + tokenH + 12);
    ctx.stroke();
    ctx.fillStyle = '#a78bfa';
    ctx.font = '10px monospace';
    ctx.textAlign = 'center';
    ctx.fillText('R2L sidecar (right ctx)', (rx1 + rx2) / 2, tokenY + tokenH + 22);
  }

  // Labels at bottom
  ctx.font = '11px monospace';
  ctx.textAlign = 'left';
  ctx.fillStyle = '#06b6d4';
  ctx.fillText('Causal sees: ' + s.tokens.slice(0, s.pos).join(' '), 20, tokenY + tokenH + 45);
  ctx.fillStyle = '#a78bfa';
  ctx.fillText('R2L also sees: ' + s.tokens.slice(s.pos + 1).join(' '), 20, tokenY + tokenH + 60);
  ctx.fillStyle = '#10b981';
  ctx.fillText('Better prediction for position ' + s.pos, 20, tokenY + tokenH + 78);
}
drawGapCanvas(0);

// ─── Step navigator ───────────────────────────────────────────────────────────
let step = 0;
const boxes   = document.querySelectorAll('.step-box');
const prevBtn = document.getElementById('step-prev');
const nextBtn = document.getElementById('step-next');
const progEl  = document.getElementById('step-prog');
function updateSteps() {
  boxes.forEach((b, i) => {
    b.classList.remove('active', 'done');
    if (i === step) b.classList.add('active');
    else if (i < step) b.classList.add('done');
  });
  if (prevBtn) prevBtn.disabled = step === 0;
  if (nextBtn) nextBtn.disabled = step === boxes.length - 1;
  if (progEl) progEl.textContent = `Step ${step + 1} of ${boxes.length}`;
  boxes.forEach((b, i) => {
    const n = b.querySelector('.step-num');
    if (n) n.textContent = i < step ? '✓' : String(i + 1);
  });
}
prevBtn?.addEventListener('click', () => { if (step > 0) { step--; updateSteps(); } });
nextBtn?.addEventListener('click', () => { if (step < boxes.length - 1) { step++; updateSteps(); } });
updateSteps();

// ─── Throughput canvas ────────────────────────────────────────────────────────
const TP_DATA = {
  8: {
    prompts: [512, 1024, 2048, 4096],
    bidir:   [483, 260, 124, 53],
    causal:  [1356, 1295, 1050, 732],
    r2lm:    [1154, 1089, 956, 683],
  },
  1: {
    prompts: [512, 1024, 2048, 4096],
    bidir:   [246, 187, 106, 51],
    causal:  [171, 172, 167, 163],
    r2lm:    [147, 146, 145, 140],
  },
};
let tpBatch = 8;

function setThroughputBatch(b) {
  tpBatch = b;
  document.getElementById('btn-b8')?.classList.toggle('active', b === 8);
  document.getElementById('btn-b1')?.classList.toggle('active', b === 1);
  drawThroughput();
}

function drawThroughput() {
  const canvas = document.getElementById('tp-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const W = canvas.clientWidth || 580;
  const H = 260;
  const DPR = window.devicePixelRatio || 1;
  canvas.width = W * DPR; canvas.height = H * DPR;
  ctx.scale(DPR, DPR);
  ctx.clearRect(0, 0, W, H);

  const d = TP_DATA[tpBatch];
  const padL = 56, padR = 20, padT = 18, padB = 40;
  const chartW = W - padL - padR;
  const chartH = H - padT - padB;
  const maxY = tpBatch === 8 ? 1500 : 300;

  // Grid
  for (let i = 0; i <= 5; i++) {
    const y = padT + chartH - (i / 5) * chartH;
    ctx.strokeStyle = 'rgba(255,255,255,0.04)';
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(padL, y); ctx.lineTo(padL + chartW, y); ctx.stroke();
    ctx.fillStyle = '#6b7280';
    ctx.font = '10px monospace';
    ctx.textAlign = 'right';
    ctx.fillText(Math.round(maxY * i / 5), padL - 6, y + 4);
  }

  // X axis labels
  d.prompts.forEach((p, i) => {
    const x = padL + (i / (d.prompts.length - 1)) * chartW;
    ctx.fillStyle = '#6b7280';
    ctx.font = '10px monospace';
    ctx.textAlign = 'center';
    ctx.fillText('P=' + p, x, H - 8);
  });

  // Axis labels
  ctx.fillStyle = '#4b5563';
  ctx.font = '10px monospace';
  ctx.textAlign = 'center';
  ctx.fillText('tok/s', padL - 30, padT + chartH / 2);

  function drawLine(vals, color, label, labelOffsetY) {
    ctx.strokeStyle = color;
    ctx.lineWidth = 2;
    ctx.setLineDash([]);
    ctx.beginPath();
    vals.forEach((v, i) => {
      const x = padL + (i / (vals.length - 1)) * chartW;
      const y = padT + chartH - (v / maxY) * chartH;
      i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
    });
    ctx.stroke();
    // dots
    vals.forEach((v, i) => {
      const x = padL + (i / (vals.length - 1)) * chartW;
      const y = padT + chartH - (v / maxY) * chartH;
      ctx.fillStyle = color;
      ctx.beginPath(); ctx.arc(x, y, 3, 0, Math.PI * 2); ctx.fill();
    });
    // end label
    const lastX = padL + chartW;
    const lastY = padT + chartH - (vals[vals.length - 1] / maxY) * chartH;
    ctx.fillStyle = color;
    ctx.font = '10px monospace';
    ctx.textAlign = 'left';
    ctx.fillText(label, lastX - 60, lastY + labelOffsetY);
  }

  drawLine(d.causal, '#06b6d4', 'Causal', -8);
  drawLine(d.r2lm,   '#8b5cf6', 'R2LM',   2);
  drawLine(d.bidir,  '#f59e0b', 'Bidir',  10);

  // Speedup annotation at P=4096
  const bVal = d.bidir[3];
  const rVal = d.r2lm[3];
  const bY = padT + chartH - (bVal / maxY) * chartH;
  const rY = padT + chartH - (rVal / maxY) * chartH;
  const xAnn = padL + chartW - 80;
  ctx.strokeStyle = 'rgba(139,92,246,0.4)';
  ctx.lineWidth = 1;
  ctx.setLineDash([3, 3]);
  ctx.beginPath(); ctx.moveTo(xAnn, bY); ctx.lineTo(xAnn, rY); ctx.stroke();
  ctx.setLineDash([]);
  const speedup = (rVal / bVal).toFixed(1);
  ctx.fillStyle = '#a78bfa';
  ctx.font = 'bold 11px monospace';
  ctx.textAlign = 'right';
  ctx.fillText(speedup + '×', xAnn - 4, (bY + rY) / 2 + 4);
}
drawThroughput();

// ─── Animated bar chart ───────────────────────────────────────────────────────
const barsSection = document.getElementById('s-results');
if (barsSection) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          b.style.width = (parseFloat(b.dataset.w) / 55 * 100) + '%';
        });
      }
    });
  }, { threshold: 0.3 }).observe(barsSection);
}
</script>
</BaseLayout>

<span class="cs-line cmt"># The dLLM attention dilemma</span>
<span class="cs-line cmt"># Bidirectional: max quality, no KV cache</span>
<span class="cs-line cmt"># Causal: KV cached, no right context</span>
<span class="cs-line"></span>
<span class="cs-line hl-a"><span class="cmt"># Bidirectional dLLM cost per step</span></span>
<span class="cs-line">attn_cost = B * (P + G)**<span class="num">2</span>  <span class="cmt"># full seq</span></span>
<span class="cs-line hl-a"><span class="cmt"># every step recomputes everything!</span></span>
<span class="cs-line"></span>
<span class="cs-line hl-g"><span class="cmt"># Causal dLLM cost per step (cached)</span></span>
<span class="cs-line">attn_cost = B * G * (P + G)  <span class="cmt"># G-only</span></span>
<span class="cs-line hl-g"><span class="cmt"># prefix KV computed once, reused</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Right-context information gap</span>
<span class="cs-line cmt"># (information theory, Proposition 1)</span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">right_context_gap</span>(i, observed):</span>
<span class="cs-line hl-p">    <span class="cmt"># Δ = I(x_i ; x_right | x_left)</span></span>
<span class="cs-line hl-p">    right = observed[observed.pos &gt; i]</span>
<span class="cs-line hl-p">    <span class="kw">return</span> cond_mutual_info(x_i, right)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Gap largest at early positions,</span>
<span class="cs-line cmt"># vanishes at rightmost masked pos</span>
<span class="cs-line cmt"># Can't recover via causal tricks</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Throughput collapse: Bidir P=4096</span>
<span class="cs-line"><span class="cmt">#   483 tok/s (P=512)</span></span>
<span class="cs-line"><span class="cmt">#    53 tok/s (P=4096)  ← 9× slower!</span></span>
<span class="cs-line cmt"># R2LM: 1154 → 683 tok/s (stays flat)</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-background">
      <pre class="cs-pre">
<span class="cs-line cmt"># MDLM: Masked Diffusion LM</span>
<span class="cs-line cmt"># Forward: corrupt tokens to [MASK]</span>
<span class="cs-line cmt"># Reverse: denoise iteratively</span>
<span class="cs-line"></span>
<span class="cs-line hl-c"><span class="kw">def</span> <span class="fn">forward_process</span>(x, t):</span>
<span class="cs-line hl-c">    alpha_t = <span class="num">1</span> - t  <span class="cmt"># linear schedule</span></span>
<span class="cs-line hl-c">    mask = torch.rand_like(x.float())</span>
<span class="cs-line hl-c">    <span class="kw">return</span> torch.where(</span>
<span class="cs-line hl-c">        mask &lt; alpha_t, x, MASK_ID</span>
<span class="cs-line hl-c">    )</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># ELBO-weighted cross-entropy loss</span>
<span class="cs-line hl-g"><span class="kw">def</span> <span class="fn">mdlm_loss</span>(model, x):</span>
<span class="cs-line hl-g">    t = torch.<span class="fn">rand</span>(B).clamp(<span class="num">1e-4</span>, <span class="num">1-1e-4</span>)</span>
<span class="cs-line hl-g">    z_t = <span class="fn">forward_process</span>(x, t)</span>
<span class="cs-line hl-g">    w_t = <span class="num">1</span> / (<span class="num">1</span> - t)   <span class="cmt"># up-weight</span></span>
<span class="cs-line hl-g">    logits = <span class="fn">model</span>(z_t)</span>
<span class="cs-line hl-g">    <span class="kw">return</span> (w_t * <span class="fn">ce_loss</span>(logits, x,</span>
<span class="cs-line hl-g">                         mask=z_t == MASK_ID)).<span class="fn">mean</span>()</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Inference: start fully masked,</span>
<span class="cs-line cmt"># unmask highest-confidence positions</span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">generate</span>(model, prompt, G, T=<span class="num">32</span>):</span>
<span class="cs-line hl-p">    tokens = prompt + [MASK] * G</span>
<span class="cs-line hl-p">    <span class="kw">for</span> step <span class="kw">in</span> <span class="fn">range</span>(T):</span>
<span class="cs-line hl-p">        logits = <span class="fn">model</span>(tokens)</span>
<span class="cs-line hl-p">        conf = logits.<span class="fn">softmax</span>(-<span class="num">1</span>).<span class="fn">max</span>(-<span class="num">1</span>)</span>
<span class="cs-line hl-p">        unmask_top_k(tokens, conf, step)</span>
<span class="cs-line hl-p">    <span class="kw">return</span> tokens[<span class="fn">len</span>(prompt):]</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-architecture">
      <pre class="cs-pre">
<span class="cs-line cmt"># R2LM: attach R2L stream to every</span>
<span class="cs-line cmt"># k-th layer of the causal backbone</span>
<span class="cs-line"></span>
<span class="cs-line hl-c"><span class="kw">class</span> <span class="cls">R2LM</span>(nn.Module):</span>
<span class="cs-line hl-c">    <span class="kw">def</span> <span class="fn">__init__</span>(<span class="kw">self</span>, backbone, k=<span class="num">4</span>):</span>
<span class="cs-line hl-c">        <span class="kw">super</span>().<span class="fn">__init__</span>()</span>
<span class="cs-line hl-c">        <span class="kw">self</span>.backbone = backbone</span>
<span class="cs-line hl-c">        H = <span class="fn">len</span>(backbone.layers) // k</span>
<span class="cs-line hl-c">        <span class="kw">self</span>.r2l_hooks = nn.<span class="fn">ModuleList</span>([</span>
<span class="cs-line hl-c">            <span class="fn">ReverseMambaLayer</span>(backbone.d)</span>
<span class="cs-line hl-c">            <span class="kw">for</span> _ <span class="kw">in</span> <span class="fn">range</span>(H)  <span class="cmt"># H=7</span></span>
<span class="cs-line hl-c">        ])</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Hook: inject after every k-th layer</span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">register_hooks</span>(<span class="kw">self</span>):</span>
<span class="cs-line hl-p">    <span class="kw">for</span> i, layer <span class="kw">in</span> <span class="fn">enumerate</span>(</span>
<span class="cs-line hl-p">            <span class="kw">self</span>.backbone.layers):</span>
<span class="cs-line hl-p">        <span class="kw">if</span> (i+<span class="num">1</span>) % <span class="kw">self</span>.k == <span class="num">0</span>:</span>
<span class="cs-line hl-p">            hook_idx = (i+<span class="num">1</span>)//<span class="kw">self</span>.k - <span class="num">1</span></span>
<span class="cs-line hl-p">            layer.<span class="fn">register_forward_hook</span>(</span>
<span class="cs-line hl-p">                <span class="kw">self</span>.<span class="fn">make_hook</span>(hook_idx))</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Zero-init: bit-identical at start</span>
<span class="cs-line hl-g"><span class="kw">class</span> <span class="cls">ReverseMambaLayer</span>(nn.Module):</span>
<span class="cs-line hl-g">    <span class="kw">def</span> <span class="fn">__init__</span>(<span class="kw">self</span>, d):</span>
<span class="cs-line hl-g">        <span class="kw">self</span>.mamba = <span class="fn">MambaBlock</span>(d)</span>
<span class="cs-line hl-g">        <span class="kw">self</span>.ln = nn.<span class="fn">LayerNorm</span>(d)</span>
<span class="cs-line hl-g">        <span class="kw">self</span>.gate = nn.<span class="fn">Parameter</span>(</span>
<span class="cs-line hl-g">            torch.<span class="fn">zeros</span>(<span class="num">1</span>))  <span class="cmt"># ← s=0</span></span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-mechanism">
      <pre class="cs-pre">
<span class="cs-line cmt"># The R2L stream: 4 steps</span>
<span class="cs-line"></span>
<span class="cs-line hl-c"><span class="kw">def</span> <span class="fn">forward</span>(<span class="kw">self</span>, h):</span>
<span class="cs-line hl-c">    <span class="cmt"># h shape: [B, L, d]</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt">    # ① FLIP — expose right tokens</span>
<span class="cs-line hl-p">    h_flip = h.<span class="fn">flip</span>(dim=<span class="num">1</span>)</span>
<span class="cs-line hl-p">    <span class="cmt"># pos L-i-1 in h_flip → right of i</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt">    # ② MAMBA SCAN — aggregate</span>
<span class="cs-line hl-g">    h_mamba = <span class="kw">self</span>.mamba(h_flip)</span>
<span class="cs-line hl-g">    <span class="cmt"># linear time O(B·L·d_ssm)</span></span>
<span class="cs-line hl-g">    <span class="cmt"># does NOT touch causal KV cache</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt">    # ③ UNFLIP + LN — restore order</span>
<span class="cs-line hl-a">    h_r2l = <span class="kw">self</span>.ln(h_mamba.<span class="fn">flip</span>(dim=<span class="num">1</span>))</span>
<span class="cs-line hl-a">    <span class="cmt"># h_r2l[i] summarises j &gt;= i</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt">    # ④ GATED RESIDUAL — add back</span>
<span class="cs-line hl-p">    h_out = h + h_r2l * torch.<span class="fn">tanh</span>(<span class="kw">self</span>.gate)</span>
<span class="cs-line hl-p">    <span class="cmt"># gate=0 at init → no-op start</span></span>
<span class="cs-line hl-p">    <span class="cmt"># |tanh(s)| &lt;= 1 bounds residual</span></span>
<span class="cs-line hl-p">    <span class="kw">return</span> h_out</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Ablation (1B tokens, WikiText PPL)</span>
<span class="cs-line cmt"># Causal baseline:    PPL = 178</span>
<span class="cs-line cmt"># + MLP Adapter:      PPL = 356 ↑worse</span>
<span class="cs-line cmt"># + L2R Mamba:        PPL = 374 ↑worse</span>
<span class="cs-line cmt"># + R2L Mamba (ours): PPL =  42 ← 4.2×</span>
<span class="cs-line cmt"># Bidirectional:      PPL =  30</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-throughput">
      <pre class="cs-pre">
<span class="cs-line cmt"># Throughput on H100-80GB</span>
<span class="cs-line cmt"># G=128 tokens, T=32 denoising steps</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># B=8 (deployment batch)</span>
<span class="cs-line"><span class="cmt">#   P      Bidir   R2LM   Speedup</span></span>
<span class="cs-line hl-c"><span class="cmt">#   512    483     1154   2.4×</span></span>
<span class="cs-line hl-c"><span class="cmt">#   1024   260     1089   4.2×</span></span>
<span class="cs-line hl-c"><span class="cmt">#   2048   124      956   7.7×</span></span>
<span class="cs-line hl-g"><span class="cmt">#   4096    53      683  12.9×</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Why: bidir recomputes full attn</span>
<span class="cs-line hl-a"><span class="cmt"># each step: O(B(P+G)²) → collapses</span></span>
<span class="cs-line cmt"># R2LM cached: O(BG(P+G)) → stays flat</span>
<span class="cs-line cmt"># R2L scan: O(BG·d_ssm·H) → bounded</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># R2LM overhead vs causal: 7–16%</span>
<span class="cs-line cmt"># (shrinks with P, grows with G)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Memory at P=16384 (B=1):</span>
<span class="cs-line hl-p"><span class="cmt"># Bidir:  18.5 GB (linear growth)</span></span>
<span class="cs-line hl-p"><span class="cmt"># R2LM:  12.7 GB (sublinear)</span></span>
<span class="cs-line hl-p"><span class="cmt"># Saves: 5.9 GB (32%) vs bidir</span></span>
<span class="cs-line hl-p"><span class="cmt"># Within 0.4 GB of causal baseline</span></span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-results">
      <pre class="cs-pre">

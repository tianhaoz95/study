    <div class="cs-panel" id="panel-formula">
      <pre class="cs-pre">
<span class="cs-line cmt"># ── The 6ND compute formula ──────────────</span>
<span class="cs-line cmt"># Kaplan (2020), Hoffmann/Chinchilla (2022)</span>
<span class="cs-line"> </span>
<span class="cs-line kw">def</span> <span class="cs-line fn">compute_budget</span><span class="cs-line">(N, D):</span>
<span class="cs-line">    <span class="cmt"># N = params, D = tokens</span></span>
<span class="cs-line">    <span class="cmt"># 6 = 2 (fwd) + 4 (bwd) FLOPs/param/tok</span></span>
<span class="cs-line hl-p">    <span class="kw">return</span> 6 * N * D</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Chinchilla-optimal token count</span>
<span class="cs-line cmt"># D_opt ≈ 20 × N (compute-optimal)</span>
<span class="cs-line kw">def</span> <span class="fn">chinchilla_tokens</span>(N, multiplier=1.0):</span>
<span class="cs-line">    <span class="kw">return</span> 20 * N * multiplier</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># FLOPs → GPU-hours</span>
<span class="cs-line kw">def</span> <span class="fn">gpu_hours</span>(flops, gpu_tflops, mfu):</span>
<span class="cs-line">    eff = gpu_tflops * 1e12 * mfu</span>
<span class="cs-line hl-c">    <span class="kw">return</span> flops / eff / 3600</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Example: Llama 3 405B</span>
<span class="cs-line">flops = compute_budget(405e9, 15.6e12)</span>
<span class="cs-line">hrs   = gpu_hours(flops, 989, 0.40)</span>
<span class="cs-line cmt"># flops = 3.79e25  ✓ matches paper</span>
<span class="cs-line cmt"># hrs   = 26.7M H100 GPU-hours</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Verify: 16K GPUs × 75 days × 24h × 90%</span>
<span class="cs-line">cross_check = 16384 * 75 * 24 * 0.90</span>
<span class="cs-line cmt"># = 26.5M  ≈ 26.7M ✓</span>
      </pre>
    </div>


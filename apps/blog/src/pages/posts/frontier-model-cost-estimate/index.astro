<span class="cs-line cmt"># ── Llama 3 405B Pre-training Recipe ─────</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Architecture</span>
<span class="cs-line">layers      = 126</span>
<span class="cs-line">dim         = 16_384</span>
<span class="cs-line">attn_heads  = 128</span>
<span class="cs-line">vocab_size  = 128_000    <span class="cmt"># tiktoken + 28K</span></span>
<span class="cs-line">rope_base   = 500_000    <span class="cmt"># long context</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Data mix (% of 15.6T tokens)</span>
<span class="cs-line hl-c">general_knowledge = 0.50   <span class="cmt"># 50%</span></span>
<span class="cs-line hl-c">math_reasoning    = 0.25   <span class="cmt"># 25%</span></span>
<span class="cs-line hl-c">code              = 0.17   <span class="cmt"># 17%</span></span>
<span class="cs-line hl-c">multilingual      = 0.08   <span class="cmt"># 8%</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Training hyperparameters</span>
<span class="cs-line">optimizer   = "AdamW"</span>
<span class="cs-line hl-p">peak_lr     = 8e-5</span>
<span class="cs-line hl-p">warmup_steps = 8_000</span>
<span class="cs-line hl-p">decay_steps  = 1_200_000</span>
<span class="cs-line hl-p">final_lr    = 8e-7   <span class="cmt"># 0.01× peak</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Batch schedule</span>
<span class="cs-line">batch_1 = "4M tok, 4K ctx"   <span class="cmt"># start</span></span>
<span class="cs-line">batch_2 = "8M tok, 8K ctx"   <span class="cmt"># after 252M toks</span></span>
<span class="cs-line">batch_3 = "16M tok, 8K ctx"  <span class="cmt"># after 2.87T toks</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Parallelism on 16K H100s (MFU 38-43%)</span>
<span class="cs-line hl-g">TP = 8    <span class="cmt"># tensor parallelism (NVLink)</span></span>
<span class="cs-line hl-g">PP = 16   <span class="cmt"># pipeline parallelism</span></span>
<span class="cs-line hl-g">CP = 8    <span class="cmt"># context parallelism</span></span>
<span class="cs-line hl-g">DP = 128  <span class="cmt"># data parallelism</span></span>
<span class="cs-line cmt"># Total: 8×16×8×128 = 131,072 — across</span>
<span class="cs-line cmt"># 16K GPUs, each 8-GPU server = TP group</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-pipeline">
      <pre class="cs-pre">
<span class="cs-line cmt"># ── Post-Training Pipeline Costs ─────────</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Stage 1: Annealing (pre-train finale)</span>
<span class="cs-line">anneal_tokens = 40e9          <span class="cmt"># 40B tokens</span></span>
<span class="cs-line">anneal_flops  = 6 * 405e9 * 40e9</span>
<span class="cs-line cmt"># = 9.7e22 FLOPs → 0.068M GPU-hrs → $204K</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Stage 2: Context extension (8K → 128K)</span>
<span class="cs-line">ctx_ext_tokens = 300e9        <span class="cmt"># ~300B</span></span>
<span class="cs-line hl-c">ctx_ext_flops = 6 * 405e9 * ctx_ext_tokens</span>
<span class="cs-line cmt"># = 7.3e23 FLOPs → 0.51M GPU-hrs → $1.5M</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Stage 3: Reward model (RM)</span>
<span class="cs-line">rm_tokens = 5e9               <span class="cmt"># 5B tokens</span></span>
<span class="cs-line">rm_flops  = 6 * 405e9 * rm_tokens</span>
<span class="cs-line cmt"># = 1.2e22 FLOPs → 8.5K GPU-hrs → $25K</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Stage 4-6: SFT + DPO (multiple rounds)</span>
<span class="cs-line hl-p">sft_rounds = 4</span>
<span class="cs-line hl-p">sft_tokens_per_round = 50e9</span>
<span class="cs-line hl-p">dpo_rounds = 4</span>
<span class="cs-line hl-p">dpo_tokens_per_round = 50e9</span>
<span class="cs-line"> </span>
<span class="cs-line">post_train_tokens = (</span>
<span class="cs-line">    sft_rounds * sft_tokens_per_round +</span>
<span class="cs-line">    dpo_rounds * dpo_tokens_per_round</span>
<span class="cs-line">)  <span class="cmt"># = 400B tokens</span></span>
<span class="cs-line">post_flops = 6 * 405e9 * post_train_tokens</span>
<span class="cs-line cmt"># = 9.7e23 FLOPs → 0.68M GPU-hrs → $2M</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># ── Summary (SFT/DPO pipeline) ───────────</span>
<span class="cs-line hl-g">total_post_hrs = 0.068 + 0.51 + 0.009 + 0.68</span>
<span class="cs-line cmt"># = ~1.27M H100 GPU-hrs → ~$3.8M</span>
<span class="cs-line cmt"># ≈ 4.7% of pre-training compute</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># ── RLVR (reasoning model, 2025+) ────────</span>
<span class="cs-line cmt"># Config: 100K steps, batch 32×G=16, avg 6K tok</span>
<span class="cs-line">rollout_tokens = 100_000 * 32 * 16 * 6_000</span>
<span class="cs-line cmt"># = 307.2B rollout tokens per run</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># A) Rollout generation (autoregressive inference)</span>
<span class="cs-line">rollout_mfu   = 0.18  <span class="cmt"># memory-BW limited</span></span>
<span class="cs-line hl-a">rollout_flops = 2 * 405e9 * rollout_tokens</span>
<span class="cs-line hl-a">rollout_hrs   = rollout_flops / (989e12 * rollout_mfu) / 3600</span>
<span class="cs-line cmt"># = 2.49e23 FLOPs → ~388K GPU-hrs → ~$1.16M</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># B) Policy gradient (fwd + bwd on rollout tokens)</span>
<span class="cs-line hl-p">grad_flops = 6 * 405e9 * rollout_tokens</span>
<span class="cs-line hl-p">grad_hrs   = grad_flops / (989e12 * 0.40) / 3600</span>
<span class="cs-line cmt"># = 7.47e23 FLOPs → ~524K GPU-hrs → ~$1.57M</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># C) Reference model (KL penalty, frozen copy)</span>
<span class="cs-line">ref_mfu   = 0.30  <span class="cmt"># batched fwd, better than rollout</span></span>
<span class="cs-line hl-c">ref_flops = 2 * 405e9 * rollout_tokens</span>
<span class="cs-line hl-c">ref_hrs   = ref_flops / (989e12 * ref_mfu) / 3600</span>
<span class="cs-line cmt"># = 2.49e23 FLOPs → ~233K GPU-hrs → ~$0.70M</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># D) Reward / verifier</span>
<span class="cs-line cmt"># Code exec sandbox (CPU) + 70B reward model</span>
<span class="cs-line">reward_hrs = 80_000   <span class="cmt"># ~$0.24M</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># ── RLVR total ───────────────────────────</span>
<span class="cs-line hl-g">total_rlvr_hrs = rollout_hrs + grad_hrs + ref_hrs + reward_hrs</span>
<span class="cs-line cmt"># = ~1.23M GPU-hrs → ~$3.7M  (100K steps)</span>
<span class="cs-line cmt"> </span>
<span class="cs-line cmt"># Scaling with RL training depth:</span>
<span class="cs-line cmt"># 10K steps  → ~370K hrs  → ~$1.1M   (R1-Zero scale)</span>
<span class="cs-line cmt"># 50K steps  → ~615K hrs  → ~$1.9M</span>
<span class="cs-line cmt"># 100K steps → ~1.23M hrs → ~$3.7M</span>
<span class="cs-line cmt"># 250K steps → ~3.08M hrs → ~$9.2M   (frontier)</span>
<span class="cs-line cmt"># 500K steps → ~6.16M hrs → ~$18.5M  (heavy)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># vs traditional SFT+DPO: ~0.68M hrs → ~$2M</span>
<span class="cs-line cmt"># RLVR @ 250K steps costs ~4.5× more than SFT+DPO</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-cloud">
      <pre class="cs-pre">
<span class="cs-line cmt"># ── Cloud H100 Pricing (June 2026) ───────</span>
<span class="cs-line cmt"># Per GPU-hour, on-demand / spot</span>
<span class="cs-line"> </span>
<span class="cs-line">providers = &#123;</span>
<span class="cs-line">  <span class="str">"RunPod"</span>:     3.29,  <span class="cmt"># SXM on-demand</span></span>
<span class="cs-line">  <span class="str">"Modal"</span>:      3.95,  <span class="cmt"># per-second billing</span></span>
<span class="cs-line">  <span class="str">"GCP A3"</span>:     3.73,  <span class="cmt"># us-central1</span></span>
<span class="cs-line">  <span class="str">"Together.ai"</span>: 5.49, <span class="cmt"># HGX H100</span></span>
<span class="cs-line hl-a">  <span class="str">"CoreWeave"</span>:  6.16,  <span class="cmt"># on-demand ÷8</span></span>
<span class="cs-line">&#125;</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Large-cluster reservation discount</span>
<span class="cs-line cmt"># (512+ GPUs, 3-12 month commitment)</span>
<span class="cs-line hl-c">reservation_discount = 0.35  <span class="cmt"># ~35% off</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Llama 3 405B pre-train at each price</span>
<span class="cs-line">gpu_hours = 26.7e6</span>
<span class="cs-line kw">for</span> name, price <span class="kw">in</span> providers.items():</span>
<span class="cs-line">    reserved = price * (1 - reservation_discount)</span>
<span class="cs-line">    cost     = gpu_hours * reserved / 1e6</span>
<span class="cs-line">    <span class="fn">print</span>(<span class="fn">f</span><span class="str">"&#123;name&#125;: $&#123;cost:.0f&#125;M"</span>)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># RunPod:     $57M  (reserved)</span>
<span class="cs-line cmt"># Modal:      $69M  (reserved)</span>
<span class="cs-line cmt"># GCP A3:     $65M  (reserved)</span>
<span class="cs-line hl-p cmt"># CoreWeave:  $107M (on-demand)</span>
<span class="cs-line cmt"># ── Our model uses $3.00/hr ─────────────</span>
<span class="cs-line hl-g cmt"># = $80M mid-estimate (no discount assumed)</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-hidden">
      <pre class="cs-pre">
<span class="cs-line cmt"># ── Hidden Costs Breakdown ───────────────</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># 1. Model checkpoints</span>
<span class="cs-line">params_bytes  = 405e9 * 2    <span class="cmt"># BF16</span></span>
<span class="cs-line">ckpt_size_gb  = params_bytes / 1e9  <span class="cmt"># 810 GB</span></span>
<span class="cs-line">n_checkpoints = 1000</span>
<span class="cs-line">storage_tb    = ckpt_size_gb * n_checkpoints / 1000</span>
<span class="cs-line cmt"># = 810 TB</span>
<span class="cs-line hl-c">storage_cost  = storage_tb * 1000 * 0.02 * 4</span>
<span class="cs-line cmt"># GB × $/GB/mo × months = $64,800</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># 2. Human annotation</span>
<span class="cs-line">sft_examples   = 500_000</span>
<span class="cs-line">sft_cost_each  = 5.0      <span class="cmt"># $ per example</span></span>
<span class="cs-line hl-p">dpo_pairs      = 200_000</span>
<span class="cs-line hl-p">dpo_cost_each  = 15.0     <span class="cmt"># $ per pair</span></span>
<span class="cs-line">annotation_total = (</span>
<span class="cs-line">    sft_examples * sft_cost_each +</span>
<span class="cs-line">    dpo_pairs * dpo_cost_each</span>
<span class="cs-line">)  <span class="cmt"># = $5.5M</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># 3. Team</span>
<span class="cs-line">headcount     = 20</span>
<span class="cs-line">loaded_annual = 450_000   <span class="cmt"># $/person/yr</span></span>
<span class="cs-line">duration_yrs  = 1.5</span>
<span class="cs-line hl-g">team_cost     = headcount * loaded_annual * duration_yrs</span>
<span class="cs-line cmt"># = $13.5M</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Total hidden costs</span>
<span class="cs-line">hidden = storage_cost + annotation_total + team_cost</span>
<span class="cs-line cmt"># ≈ $19.1M  (+ ops/infra ≈ $21M total)</span>
<span class="cs-line cmt"># = ~21% of total budget</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-ledger">
      <pre class="cs-pre">
<span class="cs-line cmt"># ── Full Cost Estimator ──────────────────</span>
<span class="cs-line"> </span>
<span class="cs-line kw">def</span> <span class="fn">estimate_frontier_cost</span>(</span>
<span class="cs-line">    N,              <span class="cmt"># params</span></span>
<span class="cs-line">    chinchilla_mult = 2.0,</span>
<span class="cs-line">    gpu_price       = 3.00,  <span class="cmt"># $/hr</span></span>
<span class="cs-line">    mfu             = 0.40,</span>
<span class="cs-line">    gpu_tflops      = 989,   <span class="cmt"># H100 BF16</span></span>
<span class="cs-line">    team_size       = 20,</span>
<span class="cs-line">    duration_months = 18):</span>
<span class="cs-line"> </span>
<span class="cs-line">    D = 20 * N * chinchilla_mult</span>
<span class="cs-line hl-p">    flops = 6 * N * D</span>
<span class="cs-line"> </span>
<span class="cs-line">    eff = gpu_tflops * 1e12 * mfu</span>
<span class="cs-line hl-c">    gpu_hrs = flops / eff / 3600</span>
<span class="cs-line"> </span>
<span class="cs-line cmt">    # Add 50% for experiments & ablations</span>
<span class="cs-line">    total_hrs = gpu_hrs * 1.50</span>
<span class="cs-line hl-g">    compute = total_hrs * gpu_price</span>
<span class="cs-line"> </span>
<span class="cs-line cmt">    # Hidden costs (relatively fixed)</span>
<span class="cs-line">    team = team_size * 450_000 * (duration_months / 12)</span>
<span class="cs-line">    annotation = max(2e6, N / 405e9 * 4e6)</span>
<span class="cs-line">    storage    = 0.1e6  <span class="cmt"># modest</span></span>
<span class="cs-line"> </span>
<span class="cs-line hl-a">    total = compute + team + annotation + storage</span>
<span class="cs-line">    <span class="kw">return</span> total</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Estimates</span>
<span class="cs-line"><span class="fn">estimate_frontier_cost</span>(7e9)    <span class="cmt"># $3.7M</span></span>
<span class="cs-line"><span class="fn">estimate_frontier_cost</span>(70e9)   <span class="cmt"># $25M</span></span>
<span class="cs-line"><span class="fn">estimate_frontier_cost</span>(405e9)  <span class="cmt"># $127M</span></span>
<span class="cs-line"><span class="fn">estimate_frontier_cost</span>(1000e9) <span class="cmt"># $322M</span></span>
      </pre>
    </div>

  </div>
</aside>

</div><!-- /post-grid -->

<script>
/* ── TOC + sidebar toggles ── */
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});
const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

/* ── Code sidebar tabs ── */
const tabMeta = {
  overview: { file: 'cost_estimate.py',    title: 'Overview' },
  formula:  { file: 'compute_formula.py',  title: 'Compute Formula' },
  pretrain: { file: 'pretrain_recipe.py',  title: 'Pre-Training Recipe' },
  pipeline: { file: 'pipeline_costs.py',   title: 'Mid & Post-Training' },
  cloud:    { file: 'cloud_pricing.py',    title: 'Cloud Providers' },
  hidden:   { file: 'hidden_costs.py',     title: 'Hidden Costs' },
  ledger:   { file: 'full_estimator.py',   title: 'Full Ledger' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

/* ── IntersectionObserver: TOC + tab sync ── */
const sectionMap = {
  's-overview': 'overview', 's-formula': 'formula', 's-pretrain': 'pretrain',
  's-pipeline': 'pipeline', 's-cloud': 'cloud', 's-hidden': 'hidden', 's-ledger': 'ledger',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

/* ── Waterfall chart (§01) ── */
const wfSection = document.getElementById('s-overview');
let wfAnimated = false;
function animateWaterfall() {
  if (wfAnimated) return;
  wfAnimated = true;
  const bars = document.querySelectorAll('.wf-bar');
  const maxPct = 100;
  bars.forEach((bar, i) => {
    const pct = parseFloat(bar.dataset.pct);
    setTimeout(() => {
      bar.style.width = (pct / maxPct * 100) + '%';
    }, i * 120);
  });
  setTimeout(() => {
    document.getElementById('wf-total-val').textContent = '~$127M base + ~$7M RLVR = ~$134M';
  }, bars.length * 120 + 200);
}
if (wfSection) {
  new IntersectionObserver(entries => {
    if (entries[0].isIntersecting) animateWaterfall();
  }, { threshold: 0.2 }).observe(wfSection);
}

/* ── Provider bars (§05) ── */
const cloudSection = document.getElementById('s-cloud');
let provAnimated = false;
if (cloudSection) {
  new IntersectionObserver(entries => {
    if (entries[0].isIntersecting && !provAnimated) {
      provAnimated = true;
      document.querySelectorAll('#provider-bars .bar-fill').forEach((b, i) => {
        setTimeout(() => { b.style.width = b.dataset.w + '%'; }, i * 180);
      });
    }
  }, { threshold: 0.3 }).observe(cloudSection);
}

/* ── RLVR scale bars (§04) ── */
const rlvrSection = document.getElementById('s-pipeline');
let rlvrAnimated = false;
if (rlvrSection) {
  new IntersectionObserver(entries => {
    if (entries[0].isIntersecting && !rlvrAnimated) {
      rlvrAnimated = true;
      document.querySelectorAll('#rlvr-scale-bars .bar-fill').forEach((b, i) => {
        setTimeout(() => { b.style.width = b.dataset.w + '%'; }, i * 200);
      });
    }
  }, { threshold: 0.2 }).observe(rlvrSection);
}

/* ── Compute Budget Calculator (§02) ── */
let calcN = 405, calcTokMult = 2.0;
const H100_TFLOPS = 989;
const MFU = 0.40;
const GPU_PRICE = 3.00;
// Chinchilla-optimal: 20 tokens per param; multiply by user's multiplier
function updateCalc() {
  const D = 20 * calcN * 1e9 * calcTokMult;
  const N = calcN * 1e9;
  const flops = 6 * N * D;
  const hrs   = flops / (H100_TFLOPS * 1e12 * MFU) / 3600;
  const cost  = hrs * GPU_PRICE;
  function fmtFlops(f) {
    if (f >= 1e25) return (f/1e25).toFixed(1) + '×10²⁵';
    if (f >= 1e24) return (f/1e24).toFixed(1) + '×10²⁴';
    if (f >= 1e23) return (f/1e23).toFixed(1) + '×10²³';
    if (f >= 1e22) return (f/1e22).toFixed(1) + '×10²²';
    return (f/1e21).toFixed(1) + '×10²¹';
  }
  function fmtHrs(h) {
    if (h >= 1e6) return (h/1e6).toFixed(1) + 'M';
    if (h >= 1e3) return (h/1e3).toFixed(1) + 'K';
    return h.toFixed(0);
  }
  function fmtCost(c) {
    if (c >= 1e9) return '$' + (c/1e9).toFixed(1) + 'B';
    if (c >= 1e6) return '$' + (c/1e6).toFixed(0) + 'M';
    if (c >= 1e3) return '$' + (c/1e3).toFixed(0) + 'K';
    return '$' + c.toFixed(0);
  }
  document.getElementById('calc-flops').textContent = fmtFlops(flops);
  document.getElementById('calc-gpu-hrs').textContent = fmtHrs(hrs);
  document.getElementById('calc-cost').textContent = fmtCost(cost);
  drawCalcCanvas(flops, hrs, cost);
}
document.querySelectorAll('#calc-n-btns .calc-btn').forEach(b => {
  b.addEventListener('click', () => {
    document.querySelectorAll('#calc-n-btns .calc-btn').forEach(x => x.classList.remove('active'));
    b.classList.add('active');
    calcN = parseFloat(b.dataset.n);
    updateCalc();
  });
});
document.querySelectorAll('#calc-tok-btns .calc-btn').forEach(b => {
  b.addEventListener('click', () => {
    document.querySelectorAll('#calc-tok-btns .calc-btn').forEach(x => x.classList.remove('active'));
    b.classList.add('active');
    calcTokMult = parseFloat(b.dataset.tok);
    updateCalc();
  });
});

function drawCalcCanvas(flops, hrs, cost) {
  const canvas = document.getElementById('calc-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 120;
  canvas.width = W * DPR; canvas.height = H * DPR; ctx.scale(DPR, DPR);
  ctx.clearRect(0, 0, W, H);

  // Draw a simple horizontal stacked bar showing relative proportions
  // Pretrain (72%), experiments (11%), post-train (5%), hidden (12%)
  const pctPretrain = 0.72, pctExp = 0.11, pctPost = 0.05, pctHidden = 0.12;
  const barY = 40, barH = 36, barW = W - 40;
  const colors = ['#8b5cf6','rgba(139,92,246,.5)','#06b6d4','#10b981'];
  const pcts   = [pctPretrain, pctExp, pctPost, pctHidden];
  const labels = ['Pre-training', 'Experiments', 'Post-training', 'Team/Hidden'];
  let x = 20;
  pcts.forEach((p, i) => {
    const w = p * barW;
    ctx.fillStyle = colors[i];
    ctx.beginPath();
    ctx.roundRect(x, barY, w - 2, barH, i === 0 ? [4, 0, 0, 4] : (i === pcts.length-1 ? [0, 4, 4, 0] : 0));
    ctx.fill();
    if (w > 50) {
      ctx.fillStyle = 'rgba(255,255,255,.75)';
      ctx.font = `${10 * DPR / DPR}px monospace`;
      ctx.fillText(labels[i], x + 6, barY + barH/2 + 4);
    }
    x += w;
  });
  // Total cost label
  ctx.fillStyle = '#abb2bf';
  ctx.font = '11px monospace';
  ctx.textAlign = 'right';
  const totalCost = cost * 1.35; // add 35% for experiments + hidden
  function fmtC(c) {
    if (c >= 1e9) return '$' + (c/1e9).toFixed(1) + 'B';
    if (c >= 1e6) return '$' + (c/1e6).toFixed(0) + 'M est.';
    return '$' + (c/1e3).toFixed(0) + 'K est.';
  }
  ctx.fillText('Est. total: ' + fmtC(totalCost), W - 20, barY + barH + 16);
}

updateCalc();

/* ── MFU chart (§03) ── */
function drawMfuChart() {
  const canvas = document.getElementById('mfu-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 220;
  canvas.width = W * DPR; canvas.height = H * DPR; ctx.scale(DPR, DPR);
  ctx.clearRect(0, 0, W, H);

  const padL = 70, padR = 20, padT = 20, padB = 40;
  const cW = W - padL - padR, cH = H - padT - padB;

  // MFU values 0.15 to 0.65
  const mfuVals = [0.15, 0.20, 0.25, 0.30, 0.35, 0.40, 0.45, 0.50, 0.55, 0.60, 0.65];
  const FLOPS = 3.8e25;
  const PEAK  = 989e12; // H100 TFLOPS

  // Convert MFU to GPU-hours
  function toGpuHrs(mfu) { return FLOPS / (PEAK * mfu) / 3600; }
  function toCost(mfu)    { return toGpuHrs(mfu) * 3.0 / 1e6; } // $M

  const maxCost = toCost(0.15); // ~160M
  const minCost = toCost(0.65); // ~37M

  // Axes
  ctx.strokeStyle = 'rgba(255,255,255,.08)';
  ctx.lineWidth = 1;
  for (let i = 0; i <= 4; i++) {
    const y = padT + cH * (1 - i/4);
    ctx.beginPath(); ctx.moveTo(padL, y); ctx.lineTo(padL + cW, y); ctx.stroke();
    ctx.fillStyle = '#5c6370';
    ctx.font = '10px monospace'; ctx.textAlign = 'right';
    ctx.fillText('$' + Math.round(maxCost * (1 - i/4) + minCost * (i/4)) + 'M', padL - 6, y + 4);
  }

  // Draw cost line
  ctx.beginPath();
  ctx.strokeStyle = '#8b5cf6';
  ctx.lineWidth = 2.5;
  mfuVals.forEach((mfu, idx) => {
    const cost = toCost(mfu);
    const x = padL + (mfu - 0.15) / 0.50 * cW;
    const y = padT + cH * (1 - (cost - minCost) / (maxCost - minCost));
    if (idx === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
  });
  ctx.stroke();

  // MFU axis labels
  [0.15, 0.20, 0.25, 0.30, 0.38, 0.40, 0.50, 0.60, 0.65].forEach(mfu => {
    const x = padL + (mfu - 0.15) / 0.50 * cW;
    ctx.fillStyle = mfu === 0.40 ? '#a78bfa' : '#5c6370';
    ctx.font = mfu === 0.40 ? 'bold 10px monospace' : '9px monospace';
    ctx.textAlign = 'center';
    ctx.fillText(Math.round(mfu * 100) + '%', x, H - padB + 14);
  });

  // Highlight Llama 3 operating point
  const llmMfu = 0.40;
  const llmCost = toCost(llmMfu);
  const lx = padL + (llmMfu - 0.15) / 0.50 * cW;
  const ly = padT + cH * (1 - (llmCost - minCost) / (maxCost - minCost));
  ctx.fillStyle = '#a78bfa';
  ctx.beginPath(); ctx.arc(lx, ly, 6, 0, Math.PI * 2); ctx.fill();
  ctx.fillStyle = '#a78bfa';
  ctx.font = 'bold 10px monospace'; ctx.textAlign = 'left';
  ctx.fillText('Llama 3', lx + 9, ly - 4);
  ctx.fillText('40% MFU, $' + Math.round(llmCost) + 'M', lx + 9, ly + 8);

  // Highlight bad MFU zone
  const badX = padL;
  const badW = padL + (0.25 - 0.15) / 0.50 * cW - padL;
  ctx.fillStyle = 'rgba(239,68,68,.07)';
  ctx.fillRect(badX, padT, badW, cH);
  ctx.fillStyle = '#ef4444';
  ctx.font = '9px monospace'; ctx.textAlign = 'center';
  ctx.fillText('danger zone', badX + badW/2, padT + 12);

  // Axis label
  ctx.fillStyle = '#6b7280'; ctx.font = '10px monospace'; ctx.textAlign = 'center';
  ctx.fillText('Model FLOP Utilization (MFU)', padL + cW/2, H - 2);
  ctx.save(); ctx.translate(12, padT + cH/2); ctx.rotate(-Math.PI/2);
  ctx.textAlign = 'center'; ctx.fillText('Pre-train cost ($M)', 0, 0); ctx.restore();
}
drawMfuChart();

/* ── Pipeline step navigator (§04) ── */
let pipeStep = 0;
const pipeBoxes = document.querySelectorAll('#pipeline-steps .step-box');
const pipePrev  = document.getElementById('pipe-prev');
const pipeNext  = document.getElementById('pipe-next');
const pipeProg  = document.getElementById('pipe-prog');
function updatePipe() {
  pipeBoxes.forEach((b, i) => {
    b.classList.remove('active', 'done');
    if (i === pipeStep) b.classList.add('active');
    else if (i < pipeStep) b.classList.add('done');
  });
  pipeBoxes.forEach((b, i) => {
    const n = b.querySelector('.step-num');
    if (n) n.textContent = i < pipeStep ? '✓' : String(i+1);
  });
  if (pipePrev) pipePrev.disabled = pipeStep === 0;
  if (pipeNext) pipeNext.disabled = pipeStep === pipeBoxes.length - 1;
  if (pipeProg) pipeProg.textContent = `Step ${pipeStep+1} of ${pipeBoxes.length}`;
}
pipePrev?.addEventListener('click', () => { if (pipeStep > 0) { pipeStep--; updatePipe(); }});
pipeNext?.addEventListener('click', () => { if (pipeStep < pipeBoxes.length - 1) { pipeStep++; updatePipe(); }});
updatePipe();

/* ── Full cost estimator (§07) ── */
let estN = 405, estPrice = 3.00;
function updateEst() {
  const D     = 20 * estN * 1e9 * 2.0; // 2× Chinchilla
  const N     = estN * 1e9;
  const flops = 6 * N * D;
  const hrs   = flops / (H100_TFLOPS * 1e12 * 0.40) / 3600;
  const comp  = hrs * estPrice;
  const expts = comp * 0.40; // 40% extra for experiments + smaller models + post-train
  const team  = 20 * 450000 * 1.5; // 20 people × 18 months
  const annot = Math.max(2e6, (N/405e9) * 4e6);
  const total = comp + expts + team + annot;
  function fmtM(c) {
    if (c >= 1e9) return '$' + (c/1e9).toFixed(1) + 'B';
    if (c >= 1e6) return '$' + (c/1e6).toFixed(0) + 'M';
    return '$' + (c/1e3).toFixed(0) + 'K';
  }
  document.getElementById('est-compute').textContent = fmtM(comp);
  document.getElementById('est-ops').textContent     = fmtM(expts);
  document.getElementById('est-fixed').textContent   = fmtM(team + annot);
  document.getElementById('est-total').textContent   = fmtM(total);
}
document.querySelectorAll('#est-n-btns .calc-btn').forEach(b => {
  b.addEventListener('click', () => {
    document.querySelectorAll('#est-n-btns .calc-btn').forEach(x => x.classList.remove('active'));
    b.classList.add('active');
    estN = parseFloat(b.dataset.n);
    updateEst();
  });
});
document.querySelectorAll('#est-price-btns .calc-btn').forEach(b => {
  b.addEventListener('click', () => {
    document.querySelectorAll('#est-price-btns .calc-btn').forEach(x => x.classList.remove('active'));
    b.classList.add('active');
    estPrice = parseFloat(b.dataset.price);
    updateEst();
  });
});
updateEst();
</script>

    <!-- Mechanics Panel -->
    <div class="cs-panel" id="panel-mechanics">
      <pre class="cs-pre">
<span class="cs-line cmt"># Gradient conflict in adapter models</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">gradient_conflict_metric</span>(grad_text, grad_vision):</span>
<span class="cs-line">    <span class="cmt"># Cosine similarity of gradient vectors</span></span>
<span class="cs-line">    dot_prod = torch.<span class="fn">dot</span>(grad_text.flatten(), grad_vision.flatten())</span>
<span class="cs-line">    norm_t = torch.<span class="fn">linalg.norm</span>(grad_text)</span>
<span class="cs-line">    norm_v = torch.<span class="fn">linalg.norm</span>(grad_vision)</span>
<span class="cs-line"> </span>
<span class="cs-line">    cos_sim = dot_prod / (norm_t * norm_v)</span>
<span class="cs-line hl-c">    <span class="kw">if</span> cos_sim &lt; <span class="num">0</span>:</span>
<span class="cs-line hl-c">        <span class="cmt"># Negative cosine similarity indicates</span></span>
<span class="cs-line hl-c">        <span class="cmt"># gradient conflict (cancelling out weights)</span></span>
<span class="cs-line hl-c">        <span class="fn">print</span>(f<span class="str">"Gradient Conflict! CosSim: &#123;cos_sim:.4f&#125;"</span>)</span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="kw">return</span> cos_sim</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># SFT updates without regularization:</span>
<span class="cs-line cmt"># W_new = W_old - lr * grad_vision</span>
<span class="cs-line cmt"># Overwrites math/code logical parameters</span>
      </pre>
    </div>

    <!-- Replay Panel -->
    <div class="cs-panel" id="panel-replay">
      <pre class="cs-pre">
<span class="cs-line cmt"># Joint Multitask DataLoader & Loss Mix</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">joint_train_step</span>(model, batch_text, batch_vision, mix_ratio=<span class="num">0.5</span>):</span>
<span class="cs-line">    <span class="cmt"># 1. Text loss calculation (regularizer)</span></span>
<span class="cs-line">    txt_in, txt_tgt = batch_text</span>
<span class="cs-line">    loss_text = <span class="fn">cross_entropy</span>(model(txt_in), txt_tgt)</span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="cmt"># 2. Vision loss calculation</span></span>
<span class="cs-line">    vis_img, vis_in, vis_tgt = batch_vision</span>
<span class="cs-line">    loss_vision = <span class="fn">cross_entropy</span>(model(vis_img, vis_in), vis_tgt)</span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="cmt"># 3. Weighted total loss</span></span>
<span class="cs-line hl-g">    total_loss = mix_ratio * loss_text + (1 - mix_ratio) * loss_vision</span>
<span class="cs-line"> </span>
<span class="cs-line">    optimizer.<span class="fn">zero_grad</span>()</span>
<span class="cs-line">    total_loss.<span class="fn">backward</span>()</span>
<span class="cs-line hl-c">    optimizer.<span class="fn">step</span>()  <span class="cmt"># Balanced updates</span></span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="kw">return</span> total_loss.item()</span>
      </pre>
    </div>

    <!-- Native Panel -->
    <div class="cs-panel" id="panel-native">
      <pre class="cs-pre">
<span class="cs-line cmt"># Early-Fusion Interleaved Multimodal Model</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">class</span> <span class="cls">EarlyFusionTransformer</span>(nn.Module):</span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">__init__</span>(self, vocab_size, num_vision_tokens, d_model):</span>
<span class="cs-line">        super().<span class="fn">__init__</span>()</span>
<span class="cs-line">        <span class="cmt"># Shared embedding space</span></span>
<span class="cs-line">        self.text_embed = nn.<span class="cls">Embedding</span>(vocab_size, d_model)</span>
<span class="cs-line">        self.vision_proj = nn.<span class="cls">Linear</span>(num_vision_tokens, d_model)</span>
<span class="cs-line">        self.layers = nn.<span class="cls">TransformerEncoder</span>(...)</span>
<span class="cs-line"> </span>
<span class="cs-line hl-g">    <span class="kw">def</span> <span class="fn">forward</span>(self, sequence_tokens, sequence_types):</span>
<span class="cs-line hl-g">        embeddings = []</span>
<span class="cs-line hl-g">        <span class="kw">for</span> token, t_type <span class="kw">in</span> <span class="fn">zip</span>(sequence_tokens, sequence_types):</span>
<span class="cs-line hl-g">            <span class="kw">if</span> t_type == <span class="str">"text"</span>:</span>
<span class="cs-line hl-g">                embeddings.<span class="fn">append</span>(self.text_embed(token))</span>
<span class="cs-line hl-g">            <span class="kw">else</span>:</span>
<span class="cs-line hl-g">                embeddings.<span class="fn">append</span>(self.vision_proj(token))</span>
<span class="cs-line hl-g">        </span>
<span class="cs-line">        <span class="cmt"># Fully homogeneous stack</span></span>
<span class="cs-line">        x = torch.<span class="fn">stack</span>(embeddings)</span>
<span class="cs-line">        <span class="kw">return</span> self.layers(x)</span>
      </pre>
    </div>

    <!-- Reasoning Panel -->
    <div class="cs-panel" id="panel-reasoning">
      <pre class="cs-pre">
<span class="cs-line cmt"># Test-Time Compute (TTC) Visual Cropper</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">class</span> <span class="cls">VisualTTCReasoner</span>:</span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">__init__</span>(self, model):</span>
<span class="cs-line">        self.model = model</span>
<span class="cs-line"> </span>
<span class="cs-line hl-g">    <span class="kw">def</span> <span class="fn">reason_with_ttc</span>(self, image, prompt):</span>
<span class="cs-line hl-g">        <span class="cmt"># 1. Low-res initial scan</span></span>
<span class="cs-line hl-g">        plan = self.model.<span class="fn">generate_cot</span>(image, prompt)</span>
<span class="cs-line hl-g">        </span>
<span class="cs-line hl-g">        <span class="cmt"># 2. Identify detail coordinates needing crop</span></span>
<span class="cs-line hl-g">        crop_box = self.model.<span class="fn">detect_focus_area</span>(plan)</span>
<span class="cs-line hl-g">        </span>
<span class="cs-line hl-g">        <span class="cmt"># 3. High-res crop visual token extraction</span></span>
<span class="cs-line hl-g">        cropped_patch = image.<span class="fn">crop</span>(crop_box)</span>
<span class="cs-line hl-g">        </span>
<span class="cs-line hl-g">        <span class="cmt"># 4. Final step-by-step reasoning with cropped patch</span></span>
<span class="cs-line hl-g">        response = self.model.<span class="fn">generate_final</span>(</span>
<span class="cs-line hl-g">            cropped_patch, plan, prompt</span>
<span class="cs-line hl-g">        )</span>
<span class="cs-line hl-g">        <span class="kw">return</span> response</span>
      </pre>
    </div>

    <!-- Results Panel -->
    <div class="cs-panel" id="panel-results">
      <pre class="cs-pre">
<span class="cs-line cmt"># SOTA Multimodal vs Text-Only benchmarks</span>
<span class="cs-line cmt"># Showing 0% math/code performance degradation</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p">benchmarks = &#123;</span>
<span class="cs-line">    <span class="str">"Llama 3.1 8B"</span>: &#123;</span>
<span class="cs-line">        <span class="str">"GSM8K"</span>: <span class="num">84.5</span>, <span class="str">"HumanEval"</span>: <span class="num">72.6</span>, <span class="str">"MMLU"</span>: <span class="num">73.0</span></span>
<span class="cs-line">    &#125;,</span>
<span class="cs-line hl-g">    <span class="str">"Llama 3.2 11B Vision"</span>: &#123;</span>
<span class="cs-line hl-g">        <span class="str">"GSM8K"</span>: <span class="num">84.8</span>, <span class="str">"HumanEval"</span>: <span class="num">73.1</span>, <span class="str">"MMLU"</span>: <span class="num">73.5</span></span>
<span class="cs-line hl-g">    &#125;,</span>
<span class="cs-line">    <span class="str">"Qwen2 7B"</span>: &#123;</span>
<span class="cs-line">        <span class="str">"GSM8K"</span>: <span class="num">82.3</span>, <span class="str">"HumanEval"</span>: <span class="num">78.4</span>, <span class="str">"MMLU"</span>: <span class="num">70.5</span></span>
<span class="cs-line">    &#125;,</span>
<span class="cs-line hl-g">    <span class="str">"Qwen2-VL 7B"</span>: &#123;</span>
<span class="cs-line hl-g">        <span class="str">"GSM8K"</span>: <span class="num">83.1</span>, <span class="str">"HumanEval"</span>: <span class="num">79.0</span>, <span class="str">"MMLU"</span>: <span class="num">71.2</span></span>
<span class="cs-line hl-g">    &#125;</span>
<span class="cs-line">&#125;</span>
      </pre>
    </div>
  </div>
</aside>

</div>

<script>
// TOC + sidebar toggles
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});

const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// Code sidebar tab switching
const tabMeta = {
  intro:     { file: 'vqa_sft.py',          title: 'Visual SFT Objective' },
  mechanics: { file: 'gradient_conflict.py',title: 'Gradient Interference' },
  replay:    { file: 'balanced_replay.py',  title: 'Balanced Data Loader' },
  native:    { file: 'early_fusion.py',     title: 'Early-Fusion Transformer' },
  reasoning: { file: 'visual_ttc.py',       title: 'Visual Crop & Reason' },
  results:   { file: 'benchmarks.py',       title: 'State of the Art' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// IntersectionObserver - sync TOC + sidebar tab on scroll
const sectionMap = { 
  's-tax': 'intro', 
  's-conflict': 'mechanics', 
  's-replay': 'replay', 
  's-native': 'native', 
  's-reasoning': 'reasoning', 
  's-results': 'results' 
};

document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.35 }).observe(s)
);

// ----------------------------------------------------
// Viz 1 Interactivity: The Text Performance Penalty Bars
// ----------------------------------------------------
const recipeData = {
  'vqa-only': { gsm8k: 12, human: 18, mmlu: 45 },
  'balanced-replay': { gsm8k: 52, human: 60, mmlu: 69 },
  'native-scratch': { gsm8k: 58, human: 63, mmlu: 72 }
};

document.querySelectorAll('[data-recipe]').forEach(btn => {
  btn.addEventListener('click', (e) => {
    document.querySelectorAll('[data-recipe]').forEach(b => b.classList.remove('active'));
    e.target.classList.add('active');
    const data = recipeData[e.target.dataset.recipe];
    if (data) {
      const gFill = document.getElementById('bar-gsm8k-adapted');
      const hFill = document.getElementById('bar-human-adapted');
      const mFill = document.getElementById('bar-mmlu-adapted');
      
      gFill.style.width = data.gsm8k + '%';
      gFill.querySelector('span').textContent = data.gsm8k + '.0%';
      
      hFill.style.width = data.human + '%';
      hFill.querySelector('span').textContent = data.human + '.0%';
      
      mFill.style.width = data.mmlu + '%';
      mFill.querySelector('span').textContent = data.mmlu + '.0%';
    }
  });
});

// ----------------------------------------------------
// Viz 2 Canvas: Gradient Update Trajectory
// ----------------------------------------------------
const gradCanvas = document.getElementById('canvas-gradient');
if (gradCanvas) {
  const ctx = gradCanvas.getContext('2d');
  const unfrozenSlider = document.getElementById('unfrozen-ratio');
  const unfrozenVal = document.getElementById('unfrozen-val');
  
  function drawGradientVectors() {
    const W = gradCanvas.clientWidth, H = 250, DPR = window.devicePixelRatio || 1;
    if (gradCanvas.width !== W * DPR) {
      gradCanvas.width = W * DPR; gradCanvas.height = H * DPR; ctx.scale(DPR, DPR);
    }
    ctx.clearRect(0, 0, W, H);
    
    // Draw background grid lines
    ctx.strokeStyle = 'rgba(255, 255, 255, 0.05)';
    ctx.lineWidth = 1;
    for (let x = 0; x < W; x += 30) {
      ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, H); ctx.stroke();
    }
    for (let y = 0; y < H; y += 30) {
      ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(W, y); ctx.stroke();
    }
    
    const unfrozen = parseFloat(unfrozenSlider.value) / 100.0;
    unfrozenVal.textContent = Math.round(unfrozen * 100) + '%';
    
    const ox = W / 2, oy = H / 2 + 30; // origin
    
    // Target Basin regions
    // Math target basin
    ctx.fillStyle = 'rgba(16, 185, 129, 0.08)';
    ctx.beginPath(); ctx.arc(ox - 100, oy - 120, 45, 0, Math.PI * 2); ctx.fill();
    ctx.fillStyle = 'var(--green)';
    ctx.font = '9px monospace';
    ctx.fillText('Math/Code Reasoning Basin', ox - 150, oy - 180);
    ctx.beginPath(); ctx.arc(ox - 100, oy - 120, 5, 0, Math.PI * 2); ctx.fill();
    
    // Vision target basin
    ctx.fillStyle = 'rgba(139, 92, 246, 0.08)';
    ctx.beginPath(); ctx.arc(ox + 120, oy - 70, 45, 0, Math.PI * 2); ctx.fill();
    ctx.fillStyle = 'var(--purple-l)';
    ctx.fillText('Vision Alignment Space', ox + 80, oy - 125);
    ctx.beginPath(); ctx.arc(ox + 120, oy - 70, 5, 0, Math.PI * 2); ctx.fill();
    
    // Draw Text logical direction vector (Green Arrow)
    drawArrow(ox, oy, ox - 90, oy - 100, 'var(--green)', 2, 'Text reasoning direction');
    
    // Draw Vision alignment direction vector (Purple Arrow)
    drawArrow(ox, oy, ox + 110, oy - 55, 'var(--purple)', 2, 'Vision alignment direction');
    
    // Actual parameter update vector (Cyan Arrow)
    // As unfrozen ratio goes to 1.0 (100% SFT), the parameter updates lean 100% towards vision alignment
    // (since VQA SFT has no math datasets). 
    // If unfrozen ratio is 0.0 (frozen backbone), update is small and stays locked.
    const updateLength = 10 + unfrozen * 120;
    const angle = -0.45 + (1.0 - unfrozen) * -0.7; // angles towards vision at 1.0, math at 0.0
    const ux = ox + Math.cos(angle) * updateLength;
    const uy = oy + Math.sin(angle) * updateLength;
    
    drawArrow(ox, oy, ux, uy, 'var(--cyan)', 3, `Parameter SFT Update Vector`);
    
    // Label origin
    ctx.fillStyle = 'var(--text)';
    ctx.beginPath(); ctx.arc(ox, oy, 4, 0, Math.PI * 2); ctx.fill();
    ctx.fillText('Pretrained LLM W_0', ox - 40, oy + 20);
  }
  
  function drawArrow(x1, y1, x2, y2, color, width, label) {
    ctx.strokeStyle = color;
    ctx.fillStyle = color;
    ctx.lineWidth = width;
    ctx.beginPath();
    ctx.moveTo(x1, y1);
    ctx.lineTo(x2, y2);
    ctx.stroke();
    
    const angle = Math.atan2(y2 - y1, x2 - x1);
    ctx.beginPath();
    ctx.moveTo(x2, y2);
    ctx.lineTo(x2 - 10 * Math.cos(angle - Math.PI / 6), y2 - 10 * Math.sin(angle - Math.PI / 6));
    ctx.lineTo(x2 - 10 * Math.cos(angle + Math.PI / 6), y2 - 10 * Math.sin(angle + Math.PI / 6));
    ctx.fill();
    
    if (label) {
      ctx.font = '8px monospace';
      ctx.fillText(label, x2 + 5, y2 + (y2 > y1 ? 5 : -5));
    }
  }
  
  unfrozenSlider.addEventListener('input', drawGradientVectors);
  window.addEventListener('resize', drawGradientVectors);
  drawGradientVectors();
}

// ----------------------------------------------------
// Viz 3 Canvas: Parameter Drift Simulation
// ----------------------------------------------------
const replayCanvas = document.getElementById('canvas-replay');
if (replayCanvas) {
  const ctx = replayCanvas.getContext('2d');
  const mixSlider = document.getElementById('mix-percentage');
  const mixVal = document.getElementById('mix-val');
  const playBtn = document.getElementById('btn-replay-play');
  const resetBtn = document.getElementById('btn-replay-reset');
  const epochEl = document.getElementById('replay-epoch-val');
  
  let animationId = null;
  let epoch = 0;
  let px = 100, py = 160; // particle coords
  
  // Seeded PRNG for reproducible particle trajectories
  let seed = 1234;
  function random() {
    const x = Math.sin(seed++) * 10000;
    return x - Math.floor(x);
  }
  
  function drawReplaySpace() {
    const W = replayCanvas.clientWidth, H = 260, DPR = window.devicePixelRatio || 1;
    if (replayCanvas.width !== W * DPR) {
      replayCanvas.width = W * DPR; replayCanvas.height = H * DPR; ctx.scale(DPR, DPR);
    }
    ctx.clearRect(0, 0, W, H);
    
    // Draw background grids
    ctx.strokeStyle = 'rgba(255, 255, 255, 0.04)';
    for (let x = 0; x < W; x += 25) {
      ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, H); ctx.stroke();
    }
    for (let y = 0; y < H; y += 25) {
      ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(W, y); ctx.stroke();
    }
    
    const mix = parseFloat(mixSlider.value);
    mixVal.textContent = mix + '%';
    
    // Region A: Text Reason Space (Green circle)
    ctx.fillStyle = 'rgba(16, 185, 129, 0.07)';
    ctx.strokeStyle = 'rgba(16, 185, 129, 0.3)';
    ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.arc(120, 130, 80, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
    ctx.fillStyle = 'var(--green)';
    ctx.font = '9px monospace';
    ctx.fillText('Text Reasoning (Math/Code)', 50, 45);
    
    // Region B: Vision Alignment Space (Purple circle)
    ctx.fillStyle = 'rgba(139, 92, 246, 0.07)';
    ctx.strokeStyle = 'rgba(139, 92, 246, 0.3)';
    ctx.beginPath(); ctx.arc(W - 120, 130, 80, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
    ctx.fillStyle = 'var(--purple-l)';
    ctx.fillText('Multimodal VQA space', W - 180, 45);
    
    // Overlap: The Balanced Sweet Spot
    ctx.fillStyle = 'var(--text2)';
    ctx.font = '8px monospace';
    ctx.fillText('Target Intersection', W/2 - 45, 135);
    
    // Draw parameter particle
    ctx.beginPath();
    // Color of particle based on location
    const dText = Math.hypot(px - 120, py - 130);
    const dVis = Math.hypot(px - (W - 120), py - 130);
    
    if (dText <= 80 && dVis <= 80) {
      ctx.fillStyle = 'var(--cyan)';
      ctx.shadowColor = 'var(--cyan)';
      ctx.shadowBlur = 10;
    } else if (dText <= 80) {
      ctx.fillStyle = 'var(--green)';
      ctx.shadowColor = 'var(--green)';
      ctx.shadowBlur = 10;
    } else if (dVis <= 80) {
      ctx.fillStyle = 'var(--purple)';
      ctx.shadowColor = 'var(--purple)';
      ctx.shadowBlur = 10;
    } else {
      ctx.fillStyle = '#ef4444';
      ctx.shadowColor = '#ef4444';
      ctx.shadowBlur = 10;
    }
    
    ctx.arc(px, py, 7, 0, Math.PI * 2);
    ctx.fill();
    ctx.shadowBlur = 0; // reset
    
    ctx.fillStyle = 'var(--text)';
    ctx.fillText('Active Weights θ', px - 40, py - 12);
  }
  
  function updateParticle() {
    if (epoch >= 100) {
      cancelAnimationFrame(animationId);
      animationId = null;
      playBtn.textContent = '▶ Play Epochs';
      return;
    }
    
    epoch++;
    epochEl.textContent = `Epoch: ${epoch}`;
    
    const W = replayCanvas.clientWidth;
    const mix = parseFloat(mixSlider.value) / 100.0;
    
    // Target coordinate calculation:
    // 0% text mix -> particle moves entirely to the right (multimodal alignment only)
    // 100% text mix -> particle stays at the left (text only)
    // 50% text mix -> particle settles in center (the overlap sweet spot)
    const targetX = 120 + mix * (W - 240) + (1 - mix) * (W - 240);
    const textTargetX = 120;
    const visTargetX = W - 120;
    
    // Final settling point is a interpolation of text and vision centers based on mixture
    const fx = textTargetX * mix + visTargetX * (1 - mix);
    const fy = 130;
    
    // Add random SGD-like noise to path
    seed = epoch;
    const noiseX = (random() - 0.5) * 8;
    const noiseY = (random() - 0.5) * 8;
    
    px += (fx - px) * 0.08 + noiseX;
    py += (fy - py) * 0.08 + noiseY;
    
    drawReplaySpace();
    animationId = requestAnimationFrame(updateParticle);
  }
  
  playBtn.addEventListener('click', () => {
    if (animationId) {
      cancelAnimationFrame(animationId);
      animationId = null;
      playBtn.textContent = '▶ Play Epochs';
    } else {
      if (epoch >= 100) {
        epoch = 0;
        px = 100;
        py = 160;
      }
      playBtn.textContent = '⏸ Pause';
      updateParticle();
    }
  });
  
  resetBtn.addEventListener('click', () => {
    if (animationId) {
      cancelAnimationFrame(animationId);
      animationId = null;
    }
    epoch = 0;
    px = 100;
    py = 160;
    epochEl.textContent = `Epoch: 0`;
    playBtn.textContent = '▶ Play Epochs';
    drawReplaySpace();
  });
  
  mixSlider.addEventListener('input', drawReplaySpace);
  window.addEventListener('resize', drawReplaySpace);
  drawReplaySpace();
}

// ----------------------------------------------------
// Viz 4 Interactivity: Architecture Toggles
// ----------------------------------------------------
const lateSvg = document.getElementById('svg-late');
const earlySvg = document.getElementById('svg-early');
const btnLate = document.getElementById('btn-arch-late');
const btnEarly = document.getElementById('btn-arch-early');

btnLate?.addEventListener('click', () => {
  btnLate.classList.add('active');
  btnEarly?.classList.remove('active');
  lateSvg.style.display = 'block';
  earlySvg.style.display = 'none';
});

btnEarly?.addEventListener('click', () => {
  btnEarly.classList.add('active');
  btnLate.classList.remove('active');
  earlySvg.style.display = 'block';
  lateSvg.style.display = 'none';
});

// ----------------------------------------------------
// Viz 5 Interactivity: Inference Step Navigator
// ----------------------------------------------------
let step = 0;
const boxes = document.querySelectorAll('.step-box');
const prevBtn = document.getElementById('step-prev');
const nextBtn = document.getElementById('step-next');
const progEl = document.getElementById('step-prog');

function updateSteps() {
  boxes.forEach((b, i) => {
    b.classList.remove('active','done');
    if (i === step) b.classList.add('active');
    else if (i < step) b.classList.add('done');
  });
  if (prevBtn) prevBtn.disabled = step === 0;
  if (nextBtn) nextBtn.disabled = step === boxes.length - 1;
  if (progEl) progEl.textContent = `Step ${step+1} of ${boxes.length}`;
  boxes.forEach((b, i) => {
    const n = b.querySelector('.step-num');
    if (n) n.textContent = i < step ? '✓' : String(i+1);
  });
}

prevBtn?.addEventListener('click', () => { if (step > 0){ step--; updateSteps(); } });
nextBtn?.addEventListener('click', () => { if (step < boxes.length - 1){ step++; updateSteps(); } });
updateSteps();

// ----------------------------------------------------
// Viz 6 Interactivity: Modern SOTA animated bars
// ----------------------------------------------------
const resultsSection = document.getElementById('s-results');
if (resultsSection) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          b.style.width = b.dataset.w + '%';
        });
      }
    });
  }, { threshold: 0.2 }).observe(resultsSection);
}
</script>
</BaseLayout>

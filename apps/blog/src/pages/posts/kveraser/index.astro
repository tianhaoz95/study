<span class="cs-line cmt"># Computational complexity comparison</span>
<span class="cs-line cmt"># x = p ⊕ e ⊕ s,  x̃ = p ⊕ s</span>
<span class="cs-line cmt"># Attention cost for L new tokens after prefix |p|:</span>
<span class="cs-line cmt">   Σᵢ (|p| + i) = O(L(|p| + L))</span>
<span class="cs-line"> </span>
<span class="cs-line hl-a">exact_recompute_cost = <span class="fn">O</span>(</span>
<span class="cs-line hl-a">    |s| * (|p| + |s|)   <span class="cmt"># SUFFIX dominated</span></span>
<span class="cs-line hl-a">)</span>
<span class="cs-line cmt"># When |e|=100, |s|=31900 (early span in 32K):</span>
<span class="cs-line cmt"># → must recompute 31,900 token prefix</span>
<span class="cs-line"> </span>
<span class="cs-line hl-g">kveraser_cost = <span class="fn">O</span>(</span>
<span class="cs-line hl-g">    |e| * (|p| + |e|)   <span class="cmt"># SPAN dominated</span></span>
<span class="cs-line hl-g">)</span>
<span class="cs-line cmt"># When |e|=100 regardless of |s|:</span>
<span class="cs-line cmt"># → always pay for 100 tokens</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Empirical results (NIAH benchmark):</span>
<span class="cs-line cmt"># Context  1K:  KVEraser ~40s  Full ~40s</span>
<span class="cs-line cmt"># Context  4K:  KVEraser ~42s  Full ~80s</span>
<span class="cs-line cmt"># Context  8K:  KVEraser ~44s  Full ~160s</span>
<span class="cs-line cmt"># Context 16K:  KVEraser ~46s  Full ~350s</span>
<span class="cs-line cmt"># Context 32K:  KVEraser ~50s  Full ~704s</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p">latency_growth_kveraser = <span class="num">1.24</span>   <span class="cmt"># +24%</span></span>
<span class="cs-line hl-p">latency_growth_full_recompute = <span class="num">17.6</span>  <span class="cmt"># 17.6×</span></span>
</pre>

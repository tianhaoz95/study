<span class="cs-line cmt"># Context erasing: the problem setup</span>
<span class="cs-line cmt"># x = p ⊕ e ⊕ s  (prefix | erased span | suffix)</span>
<span class="cs-line cmt"># Goal: make future decoding behave as if</span>
<span class="cs-line cmt"># e had never appeared → produce response</span>
<span class="cs-line cmt"># matching KV(x̃) where x̃ = p ⊕ s</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">exact_erase</span>(KV_prefix, suffix_tokens, query):</span>
<span class="cs-line cmt">    # Exact solution: rerun prefill on suffix</span>
<span class="cs-line cmt">    # cost = O(|s| × (|p| + |s|))</span>
<span class="cs-line cmt">    # dominated by suffix length, NOT span length</span>
<span class="cs-line">    KV_suffix_clean = prefill(</span>
<span class="cs-line">        suffix_tokens,</span>
<span class="cs-line">        prefix_cache=KV_prefix   <span class="cmt"># ← reuse prefix</span></span>
<span class="cs-line">    )</span>
<span class="cs-line">    <span class="kw">return</span> generate(</span>
<span class="cs-line">        KV_prefix + KV_suffix_clean, query</span>
<span class="cs-line">    )</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Failure modes of simpler approaches:</span>
<span class="cs-line hl-a"><span class="kw">def</span> <span class="fn">instruction_only_forget</span>(KV_full, query):</span>
<span class="cs-line cmt">    # Cache unchanged; model must compete</span>
<span class="cs-line cmt">    # with cached evidence at decode time</span>
<span class="cs-line cmt">    # → fails at large context sizes</span>
<span class="cs-line">    prompt = <span class="str">"Ignore [span]. "</span> + query</span>
<span class="cs-line">    <span class="kw">return</span> generate(KV_full, prompt)</span>
<span class="cs-line"> </span>
<span class="cs-line hl-a"><span class="kw">def</span> <span class="fn">delete_and_shift</span>(KV_full, m, n, query):</span>
<span class="cs-line cmt">    # Remove KV[m:n], re-rotate suffix positions</span>
<span class="cs-line cmt">    # → suffix states were encoded attending to e</span>
<span class="cs-line cmt">    # → still contaminated → frequent failure</span>
<span class="cs-line">    KV_no_span = KV_full[:m] + KV_full[n+<span class="num">1</span>:]</span>
<span class="cs-line">    <span class="kw">return</span> generate(rerotate(KV_no_span), query)</span>
</pre>
    </div>

    <div class="cs-panel" id="panel-contamination">
      <pre class="cs-pre">
<span class="cs-line cmt"># Why suffix KV states are contaminated</span>
<span class="cs-line cmt"># Causal self-attention: token i attends to</span>
<span class="cs-line cmt"># all tokens j &lt;= i when computing its KV</span>
<span class="cs-line"> </span>
<span class="cs-line hl-c"><span class="kw">def</span> <span class="fn">compute_kv</span>(token_i, prefix_kv):</span>
<span class="cs-line cmt">    # key_i, val_i depend on the FULL prefix</span>
<span class="cs-line cmt">    # including any erased span in that prefix</span>
<span class="cs-line">    attn_out = <span class="fn">causal_attention</span>(</span>
<span class="cs-line">        query=<span class="fn">q</span>(token_i),</span>
<span class="cs-line">        keys=prefix_kv.keys,     <span class="cmt"># includes e</span></span>
<span class="cs-line">        values=prefix_kv.values  <span class="cmt"># includes e</span></span>
<span class="cs-line">    )</span>
<span class="cs-line">    key_i = <span class="fn">W_k</span>(attn_out + token_i)</span>
<span class="cs-line">    val_i = <span class="fn">W_v</span>(attn_out + token_i)</span>
<span class="cs-line">    <span class="kw">return</span> key_i, val_i  <span class="cmt"># permanently encoded e</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Contamination example:</span>
<span class="cs-line cmt"># Context: "France capital is London. [1K tokens]"</span>
<span class="cs-line cmt"># Erase "London" KV → suffix tokens still</span>
<span class="cs-line cmt"># attended to "London" when cached</span>
<span class="cs-line cmt"># → model still "believes" London was there</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">kv_validity_condition</span>(token_i, prefix_kv):</span>
<span class="cs-line cmt">    # KV reuse is valid ONLY when prefix matches</span>
<span class="cs-line cmt">    # edited cache: KV_i is wrong if any token</span>
<span class="cs-line cmt">    # in its prefix was deleted or modified</span>
<span class="cs-line">    <span class="kw">return</span> <span class="fn">prefix_unchanged</span>(token_i, prefix_kv)</span>
</pre>
    </div>

    <div class="cs-panel" id="panel-architecture">
      <pre class="cs-pre">
<span class="cs-line cmt"># KVEraser surrogate cache construction</span>
<span class="cs-line cmt"># Eraser Eφ: trainable backbone (no LM head)</span>
<span class="cs-line cmt"># Generator pθ: frozen LLM backbone + LM head</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">class</span> <span class="cls">KVEraser</span>:</span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">__init__</span>(<span class="kw">self</span>, generator_backbone):</span>
<span class="cs-line cmt">        # Initialize eraser from generator weights</span>
<span class="cs-line">        <span class="kw">self</span>.eraser = <span class="fn">copy</span>(generator_backbone)</span>
<span class="cs-line">        <span class="kw">self</span>.generator = generator_backbone  <span class="cmt"># frozen</span></span>
<span class="cs-line"> </span>
<span class="cs-line hl-c">    <span class="kw">def</span> <span class="fn">build_surrogate_cache</span>(<span class="kw">self</span>, KV, m, n, e):</span>
<span class="cs-line cmt">        # KV = [KV_prefix | KV_span | KV_suffix]</span>
<span class="cs-line">        KV_prefix = KV[:<span class="num">m</span>]          <span class="cmt"># valid, reuse</span></span>
<span class="cs-line hl-p">        KV_steer = <span class="kw">self</span>.eraser(</span>
<span class="cs-line hl-p">            span_tokens=e,</span>
<span class="cs-line hl-p">            prefix_kv=KV_prefix    <span class="cmt"># key conditioning</span></span>
<span class="cs-line hl-p">        )</span>
<span class="cs-line">        KV_suffix = KV[n+<span class="num">1</span>:]       <span class="cmt"># contaminated, reuse</span></span>
<span class="cs-line">        <span class="kw">return</span> KV_prefix + KV_steer + KV_suffix</span>
<span class="cs-line"> </span>
<span class="cs-line hl-g">    <span class="kw">def</span> <span class="fn">infer</span>(<span class="kw">self</span>, KV, m, n, e, query):</span>
<span class="cs-line cmt">        # Cost: O(|e|(|p| + |e|)) — NOT O(|s|)</span>
<span class="cs-line">        surrogate = <span class="kw">self</span>.<span class="fn">build_surrogate_cache</span>(</span>
<span class="cs-line">            KV, m, n, e</span>
<span class="cs-line">        )</span>
<span class="cs-line">        <span class="kw">return</span> <span class="kw">self</span>.generator.<span class="fn">decode</span>(surrogate, query)</span>
</pre>
    </div>

    <div class="cs-panel" id="panel-training">
      <pre class="cs-pre">
<span class="cs-line cmt"># Two-stage training pipeline</span>
<span class="cs-line cmt"># Stage 1: generic span-neighbor pre-training</span>
<span class="cs-line"> </span>
<span class="cs-line hl-c"><span class="kw">def</span> <span class="fn">construct_pretrain_sample</span>(doc, wiki_chunk):</span>
<span class="cs-line cmt">    # Insert 100-token Wikipedia chunk into doc</span>
<span class="cs-line">    pos = <span class="fn">random_position</span>(doc)</span>
<span class="cs-line">    context = doc[:pos] + wiki_chunk + doc[pos:]</span>
<span class="cs-line cmt">    # Select anchor adjacent to or far from chunk</span>
<span class="cs-line">    anchor = <span class="fn">select_anchor</span>(context, pos)</span>
<span class="cs-line cmt">    # Target: text neighboring anchor</span>
<span class="cs-line">    <span class="kw">return</span> (context, wiki_chunk, anchor, target)</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">train_stage1</span>(eraser, generator, data):</span>
<span class="cs-line cmt">    # 80K samples from Wikipedia</span>
<span class="cs-line cmt">    # Only retain samples where clean model</span>
<span class="cs-line cmt">    # succeeds → reliable supervision</span>
<span class="cs-line">    <span class="kw">for</span> (ctx, e, anchor, target) <span class="kw">in</span> data:</span>
<span class="cs-line">        KV = <span class="fn">prefill</span>(ctx)  <span class="cmt"># prefill full context</span></span>
<span class="cs-line">        m, n = <span class="fn">locate</span>(e, ctx)</span>
<span class="cs-line">        KV_hat = eraser.<span class="fn">build_surrogate_cache</span>(KV,m,n,e)</span>
<span class="cs-line">        loss = <span class="fn">nll</span>(generator, KV_hat, anchor, target)</span>
<span class="cs-line">        loss.<span class="fn">backward</span>()  <span class="cmt"># only eraser updated</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Stage 2: task-specific fine-tuning</span>
<span class="cs-line cmt"># NIAH: 200 samples × 6 context sizes (1K–32K)</span>
<span class="cs-line cmt"># QA: NQ + TriviaQA + HotpotQA harmful distractors</span>
<span class="cs-line cmt"># Total: ~7.5K samples</span>
<span class="cs-line hl-g"><span class="kw">def</span> <span class="fn">construct_qa_sample</span>(doc, question, answer):</span>
<span class="cs-line cmt">    # Insert distractor only if it causes failure</span>
<span class="cs-line cmt">    # Ensures distractor is genuinely harmful</span>
<span class="cs-line">    distractor = <span class="fn">retrieve_hard_negative</span>(doc)</span>
<span class="cs-line">    context = <span class="fn">insert</span>(doc, distractor)</span>
<span class="cs-line">    <span class="kw">if</span> <span class="fn">model_fails_with</span>(context, question):</span>
<span class="cs-line">        <span class="kw">return</span> (context, distractor, question, answer)</span>
</pre>
    </div>


<script>
// ── TOC + sidebar toggles ─────────────────────────────
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});
const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ── Tab switching ────────────────────────────────────
const tabMeta = {
  problem:       { file: 'kveraser/problem.py',       title: 'The Erasing Dilemma' },
  contamination: { file: 'kveraser/contamination.py', title: 'KV Contamination' },
  architecture:  { file: 'kveraser/architecture.py',  title: 'Surrogate Cache' },
  training:      { file: 'kveraser/training.py',      title: 'Training Pipeline' },
  scaling:       { file: 'kveraser/scaling.py',       title: 'Scaling Analysis' },
  results:       { file: 'kveraser/results.py',       title: 'Results' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ── IntersectionObserver — TOC + sidebar sync ──────────
const sectionMap = {
  's-problem':       'problem',
  's-contamination': 'contamination',
  's-architecture':  'architecture',
  's-training':      'training',
  's-scaling':       'scaling',
  's-results':       'results',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ── §01: Cost comparison canvas ──────────────────────
const costCanvas = document.getElementById('cost-canvas');
const posSlider  = document.getElementById('pos-slider');
const posLabel   = document.getElementById('pos-label');

function drawCostCanvas(spanPct) {
  if (!costCanvas) return;
  const ctx = costCanvas.getContext('2d');
  const W = costCanvas.clientWidth, H = 200;
  const DPR = window.devicePixelRatio || 1;
  costCanvas.width = W * DPR; costCanvas.height = H * DPR;
  ctx.scale(DPR, DPR);

  const SPAN_W = 10; // span is always 10% of context
  const prefixPct = spanPct;
  const suffixPct = 100 - spanPct - SPAN_W;

  const barY = 20, barH = 40;
  const barX = 20, barW = W - 40;

  // Draw context bar
  ctx.fillStyle = 'rgba(6,182,212,0.25)';
  ctx.strokeStyle = '#06b6d4';
  ctx.lineWidth = 1;
  const px = barX;
  const pW = barW * prefixPct / 100;
  ctx.fillRect(px, barY, pW, barH);
  ctx.strokeRect(px, barY, pW, barH);

  // Erased span
  const ex = px + pW;
  const eW = barW * SPAN_W / 100;
  ctx.fillStyle = 'rgba(239,68,68,0.4)';
  ctx.strokeStyle = '#ef4444';
  ctx.fillRect(ex, barY, eW, barH);
  ctx.strokeRect(ex, barY, eW, barH);

  // Suffix
  const sx = ex + eW;
  const sW = barW * suffixPct / 100;
  ctx.fillStyle = 'rgba(245,158,11,0.2)';
  ctx.strokeStyle = '#f59e0b';
  ctx.fillRect(sx, barY, sW, barH);
  ctx.strokeRect(sx, barY, sW, barH);

  // Labels
  ctx.font = `${10 * Math.min(1, pW / 60)}px var(--ff-mono, monospace)`;
  ctx.fillStyle = '#06b6d4';
  ctx.textAlign = 'center';
  if (pW > 30) ctx.fillText('Prefix p', px + pW/2, barY + barH/2 + 4);

  ctx.font = '9px var(--ff-mono, monospace)';
  ctx.fillStyle = '#f87171';
  ctx.textAlign = 'center';
  ctx.fillText('span e', ex + eW/2, barY + barH/2 + 4);

  ctx.font = `${10 * Math.min(1, sW / 80)}px var(--ff-mono, monospace)`;
  ctx.fillStyle = '#f59e0b';
  if (sW > 30) ctx.fillText(`Suffix s (${Math.round(suffixPct)}%)`, sx + sW/2, barY + barH/2 + 4);

  // Bracket annotations
  ctx.strokeStyle = '#ef4444';
  ctx.lineWidth = 1.5;
  ctx.beginPath();
  ctx.moveTo(sx, barY + barH + 8);
  ctx.lineTo(sx + sW, barY + barH + 8);
  ctx.stroke();
  ctx.fillStyle = '#f87171';
  ctx.font = '9px var(--ff-mono, monospace)';
  ctx.textAlign = 'center';
  ctx.fillText('Full recompute cost ∝ suffix length', sx + sW/2, barY + barH + 22);

  ctx.strokeStyle = '#8b5cf6';
  ctx.beginPath();
  ctx.moveTo(ex, barY + barH + 35);
  ctx.lineTo(ex + eW, barY + barH + 35);
  ctx.stroke();
  ctx.fillStyle = '#a78bfa';
  ctx.fillText('KVEraser cost ∝ span length', ex + eW/2, barY + barH + 49);

  // Token count labels
  ctx.fillStyle = '#6b7280';
  ctx.font = '8px var(--ff-mono, monospace)';
  ctx.textAlign = 'left';
  ctx.fillText(`|p|=${spanPct}%`, px + 3, barY - 6);
  ctx.textAlign = 'center';
  ctx.fillText(`|e|=10%`, ex + eW/2, barY - 6);
  ctx.textAlign = 'right';
  ctx.fillText(`|s|=${Math.round(suffixPct)}%`, px + barW, barY - 6);

  // Update cost bars
  const exactEl = document.getElementById('cost-exact');
  const exactLblEl = document.getElementById('cost-exact-lbl');
  if (exactEl) {
    exactEl.style.width = suffixPct + '%';
    if (exactLblEl) exactLblEl.textContent = `suffix: ${Math.round(suffixPct)}% of context`;
  }
}

function updateCostViz() {
  const pct = parseInt(posSlider.value);
  const pos = pct <= 33 ? 'early' : pct <= 66 ? 'middle' : 'late';
  posLabel.textContent = `${pos} (${pct}%)`;
  drawCostCanvas(pct);
}

posSlider?.addEventListener('input', updateCostViz);
window.addEventListener('resize', () => updateCostViz());
updateCostViz();

// ── §02: Contamination canvas ──────────────────────
const contamCanvas = document.getElementById('contam-canvas');
let contamState = 'original';

function showContamState(state) {
  contamState = state;
  drawContam();
  ['original','delete','kve'].forEach(s => {
    const btn = document.getElementById('btn-' + s);
    if (!btn) return;
    btn.style.border = s === state ? '1px solid var(--purple)' : '1px solid var(--border-hi)';
    btn.style.background = s === state ? 'var(--purple-dim)' : 'var(--surface)';
    btn.style.color = s === state ? 'var(--purple-l)' : 'var(--muted2)';
  });
  const descs = {
    original: 'Suffix tokens "attended to" the erased span during prefill. Their cached K/V states carry that influence — shown as contamination arrows. The span\'s KV entries are at positions m:n.',
    delete:   'After Delete-and-shift: the span\'s KV entries (positions m:n) are removed, suffix is shifted left. But contamination arrows remain — suffix tokens were encoded attending to the span. The cache is still corrupted.',
    kve:      'KVEraser: replaces span positions m:n with learned steering states (purple). Prefix KV and suffix KV are reused. The steering states compensate for the contamination in the reused suffix, inducing correct decoding behavior.',
  };
  const descEl = document.getElementById('contam-desc');
  if (descEl) descEl.textContent = descs[state];
}
window.showContamState = showContamState;

function drawContam() {
  if (!contamCanvas) return;
  const ctx = contamCanvas.getContext('2d');
  const W = contamCanvas.clientWidth, H = 220;
  const DPR = window.devicePixelRatio || 1;
  contamCanvas.width = W * DPR; contamCanvas.height = H * DPR;
  ctx.scale(DPR, DPR);

  // Seeded positions
  function sr(n) { return ((1664525*n+1013904223)&0x7fffffff)/0x7fffffff; }

  const tokens = [
    {label:'I prefer', type:'prefix'},
    {label:'concise', type:'prefix'},
    {label:'answers', type:'prefix'},
    {label:'"London"', type:'span'},
    {label:'capital?', type:'suffix'},
    {label:'"France"', type:'suffix'},
    {label:'Tell me', type:'suffix'},
  ];

  const N = tokens.length;
  const tw = Math.min(80, (W - 40) / N - 6);
  const th = 36;
  const startX = (W - N * (tw + 6)) / 2;
  const tokY = 30;

  // Draw token boxes
  tokens.forEach((tok, i) => {
    const x = startX + i * (tw + 6);
    let fill, stroke;
    if (tok.type === 'prefix') { fill = 'rgba(6,182,212,.15)'; stroke = '#06b6d4'; }
    else if (tok.type === 'span') {
      if (contamState === 'delete') { fill = 'rgba(107,114,128,.1)'; stroke = '#374151'; }
      else if (contamState === 'kve') { fill = 'rgba(139,92,246,.2)'; stroke = '#8b5cf6'; }
      else { fill = 'rgba(239,68,68,.2)'; stroke = '#ef4444'; }
    }
    else { fill = 'rgba(245,158,11,.12)'; stroke = '#f59e0b'; }

    ctx.fillStyle = fill;
    ctx.strokeStyle = stroke;
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.roundRect(x, tokY, tw, th, 4);
    ctx.fill(); ctx.stroke();

    ctx.fillStyle = tok.type === 'span' && contamState === 'kve' ? '#a78bfa' :
                    tok.type === 'span' ? '#f87171' :
                    tok.type === 'prefix' ? '#67e8f9' : '#fcd34d';
    ctx.font = `${Math.min(9, tw / tok.label.length * 5)}px var(--ff-mono, monospace)`;
    ctx.textAlign = 'center';
    ctx.fillText(tok.label, x + tw/2, tokY + th/2 + 4);
  });

  // KV boxes below tokens (suffix KV)
  const kvY = tokY + th + 20;
  const kvH = 30;

  tokens.forEach((tok, i) => {
    const x = startX + i * (tw + 6);
    if (tok.type === 'prefix') return; // prefix KV not shown
    if (tok.type === 'span' && contamState === 'delete') {
      // Span KV removed
      ctx.strokeStyle = '#374151';
      ctx.lineWidth = 1;
      ctx.setLineDash([3,3]);
      ctx.strokeRect(x, kvY, tw, kvH);
      ctx.setLineDash([]);
      ctx.fillStyle = '#4b5563';
      ctx.font = '8px var(--ff-mono,monospace)';
      ctx.textAlign = 'center';
      ctx.fillText('removed', x + tw/2, kvY + kvH/2 + 3);
    } else if (tok.type === 'span' && contamState === 'kve') {
      // Steering states
      ctx.fillStyle = 'rgba(139,92,246,.2)';
      ctx.strokeStyle = '#8b5cf6';
      ctx.lineWidth = 2;
      ctx.fillRect(x, kvY, tw, kvH);
      ctx.strokeRect(x, kvY, tw, kvH);
      ctx.fillStyle = '#a78bfa';
      ctx.font = '8px var(--ff-mono,monospace)';
      ctx.textAlign = 'center';
      ctx.fillText('KV_steer', x + tw/2, kvY + kvH/2 + 3);
    } else if (tok.type === 'span') {
      // Original span KV
      ctx.fillStyle = 'rgba(239,68,68,.2)';
      ctx.strokeStyle = '#ef4444';
      ctx.lineWidth = 1.5;
      ctx.fillRect(x, kvY, tw, kvH);
      ctx.strokeRect(x, kvY, tw, kvH);
      ctx.fillStyle = '#f87171';
      ctx.font = '8px var(--ff-mono,monospace)';
      ctx.textAlign = 'center';
      ctx.fillText('KV_e', x + tw/2, kvY + kvH/2 + 3);
    } else {
      // Suffix KV
      ctx.fillStyle = 'rgba(245,158,11,.12)';
      ctx.strokeStyle = contamState === 'delete' ? '#6b7280' : '#f59e0b';
      ctx.lineWidth = 1.5;
      ctx.fillRect(x, kvY, tw, kvH);
      ctx.strokeRect(x, kvY, tw, kvH);
      ctx.fillStyle = contamState === 'delete' ? '#9ca3af' : '#fcd34d';
      ctx.font = '8px var(--ff-mono,monospace)';
      ctx.textAlign = 'center';
      ctx.fillText('KV_s', x + tw/2, kvY + kvH/2 + 3);
    }
  });

  // Draw contamination arrows from span to suffix KV states
  const spanIdx = tokens.findIndex(t => t.type === 'span');
  const spanX = startX + spanIdx * (tw + 6) + tw/2;
  const spanKvY = kvY;

  tokens.forEach((tok, i) => {
    if (tok.type !== 'suffix') return;
    const sx2 = startX + i * (tw + 6) + tw/2;

    const color = contamState === 'delete' ? 'rgba(239,68,68,0.35)' :
                  contamState === 'kve'    ? 'rgba(139,92,246,0.3)' :
                                            'rgba(239,68,68,0.55)';
    ctx.strokeStyle = color;
    ctx.lineWidth = contamState === 'kve' ? 0.8 : 1.2;
    ctx.setLineDash(contamState === 'kve' ? [2,3] : []);
    ctx.beginPath();
    ctx.moveTo(spanX, spanKvY + kvH/2);
    const cpX = (spanX + sx2) / 2;
    const cpY = kvY + kvH + 18;
    ctx.quadraticCurveTo(cpX, cpY, sx2, kvY + kvH/2);
    ctx.stroke();
    ctx.setLineDash([]);
  });

  // Labels
  ctx.font = '9px var(--ff-mono,monospace)';
  ctx.fillStyle = '#6b7280';
  ctx.textAlign = 'left';
  ctx.fillText('KV cache (per token):', startX, kvY - 5);

  if (contamState === 'kve') {
    ctx.fillStyle = '#a78bfa';
    ctx.textAlign = 'center';
    ctx.fillText('Steering compensates for suffix contamination', W/2, kvY + kvH + 38);
  } else if (contamState === 'delete') {
    ctx.fillStyle = '#9ca3af';
    ctx.textAlign = 'center';
    ctx.fillText('Contamination remains even after deletion', W/2, kvY + kvH + 38);
  } else {
    ctx.fillStyle = '#f87171';
    ctx.textAlign = 'center';
    ctx.fillText('Contamination arrows: suffix KV encodes span influence', W/2, kvY + kvH + 38);
  }
}

drawContam();
window.addEventListener('resize', drawContam);

// ── §04: Step navigator ───────────────────────────
let tstep = 0;
const tstepBoxes = document.querySelectorAll('#training-steps .step-box');
const tstepPrev  = document.getElementById('tstep-prev');
const tstepNext  = document.getElementById('tstep-next');
const tstepProg  = document.getElementById('tstep-prog');

function updateTsteps() {
  tstepBoxes.forEach((b, i) => {
    b.classList.remove('active','done');
    if (i === tstep) b.classList.add('active');
    else if (i < tstep) b.classList.add('done');
    const n = b.querySelector('.step-num');
    if (n) n.textContent = i < tstep ? '✓' : String(i+1);
  });
  if (tstepPrev) tstepPrev.disabled = tstep === 0;
  if (tstepNext) tstepNext.disabled = tstep === tstepBoxes.length - 1;
  if (tstepProg) tstepProg.textContent = `Step ${tstep+1} of ${tstepBoxes.length}`;
}
tstepPrev?.addEventListener('click', () => { if (tstep > 0) { tstep--; updateTsteps(); } });
tstepNext?.addEventListener('click', () => { if (tstep < tstepBoxes.length - 1) { tstep++; updateTsteps(); } });
updateTsteps();

// ── §05: Scaling chart ────────────────────────────
const scalingCanvas = document.getElementById('scaling-canvas');

function drawScaling() {
  if (!scalingCanvas) return;
  const ctx = scalingCanvas.getContext('2d');
  const W = scalingCanvas.clientWidth, H = 280;
  const DPR = window.devicePixelRatio || 1;
  scalingCanvas.width = W * DPR; scalingCanvas.height = H * DPR;
  ctx.scale(DPR, DPR);

  const PAD = { t: 24, r: 30, b: 48, l: 60 };
  const cW = W - PAD.l - PAD.r;
  const cH = H - PAD.t - PAD.b;

  // Data (approximate from paper — log scale)
  const sizes = [1, 2, 4, 8, 16, 32]; // in K
  const logSizes = sizes.map(s => Math.log2(s));
  const kve   = [40, 42, 43, 44, 46, 50];
  const full  = [40, 60, 100, 180, 360, 704];
  const del   = [40, 52, 76, 125, 230, 400];
  const instr = [42, 58, 88, 155, 290, 550];

  // Log scale on y
  const yMin = Math.log2(30), yMax = Math.log2(800);
  const xMin = logSizes[0], xMax = logSizes[logSizes.length - 1];

  function toX(ls) { return PAD.l + (ls - xMin) / (xMax - xMin) * cW; }
  function toY(v)  { return PAD.t + (1 - (Math.log2(v) - yMin) / (yMax - yMin)) * cH; }

  // Grid
  ctx.strokeStyle = 'rgba(255,255,255,0.05)';
  ctx.lineWidth = 1;
  [32,64,128,256,512].forEach(v => {
    const y = toY(v);
    ctx.beginPath(); ctx.moveTo(PAD.l, y); ctx.lineTo(PAD.l + cW, y); ctx.stroke();
  });
  sizes.forEach((s, i) => {
    const x = toX(logSizes[i]);
    ctx.beginPath(); ctx.moveTo(x, PAD.t); ctx.lineTo(x, PAD.t + cH); ctx.stroke();
  });

  // Axes
  ctx.strokeStyle = '#374151';
  ctx.lineWidth = 1.5;
  ctx.beginPath();
  ctx.moveTo(PAD.l, PAD.t); ctx.lineTo(PAD.l, PAD.t + cH); ctx.stroke();
  ctx.beginPath();
  ctx.moveTo(PAD.l, PAD.t + cH); ctx.lineTo(PAD.l + cW, PAD.t + cH); ctx.stroke();

  // Y axis labels
  ctx.fillStyle = '#6b7280';
  ctx.font = '9px var(--ff-mono,monospace)';
  ctx.textAlign = 'right';
  [32,64,128,256,512].forEach(v => {
    ctx.fillText(v + 's', PAD.l - 6, toY(v) + 3);
  });

  // X axis labels
  ctx.textAlign = 'center';
  sizes.forEach((s, i) => {
    ctx.fillText(s + 'K', toX(logSizes[i]), PAD.t + cH + 14);
  });
  ctx.fillText('Context size', PAD.l + cW/2, PAD.t + cH + 30);
  ctx.save(); ctx.translate(14, PAD.t + cH/2); ctx.rotate(-Math.PI/2);
  ctx.fillText('Latency (s, log scale)', 0, 0); ctx.restore();

  function drawLine(data, color, dash, lw) {
    ctx.strokeStyle = color;
    ctx.lineWidth = lw || 2;
    ctx.setLineDash(dash || []);
    ctx.beginPath();
    data.forEach((v, i) => {
      const x = toX(logSizes[i]), y = toY(v);
      i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
    });
    ctx.stroke();
    ctx.setLineDash([]);
  }

  // Draw lines
  drawLine(del,   '#6b7280', [4,4], 1.5);
  drawLine(instr, '#f59e0b', [4,4], 1.5);
  drawLine(full,  '#ef4444', [], 2.5);
  drawLine(kve,   '#8b5cf6', [], 2.5);

  // Endpoint labels
  ctx.font = '9px var(--ff-mono,monospace)';
  ctx.fillStyle = '#8b5cf6';
  ctx.textAlign = 'right';
  ctx.fillText('+24%', toX(logSizes[5]) - 4, toY(kve[5]) - 6);

  ctx.fillStyle = '#ef4444';
  ctx.textAlign = 'left';
  ctx.fillText('+17.6×', toX(logSizes[5]) + 4, toY(full[5]) - 6);

  // Dots on KVEraser line
  kve.forEach((v, i) => {
    ctx.fillStyle = '#8b5cf6';
    ctx.beginPath();
    ctx.arc(toX(logSizes[i]), toY(v), 4, 0, Math.PI*2);
    ctx.fill();
  });
  // Dots on full recompute line
  full.forEach((v, i) => {
    ctx.fillStyle = '#ef4444';
    ctx.beginPath();
    ctx.arc(toX(logSizes[i]), toY(v), 4, 0, Math.PI*2);
    ctx.fill();
  });
}

drawScaling();
window.addEventListener('resize', drawScaling);

// ── §06: Animated bar charts ──────────────────────
function triggerBars(sectionId) {
  const sec = document.getElementById(sectionId);
  if (!sec) return;
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        sec.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          b.style.width = parseFloat(b.dataset.w) + '%';
        });
      }
    });
  }, { threshold: 0.3 }).observe(sec);
}
triggerBars('s-results');
</script>
</BaseLayout>

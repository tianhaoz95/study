    <div class="cs-panel" id="panel-workflow">
      <pre class="cs-pre">
<span class="cs-line cmt"># Four-stage workflow (FKL-to-OPD bridge)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Stage 1: Teacher RL (sparse reward on teacher)</span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">stage1</span>(teacher, D):</span>
<span class="cs-line hl-p">    <span class="kw">return</span> <span class="fn">grpo</span>(teacher, D)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Stage 2a: Forward-KL warmup (off-policy dense)</span>
<span class="cs-line hl-c"><span class="kw">def</span> <span class="fn">stage2a</span>(teacher_rl, student, D):</span>
<span class="cs-line hl-c">    rollouts = <span class="fn">sample</span>(teacher_rl, D, K=<span class="num">4</span>)</span>
<span class="cs-line hl-c">    <span class="cmt"># minimize forward-KL on teacher occupancy</span></span>
<span class="cs-line hl-c">    <span class="kw">return</span> <span class="fn">train</span>(student, rollouts, loss=<span class="str">'cross_entropy'</span>)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Stage 2b: OPD — on-policy distillation (on-policy dense)</span>
<span class="cs-line hl-g"><span class="kw">def</span> <span class="fn">stage2b</span>(teacher_rl, student_warmed, D):</span>
<span class="cs-line hl-g">    rollouts = <span class="fn">sample</span>(student_warmed, D)</span>
<span class="cs-line hl-g">    teacher_logprobs = <span class="fn">score</span>(teacher_rl, rollouts)  <span class="cmt"># frozen</span></span>
<span class="cs-line hl-g">    <span class="kw">return</span> <span class="fn">train</span>(student_warmed, rollouts, teacher_logprobs,</span>
<span class="cs-line hl-g">                 loss=<span class="str">'reverse_kl'</span>)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Stage 3: Post-bridge student RL (optional)</span>
<span class="cs-line hl-a"><span class="kw">def</span> <span class="fn">stage3</span>(student_bridged, D_held_out):</span>
<span class="cs-line hl-a">    <span class="kw">return</span> <span class="fn">grpo</span>(student_bridged, D_held_out)</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-math">
      <pre class="cs-pre">
<span class="cs-line cmt"># OPD is trust-region RL with dense implicit reward</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># OPD objective (reverse-KL minimization):</span>
<span class="cs-line cmt"># L_R(θ) = E_&#123;s~d_πθ&#125; KL(πθ(·|s) ‖ πT(·|s))</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Its gradient equals policy gradient of implicit reward:</span>
<span class="cs-line hl-p"><span class="cmt"># -β ∇θ KL(πθ ‖ πT)|θk</span></span>
<span class="cs-line hl-p"><span class="cmt">#  = E_&#123;y~πk&#125; [R̃k(x,y) · ∇θ log πθ(y|x)]</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># where the dense implicit reward is:</span>
<span class="cs-line hl-g"><span class="cmt"># R̃k(x,y) = Σ_t β log(πT(yt|st) / πk(yt|st))</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Two conditions for this to be informative:</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># C1 (optimality): πT must be reward-shaped</span>
<span class="cs-line hl-a"><span class="cmt">#   If πT is raw (no Stage 1), R̃ pushes toward wrong target</span></span>
<span class="cs-line hl-a"><span class="cmt">#   → raw teacher &lt; cold GRPO (empirically confirmed)</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># C2 (proximity): KL(πT ‖ πθ) must be small</span>
<span class="cs-line hl-a"><span class="cmt">#   Cold 1.7B vs post-RL 8B → high variance log-ratio</span></span>
<span class="cs-line hl-a"><span class="cmt">#   → Stage 2a (FKL warmup) enforces C2 before OPD</span></span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-ablation">
      <pre class="cs-pre">
<span class="cs-line cmt"># Component ablation — Qwen3-1.7B student, avg@16</span>
<span class="cs-line cmt"># Table 2 key rows (MATH-500 / AIME2024)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># ─── 8B RL teacher ───────────────────────────────</span>
<span class="cs-line hl-g"><span class="cmt"># Full bridge (S1+2a+2b):   79.3%  25.2%  ← best</span></span>
<span class="cs-line hl-c"><span class="cmt"># − Stage 2a (OPD only):    77.6%  23.0%  ← C2 violated</span></span>
<span class="cs-line hl-c"><span class="cmt"># − Stage 2b (FKL only):    76.0%  22.4%  ← no student feedback</span></span>
<span class="cs-line cmt"># Direct GRPO baseline:     75.9%  19.8%</span>
<span class="cs-line hl-a"><span class="cmt"># − Stage 1 (raw 8B):       71.5%  15.0%  ← C1 violated!</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># ─── 14B RL teacher ──────────────────────────────</span>
<span class="cs-line hl-g"><span class="cmt"># Full bridge (S1+2a+2b):   78.6%  24.6%</span></span>
<span class="cs-line hl-c"><span class="cmt"># − Stage 2a (OPD only):    77.1%  22.8%</span></span>
<span class="cs-line hl-c"><span class="cmt"># − Stage 2b (FKL only):    76.5%  21.5%</span></span>
<span class="cs-line cmt"># Direct GRPO baseline:     75.9%  19.8%</span>
<span class="cs-line hl-a"><span class="cmt"># − Stage 1 (raw 14B):      72.8%  16.7%  ← C1 violated!</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># ─── Stage 3 (half-split, 8B teacher) ────────────</span>
<span class="cs-line hl-g"><span class="cmt"># Bridge (½D) + Stage3 (½D): 78.5%  23.7%</span></span>
<span class="cs-line cmt"># Bridge only (½D):           75.4%  22.0%</span>
<span class="cs-line cmt"># Replay control (½D):        75.7%  21.6%  ← no new data</span></span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-replication">
      <pre class="cs-pre">
<span class="cs-line cmt"># Cross-family replication — Llama</span>
<span class="cs-line cmt"># Student: Llama-3.1-8B-Instruct</span>
<span class="cs-line cmt"># Teacher: Llama-3.3-70B-Instruct (9× larger)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Table 3: avg@16 accuracy</span>
<span class="cs-line hl-g"><span class="cmt"># RL'd 70B → bridge:  62.1%  14.9%   9.2%  ← best</span></span>
<span class="cs-line cmt"># Direct GRPO:        59.8%  12.5%   7.2%</span>
<span class="cs-line hl-a"><span class="cmt"># Raw 70B → bridge:   55.4%   8.8%   3.1%  ← 9x larger but worse!</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Same three-way ordering: raw &lt; GRPO &lt; RL-teacher</span>
<span class="cs-line cmt"># Confirms: scale ≠ C1 satisfaction</span>
<span class="cs-line cmt"># Need reward-shaping, not just model size</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Absolute gains smaller (+2.3 vs +3.4 MATH pts)</span>
<span class="cs-line cmt"># because 8B Llama student has higher base capacity</span>
<span class="cs-line cmt"># than 1.7B Qwen3 → less recoverable headroom</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Key constraint: shared tokenizer required for OPD</span>
<span class="cs-line cmt"># Cross-architecture requires same vocab to compute</span>
<span class="cs-line cmt"># per-token teacher log-probs on student rollouts</span>
      </pre>
    </div>

  </div>
</aside>

</div><!-- /post-grid -->

<script>
// TOC + sidebar toggles
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});
const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// Code sidebar tab switching
const tabMeta = {
  problem:     { file: 'workflow.py',    title: 'Allocation Problem' },
  signals:     { file: 'reward.py',      title: 'Sparse vs Dense Signals' },
  workflow:    { file: 'pipeline.py',    title: '4-Stage Workflow' },
  math:        { file: 'theory.py',      title: 'OPD as Implicit RL' },
  ablation:    { file: 'results.py',     title: 'Stage-by-Stage Ablation' },
  replication: { file: 'llama.py',       title: 'Cross-Family Replication' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// IntersectionObserver — sync TOC + sidebar
const sectionMap = {
  's-problem':     'problem',
  's-signals':     'signals',
  's-workflow':    'workflow',
  's-math':        'math',
  's-ablation':    'ablation',
  's-replication': 'replication',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.25 }).observe(s)
);

// Animated bar charts — §01 direct GRPO bars
const problemBars = document.getElementById('s-problem-bars');
if (problemBars) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        problemBars.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          b.style.width = parseFloat(b.dataset.w) + '%';
        });
      }
    });
  }, { threshold: 0.3 }).observe(problemBars);
}

// Ablation bars — trigger on §05
const ablationSection = document.getElementById('s-ablation');
if (ablationSection) {
  let fired = false;
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting && !fired) {
        fired = true;
        ablationSection.querySelectorAll('.abl-bar[data-w]').forEach(b => {
          b.style.width = parseFloat(b.dataset.w) + '%';
        });
      }
    });
  }, { threshold: 0.1 }).observe(ablationSection);
}

// Llama bars — trigger on §06
const llamaSection = document.getElementById('llama-bars-section');
if (llamaSection) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        llamaSection.querySelectorAll('.llama-bar[data-w]').forEach(b => {
          b.style.width = parseFloat(b.dataset.w) + '%';
        });
      }
    });
  }, { threshold: 0.3 }).observe(llamaSection);
}

// Signals step navigator
let sigStep = 0;
const sigBoxes = document.querySelectorAll('#signals-steps .step-box');
const sigPrev  = document.getElementById('sig-prev');
const sigNext  = document.getElementById('sig-next');
const sigProg  = document.getElementById('sig-prog');
function updateSigSteps() {
  sigBoxes.forEach((b, i) => {
    b.classList.remove('active', 'done');
    if (i === sigStep) b.classList.add('active');
    else if (i < sigStep) b.classList.add('done');
  });
  sigBoxes.forEach((b, i) => {
    const n = b.querySelector('.step-num');
    if (n) n.textContent = i < sigStep ? '✓' : String(i + 1);
  });
  if (sigPrev) sigPrev.disabled = sigStep === 0;
  if (sigNext) sigNext.disabled = sigStep === sigBoxes.length - 1;
  if (sigProg) sigProg.textContent = 'Step ' + (sigStep + 1) + ' of ' + sigBoxes.length;
}
sigPrev?.addEventListener('click', () => { if (sigStep > 0) { sigStep--; updateSigSteps(); } });
sigNext?.addEventListener('click', () => { if (sigStep < sigBoxes.length - 1) { sigStep++; updateSigSteps(); } });
updateSigSteps();

// Workflow step navigator
let wfStep = 0;
const wfBoxes = document.querySelectorAll('#workflow-steps .step-box');
const wfPrev  = document.getElementById('wf-prev');
const wfNext  = document.getElementById('wf-next');
const wfProg  = document.getElementById('wf-prog');
function updateWfSteps() {
  wfBoxes.forEach((b, i) => {
    b.classList.remove('active', 'done');
    if (i === wfStep) b.classList.add('active');
    else if (i < wfStep) b.classList.add('done');
  });
  wfBoxes.forEach((b, i) => {
    const n = b.querySelector('.step-num');
    if (n) n.textContent = i < wfStep ? '✓' : String(i + 1);
  });
  if (wfPrev) wfPrev.disabled = wfStep === 0;
  if (wfNext) wfNext.disabled = wfStep === wfBoxes.length - 1;
  if (wfProg) wfProg.textContent = 'Step ' + (wfStep + 1) + ' of ' + wfBoxes.length;
}
wfPrev?.addEventListener('click', () => { if (wfStep > 0) { wfStep--; updateWfSteps(); } });
wfNext?.addEventListener('click', () => { if (wfStep < wfBoxes.length - 1) { wfStep++; updateWfSteps(); } });
updateWfSteps();

// Ablation toggle: 8B vs 14B
const btn8b  = document.getElementById('btn-8b');
const btn14b = document.getElementById('btn-14b');
const abl8b  = document.getElementById('ablation-8b');
const abl14b = document.getElementById('ablation-14b');
function switchAblation(which) {
  const is8b = which === '8b';
  btn8b.classList.toggle('active', is8b);
  btn14b.classList.toggle('active', !is8b);
  abl8b.style.display  = is8b ? '' : 'none';
  abl14b.style.display = is8b ? 'none' : '';
  // animate bars in the newly shown panel
  const panel = is8b ? abl8b : abl14b;
  setTimeout(() => {
    panel.querySelectorAll('.abl-bar[data-w]').forEach(b => {
      b.style.width = '0%';
      requestAnimationFrame(() => {
        requestAnimationFrame(() => { b.style.width = parseFloat(b.dataset.w) + '%'; });
      });
    });
  }, 50);
}
btn8b?.addEventListener('click',  () => switchAblation('8b'));
btn14b?.addEventListener('click', () => switchAblation('14b'));
</script>
</BaseLayout>

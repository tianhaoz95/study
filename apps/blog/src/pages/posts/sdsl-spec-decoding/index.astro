  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});
const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ─── Code sidebar tabs ───
const tabMeta = {
  problem:    { file: 'sdsl/problem.py',    title: 'The Problem' },
  speculative:{ file: 'sdsl/spec_dec.py',   title: 'Speculative Decoding 101' },
  alpha:      { file: 'sdsl/alpha_law.py',  title: 'The α Affine Law' },
  throughput: { file: 'sdsl/throughput.py', title: 'Throughput Formula' },
  rule:       { file: 'sdsl/200x_rule.py',  title: 'The 200× Rule' },
  validation: { file: 'sdsl/validation.py', title: 'Empirical Validation' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ─── IntersectionObserver: sync TOC + sidebar tab ───
const sectionMap = {
  's-problem':    'problem',
  's-speculative':'speculative',
  's-alpha':      'alpha',
  's-throughput': 'throughput',
  's-rule':       'rule',
  's-validation': 'validation',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ─── Step navigator ───
(function() {
  let step = 0;
  const boxes   = document.querySelectorAll('#problem-steps .step-box');
  const prevBtn = document.getElementById('prob-prev');
  const nextBtn = document.getElementById('prob-next');
  const progEl  = document.getElementById('prob-prog');
  function update() {
    boxes.forEach((b, i) => {
      b.classList.remove('active','done');
      if (i === step) b.classList.add('active');
      else if (i < step) b.classList.add('done');
    });
    boxes.forEach((b, i) => {
      const n = b.querySelector('.step-num');
      if (n) n.textContent = i < step ? '✓' : String(i+1);
    });
    if (prevBtn) prevBtn.disabled = step === 0;
    if (nextBtn) nextBtn.disabled = step === boxes.length - 1;
    if (progEl)  progEl.textContent = `Step ${step+1} of ${boxes.length}`;
  }
  prevBtn?.addEventListener('click', () => { if (step>0){step--;update();} });
  nextBtn?.addEventListener('click', () => { if (step<boxes.length-1){step++;update();} });
  update();
})();

// ─── Spec decoding visualization (§02) ───
(function() {
  const canvas = document.getElementById('spec-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  let W, H, DPR;
  function resize() {
    DPR = window.devicePixelRatio || 1;
    W = canvas.clientWidth; H = 220;
    canvas.width = W * DPR; canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
  }
  resize();

  let currentAlpha = 0.70;
  document.querySelectorAll('[data-alpha]').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('[data-alpha]').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentAlpha = parseFloat(btn.dataset.alpha);
      drawSpec();
    });
  });

  // Seeded PRNG
  function seededRand(seed) {
    let s = seed;
    return function() { s = (s * 1664525 + 1013904223) & 0xffffffff; return (s >>> 0) / 0xffffffff; };
  }

  function drawSpec() {
    ctx.clearRect(0, 0, W, H);
    const alpha = currentAlpha;
    const gamma = 4; // always show 4 draft tokens
    const rng = seededRand(42);

    // Background
    ctx.fillStyle = 'rgba(0,0,0,0.2)';
    ctx.fillRect(0, 0, W, H);

    // Layout
    const marginX = 20;
    const draftY  = H * 0.28;
    const targetY = H * 0.65;
    const tokenW  = 54;
    const tokenH  = 28;
    const gap     = 14;
    const startX  = 90;

    // Draft model label
    ctx.fillStyle = '#61afef';
    ctx.font = `bold ${W < 500 ? 10 : 11}px monospace`;
    ctx.textAlign = 'right';
    ctx.fillText('Draft Mq', startX - 10, draftY + tokenH/2 + 4);

    // Target model label
    ctx.fillStyle = '#c678dd';
    ctx.font = `bold ${W < 500 ? 10 : 11}px monospace`;
    ctx.fillText('Target Mp', startX - 10, targetY + tokenH/2 + 4);

    // Draw accepted/rejected tokens
    const results = [];
    for (let i = 0; i < gamma; i++) {
      const r = rng();
      results.push(r < alpha);
    }
    // Make sure result reflects alpha meaningfully
    const nAccepted = Math.round(alpha * gamma);

    const tokenLabels = ['the', 'cat', 'sat', 'on'];
    for (let i = 0; i < gamma; i++) {
      const x = startX + i * (tokenW + gap);
      const accepted = i < nAccepted;

      // Draft token box
      const dColor  = '#61afef';
      ctx.strokeStyle = dColor;
      ctx.lineWidth = 1.5;
      ctx.fillStyle = 'rgba(97,175,239,0.12)';
      ctx.beginPath();
      ctx.roundRect(x, draftY, tokenW, tokenH, 4);
      ctx.fill(); ctx.stroke();
      ctx.fillStyle = dColor;
      ctx.font = `${W < 500 ? 9 : 10}px monospace`;
      ctx.textAlign = 'center';
      ctx.fillText(`"${tokenLabels[i]}"`, x + tokenW/2, draftY + tokenH/2 + 4);

      // Arrow down
      ctx.strokeStyle = 'rgba(255,255,255,0.15)';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(x + tokenW/2, draftY + tokenH + 2);
      ctx.lineTo(x + tokenW/2, targetY - 2);
      ctx.stroke();

      // Target token box (acceptance indicator)
      const tColor = accepted ? '#10b981' : '#ef4444';
      ctx.strokeStyle = tColor;
      ctx.lineWidth = 1.5;
      ctx.fillStyle = accepted ? 'rgba(16,185,129,0.12)' : 'rgba(239,68,68,0.12)';
      ctx.beginPath();
      ctx.roundRect(x, targetY, tokenW, tokenH, 4);
      ctx.fill(); ctx.stroke();
      ctx.fillStyle = tColor;
      ctx.font = `bold ${W < 500 ? 10 : 11}px monospace`;
      ctx.textAlign = 'center';
      ctx.fillText(accepted ? '✓ acc' : '✗ rej', x + tokenW/2, targetY + tokenH/2 + 4);
    }

    // Stats panel
    const statsX = startX + gamma * (tokenW + gap) + 24;
    if (statsX + 120 < W) {
      ctx.fillStyle = 'rgba(139,92,246,0.08)';
      ctx.strokeStyle = 'rgba(139,92,246,0.25)';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.roundRect(statsX, H*0.15, 130, H*0.7, 6);
      ctx.fill(); ctx.stroke();

      ctx.fillStyle = 'var(--purple-l, #a78bfa)';
      ctx.font = `bold 11px monospace`;
      ctx.textAlign = 'center';
      ctx.fillText('α = ' + alpha.toFixed(2), statsX + 65, H*0.15 + 22);

      ctx.fillStyle = '#5c6370';
      ctx.font = '9px monospace';
      ctx.textAlign = 'center';
      ctx.fillText(`accepted: ${nAccepted}/${gamma}`, statsX + 65, H*0.15 + 40);

      // Throughput relative bar
      const maxTput = 1.0;
      // Approximate relative throughput
      const relTput = (alpha > 0.05) ? (alpha * (1 - Math.pow(alpha, gamma)) / (1 - alpha)) / (gamma + 1) : 0;
      const barW = 90;
      const barH2 = 10;
      const barX = statsX + 20;
      const barY = H*0.15 + 55;
      ctx.fillStyle = 'rgba(255,255,255,0.08)';
      ctx.beginPath(); ctx.roundRect(barX, barY, barW, barH2, 3); ctx.fill();
      const fill = Math.min(1, relTput / 0.75);
      ctx.fillStyle = alpha >= 0.80 ? '#10b981' : alpha >= 0.65 ? '#c678dd' : '#ef4444';
      ctx.beginPath(); ctx.roundRect(barX, barY, barW * fill, barH2, 3); ctx.fill();

      ctx.fillStyle = '#abb2bf';
      ctx.font = '9px monospace';
      ctx.textAlign = 'center';
      ctx.fillText('rel. throughput', statsX + 65, barY + barH2 + 13);

      // Tokens per step
      const tps = ((1 - Math.pow(alpha, gamma+1)) / (1 - alpha)).toFixed(2);
      ctx.fillStyle = '#abb2bf';
      ctx.font = '9px monospace';
      ctx.fillText(`E[tokens/step]: ${tps}`, statsX + 65, H*0.15 + 92);
    }

    // Title
    ctx.fillStyle = 'rgba(255,255,255,0.35)';
    ctx.font = '10px monospace';
    ctx.textAlign = 'left';
    ctx.fillText('γ = 4 (lookahead)', marginX, H - 10);
  }
  drawSpec();
  window.addEventListener('resize', () => { resize(); drawSpec(); });
})();

// ─── α vs perplexity scatter (§03) ───
(function() {
  const canvas = document.getElementById('alpha-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  let W, H, DPR;
  function resize() {
    DPR = window.devicePixelRatio || 1;
    W = canvas.clientWidth; H = 260;
    canvas.width = W * DPR; canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
  }
  resize();

  // Data from Tables 1, 2 and Figure 3 in paper
  // format: [draft_ppl, alpha] for each target model
  const DATA = {
    llama70: {
      name: 'LLaMA 3.1-70B (target ppl≈11.1)',
      color: '#c678dd',
      pts: [
        [29.8, 0.606], [25.3, 0.625], [19.4, 0.665],
        [18.4, 0.658], [17.9, 0.670], [17.4, 0.674],
        [14.1, 0.682], [13.9, 0.700], [13.7, 0.704],
        [12.6, 0.715],
      ],
    },
    qwen110: {
      name: 'Qwen1.5-110B (target ppl≈10.1)',
      color: '#06b6d4',
      pts: [
        [29.8, 0.521], [25.3, 0.546], [19.4, 0.582],
        [18.4, 0.591], [17.9, 0.606], [17.4, 0.598],
        [14.1, 0.622], [13.9, 0.640], [13.7, 0.640],
        [12.6, 0.650],
      ],
    },
    opt13: {
      name: 'OPT-13B (target ppl≈15.6)',
      color: '#f59e0b',
      pts: [
        [29.8, 0.596], [25.3, 0.628], [19.4, 0.669],
        [18.4, 0.649], [17.9, 0.652], [17.4, 0.679],
        [14.1, 0.667], [13.9, 0.672], [13.7, 0.668],
        [12.6, 0.673],
      ],
    },
  };

  let currentTarget = 'llama70';
  document.querySelectorAll('[data-target]').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('[data-target]').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentTarget = btn.dataset.target;
      drawAlpha();
    });
  });

  function drawAlpha() {
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = 'rgba(0,0,0,0.2)';
    ctx.fillRect(0, 0, W, H);

    const pad = { l: 55, r: 25, t: 30, b: 42 };
    const cW = W - pad.l - pad.r;
    const cH = H - pad.t - pad.b;

    // Scales
    const xMin = 11, xMax = 32;
    const yMin = 0.45, yMax = 0.78;
    const px = v => pad.l + (xMax - v) / (xMax - xMin) * cW; // inverted: lower ppl = right
    const py = v => pad.t + cH - (v - yMin) / (yMax - yMin) * cH;

    // Grid
    ctx.strokeStyle = 'rgba(255,255,255,0.04)';
    ctx.lineWidth = 1;
    [0.50, 0.55, 0.60, 0.65, 0.70, 0.75].forEach(v => {
      ctx.beginPath(); ctx.moveTo(pad.l, py(v)); ctx.lineTo(pad.l + cW, py(v)); ctx.stroke();
    });
    [12, 15, 18, 21, 24, 27, 30].forEach(v => {
      ctx.beginPath(); ctx.moveTo(px(v), pad.t); ctx.lineTo(px(v), pad.t + cH); ctx.stroke();
    });

    // Draw all datasets (dimmed)
    Object.entries(DATA).forEach(([key, ds]) => {
      if (key === currentTarget) return;
      const col = ds.color;
      // Fit line
      const sorted = [...ds.pts].sort((a,b) => a[0]-b[0]);
      ctx.strokeStyle = col + '30';
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      sorted.forEach((p, i) => {
        if (i === 0) ctx.moveTo(px(p[0]), py(p[1]));
        else ctx.lineTo(px(p[0]), py(p[1]));
      });
      ctx.stroke();
      ds.pts.forEach(p => {
        ctx.fillStyle = col + '40';
        ctx.beginPath(); ctx.arc(px(p[0]), py(p[1]), 3.5, 0, Math.PI*2); ctx.fill();
      });
    });

    // Draw active dataset
    const ds = DATA[currentTarget];
    const sorted = [...ds.pts].sort((a,b) => a[0]-b[0]);
    ctx.strokeStyle = ds.color;
    ctx.lineWidth = 2;
    ctx.setLineDash([4,3]);
    ctx.beginPath();
    sorted.forEach((p, i) => {
      if (i === 0) ctx.moveTo(px(p[0]), py(p[1]));
      else ctx.lineTo(px(p[0]), py(p[1]));
    });
    ctx.stroke();
    ctx.setLineDash([]);
    ds.pts.forEach(p => {
      ctx.fillStyle = ds.color;
      ctx.beginPath(); ctx.arc(px(p[0]), py(p[1]), 5, 0, Math.PI*2); ctx.fill();
      ctx.strokeStyle = '#fff';
      ctx.lineWidth = 1;
      ctx.beginPath(); ctx.arc(px(p[0]), py(p[1]), 5, 0, Math.PI*2); ctx.stroke();
    });

    // Axes
    ctx.strokeStyle = 'rgba(255,255,255,0.2)';
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(pad.l, pad.t); ctx.lineTo(pad.l, pad.t + cH); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(pad.l, pad.t + cH); ctx.lineTo(pad.l + cW, pad.t + cH); ctx.stroke();

    // Axis labels
    ctx.fillStyle = 'rgba(255,255,255,0.45)';
    ctx.font = '10px monospace';
    ctx.textAlign = 'center';
    [12, 15, 18, 21, 24, 27, 30].forEach(v => {
      ctx.fillText(v, px(v), pad.t + cH + 16);
    });
    ctx.textAlign = 'right';
    [0.50, 0.55, 0.60, 0.65, 0.70, 0.75].forEach(v => {
      ctx.fillText(v.toFixed(2), pad.l - 6, py(v) + 4);
    });

    // Axis title
    ctx.fillStyle = 'rgba(255,255,255,0.45)';
    ctx.font = '10px monospace';
    ctx.textAlign = 'center';
    ctx.fillText('← draft perplexity (lower = better draft)', pad.l + cW/2, H - 6);

    // Y axis title
    ctx.save();
    ctx.translate(12, pad.t + cH/2);
    ctx.rotate(-Math.PI/2);
    ctx.fillText('α (acceptance rate)', 0, 0);
    ctx.restore();

    // Legend / annotation
    ctx.fillStyle = ds.color;
    ctx.font = 'bold 10px monospace';
    ctx.textAlign = 'left';
    ctx.fillText('▶ ' + ds.name, pad.l + 4, pad.t + 16);

    // R² annotation
    ctx.fillStyle = 'rgba(255,255,255,0.4)';
    ctx.font = '9px monospace';
    ctx.textAlign = 'right';
    ctx.fillText('R² ≈ 0.97 (log fit, draft PPL only)', W - pad.r, pad.t + 16);
  }
  drawAlpha();
  window.addEventListener('resize', () => { resize(); drawAlpha(); });
})();

// ─── Lambert W₋₁ function ───
function lambertWneg1(x) {
  if (x >= 0 || x < -1/Math.E) return NaN;
  let w = Math.log(-x) - Math.log(-Math.log(-x));
  for (let i = 0; i < 30; i++) {
    const ew = Math.exp(w);
    const num = w * ew - x;
    const den = ew * (w + 1);
    if (Math.abs(den) < 1e-20) break;
    w -= num / den;
  }
  return w;
}

// ─── Throughput vs N chart (§04) ───
(function() {
  const canvas = document.getElementById('throughput-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  let W, H, DPR;
  function resize() {
    DPR = window.devicePixelRatio || 1;
    W = canvas.clientWidth; H = 280;
    canvas.width = W * DPR; canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
  }
  resize();

  // Pre-training scaling law: Chinchilla / Besiroglu (2024)
  // ppl = exp(1.8172 + 482.01/N^0.3478 + 2085.43/D^0.3658)
  function pplFromN(N_params, D_tokens) {
    return Math.exp(1.8172 + 482.01 / Math.pow(N_params, 0.3478) + 2085.43 / Math.pow(D_tokens, 0.3658));
  }

  // Alpha from affine law (Eq. 5)
  const A = -0.0067, B = 0.01297, C = 0.6421;
  function alphaFromPpls(draft_ppl, target_ppl) {
    return Math.max(0.01, Math.min(0.999, A * draft_ppl + B * target_ppl + C));
  }

  // Throughput (tokens / FLOP) at optimal gamma
  function computeThroughput(M, N, alpha) {
    if (N >= M * 0.95 || alpha <= 0.001 || alpha >= 0.9999) return 0;
    const r = M / N;
    const arg = -Math.pow(alpha, r - 1) / Math.E;
    if (arg <= -1/Math.E || arg >= 0) return 0;
    const W = lambertWneg1(arg);
    if (isNaN(W)) return 0;
    const numer = -Math.log(alpha);
    const denom = 2 * N * (alpha - 1) * W;
    if (denom === 0) return 0;
    return numer / denom;
  }

  const MODELS = {
    opt13:  { M: 13e9,   label: 'OPT-13B',      color: '#f59e0b', Nstar: 0.117e9, D: 300e9   },
    opt30:  { M: 30e9,   label: 'OPT-30B',       color: '#06b6d4', Nstar: 0.298e9, D: 300e9   },
    llama70:{ M: 70e9,   label: 'LLaMA-70B',     color: '#c678dd', Nstar: 0.41e9,  D: 1000e9  },
  };

  let activeModel = 'opt13';
  document.querySelectorAll('[data-model]').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('[data-model]').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeModel = btn.dataset.model;
      drawTput();
    });
  });

  function drawTput() {
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = 'rgba(0,0,0,0.2)';
    ctx.fillRect(0, 0, W, H);

    const pad = { l: 60, r: 30, t: 30, b: 44 };
    const cW = W - pad.l - pad.r;
    const cH = H - pad.t - pad.b;

    // X axis: log scale, N from 50M to 5B
    const xLogMin = Math.log10(50e6), xLogMax = Math.log10(5e9);
    const px = N => pad.l + (Math.log10(N) - xLogMin) / (xLogMax - xLogMin) * cW;

    // Compute throughput curves for each model
    function makeCurve(mdl) {
      const pts = [];
      for (let logN = xLogMin; logN <= xLogMax; logN += 0.04) {
        const N = Math.pow(10, logN);
        const draftPpl = pplFromN(N, mdl.D);
        const targetPpl = pplFromN(mdl.M, mdl.D);
        const alpha = alphaFromPpls(draftPpl, targetPpl);
        const T = computeThroughput(mdl.M, N, alpha);
        pts.push({ N, T });
      }
      return pts;
    }

    // Compute all curves and find global max for y scale
    const curves = {};
    let globalMax = 0;
    Object.entries(MODELS).forEach(([key, mdl]) => {
      const pts = makeCurve(mdl);
      curves[key] = pts;
      pts.forEach(p => { if (isFinite(p.T) && p.T > globalMax) globalMax = p.T; });
    });

    const yMax = globalMax * 1.15;
    const py = T => pad.t + cH - (isFinite(T) ? T / yMax * cH : 0);

    // Grid
    ctx.strokeStyle = 'rgba(255,255,255,0.04)';
    ctx.lineWidth = 1;
    [0.25, 0.5, 0.75, 1.0].forEach(frac => {
      const y = pad.t + cH - frac * cH;
      ctx.beginPath(); ctx.moveTo(pad.l, y); ctx.lineTo(pad.l + cW, y); ctx.stroke();
    });
    [100e6, 300e6, 1e9, 3e9].forEach(N => {
      const x = px(N);
      ctx.beginPath(); ctx.moveTo(x, pad.t); ctx.lineTo(x, pad.t + cH); ctx.stroke();
    });

    // Draw non-active curves dimmed
    Object.entries(MODELS).forEach(([key, mdl]) => {
      if (key === activeModel) return;
      const pts = curves[key];
      ctx.strokeStyle = mdl.color + '30';
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      pts.forEach((p, i) => {
        if (!isFinite(p.T)) return;
        if (i === 0) ctx.moveTo(px(p.N), py(p.T));
        else ctx.lineTo(px(p.N), py(p.T));
      });
      ctx.stroke();
    });

    // Draw active curve
    const mdl = MODELS[activeModel];
    const pts = curves[activeModel];
    ctx.strokeStyle = mdl.color;
    ctx.lineWidth = 2.5;
    ctx.beginPath();
    pts.forEach((p, i) => {
      if (!isFinite(p.T)) return;
      if (i === 0) ctx.moveTo(px(p.N), py(p.T));
      else ctx.lineTo(px(p.N), py(p.T));
    });
    ctx.stroke();

    // Find actual peak N
    let peakT = 0, peakN = mdl.Nstar;
    pts.forEach(p => { if (isFinite(p.T) && p.T > peakT) { peakT = p.T; peakN = p.N; } });

    // Star at N*
    const sx = px(peakN), sy = py(peakT);
    ctx.fillStyle = '#fbbf24';
    ctx.font = 'bold 16px monospace';
    ctx.textAlign = 'center';
    ctx.fillText('★', sx, sy - 6);
    ctx.fillStyle = mdl.color;
    ctx.font = 'bold 10px monospace';
    ctx.fillText('N* ≈ ' + (peakN/1e6).toFixed(0) + 'M', sx, sy + 18);

    // Axes
    ctx.strokeStyle = 'rgba(255,255,255,0.2)';
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(pad.l, pad.t); ctx.lineTo(pad.l, pad.t + cH); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(pad.l, pad.t + cH); ctx.lineTo(pad.l + cW, pad.t + cH); ctx.stroke();

    // X axis labels (log scale)
    ctx.fillStyle = 'rgba(255,255,255,0.45)';
    ctx.font = '10px monospace';
    ctx.textAlign = 'center';
    [[100e6,'100M'],[300e6,'300M'],[1e9,'1B'],[3e9,'3B']].forEach(([N, label]) => {
      ctx.fillText(label, px(N), pad.t + cH + 16);
    });
    ctx.fillText('Draft model size N', pad.l + cW/2, H - 5);

    // Y axis labels
    ctx.textAlign = 'right';
    ctx.fillStyle = 'rgba(255,255,255,0.45)';
    ['0%', '25%', '50%', '75%', '100%'].forEach((label, i) => {
      const y = pad.t + cH - i/4 * cH;
      ctx.fillText(label, pad.l - 6, y + 4);
    });

    // Y axis title
    ctx.save();
    ctx.translate(12, pad.t + cH/2);
    ctx.rotate(-Math.PI/2);
    ctx.fillStyle = 'rgba(255,255,255,0.45)';
    ctx.font = '10px monospace';
    ctx.textAlign = 'center';
    ctx.fillText('relative throughput', 0, 0);
    ctx.restore();

    // Legend
    ctx.fillStyle = mdl.color;
    ctx.font = 'bold 11px monospace';
    ctx.textAlign = 'left';
    ctx.fillText('▶ ' + mdl.label, pad.l + 6, pad.t + 18);

    // "too small" / "too large" annotations
    const midN = peakN;
    const leftX = pad.l + 8;
    const rightX = px(midN) + 30;
    ctx.fillStyle = 'rgba(239,68,68,0.6)';
    ctx.font = '9px monospace';
    ctx.textAlign = 'left';
    ctx.fillText('← low α', leftX, pad.t + cH * 0.5);
    ctx.fillStyle = 'rgba(239,68,68,0.6)';
    ctx.textAlign = 'right';
    ctx.fillText('draft too expensive →', W - pad.r - 4, pad.t + cH * 0.5);
  }

  drawTput();
  window.addEventListener('resize', () => { resize(); drawTput(); });
})();

// ─── 200× rule canvas (§05) ───
(function() {
  const canvas = document.getElementById('rule-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  let W, H, DPR;
  function resize() {
    DPR = window.devicePixelRatio || 1;
    W = canvas.clientWidth; H = 260;
    canvas.width = W * DPR; canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
  }
  resize();

  const slider = document.getElementById('rule-slider');
  const labelEl = document.getElementById('rule-label');
  let selectedM = 70;

  // Empirical N* data points from Table 5 (M in B, N* in M)
  const empiricalPts = [
    { M: 13, N: 117, family: 'OPT',   color: '#f59e0b' },
    { M: 13, N: 109, family: 'Qwen',  color: '#06b6d4' },
    { M: 14, N: 117, family: 'Qwen',  color: '#06b6d4' },
    { M: 30, N: 298, family: 'OPT',   color: '#f59e0b' },
    { M: 32, N: 314, family: 'Qwen',  color: '#06b6d4' },
    { M: 36, N: 319, family: 'Seed',  color: '#10b981' },
    { M: 66, N: 410, family: 'OPT',   color: '#f59e0b' },
    { M: 70, N: 378, family: 'Qwen',  color: '#06b6d4' },
    { M: 72, N: 290, family: 'Qwen',  color: '#06b6d4' },
    { M: 110, N: 378, family: 'Qwen', color: '#06b6d4' },
  ];

  function nStar(M_B) { return (2.71e-3 * M_B * 1e9 + 87.1e6) / 1e6; }

  function drawRule() {
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = 'rgba(0,0,0,0.2)';
    ctx.fillRect(0, 0, W, H);

    const pad = { l: 60, r: 30, t: 28, b: 42 };
    const cW = W - pad.l - pad.r;
    const cH = H - pad.t - pad.b;

    const xMin = 0, xMax = 120;
    const yMin = 0, yMax = 500;
    const px = M => pad.l + (M - xMin) / (xMax - xMin) * cW;
    const py = N => pad.t + cH - (N - yMin) / (yMax - yMin) * cH;

    // Grid
    ctx.strokeStyle = 'rgba(255,255,255,0.04)';
    ctx.lineWidth = 1;
    [100, 200, 300, 400].forEach(v => {
      ctx.beginPath(); ctx.moveTo(pad.l, py(v)); ctx.lineTo(pad.l + cW, py(v)); ctx.stroke();
    });
    [20, 40, 60, 80, 100].forEach(v => {
      ctx.beginPath(); ctx.moveTo(px(v), pad.t); ctx.lineTo(px(v), pad.t + cH); ctx.stroke();
    });

    // SDSL fit line
    ctx.strokeStyle = 'rgba(139,92,246,0.7)';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(px(xMin), py(nStar(xMin)));
    ctx.lineTo(px(xMax), py(nStar(xMax)));
    ctx.stroke();

    // Label the line
    ctx.fillStyle = 'rgba(139,92,246,0.8)';
    ctx.font = '10px monospace';
    ctx.textAlign = 'left';
    ctx.fillText('N* = 2.71×10⁻³ × M + 87M', pad.l + cW * 0.05, py(nStar(20)) - 10);

    // Empirical scatter
    empiricalPts.forEach(pt => {
      ctx.fillStyle = pt.color;
      ctx.beginPath(); ctx.arc(px(pt.M), py(pt.N), 5.5, 0, Math.PI*2); ctx.fill();
      ctx.strokeStyle = '#fff4';
      ctx.lineWidth = 1;
      ctx.beginPath(); ctx.arc(px(pt.M), py(pt.N), 5.5, 0, Math.PI*2); ctx.stroke();
    });

    // Slider marker
    const mB = selectedM;
    const nM = nStar(mB);
    const mx = px(mB), my = py(nM);
    // Vertical dashed line
    ctx.strokeStyle = 'rgba(255,255,255,0.25)';
    ctx.lineWidth = 1;
    ctx.setLineDash([4, 3]);
    ctx.beginPath(); ctx.moveTo(mx, pad.t + cH); ctx.lineTo(mx, my); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(pad.l, my); ctx.lineTo(mx, my); ctx.stroke();
    ctx.setLineDash([]);
    // Big dot
    ctx.fillStyle = '#c678dd';
    ctx.beginPath(); ctx.arc(mx, my, 8, 0, Math.PI*2); ctx.fill();
    ctx.strokeStyle = '#fff';
    ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.arc(mx, my, 8, 0, Math.PI*2); ctx.stroke();
    // Label
    ctx.fillStyle = '#fff';
    ctx.font = 'bold 10px monospace';
    ctx.textAlign = mx > W/2 ? 'right' : 'left';
    const lx = mx > W/2 ? mx - 12 : mx + 12;
    ctx.fillText(`M=${mB}B → N*≈${nM.toFixed(0)}M`, lx, my - 12);

    // Axes
    ctx.strokeStyle = 'rgba(255,255,255,0.2)';
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(pad.l, pad.t); ctx.lineTo(pad.l, pad.t + cH); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(pad.l, pad.t + cH); ctx.lineTo(pad.l + cW, pad.t + cH); ctx.stroke();

    ctx.fillStyle = 'rgba(255,255,255,0.45)';
    ctx.font = '10px monospace';
    ctx.textAlign = 'center';
    [20, 40, 60, 80, 100, 120].forEach(v => ctx.fillText(v+'B', px(v), pad.t + cH + 16));
    ctx.textAlign = 'right';
    [100, 200, 300, 400].forEach(v => ctx.fillText(v+'M', pad.l - 6, py(v) + 4));
    ctx.textAlign = 'center';
    ctx.fillText('Target model size M', pad.l + cW/2, H - 5);

    ctx.save();
    ctx.translate(12, pad.t + cH/2);
    ctx.rotate(-Math.PI/2);
    ctx.fillText('Optimal draft N*', 0, 0);
    ctx.restore();

    // Legend dots
    const lg = [['OPT', '#f59e0b'], ['Qwen', '#06b6d4'], ['Seed', '#10b981']];
    lg.forEach(([name, color], i) => {
      const lx2 = W - pad.r - 140 + i * 48;
      ctx.fillStyle = color;
      ctx.beginPath(); ctx.arc(lx2, pad.t + 12, 4, 0, Math.PI*2); ctx.fill();
      ctx.fillStyle = 'rgba(255,255,255,0.5)';
      ctx.font = '9px monospace';
      ctx.textAlign = 'left';
      ctx.fillText(name, lx2 + 7, pad.t + 16);
    });
  }

  drawRule();

  slider?.addEventListener('input', () => {
    selectedM = parseInt(slider.value, 10);
    const nM = nStar(selectedM);
    const ratio = (selectedM * 1e3 / nM).toFixed(0);
    labelEl.textContent = `${selectedM}B → N* ≈ ${nM.toFixed(0)}M (${ratio}×)`;
    drawRule();
  });
  window.addEventListener('resize', () => { resize(); drawRule(); });
})();

// ─── Animated bar chart (§06) ───
(function() {
  const section = document.getElementById('s-validation');
  if (!section) return;
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('#val-bars .bar-fill[data-w]').forEach(b => {
          b.style.width = (parseFloat(b.dataset.w) / 100 * 100) + '%';
        });
      }
    });
  }, { threshold: 0.3 }).observe(section);
})();
</script>
</BaseLayout>

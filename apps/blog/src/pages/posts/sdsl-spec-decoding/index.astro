<span class="cs-line"> </span>
<span class="cs-line hl-a"><span class="kw">def</span> <span class="fn">find_best_draft</span>(target_M, data_D):</span>
<span class="cs-line hl-a">  candidates = [125e6, 350e6, 1.3e9,</span>
<span class="cs-line hl-a">                2.7e9, 6.7e9]</span>
<span class="cs-line">  results = &#123;&#125;</span>
<span class="cs-line">  <span class="kw">for</span> N <span class="kw">in</span> candidates:</span>
<span class="cs-line">    <span class="cmt"># expensive: full pre-training run</span></span>
<span class="cs-line">    draft = <span class="fn">train_model</span>(N, data_D)</span>
<span class="cs-line">    alpha = <span class="fn">measure_acceptance</span>(</span>
<span class="cs-line">      draft, target_M)</span>
<span class="cs-line">    tput = <span class="fn">benchmark_throughput</span>(</span>
<span class="cs-line">      draft, target_M)</span>
<span class="cs-line">    results[N] = tput</span>
<span class="cs-line">  <span class="kw">return</span> <span class="fn">max</span>(results, key=results.get)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># With SDSL: no search needed</span>
<span class="cs-line hl-g"><span class="kw">def</span> <span class="fn">sdsl_optimal_draft</span>(M):</span>
<span class="cs-line hl-g">  mu = 2.71e-3</span>
<span class="cs-line hl-g">  M0 = 87.1e6</span>
<span class="cs-line hl-g">  <span class="kw">return</span> mu * M + M0</span>
<span class="cs-line hl-g">  <span class="cmt"># M=70B → ~277M, no training needed</span></span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-speculative">
      <pre class="cs-pre">
<span class="cs-line cmt"># Speculative Decoding core loop</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">speculative_decode</span>(prefix, gamma,</span>
<span class="cs-line hl-p">                        Mq, Mp):</span>
<span class="cs-line">  <span class="cmt"># Step 1: draft γ tokens</span></span>
<span class="cs-line">  drafts = []</span>
<span class="cs-line">  <span class="kw">for</span> i <span class="kw">in</span> <span class="fn">range</span>(gamma):</span>
<span class="cs-line">    q_i = <span class="fn">Mq</span>(prefix + drafts)</span>
<span class="cs-line">    x_i = <span class="fn">sample</span>(q_i)</span>
<span class="cs-line">    drafts.<span class="fn">append</span>(x_i)</span>
<span class="cs-line"> </span>
<span class="cs-line">  <span class="cmt"># Step 2: target scores all in 1 pass</span></span>
<span class="cs-line">  p_all = <span class="fn">Mp</span>(prefix + drafts)  <span class="cmt"># parallel!</span></span>
<span class="cs-line"> </span>
<span class="cs-line">  <span class="cmt"># Step 3: accept/reject</span></span>
<span class="cs-line">  n_accepted = 0</span>
<span class="cs-line">  <span class="kw">for</span> i, x_i <span class="kw">in</span> <span class="fn">enumerate</span>(drafts):</span>
<span class="cs-line hl-c">    r = <span class="fn">uniform</span>(0, 1)</span>
<span class="cs-line hl-c">    <span class="kw">if</span> r &lt; p_all[i][x_i] / q_all[i][x_i]:</span>
<span class="cs-line hl-c">      n_accepted += 1   <span class="cmt"># accept token</span></span>
<span class="cs-line">    <span class="kw">else</span>:</span>
<span class="cs-line">      <span class="kw">break</span>             <span class="cmt"># reject, resample</span></span>
<span class="cs-line"> </span>
<span class="cs-line">  <span class="kw">return</span> n_accepted + 1  <span class="cmt"># always ≥1</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Expected acceptance (averaged over prefixes)</span>
<span class="cs-line cmt"># alpha = E[acceptance_rate] in (0, 1)</span>
<span class="cs-line cmt"># TAR(gamma) = (1 - alpha^(gamma+1)) / (1-alpha)</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-alpha">
      <pre class="cs-pre">
<span class="cs-line cmt"># SDSL Affine alpha law (Eq. 5)</span>
<span class="cs-line cmt"># x = draft perplexity</span>
<span class="cs-line cmt"># y = target perplexity</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p">A, B, C = -0.0067, 0.01297, 0.6421</span>
<span class="cs-line"> </span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">predict_alpha</span>(draft_ppl, target_ppl):</span>
<span class="cs-line">  <span class="kw">return</span> A * draft_ppl \</span>
<span class="cs-line">       + B * target_ppl + C</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Examples from Table 1:</span>
<span class="cs-line cmt"># LLaMA3.1-70B target (ppl≈11.1)</span>
<span class="cs-line"> </span>
<span class="cs-line">  <span class="cmt"># OPT-125M draft (ppl=29.8)</span></span>
<span class="cs-line">  <span class="fn">predict_alpha</span>(29.8, 11.1)</span>
<span class="cs-line hl-a">  <span class="cmt"># → 0.609  (measured: 0.606 ± 0.0018)</span></span>
<span class="cs-line"> </span>
<span class="cs-line">  <span class="cmt"># Qwen2.5-3B draft (ppl=12.6)</span></span>
<span class="cs-line">  <span class="fn">predict_alpha</span>(12.6, 11.1)</span>
<span class="cs-line hl-g">  <span class="cmt"># → 0.712  (measured: 0.715 ± 0.0011)</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Key: B/|A| = 1.9× → draft PPL</span>
<span class="cs-line cmt"># contributes ~2× more than target PPL</span>
<span class="cs-line cmt"># per unit of perplexity change.</span>
<span class="cs-line cmt"># But target PPL range (9-16) is much</span>
<span class="cs-line cmt"># smaller than draft PPL range (12-30).</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-throughput">
      <pre class="cs-pre">
<span class="cs-line cmt"># Throughput at optimal gamma (Eq. 4)</span>
<span class="cs-line cmt"># tokens per FLOP</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">throughput</span>(M, N, alpha):</span>
<span class="cs-line hl-p">  <span class="cmt"># M = target params, N = draft params</span></span>
<span class="cs-line hl-p">  <span class="cmt"># Requires N &lt; M</span></span>
<span class="cs-line">  r = M / N          <span class="cmt"># size ratio</span></span>
<span class="cs-line">  a = alpha</span>
<span class="cs-line">  <span class="cmt"># Lambert W arg (W_&#123;-1&#125; branch)</span></span>
<span class="cs-line hl-c">  x = -(a ** (r - 1)) / math.e</span>
<span class="cs-line hl-c">  W = <span class="fn">lambert_w_neg1</span>(x)</span>
<span class="cs-line">  numer = -<span class="fn">log</span>(a)</span>
<span class="cs-line">  denom = 2 * N * (a - 1) * W</span>
<span class="cs-line">  <span class="kw">return</span> numer / denom</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># N* maximizes throughput(M, N, alpha(N))</span>
<span class="cs-line cmt"># where alpha(N) comes from pre-training</span>
<span class="cs-line cmt"># scaling laws for perplexity</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># For OPT-13B (M=13B):</span>
<span class="cs-line">N_values = [0.125, 0.35, 1.3, 2.7]  <span class="cmt"># B</span></span>
<span class="cs-line">T_values = [<span class="fn">throughput</span>(13e9, N*1e9, ...)</span>
<span class="cs-line">             <span class="kw">for</span> N <span class="kw">in</span> N_values]</span>
<span class="cs-line hl-g"><span class="cmt"># peak at N≈0.117B → N* confirmed</span></span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-rule">
      <pre class="cs-pre">
<span class="cs-line cmt"># SDSL Scaling Law (Eq. 11)</span>
<span class="cs-line cmt"># Fit over all (M, D, D') configurations</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p">mu = 2.71e-3    <span class="cmt"># asymptotic ratio</span></span>
<span class="cs-line hl-p">M0 = 87.1e6     <span class="cmt"># finite-size offset</span></span>
<span class="cs-line"> </span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">optimal_draft_size</span>(M):</span>
<span class="cs-line">  <span class="kw">return</span> mu * M + M0</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Examples:</span>
<span class="cs-line"><span class="fn">optimal_draft_size</span>(13e9)   <span class="cmt"># → 122M</span></span>
<span class="cs-line"><span class="fn">optimal_draft_size</span>(30e9)   <span class="cmt"># → 168M</span></span>
<span class="cs-line"><span class="fn">optimal_draft_size</span>(70e9)   <span class="cmt"># → 277M</span></span>
<span class="cs-line"><span class="fn">optimal_draft_size</span>(110e9)  <span class="cmt"># → 385M</span></span>
<span class="cs-line"><span class="fn">optimal_draft_size</span>(405e9)  <span class="cmt"># → 1.18B</span></span>

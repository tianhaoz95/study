<span class="cs-line cmt"># Full attention: O(L²) complexity</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># At context length L, attention head dim d:</span>
<span class="cs-line cmt">#   QK^T  → L×L matrix  = L² dot products</span>
<span class="cs-line cmt">#   cost grows quadratically with sequence len</span>
<span class="cs-line"></span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">full_attn_flops</span>(L, d, num_heads):</span>
<span class="cs-line hl-p">    <span class="cmt"># QK^T: L×d · d×L = L² per head</span></span>
<span class="cs-line hl-p">    qkt = L * L * d * num_heads</span>
<span class="cs-line hl-p">    <span class="kw">return</span> qkt  <span class="cmt"># × 2 for FMA</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Concrete numbers:</span>
<span class="cs-line">L_8K  = <span class="num">8192</span>;  L_128K = <span class="num">131072</span></span>
<span class="cs-line">ratio = (L_128K / L_8K) ** <span class="num">2</span>  <span class="cmt"># = 256×</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># 128K tokens: 131072² ≈ 17.2 billion QK pairs</span>
<span class="cs-line cmt"># per layer, per forward pass, per attention head</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Block-wise sparse attention target:</span>
<span class="cs-line hl-c"><span class="kw">def</span> <span class="fn">sparse_attn_flops</span>(L, B, rho):</span>
<span class="cs-line hl-c">    <span class="cmt"># rho = sparsity (fraction of blocks skipped)</span></span>
<span class="cs-line hl-c">    Nb = L // B  <span class="cmt"># number of blocks</span></span>
<span class="cs-line hl-c">    kept = (1 - rho) * Nb * Nb</span>
<span class="cs-line hl-c">    <span class="kw">return</span> kept * B * B  <span class="cmt"># token-level ops</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># At 50% sparsity: half the blocks, half the cost</span>
<span class="cs-line cmt"># Challenge: how to PICK which blocks to keep?</span>
      </pre>
    </div>

    <!-- panel: tradeoffs -->
    <div class="cs-panel" id="panel-tradeoffs">
      <pre class="cs-pre">
<span class="cs-line cmt"># FlexPrefill: uses last query block only</span>
<span class="cs-line cmt">#   ✓ query-independent  ✗ not global</span>
<span class="cs-line"></span>
<span class="cs-line hl-a"><span class="kw">def</span> <span class="fn">flexprefill_importance</span>(Q, K, S):</span>
<span class="cs-line hl-a">    q_last = Q[-S:]  <span class="cmt"># only last stride!</span></span>
<span class="cs-line hl-a">    scores = q_last @ K.T  <span class="cmt"># local estimate</span></span>
<span class="cs-line hl-a">    <span class="kw">return</span> scores  <span class="cmt"># misses earlier patterns</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># XAttention: anti-diagonal aggregation</span>
<span class="cs-line cmt">#   ✓ global  ✗ mixes query distributions</span>
<span class="cs-line"></span>
<span class="cs-line hl-c"><span class="kw">def</span> <span class="fn">xattention_importance</span>(Q, K, S):</span>
<span class="cs-line hl-c">    <span class="cmt"># sum anti-diagonal elements across queries</span></span>
<span class="cs-line hl-c">    scores = <span class="fn">antidiag_sum</span>(Q, K, S)</span>
<span class="cs-line hl-c">    <span class="cmt"># PROBLEM: mixes Q[0]·K[j] + Q[1]·K[j-1]</span></span>
<span class="cs-line hl-c">    <span class="cmt"># different queries' signals contaminate each other</span></span>
<span class="cs-line hl-c">    <span class="kw">return</span> scores</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># RRAttention: both global AND independent</span>
<span class="cs-line cmt">#   ✓ global (different positions per head)</span>
<span class="cs-line cmt">#   ✓ query-independent (one query per stride/head)</span>
<span class="cs-line"></span>
<span class="cs-line hl-g"><span class="kw">def</span> <span class="fn">rr_importance</span>(Q, K, S, h):</span>
<span class="cs-line hl-g">    <span class="cmt"># each stride: one query, chosen by head index</span></span>
<span class="cs-line hl-g">    pos = [(i*S + S-<span class="num">1</span> - (h % S))</span></span>
<span class="cs-line hl-g">           <span class="kw">for</span> i <span class="kw">in</span> <span class="fn">range</span>(L // S)]</span>
<span class="cs-line hl-g">    <span class="kw">return</span> Q[pos] @ K.T  <span class="cmt"># no mixing!</span></span>
      </pre>
    </div>

    <!-- panel: roundrobin -->
    <div class="cs-panel" id="panel-roundrobin">
      <pre class="cs-pre">
<span class="cs-line cmt"># Head Round-Robin Sampling Strategy</span>
<span class="cs-line cmt"># S = stride size (default 8 in experiments)</span>
<span class="cs-line"></span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">sample_position</span>(stride_i, head_h, S):</span>
<span class="cs-line hl-p">    <span class="cmt"># which token in stride i does head h sample?</span></span>
<span class="cs-line hl-p">    offset = S - <span class="num">1</span> - (head_h % S)</span>
<span class="cs-line hl-p">    <span class="kw">return</span> stride_i * S + offset</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Example: S=4, first stride (i=0)</span>
<span class="cs-line cmt">#  Head 0  offset=3  → samples token 3</span>
<span class="cs-line cmt">#  Head 1  offset=2  → samples token 2</span>
<span class="cs-line cmt">#  Head 2  offset=1  → samples token 1</span>
<span class="cs-line cmt">#  Head 3  offset=0  → samples token 0</span>
<span class="cs-line cmt"># All 4 positions covered — full information!</span>
<span class="cs-line"></span>
<span class="cs-line hl-c"><span class="kw">def</span> <span class="fn">build_sample_set</span>(L, S, head_h):</span>
<span class="cs-line hl-c">    <span class="cmt"># one query per stride for this head</span></span>
<span class="cs-line hl-c">    <span class="kw">return</span> [<span class="fn">sample_position</span>(i, head_h, S)</span>
<span class="cs-line hl-c">            <span class="kw">for</span> i <span class="kw">in</span> <span class="fn">range</span>(L // S)]</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Why this catches vertical/slash patterns:</span>
<span class="cs-line cmt"># - Vertical: some key pos j is important for all</span>
<span class="cs-line cmt">#   queries → any sampled head will see it</span>
<span class="cs-line cmt"># - Slash: important block follows diagonal</span>
<span class="cs-line cmt">#   → varied offsets intersect diagonal naturally</span>
<span class="cs-line"></span>
<span class="cs-line hl-g">num_sample_queries = L // S</span>
<span class="cs-line hl-g"><span class="cmt"># vs full attention: L queries</span></span>
<span class="cs-line hl-g"><span class="cmt"># S× cheaper per head for importance estimation</span></span>
      </pre>
    </div>

    <!-- panel: algorithm -->
    <div class="cs-panel" id="panel-algorithm">
      <pre class="cs-pre">
<span class="cs-line cmt"># Full RRAttention pipeline (per layer, per head)</span>
<span class="cs-line"></span>
<span class="cs-line hl-p"><span class="cmt"># Stage 1: Query sampling</span></span>
<span class="cs-line hl-p">sample_pos = <span class="fn">build_sample_set</span>(L, S, h)</span>
<span class="cs-line hl-p">Q_s = Q[sample_pos]  <span class="cmt"># shape: (L/S, d)</span></span>
<span class="cs-line"></span>
<span class="cs-line hl-c"><span class="cmt"># Stage 2: Stride-level importance estimation</span></span>
<span class="cs-line hl-c"><span class="cmt"># Aggregate keys within each stride</span></span>
<span class="cs-line hl-c">K_agg = K.<span class="fn">reshape</span>(L//S, S, d).<span class="fn">sum</span>(dim=<span class="num">1</span>)</span>
<span class="cs-line hl-c">I = Q_s @ K_agg.T / (S * d**<span class="num">0.5</span>)  <span class="cmt"># (L/S)²</span></span>
<span class="cs-line hl-c">P = <span class="fn">softmax</span>(I, dim=-<span class="num">1</span>)  <span class="cmt"># row-wise</span></span>
<span class="cs-line cmt"># complexity: O(L²/S²) vs O(L²)</span>
<span class="cs-line"></span>
<span class="cs-line hl-g"><span class="cmt"># Stage 3: Top-τ block selection</span></span>
<span class="cs-line hl-g"><span class="kw">for</span> q_block <span class="kw">in</span> query_blocks:</span>

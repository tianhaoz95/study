<span class="cs-line hl-g">recovery = <span class="num">56.24</span> / <span class="num">56.42</span>  <span class="cmt"># = 99.68%</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Aggressive setting (τ=0.90 / γ=0.95):</span>
<span class="cs-line cmt"># RRAttention 55.67 vs XAttention 54.82</span>
<span class="cs-line cmt"># gap widens when sparsity is pushed harder</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Qwen — similar story:</span>
<span class="cs-line">qwen = {</span>
<span class="cs-line">    <span class="str">"FullAttention"</span>: <span class="num">47.68</span>,</span>
<span class="cs-line">    <span class="str">"FlexPrefill"</span>:   <span class="num">45.45</span>,</span>
<span class="cs-line">    <span class="str">"XAttention"</span>:    <span class="num">46.64</span>,</span>
<span class="cs-line hl-g">    <span class="str">"RRAttention"</span>:   <span class="num">47.17</span>,</span>
<span class="cs-line">}  <span class="cmt"># recovers 99.0% of full attention</span></span>
      </pre>
    </div>

  </div>
</aside>

</div><!-- /post-grid -->

<script>
/* ── TOC + sidebar toggles ────────────────────────────────────────────── */
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});
const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

/* ── Code sidebar tab switching ───────────────────────────────────────── */
const tabMeta = {
  problem:    { file: 'rrattn/complexity.py',   title: 'The O(L²) Problem' },
  tradeoffs:  { file: 'rrattn/comparison.py',   title: 'Five-Dimension Space' },
  roundrobin: { file: 'rrattn/sampling.py',     title: 'Round-Robin Sampling' },
  algorithm:  { file: 'rrattn/pipeline.py',     title: 'Three-Stage Pipeline' },
  efficiency: { file: 'rrattn/benchmarks.py',   title: '2.4× Speedup' },
  results:    { file: 'rrattn/results.py',       title: 'Benchmark Results' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

/* ── IntersectionObserver — sync TOC + tab on scroll ─────────────────── */
const sectionMap = {
  's-problem':    'problem',
  's-tradeoffs':  'tradeoffs',
  's-roundrobin': 'roundrobin',
  's-algorithm':  'algorithm',
  's-efficiency': 'efficiency',
  's-results':    'results',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

/* ── §01 Cost canvas — O(L²) vs sparse ──────────────────────────────── */
(function() {
  const canvas = document.getElementById('cost-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 220;
  canvas.width = W * DPR; canvas.height = H * DPR;
  ctx.scale(DPR, DPR);

  const PAD = { l: 56, r: 20, t: 20, b: 36 };
  const cW = W - PAD.l - PAD.r;
  const cH = H - PAD.t - PAD.b;

  const lengths = [8, 16, 32, 48, 64, 80, 96, 112, 128]; // K tokens
  const maxL = 128;
  // Full: quadratic, normalized to 1 at 128K
  const full  = lengths.map(l => (l / maxL) ** 2);
  // Sparse (50% blocks): half of full
  const sparse = lengths.map(l => (l / maxL) ** 2 * 0.5);

  function xp(l) { return PAD.l + (l / maxL) * cW; }
  function yp(v) { return PAD.t + cH - v * cH; }

  // Grid lines
  ctx.strokeStyle = 'rgba(255,255,255,0.05)';
  ctx.lineWidth = 1;
  [0.25, 0.5, 0.75, 1.0].forEach(v => {
    ctx.beginPath();
    ctx.moveTo(PAD.l, yp(v));
    ctx.lineTo(PAD.l + cW, yp(v));
    ctx.stroke();
  });

  // Axes
  ctx.strokeStyle = 'rgba(255,255,255,0.15)';
  ctx.beginPath();
  ctx.moveTo(PAD.l, PAD.t);
  ctx.lineTo(PAD.l, PAD.t + cH);
  ctx.lineTo(PAD.l + cW, PAD.t + cH);
  ctx.stroke();

  // X labels
  ctx.fillStyle = '#5c6370';
  ctx.font = `${11 * DPR / DPR}px monospace`;
  ctx.textAlign = 'center';
  [8, 32, 64, 96, 128].forEach(l => {
    ctx.fillText(l + 'K', xp(l), H - 8);
  });

  // Full attention curve (red)
  ctx.beginPath();
  ctx.strokeStyle = '#f87171';
  ctx.lineWidth = 2.5;
  lengths.forEach((l, i) => {
    if (i === 0) ctx.moveTo(xp(l), yp(full[i]));
    else ctx.lineTo(xp(l), yp(full[i]));
  });
  ctx.stroke();

  // Sparse curve (purple)
  ctx.beginPath();
  ctx.strokeStyle = '#8b5cf6';
  ctx.lineWidth = 2.5;
  ctx.setLineDash([5, 3]);
  lengths.forEach((l, i) => {
    if (i === 0) ctx.moveTo(xp(l), yp(sparse[i]));
    else ctx.lineTo(xp(l), yp(sparse[i]));
  });
  ctx.stroke();
  ctx.setLineDash([]);

  // Labels
  ctx.font = `${11 * DPR / DPR}px monospace`;
  ctx.textAlign = 'left';
  ctx.fillStyle = '#f87171';
  ctx.fillText('Full attention  O(L²)', xp(32), yp(full[3]) - 8);
  ctx.fillStyle = '#8b5cf6';
  ctx.fillText('Sparse (50% blocks skipped)', xp(48), yp(sparse[4]) + 16);

  // 2.4× annotation at 128K
  const x128 = xp(128);
  ctx.strokeStyle = 'rgba(255,255,255,0.2)';
  ctx.lineWidth = 1;
  ctx.setLineDash([3, 3]);
  ctx.beginPath();
  ctx.moveTo(x128, yp(full[8]));
  ctx.lineTo(x128, yp(sparse[8]));
  ctx.stroke();
  ctx.setLineDash([]);
  ctx.fillStyle = '#a1a1aa';
  ctx.textAlign = 'right';
  ctx.fillText('2.4×', x128 - 4, (yp(full[8]) + yp(sparse[8])) / 2 + 4);
})();

/* ── §03 Round-Robin Canvas ──────────────────────────────────────────── */
(function() {
  const canvas = document.getElementById('rr-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 260;
  canvas.width = W * DPR; canvas.height = H * DPR;
  ctx.scale(DPR, DPR);

  const S = 4; // stride size
  const NUM_STRIDES = 5;
  const NUM_HEADS = 4;
  const CELL = Math.min(38, Math.floor((W - 80) / (S * NUM_STRIDES)));
  const TOKEN_W = CELL;
  const TOKEN_H = 26;
  const PAD_L = 72;
  const PAD_T = 30;
  const HEAD_GAP = 8;
  const STRIDE_GAP = 6;
  const ROW_H = TOKEN_H + HEAD_GAP;

  // Colors per head
  const headColors = ['#8b5cf6','#06b6d4','#10b981','#f59e0b'];
  const headNames  = ['Head 0','Head 1','Head 2','Head 3'];

  let activeHead = -1; // -1 = all

  function draw() {
    ctx.clearRect(0, 0, W, H);

    // Column header: stride labels
    ctx.fillStyle = '#5c6370';
    ctx.font = `${10 * DPR / DPR}px monospace`;
    ctx.textAlign = 'center';
    for (let si = 0; si < NUM_STRIDES; si++) {
      const sx = PAD_L + si * (S * TOKEN_W + STRIDE_GAP) + (S * TOKEN_W) / 2;
      ctx.fillText('Stride ' + si, sx, PAD_T - 10);
    }

    // Head rows
    for (let h = 0; h < NUM_HEADS; h++) {
      const y = PAD_T + h * ROW_H * 1.5;
      const isActive = activeHead === -1 || activeHead === h;
      const alpha = isActive ? 1.0 : 0.18;

      // Head label
      ctx.globalAlpha = alpha;
      ctx.fillStyle = headColors[h];
      ctx.textAlign = 'right';
      ctx.font = `bold ${10 * DPR / DPR}px monospace`;
      ctx.fillText(headNames[h], PAD_L - 8, y + TOKEN_H / 2 + 4);

      for (let si = 0; si < NUM_STRIDES; si++) {
        const baseX = PAD_L + si * (S * TOKEN_W + STRIDE_GAP);
        // Sampled offset for this head: S-1 - (h mod S)
        const sampledOffset = S - 1 - (h % S);

        for (let pos = 0; pos < S; pos++) {
          const x = baseX + pos * TOKEN_W;
          const isSampled = pos === sampledOffset;

          // Token cell background
          if (isSampled && isActive) {
            ctx.fillStyle = headColors[h];
            ctx.globalAlpha = alpha;
          } else {
            ctx.fillStyle = 'rgba(255,255,255,0.04)';
            ctx.globalAlpha = isActive ? 0.8 : 0.12;
          }
          ctx.beginPath();
          ctx.roundRect(x + 1, y, TOKEN_W - 2, TOKEN_H, 3);
          ctx.fill();

          // Border
          ctx.strokeStyle = isSampled && isActive ? headColors[h] : 'rgba(255,255,255,0.08)';
          ctx.lineWidth = isSampled && isActive ? 1.5 : 0.5;
          ctx.globalAlpha = isActive ? 0.9 : 0.12;
          ctx.beginPath();
          ctx.roundRect(x + 1, y, TOKEN_W - 2, TOKEN_H, 3);
          ctx.stroke();

          // Position label inside cell
          ctx.globalAlpha = isActive ? 1 : 0.15;
          ctx.fillStyle = isSampled ? '#fff' : '#5c6370';
          ctx.textAlign = 'center';
          ctx.font = `${9 * DPR / DPR}px monospace`;
          ctx.fillText('t' + pos, x + TOKEN_W / 2, y + TOKEN_H / 2 + 3);
        }
      }
      ctx.globalAlpha = 1;
    }

    // Legend: "sampled" indicator
    ctx.globalAlpha = 1;
    ctx.fillStyle = '#71717a';
    ctx.textAlign = 'left';
    ctx.font = `${10 * DPR / DPR}px monospace`;
    ctx.fillText('filled = sampled by this head', PAD_L, H - 8);

    // Show sampling formula for active head
    if (activeHead >= 0) {
      const h = activeHead;
      const offset = S - 1 - (h % S);
      ctx.fillStyle = headColors[h];
      ctx.textAlign = 'right';
      ctx.font = `${10 * DPR / DPR}px monospace`;
      ctx.fillText(`P(i,${h}) = i×${S} + ${offset}  (offset=${offset})`, W - 10, H - 8);
    } else {
      ctx.fillStyle = '#71717a';
      ctx.textAlign = 'right';
      ctx.font = `${10 * DPR / DPR}px monospace`;
      ctx.fillText('all 4 positions covered across 4 heads', W - 10, H - 8);
    }
  }

  draw();

  // Button handlers
  document.getElementById('hb-all')?.addEventListener('click', function() {
    activeHead = -1;
    document.querySelectorAll('.head-btn').forEach(b => b.classList.remove('active'));
    this.classList.add('active');
    document.getElementById('rr-caption').textContent = 'Each head independently estimates importance from its own query — no cross-head mixing.';
    draw();
  });
  [0,1,2,3].forEach(h => {
    document.getElementById('hb-' + h)?.addEventListener('click', function() {
      activeHead = h;
      document.querySelectorAll('.head-btn').forEach(b => b.classList.remove('active'));
      this.classList.add('active');
      const offset = S - 1 - (h % S);
      document.getElementById('rr-caption').textContent =
        `Head ${h} samples position ${offset} within each stride (t${offset} highlighted). One clean, independent estimate.`;
      draw();
    });
  });
})();

/* ── §04 Step navigator ──────────────────────────────────────────────── */
(function() {
  let step = 0;
  const boxes   = document.querySelectorAll('.step-box');
  const prevBtn = document.getElementById('step-prev');
  const nextBtn = document.getElementById('step-next');
  const progEl  = document.getElementById('step-prog');
  function updateSteps() {
    boxes.forEach((b, i) => {
      b.classList.remove('active', 'done');
      if (i === step) b.classList.add('active');
      else if (i < step) b.classList.add('done');
    });
    if (prevBtn) prevBtn.disabled = step === 0;
    if (nextBtn) nextBtn.disabled = step === boxes.length - 1;
    if (progEl)  progEl.textContent = 'Step ' + (step + 1) + ' of ' + boxes.length;
    boxes.forEach((b, i) => {
      const n = b.querySelector('.step-num');
      if (n) n.textContent = i < step ? '✓' : String(i + 1);
    });
  }
  prevBtn?.addEventListener('click', () => { if (step > 0) { step--; updateSteps(); } });
  nextBtn?.addEventListener('click', () => { if (step < boxes.length - 1) { step++; updateSteps(); } });
  updateSteps();
})();

/* ── §05 Timing canvas ────────────────────────────────────────────────── */
(function() {
  const canvas = document.getElementById('timing-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 240;
  canvas.width = W * DPR; canvas.height = H * DPR;
  ctx.scale(DPR, DPR);

  const PAD = { l: 64, r: 20, t: 20, b: 36 };
  const cW = W - PAD.l - PAD.r;
  const cH = H - PAD.t - PAD.b;

  // Context lengths and timing data (ms, approx from paper Figure 3)
  const ctxLens  = [8,  16,  32,   48,   64,   80,    96,    112,   128];
  const tFull    = [55, 200, 750,  1800, 3500, 5800,  8200,  10200, 12000];
  const tFlex    = [55, 195, 730,  1750, 3420, 5650,  8000,  9900,  11200];
  const tXAttn   = [52, 175, 600,  1350, 2600, 4000,  5000,  5900,  6840];
  const tRR      = [50, 165, 560,  1200, 2200, 3200,  3900,  4500,  4935];
  const maxT = 12000;

  function xp(l) { return PAD.l + ((l - 8) / (128 - 8)) * cW; }
  function yp(t) { return PAD.t + cH - (t / maxT) * cH; }

  // Grid
  ctx.strokeStyle = 'rgba(255,255,255,0.05)';
  ctx.lineWidth = 1;
  [3000, 6000, 9000, 12000].forEach(t => {
    ctx.beginPath();
    ctx.moveTo(PAD.l, yp(t));
    ctx.lineTo(PAD.l + cW, yp(t));
    ctx.stroke();
    ctx.fillStyle = '#5c6370';
    ctx.font = `${10 * DPR / DPR}px monospace`;
    ctx.textAlign = 'right';
    ctx.fillText((t / 1000) + 's', PAD.l - 4, yp(t) + 4);
  });

  // Axes
  ctx.strokeStyle = 'rgba(255,255,255,0.15)';
  ctx.lineWidth = 1;
  ctx.beginPath();
  ctx.moveTo(PAD.l, PAD.t);
  ctx.lineTo(PAD.l, PAD.t + cH);
  ctx.lineTo(PAD.l + cW, PAD.t + cH);
  ctx.stroke();

  // X labels
  ctx.fillStyle = '#5c6370';
  ctx.textAlign = 'center';
  ctx.font = `${10 * DPR / DPR}px monospace`;
  [8, 32, 64, 96, 128].forEach(l => {
    ctx.fillText(l + 'K', xp(l), H - 8);
  });

  function drawLine(data, color, dashed) {
    ctx.beginPath();
    ctx.strokeStyle = color;
    ctx.lineWidth = 2;
    if (dashed) ctx.setLineDash([5, 3]);
    else ctx.setLineDash([]);
    ctxLens.forEach((l, i) => {
      if (i === 0) ctx.moveTo(xp(l), yp(data[i]));
      else ctx.lineTo(xp(l), yp(data[i]));
    });
    ctx.stroke();
    ctx.setLineDash([]);
  }

  drawLine(tFull,  '#f87171', false);
  drawLine(tFlex,  '#a1a1aa', true);
  drawLine(tXAttn, '#06b6d4', false);
  drawLine(tRR,    '#8b5cf6', false);

  // Labels at right edge
  const rightX = xp(128) + 4;
  ctx.textAlign = 'left';
  ctx.font = `${10 * DPR / DPR}px monospace`;
  ctx.fillStyle = '#f87171'; ctx.fillText('Full',         rightX, yp(tFull[8])  + 3);
  ctx.fillStyle = '#a1a1aa'; ctx.fillText('FlexPrefill',  rightX, yp(tFlex[8])  - 6);
  ctx.fillStyle = '#06b6d4'; ctx.fillText('XAttention',   rightX, yp(tXAttn[8]) + 3);
  ctx.fillStyle = '#8b5cf6'; ctx.fillText('RRAttention',  rightX, yp(tRR[8])    + 3);

  // 2.4× annotation
  const x128 = xp(128);
  ctx.strokeStyle = 'rgba(255,255,255,0.2)';
  ctx.lineWidth = 1;
  ctx.setLineDash([3, 3]);
  ctx.beginPath();
  ctx.moveTo(x128 - 22, yp(tFull[8]));
  ctx.lineTo(x128 - 22, yp(tRR[8]));
  ctx.stroke();
  ctx.setLineDash([]);
  ctx.fillStyle = '#e2e8f0';
  ctx.textAlign = 'right';
  ctx.font = `bold ${11 * DPR / DPR}px monospace`;
  ctx.fillText('2.4×', x128 - 26, (yp(tFull[8]) + yp(tRR[8])) / 2 + 4);
})();

/* ── §06 Animated bar chart ───────────────────────────────────────────── */
(function() {
  const resultsSection = document.getElementById('s-results');
  if (!resultsSection) return;
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          b.style.width = (parseFloat(b.dataset.w)) + '%';
        });
      }
    });
  }, { threshold: 0.3 }).observe(resultsSection);
})();
</script>
</BaseLayout>

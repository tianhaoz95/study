      <td style="color:var(--red,#f87171)">✗</td>
      <td style="color:var(--green)">✓</td>
      <td style="color:var(--red,#f87171)">✗</td>
      <td><span class="mn">Token</span></td>
    </tr>
    <tr>
      <td><span class="mn">XAttention</span></td>
      <td style="color:var(--green)">✓</td>
      <td style="color:var(--green)">✓</td>
      <td style="color:var(--red,#f87171)">✗</td>
      <td style="color:var(--green)">✓</td>
      <td><span class="mn">Stride</span></td>
    </tr>
    <tr class="highlight-row">
      <td><strong>RRAttention</strong></td>
      <td style="color:var(--green)">✓</td>
      <td style="color:var(--green)">✓</td>
      <td style="color:var(--green)">✓</td>
      <td style="color:var(--green)">✓</td>
      <td><span class="mn best">Stride</span></td>
    </tr>

<span class="cs-line hl-g">    sorted_keys  = <span class="fn">argsort</span>(block_scores, desc)</span>
<span class="cs-line hl-g">    cumsum = <span class="fn">cumsum</span>(block_scores[sorted_keys])</span>
<span class="cs-line hl-g">    keep = sorted_keys[cumsum &lt;= tau]</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Always protect final query block:</span>
<span class="cs-line">B_final = B_dynamic | B_static_last_block</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Actual sparse attention with selected blocks</span>
<span class="cs-line">out = <span class="fn">sparse_flash_attn</span>(Q, K, V, B_final)</span>
      </pre>
    </div>


<span class="cs-line"></span>
<span class="cs-line hl-c">  # Zone 2: Dissect Zone (deep learning)</span>
<span class="cs-line hl-c">  elif task.complex and mastery.low:</span>
<span class="cs-line hl-c">    # Let AI generate a solution</span>
<span class="cs-line hl-c">    # Read every line carefully</span>
<span class="cs-line hl-c">    # Rebuild it from scratch after</span>
<span class="cs-line hl-c">    return Strategy.DISSECT</span>
<span class="cs-line"></span>
<span class="cs-line hl-g">  # Zone 3: Delegation Zone (leverage)</span>
<span class="cs-line hl-g">  elif task.simple and mastery.high:</span>
<span class="cs-line hl-g">    # Fully delegate to AI</span>
<span class="cs-line hl-g">    # Review output for correctness</span>
<span class="cs-line hl-g">    # This is the productivity win</span>
<span class="cs-line hl-g">    return Strategy.DELEGATE</span>
<span class="cs-line"></span>
<span class="cs-line cmt">  # Zone 4: Collaboration Zone (mastery)</span>
<span class="cs-line">  else:  </span><span class="cs-line cmt"># complex + high mastery</span>
<span class="cs-line">    </span><span class="cs-line cmt"># YOU lead the architecture</span>
<span class="cs-line">    </span><span class="cs-line cmt"># AI implements your spec</span>
<span class="cs-line">    </span><span class="cs-line cmt"># Review rigorously for edge cases</span>
<span class="cs-line">    return Strategy.COLLABORATE</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Key rule:</span>
<span class="cs-line cmt"># If you can't explain AI output</span>
<span class="cs-line cmt"># in plain English → not ready to</span>
<span class="cs-line cmt"># delegate that task yet.</span>

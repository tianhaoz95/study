<script>
// ── TOC + sidebar toggles ──────────────────────────
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});

const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ── Code sidebar tab switching ─────────────────────
const tabMeta = {
  paradox:   { file: 'guide/overview.md',    title: 'The Paradox' },
  evidence:  { file: 'research/papers.md',   title: 'Research Evidence' },
  patterns:  { file: 'guide/patterns.md',    title: 'Interaction Patterns' },
  skills:    { file: 'guide/skills.md',      title: 'Skills Taxonomy' },
  framework: { file: 'guide/framework.py',   title: 'Decision Framework' },
  plan:      { file: 'guide/90day-plan.md',  title: '90-Day Plan' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ── IntersectionObserver — TOC + sidebar sync ──────
const sectionMap = {
  's-paradox':   'paradox',
  's-evidence':  'evidence',
  's-patterns':  'patterns',
  's-skills':    'skills',
  's-framework': 'framework',
  's-plan':      'plan',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.25 }).observe(s)
);

// ── Trajectory Canvas ──────────────────────────────
(function() {
  const canvas = document.getElementById('traj-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth;
  const H = 280;
  canvas.width  = W * DPR;
  canvas.height = H * DPR;
  ctx.scale(DPR, DPR);

  // Control points: [month, skill 0-100]
  const paths = {
    sam:  [[0,20],[3,40],[6,52],[12,72],[24,88]],
    alex: [[0,20],[3,55],[6,60],[12,58],[24,52]],
    noai: [[0,20],[3,30],[6,42],[12,60],[24,75]],
  };

  const ML = 58, MR = 18, MT = 22, MB = 46;
  const PW = W - ML - MR;
  const PH = H - MT - MB;
  const maxMonth = 24;
  const maxSkill = 100;

  function mx(month) { return ML + (month / maxMonth) * PW; }
  function my(skill) { return MT + PH - (skill / maxSkill) * PH; }

  function interpPath(pts, month) {
    for (let i = 0; i < pts.length - 1; i++) {
      if (month >= pts[i][0] && month <= pts[i+1][0]) {
        const t = (month - pts[i][0]) / (pts[i+1][0] - pts[i][0]);
        const et = t * t * (3 - 2 * t);
        return pts[i][1] + (pts[i+1][1] - pts[i][1]) * et;
      }
    }
    return pts[pts.length-1][1];
  }

  function drawSmooth(pts, upToMonth) {
    ctx.beginPath();
    const steps = 120;
    let started = false;
    for (let i = 0; i <= steps; i++) {
      const m = (i / steps) * upToMonth;
      const s = interpPath(pts, m);
      const x = mx(m), y = my(s);
      if (!started) { ctx.moveTo(x, y); started = true; }
      else ctx.lineTo(x, y);
    }
    ctx.stroke();
  }

  let currentMonth = 0;
  let animStart = null;
  let animFrom = 0;
  let animTo = 0;
  let animating = false;

  function draw(month) {
    ctx.clearRect(0, 0, W, H);

    // Grid
    ctx.strokeStyle = 'rgba(255,255,255,0.05)';
    ctx.lineWidth = 1;
    for (let m of [0, 6, 12, 18, 24]) {
      const x = mx(m);
      ctx.beginPath(); ctx.moveTo(x, MT); ctx.lineTo(x, MT + PH); ctx.stroke();
      ctx.fillStyle = 'rgba(255,255,255,0.3)';
      ctx.font = `${10 * DPR / DPR}px var(--ff-mono, monospace)`;
      ctx.textAlign = 'center';
      ctx.fillText(m === 0 ? 'now' : m + 'mo', x, MT + PH + 18);
    }
    for (let s of [25, 50, 75, 100]) {
      const y = my(s);
      ctx.beginPath(); ctx.moveTo(ML, y); ctx.lineTo(ML + PW, y); ctx.stroke();
      ctx.fillStyle = 'rgba(255,255,255,0.3)';
      ctx.font = `${9 * DPR / DPR}px var(--ff-mono, monospace)`;
      ctx.textAlign = 'right';
      ctx.fillText(s + '%', ML - 6, y + 3.5);
    }

    // Axis labels
    ctx.fillStyle = 'rgba(255,255,255,0.35)';
    ctx.font = `bold ${10 * DPR / DPR}px var(--ff-mono, monospace)`;
    ctx.textAlign = 'center';
    ctx.fillText('months from today', ML + PW / 2, H - 6);
    ctx.save(); ctx.translate(12, MT + PH / 2); ctx.rotate(-Math.PI / 2);
    ctx.fillText('skill level', 0, 0);
    ctx.restore();

    // Title
    ctx.fillStyle = 'rgba(255,255,255,0.4)';
    ctx.font = `bold ${10 * DPR / DPR}px var(--ff-mono, monospace)`;
    ctx.textAlign = 'left';

    const dm = Math.min(month, maxMonth);

    // No-AI path (faint reference)
    ctx.save();
    ctx.globalAlpha = 0.35;
    ctx.strokeStyle = '#6b7280';
    ctx.lineWidth = 1.5;
    ctx.setLineDash([4, 4]);
    drawSmooth(paths.noai, dm);
    ctx.setLineDash([]);
    ctx.restore();

    // Alex path (red/orange — passive)
    ctx.strokeStyle = 'rgba(239,68,68,0.85)';
    ctx.lineWidth = 2.5;
    drawSmooth(paths.alex, dm);

    // Sam path (green — deliberate)
    ctx.strokeStyle = 'rgba(16,185,129,0.9)';
    ctx.lineWidth = 2.5;
    drawSmooth(paths.sam, dm);

    // Endpoint dots + labels
    if (dm > 0) {
      const labels = [
        { pts: paths.sam,  color: '#10b981', name: 'Sam', sub: 'deliberate practice', offset: [-6, -14] },
        { pts: paths.alex, color: '#ef4444', name: 'Alex', sub: 'passive delegation', offset: [-6, 16] },
        { pts: paths.noai, color: '#6b7280', name: 'no AI', sub: '(reference)', offset: [8, 0] },
      ];
      labels.forEach(({ pts, color, name, sub, offset }) => {
        const s = interpPath(pts, dm);
        const x = mx(dm), y = my(s);
        ctx.beginPath();
        ctx.arc(x, y, 5, 0, Math.PI * 2);
        ctx.fillStyle = color;
        ctx.fill();
        ctx.fillStyle = color;
        ctx.font = `bold ${11 * DPR / DPR}px var(--ff-mono, monospace)`;
        ctx.textAlign = offset[0] < 0 ? 'right' : 'left';
        ctx.fillText(name, x + offset[0], y + offset[1]);
        ctx.font = `${9.5 * DPR / DPR}px var(--ff-mono, monospace)`;
        ctx.fillStyle = 'rgba(255,255,255,0.5)';
        ctx.fillText(sub, x + offset[0], y + offset[1] + 13);
      });
    }

    // Vertical "now" marker
    if (dm > 0 && dm < maxMonth) {
      const x = mx(dm);
      ctx.beginPath();
      ctx.setLineDash([3, 3]);
      ctx.strokeStyle = 'rgba(139,92,246,0.6)';
      ctx.lineWidth = 1;
      ctx.moveTo(x, MT); ctx.lineTo(x, MT + PH);
      ctx.stroke();
      ctx.setLineDash([]);
    }

    // Crossover annotation at 12 months
    if (dm >= 12) {
      const x = mx(12);
      const y = my(65);
      ctx.fillStyle = 'rgba(139,92,246,0.7)';
      ctx.font = `${9 * DPR / DPR}px var(--ff-mono, monospace)`;
      ctx.textAlign = 'center';
      ctx.fillText('Sam overtakes Alex', x, y);
      ctx.fillText('↓', x, y + 11);
    }
  }

  function animate(ts) {
    if (!animating) return;
    if (!animStart) animStart = ts;
    const elapsed = ts - animStart;
    const dur = 800;
    const t = Math.min(elapsed / dur, 1);
    const et = t < 0.5 ? 2*t*t : -1+(4-2*t)*t;
    const month = animFrom + (animTo - animFrom) * et;
    draw(month);
    if (t < 1) { requestAnimationFrame(animate); }
    else { currentMonth = animTo; animating = false; draw(currentMonth); }
  }

  function goTo(m) {
    animFrom = currentMonth;
    animTo = m;
    animStart = null;
    animating = true;
    requestAnimationFrame(animate);
  }

  // Buttons
  document.querySelectorAll('.traj-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.traj-btn').forEach(b => b.classList.remove('traj-active'));
      btn.classList.add('traj-active');
      goTo(parseInt(btn.dataset.month));
    });
  });

  draw(0);
})();

// ── Impact Bars (IntersectionObserver) ────────────
const impactSection = document.getElementById('impact-bars-section');
if (impactSection) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('#impact-bars-section .bar-fill[data-w]').forEach(b => {
          b.style.width = b.dataset.w + '%';
        });
      }
    });
  }, { threshold: 0.25 }).observe(impactSection);
}

// ── Automation Risk Chart (IntersectionObserver) ──
const autoSection = document.getElementById('auto-chart-section');
if (autoSection) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('#auto-chart-section .auto-fill[data-w]').forEach(b => {
          b.style.width = b.dataset.w + '%';
        });
      }
    });
  }, { threshold: 0.25 }).observe(autoSection);
}

// ── Decision Matrix Canvas ─────────────────────────
(function() {
  const canvas = document.getElementById('matrix-canvas');
  const descEl = document.getElementById('matrix-desc');
  const nameEl = document.getElementById('matrix-zone-name');
  const bodyEl = document.getElementById('matrix-zone-body');
  if (!canvas || !descEl) return;

  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth;
  const H = 340;
  canvas.width  = W * DPR;
  canvas.height = H * DPR;
  ctx.scale(DPR, DPR);

  const PAD = 16;
  const LABEL_W = 90;
  const LABEL_H = 30;
  const GW = W - PAD * 2 - LABEL_W;
  const GH = H - PAD * 2 - LABEL_H;
  const OX = PAD + LABEL_W;
  const OY = PAD;

  const zones = [
    {
      col: 0, row: 1,
      name: '🟠 Study Zone',
      color: 'rgba(245,158,11,',
      nameColor: '#f59e0b',
      tasks: ['Write a React hook', 'Basic API integration', 'New library / framework'],
      strategy: 'Do it yourself first. Use AI to check your work and explain what you got wrong. Ask "why?" for every suggestion you accept.',
    },
    {
      col: 1, row: 1,
      name: '🔵 Dissect Zone',
      color: 'rgba(6,182,212,',
      nameColor: '#06b6d4',
      tasks: ['Architect a new service', 'Advanced async patterns', 'Unknown domain problem'],
      strategy: 'Let AI generate a solution. Read every single line. Ask it to explain anything unclear. Then rebuild it from scratch without looking — until you can.',
    },
    {
      col: 0, row: 0,
      name: '🟢 Delegation Zone',
      color: 'rgba(16,185,129,',
      nameColor: '#10b981',
      tasks: ['CRUD you\'ve written 50x', 'Boilerplate you know cold', 'Routine refactors'],
      strategy: 'Fully delegate to AI. Just review for correctness. This is the productivity win — free up your attention for harder problems.',
    },
    {
      col: 1, row: 0,
      name: '🟣 Collaboration Zone',
      color: 'rgba(139,92,246,',
      nameColor: '#8b5cf6',
      tasks: ['System design in your specialty', 'Complex algorithm optimization', 'Architectural trade-off decisions'],
      strategy: 'You lead. Write the spec and design doc first. Use AI for implementation details and edge cases. Review rigorously — you know this domain better than AI does.',
    },
  ];

  let activeZone = null;

  function drawMatrix() {
    ctx.clearRect(0, 0, W, H);

    zones.forEach(z => {
      const x = OX + z.col * (GW / 2);
      const y = OY + z.row * (GH / 2);
      const qw = GW / 2;
      const qh = GH / 2;

      const isActive = activeZone === z;
      const alpha = isActive ? '0.25)' : '0.10)';
      ctx.fillStyle = z.color + alpha;
      ctx.fillRect(x + 2, y + 2, qw - 4, qh - 4);

      if (isActive) {
        ctx.strokeStyle = z.color + '0.9)';
        ctx.lineWidth = 2;
        ctx.strokeRect(x + 2, y + 2, qw - 4, qh - 4);
      }

      // Zone name
      ctx.fillStyle = z.nameColor;
      ctx.font = `bold ${11 * DPR / DPR}px var(--ff-mono, monospace)`;
      ctx.textAlign = 'center';
      const emoji = z.name.slice(0, 2);
      const label = z.name.slice(3);
      ctx.fillText(emoji + ' ' + label, x + qw / 2, y + 26);

      // Example tasks
      const tasks = z.tasks.slice(0, 2);
      tasks.forEach((t, i) => {
        ctx.fillStyle = 'rgba(255,255,255,0.38)';
        ctx.font = `${9.5 * DPR / DPR}px var(--ff-mono, monospace)`;
        ctx.textAlign = 'center';
        const trimmed = t.length > 22 ? t.slice(0, 21) + '…' : t;
        ctx.fillText('· ' + trimmed, x + qw / 2, y + 48 + i * 16);
      });
    });

    // Grid lines
    ctx.strokeStyle = 'rgba(255,255,255,0.12)';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(OX + GW / 2, OY); ctx.lineTo(OX + GW / 2, OY + GH);
    ctx.moveTo(OX, OY + GH / 2); ctx.lineTo(OX + GW, OY + GH / 2);
    ctx.stroke();

    // Axes
    ctx.fillStyle = 'rgba(255,255,255,0.45)';
    ctx.font = `bold ${10 * DPR / DPR}px var(--ff-mono, monospace)`;

    // Y axis label
    ctx.save(); ctx.translate(PAD + 10, OY + GH / 2); ctx.rotate(-Math.PI / 2);
    ctx.textAlign = 'center';
    ctx.fillText('your mastery', 0, 0);
    ctx.restore();

    // Y axis ticks
    ctx.textAlign = 'right';
    ctx.font = `${9 * DPR / DPR}px var(--ff-mono, monospace)`;
    ctx.fillText('high ↑', OX - 4, OY + 16);
    ctx.fillText('low', OX - 4, OY + GH - 4);

    // X axis label
    ctx.textAlign = 'center';
    ctx.font = `bold ${10 * DPR / DPR}px var(--ff-mono, monospace)`;
    ctx.fillText('task complexity  →', OX + GW / 2, OY + GH + 22);

    // X axis ticks
    ctx.font = `${9 * DPR / DPR}px var(--ff-mono, monospace)`;
    ctx.fillStyle = 'rgba(255,255,255,0.35)';
    ctx.textAlign = 'left';
    ctx.fillText('simple', OX + 6, OY + GH + 22);
    ctx.textAlign = 'right';
    ctx.fillText('complex', OX + GW - 4, OY + GH + 22);
  }

  canvas.addEventListener('click', (e) => {
    const rect = canvas.getBoundingClientRect();
    const cx = (e.clientX - rect.left);
    const cy = (e.clientY - rect.top);
    const col = cx < OX + GW / 2 ? 0 : 1;
    const row = cy < OY + GH / 2 ? 0 : 1;
    const z = zones.find(z => z.col === col && z.row === row);
    if (z) {
      activeZone = activeZone === z ? null : z;
      drawMatrix();
      if (activeZone) {
        nameEl.textContent = z.name;
        nameEl.style.color = z.nameColor;
        bodyEl.innerHTML = '<strong>Examples:</strong> ' + z.tasks.join(', ') + '<br><br>' + z.strategy;
      } else {
        nameEl.textContent = 'Click a zone →';
        nameEl.style.color = 'var(--muted)';
        bodyEl.textContent = 'Select a quadrant above to see the recommended strategy for tasks in that zone.';
      }
    }
  });

  drawMatrix();
})();
</script>
</BaseLayout>

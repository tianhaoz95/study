    <div class="cs-panel" id="panel-algorithm">
      <pre class="cs-pre">
<span class="cs-line cmt"># Algorithm 1: Block-Level Expert Routing</span>
<span class="cs-line cmt"># Input: token-level expert scores &#123;s_i&#125;</span>
<span class="cs-line cmt"># Output: coreset C, routed experts &#123;R_i&#125;</span>
<span class="cs-line"></span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">dmoe_routing</span>(block_tokens, p=<span class="num">0.6</span>, k=<span class="num">2</span>):</span>
<span class="cs-line">    <span class="cmt"># Step 1: token-level routing scores</span></span>
<span class="cs-line">    scores = [router(t) <span class="kw">for</span> t <span class="kw">in</span> block_tokens]</span>
<span class="cs-line"></span>
<span class="cs-line">    <span class="cmt"># Step 2: aggregate to block-level</span></span>
<span class="cs-line hl-c">    Sblock = zeros(n_experts)</span>
<span class="cs-line hl-c">    <span class="kw">for</span> s <span class="kw">in</span> scores:</span>
<span class="cs-line hl-c">        Sblock += topk_mask(s, k)  <span class="cmt"># zero non-top-k</span></span>
<span class="cs-line"></span>
<span class="cs-line">    <span class="cmt"># Step 3: top-p coreset selection</span></span>
<span class="cs-line hl-p">    S_norm = softmax(Sblock)</span>
<span class="cs-line hl-p">    C = top_p_select(S_norm, p)</span>
<span class="cs-line">    <span class="cmt"># C is small when distribution is peaked</span></span>
<span class="cs-line">    <span class="cmt"># C is larger when distribution is flat</span></span>
<span class="cs-line"></span>
<span class="cs-line">    <span class="cmt"># Step 4: coreset-restricted per-token route</span></span>
<span class="cs-line hl-g">    R = []</span>
<span class="cs-line hl-g">    <span class="kw">for</span> s <span class="kw">in</span> scores:</span>
<span class="cs-line hl-g">        s_masked = mask_outside(s, C)</span>
<span class="cs-line hl-g">        R.append(topk(s_masked, k))</span>
<span class="cs-line"></span>
<span class="cs-line">    <span class="kw">return</span> C, R</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-topp">
      <pre class="cs-pre">
<span class="cs-line cmt"># Top-p selection (nucleus sampling style)</span>
<span class="cs-line cmt"># Greedily pick experts until cumsum ≥ p</span>
<span class="cs-line"></span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">top_p_select</span>(norm_scores, p):</span>
<span class="cs-line">    order = argsort(norm_scores, descending=<span class="cls">True</span>)</span>
<span class="cs-line hl-c">    cumsum = <span class="num">0.0</span></span>
<span class="cs-line hl-c">    coreset = []</span>
<span class="cs-line hl-c">    <span class="kw">for</span> idx <span class="kw">in</span> order:</span>
<span class="cs-line hl-c">        coreset.append(idx)</span>
<span class="cs-line hl-c">        cumsum += norm_scores[idx]</span>
<span class="cs-line hl-c">        <span class="kw">if</span> cumsum &gt;= p: <span class="kw">break</span></span>
<span class="cs-line">    <span class="kw">return</span> coreset</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Concentrated distribution example:</span>
<span class="cs-line cmt"># E5=0.40, E2=0.25, E1=0.15, rest≤0.05</span>
<span class="cs-line cmt"># p=0.6 → &#123;E5, E2&#125; (cumsum=0.65 ≥ 0.6)</span>
<span class="cs-line cmt"># only 2 experts needed!</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Dispersed distribution example:</span>
<span class="cs-line cmt"># all experts roughly equal weight ~0.08</span>
<span class="cs-line cmt"># p=0.6 → need 8 experts to reach 0.64</span>
<span class="cs-line cmt"># adapts automatically to step/layer</span>
      </pre>
    </div>


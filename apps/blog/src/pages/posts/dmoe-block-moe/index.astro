---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="dMoE: Block-Level Expert Routing for Diffusion LLMs | AI/ML Deep Dives"
  description="Diffusion LLMs decode blocks of tokens in parallel, but MoE layers route experts per token — causing 70+ unique expert loads per forward pass. dMoE aggregates token scores into block-level distributions and selects a coreset via top-p, cutting unique experts from 70 to 14 while retaining 99% of performance."
  crumb="dMoE Block MoE"
>


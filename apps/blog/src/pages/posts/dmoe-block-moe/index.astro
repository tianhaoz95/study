}

// ── §06 Trade-off line chart ─────────────────────────────────────────
(function() {
  const canvas = document.getElementById('tradeoff-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 240;
  canvas.width = W * DPR; canvas.height = H * DPR;
  ctx.scale(DPR, DPR);

  // Data from Table 3 (MATH500)
  // ptrain=0.6: ptest 0.4, 0.5, 0.6, 0.7, 0.8 → (experts, acc)
  const curve06 = [[10.3, 69.8], [11.5, 70.0], [14.1, 71.0], [19.0, 72.6], [27.1, 74.2]];
  // ptrain=0.5
  const curve05 = [[10.2, 69.6], [11.4, 69.8], [14.3, 70.0], [19.2, 73.4], [27.2, 73.2]];
  // Original
  const original = [70.0, 72.0];

  const margin = { l: 52, r: 30, t: 20, b: 42 };
  const pw = W - margin.l - margin.r;
  const ph = H - margin.t - margin.b;
  const xMin = 8, xMax = 75, yMin = 68, yMax = 76;

  function tx(v) { return margin.l + (v - xMin) / (xMax - xMin) * pw; }
  function ty(v) { return H - margin.b - (v - yMin) / (yMax - yMin) * ph; }

  // Grid
  ctx.strokeStyle = 'rgba(255,255,255,0.05)';
  ctx.lineWidth = 1;
  [69, 70, 71, 72, 73, 74, 75].forEach(v => {
    ctx.beginPath(); ctx.moveTo(margin.l, ty(v)); ctx.lineTo(W - margin.r, ty(v)); ctx.stroke();
  });
  [10, 20, 30, 40, 50, 60, 70].forEach(v => {
    ctx.beginPath(); ctx.moveTo(tx(v), margin.t); ctx.lineTo(tx(v), H - margin.b); ctx.stroke();
  });

  // Original model dot
  ctx.beginPath();
  ctx.arc(tx(original[0]), ty(original[1]), 6, 0, Math.PI * 2);
  ctx.fillStyle = 'rgba(245,158,11,0.7)';
  ctx.fill();
  ctx.fillStyle = '#f59e0b';
  ctx.font = `bold ${10 * DPR / DPR}px monospace`;
  ctx.textAlign = 'left';
  ctx.fillText('original', tx(original[0]) + 9, ty(original[1]) + 4);

  function drawCurve(pts, color, dashed) {
    ctx.strokeStyle = color;
    ctx.lineWidth = 2;
    if (dashed) ctx.setLineDash([5, 3]); else ctx.setLineDash([]);
    ctx.beginPath();
    pts.forEach(([x, y], i) => {
      if (i === 0) ctx.moveTo(tx(x), ty(y));
      else ctx.lineTo(tx(x), ty(y));
    });
    ctx.stroke();
    ctx.setLineDash([]);
    // Dots with p_test labels
    const labels = ['p=0.4', 'p=0.5', 'p=0.6', 'p=0.7', 'p=0.8'];
    pts.forEach(([x, y], i) => {
      ctx.beginPath();
      ctx.arc(tx(x), ty(y), 4, 0, Math.PI * 2);
      ctx.fillStyle = color;
      ctx.fill();
    });
    // Label last point
    ctx.fillStyle = color;
    ctx.font = `${9 * DPR / DPR}px monospace`;
    ctx.textAlign = 'left';
    ctx.fillText(labels[4], tx(pts[4][0]) + 7, ty(pts[4][1]) - 4);
    ctx.textAlign = 'right';
    ctx.fillText(labels[0], tx(pts[0][0]) - 6, ty(pts[0][1]) - 4);
  }

  drawCurve(curve06, 'rgba(139,92,246,0.85)', false);
  drawCurve(curve05, 'rgba(6,182,212,0.75)', true);

  // Axes
  ctx.strokeStyle = 'rgba(255,255,255,0.2)';
  ctx.lineWidth = 1;
  ctx.beginPath();
  ctx.moveTo(margin.l, margin.t); ctx.lineTo(margin.l, H - margin.b);
  ctx.lineTo(W - margin.r, H - margin.b);
  ctx.stroke();

  // Axis labels
  ctx.fillStyle = '#5c6370';
  ctx.font = `${10 * DPR / DPR}px monospace`;
  ctx.textAlign = 'center';
  ctx.fillText('Unique Experts per Forward Pass', W / 2, H - 6);
  ctx.save();
  ctx.translate(13, H / 2);
  ctx.rotate(-Math.PI / 2);
  ctx.fillText('MATH500 Accuracy (%)', 0, 0);
  ctx.restore();

  // Tick labels
  ctx.font = `${9 * DPR / DPR}px monospace`;
  ctx.fillStyle = '#5c6370';
  [10, 20, 30, 40, 50, 60, 70].forEach(v => {
    ctx.textAlign = 'center';
    ctx.fillText(v, tx(v), H - margin.b + 14);
  });
  [69, 70, 71, 72, 73, 74, 75].forEach(v => {
    ctx.textAlign = 'right';
    ctx.fillText(v + '%', margin.l - 5, ty(v) + 4);
  });
})();
</script>
</BaseLayout>

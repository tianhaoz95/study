<span class="cs-line cmt"># context_compression.py</span>
<span class="cs-line"><span class="kw">class</span> <span class="cls">ManagerContext</span>:</span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">update</span>(<span class="self">self</span>, action, result, global_goal):</span>
<span class="cs-line">        <span class="self">self</span>.append(action, result)</span>
<span class="cs-line hl-p">        <span class="cmt"># ACC: Manager decides *when* to compress using a learned tool</span></span>
<span class="cs-line hl-p">        <span class="kw">if</span> <span class="self">self</span>.should_compress(global_goal):</span>
<span class="cs-line hl-g">            <span class="cmt"># Summarization preserves task progress & decisions</span></span>
<span class="cs-line hl-g">            <span class="self">self</span>.history = <span class="self">self</span>.summarize_context(<span class="self">self</span>.history, global_goal)</span>
<span class="cs-line">            </span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">summarize_context</span>(<span class="self">self</span>, history, goal):</span>
<span class="cs-line">        prompt = f<span class="str">"Summarize data science decisions aligning with &#123;goal&#125;: &#123;history&#125;"</span></span>
<span class="cs-line">        <span class="kw">return</span> <span class="self">self</span>.llm.generate(prompt)</span>
      </pre>
    </div>

    <!-- Panel 5: GRPO -->
    <div class="cs-panel" id="panel-grpo">
      <pre class="cs-pre">
<span class="cs-line cmt"># grpo_rl.py</span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">compute_manager_reward</span>(outcome_score, sub_scores, context_len, turns):</span>
<span class="cs-line">    <span class="cmt"># Outcome reward (benchmark metric)</span></span>
<span class="cs-line">    R_outcome = outcome_score </span>
<span class="cs-line">    <span class="cmt"># Subtask success rate</span></span>
<span class="cs-line">    R_sub = sum(sub_scores) / len(sub_scores) <span class="kw">if</span> sub_scores <span class="kw">else</span> <span class="num">0.0</span></span>
<span class="cs-line hl-p">    <span class="cmt"># Efficiency and resource penalties</span></span>
<span class="cs-line hl-p">    P_context = context_len / max_context_tokens</span>
<span class="cs-line hl-p">    P_turn = turns / max_turns</span>
<span class="cs-line">    </span>
<span class="cs-line hl-g">    <span class="cmt"># Hybrid reward formula</span></span>
<span class="cs-line hl-g">    R_main = R_outcome + <span class="num">0.2</span> * R_sub - <span class="num">0.1</span> * P_context - <span class="num">0.1</span> * P_turn</span>
<span class="cs-line">    <span class="kw">return</span> R_main</span>
      </pre>

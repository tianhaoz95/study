<script>
// ── TOC toggle ──────────────────────────────────────────────────────
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle = document.getElementById('toc-toggle');
const postGrid = document.getElementById('post-grid');

tocToggle?.addEventListener('click', () => {
  const collapsed = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', collapsed);
  tocToggle.textContent = collapsed ? '›' : '‹';
  tocToggle.title = collapsed ? 'Show contents' : 'Hide contents';
});

// ── Code sidebar toggle ─────────────────────────────────────────────
const codeSidebar = document.getElementById('code-sidebar');
const csToggle = document.getElementById('cs-toggle');

csToggle?.addEventListener('click', () => {
  const collapsed = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', collapsed);
  csToggle.textContent = collapsed ? '‹' : '›';
  csToggle.title = collapsed ? 'Show code' : 'Hide code';
});

// ── Code sidebar tabs ───────────────────────────────────────────────
const csTabs = document.querySelectorAll('.cs-tab');
const csPanels = document.querySelectorAll('.cs-panel');
const csFileLabel = document.getElementById('cs-file-label');
const csSectionTitle = document.getElementById('cs-section-title');

const tabMeta = {
  problem:   { file: 'naive_agent.py',       title: 'The Long Horizon' },
  hierarchy: { file: 'manager_agent.py',     title: 'Specialization' },
  asa:       { file: 'skill_acquisition.py', title: 'Skill Acquisition' },
  acc:       { file: 'context_compression.py', title: 'Active Compression' },
  grpo:      { file: 'grpo_rl.py',           title: 'Agentic GRPO' },
  results:   { file: 'table_results.json',   title: 'Benchmarks' },
};

function activateTab(name) {
  csTabs.forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  csPanels.forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m && csFileLabel) csFileLabel.textContent = m.file;
  if (m && csSectionTitle) csSectionTitle.textContent = m.title;
}

csTabs.forEach(tab => {
  tab.addEventListener('click', () => activateTab(tab.dataset.panel));
});

// ── IntersectionObserver: sync TOC + sidebar ───────────────────────
const sectionCodeMap = {
  's-problem':  'problem',
  's-hierarchy':'hierarchy',
  's-asa':      'asa',
  's-acc':      'acc',
  's-rl':       'grpo',
  's-results':  'results',
};

const observer = new IntersectionObserver((entries) => {
  let best = null, bestRatio = 0;
  entries.forEach(e => {
    if (e.isIntersecting && e.intersectionRatio > bestRatio) {
      best = e.target;
      bestRatio = e.intersectionRatio;
    }
  });
  if (!best) return;
  const id = best.id;
  document.querySelectorAll('.toc-item').forEach(li => {
    li.classList.toggle('toc-active', li.id === 'toc-' + id);
  });
  const panel = sectionCodeMap[id];
  if (panel) activateTab(panel);
}, { threshold: [0.15, 0.4] });

document.querySelectorAll('.post-body section[id]').forEach(s => observer.observe(s));

// ── Context Token Canvas Simulation ─────────────────────────────────
const contextCanvas = document.getElementById('context-canvas');
if (contextCanvas) {
  const ctx = contextCanvas.getContext('2d');
  let animId = null;
  let running = false;
  let step = 0;
  
  const W_CSS = contextCanvas.clientWidth;
  const H_CSS = 220;
  const DPR = window.devicePixelRatio || 1;
  contextCanvas.width = W_CSS * DPR;
  contextCanvas.height = H_CSS * DPR;
  ctx.scale(DPR, DPR);
  const W = W_CSS, H = H_CSS;
  
  // Data trajectories
  const naiveData = [];
  const evodsData = [];
  
  // Pre-generate steps
  for (let s = 0; s <= 15; s++) {
    // Naive goes up linearly
    naiveData.push(1000 + s * 1800);
    // EvoDS climbs but drops at 4, 8, 12
    let evVal = 1000;
    for (let x = 1; x <= s; x++) {
      evVal += 1200;
      if (x % 4 === 0) {
        evVal = Math.max(1000, evVal - 3500); // Compression
      }
    }
    evodsData.push(evVal);
  }
  
  function drawChart(currStep) {
    ctx.clearRect(0, 0, W, H);
    
    // Axes and grids
    ctx.strokeStyle = 'rgba(255,255,255,0.05)';
    ctx.lineWidth = 1;
    for (let gx = 40; gx <= W - 20; gx += (W - 60) / 15) {
      ctx.beginPath(); ctx.moveTo(gx, 10); ctx.lineTo(gx, H - 30); ctx.stroke();
    }
    for (let gy = 20; gy <= H - 30; gy += 30) {
      ctx.beginPath(); ctx.moveTo(40, gy); ctx.lineTo(W - 20, gy); ctx.stroke();
    }
    
    // Y-Axis labels (Token size, max 24,000)
    ctx.font = '9px monospace';
    ctx.fillStyle = 'rgba(255,255,255,0.4)';
    ctx.textAlign = 'right';
    ctx.fillText('24K', 32, 23);
    ctx.fillText('16K', 32, 68);
    ctx.fillText('8K', 32, 113);
    ctx.fillText('0K', 32, 158);
    
    // Draw limit line (24,000 tokens)
    ctx.strokeStyle = '#e06c75';
    ctx.lineWidth = 1.5;
    ctx.setLineDash([4, 4]);
    ctx.beginPath();
    ctx.moveTo(40, 20);
    ctx.lineTo(W - 20, 20);
    ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle = '#e06c75';
    ctx.textAlign = 'left';
    ctx.fillText('Token Limit (24K)', 45, 16);
    
    // Convert data coordinate to pixel coordinate
    const getX = (idx) => 40 + idx * (W - 60) / 15;
    const getY = (val) => H - 30 - (val / 26000) * (H - 50);
    
    // Draw Naive line
    ctx.strokeStyle = 'rgba(255,255,255,0.2)';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(getX(0), getY(naiveData[0]));
    for (let i = 1; i <= currStep; i++) {
      if (naiveData[i] <= 24500) {
        ctx.lineTo(getX(i), getY(naiveData[i]));
      }
    }
    ctx.stroke();
    
    // Draw EvoDS line
    ctx.strokeStyle = 'var(--purple)';
    ctx.lineWidth = 2.5;
    ctx.beginPath();
    ctx.moveTo(getX(0), getY(evodsData[0]));
    for (let i = 1; i <= currStep; i++) {
      ctx.lineTo(getX(i), getY(evodsData[i]));
    }
    ctx.stroke();
    
    // Draw dots and annotations
    for (let i = 0; i <= currStep; i++) {
      // Naive dot
      if (naiveData[i] <= 24000) {
        ctx.beginPath(); ctx.arc(getX(i), getY(naiveData[i]), 3, 0, Math.PI*2);
        ctx.fillStyle = 'rgba(255,255,255,0.4)'; ctx.fill();
      } else if (i > 0 && naiveData[i-1] <= 24000) {
        // Draw failure crash symbol
        ctx.fillStyle = '#e06c75';
        ctx.font = 'bold 11px monospace';
        ctx.fillText('✘ OOT Failure', getX(i) - 40, getY(24000) + 18);
      }
      
      // EvoDS dot
      ctx.beginPath(); ctx.arc(getX(i), getY(evodsData[i]), 4, 0, Math.PI*2);
      ctx.fillStyle = 'var(--purple-l)'; ctx.fill();
      
      // Draw compression markers
      if (i > 0 && i % 4 === 0) {
        ctx.fillStyle = 'var(--cyan)';
        ctx.beginPath(); ctx.arc(getX(i), getY(evodsData[i]), 6, 0, Math.PI*2);
        ctx.stroke();
        ctx.font = '9px monospace';
        ctx.fillText('ACC compress', getX(i) - 30, getY(evodsData[i]) - 12);
      }
    }
  }
  
  drawChart(0);
  
  const playBtn = document.getElementById('canvas-play');
  const resetBtn = document.getElementById('canvas-reset');
  const stepVal = document.getElementById('canvas-step-val');
  const tokensVal = document.getElementById('canvas-tokens-val');
  
  function triggerStep() {
    if (step < 15) {
      step++;
      drawChart(step);
      if (stepVal) stepVal.textContent = String(step);
      if (tokensVal) tokensVal.textContent = evodsData[step].toLocaleString();
      animId = setTimeout(triggerStep, 700);
    } else {
      running = false;
      if (playBtn) playBtn.textContent = '▶ Play Simulation';
    }
  }
  
  playBtn?.addEventListener('click', () => {
    if (running) {
      running = false;
      clearTimeout(animId);
      playBtn.textContent = '▶ Play Simulation';
    } else {
      if (step >= 15) step = 0;
      running = true;
      playBtn.textContent = '⏸ Pause';
      triggerStep();
    }
  });
  
  resetBtn?.addEventListener('click', () => {
    running = false;
    clearTimeout(animId);
    step = 0;
    drawChart(0);
    if (stepVal) stepVal.textContent = '0';
    if (tokensVal) tokensVal.textContent = '1,000';
    if (playBtn) playBtn.textContent = '▶ Play Simulation';
  });
}


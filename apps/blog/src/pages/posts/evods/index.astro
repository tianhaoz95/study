function animateBars(benchName) {
  const data = benchmarkData[benchName];
  if (!data) return;
  
  const elDA = document.getElementById('bar-deepanalyze');
  const elDM = document.getElementById('bar-datamind');
  const elEV = document.getElementById('bar-evods');
  const elEVE = document.getElementById('bar-evods-evo');
  
  if (elDA) {
    elDA.style.width = data.deepanalyze + '%';
    const span = elDA.querySelector('span');
    if (span) span.textContent = data.deepanalyze.toFixed(1) + '%';
  }
  if (elDM) {
    elDM.style.width = data.datamind + '%';
    const span = elDM.querySelector('span');
    if (span) span.textContent = data.datamind.toFixed(1) + '%';
  }
  if (elEV) {
    elEV.style.width = data.evods + '%';
    const span = elEV.querySelector('span');
    if (span) span.textContent = data.evods.toFixed(1) + '%';

    const bench = btn.dataset.bench;
    animateBars(bench);
  });
});

// Trigger chart animation via IntersectionObserver
const resultsSection = document.getElementById('s-results');
if (resultsSection) {
  new IntersectionObserver((entries, obs) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        animateBars('average');
        obs.unobserve(e.target);
      }
    });
  }, { threshold: 0.2 }).observe(resultsSection);
}

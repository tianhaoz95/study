<span class="cs-line"><span class="cmt"># LoopWM:  51.6% EM, 80.4% F1</span></span>
<span class="cs-line"><span class="cmt"># Claude:  53.0% EM, 72.6% F1</span></span>
<span class="cs-line"><span class="cmt"># → competitive at 100× fewer params</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Parameter efficiency:</span>
<span class="cs-line hl-a"><span class="cmt"># Fixed-depth L=100: 100 × block_size</span></span>
<span class="cs-line hl-a"><span class="cmt"># LoopWM T≤100:      1 × block_size</span></span>
<span class="cs-line hl-a"><span class="cmt"># → up to 100× efficiency</span></span>
      </pre>
    </div>

  </div>
</aside>

</div><!-- /post-grid -->

<script>
// ─── Sidebar + TOC toggles ────────────────────────────────────────────────
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});

const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ─── Code sidebar tab switching ──────────────────────────────────────────
const tabMeta = {
  problem:  { file: 'loopwm/model.py',     title: 'The Fixed-Depth Trap' },
  loop:     { file: 'loopwm/loop_core.py', title: 'Looped Architectures' },
  arch:     { file: 'loopwm/stability.py', title: 'LoopWM Architecture' },
  adaptive: { file: 'loopwm/exit_gate.py', title: 'Adaptive Computation' },
  deferred: { file: 'loopwm/deferred.py',  title: 'Deferred Decoding' },
  results:  { file: 'loopwm/results.py',   title: 'Results' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ─── IntersectionObserver — TOC + sidebar sync ───────────────────────────
const sectionMap = {
  's-problem':  'problem',
  's-loop':     'loop',
  's-arch':     'arch',
  's-adaptive': 'adaptive',
  's-deferred': 'deferred',
  's-results':  'results',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.25 }).observe(s)
);

// ─── Canvas: The Fixed-Depth Problem ─────────────────────────────────────
(function () {
  const canvas = document.getElementById('canvas-problem');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 200;
  canvas.width = W * DPR; canvas.height = H * DPR;
  const ctx = canvas.getContext('2d');
  ctx.scale(DPR, DPR);

  const nLayers = 8;
  const panelW = W / 2 - 20;

  // Colors for fixed-depth (all same amber) and adaptive (green/amber/red)
  const fixedColor = 'rgba(245,158,11,0.75)';
  const colors = ['#10b981','#10b981','#10b981','#10b981','#10b981','#10b981','#10b981','#10b981'];

  function drawPanel(xOffset, label, depths, isFixed) {
    // background
    ctx.fillStyle = 'rgba(255,255,255,0.03)';
    ctx.strokeStyle = 'rgba(255,255,255,0.08)';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.roundRect(xOffset, 10, panelW, H - 20, 8);
    ctx.fill(); ctx.stroke();

    // Panel title
    ctx.fillStyle = isFixed ? '#f59e0b' : '#10b981';
    ctx.font = `600 10px monospace`;
    ctx.textAlign = 'center';
    ctx.fillText(label, xOffset + panelW / 2, 28);

    const barW = (panelW - 40) / depths.length;
    const maxH = H - 80;
    const baseY = H - 30;

    depths.forEach((d, i) => {
      const x = xOffset + 20 + i * barW + barW * 0.1;
      const bw = barW * 0.8;
      const bh = (d / 8) * maxH;
      const y = baseY - bh;

      const c = isFixed ? fixedColor
        : d <= 2 ? '#10b981'
        : d <= 5 ? '#f59e0b' : '#8b5cf6';
      ctx.fillStyle = c;
      ctx.beginPath();
      ctx.roundRect(x, y, bw, bh, 3);
      ctx.fill();

      // T label
      ctx.fillStyle = 'rgba(255,255,255,0.5)';
      ctx.font = `600 8px monospace`;
      ctx.textAlign = 'center';
      ctx.fillText('T=' + d, x + bw / 2, y - 4);
    });

    // X-axis labels
    const actions = isFixed
      ? ['nav','nav','pick','nav','pour','heat','nav','obs']
      : ['nav','nav','pick','nav','pour','heat','nav','obs'];
    actions.forEach((a, i) => {
      const x = xOffset + 20 + i * barW + barW / 2;
      ctx.fillStyle = '#5c6370';
      ctx.font = `7px monospace`;
      ctx.textAlign = 'center';
      ctx.fillText(a, x, H - 14);
    });
  }

  // Fixed-depth: all T=8
  drawPanel(10, 'Fixed-depth (T=8 always)', [8,8,8,8,8,8,8,8], true);
  // Adaptive: variable T
  drawPanel(W / 2 + 10, 'Adaptive (T per complexity)', [2,1,4,2,6,7,1,3], false);

  // Waste label on fixed panel
  ctx.fillStyle = 'rgba(245,158,11,0.3)';
  ctx.font = `italic 9px monospace`;
  ctx.textAlign = 'center';
  ctx.fillText('waste on simple steps ↑', 10 + panelW / 2, 58);
})();

// ─── Canvas: Looped vs Fixed-depth parameter bars ────────────────────────
(function () {
  const canvas = document.getElementById('canvas-loop');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 220;
  canvas.width = W * DPR; canvas.height = H * DPR;
  const ctx = canvas.getContext('2d');
  ctx.scale(DPR, DPR);

  ctx.fillStyle = '#0d0d14';
  ctx.fillRect(0, 0, W, H);

  const models = [
    { label: 'Fixed L=8',   params: 8, color: '#f59e0b', depth: 8 },
    { label: 'Fixed L=4',   params: 4, color: '#f59e0b', color2: true, depth: 4 },
    { label: 'Looped T=8',  params: 1, color: '#8b5cf6', depth: 8 },
    { label: 'Looped T=16', params: 1, color: '#10b981', depth: 16 },
  ];

  const maxP = 8;
  const barH = 26;
  const gap = 12;
  const labelW = 120;
  const trackW = W - labelW - 80;
  const startY = 30;

  ctx.fillStyle = '#5c6370';
  ctx.font = '9px monospace';
  ctx.textAlign = 'left';
  ctx.fillText('Parameter count (relative units)', labelW, 20);
  ctx.textAlign = 'right';
  ctx.fillText('Effective depth', W - 10, 20);

  models.forEach((m, i) => {
    const y = startY + i * (barH + gap);

    // Label
    ctx.fillStyle = '#abb2bf';
    ctx.font = '9px monospace';
    ctx.textAlign = 'right';
    ctx.fillText(m.label, labelW - 8, y + barH / 2 + 3);

    // Param bar
    const bw = (m.params / maxP) * trackW;
    ctx.fillStyle = 'rgba(255,255,255,0.04)';
    ctx.beginPath();
    ctx.roundRect(labelW, y, trackW, barH, 4);
    ctx.fill();
    ctx.fillStyle = m.color + (m.color2 ? '88' : 'cc');
    ctx.beginPath();
    ctx.roundRect(labelW, y, bw, barH, 4);
    ctx.fill();

    // Param value
    ctx.fillStyle = '#abb2bf';
    ctx.font = '600 9px monospace';
    ctx.textAlign = 'left';
    ctx.fillText(m.params + 'x blocks', labelW + bw + 6, y + barH / 2 + 3);

    // Depth label on right
    ctx.fillStyle = m.color;
    ctx.textAlign = 'right';
    ctx.fillText('depth ' + m.depth, W - 10, y + barH / 2 + 3);
  });

  // Highlight same-depth rows
  ctx.strokeStyle = 'rgba(139,92,246,0.3)';
  ctx.setLineDash([3, 3]);
  ctx.lineWidth = 1;
  const y0 = startY;
  const y2 = startY + 2 * (barH + gap);
  ctx.beginPath();
  ctx.moveTo(W - 55, y0 + barH / 2);
  ctx.lineTo(W - 55, y2 + barH / 2);
  ctx.stroke();
  ctx.setLineDash([]);
  ctx.fillStyle = '#8b5cf6';
  ctx.font = 'italic 8px monospace';
  ctx.textAlign = 'center';
  ctx.fillText('same depth', W - 55, startY - 2);
  ctx.fillText('8× fewer params', W - 55, y2 + barH + 14);
})();

// ─── Canvas: Spectral stability ───────────────────────────────────────────
(function () {
  const canvas = document.getElementById('canvas-stability');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 200;
  canvas.width = W * DPR; canvas.height = H * DPR;
  const ctx = canvas.getContext('2d');
  ctx.scale(DPR, DPR);

  ctx.fillStyle = '#0d0d14';
  ctx.fillRect(0, 0, W, H);

  const N = 50;
  const padL = 50, padR = 20, padT = 20, padB = 35;
  const plotW = W - padL - padR;
  const plotH = H - padT - padB;

  // Axes
  ctx.strokeStyle = 'rgba(255,255,255,0.08)';
  ctx.lineWidth = 1;
  // Horizontal grid lines
  [0, 0.25, 0.5, 0.75, 1.0].forEach(v => {
    const y = padT + plotH * (1 - v / 3);
    ctx.beginPath();
    ctx.moveTo(padL, y);
    ctx.lineTo(padL + plotW, y);
    ctx.stroke();
    ctx.fillStyle = '#5c6370';
    ctx.font = '8px monospace';
    ctx.textAlign = 'right';
    ctx.fillText(v.toFixed(1), padL - 4, y + 3);
  });

  // Y-axis label
  ctx.save();
  ctx.translate(12, padT + plotH / 2);
  ctx.rotate(-Math.PI / 2);
  ctx.fillStyle = '#5c6370';
  ctx.font = '8px monospace';
  ctx.textAlign = 'center';
  ctx.fillText('‖h‖ norm', 0, 0);
  ctx.restore();

  // X-axis label
  ctx.fillStyle = '#5c6370';
  ctx.font = '8px monospace';
  ctx.textAlign = 'center';
  ctx.fillText('Rollout step', padL + plotW / 2, H - 5);

  // Unconstrained: grows exponentially, cap at 3
  function unconstrained(t) { return Math.min(3, Math.pow(1.12, t) * 0.85); }
  // Constrained: stays bounded around 1.0 with small noise
  function seededRand(n) { return ((1664525*n+1013904223)&0x7fffffff)/0x7fffffff; }
  function constrained(t) { return 1.0 + 0.08 * Math.sin(t * 0.7) + 0.03 * (seededRand(t) - 0.5); }

  function toX(t) { return padL + (t / (N - 1)) * plotW; }
  function toY(v) { return padT + plotH * (1 - Math.min(v, 3) / 3); }

  // Draw unconstrained (red)
  ctx.strokeStyle = '#ef4444';
  ctx.lineWidth = 2;
  ctx.beginPath();
  for (let t = 0; t < N; t++) {
    const y = toY(unconstrained(t));
    if (t === 0) ctx.moveTo(toX(t), y);
    else ctx.lineTo(toX(t), y);
  }
  ctx.stroke();

  // Draw constrained (green)
  ctx.strokeStyle = '#10b981';
  ctx.lineWidth = 2;
  ctx.beginPath();
  for (let t = 0; t < N; t++) {
    const y = toY(constrained(t));
    if (t === 0) ctx.moveTo(toX(t), y);
    else ctx.lineTo(toX(t), y);
  }
  ctx.stroke();

  // Labels
  ctx.fillStyle = '#ef4444';
  ctx.font = '9px monospace';
  ctx.textAlign = 'left';
  ctx.fillText('Without ρ(Ā) < 1 — diverges', padL + plotW * 0.4, toY(unconstrained(22)) - 8);

  ctx.fillStyle = '#10b981';
  ctx.fillText('LoopWM — bounded by construction', padL + 4, toY(constrained(25)) - 8);
})();

// ─── Canvas: Adaptive computation (interactive) ──────────────────────────
(function () {
  const canvas = document.getElementById('canvas-adaptive');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 240;
  canvas.width = W * DPR; canvas.height = H * DPR;
  const ctx = canvas.getContext('2d');
  ctx.scale(DPR, DPR);

  const easyDepths = [2, 1, 2, 1, 2, 2, 1, 2, 2, 1];
  const easyLabels = ['go N','look','pick','go E','go W','look','go N','drop','go S','look'];
  const hardDepths = [2, 5, 8, 7, 3, 2, 6, 8, 3, 2];
  const hardLabels = ['nav','pick up','add chem','observe','stir','set aside','heat','phase chg','cool','record'];

  let current = 'easy';

  function barColor(d) {
    if (d <= 2) return '#10b981';
    if (d <= 5) return '#f59e0b';
    return '#8b5cf6';
  }

  function draw(mode) {
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = '#0d0d14';
    ctx.fillRect(0, 0, W, H);

    const depths = mode === 'easy' ? easyDepths : hardDepths;
    const labels = mode === 'easy' ? easyLabels : hardLabels;
    const avg = (depths.reduce((a,b) => a+b, 0) / depths.length).toFixed(1);

    document.getElementById('stat-avg').textContent = 'avg T: ' + avg + ' iterations';

    const n = depths.length;
    const padL = 20, padR = 20, padT = 30, padB = 50;
    const plotW = W - padL - padR;
    const plotH = H - padT - padB;
    const barW = plotW / n;
    const maxT = 8;

    // T_max line
    const tmaxY = padT;
    ctx.strokeStyle = 'rgba(255,255,255,0.1)';
    ctx.setLineDash([4, 4]);
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(padL, tmaxY);
    ctx.lineTo(padL + plotW, tmaxY);
    ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle = '#5c6370';
    ctx.font = '8px monospace';
    ctx.textAlign = 'left';
    ctx.fillText('T_max = 8', padL + 4, tmaxY - 3);

    depths.forEach((d, i) => {
      const x = padL + i * barW + barW * 0.12;
      const bw = barW * 0.76;
      const bh = (d / maxT) * plotH;
      const y = padT + plotH - bh;

      // Bar
      ctx.fillStyle = barColor(d) + 'cc';
      ctx.beginPath();
      ctx.roundRect(x, y, bw, bh, 3);
      ctx.fill();

      // T value label
      ctx.fillStyle = '#f0f0f8';
      ctx.font = '600 9px monospace';
      ctx.textAlign = 'center';
      ctx.fillText('T=' + d, x + bw / 2, y - 5);

      // Step label below
      ctx.fillStyle = '#5c6370';
      ctx.font = '7px monospace';
      ctx.textAlign = 'center';
      ctx.fillText(labels[i], x + bw / 2, H - padB + 14);

      // Complex badge
      if (d >= 6) {
        ctx.fillStyle = 'rgba(139,92,246,0.15)';
        ctx.strokeStyle = 'rgba(139,92,246,0.4)';
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.roundRect(x - 2, y - 22, bw + 4, 14, 3);
        ctx.fill(); ctx.stroke();
        ctx.fillStyle = '#a78bfa';
        ctx.font = '6px monospace';
        ctx.textAlign = 'center';
        ctx.fillText('complex', x + bw / 2, y - 12);
      }
    });
  }

  draw('easy');

  document.getElementById('btn-easy').addEventListener('click', () => {
    current = 'easy';
    document.getElementById('btn-easy').classList.add('active');
    document.getElementById('btn-hard').classList.remove('active');
    draw('easy');
  });
  document.getElementById('btn-hard').addEventListener('click', () => {
    current = 'hard';
    document.getElementById('btn-hard').classList.add('active');
    document.getElementById('btn-easy').classList.remove('active');
    draw('hard');
  });
})();

// ─── Canvas: Deferred decoding ────────────────────────────────────────────
(function () {
  const canvas = document.getElementById('canvas-deferred');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 240;
  canvas.width = W * DPR; canvas.height = H * DPR;
  const ctx = canvas.getContext('2d');
  ctx.scale(DPR, DPR);

  ctx.fillStyle = '#0d0d14';
  ctx.fillRect(0, 0, W, H);

  const K = 5;
  const actions = ['take beaker', 'pour reagent', 'add catalyst', 'heat to 100°C', 'observe'];
  const padL = 100, padR = 20;
  const cellW = (W - padL - padR) / K;
  const rowH = 60;
  const row1Y = 40;
  const row2Y = 140;

  // Row labels
  ctx.font = '600 9px monospace';
  ctx.textAlign = 'right';
  ctx.fillStyle = '#f59e0b';
  ctx.fillText('Per-step', padL - 8, row1Y + rowH / 2 + 3);
  ctx.fillStyle = '#10b981';
  ctx.fillText('Deferred', padL - 8, row2Y + rowH / 2 + 3);

  // Draw flow arrow between cells
  function drawArrow(x1, y1, x2, y2) {
    ctx.strokeStyle = '#5c6370';
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(x1, y1);
    ctx.lineTo(x2, y2);
    ctx.stroke();
    // arrowhead
    const angle = Math.atan2(y2 - y1, x2 - x1);
    ctx.beginPath();
    ctx.moveTo(x2, y2);
    ctx.lineTo(x2 - 7 * Math.cos(angle - 0.4), y2 - 7 * Math.sin(angle - 0.4));
    ctx.lineTo(x2 - 7 * Math.cos(angle + 0.4), y2 - 7 * Math.sin(angle + 0.4));
    ctx.closePath();
    ctx.fillStyle = '#5c6370';
    ctx.fill();
  }

  for (let k = 0; k < K; k++) {
    const cx = padL + k * cellW + cellW / 2;

    // ── Per-step row ──
    const boxW1 = cellW - 14;
    const bx1 = padL + k * cellW + 7;

    // Latent dynamics box
    ctx.fillStyle = 'rgba(139,92,246,0.12)';
    ctx.strokeStyle = 'rgba(139,92,246,0.4)';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.roundRect(bx1, row1Y, boxW1, 22, 4);
    ctx.fill(); ctx.stroke();
    ctx.fillStyle = '#a78bfa';
    ctx.font = '7px monospace';
    ctx.textAlign = 'center';
    ctx.fillText('dynamics', cx, row1Y + 13);

    // Decoder box (red)
    ctx.fillStyle = 'rgba(239,68,68,0.15)';
    ctx.strokeStyle = 'rgba(239,68,68,0.5)';
    ctx.beginPath();
    ctx.roundRect(bx1, row1Y + 28, boxW1, 20, 4);
    ctx.fill(); ctx.stroke();
    ctx.fillStyle = '#f87171';
    ctx.font = '700 8px monospace';
    ctx.textAlign = 'center';
    ctx.fillText('DECODE', cx, row1Y + 41);

    // Arrow to next
    if (k < K - 1) {
      drawArrow(bx1 + boxW1, row1Y + 30, padL + (k+1)*cellW + 7, row1Y + 11);
    }

    // ── Deferred row ──
    const bx2 = padL + k * cellW + 7;
    const isLast = k === K - 1;

    // Latent dynamics box
    ctx.fillStyle = 'rgba(16,185,129,0.10)';
    ctx.strokeStyle = isLast ? 'rgba(16,185,129,0.8)' : 'rgba(16,185,129,0.3)';
    ctx.lineWidth = isLast ? 1.5 : 1;
    ctx.beginPath();
    ctx.roundRect(bx2, row2Y, boxW1, 22, 4);
    ctx.fill(); ctx.stroke();
    ctx.fillStyle = isLast ? '#34d399' : '#6ee7b7';
    ctx.font = '7px monospace';
    ctx.textAlign = 'center';
    ctx.fillText('dynamics', cx, row2Y + 13);

    if (isLast) {
      // Single decode at end
      ctx.fillStyle = 'rgba(16,185,129,0.2)';
      ctx.strokeStyle = '#10b981';
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.roundRect(bx2, row2Y + 28, boxW1, 20, 4);
      ctx.fill(); ctx.stroke();
      ctx.fillStyle = '#10b981';
      ctx.font = '700 8px monospace';
      ctx.textAlign = 'center';
      ctx.fillText('DECODE', cx, row2Y + 41);
    } else {
      // Empty / latent-only indicator
      ctx.fillStyle = '#5c6370';
      ctx.font = 'italic 7px monospace';
      ctx.textAlign = 'center';
      ctx.fillText('latent only', cx, row2Y + 40);
    }

    // Arrow to next
    if (k < K - 1) {
      drawArrow(bx2 + boxW1, row2Y + 11, padL + (k+1)*cellW + 7, row2Y + 11);
    }

    // Action label below
    ctx.fillStyle = '#5c6370';
    ctx.font = '7px monospace';
    ctx.textAlign = 'center';
    ctx.fillText(actions[k], cx, row2Y + 72);
  }

  // Savings label
  const savX = padL + 2 * cellW;
  ctx.fillStyle = 'rgba(239,68,68,0.2)';
  ctx.font = '8px monospace';
  ctx.textAlign = 'center';
  ctx.fillText('↑ 5 decoder calls', savX, row1Y - 8);

  ctx.fillStyle = 'rgba(16,185,129,0.8)';
  ctx.fillText('↑ 1 decoder call — saves 4×', padL + 4 * cellW, row2Y - 8);
})();

// ─── Animated bar chart trigger ────────────────────────────────────────────
const barsSection = document.getElementById('s-results');
if (barsSection) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          b.style.width = b.dataset.w + '%';
        });
      }
    });
  }, { threshold: 0.3 }).observe(barsSection);
}
</script>
</BaseLayout>

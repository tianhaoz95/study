<span class="cs-line hl-a">            h = <span class="fn">layer</span>(h, obs, action)</span>
<span class="cs-line hl-a">        <span class="kw">return</span> h  <span class="cmt"># always: L × FLOPs</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Two failure modes:</span>
<span class="cs-line cmt">#  1. Compounding errors over horizon K</span>
<span class="cs-line cmt">#     err ~ (1+ε)^K → exponential blowup</span>
<span class="cs-line cmt">#  2. Deployment cost scales with L</span>
<span class="cs-line cmt">#     plan ×1000 rollouts = 1000 × L layers</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># LoopWM insight:</span>
<span class="cs-line cmt">#   T = f(transition_complexity)</span>
<span class="cs-line cmt">#   not a global hyperparameter</span>
      </pre>
    </div>

    <!-- panel: loop -->
    <div class="cs-panel" id="panel-loop">
      <pre class="cs-pre">
<span class="cs-line cmt"># Looped architecture: 1 shared block × T</span>
<span class="cs-line cmt"># Depth decoupled from parameter count</span>
<span class="cs-line"></span>
<span class="cs-line hl-p"><span class="kw">class</span> <span class="cls">LoopedCore</span>:</span>
<span class="cs-line hl-p">    <span class="kw">def</span> <span class="fn">__init__</span>(<span class="kw">self</span>, d=<span class="num">512</span>):</span>
<span class="cs-line hl-p">        <span class="cmt"># One shared block (not L unique!)</span></span>
<span class="cs-line hl-p">        <span class="kw">self</span>.block = <span class="fn">TransformerBlock</span>(d)</span>
<span class="cs-line"></span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">forward</span>(<span class="kw">self</span>, h, e, T):</span>
<span class="cs-line">        <span class="kw">for</span> t <span class="kw">in</span> <span class="fn">range</span>(T):</span>
<span class="cs-line hl-c">            <span class="cmt"># same weights every iteration</span></span>
<span class="cs-line hl-c">            h = Ā*h + B̄*e + <span class="fn">R̄</span>(h, e)</span>
<span class="cs-line">        <span class="kw">return</span> h</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Parameter count comparison:</span>
<span class="cs-line cmt"># Fixed-depth L=8:  8 × block_params</span>
<span class="cs-line cmt"># Looped T=8:       1 × block_params</span>
<span class="cs-line cmt"># Same effective depth. 8× fewer params.</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Variable T:  FixedDepth can't do this.</span>
<span class="cs-line cmt"># Looped runs T=2 or T=12 same model.</span>
<span class="cs-line"></span>
<span class="cs-line hl-g"><span class="cmt"># Stochastic training: T ~ Poisson(μ_rec)</span></span>
<span class="cs-line hl-g"><span class="cmt"># sampled per-sequence in each micro-batch</span></span>
<span class="cs-line hl-g"><span class="cmt"># → robustness to variable inference depth</span></span>
      </pre>
    </div>

    <!-- panel: arch -->
    <div class="cs-panel" id="panel-arch">
      <pre class="cs-pre">
<span class="cs-line cmt"># Spectral stability — guaranteed by design</span>
<span class="cs-line cmt"># No gradient clipping needed</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Continuous-time diagonal matrix:</span>
<span class="cs-line hl-p">A = <span class="fn">diag</span>(-<span class="fn">exp</span>(a))   <span class="cmt"># a ∈ ℝ^d learnable</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Zero-order hold discretization:</span>
<span class="cs-line hl-c">Ā = <span class="fn">exp</span>(Δ · A)       <span class="cmt"># Δ &gt; 0 learnable</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Result: all entries of Δ·A are negative</span>
<span class="cs-line cmt"># exp(negative) ∈ (0, 1)</span>
<span class="cs-line cmt"># → ρ(Ā) &lt; 1  (spectral radius)</span>
<span class="cs-line cmt"># → contractive: ‖h^(t)‖ stays bounded</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># PRC architecture blocks:</span>
<span class="cs-line">P = <span class="fn">Prelude</span>(L_P)   <span class="cmt"># processes obs+action once</span></span>
<span class="cs-line">R = <span class="fn">SharedBlock</span>(L_R) <span class="cmt"># shared, looped T times</span></span>
<span class="cs-line">C = <span class="fn">Coda</span>(L_C)     <span class="cmt"># processes final h^(T)</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Cross-timestep propagation:</span>
<span class="cs-line cmt"># h^(0) at step k = h^(T) from step k-1</span>
<span class="cs-line hl-g"><span class="cmt"># inner loop: refines within 1 transition</span></span>
<span class="cs-line hl-g"><span class="cmt"># outer loop: propagates across time steps</span></span>
<span class="cs-line hl-g"><span class="cmt"># both loops bounded by ρ(Ā) &lt; 1</span></span>
      </pre>
    </div>

    <!-- panel: adaptive -->
    <div class="cs-panel" id="panel-adaptive">
      <pre class="cs-pre">
<span class="cs-line cmt"># Adaptive exit gate — tiny overhead</span>
<span class="cs-line"></span>
<span class="cs-line hl-p">exit_gate = <span class="fn">Linear</span>(d, <span class="num">1</span>)  <span class="cmt"># &lt;&lt; 0.01% params</span></span>
<span class="cs-line"></span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">adaptive_forward</span>(h, e, T_max, τ=<span class="num">0.5</span>):</span>
<span class="cs-line">    <span class="kw">for</span> t <span class="kw">in</span> <span class="fn">range</span>(T_max):</span>
<span class="cs-line hl-c">        h = Ā*h + B̄*e + <span class="fn">R̄</span>(h, e)</span>
<span class="cs-line hl-c">        g = <span class="fn">sigmoid</span>(<span class="fn">exit_gate</span>(h))</span>
<span class="cs-line hl-g">        <span class="kw">if</span> g &gt; τ:   <span class="cmt"># converged!</span></span>
<span class="cs-line hl-g">            <span class="kw">break</span>  <span class="cmt"># exit after t+1 iters</span></span>
<span class="cs-line">    <span class="kw">return</span> h, t + <span class="num">1</span>  <span class="cmt"># actual depth used</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Example savings (100-layer equiv):</span>
<span class="cs-line cmt"># Free flight → T=4  : 25× FLOP reduction</span>
<span class="cs-line cmt"># Collision   → T=100: full depth needed</span>
<span class="cs-line cmt"># Avg rollout: ~2× reduction in practice</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Entropy regularizer (prevents gate collapse)</span>
<span class="cs-line hl-a">L_ent = -α * <span class="fn">E</span>[<span class="fn">sum</span>(<span class="fn">H</span>(g_t) <span class="kw">for</span> t <span class="kw">in</span> T)]</span>
<span class="cs-line hl-a"><span class="cmt"># H = binary entropy; α balances exploration</span></span>
      </pre>
    </div>

    <!-- panel: deferred -->
    <div class="cs-panel" id="panel-deferred">
      <pre class="cs-pre">
<span class="cs-line cmt"># Deferred Decoding: K steps, 1 decode</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Standard (baseline): K decoder calls</span>
<span class="cs-line hl-a"><span class="kw">for</span> k <span class="kw">in</span> <span class="fn">range</span>(K):</span>
<span class="cs-line hl-a">    u = <span class="fn">embed_action</span>(actions[k])</span>
<span class="cs-line hl-a">    h = <span class="fn">looped_core</span>(h, u)  <span class="cmt"># dynamics</span></span>
<span class="cs-line hl-a">    obs, rew, c = <span class="fn">decode</span>(h) <span class="cmt"># decode every step</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Deferred: 1 decoder call (step K only)</span>
<span class="cs-line hl-p"><span class="kw">for</span> k <span class="kw">in</span> <span class="fn">range</span>(K):</span>
<span class="cs-line hl-p">    u = <span class="fn">embed_action</span>(actions[k])</span>
<span class="cs-line hl-p">    h = <span class="fn">looped_core</span>(h, u)  <span class="cmt"># latent only!</span></span>
<span class="cs-line hl-g">obs, rew, c = <span class="fn">decode</span>(h)  <span class="cmt"># once at the end</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Training: curriculum over deferral horizon</span>
<span class="cs-line cmt"># K_schedule(step) = min(K_max, 1 + step//Δ)</span>
<span class="cs-line cmt"># Start with K=1, grow to K_max gradually</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Latent consistency loss (soft supervision)</span>
<span class="cs-line hl-c">e_k_ref = <span class="fn">sg</span>(<span class="fn">encoder</span>(obs_k))  <span class="cmt"># stop-grad</span></span>
<span class="cs-line hl-c">L_consist = <span class="fn">mse</span>(<span class="fn">proj_head</span>(h_k), e_k_ref)</span>
      </pre>
    </div>

    <!-- panel: results -->
    <div class="cs-panel" id="panel-results">
      <pre class="cs-pre">
<span class="cs-line cmt"># ScienceWorld — Exact Match (EM)</span>
<span class="cs-line cmt"># Task: predict state after 5 actions</span>
<span class="cs-line"></span>
<span class="cs-line hl-p"><span class="cmt"># Model          | EM     | Params</span></span>

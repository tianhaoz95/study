.bar-fill{height:100%;border-radius:4px;transition:width 1s ease;display:flex;align-items:center;justify-content:flex-end;padding-right:.5rem;width:0%}
.bar-fill span{font-size:.65rem;font-weight:700;font-family:var(--ff-mono);color:rgba(255,255,255,.85)}

/* Inline controls */
.viz-controls{display:flex;align-items:center;gap:.625rem;flex-wrap:wrap;margin-bottom:.75rem}
.viz-btn{padding:.3rem .8rem;border-radius:5px;font-size:.72rem;font-family:var(--ff-mono);cursor:pointer;border:1px solid var(--border-hi);background:var(--surface);color:var(--muted2);transition:all .15s}
.viz-btn:hover{border-color:var(--cyan);color:var(--cyan);background:var(--cyan-dim)}

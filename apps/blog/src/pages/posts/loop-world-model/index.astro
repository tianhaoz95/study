      <text x="50" y="195" text-anchor="middle" fill="#06b6d4" font-size="9" font-family="monospace">Action</text>
      <text x="50" y="208" text-anchor="middle" fill="#5c6370" font-size="8" font-family="monospace">A&#968;</text>

      <!-- action label -->
      <text x="50" y="234" text-anchor="middle" fill="#5c6370" font-size="8" font-family="monospace">a&#8342;</text>
      <line x1="50" y1="220" x2="50" y2="228" stroke="#5c6370" stroke-width="1"/>

      <!-- Prelude box -->
      <rect x="130" y="90" width="80" height="70" rx="6" fill="#1a1330" stroke="#8b5cf6" stroke-width="1.2"/>
      <text x="170" y="122" text-anchor="middle" fill="#8b5cf6" font-size="9" font-family="monospace">Prelude P</text>

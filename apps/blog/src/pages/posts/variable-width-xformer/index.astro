      <pre class="cs-pre">
<span class="cs-line cmt"># Standard transformer: constant width d</span>
<span class="cs-line cmt"># at every layer — is this optimal?</span>
<span class="cs-line"></span>
<span class="cs-line kw">class</span> <span class="cs-line cls">ConstantWidthTransformer</span><span class="cs-line">:</span>
<span class="cs-line hl-a">    <span class="cmt"># 2B model: d=1600 at all 40 layers</span></span>
<span class="cs-line hl-a">    <span class="cmt"># params per layer ∝ d² = 2.56M/layer</span></span>
<span class="cs-line hl-a">    <span class="cmt"># same budget for layer 1 (syntax)</span></span>
<span class="cs-line hl-a">    <span class="cmt"># and layer 20 (semantic collapse!)</span></span>
<span class="cs-line"></span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">__init__</span>(self):</span>
<span class="cs-line">        self.d = <span class="num">1600</span>   <span class="cmt"># same for ALL layers</span></span>
<span class="cs-line">        self.L = <span class="num">40</span></span>
<span class="cs-line">        self.layers = [</span>
<span class="cs-line">            <span class="fn">TransformerBlock</span>(d=self.d)</span>
<span class="cs-line">            <span class="kw">for</span> _ <span class="kw">in</span> <span class="fn">range</span>(self.L)</span>
<span class="cs-line">        ]</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Parameter count: O(d²) per layer</span>
<span class="cs-line cmt"># Attention FLOPs: O(N²·d) per layer</span>
<span class="cs-line cmt"># KV cache: O(N·d) per layer</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Question: do all layers NEED d=1600?</span>
<span class="cs-line cmt"># Layer functions differ radically:</span>
<span class="cs-line cmt"># Layer 1: tokenization, position</span>
<span class="cs-line cmt"># Layer 20: semantic associations</span>
<span class="cs-line cmt"># Layer 40: next-token prediction</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Prior work on scaling found model</span>
<span class="cs-line cmt"># shape (width:depth ratio) matters.</span>
<span class="cs-line cmt"># &gt;&lt;former asks: what about varying</span>
<span class="cs-line cmt"># width WITHIN a model?</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-valley">
      <pre class="cs-pre">
<span class="cs-line cmt"># Normalized Matrix Entropy</span>
<span class="cs-line cmt"># measures representation diversity</span>
<span class="cs-line cmt"># across token-representation matrix X</span>
<span class="cs-line"></span>
<span class="cs-line kw">def</span> <span class="fn">normalized_entropy</span>(X):</span>
<span class="cs-line">    <span class="cmt"># X: [n_tokens, d] hidden states</span></span>
<span class="cs-line">    _, s, _ = torch.<span class="fn">linalg.svd</span>(X)</span>
<span class="cs-line">    p = s**<span class="num">2</span> / (s**<span class="num">2</span>).<span class="fn">sum</span>()</span>
<span class="cs-line hl-p">    <span class="cmt"># pⱼ = σⱼ² / ‖X‖²_F</span></span>
<span class="cs-line hl-p">    r = <span class="fn">len</span>(s)</span>
<span class="cs-line hl-p">    H = -(p * p.<span class="fn">log</span>()).<span class="fn">sum</span>() / <span class="fn">log</span>(r)</span>
<span class="cs-line">    <span class="kw">return</span> H  <span class="cmt"># H ∈ [0, 1]</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># H → 0: all tokens map to same vector</span>
<span class="cs-line cmt"># (representation collapse)</span>
<span class="cs-line cmt"># H → 1: all dimensions used evenly</span>
<span class="cs-line cmt"># (full capacity utilization)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Observed in 2B constant-width model:</span>
<span class="cs-line cmt"># Layer  1: H ≈ 0.85  (start: diverse)</span>
<span class="cs-line cmt"># Layer 10: H ≈ 0.40  (declining)</span>
<span class="cs-line cmt"># Layer 20: H ≈ 0.05  (near collapse!)</span>
<span class="cs-line cmt"># Layer 30: H ≈ 0.45  (recovering)</span>
<span class="cs-line cmt"># Layer 40: H ≈ 0.72  (end: diverse)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Observed in 2B &gt;&lt;former:</span>
<span class="cs-line hl-g"><span class="cmt"># Layer 10: H ≈ 0.32  (compressing)</span></span>
<span class="cs-line hl-g"><span class="cmt"># Layer 20: H ≈ 0.50  (maintained!)</span></span>
<span class="cs-line hl-g"><span class="cmt"># Layer 30: H ≈ 0.55  (bottleneck)</span></span>
<span class="cs-line hl-g"><span class="cmt"># Layer 40: H ≈ 0.85  (end: diverse)</span></span>
<span class="cs-line cmt"># Physical constraint prevents collapse</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-shape">
      <pre class="cs-pre">
<span class="cs-line cmt"># Geometric width schedule</span>
<span class="cs-line cmt"># Two parameters: r_ℓ and r_d</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># r_ℓ = bottleneck layer / L</span>
<span class="cs-line cmt"># r_d = bottleneck dim / d</span>
<span class="cs-line cmt"># optimal: r_ℓ=0.75, r_d=0.3</span>
<span class="cs-line"></span>
<span class="cs-line kw">def</span> <span class="fn">get_layer_widths</span>(L, d, r_l, r_d):</span>
<span class="cs-line hl-p">    l_star = <span class="fn">int</span>(r_l * L)   <span class="cmt"># bottleneck idx</span></span>
<span class="cs-line hl-p">    d_star = r_d * d        <span class="cmt"># bottleneck dim</span></span>
<span class="cs-line"></span>
<span class="cs-line">    <span class="cmt"># Geometric decay d → d_star</span></span>
<span class="cs-line">    alpha_minus = (d_star/d)**(</span>
<span class="cs-line">        <span class="num">1</span>/(l_star-<span class="num">1</span>))</span>
<span class="cs-line">    <span class="cmt"># Geometric growth d_star → d</span></span>
<span class="cs-line">    alpha_plus = (d/d_star)**(</span>
<span class="cs-line">        <span class="num">1</span>/(L-l_star))</span>
<span class="cs-line"></span>
<span class="cs-line">    widths = []</span>
<span class="cs-line">    w = d</span>
<span class="cs-line">    <span class="kw">for</span> l <span class="kw">in</span> <span class="fn">range</span>(<span class="num">1</span>, L+<span class="num">1</span>):</span>
<span class="cs-line">        widths.<span class="fn">append</span>(<span class="fn">round32</span>(w))</span>
<span class="cs-line">        <span class="kw">if</span> l &lt; l_star:</span>
<span class="cs-line">            w *= alpha_minus</span>
<span class="cs-line">        <span class="kw">else</span>:</span>
<span class="cs-line">            w *= alpha_plus</span>
<span class="cs-line">    <span class="kw">return</span> widths</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># 2B model (L=40, d=1600):</span>
<span class="cs-line cmt"># widths[0]  = 1600 (layer 1)</span>
<span class="cs-line cmt"># widths[29] = 480  (layer 30, bottleneck)</span>
<span class="cs-line cmt"># widths[39] = 1600 (layer 40)</span>
<span class="cs-line cmt"># avg = 1426 (vs 1600 for baseline)</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-residual">
      <pre class="cs-pre">
<span class="cs-line cmt"># Fixed-residual carry-forward</span>
<span class="cs-line cmt"># Parameter-free expansion between layers</span>
<span class="cs-line"></span>
<span class="cs-line kw">def</span> <span class="fn">carry_forward_expand</span>(</span>
<span class="cs-line">    x_prev,       <span class="cmt"># [d_prev] residual</span></span>
<span class="cs-line">    d_new,        <span class="cmt"># new (larger) width</span></span>
<span class="cs-line">    residual_hist <span class="cmt"># past layer outputs</span></span>
<span class="cs-line">):</span>
<span class="cs-line hl-p">    x_new = torch.<span class="fn">zeros</span>(d_new)</span>
<span class="cs-line hl-p">    x_new[:d_prev] = x_prev  <span class="cmt"># copy known</span></span>
<span class="cs-line"></span>
<span class="cs-line">    <span class="cmt"># Restore bypassed dims</span></span>
<span class="cs-line hl-c">    <span class="kw">for</span> i <span class="kw">in</span> <span class="fn">range</span>(d_prev, d_new):</span>
<span class="cs-line hl-c">        <span class="cmt"># find last layer that processed dim i</span></span>
<span class="cs-line hl-c">        l_prime = <span class="fn">max</span>(</span>
<span class="cs-line hl-c">            l <span class="kw">for</span> l, h <span class="kw">in</span> <span class="fn">enumerate</span>(residual_hist)</span>
<span class="cs-line hl-c">            <span class="kw">if</span> <span class="fn">len</span>(h) &gt; i</span>
<span class="cs-line hl-c">        )</span>
<span class="cs-line hl-c">        x_new[i] = residual_hist[l_prime][i]</span>
<span class="cs-line">    <span class="kw">return</span> x_new</span>
<span class="cs-line"></span>
<span class="cs-line kw">def</span> <span class="fn">truncate</span>(x, d_new):  <span class="cmt"># narrowing</span></span>
<span class="cs-line">    <span class="kw">return</span> x[:d_new]  <span class="cmt"># just slice</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Ablation at 500M scale:</span>
<span class="cs-line hl-g"><span class="cmt"># carry-forward:   loss 3.099  ← best</span></span>
<span class="cs-line cmt"># zero-padding:    loss 3.124</span>
<span class="cs-line cmt"># learned proj:    loss 3.150  ← worst</span>
<span class="cs-line cmt">#</span></span>
<span class="cs-line cmt"># Projection adds params & changes the</span>
<span class="cs-line cmt"># skip path — hurts more than it helps.</span>
<span class="cs-line cmt"># Zero-padding erases bypassed info.</span>
<span class="cs-line cmt"># Carry-forward preserves both.</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-efficiency">
      <pre class="cs-pre">
<span class="cs-line cmt"># Why parameter-matching guarantees</span>
<span class="cs-line cmt"># lower FLOPs and smaller KV cache</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Parameter count per layer ∝ d_ℓ²</span>
<span class="cs-line cmt"># Match total params to baseline:</span>
<span class="cs-line cmt">#   Σ d_ℓ² = L · d²</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Jensen's inequality:</span>
<span class="cs-line cmt">#   (mean d_ℓ)² ≤ mean(d_ℓ²)</span>
<span class="cs-line hl-p"><span class="cmt"># ∴ avg(d_ℓ) &lt; d  when widths vary</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># KV cache ∝ avg(d_ℓ)  → smaller ✓</span>
<span class="cs-line cmt"># Attn FLOPs ∝ N²·Σd_ℓ → smaller ✓</span>
<span class="cs-line cmt"># Dense FLOPs ∝ Σd_ℓ²  → same ✗</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># 2B model numbers:</span>
<span class="cs-line hl-c"><span class="cmt"># Baseline avg dim:  1600</span></span>
<span class="cs-line hl-c"><span class="cmt"># &gt;&lt;former avg dim:  1426  (−10.9%)</span></span>
<span class="cs-line hl-c"><span class="cmt"># Baseline FLOPs: 16.92 PFD</span></span>
<span class="cs-line hl-c"><span class="cmt"># &gt;&lt;former FLOPs: 16.49 PFD  (−2.5%)</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Scaling law (loss-matched):</span>
<span class="cs-line hl-g"><span class="cmt"># Baseline: 3.16 × C^(−0.0498)</span></span>
<span class="cs-line hl-g"><span class="cmt"># &gt;&lt;former: 3.12 × C^(−0.0503)</span></span>
<span class="cs-line hl-g"><span class="cmt"># To match 2B loss (2.751):</span></span>
<span class="cs-line hl-g"><span class="cmt">#   77.8% FLOPs, 85.1% avg KV width</span></span>
<span class="cs-line hl-g"><span class="cmt">#   → 22% FLOP reduction at same loss</span></span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-results">
      <pre class="cs-pre">
<span class="cs-line cmt"># 2B model: zero-shot downstream eval</span>
<span class="cs-line cmt"># lm-evaluation-harness, 11 benchmarks</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Perplexity (lower is better):</span>
<span class="cs-line cmt"># Task         Baseline  &gt;&lt;former</span>
<span class="cs-line hl-g"><span class="cmt"># LAMBADA PPL    8.18     7.43   ↓</span></span>
<span class="cs-line hl-g"><span class="cmt"># WikiText PPL  16.96    16.32   ↓</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Accuracy (higher is better):</span>

<script>
// ── TOC + sidebar toggles ──
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});
const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ── Code sidebar tab switching ──
const tabMeta = {
  problem:    { file: 'xformer/arch.py',       title: 'The Problem' },
  valley:     { file: 'xformer/entropy.py',    title: 'Compression Valley' },
  shape:      { file: 'xformer/schedule.py',   title: 'The ×-Shape' },
  residual:   { file: 'xformer/residual.py',   title: 'Fixed Residual' },
  efficiency: { file: 'xformer/efficiency.py', title: 'Why It\'s Cheaper' },
  results:    { file: 'xformer/results.py',    title: 'Results' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ── IntersectionObserver — TOC + sidebar sync ──
const sectionMap = {
  's-problem':    'problem',
  's-valley':     'valley',
  's-shape':      'shape',
  's-residual':   'residual',
  's-efficiency': 'efficiency',
  's-results':    'results',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ════════════════════════════════
// §02 — Compression Valley Canvas
// ════════════════════════════════
(function() {
  const canvas = document.getElementById('valley-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 240;
  canvas.width = W * DPR; canvas.height = H * DPR; ctx.scale(DPR, DPR);
  const tooltip = document.getElementById('valley-tooltip');

  // Approximated entropy curves based on paper Figure 7 description
  // Constant-width: severe compression valley in middle layers
  const cwEntropy = [
    0.85,0.82,0.78,0.72,0.64, // 1-5
    0.55,0.46,0.38,0.28,0.18, // 6-10
    0.12,0.08,0.06,0.05,0.04, // 11-15
    0.04,0.05,0.05,0.06,0.07, // 16-20
    0.08,0.10,0.13,0.17,0.23, // 21-25
    0.30,0.38,0.44,0.50,0.55, // 26-30
    0.59,0.62,0.64,0.65,0.66, // 31-35
    0.67,0.68,0.70,0.71,0.72  // 36-40
  ];
  // ><former: avoids collapse, maintains higher entropy
  const xfEntropy = [
    0.42,0.40,0.38,0.36,0.34, // 1-5 (actively compressing)
    0.32,0.30,0.30,0.31,0.32, // 6-10
    0.35,0.38,0.41,0.44,0.47, // 11-15
    0.49,0.50,0.51,0.52,0.52, // 16-20
    0.53,0.54,0.55,0.55,0.56, // 21-25
    0.56,0.57,0.58,0.58,0.57, // 26-30 (bottleneck zone)
    0.60,0.64,0.68,0.72,0.77, // 31-35
    0.80,0.82,0.83,0.84,0.85  // 36-40
  ];

  const L = 40;
  const PAD = { top: 30, right: 20, bottom: 36, left: 52 };
  const pw = W - PAD.left - PAD.right;
  const ph = H - PAD.top - PAD.bottom;

  function xOf(i) { return PAD.left + (i / (L - 1)) * pw; }
  function yOf(v) { return PAD.top + (1 - v) * ph; }

  let hoverIdx = -1;

  function draw() {
    ctx.clearRect(0, 0, W, H);

    // Grid lines
    ctx.strokeStyle = 'rgba(255,255,255,0.04)';
    ctx.lineWidth = 1;
    [0.25, 0.5, 0.75, 1.0].forEach(v => {
      ctx.beginPath();
      ctx.moveTo(PAD.left, yOf(v));
      ctx.lineTo(PAD.left + pw, yOf(v));
      ctx.stroke();
    });

    // Axis labels (y)
    ctx.fillStyle = '#6b7280';
    ctx.font = `${9 * DPR / DPR}px monospace`;
    ctx.textAlign = 'right';
    [0, 0.25, 0.5, 0.75, 1.0].forEach(v => {
      ctx.fillText(v.toFixed(2), PAD.left - 5, yOf(v) + 3);
    });
    // Axis title (y)
    ctx.save(); ctx.translate(10, H / 2); ctx.rotate(-Math.PI / 2);
    ctx.textAlign = 'center'; ctx.fillText('normalized entropy', 0, 0);
    ctx.restore();

    // x-axis labels
    ctx.textAlign = 'center';
    [1, 10, 20, 30, 40].forEach(l => {
      ctx.fillText(l, xOf(l - 1), H - 8);
    });
    ctx.fillText('layer', PAD.left + pw / 2, H - 2);

    // Bottleneck region shading (layers 28-32)
    ctx.fillStyle = 'rgba(139,92,246,0.05)';
    ctx.fillRect(xOf(27), PAD.top, xOf(31) - xOf(27), ph);
    ctx.strokeStyle = 'rgba(139,92,246,0.2)';
    ctx.lineWidth = 1;
    ctx.setLineDash([3, 3]);
    ctx.beginPath(); ctx.moveTo(xOf(29), PAD.top); ctx.lineTo(xOf(29), PAD.top + ph); ctx.stroke();
    ctx.setLineDash([]);

    // Bottleneck label
    ctx.fillStyle = 'rgba(139,92,246,0.6)';
    ctx.textAlign = 'center';
    ctx.font = '8px monospace';
    ctx.fillText('bottleneck', xOf(29), PAD.top - 4);

    // Constant-width line (grey)
    ctx.beginPath();
    ctx.strokeStyle = '#6b7280';
    ctx.lineWidth = 2;
    cwEntropy.forEach((v, i) => {
      if (i === 0) ctx.moveTo(xOf(i), yOf(v));
      else ctx.lineTo(xOf(i), yOf(v));
    });
    ctx.stroke();

    // ><former line (purple)
    ctx.beginPath();
    ctx.strokeStyle = '#8b5cf6';
    ctx.lineWidth = 2.5;
    xfEntropy.forEach((v, i) => {
      if (i === 0) ctx.moveTo(xOf(i), yOf(v));
      else ctx.lineTo(xOf(i), yOf(v));
    });
    ctx.stroke();

    // Hover point
    if (hoverIdx >= 0 && hoverIdx < L) {
      const cw = cwEntropy[hoverIdx];
      const xf = xfEntropy[hoverIdx];
      const x = xOf(hoverIdx);

      ctx.beginPath(); ctx.arc(x, yOf(cw), 4, 0, Math.PI * 2);
      ctx.fillStyle = '#6b7280'; ctx.fill();
      ctx.beginPath(); ctx.arc(x, yOf(xf), 4, 0, Math.PI * 2);
      ctx.fillStyle = '#8b5cf6'; ctx.fill();

      // Vertical guide
      ctx.strokeStyle = 'rgba(255,255,255,0.08)';
      ctx.lineWidth = 1;
      ctx.setLineDash([2, 2]);
      ctx.beginPath(); ctx.moveTo(x, PAD.top); ctx.lineTo(x, PAD.top + ph); ctx.stroke();
      ctx.setLineDash([]);
    }

    // Legend
    ctx.textAlign = 'left';
    ctx.font = '9px monospace';
    ctx.fillStyle = '#6b7280'; ctx.fillRect(PAD.left + 4, PAD.top + 4, 14, 2);
    ctx.fillStyle = '#9ca3af'; ctx.fillText('Constant-width (compression valley)', PAD.left + 22, PAD.top + 8);
    ctx.fillStyle = '#8b5cf6'; ctx.fillRect(PAD.left + 4, PAD.top + 16, 14, 2);
    ctx.fillStyle = '#a78bfa'; ctx.fillText('><former (avoids collapse)', PAD.left + 22, PAD.top + 20);
  }

  draw();

  // Hover interaction
  canvas.addEventListener('mousemove', e => {
    const rect = canvas.getBoundingClientRect();
    const mx = e.clientX - rect.left;
    const idx = Math.round((mx - PAD.left) / pw * (L - 1));
    if (idx >= 0 && idx < L) {
      hoverIdx = idx;
      const cw = cwEntropy[idx].toFixed(3);
      const xf = xfEntropy[idx].toFixed(3);
      tooltip.innerHTML = `Layer ${idx + 1}: Constant-width H=${cw} &nbsp;|&nbsp; &gt;&lt;former H=${xf}`;
      draw();
    }
  });
  canvas.addEventListener('mouseleave', () => {
    hoverIdx = -1;
    tooltip.textContent = '';
    draw();
  });
})();

// ════════════════════════════════
// §03 — Width Profile Shape Canvas
// ════════════════════════════════
(function() {
  const canvas = document.getElementById('shape-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 200;
  canvas.width = W * DPR; canvas.height = H * DPR; ctx.scale(DPR, DPR);
  const info = document.getElementById('shape-info');

  const L = 40;
  let currentShape = 'x';
  let currentRd = 0.3;

  function computeWidths(shape, rd) {
    if (shape === 'uniform') return Array(L).fill(1.0);
    const rL = 0.75;
    const lStar = Math.round(rL * L); // 30

    if (shape === 'x') {
      const aMinus = Math.pow(rd, 1 / (lStar - 1));
      const aPlus  = Math.pow(1 / rd, 1 / (L - lStar));
      const widths = [];
      let w = 1.0;
      for (let i = 0; i < L; i++) {
        widths.push(w);
        if (i < lStar - 1) w *= aMinus;
        else w *= aPlus;
      }
      return widths;
    }
    if (shape === 'hourglass3') {
      // 3-shape: narrow ends, wide middle (opposite of x)
      const aMinus = Math.pow(1 / rd, 1 / (lStar - 1));
      const aPlus  = Math.pow(rd, 1 / (L - lStar));
      const widths = [];
      let w = rd;
      for (let i = 0; i < L; i++) {
        widths.push(w);
        if (i < lStar - 1) w *= aMinus;
        else w *= aPlus;
      }
      return widths;
    }
    if (shape === 'wedge-down') {
      // ∧-shape: wide at start, narrow at end
      const a = Math.pow(rd, 1 / (L - 1));
      return Array.from({ length: L }, (_, i) => Math.pow(a, i));
    }
    if (shape === 'wedge-up') {
      // ∨-shape: narrow at start, wide at end
      const a = Math.pow(rd, 1 / (L - 1));
      return Array.from({ length: L }, (_, i) => Math.pow(a, L - 1 - i));
    }
    return Array(L).fill(1.0);
  }

  function drawShape(widths, shape) {
    ctx.clearRect(0, 0, W, H);
    const PAD = { top: 18, right: 10, bottom: 28, left: 50 };
    const pw = W - PAD.left - PAD.right;
    const ph = H - PAD.top - PAD.bottom;
    const bw = pw / L;

    // Grid lines
    ctx.strokeStyle = 'rgba(255,255,255,0.04)';
    ctx.lineWidth = 1;
    [0.25, 0.5, 0.75, 1.0].forEach(v => {
      const y = PAD.top + (1 - v) * ph;
      ctx.beginPath(); ctx.moveTo(PAD.left, y); ctx.lineTo(PAD.left + pw, y); ctx.stroke();
      ctx.fillStyle = '#6b7280'; ctx.font = '8px monospace'; ctx.textAlign = 'right';
      ctx.fillText((v * 1600).toFixed(0), PAD.left - 4, y + 3);
    });

    // Axis label
    ctx.save(); ctx.translate(10, H / 2); ctx.rotate(-Math.PI / 2);
    ctx.textAlign = 'center'; ctx.fillStyle = '#6b7280'; ctx.font = '8px monospace';
    ctx.fillText('layer width d_ℓ', 0, 0); ctx.restore();
    ctx.textAlign = 'center';
    ctx.fillText('layer index (1–40)', PAD.left + pw / 2, H - 4);

    // Bars
    widths.forEach((w, i) => {
      const x = PAD.left + i * bw + 1;
      const barH = w * ph;
      const y = PAD.top + ph - barH;
      const isBottleneck = (i === 29) && shape === 'x';
      ctx.fillStyle = isBottleneck
        ? 'rgba(6,182,212,0.7)'
        : shape === 'uniform'
          ? 'rgba(107,114,128,0.5)'
          : 'rgba(139,92,246,0.55)';
      ctx.fillRect(x, y, bw - 2, barH);
      if (isBottleneck) {
        ctx.strokeStyle = 'rgba(6,182,212,0.9)'; ctx.lineWidth = 1;
        ctx.strokeRect(x, y, bw - 2, barH);
      }
    });

    // Uniform baseline line
    if (shape !== 'uniform') {
      ctx.strokeStyle = 'rgba(107,114,128,0.35)';
      ctx.lineWidth = 1; ctx.setLineDash([4, 4]);
      ctx.beginPath(); ctx.moveTo(PAD.left, PAD.top); ctx.lineTo(PAD.left + pw, PAD.top); ctx.stroke();
      ctx.setLineDash([]);
      ctx.fillStyle = 'rgba(107,114,128,0.5)'; ctx.font = '8px monospace'; ctx.textAlign = 'left';
      ctx.fillText('uniform d=1600', PAD.left + 4, PAD.top - 4);
    }
  }

  function update() {
    const widths = computeWidths(currentShape, currentRd);
    drawShape(widths, currentShape);
    const avg = widths.reduce((a, b) => a + b, 0) / L;
    const min = Math.min(...widths);
    const shapeNames = { uniform: 'Uniform', x: '×-shape (><former)', hourglass3: '3-shape', 'wedge-down': '∧-shape', 'wedge-up': '∨-shape' };
    if (currentShape === 'x') {
      info.textContent = `${shapeNames[currentShape]} | bottleneck layer 30 = ${(currentRd * 1600).toFixed(0)} dims (r_d=${currentRd}) | avg = ${(avg * 1600).toFixed(0)} dims (${(avg * 100).toFixed(1)}% of baseline)`;
    } else {
      info.textContent = `${shapeNames[currentShape]} | min = ${(min * 1600).toFixed(0)} dims | avg = ${(avg * 1600).toFixed(0)} dims`;
    }
  }

  // Shape buttons
  document.querySelectorAll('.shape-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.shape-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentShape = btn.dataset.shape;
      // Only show r_d controls for shapes that use it meaningfully
      const rdBtns = document.getElementById('rd-btns');
      rdBtns.style.opacity = ['uniform'].includes(currentShape) ? '0.3' : '1';
      update();
    });
  });

  // r_d buttons
  document.querySelectorAll('.rd-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.rd-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentRd = parseFloat(btn.dataset.rd);
      update();
    });
  });

  update();
})();

// ════════════════════════════════
// §04 — Step Navigator (residual)
// ════════════════════════════════
(function() {
  const boxes   = document.querySelectorAll('#residual-steps .step-box');
  const prevBtn = document.getElementById('res-prev');
  const nextBtn = document.getElementById('res-next');
  const progEl  = document.getElementById('res-prog');
  const canvas  = document.getElementById('residual-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 90;
  canvas.width = W * DPR; canvas.height = H * DPR; ctx.scale(DPR, DPR);

  let step = 0;
  const TOTAL = boxes.length;

  // Visual configuration per step
  const STEPS_VIZ = [
    // Step 0: Wide layer — all 1600 dims active
    { dims: 48, activeDims: 48, restored: 0, label: 'Layer wide (d=1600): all 48 dims active', bottleneckAt: -1 },
    // Step 1: Narrowing to 480 — only first 14 active
    { dims: 48, activeDims: 14, restored: 0, label: 'Narrowing to d=480: dims [480:1600] bypass unchanged', bottleneckAt: 14 },
    // Step 2: Widening back to 960 — restore dims [14:28]
    { dims: 48, activeDims: 14, restored: 14, label: 'Widening to d=960: dims [480:960] restored from last wide layer', bottleneckAt: 14 },
    // Step 3: Back to full width
    { dims: 48, activeDims: 48, restored: 0, label: 'Result: carry-forward beats projection (3.099 vs 3.150 loss)', bottleneckAt: -1 },
  ];

  function drawResidual(s) {
    ctx.clearRect(0, 0, W, H);
    const viz = STEPS_VIZ[s];
    const N = viz.dims;
    const bw = (W - 20) / N;
    const bh = 40;
    const y0 = (H - bh) / 2;

    for (let i = 0; i < N; i++) {
      const x = 10 + i * bw;
      let color;
      if (i < viz.activeDims) {
        color = 'rgba(139,92,246,0.7)'; // active: purple
      } else if (viz.restored > 0 && i < viz.activeDims + viz.restored) {
        color = 'rgba(16,185,129,0.6)'; // restored: green
      } else {
        color = 'rgba(107,114,128,0.2)'; // bypassed: dim grey
      }
      ctx.fillStyle = color;
      ctx.fillRect(x + 1, y0, bw - 2, bh);
    }

    // Bottleneck line
    if (viz.bottleneckAt > 0) {
      const bx = 10 + viz.bottleneckAt * bw;
      ctx.strokeStyle = 'rgba(6,182,212,0.8)'; ctx.lineWidth = 2; ctx.setLineDash([3, 3]);
      ctx.beginPath(); ctx.moveTo(bx, y0 - 5); ctx.lineTo(bx, y0 + bh + 5); ctx.stroke();
      ctx.setLineDash([]);
      ctx.fillStyle = 'rgba(6,182,212,0.7)'; ctx.font = '8px monospace'; ctx.textAlign = 'left';
      ctx.fillText('d=480', bx + 3, y0 - 7);
    }

    // Legend
    const ly = y0 + bh + 14;
    ctx.font = '8px monospace'; ctx.textAlign = 'left';
    ctx.fillStyle = 'rgba(139,92,246,0.7)'; ctx.fillRect(10, ly, 10, 8);
    ctx.fillStyle = '#9ca3af'; ctx.fillText('active', 24, ly + 7);
    if (viz.restored > 0) {
      ctx.fillStyle = 'rgba(16,185,129,0.6)'; ctx.fillRect(70, ly, 10, 8);
      ctx.fillStyle = '#9ca3af'; ctx.fillText('restored (carry-fwd)', 84, ly + 7);
    } else {
      ctx.fillStyle = 'rgba(107,114,128,0.25)'; ctx.fillRect(70, ly, 10, 8);
      ctx.fillStyle = '#9ca3af'; ctx.fillText('bypassed (unchanged)', 84, ly + 7);
    }
    ctx.textAlign = 'right';
    ctx.fillStyle = '#6b7280'; ctx.fillText(`Step ${s + 1}: ${viz.label}`, W - 10, 10);
  }

  function updateSteps() {
    boxes.forEach((b, i) => {
      b.classList.remove('active', 'done');
      if (i === step) b.classList.add('active');
      else if (i < step) b.classList.add('done');
    });
    boxes.forEach((b, i) => {
      const n = b.querySelector('.step-num');
      if (n) n.textContent = i < step ? '✓' : String(i + 1);
    });
    prevBtn.disabled = step === 0;
    nextBtn.disabled = step === TOTAL - 1;
    progEl.textContent = `Step ${step + 1} of ${TOTAL}`;
    drawResidual(step);
  }

  prevBtn.addEventListener('click', () => { if (step > 0) { step--; updateSteps(); } });
  nextBtn.addEventListener('click', () => { if (step < TOTAL - 1) { step++; updateSteps(); } });
  updateSteps();
})();

// ════════════════════════════════
// §06 — Animated bar chart trigger
// ════════════════════════════════
const resultsSection = document.getElementById('s-results');
if (resultsSection) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        // Scale bar-fill widths relative to max value in group
        // KV cache bars: max reduction is 11% → scale to 90% track width
        // FLOP bars: max reduction is 4.6% → scale to 90%
        const allBars = document.querySelectorAll('.bar-fill[data-w]');
        const maxKV = 11, maxFlop = 4.6;
        allBars.forEach(b => {
          const v = parseFloat(b.dataset.w);
          // Determine if this is a KV bar (first group) or FLOP bar (second group)
          const pct = (v / maxKV) * 85; // scale to 85% of track
          b.style.width = pct + '%';
        });
      }
    });
  }, { threshold: 0.25 }).observe(resultsSection);
}
</script>
</BaseLayout>

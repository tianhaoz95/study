<span class="cs-line cmt"># probabilities unchanged; remaining</span>
<span class="cs-line cmt"># mass is uniform over |V|-k tokens</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Then: S'^t = W_E · softmax(f_k(ℓ̂))</span>
<span class="cs-line"> </span>

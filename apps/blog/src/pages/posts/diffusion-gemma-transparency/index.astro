      <text x="220" y="82" text-anchor="middle" font-size="10" fill="rgba(107,114,128,.8)" font-family="monospace">denoising step 1</text>
      <!-- Inner blocks -->
      <rect x="168" y="90" width="104" height="30" rx="4" fill="rgba(139,92,246,.2)" stroke="rgba(139,92,246,.4)"/>
      <text x="220" y="109" text-anchor="middle" font-size="9" fill="#c4b5fd" font-family="monospace">transformer layers</text>
      <rect x="168" y="130" width="104" height="30" rx="4" fill="rgba(6,182,212,.15)" stroke="rgba(6,182,212,.35)"/>
      <text x="220" y="149" text-anchor="middle" font-size="9" fill="#67e8f9" font-family="monospace">sampling + S^t</text>
      <!-- Canvas in -->
      <line x1="100" y1="165" x2="154" y2="165" stroke="rgba(16,185,129,.7)" stroke-width="1.5" marker-end="url(#arr-g)"/>
      <text x="122" y="157" text-anchor="middle" font-size="8" fill="rgba(16,185,129,.8)">canvas (o)</text>

<span class="cs-line hl-c">        S = <span class="fn">softmax</span>(logits/τ) @ W_E</span>
<span class="cs-line">        <span class="cmt"># sample new canvas (EB sampling)</span></span>
<span class="cs-line">        o = <span class="fn">entropy_bounded_sample</span>(logits)</span>

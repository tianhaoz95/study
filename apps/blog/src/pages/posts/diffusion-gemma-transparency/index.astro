<span class="cs-line cmt"># Algorithm: f_k logit modification</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">top_k_project</span>(logits, k):</span>
<span class="cs-line">    <span class="cmt"># find k-th largest logit</span></span>
<span class="cs-line">    threshold = <span class="fn">kth_value</span>(logits, k)</span>
<span class="cs-line">    <span class="cmt"># compute prob mass of top-k</span></span>
<span class="cs-line">    mask = logits &gt;= threshold</span>
<span class="cs-line">    top_probs = <span class="fn">softmax</span>(logits)[mask]</span>
<span class="cs-line">    total_top = top_probs.<span class="fn">sum</span>()</span>
<span class="cs-line">    <span class="cmt"># set non-top-k logits uniformly</span></span>
<span class="cs-line hl-c">    out = logits.<span class="fn">clone</span>()</span>
<span class="cs-line hl-c">    out[~mask] = <span class="fn">log</span>(</span>
<span class="cs-line hl-c">        (<span class="num">1</span> - total_top) / (V - k)</span>
<span class="cs-line hl-c">    )</span>
<span class="cs-line">    <span class="kw">return</span> out</span>
<span class="cs-line"> </span>

  const colors = ['rgba(139,92,246,0.7)', 'rgba(6,182,212,0.7)', 'rgba(16,185,129,0.7)', 'rgba(245,158,11,0.7)'];

  let currentK = '1';
  const chart = document.getElementById('ablation-chart');
  const verdict = document.getElementById('ablation-verdict');

  function render(k) {
    const s = scores[k];
    chart.innerHTML = '';
    benchmarks.forEach((bench, i) => {
      const row = document.createElement('div');
      row.style.cssText = 'display:flex;align-items:center;gap:.75rem';
      const label = document.createElement('div');
      label.style.cssText = 'font-size:.72rem;font-family:var(--ff-mono);color:var(--muted2);width:140px;flex-shrink:0;text-align:right';
      label.textContent = bench;
      const track = document.createElement('div');
      track.style.cssText = 'flex:1;background:var(--card2);border-radius:4px;height:22px;overflow:hidden';
      const fill = document.createElement('div');
      const pct = (s[i] * 100).toFixed(0);
      fill.style.cssText = `height:100%;border-radius:4px;transition:width 0.6s ease;display:flex;align-items:center;justify-content:flex-end;padding-right:.5rem;width:${pct}%;background:${colors[i]}`;
      fill.innerHTML = `<span style="font-size:.65rem;font-weight:700;font-family:var(--ff-mono);color:rgba(255,255,255,.85)">${(s[i]*100).toFixed(0)}%</span>`;
      track.appendChild(fill); row.appendChild(label); row.appendChild(track);
      chart.appendChild(row);
    });
    const verdicts = {
      '1': '⚠ Large performance drop — single top token loses too much information',
      '2': '⚠ Still significant degradation on LiveCodeBench and AMC/AIME',
      '4': '~ Approaching baseline but still some loss on complex reasoning tasks',
      '8': '✓ Matches baseline on all benchmarks — this is the safe compression point',
      '16': '✓ Matches baseline — extra tokens beyond k=8 add no value',
      '32': '✓ Matches baseline',
      '64': '✓ Matches baseline',
      'baseline': '— Full self-conditioning matrix, no compression',
    };
    verdict.textContent = verdicts[k] || '';
  }

  document.querySelectorAll('.abl-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.abl-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      render(btn.dataset.k);
    });
    btn.style.cssText = 'padding:.3rem .7rem;border-radius:5px;font-size:.7rem;font-family:var(--ff-mono);cursor:pointer;border:1px solid var(--border-hi);background:var(--surface);color:var(--muted2);transition:all .15s';
  });
  document.querySelector('.abl-btn[data-k="8"]').style.borderColor = 'var(--green)';
  document.querySelector('.abl-btn[data-k="8"]').style.color = 'var(--green)';

  render('1');

  // Start with k=1 active, but show k=8 pre-highlighted
  document.querySelectorAll('.abl-btn').forEach(b => {
    b.addEventListener('mouseenter', () => { b.style.background = 'rgba(255,255,255,.05)'; });
    b.addEventListener('mouseleave', () => { if (!b.classList.contains('active')) b.style.background = 'var(--surface)'; });
  });
})();

// ── §04: Category canvas ──
(function() {
  const canvas = document.getElementById('category-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 200;
  canvas.width = W * DPR; canvas.height = H * DPR; ctx.scale(DPR, DPR);

  // Approximate data from Figure 3 in paper
  // Steps 0..47, p>0.03 filter
  // Categories: final, adjacent, sim_final, sim_adj, other
  // Values are approximate percentages at each step group
  const steps = 48;
  // p>0.03 data (approximated from paper figure): interpretable stays >85% throughout
  const data_p03 = Array.from({length: steps}, (_, t) => {
    const progress = t / (steps - 1);
    const final_pct = 20 + 55 * progress;         // grows from 20→75
    const adjacent_pct = 25 - 10 * progress;       // shrinks from 25→15
    const similar_pct = 30 - 15 * progress;        // shrinks from 30→15
    const other_pct = Math.max(1, 25 - 20 * progress); // shrinks from 25→5
    const total = final_pct + adjacent_pct + similar_pct + other_pct;
    return [final_pct/total, adjacent_pct/total, similar_pct/total, other_pct/total];
  });
  // top-k=8 data: "other" spikes at late steps
  const data_topk = Array.from({length: steps}, (_, t) => {
    const progress = t / (steps - 1);
    const other_spike = t > 25 ? (t - 25) / 22 : 0;
    const final_pct = 20 + 55 * progress * (1 - other_spike * 0.3);
    const adjacent_pct = 20 - 8 * progress;
    const similar_pct = 25 - 15 * progress;
    const other_pct = 35 - 20 * progress + other_spike * 60;
    const total = final_pct + adjacent_pct + similar_pct + other_pct;
    return [final_pct/total, adjacent_pct/total, similar_pct/total, other_pct/total];
  });

  const COLORS = ['rgba(139,92,246,0.8)', 'rgba(6,182,212,0.8)', 'rgba(16,185,129,0.8)', 'rgba(239,68,68,0.75)'];

  function draw(data) {
    ctx.clearRect(0, 0, W, H);
    const padL = 35, padR = 10, padT = 10, padB = 28;
    const chartW = W - padL - padR;
    const chartH = H - padT - padB;
    const stepW = chartW / steps;

    // Draw stacked area
    for (let c = 3; c >= 0; c--) {
      ctx.beginPath();
      let cumPrev = Array(steps).fill(0);
      for (let ci = 0; ci < c; ci++) {
        for (let s = 0; s < steps; s++) cumPrev[s] += data[s][ci];
      }
      let cumCur = Array(steps).fill(0);
      for (let ci = 0; ci <= c; ci++) {
        for (let s = 0; s < steps; s++) cumCur[s] += data[s][ci];
      }
      // top edge left→right
      ctx.moveTo(padL, padT + chartH * (1 - cumCur[0]));
      for (let s = 1; s < steps; s++) {
        ctx.lineTo(padL + s * stepW, padT + chartH * (1 - cumCur[s]));
      }
      // bottom edge right→left
      for (let s = steps - 1; s >= 0; s--) {
        ctx.lineTo(padL + s * stepW, padT + chartH * (1 - cumPrev[s]));
      }
      ctx.closePath();
      ctx.fillStyle = COLORS[c];
      ctx.fill();
    }
    // X axis
    ctx.strokeStyle = 'rgba(255,255,255,.12)'; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(padL, padT + chartH); ctx.lineTo(W - padR, padT + chartH); ctx.stroke();
    // Y axis labels
    ctx.font = `10px monospace`; ctx.fillStyle = 'rgba(107,114,128,.8)'; ctx.textAlign = 'right';
    [0, 25, 50, 75, 100].forEach(pct => {
      const y = padT + chartH * (1 - pct/100);
      ctx.fillText(pct + '%', padL - 4, y + 3);
      ctx.strokeStyle = 'rgba(255,255,255,.04)'; ctx.setLineDash([2,2]);
      ctx.beginPath(); ctx.moveTo(padL, y); ctx.lineTo(W - padR, y); ctx.stroke();
      ctx.setLineDash([]);
    });
    // X axis labels
    ctx.fillStyle = 'rgba(107,114,128,.7)'; ctx.textAlign = 'center';
    [0, 10, 20, 30, 40, 47].forEach(s => {
      ctx.fillText('step ' + s, padL + s * stepW, H - 8);
    });
  }

  let currentFilter = 'p03';
  draw(data_p03);

  document.querySelectorAll('.filter-btn').forEach(btn => {
    btn.style.cssText = 'padding:.3rem .8rem;border-radius:5px;font-size:.72rem;font-family:var(--ff-mono);cursor:pointer;border:1px solid var(--border-hi);background:var(--surface);color:var(--muted2);transition:all .15s';
    btn.addEventListener('click', () => {
      document.querySelectorAll('.filter-btn').forEach(b => {
        b.classList.remove('active');
        b.style.borderColor = ''; b.style.color = '';
      });
      btn.classList.add('active');
      btn.style.borderColor = 'var(--purple)'; btn.style.color = 'var(--purple-l)';
      currentFilter = btn.dataset.filter;
      draw(currentFilter === 'p03' ? data_p03 : data_topk);
    });
    if (btn.dataset.filter === 'p03') {
      btn.classList.add('active');
      btn.style.borderColor = 'var(--purple)'; btn.style.color = 'var(--purple-l)';
    }
  });
})();

// ── §05: Retroactive self-correction step navigator ──
(function() {
  let step = 0;
  const boxes = document.querySelectorAll('#correction-steps .step-box');
  const prevBtn = document.getElementById('cstep-prev');
  const nextBtn = document.getElementById('cstep-next');
  const progEl  = document.getElementById('cstep-prog');
  function updateSteps() {
    boxes.forEach((b, i) => {
      b.classList.remove('active', 'done');
      if (i === step) b.classList.add('active');
      else if (i < step) b.classList.add('done');
    });
    if (prevBtn) prevBtn.disabled = step === 0;
    if (nextBtn) nextBtn.disabled = step === boxes.length - 1;
    if (progEl) progEl.textContent = `Step ${step+1} of ${boxes.length}`;
    boxes.forEach((b, i) => {
      const n = b.querySelector('.step-num');
      if (n) n.textContent = i < step ? '✓' : String(i+1);
    });
  }
  prevBtn?.addEventListener('click', () => { if (step > 0) { step--; updateSteps(); }});
  nextBtn?.addEventListener('click', () => { if (step < boxes.length - 1) { step++; updateSteps(); }});
  updateSteps();
})();

// ── §05: Token smearing canvas ──
(function() {
  const canvas = document.getElementById('smear-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 120;
  canvas.width = W * DPR; canvas.height = H * DPR; ctx.scale(DPR, DPR);

  // Show token smearing for " bracket" token across positions 20-35
  const numPos = 40;
  const posW = (W - 40) / numPos;

  function seededRand(n) { return ((1664525*n+1013904223)&0x7fffffff)/0x7fffffff; }

  // Step profiles: early, mid, late
  const profiles = [
    { label: 'Step 0 — smeared', peak: 27, spread: 7, height: 0.55 },
    { label: 'Step 8 — narrowing', peak: 27, spread: 3, height: 0.85 },
    { label: 'Step 15 — locked in', peak: 27, spread: 0.5, height: 1.0 },
  ];
  const phaseColors = ['rgba(6,182,212,0.8)', 'rgba(139,92,246,0.8)', 'rgba(16,185,129,0.8)'];

  ctx.clearRect(0, 0, W, H);
  const padL = 10, padT = 10;
  const barH = 25;
  const spacing = 28;

  profiles.forEach((prof, pi) => {
    const y0 = padT + pi * spacing;
    // Label
    ctx.font = `9px monospace`; ctx.fillStyle = phaseColors[pi]; ctx.textAlign = 'left';
    ctx.fillText(prof.label, padL, y0 + 9);
    // Bars
    for (let p = 0; p < numPos; p++) {
      const d = Math.abs(p - prof.peak);
      const prob = Math.exp(-0.5 * (d / prof.spread) ** 2) * prof.height;
      const x = padL + 90 + p * posW;
      const bh = Math.max(1, prob * barH);
      ctx.fillStyle = prob > 0.3
        ? phaseColors[pi]
        : `rgba(${pi===0?'6,182,212':pi===1?'139,92,246':'16,185,129'},${0.15 + prob * 0.3})`;
      ctx.fillRect(x, y0 + barH - bh, Math.max(2, posW - 1), bh);
    }
    // "bracket" label at peak
    ctx.font = `8px monospace`; ctx.fillStyle = phaseColors[pi]; ctx.textAlign = 'center';
    ctx.fillText('"bracket"', padL + 90 + prof.peak * posW, y0 + barH + 8);
  });
})();

// ── §06: Monitorability bars IntersectionObserver ──
(function() {
  const section = document.getElementById('s-monitor');
  if (!section) return;
  const obs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('#monitor-bars .bar-fill[data-w]').forEach(b => {
          b.style.width = b.dataset.w + '%';
        });
        obs.disconnect();
      }
    });
  }, { threshold: 0.3 });
  obs.observe(section);
})();
</script>


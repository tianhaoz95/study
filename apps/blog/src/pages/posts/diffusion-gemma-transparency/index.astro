      <div style="display:flex;align-items:center;gap:.4rem;font-size:.72rem;color:var(--muted)"><span style="width:10px;height:10px;border-radius:2px;background:rgba(6,182,212,.5);display:inline-block"></span> DiffusionGemma 26B A4B</div>

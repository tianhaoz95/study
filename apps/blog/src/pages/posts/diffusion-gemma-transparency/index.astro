      </div>
    </div>
    <div class="step-nav">
      <button id="cstep-prev" disabled>← Prev</button>
      <span id="cstep-prog" style="font-size:.72rem;font-family:var(--ff-mono);color:var(--muted)">Step 1 of 3</span>
      <button id="cstep-next">Next →</button>
    </div>

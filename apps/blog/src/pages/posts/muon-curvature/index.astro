// ---------------------------------------------------------------------
// VISUALIZATION 1: Curvature Valley Simulation
// ---------------------------------------------------------------------
(function() {
  const canvas = document.getElementById('canvas-sim');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  
  let method = 'muon'; // muon or gd
  let wH = 15; // vertical curvature
  let wL = 1;  // horizontal curvature
  let points = [];
  let isRunning = false;
  let timer = null;
  let simStep = 0;
  
  // Starting point of the ball
  const startX = 10;
  const startY = 8;
  let currentX = startX;
  let currentY = startY;
  
  function getDPR() {
    return window.devicePixelRatio || 1;
  }
  
  function initCanvas() {
    const dpr = getDPR();
    const w = canvas.clientWidth, h = 300;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    ctx.setTransform(1, 0, 0, 1, 0, 0);
    ctx.scale(dpr, dpr);
    draw();
  }
  
  // Contour mapping function: maps 2D coordinates to screen positions
  function toScreen(x, y, W, H) {
    // Center at (W/2, H/2)
    // Scale so x in [-12, 12] fits
    const scaleX = (W - 40) / 24;
    const scaleY = (H - 40) / 18;
    return {
      x: W / 2 + x * scaleX,
      y: H / 2 - y * scaleY
    };
  }
  
  function draw() {
    const W = canvas.width / getDPR(), H = canvas.height / getDPR();
    ctx.clearRect(0, 0, W, H);
    
    // Draw Contours for Q(x, y) = 0.5 * (w_L * x^2 + w_H * y^2)
    ctx.lineWidth = 1;
    for (let c = 1; c <= 8; c++) {
      const radiusL = Math.sqrt((c * 15) / wL);
      const radiusH = Math.sqrt((c * 15) / wH);
      
      ctx.strokeStyle = `rgba(139, 92, 246, ${0.05 + (9-c)*0.03})`;
      ctx.beginPath();
      
      // Draw ellipse
      for (let angle = 0; angle <= 360; angle += 2) {
        const rad = angle * Math.PI / 180;
        const ptX = radiusL * Math.cos(rad);
        const ptY = radiusH * Math.sin(rad);
        const scr = toScreen(ptX, ptY, W, H);
        if (angle === 0) ctx.moveTo(scr.x, scr.y);
        else ctx.lineTo(scr.x, scr.y);
      }
      ctx.closePath();
      ctx.stroke();
    }
    
    // Draw Axis
    ctx.strokeStyle = 'rgba(255,255,255,0.08)';
    ctx.beginPath();
    ctx.moveTo(10, H/2); ctx.lineTo(W-10, H/2);
    ctx.moveTo(W/2, 10); ctx.lineTo(W/2, H-10);
    ctx.stroke();
    
    // Draw target (Minimum)
    const minScr = toScreen(0, 0, W, H);
    ctx.fillStyle = '#10b981';
    ctx.beginPath();
    ctx.arc(minScr.x, minScr.y, 4, 0, Math.PI * 2);
    ctx.fill();
    
    // Draw trajectory
    if (points.length > 0) {
      ctx.beginPath();
      ctx.lineWidth = 1.5;
      ctx.strokeStyle = method === 'muon' ? '#06b6d4' : '#ef4444';
      
      const startScr = toScreen(startX, startY, W, H);
      ctx.moveTo(startScr.x, startScr.y);
      for (let p of points) {
        const scr = toScreen(p.x, p.y, W, H);
        ctx.lineTo(scr.x, scr.y);
      }
      ctx.stroke();
      
      // Draw historical dots
      ctx.fillStyle = method === 'muon' ? 'rgba(6,182,212,0.4)' : 'rgba(239,68,68,0.4)';
      for (let p of points) {
        const scr = toScreen(p.x, p.y, W, H);
        ctx.beginPath();
        ctx.arc(scr.x, scr.y, 3, 0, Math.PI * 2);
        ctx.fill();
      }
    }
    
    // Draw current ball
    const curScr = toScreen(currentX, currentY, W, H);
    ctx.fillStyle = method === 'muon' ? '#06b6d4' : '#ef4444';
    ctx.shadowBlur = 8;
    ctx.shadowColor = method === 'muon' ? '#06b6d4' : '#ef4444';
    ctx.beginPath();
    ctx.arc(curScr.x, curScr.y, 6, 0, Math.PI * 2);
    ctx.fill();
    ctx.shadowBlur = 0; // reset
  }
  
  function stepSimulation() {
    if (simStep > 35) {
      stop();
      return;
    }
    
    // Compute gradient: G_x = wL * x, G_y = wH * y
    // We want to minimize Q(x, y) = 0.5 * (wL * x^2 + wH * y^2)
    const Gx = wL * currentX;
    const Gy = wH * currentY;
    
    if (method === 'gd') {
      // GD step size is small to avoid exploding vertically
      const lr = 1.8 / wH;
      currentX -= lr * Gx;
      currentY -= lr * Gy;
    } else {
      // Muon step sets updates to ±1 (spectral normalization in coordinate space)
      const lr = 0.4;
      currentX -= lr * Math.sign(Gx);
      currentY -= lr * Math.sign(Gy);
    }
    
    points.push({ x: currentX, y: currentY });
    simStep++;
    draw();
  }
  
  function start() {
    if (isRunning) return;
    isRunning = true;
    document.getElementById('btn-run-muon').textContent = method === 'muon' ? 'Pause' : 'Run Muon';
    document.getElementById('btn-run-gd').textContent = method === 'gd' ? 'Pause' : 'Run GD';
    timer = setInterval(stepSimulation, 100);
  }
  
  function stop() {
    if (!isRunning) return;
    isRunning = false;
    clearInterval(timer);
    document.getElementById('btn-run-muon').textContent = 'Run Muon';
    document.getElementById('btn-run-gd').textContent = 'Run GD';
  }
  
  function reset() {
    stop();
    currentX = startX;
    currentY = startY;
    points = [];
    simStep = 0;
    draw();
  }
  
  document.getElementById('btn-run-muon')?.addEventListener('click', () => {
    if (method !== 'muon') {
      method = 'muon';
      reset();
    }
    document.getElementById('btn-run-muon').classList.add('active');
    document.getElementById('btn-run-gd').classList.remove('active');
    if (isRunning) stop(); else start();
  });
  
  document.getElementById('btn-run-gd')?.addEventListener('click', () => {
    if (method !== 'gd') {
      method = 'gd';
      reset();
    }
    document.getElementById('btn-run-gd').classList.add('active');
    document.getElementById('btn-run-muon').classList.remove('active');
    if (isRunning) stop(); else start();
  });
  
  document.getElementById('btn-sim-reset')?.addEventListener('click', reset);
  
  const sliderCurv = document.getElementById('slider-curvature');
  sliderCurv?.addEventListener('input', (e) => {
    wH = parseFloat(e.target.value);
    document.getElementById('lbl-curvature').textContent = wH;
    reset();
  });
  
  window.addEventListener('resize', initCanvas);
  initCanvas();
})();

// ---------------------------------------------------------------------
// VISUALIZATION 2: NDS vs Update Norm Chart
// ---------------------------------------------------------------------
(function() {
  const canvas = document.getElementById('canvas-metrics');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  
  let currentMetric = 'nds'; // nds or norm
  
  function getDPR() {
    return window.devicePixelRatio || 1;
  }
  
  function initCanvas() {
    const dpr = getDPR();
    const w = canvas.clientWidth, h = 250;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    ctx.setTransform(1, 0, 0, 1, 0, 0);
    ctx.scale(dpr, dpr);
    draw();
  }
  
  // Generate dummy pretraining metric curves that match the paper
  // x is matched validation loss from 4.4 down to 3.4
  function draw() {
    const W = canvas.width / getDPR(), H = canvas.height / getDPR();
    ctx.clearRect(0, 0, W, H);
    
    const PAD = { l: 50, r: 20, t: 25, b: 35 };
    const chartW = W - PAD.l - PAD.r;
    const chartH = H - PAD.t - PAD.b;
    
    // Draw Chart Box & Grid
    ctx.strokeStyle = 'rgba(255,255,255,0.04)';
    ctx.lineWidth = 1;
    
    // Vertical grid lines (losses 4.4, 4.2, 4.0, 3.8, 3.6, 3.4)
    const losses = [4.4, 4.2, 4.0, 3.8, 3.6, 3.4];
    losses.forEach((l, idx) => {
      const x = PAD.l + (idx / (losses.length - 1)) * chartW;
      ctx.beginPath();
      ctx.moveTo(x, PAD.t);
      ctx.lineTo(x, PAD.t + chartH);
      ctx.stroke();
      
      // X Label
      ctx.fillStyle = '#6b7280';
      ctx.font = '9px var(--ff-mono)';
      ctx.textAlign = 'center';
      ctx.fillText(l.toFixed(1), x, PAD.t + chartH + 16);
    });
    
    // X Axis Title
    ctx.fillStyle = '#9ca3af';
    ctx.textAlign = 'center';
    ctx.fillText('Validation Loss', PAD.l + chartW/2, H - 5);
    
    // Metric curves
    let adamPts = [];
    let muonPts = [];
    let yMin = 0, yMax = 1;
    let yLabels = [];
    
    if (currentMetric === 'nds') {
      // Sharpness ranges from 10^1 to 10^5
      // We'll plot on a logarithmic scale for NDS
      yMin = 1; yMax = 5; // exponent log10
      yLabels = ['10¹', '10²', '10³', '10⁴', '10⁵'];
      
      // Generate curves mimicking Figure 2(a)
      // Adam NDS stays high (starts at 10^4.5, falls to 10^3.6)
      // Muon NDS stays lower (starts at 10^4.1, falls to 10^3.1)
      for (let i = 0; i <= 20; i++) {
        const pct = i / 20;
        const loss = 4.4 - pct * 1.0;
        
        // Log values
        const adamLog = 4.5 - pct * 1.0 + Math.sin(pct*5)*0.1;
        const muonLog = 4.1 - pct * 1.1 + Math.sin(pct*4)*0.08;
        
        adamPts.push({ x: PAD.l + pct * chartW, yLog: adamLog });
        muonPts.push({ x: PAD.l + pct * chartW, yLog: muonLog });
      }
    } else {
      // Update Norm ranges from 0 to 6
      yMin = 0; yMax = 6;
      yLabels = ['0', '1.5', '3.0', '4.5', '6.0'];
      
      // Update norm remains flat around 4.5
      for (let i = 0; i <= 20; i++) {
        const pct = i / 20;
        const adamVal = 4.5 + Math.random()*0.1;
        const muonVal = 4.5 + Math.random()*0.05;
        
        adamPts.push({ x: PAD.l + pct * chartW, val: adamVal });
        muonPts.push({ x: PAD.l + pct * chartW, val: muonVal });
      }
    }
    
    // Draw Y grid and labels
    yLabels.forEach((label, idx) => {
      const yVal = PAD.t + chartH - (idx / (yLabels.length - 1)) * chartH;
      ctx.beginPath();
      ctx.moveTo(PAD.l, yVal);
      ctx.lineTo(PAD.l + chartW, yVal);
      ctx.stroke();
      
      ctx.fillStyle = '#6b7280';
      ctx.textAlign = 'right';
      ctx.fillText(label, PAD.l - 8, yVal + 3);
    });
    
    // Helper function to scale Y
    function scaleY(val) {
      const pct = (val - yMin) / (yMax - yMin);
      return PAD.t + chartH - pct * chartH;
    }
    
    // Draw lines
    ctx.lineWidth = 2;
    
    // Adam line
    ctx.strokeStyle = '#ef4444';
    ctx.beginPath();
    adamPts.forEach((pt, idx) => {
      const y = scaleY(currentMetric === 'nds' ? pt.yLog : pt.val);
      if (idx === 0) ctx.moveTo(pt.x, y);
      else ctx.lineTo(pt.x, y);
    });
    ctx.stroke();
    
    // Muon line
    ctx.strokeStyle = '#06b6d4';
    ctx.beginPath();
    muonPts.forEach((pt, idx) => {
      const y = scaleY(currentMetric === 'nds' ? pt.yLog : pt.val);
      if (idx === 0) ctx.moveTo(pt.x, y);
      else ctx.lineTo(pt.x, y);
    });
    ctx.stroke();
    
    // Legend
    ctx.font = '10px var(--ff-mono)';
    ctx.textAlign = 'left';
    ctx.fillStyle = '#ef4444';
    ctx.fillRect(PAD.l + 10, PAD.t + 10, 8, 8);
    ctx.fillText('Adam', PAD.l + 22, PAD.t + 17);
    
    ctx.fillStyle = '#06b6d4';
    ctx.fillRect(PAD.l + 70, PAD.t + 10, 8, 8);
    ctx.fillText('Muon', PAD.l + 82, PAD.t + 17);
  }
  
  document.getElementById('btn-metric-nds')?.addEventListener('click', () => {
    currentMetric = 'nds';
    document.getElementById('btn-metric-nds').classList.add('active');
    document.getElementById('btn-metric-norm').classList.remove('active');
    draw();
  });
  
  document.getElementById('btn-metric-norm')?.addEventListener('click', () => {
    currentMetric = 'norm';
    document.getElementById('btn-metric-norm').classList.add('active');
    document.getElementById('btn-metric-nds').classList.remove('active');
    draw();
  });
  
  window.addEventListener('resize', initCanvas);
  initCanvas();
})();

// ---------------------------------------------------------------------
// VISUALIZATION 3: Within-Layer vs Cross-Layer Curvature
// ---------------------------------------------------------------------
(function() {
  const canvas = document.getElementById('canvas-layers');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  
  let curStepVal = 7500;
  
  function getDPR() {
    return window.devicePixelRatio || 1;
  }
  
  function initCanvas() {
    const dpr = getDPR();
    const w = canvas.clientWidth, h = 220;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    ctx.setTransform(1, 0, 0, 1, 0, 0);
    ctx.scale(dpr, dpr);
    draw();
  }
  
  function draw() {
    const W = canvas.width / getDPR(), H = canvas.height / getDPR();
    ctx.clearRect(0, 0, W, H);
    
    // We represent a stacked bar chart of Within-Layer vs Cross-layer for both Muon and Adam
    // at the selected step
    const stepRatio = (curStepVal - 1000) / 14000; // 0 to 1
    
    // Calculate Within-layer vs Cross-layer shares based on stepRatio
    // Muon Within climbs from 14% to 44%
    const muonWithin = 14 + stepRatio * 30;
    const muonCross = 100 - muonWithin;
    
    // Adam Within goes from 27% to 34%
    const adamWithin = 27 + stepRatio * 7;
    const adamCross = 100 - adamWithin;
    
    const barWidth = 80;
    const barHeight = 120;
    
    // Render Adam Bar at W/2 - 90
    const adamX = W/2 - 100;
    const barY = H/2 - barHeight/2 - 10;
    
    // Draw Adam Bar (Stacked: within on bottom, cross on top)
    // Within-layer
    const adamWithinH = (adamWithin / 100) * barHeight;
    ctx.fillStyle = '#8b5cf6'; // Within-layer (Purple)
    ctx.fillRect(adamX, barY + barHeight - adamWithinH, barWidth, adamWithinH);
    
    // Cross-layer
    const adamCrossH = barHeight - adamWithinH;
    ctx.fillStyle = '#374151'; // Cross-layer (Muted gray)
    ctx.fillRect(adamX, barY, barWidth, adamCrossH);
    
    // Draw Labels for Adam
    ctx.fillStyle = '#e5e7eb';
    ctx.font = 'bold 10px var(--ff-mono)';
    ctx.textAlign = 'center';
    ctx.fillText('Adam', adamX + barWidth/2, barY + barHeight + 16);
    
    ctx.fillStyle = 'rgba(255,255,255,0.7)';
    ctx.font = '9px var(--ff-mono)';
    ctx.fillText(adamCross.toFixed(0) + '% cross', adamX + barWidth/2, barY + adamCrossH/2 + 4);
    ctx.fillText(adamWithin.toFixed(0) + '% within', adamX + barWidth/2, barY + barHeight - adamWithinH/2 + 4);
    
    // Render Muon Bar at W/2 + 10
    const muonX = W/2 + 20;
    
    // Draw Muon Bar
    const muonWithinH = (muonWithin / 100) * barHeight;
    ctx.fillStyle = '#06b6d4'; // Within-layer (Cyan)
    ctx.fillRect(muonX, barY + barHeight - muonWithinH, barWidth, muonWithinH);
    
    const muonCrossH = barHeight - muonWithinH;
    ctx.fillStyle = '#1e293b'; // Cross-layer (Darker gray)
    ctx.fillRect(muonX, barY, barWidth, muonCrossH);
    
    // Draw Labels for Muon
    ctx.fillStyle = '#e5e7eb';
    ctx.font = 'bold 10px var(--ff-mono)';
    ctx.fillText('Muon', muonX + barWidth/2, barY + barHeight + 16);
    
    ctx.fillStyle = 'rgba(255,255,255,0.7)';
    ctx.font = '9px var(--ff-mono)';
    ctx.fillText(muonCross.toFixed(0) + '% cross', muonX + barWidth/2, barY + muonCrossH/2 + 4);
    ctx.fillText(muonWithin.toFixed(0) + '% within', muonX + barWidth/2, barY + barHeight - muonWithinH/2 + 4);
    
    // Draw Legend
    ctx.font = '9px var(--ff-mono)';
    ctx.textAlign = 'left';
    ctx.fillStyle = '#06b6d4';
    ctx.fillRect(W - 105, barY + 10, 8, 8);
    ctx.fillStyle = '#6b7280';
    ctx.fillText('Within-Layer', W - 92, barY + 17);
    
    ctx.fillStyle = '#374151';
    ctx.fillRect(W - 105, barY + 26, 8, 8);
    ctx.fillStyle = '#6b7280';
    ctx.fillText('Cross-Layer', W - 92, barY + 33);
  }
  
  const sliderStep = document.getElementById('slider-step');
  sliderStep?.addEventListener('input', (e) => {
    curStepVal = parseInt(e.target.value);
    document.getElementById('lbl-step').textContent = curStepVal;
    draw();
  });
  
  window.addEventListener('resize', initCanvas);
  initCanvas();
})();

// ---------------------------------------------------------------------
// VISUALIZATION 4: Zipf Imbalance Chart & NDS Gap Bar
// ---------------------------------------------------------------------
(function() {
  const canvasDist = document.getElementById('canvas-zipf-dist');
  const canvasNds = document.getElementById('canvas-zipf-nds');
  if (!canvasDist || !canvasNds) return;
  
  const ctxDist = canvasDist.getContext('2d');
  const ctxNds = canvasNds.getContext('2d');
  
  let exponent = 0.5; // 0, 0.5, or 1.0
  
  function getDPR() {
    return window.devicePixelRatio || 1;
  }
  
  function initCanvases() {
    const dpr = getDPR();
    
    const wD = canvasDist.clientWidth, hD = 180;
    canvasDist.width = wD * dpr;
    canvasDist.height = hD * dpr;
    ctxDist.setTransform(1,0,0,1,0,0);
    ctxDist.scale(dpr, dpr);
    
    const wN = canvasNds.clientWidth, hN = 180;
    canvasNds.width = wN * dpr;
    canvasNds.height = hN * dpr;
    ctxNds.setTransform(1,0,0,1,0,0);
    ctxNds.scale(dpr, dpr);
    
    draw();
  }
  
  function draw() {
    drawDist();
    drawNds();
  }
  
  // Draw Token probability distribution on the left
  function drawDist() {
    const W = canvasDist.width / getDPR(), H = canvasDist.height / getDPR();
    ctxDist.clearRect(0, 0, W, H);
    
    const PAD = { l: 40, r: 10, t: 20, b: 30 };
    const chartW = W - PAD.l - PAD.r;
    const chartH = H - PAD.t - PAD.b;
    
    // Draw Axis
    ctxDist.strokeStyle = 'rgba(255,255,255,0.06)';
    ctxDist.beginPath();
    ctxDist.moveTo(PAD.l, PAD.t); ctxDist.lineTo(PAD.l, PAD.t + chartH);
    ctxDist.lineTo(PAD.l + chartW, PAD.t + chartH);
    ctxDist.stroke();
    
    // Generate Zipf values
    // P(r) ∝ r^(-s)
    const count = 30;
    let sum = 0;
    const vals = [];
    for (let r = 1; r <= count; r++) {
      const p = Math.pow(r, -exponent);
      vals.push(p);
      sum += p;
    }
    const normProbs = vals.map(v => v / sum);
    
    // Plot bar chart
    ctxDist.fillStyle = '#8b5cf6';
    const barW = chartW / count - 1;
    for (let i = 0; i < count; i++) {
      const p = normProbs[i];
      const bH = p * chartH * 4.5; // scale factor
      const x = PAD.l + i * (barW + 1);
      const y = PAD.t + chartH - bH;
      ctxDist.fillRect(x, Math.max(PAD.t, y), barW, Math.min(chartH, bH));
    }
    
    // Labels
    ctxDist.fillStyle = '#6b7280';
    ctxDist.font = '8px var(--ff-mono)';
    ctxDist.textAlign = 'center';
    ctxDist.fillText('Token Rank (Most -> Least)', PAD.l + chartW/2, H - 5);
    ctxDist.fillText('Probability', PAD.l + 10, PAD.t - 8);
    
    // Title inside
    ctxDist.fillStyle = '#e5e7eb';
    ctxDist.font = '9px var(--ff-mono)';
    ctxDist.textAlign = 'left';
    ctxDist.fillText(`Zipf Exponent s = ${exponent.toFixed(1)}`, PAD.l + 10, PAD.t + 15);
  }
  
  // Draw NDS Bar chart on the right
  function drawNds() {
    const W = canvasNds.width / getDPR(), H = canvasNds.height / getDPR();
    ctxNds.clearRect(0, 0, W, H);
    
    // Define values from paper:
    // s=0: Adam = 1.63, Muon = 1.00 (Gap = 0.63)
    // s=0.5: Adam = 1.95, Muon = 1.13 (Gap = 0.82)
    // s=1.0: Adam = 2.38, Muon = 1.25 (Gap = 1.13)
    let adamNds = 1.95;
    let muonNds = 1.13;
    if (exponent === 0) {
      adamNds = 1.63;
      muonNds = 1.00;
    } else if (exponent === 1.0) {
      adamNds = 2.38;
      muonNds = 1.25;
    }
    
    const maxVal = 2.5;
    const PAD = { l: 40, r: 10, t: 20, b: 30 };
    const chartW = W - PAD.l - PAD.r;
    const chartH = H - PAD.t - PAD.b;
    
    // Draw Y Axis grid
    const grids = [0, 0.5, 1.0, 1.5, 2.0, 2.5];
    grids.forEach(g => {
      const y = PAD.t + chartH - (g / maxVal) * chartH;
      ctxNds.strokeStyle = 'rgba(255,255,255,0.04)';
      ctxNds.beginPath();
      ctxNds.moveTo(PAD.l, y); ctxNds.lineTo(PAD.l + chartW, y);
      ctxNds.stroke();
      
      ctxNds.fillStyle = '#6b7280';
      ctxNds.font = '8px var(--ff-mono)';
      ctxNds.textAlign = 'right';
      ctxNds.fillText(g.toFixed(1), PAD.l - 6, y + 3);
    });
    
    // Draw Bars
    const barW = 35;
    const gap = 30;
    const baseX = PAD.l + (chartW - (barW * 2 + gap)) / 2;
    
    // Adam Bar
    const adamH = (adamNds / maxVal) * chartH;
    ctxNds.fillStyle = '#ef4444';
    ctxNds.fillRect(baseX, PAD.t + chartH - adamH, barW, adamH);
    ctxNds.fillStyle = '#e5e7eb';
    ctxNds.font = 'bold 9px var(--ff-mono)';
    ctxNds.textAlign = 'center';
    ctxNds.fillText(adamNds.toFixed(2), baseX + barW/2, PAD.t + chartH - adamH - 5);
    ctxNds.font = '8px var(--ff-mono)';
    ctxNds.fillText('Adam', baseX + barW/2, PAD.t + chartH + 12);
    
    // Muon Bar
    const muonH = (muonNds / maxVal) * chartH;
    ctxNds.fillStyle = '#06b6d4';
    ctxNds.fillRect(baseX + barW + gap, PAD.t + chartH - muonH, barW, muonH);
    ctxNds.fillStyle = '#e5e7eb';
    ctxNds.font = 'bold 9px var(--ff-mono)';
    ctxNds.fillText(muonNds.toFixed(2), baseX + barW + gap + barW/2, PAD.t + chartH - muonH - 5);
    ctxNds.font = '8px var(--ff-mono)';
    ctxNds.fillText('Muon', baseX + barW + gap + barW/2, PAD.t + chartH + 12);
    
    // NDS Label
    ctxNds.fillStyle = '#9ca3af';
    ctxNds.textAlign = 'center';
    ctxNds.fillText('Trajectory-Averaged NDS', PAD.l + chartW/2, H - 5);
  }
  
  document.getElementById('btn-zipf-0')?.addEventListener('click', () => {
    exponent = 0.0;
    document.getElementById('btn-zipf-0').classList.add('active');
    document.getElementById('btn-zipf-05').classList.remove('active');
    document.getElementById('btn-zipf-1').classList.remove('active');
    draw();
  });
  
  document.getElementById('btn-zipf-05')?.addEventListener('click', () => {
    exponent = 0.5;
    document.getElementById('btn-zipf-05').classList.add('active');
    document.getElementById('btn-zipf-0').classList.remove('active');
    document.getElementById('btn-zipf-1').classList.remove('active');
    draw();
  });
  
  document.getElementById('btn-zipf-1')?.addEventListener('click', () => {
    exponent = 1.0;
    document.getElementById('btn-zipf-1').classList.add('active');
    document.getElementById('btn-zipf-0').classList.remove('active');
    document.getElementById('btn-zipf-05').classList.remove('active');
    draw();
  });
  
  window.addEventListener('resize', initCanvases);
  initCanvases();
})();

// ---------------------------------------------------------------------
// VISUALIZATION 5: Energy Distribution Modes (Theory)
// ---------------------------------------------------------------------
(function() {
  const canvas = document.getElementById('canvas-theory');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  
  function getDPR() {
    return window.devicePixelRatio || 1;
  }
  
  function initCanvas() {
    const dpr = getDPR();
    const w = canvas.clientWidth, h = 200;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    ctx.setTransform(1, 0, 0, 1, 0, 0);
    ctx.scale(dpr, dpr);
    draw();
  }
  
  function draw() {
    const W = canvas.width / getDPR(), H = canvas.height / getDPR();
    ctx.clearRect(0, 0, W, H);
    
    const PAD = { l: 60, r: 15, t: 25, b: 35 };
    const chartW = W - PAD.l - PAD.r;
    const chartH = H - PAD.t - PAD.b;
    
    // Draw Axis
    ctx.strokeStyle = 'rgba(255,255,255,0.06)';
    ctx.beginPath();
    ctx.moveTo(PAD.l, PAD.t); ctx.lineTo(PAD.l, PAD.t + chartH);
    ctx.lineTo(PAD.l + chartW, PAD.t + chartH);
    ctx.stroke();
    
    // Modes: M1 (High curvature), M2, M3, M4, M5 (Low curvature)
    const modes = ['M1 (Sharp)', 'M2 (Flat)', 'M3 (Flat)', 'M4 (Flat)', 'M5 (Flat)'];
    
    // Update Energy distribution (proportional to updates)
    // GD/Adam: concentrates heavily on high curvature M1
    const gdEnergy = [75, 8.3, 8.3, 8.3, 8.3]; // total 100%
    // Muon: distributes energy evenly
    const muonEnergy = [20, 20, 20, 20, 20];
    
    const count = modes.length;
    const groupW = chartW / count;
    const barW = groupW * 0.35;
    
    for (let i = 0; i < count; i++) {
      const startX = PAD.l + i * groupW + (groupW - barW * 2 - 4) / 2;
      
      // Draw GD bar (Red)
      const gdH = (gdEnergy[i] / 80) * chartH;
      ctx.fillStyle = '#ef4444';
      ctx.fillRect(startX, PAD.t + chartH - gdH, barW, gdH);
      
      // Draw Muon bar (Cyan)
      const muonH = (muonEnergy[i] / 80) * chartH;
      ctx.fillStyle = '#06b6d4';
      ctx.fillRect(startX + barW + 4, PAD.t + chartH - muonH, barW, muonH);
      
      // Mode labels
      ctx.fillStyle = '#6b7280';
      ctx.font = '8px var(--ff-mono)';
      ctx.textAlign = 'center';
      ctx.fillText(modes[i], PAD.l + i * groupW + groupW/2, PAD.t + chartH + 14);
    }
    
    // Y Grid & axis title
    const grids = [0, 25, 50, 75];
    grids.forEach(g => {
      const y = PAD.t + chartH - (g / 80) * chartH;
      ctx.strokeStyle = 'rgba(255,255,255,0.03)';
      ctx.beginPath();
      ctx.moveTo(PAD.l, y); ctx.lineTo(PAD.l + chartW, y);
      ctx.stroke();
      
      ctx.fillStyle = '#6b7280';
      ctx.font = '8px var(--ff-mono)';
      ctx.textAlign = 'right';
      ctx.fillText(g + '%', PAD.l - 6, y + 3);
    });
    
    ctx.fillStyle = '#9ca3af';
    ctx.textAlign = 'center';
    ctx.font = '9px var(--ff-mono)';
    ctx.fillText('Update Energy Distribution across Curvature Modes', PAD.l + chartW/2, H - 5);
    
    // Legend
    ctx.textAlign = 'left';
    ctx.fillStyle = '#ef4444';
    ctx.fillRect(W - 140, 5, 8, 8);
    ctx.fillStyle = '#6b7280';
    ctx.font = '8px var(--ff-mono)';
    ctx.fillText('GD / Adam', W - 128, 12);
    
    ctx.fillStyle = '#06b6d4';
    ctx.fillRect(W - 70, 5, 8, 8);
    ctx.fillStyle = '#6b7280';
    ctx.fillText('Muon', W - 58, 12);
  }
  
  window.addEventListener('resize', initCanvas);
  initCanvas();
})();
</script>

<span class="cs-line cmt"># 01 — Curvature Dilemma: Muon vs GD Update Rules</span>
<span class="cs-line"><span class="kw">import</span> <span class="cls">torch</span></span>
<span class="cs-line"></span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">muon_step</span>(<span class="op">W</span>, <span class="op">G</span>, <span class="op">lr</span>):</span>
<span class="cs-line hl-p">    <span class="cmt"># 1. Singular Value Decomposition of Gradient Matrix G</span></span>
<span class="cs-line hl-p">    <span class="op">U</span>, <span class="op">S</span>, <span class="op">V</span> = <span class="cls">torch</span>.<span class="fn">linalg.svd</span>(<span class="op">G</span>, <span class="op">full_matrices</span>=<span class="kw">False</span>)</span>
<span class="cs-line hl-p">    </span>
<span class="cs-line hl-p">    <span class="cmt"># 2. Spectral Normalization: Set all singular values to 1</span></span>
<span class="cs-line hl-p">    <span class="op">O</span> = <span class="op">U</span> @ <span class="op">V</span></span>
<span class="cs-line hl-p">    </span>
<span class="cs-line hl-p">    <span class="cmt"># 3. Apply uniform matrix update</span></span>
<span class="cs-line hl-p">    <span class="kw">return</span> <span class="op">W</span> - <span class="op">lr</span> * <span class="op">O</span></span>
<span class="cs-line"></span>
<span class="cs-line hl-c"><span class="kw">def</span> <span class="fn">gd_step</span>(<span class="op">W</span>, <span class="op">G</span>, <span class="op">lr</span>):</span>
<span class="cs-line hl-c">    <span class="cmt"># GD update is strictly proportional to G</span></span>
<span class="cs-line hl-c">    <span class="kw">return</span> <span class="op">W</span> - <span class="op">lr</span> * <span class="op">G</span></span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-math">
      <pre class="cs-pre">
<span class="cs-line cmt"># 02 — Taylor One-Step Loss Decrease Decomposition</span>
<span class="cs-line cmt"># ΔL ≈ &lt;G, Z&gt; - 0.5 * &lt;Z, H[Z]&gt;</span>
<span class="cs-line"></span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">compute_taylor_terms</span>(<span class="op">loss_fn</span>, <span class="op">model</span>, <span class="op">Z</span>):</span>
<span class="cs-line">    <span class="cmt"># Z: list of parameter update tensors</span></span>
<span class="cs-line">    <span class="op">params</span> = <span class="fn">list</span>(<span class="op">model</span>.<span class="fn">parameters</span>())</span>
<span class="cs-line">    <span class="op">G</span> = [<span class="op">p</span>.<span class="op">grad</span> <span class="kw">for</span> <span class="op">p</span> <span class="kw">in</span> <span class="op">params</span>]</span>
<span class="cs-line">    </span>
<span class="cs-line hl-c">    <span class="cmt"># 1. First-order Gain: &lt;G, Z&gt;</span></span>
<span class="cs-line hl-c">    <span class="op">first_order</span> = <span class="fn">sum</span>((<span class="op">g</span> * <span class="op">z</span>).<span class="fn">sum</span>() <span class="kw">for</span> <span class="op">g</span>, <span class="op">z</span> <span class="kw">in</span> <span class="fn">zip</span>(<span class="op">G</span>, <span class="op">Z</span>))</span>
<span class="cs-line">    </span>
<span class="cs-line hl-g">    <span class="cmt"># 2. Second-order Curvature Penalty: 0.5 * &lt;Z, H[Z]&gt;</span></span>
<span class="cs-line hl-g">    <span class="cmt"># Computed efficiently using Pearlmutter's method</span></span>
<span class="cs-line hl-g">    <span class="op">H_Z</span> = <span class="fn">compute_hvp</span>(<span class="op">loss_fn</span>, <span class="op">params</span>, <span class="op">Z</span>)</span>
<span class="cs-line hl-g">    <span class="op">second_order</span> = <span class="num">0.5</span> * <span class="fn">sum</span>((<span class="op">z</span> * <span class="op">hz</span>).<span class="fn">sum</span>() <span class="kw">for</span> <span class="op">z</span>, <span class="op">hz</span> <span class="kw">in</span> <span class="fn">zip</span>(<span class="op">Z</span>, <span class="op">H_Z</span>))</span>
<span class="cs-line">    </span>
<span class="cs-line">    <span class="kw">return</span> <span class="op">first_order</span>, <span class="op">second_order</span></span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-sharpness">
      <pre class="cs-pre">
<span class="cs-line cmt"># 03 — Normalized Directional Sharpness (NDS)</span>
<span class="cs-line cmt"># S_F(W; Z) = &lt;Z, H[Z]&gt; / ||Z||_F^2</span>
<span class="cs-line"></span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">normalized_directional_sharpness</span>(<span class="op">Z</span>, <span class="op">H_Z</span>):</span>
<span class="cs-line hl-p">    <span class="cmt"># Quadratic form &lt;Z, H[Z]&gt;</span></span>
<span class="cs-line hl-p">    <span class="op">quad_form</span> = <span class="fn">sum</span>((<span class="op">z</span> * <span class="op">hz</span>).<span class="fn">sum</span>() <span class="kw">for</span> <span class="op">z</span>, <span class="op">hz</span> <span class="kw">in</span> <span class="fn">zip</span>(<span class="op">Z</span>, <span class="op">H_Z</span>))</span>
<span class="cs-line hl-p">    </span>
<span class="cs-line hl-p">    <span class="cmt"># Squared Frobenius Norm ||Z||_F^2</span></span>
<span class="cs-line hl-p">    <span class="op">norm_sq</span> = <span class="fn">sum</span>((<span class="op">z</span> * <span class="op">z</span>).<span class="fn">sum</span>() <span class="kw">for</span> <span class="op">z</span> <span class="kw">in</span> <span class="op">Z</span>)</span>
<span class="cs-line hl-p">    </span>
<span class="cs-line hl-p">    <span class="cmt"># NDS measures pure curvature along the update direction</span></span>
<span class="cs-line hl-p">    <span class="kw">return</span> <span class="op">quad_form</span> / <span class="op">norm_sq</span></span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-layers">
      <pre class="cs-pre">
<span class="cs-line cmt"># 04 — Layer-wise Curvature Decomposition</span>
<span class="cs-line cmt"># SF_within_i = &lt;Z_i, H_ii[Z_i]&gt; / ||Z||_F^2</span>
<span class="cs-line"></span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">layerwise_nds_decomposition</span>(<span class="op">Z</span>, <span class="op">H_Z</span>):</span>
<span class="cs-line hl-p">    <span class="op">total_norm_sq</span> = <span class="fn">sum</span>((<span class="op">z</span> * <span class="op">z</span>).<span class="fn">sum</span>() <span class="kw">for</span> <span class="op">z</span> <span class="kw">in</span> <span class="op">Z</span>)</span>
<span class="cs-line hl-p">    <span class="op">sf_within</span> = []</span>
<span class="cs-line hl-p">    </span>
<span class="cs-line hl-p">    <span class="kw">for</span> <span class="op">z_i</span>, <span class="op">hz_i</span> <span class="kw">in</span> <span class="fn">zip</span>(<span class="op">Z</span>, <span class="op">H_Z</span>):</span>
<span class="cs-line hl-p">        <span class="cmt"># Within-layer block-diagonal curvature</span></span>
<span class="cs-line hl-p">        <span class="op">val</span> = (<span class="op">z_i</span> * <span class="op">hz_i</span>).<span class="fn">sum</span>() / <span class="op">total_norm_sq</span></span>
<span class="cs-line hl-p">        <span class="op">sf_within</span>.<span class="fn">append</span>(<span class="op">val</span>)</span>
<span class="cs-line hl-p">        </span>
<span class="cs-line hl-p">    <span class="cmt"># Cross-layer terms are the off-diagonal remainder</span></span>
<span class="cs-line hl-p">    <span class="op">total_quad</span> = <span class="fn">sum</span>((<span class="op">z</span> * <span class="op">hz</span>).<span class="fn">sum</span>() <span class="kw">for</span> <span class="op">z</span>, <span class="op">hz</span> <span class="kw">in</span> <span class="fn">zip</span>(<span class="op">Z</span>, <span class="op">H_Z</span>))</span>
<span class="cs-line hl-p">    <span class="op">sf_cross</span> = (<span class="op">total_quad</span> / <span class="op">total_norm_sq</span>) - <span class="fn">sum</span>(<span class="op">sf_within</span>)</span>
<span class="cs-line hl-p">    </span>
<span class="cs-line hl-p">    <span class="kw">return</span> <span class="op">sf_within</span>, <span class="op">sf_cross</span></span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-imbalance">
      <pre class="cs-pre">
<span class="cs-line cmt"># 05 — Token Zipf Imbalance Generator</span>
<span class="cs-line cmt"># p(j | c, k) ∝ r(j, c, k)^(-s) * phi_k,c(j)</span>
<span class="cs-line"></span>
<span class="cs-line hl-c"><span class="kw">import</span> <span class="cls">numpy</span> <span class="kw">as</span> <span class="cls">np</span></span>
<span class="cs-line"></span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">sample_zipf_token</span>(<span class="op">phi_base</span>, <span class="op">ranks</span>, <span class="op">s</span>):</span>
<span class="cs-line hl-p">    <span class="cmt"># Reweight base probabilities by rank and Zipf exponent s</span></span>
<span class="cs-line hl-p">    <span class="op">reweighted</span> = (<span class="op">ranks</span> ** (<span class="op">-s</span>)) * <span class="op">phi_base</span></span>
<span class="cs-line hl-p">    <span class="op">probs</span> = <span class="op">reweighted</span> / <span class="op">reweighted</span>.<span class="fn">sum</span>()</span>
<span class="cs-line hl-p">    </span>
<span class="cs-line hl-p">    <span class="cmt"># Sample from imbalanced distribution</span></span>
<span class="cs-line hl-p">    <span class="kw">return</span> <span class="cls">np</span>.<span class="fn">random.choice</span>(<span class="fn">len</span>(<span class="op">probs</span>), <span class="op">p</span>=<span class="op">probs</span>)</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-theory">
      <pre class="cs-pre">
<span class="cs-line cmt"># 06 — Stylized Curvature Quadratic Model</span>
<span class="cs-line cmt"># Q(Y) = L0 - &lt;G, Y&gt; + 0.5 * &lt;Y, H[Y]&gt;</span>
<span class="cs-line"></span>
<span class="cs-line hl-c"><span class="kw">class</span> <span class="cls">HeterogeneousQuadratic</span>:</span>
<span class="cs-line hl-c">    <span class="kw">def</span> <span class="fn">__init__</span>(<span class="op">self</span>, <span class="op">q</span>=<span class="num">88</span>, <span class="op">m</span>=<span class="num">8</span>, <span class="op">w_H</span>=<span class="num">10.0</span>, <span class="op">w_L</span>=<span class="num">1.0</span>, <span class="op">sig_H</span>=<span class="num">5.0</span>, <span class="op">sig_L</span>=<span class="num">2.0</span>):</span>
<span class="cs-line hl-c">        <span class="op">self</span>.<span class="op">w</span> = <span class="cls">np</span>.<span class="fn">array</span>([<span class="op">w_H</span>]*<span class="op">m</span> + [<span class="op">w_L</span>]*(<span class="op">q</span>-<span class="op">m</span>))</span>
<span class="cs-line hl-c">        <span class="op">self</span>.<span class="op">sig</span> = <span class="cls">np</span>.<span class="fn">array</span>([<span class="op">sig_H</span>]*<span class="op">m</span> + [<span class="op">sig_L</span>]*(<span class="op">q</span>-<span class="op">m</span>))</span>
<span class="cs-line hl-c">        <span class="op">self</span>.<span class="op">y</span> = <span class="cls">np</span>.<span class="fn">zeros</span>(<span class="op">q</span>)</span>
<span class="cs-line hl-c">        </span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">step_gd</span>(<span class="op">self</span>, <span class="op">lr</span>):</span>
<span class="cs-line hl-p">        <span class="op">grad</span> = <span class="op">self</span>.<span class="op">w</span> * <span class="op">self</span>.<span class="op">y</span> - <span class="op">self</span>.<span class="op">sig</span></span>
<span class="cs-line hl-p">        <span class="op">self</span>.<span class="op">y</span> -= <span class="op">lr</span> * <span class="op">grad</span></span>
<span class="cs-line hl-p">        </span>
<span class="cs-line hl-g">    <span class="kw">def</span> <span class="fn">step_muon</span>(<span class="op">self</span>, <span class="op">lr</span>):</span>
<span class="cs-line hl-g">        <span class="op">grad</span> = <span class="op">self</span>.<span class="op">w</span> * <span class="op">self</span>.<span class="op">y</span> - <span class="op">self</span>.<span class="op">sig</span></span>
<span class="cs-line hl-g">        <span class="cmt"># Sign update in diagonalized singular basis</span></span>
<span class="cs-line hl-g">        <span class="op">direction</span> = <span class="cls">np</span>.<span class="fn">sign</span>(<span class="op">grad</span>)</span>
<span class="cs-line hl-g">        <span class="op">self</span>.<span class="op">y</span> -= <span class="op">lr</span> * <span class="op">direction</span></span>
      </pre>
    </div>
  </div>

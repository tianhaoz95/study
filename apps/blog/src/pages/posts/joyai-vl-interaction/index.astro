<span class="cs-line hl-g">  <span class="str">'translation'</span>:(<span class="num">100.0</span>, <span class="num">0.0</span>, <span class="num">0.0</span>),</span>
<span class="cs-line hl-g">  <span class="str">'commentary'</span>: (<span class="num">100.0</span>, <span class="num">0.0</span>, <span class="num">0.0</span>),</span>
<span class="cs-line">  <span class="str">'memory'</span>:     (<span class="num">77.8</span>,  <span class="num">22.2</span>, <span class="num">0.0</span>),</span>
<span class="cs-line">  <span class="str">'time_aware'</span>: (<span class="num">50.0</span>,  <span class="num">40.0</span>, <span class="num">10.0</span>),</span>

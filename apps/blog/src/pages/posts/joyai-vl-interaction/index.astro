  <div class="cs-body">

    <div class="cs-panel active" id="panel-problem">
      <pre class="cs-pre">
<span class="cs-line cmt"># Two paradigms for real-time AI</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># ── Turn-based (Doubao, Gemini) ──</span>
<span class="cs-line kw">class</span> <span class="cs-line cs-line"><span class="cls">TurnBasedModel</span>:</span>
<span class="cs-line hl-p">  <span class="kw">def</span> <span class="fn">step</span>(<span class="kw">self</span>, frame, user_query):</span>
<span class="cs-line hl-p">    <span class="kw">if</span> user_query <span class="kw">is</span> <span class="kw">None</span>:</span>
<span class="cs-line hl-p">      <span class="kw">return</span> <span class="kw">None</span>  <span class="cmt"># inert; cannot react</span></span>
<span class="cs-line">    <span class="kw">return</span> <span class="kw">self</span>.<span class="fn">generate</span>(frame, user_query)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Doubao workaround: external polling</span>
<span class="cs-line"><span class="kw">while</span> <span class="kw">True</span>:</span>
<span class="cs-line">  <span class="fn">sleep</span>(<span class="num">3</span>)  <span class="cmt"># poll every 3 seconds</span></span>
<span class="cs-line hl-a">  model.<span class="fn">step</span>(frame, ExternalTrigger)</span>
<span class="cs-line hl-a">  <span class="cmt"># reaction ≥ 3s late by construction</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># ── JoyAI-VL-Interaction ──</span>
<span class="cs-line kw">class</span> <span class="cls">InteractionModel</span>:</span>
<span class="cs-line hl-g">  <span class="kw">def</span> <span class="fn">step</span>(<span class="kw">self</span>, frame):</span>
<span class="cs-line hl-g">    <span class="cmt"># model decides every second, no prompt needed</span></span>
<span class="cs-line hl-g">    action = <span class="kw">self</span>.<span class="fn">decide</span>(frame, <span class="kw">self</span>.history)</span>
<span class="cs-line hl-g">    <span class="kw">return</span> action  <span class="cmt"># speak / silence / delegate</span></span>
<span class="cs-line"> </span>
<span class="cs-line"><span class="kw">while</span> <span class="kw">True</span>:</span>
<span class="cs-line">  frame = camera.<span class="fn">read</span>()</span>
<span class="cs-line hl-c">  action = model.<span class="fn">step</span>(frame)</span>
<span class="cs-line hl-c">  <span class="cmt"># reacts the instant the event occurs</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Fall detection case study:</span>
<span class="cs-line cmt"># JoyAI  → alerts at t=0 (event onset)</span>
<span class="cs-line cmt"># Doubao → alerts at t=4-5s (poll lag)</span>
<span class="cs-line cmt"># Gemini → admits it cannot monitor</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-actions">
      <pre class="cs-pre">
<span class="cs-line cmt"># Per-second action format</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Three special control tokens:</span>
<span class="cs-line hl-p">SILENCE  = <span class="str">"&lt;/silence&gt;"</span></span>
<span class="cs-line hl-g">RESPONSE = <span class="str">"&lt;/response&gt;"</span></span>
<span class="cs-line hl-a">DELEGATE = <span class="str">"&lt;/delegate&gt;"</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Example: dart throw counting, 10 seconds</span>
<span class="cs-line cmt">#   t=1: no throw yet       → </span><span class="cs-line"><span class="str">"&lt;/silence&gt;"</span></span>
<span class="cs-line cmt">#   t=2: no throw           → </span><span class="cs-line"><span class="str">"&lt;/silence&gt;"</span></span>
<span class="cs-line cmt">#   t=3: dart #1 hits board → </span><span class="cs-line"><span class="str">"&lt;/response&gt; 1"</span></span>
<span class="cs-line cmt">#   t=4: no throw           → </span><span class="cs-line"><span class="str">"&lt;/silence&gt;"</span></span>
<span class="cs-line cmt">#   t=5: dart #2 hits board → </span><span class="cs-line"><span class="str">"&lt;/response&gt; 2"</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Three timing types for training:</span>
<span class="cs-line kw">def</span> <span class="fn">backward_example</span>(video, q_time, event_time):</span>
<span class="cs-line">  <span class="cmt"># q_time &gt; event_time — question after event</span></span>
<span class="cs-line hl-c">  <span class="kw">for</span> t <span class="kw">in</span> <span class="fn">range</span>(event_time, q_time): yield SILENCE</span>
<span class="cs-line hl-c">  yield RESPONSE + answer(video, q_time)</span>
<span class="cs-line"> </span>
<span class="cs-line kw">def</span> <span class="fn">forward_example</span>(video, q_time, event_time):</span>
<span class="cs-line">  <span class="cmt"># q_time &lt; event_time — question before event</span></span>
<span class="cs-line hl-g">  <span class="kw">for</span> t <span class="kw">in</span> <span class="fn">range</span>(q_time, event_time): yield SILENCE</span>
<span class="cs-line hl-g">  yield RESPONSE + answer(video, event_time)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># 4M+ time-aligned clips across 6 families</span>
<span class="cs-line cmt"># Every second labeled: silence or respond</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-codec">
      <pre class="cs-pre">
<span class="cs-line cmt"># AdaCodec — predictive video tokenization</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Naive frame-by-frame encoding:</span>
<span class="cs-line cmt">#   Every frame → full ViT → ~256 tokens</span>
<span class="cs-line cmt">#   1 fps × 7200s = 7200 frames</span>
<span class="cs-line hl-p">naive_tokens = <span class="num">7200</span> * <span class="num">256</span>  <span class="cmt"># 1.84M tokens!</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># AdaCodec:</span>
<span class="cs-line cmt">#   Reference frame (scene change) → ~256 tokens</span>
<span class="cs-line cmt">#   P-frame (predictable) → ~16 tokens</span>
<span class="cs-line"> </span>
<span class="cs-line kw">def</span> <span class="fn">adacodec_encode</span>(frames):</span>
<span class="cs-line">  tokens = []</span>
<span class="cs-line">  prev = <span class="kw">None</span></span>
<span class="cs-line">  <span class="kw">for</span> frame <span class="kw">in</span> frames:</span>
<span class="cs-line">    cost = <span class="fn">prediction_cost</span>(frame, prev)</span>
<span class="cs-line hl-g">    <span class="kw">if</span> cost &gt; THRESHOLD <span class="kw">or</span> prev <span class="kw">is</span> <span class="kw">None</span>:</span>
<span class="cs-line hl-g">      tokens += <span class="fn">vit_encode</span>(frame)  <span class="cmt"># ~256 tokens</span></span>
<span class="cs-line hl-g">      prev = frame  <span class="cmt"># new reference frame</span></span>
<span class="cs-line hl-c">    <span class="kw">else</span>:</span>
<span class="cs-line hl-c">      tokens += <span class="fn">p_tokenize</span>(</span>
<span class="cs-line hl-c">        <span class="fn">residual</span>(frame, prev),</span>
<span class="cs-line hl-c">        <span class="fn">motion_vector</span>(frame, prev)</span>
<span class="cs-line hl-c">      )  <span class="cmt"># ~16 tokens</span></span>
<span class="cs-line">  <span class="kw">return</span> tokens</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># 2-hour stream, 1 scene change/min:</span>
<span class="cs-line cmt"># AdaCodec:  120*256 + 7080*16 = ~144k tokens</span>
<span class="cs-line hl-g">adacodec_tokens = <span class="num">120</span>*<span class="num">256</span> + <span class="num">7080</span>*<span class="num">16</span>  <span class="cmt"># 144k</span></span>
<span class="cs-line cmt"># 13× fewer tokens than naive encoding</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-training">
      <pre class="cs-pre">
<span class="cs-line cmt"># Role-weighted cross-entropy loss</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Silence dominates real streams — naive SFT</span>
<span class="cs-line cmt"># pushes model to always stay silent.</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Solution: weight by token role</span>
<span class="cs-line">W = &#123;</span>
<span class="cs-line hl-p">  <span class="str">'response'</span>:       <span class="num">1.5</span>,  <span class="cmt"># up-weight onset</span></span>
<span class="cs-line hl-g">  <span class="str">'silence_first'</span>:  <span class="num">1.0</span>,  <span class="cmt"># first silence: normal</span></span>
<span class="cs-line hl-c">  <span class="str">'silence_cont'</span>:   <span class="num">0.4</span>,  <span class="cmt"># continued: down-weight</span></span>
<span class="cs-line">  <span class="str">'other'</span>:          <span class="num">1.0</span>,</span>
<span class="cs-line">&#125;</span>
<span class="cs-line"> </span>
<span class="cs-line kw">def</span> <span class="fn">weighted_loss</span>(logits, targets, roles):</span>
<span class="cs-line">  losses = <span class="fn">cross_entropy</span>(logits, targets)</span>
<span class="cs-line">  weights = <span class="fn">tensor</span>([W[r] <span class="kw">for</span> r <span class="kw">in</span> roles])</span>
<span class="cs-line hl-p">  <span class="kw">return</span> (weights * losses).<span class="fn">sum</span>() / <span class="fn">len</span>(targets)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># RL fine-tuning: GRPO with stream rewards</span>
<span class="cs-line">stream_reward = &#123;</span>
<span class="cs-line hl-g">  <span class="str">'correct_in_window'</span>:    +<span class="num">1.0</span>,</span>
<span class="cs-line hl-g">  <span class="str">'appropriate_silence'</span>:  +<span class="num">0.5</span>,</span>
<span class="cs-line hl-g">  <span class="str">'good_delegation'</span>:      +<span class="num">0.8</span>,</span>
<span class="cs-line hl-a">  <span class="str">'false_alarm'</span>:          -<span class="num">1.0</span>,</span>
<span class="cs-line hl-a">  <span class="str">'mistimed_response'</span>:    -<span class="num">0.8</span>,</span>
<span class="cs-line hl-a">  <span class="str">'always_respond'</span>:       -<span class="num">2.0</span>,  <span class="cmt"># degenerate</span></span>
<span class="cs-line">&#125;</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Answer-centered window sampling keeps</span>
<span class="cs-line cmt"># rollouts tractable (100s streams → ~5 turns)</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-system">
      <pre class="cs-pre">
<span class="cs-line cmt"># Two-loop system choreography</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Real-time loop (runs every second)</span>
<span class="cs-line kw">async def</span> <span class="fn">realtime_loop</span>(session):</span>
<span class="cs-line">  <span class="kw">while</span> <span class="kw">True</span>:</span>
<span class="cs-line">    frame = <span class="kw">await</span> session.<span class="fn">next_frame</span>()</span>
<span class="cs-line hl-c">    action = <span class="kw">await</span> model.<span class="fn">step</span>(frame, session)</span>
<span class="cs-line"> </span>
<span class="cs-line hl-g">    <span class="kw">if</span> action == SPEAK:</span>
<span class="cs-line hl-g">      <span class="kw">await</span> tts.<span class="fn">stream</span>(action.text)</span>
<span class="cs-line hl-a">    <span class="kw">elif</span> action == DELEGATE:</span>
<span class="cs-line hl-a">      <span class="kw">await</span> tts.<span class="fn">speak</span>(<span class="str">"Let me look into that."</span>)</span>
<span class="cs-line hl-a">      asyncio.<span class="fn">create_task</span>(</span>
<span class="cs-line hl-a">        <span class="fn">async_loop</span>(action.query, session))</span>
<span class="cs-line">    <span class="cmt"># silence → continue watching</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Asynchronous loop (runs in background)</span>
<span class="cs-line kw">async def</span> <span class="fn">async_loop</span>(query, session):</span>
<span class="cs-line">  result = <span class="kw">await</span> background_brain.<span class="fn">run</span>(query)</span>
<span class="cs-line hl-p">  <span class="kw">await</span> session.<span class="fn">inject_result</span>(result)</span>
<span class="cs-line hl-p">  <span class="cmt"># model folds result into next response</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Memory: 3-tier hierarchy</span>
<span class="cs-line">memory = &#123;</span>
<span class="cs-line">  <span class="str">'short'</span>:  <span class="num">100</span>,  <span class="cmt"># raw tokens, last 100s</span></span>
<span class="cs-line">  <span class="str">'mid'</span>:    <span class="num">5</span>,    <span class="cmt"># M=5 text summaries</span></span>
<span class="cs-line">  <span class="str">'long'</span>:   <span class="num">15</span>,   <span class="cmt"># L=15 compressed blocks</span></span>
<span class="cs-line">&#125;  <span class="cmt"># covers ~2 hours of context</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># vLLM prefix reuse: text memory prefilled</span>
<span class="cs-line cmt"># once per chunk; only new frames recomputed</span>
      </pre>
    </div>


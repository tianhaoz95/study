<script>
// ─── TOC & sidebar toggles ───────────────────────────────────────
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});
const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ─── Code sidebar tab switching ───────────────────────────────────
const tabMeta = {
  problem:  { file: 'interaction/model.py',    title: 'The Missed Moment' },
  actions:  { file: 'interaction/actions.py',  title: 'Three Actions' },
  codec:    { file: 'interaction/adacodec.py', title: 'AdaCodec' },
  training: { file: 'interaction/training.py', title: 'Teaching Timing' },
  system:   { file: 'interaction/system.py',   title: 'Two-Loop System' },
  results:  { file: 'interaction/results.py',  title: 'Results' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ─── IntersectionObserver: sync TOC + sidebar tab ─────────────────
const sectionMap = {
  's-problem':  'problem',
  's-actions':  'actions',
  's-codec':    'codec',
  's-training': 'training',
  's-system':   'system',
  's-results':  'results',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ─── Timing canvas: turn-based vs interaction model ───────────────
(function() {
  const canvas = document.getElementById('timing-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  function resize() {
    const W = canvas.clientWidth, H = canvas.clientHeight;
    canvas.width = W * DPR; canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
    return { W, H };
  }
  let { W, H } = resize();

  let eventTime = null;       // seconds after trigger (null = no event)
  let elapsed = 0;
  let rafId = null;
  let startTs = null;

  const SYSTEMS = [
    { label: 'JoyAI-VL', color: '#8b5cf6', delay: 0 },
    { label: 'Doubao',    color: '#f59e0b', delay: 4.5 },
    { label: 'Gemini',    color: '#ef4444', delay: null }, // never
  ];
  const TOTAL_W = 14; // seconds shown

  function draw() {
    const W2 = canvas.clientWidth, H2 = canvas.clientHeight;
    ctx.clearRect(0, 0, W2, H2);

    // background
    ctx.fillStyle = '#0d0d14';
    ctx.fillRect(0, 0, W2, H2);

    const PAD_L = 90, PAD_R = 16, PAD_T = 20, row_h = (H2 - PAD_T - 16) / 3;

    // Time axis
    ctx.fillStyle = 'rgba(255,255,255,0.06)';
    ctx.fillRect(PAD_L, PAD_T, W2 - PAD_L - PAD_R, H2 - PAD_T - 16);

    // Grid lines every 2s
    for (let t = 0; t <= TOTAL_W; t += 2) {
      const x = PAD_L + (t / TOTAL_W) * (W2 - PAD_L - PAD_R);
      ctx.strokeStyle = 'rgba(255,255,255,0.04)';
      ctx.beginPath(); ctx.moveTo(x, PAD_T); ctx.lineTo(x, H2 - 16); ctx.stroke();
      ctx.fillStyle = 'rgba(255,255,255,0.2)';
      ctx.font = `${9 * DPR / DPR}px monospace`;
      ctx.textAlign = 'center';
      ctx.fillText(t + 's', x, H2 - 4);
    }

    SYSTEMS.forEach((sys, i) => {
      const y = PAD_T + i * row_h + row_h * 0.5;

      // label
      ctx.fillStyle = sys.color;
      ctx.font = `bold ${11 * DPR / DPR}px monospace`;
      ctx.textAlign = 'right';
      ctx.fillText(sys.label, PAD_L - 8, y + 4);

      // activity bar (baseline)
      ctx.fillStyle = 'rgba(255,255,255,0.04)';
      ctx.fillRect(PAD_L, y - 8, W2 - PAD_L - PAD_R, 16);

      // streaming activity pulse (animated)
      if (eventTime !== null) {
        // show "watching" pulses before event
        for (let t = 0; t < Math.min(elapsed, eventTime); t += 1) {
          const x = PAD_L + (t / TOTAL_W) * (W2 - PAD_L - PAD_R);
          ctx.fillStyle = sys.color + '22';
          ctx.fillRect(x, y - 6, (W2 - PAD_L - PAD_R) / TOTAL_W - 2, 12);
        }
      }

      // event marker
      if (eventTime !== null) {
        const ex = PAD_L + (eventTime / TOTAL_W) * (W2 - PAD_L - PAD_R);
        ctx.strokeStyle = '#ef4444';
        ctx.lineWidth = 1.5;
        ctx.setLineDash([4, 3]);
        ctx.beginPath(); ctx.moveTo(ex, PAD_T); ctx.lineTo(ex, H2 - 16); ctx.stroke();
        ctx.setLineDash([]);
        ctx.fillStyle = '#ef4444';
        ctx.font = `bold 9px monospace`;
        ctx.textAlign = 'center';
        ctx.fillText('🔥 EVENT', ex, PAD_T - 4);
      }

      // response markers
      if (eventTime !== null && sys.delay !== null) {
        const responseTime = eventTime + sys.delay;
        if (elapsed >= responseTime) {
          const rx = PAD_L + (responseTime / TOTAL_W) * (W2 - PAD_L - PAD_R);
          // response bar
          ctx.fillStyle = sys.color;
          ctx.fillRect(rx, y - 10, Math.min((elapsed - responseTime) / TOTAL_W * (W2 - PAD_L - PAD_R), 40), 20);
          ctx.fillStyle = '#fff';
          ctx.font = `bold 9px monospace`;
          ctx.textAlign = 'left';
          ctx.fillText(sys.delay === 0 ? '✓ instant' : `✗ +${sys.delay}s late`, rx + 4, y + 4);
        }
      } else if (eventTime !== null && sys.delay === null && elapsed > eventTime + 2) {
        ctx.fillStyle = '#ef444466';
        ctx.fillRect(PAD_L + (eventTime / TOTAL_W) * (W2 - PAD_L - PAD_R), y - 8, (W2 - PAD_L - PAD_R) * 0.4, 16);
        ctx.fillStyle = '#ef4444';
        ctx.font = `bold 9px monospace`;
        ctx.textAlign = 'left';
        ctx.fillText('✗ never reacts', PAD_L + (eventTime / TOTAL_W) * (W2 - PAD_L - PAD_R) + 4, y + 4);
      }
    });
  }

  function animate(ts) {
    if (!startTs) startTs = ts;
    elapsed = (ts - startTs) / 1000;
    draw();
    if (elapsed < TOTAL_W) rafId = requestAnimationFrame(animate);
  }

  document.getElementById('timing-trigger')?.addEventListener('click', () => {
    if (rafId) cancelAnimationFrame(rafId);
    eventTime = 2;
    startTs = null;
    elapsed = 0;
    rafId = requestAnimationFrame(animate);
  });
  document.getElementById('timing-reset')?.addEventListener('click', () => {
    if (rafId) cancelAnimationFrame(rafId);
    eventTime = null; elapsed = 0; startTs = null;
    draw();
  });

  draw();
})();

// ─── Timeline canvas: per-second decision strip ───────────────────
(function() {
  const canvas = document.getElementById('timeline-canvas');
  const infoEl = document.getElementById('timeline-info');
  if (!canvas || !infoEl) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 140;
  canvas.width = W * DPR; canvas.height = H * DPR;
  ctx.scale(DPR, DPR);

  // Dart throw counting scenario — 10 seconds
  const ACTIONS = [
    { label: 'silence', desc: 'No darts — watching' },
    { label: 'silence', desc: 'No darts — watching' },
    { label: 'speak',   desc: 'Dart #1 hits board → "1"' },
    { label: 'silence', desc: 'No darts — watching' },
    { label: 'speak',   desc: 'Dart #2 hits board → "2"' },
    { label: 'silence', desc: 'No darts — watching' },
    { label: 'speak',   desc: 'Dart #3 hits board → "3"' },
    { label: 'silence', desc: 'No darts — watching' },
    { label: 'delegate',desc: 'User asks complex visual analysis → delegating to background model' },
    { label: 'silence', desc: 'Background model working — still watching stream' },
  ];
  const COLORS = { silence: '#4b5563', speak: '#8b5cf6', delegate: '#f59e0b' };
  const ICONS  = { silence: '—', speak: '◆', delegate: '⟳' };
  let hovered = null;

  function draw() {
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = '#0d0d14';
    ctx.fillRect(0, 0, W, H);

    const PAD = 12, cell = (W - PAD * 2) / ACTIONS.length;
    ACTIONS.forEach((a, i) => {
      const x = PAD + i * cell, y = 24, cw = cell - 4;
      const isHov = hovered === i;
      ctx.fillStyle = isHov ? COLORS[a.label] + 'cc' : COLORS[a.label] + '66';
      ctx.beginPath();
      const r = 5;
      ctx.moveTo(x + r, y); ctx.lineTo(x + cw - r, y);
      ctx.arcTo(x + cw, y, x + cw, y + r, r);
      ctx.lineTo(x + cw, y + 60 - r);
      ctx.arcTo(x + cw, y + 60, x + cw - r, y + 60, r);
      ctx.lineTo(x + r, y + 60);
      ctx.arcTo(x, y + 60, x, y + 60 - r, r);
      ctx.lineTo(x, y + r);
      ctx.arcTo(x, y, x + r, y, r);
      ctx.closePath();
      ctx.fill();
      if (isHov) {
        ctx.strokeStyle = COLORS[a.label];
        ctx.lineWidth = 1.5;
        ctx.stroke();
      }

      // Icon
      ctx.fillStyle = isHov ? '#fff' : COLORS[a.label];
      ctx.font = `bold ${13 * DPR / DPR}px monospace`;
      ctx.textAlign = 'center';
      ctx.fillText(ICONS[a.label], x + cw / 2, y + 28);

      // Time label
      ctx.fillStyle = 'rgba(255,255,255,0.4)';
      ctx.font = `${9 * DPR / DPR}px monospace`;
      ctx.fillText('t=' + (i + 1) + 's', x + cw / 2, y + 48);

      // Bottom type label
      ctx.fillStyle = COLORS[a.label];
      ctx.font = `${8 * DPR / DPR}px monospace`;
      ctx.fillText(a.label, x + cw / 2, y + 76);
    });

    // Legend
    ctx.fillStyle = 'rgba(255,255,255,0.3)';
    ctx.font = `${9 * DPR / DPR}px monospace`;
    ctx.textAlign = 'left';
    ctx.fillText('Dart throw counting scenario — 10 seconds — click any second to inspect', PAD, 112);
  }

  canvas.addEventListener('mousemove', e => {
    const rect = canvas.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const PAD = 12, cell = (W - PAD * 2) / ACTIONS.length;
    const i = Math.floor((x - PAD) / cell);
    hovered = (i >= 0 && i < ACTIONS.length) ? i : null;
    draw();
    infoEl.textContent = hovered !== null
      ? `t=${hovered + 1}s — ${ACTIONS[hovered].label.toUpperCase()}: ${ACTIONS[hovered].desc}`
      : '';
  });
  canvas.addEventListener('mouseleave', () => { hovered = null; draw(); infoEl.textContent = ''; });
  canvas.addEventListener('click', e => {
    const rect = canvas.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const PAD = 12, cell = (W - PAD * 2) / ACTIONS.length;
    const i = Math.floor((x - PAD) / cell);
    if (i >= 0 && i < ACTIONS.length) {
      infoEl.textContent = `t=${i + 1}s — ${ACTIONS[i].label.toUpperCase()}: ${ACTIONS[i].desc}`;
    }
  });

  draw();
})();

// ─── AdaCodec canvas ─────────────────────────────────────────────
(function() {
  const canvas = document.getElementById('codec-canvas');
  const slider = document.getElementById('codec-slider');
  const labelEl = document.getElementById('codec-label');
  if (!canvas || !slider) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 220;
  canvas.width = W * DPR; canvas.height = H * DPR;
  ctx.scale(DPR, DPR);

  function draw(sceneChange) {
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = '#0d0d14';
    ctx.fillRect(0, 0, W, H);

    const N = 12, PAD = 12, cell = (W - PAD * 2) / N;
    const ROW1_Y = 28, ROW2_Y = 120;

    // Labels
    ctx.fillStyle = '#8b5cf6';
    ctx.font = `bold ${10 * DPR / DPR}px monospace`;
    ctx.textAlign = 'left';
    ctx.fillText('Naive: full ViT every frame', PAD, ROW1_Y - 10);
    ctx.fillStyle = '#06b6d4';
    ctx.fillText('AdaCodec: reference + P-frames', PAD, ROW2_Y - 10);

    let naiveTotal = 0, adaTotal = 0;

    for (let i = 0; i < N; i++) {
      const x = PAD + i * cell + 2, cw = cell - 4;
      const isRef = (i === 0) || (i === sceneChange - 1);

      // Row 1: Naive
      naiveTotal += 256;
      ctx.fillStyle = '#8b5cf6cc';
      ctx.fillRect(x, ROW1_Y, cw, 60);
      ctx.fillStyle = '#fff';
      ctx.font = `bold ${8 * DPR / DPR}px monospace`;
      ctx.textAlign = 'center';
      ctx.fillText('256', x + cw / 2, ROW1_Y + 20);
      ctx.font = `${7 * DPR / DPR}px monospace`;
      ctx.fillStyle = 'rgba(255,255,255,0.6)';
      ctx.fillText('ViT', x + cw / 2, ROW1_Y + 34);
      ctx.fillStyle = 'rgba(255,255,255,0.3)';
      ctx.font = `${7 * DPR / DPR}px monospace`;
      ctx.fillText('f' + (i + 1), x + cw / 2, ROW1_Y + 52);

      // Row 2: AdaCodec
      if (isRef) {
        adaTotal += 256;
        ctx.fillStyle = '#06b6d4cc';
        ctx.fillRect(x, ROW2_Y, cw, 60);
        ctx.fillStyle = '#fff';
        ctx.font = `bold ${8 * DPR / DPR}px monospace`;
        ctx.textAlign = 'center';
        ctx.fillText('256', x + cw / 2, ROW2_Y + 20);
        ctx.font = `${7 * DPR / DPR}px monospace`;
        ctx.fillStyle = 'rgba(255,255,255,0.6)';
        ctx.fillText('REF', x + cw / 2, ROW2_Y + 34);
        if (i === sceneChange - 1) {
          ctx.fillStyle = '#f59e0b';
          ctx.font = `bold ${7 * DPR / DPR}px monospace`;
          ctx.fillText('↺ scene', x + cw / 2, ROW2_Y + 52);
        }
      } else {
        adaTotal += 16;
        ctx.fillStyle = 'rgba(6,182,212,0.25)';
        ctx.fillRect(x, ROW2_Y + 40, cw, 20);
        ctx.fillStyle = '#06b6d4';
        ctx.font = `bold ${8 * DPR / DPR}px monospace`;
        ctx.textAlign = 'center';
        ctx.fillText('16', x + cw / 2, ROW2_Y + 54);
        ctx.font = `${7 * DPR / DPR}px monospace`;
        ctx.fillStyle = 'rgba(6,182,212,0.7)';
        ctx.fillText('P', x + cw / 2, ROW2_Y + 44);
      }
    }

    // Totals
    ctx.fillStyle = '#8b5cf6';
    ctx.font = `bold ${10 * DPR / DPR}px monospace`;
    ctx.textAlign = 'right';
    ctx.fillText('Total: ' + naiveTotal + ' tokens', W - PAD, ROW1_Y + 76);
    ctx.fillStyle = '#06b6d4';
    ctx.fillText('Total: ' + adaTotal + ' tokens  (' + Math.round(naiveTotal / adaTotal * 10) / 10 + '× savings)', W - PAD, ROW2_Y + 76);

    if (labelEl) labelEl.textContent = `Frame ${sceneChange} (${(naiveTotal / adaTotal).toFixed(1)}× savings)`;
  }

  slider.addEventListener('input', () => draw(parseInt(slider.value)));
  draw(parseInt(slider.value));
})();

// ─── Timing step navigator ────────────────────────────────────────
{
  let step = 0;
  const boxes   = document.querySelectorAll('#timing-steps .step-box');
  const prevBtn = document.getElementById('timing-prev');
  const nextBtn = document.getElementById('timing-next');
  const progEl  = document.getElementById('timing-prog');
  function updateSteps() {
    boxes.forEach((b, i) => {
      b.classList.remove('active', 'done');
      if (i === step) b.classList.add('active');
      else if (i < step) b.classList.add('done');
    });
    if (prevBtn) prevBtn.disabled = step === 0;
    if (nextBtn) nextBtn.disabled = step === boxes.length - 1;
    if (progEl)  progEl.textContent = `Step ${step + 1} of ${boxes.length}`;
    boxes.forEach((b, i) => {
      const n = b.querySelector('.step-num');
      if (n) n.textContent = i < step ? '✓' : String(i + 1);
    });
  }
  prevBtn?.addEventListener('click', () => { if (step > 0) { step--; updateSteps(); } });
  nextBtn?.addEventListener('click', () => { if (step < boxes.length - 1) { step++; updateSteps(); } });
  updateSteps();
}

// ─── SVG component tooltips ───────────────────────────────────────
{
  const tips = {
    'svg-ingest': 'Ingestion: WebRTC (camera) or RTSP (livestream) → aiortc/PyAV → sampled at 1 fps → Base64 JPEG frames assembled into Chat Completions request.',
    'svg-model':  'JoyAI-VL Interaction Model (8B): Qwen3-8B LM + Qwen3-VL ViT encoder. At every second, emits </silence>, </response>, or </delegate>. The only component that decides when to act.',
    'svg-tts':    'TTS + Visualization UI: streaming TTS renders speech; web UI shows live stream, conversation history, and per-response latency. Both components only transduce — no interaction decision made here.',
    'svg-memory': 'Long-horizon memory: 3-tier hierarchy — short (100s raw tokens), mid (5 text summaries), long (15 compressed blocks). Covers ~2 hours. Text tiers are prefilled into vLLM\'s KV cache for prefix reuse.',
    'svg-bridge': 'Background Bridge: receives delegate tokens + queries, normalizes to task-id/question/timeout. Runs the background brain asynchronously. Results returned as started/ready/error events.',
    'svg-brain':  'Background Brain: any external model, agent, or API. Handles hard subtasks that exceed real-time inference. Results folded back into the interaction model\'s context when ready.',
  };
  const tooltip = document.getElementById('svg-tooltip');
  Object.entries(tips).forEach(([id, text]) => {
    const el = document.getElementById(id);
    if (!el || !tooltip) return;
    el.addEventListener('click', () => { tooltip.textContent = text; });
    el.addEventListener('mouseenter', () => { tooltip.textContent = text; });
  });
}

// ─── Animated bar chart (IntersectionObserver) ────────────────────
const resultsSection = document.getElementById('s-results');
if (resultsSection) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          b.style.width = parseFloat(b.dataset.w) + '%';
        });
      }
    });
  }, { threshold: 0.2 }).observe(resultsSection);
}
</script>
</BaseLayout>

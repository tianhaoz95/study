});
const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

/* ─── Code sidebar tab switching ───────────────────────────────────── */
const tabMeta = {
  problem:   { file: 'dynamic_dllm/inference.py',   title: 'The O(L³) Wall' },
  layer:     { file: 'dynamic_dllm/dcu.py',         title: 'Dynamic Cache Updating' },
  threshold: { file: 'dynamic_dllm/apd.py',         title: 'Adaptive Parallel Decoding' },
  method:    { file: 'dynamic_dllm/forward.py',     title: 'DCU + APD Pipeline' },
  tradeoff:  { file: 'dynamic_dllm/ablation.py',    title: 'Budget Tradeoff' },
  results:   { file: 'dynamic_dllm/results.py',     title: 'Results & Numbers' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

/* ─── IntersectionObserver ─────────────────────────────────────────── */
const sectionMap = {
  's-problem':   'problem',
  's-layer':     'layer',
  's-threshold': 'threshold',
  's-method':    'method',
  's-tradeoff':  'tradeoff',
  's-results':   'results',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

/* ─── §01: Compute cost canvas ─────────────────────────────────────── */
(function() {
  const canvas = document.getElementById('canvas-compute');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 200;
  canvas.width = W * DPR; canvas.height = H * DPR;
  const ctx = canvas.getContext('2d');
  ctx.scale(DPR, DPR);

  ctx.fillStyle = '#0d0d14';
  ctx.fillRect(0, 0, W, H);

  const PAD = 20;
  const chartW = W - PAD * 2;
  const chartH = H - PAD * 2 - 20;
  const lengths = [128, 256, 512, 1024, 2048];
  const T = 64;

  // Normalize to 1.0 at L=128
  const base = 128 * 128; // AR cost at L=128
  const arCosts  = lengths.map(L => (L * L) / base);
  const dllmCosts = lengths.map(L => (L * L * T) / base);
  const maxCost = dllmCosts[dllmCosts.length - 1];

  // Draw grid lines
  ctx.strokeStyle = 'rgba(255,255,255,0.05)';
  ctx.lineWidth = 0.5;
  for (let i = 0; i <= 4; i++) {
    const y = PAD + chartH - (chartH * i / 4);
    ctx.beginPath(); ctx.moveTo(PAD, y); ctx.lineTo(PAD + chartW, y); ctx.stroke();
  }

  // X axis labels
  ctx.fillStyle = '#6b7280';
  ctx.font = '10px monospace';
  ctx.textAlign = 'center';
  lengths.forEach((L, i) => {
    const x = PAD + (chartW * i / (lengths.length - 1));
    ctx.fillText('L=' + L, x, PAD + chartH + 16);
  });

  // Y label
  ctx.save();
  ctx.translate(12, PAD + chartH / 2);
  ctx.rotate(-Math.PI / 2);
  ctx.fillStyle = '#6b7280';
  ctx.font = '9px monospace';
  ctx.textAlign = 'center';
  ctx.fillText('Relative Compute Cost', 0, 0);
  ctx.restore();

  function drawLine(costs, color) {
    ctx.beginPath();
    ctx.strokeStyle = color;
    ctx.lineWidth = 2;
    costs.forEach((c, i) => {
      const x = PAD + (chartW * i / (costs.length - 1));
      const y = PAD + chartH - (chartH * Math.min(c / maxCost, 1));
      if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
    });
    ctx.stroke();
    // Dot at end
    const lastX = PAD + chartW;
    const lastY = PAD + chartH - (chartH * Math.min(costs[costs.length-1] / maxCost, 1));
    ctx.beginPath(); ctx.arc(lastX, lastY, 4, 0, Math.PI * 2);
    ctx.fillStyle = color; ctx.fill();
  }

  drawLine(arCosts, '#06b6d4');
  drawLine(dllmCosts, '#8b5cf6');

  // Labels
  ctx.font = '10px monospace';
  ctx.fillStyle = '#06b6d4';
  ctx.textAlign = 'left';
  ctx.fillText('AR — O(L²)', PAD + chartW + 4, PAD + chartH - (chartH * arCosts[arCosts.length-1] / maxCost) + 4);
  ctx.fillStyle = '#8b5cf6';
  ctx.fillText('dLLM — O(L² × T)', PAD + chartW / 2, PAD + 14);
  ctx.fillStyle = '#f59e0b';
  ctx.textAlign = 'left';
  ctx.fillText('L=512: dLLM is ~64× more expensive', PAD + 4, PAD + chartH - 8);
})();

/* ─── §02: Layer budget canvas ─────────────────────────────────────── */
(function() {
  const canvas = document.getElementById('canvas-layer');
  if (!canvas) return;

  // Simulate layer dynamics: update rate increases with depth
  function seededRand(n) { return ((1664525*n+1013904223)&0x7fffffff)/0x7fffffff; }

  let layerMode = 'static';

  function draw(mode) {
    const DPR = window.devicePixelRatio || 1;
    const W = canvas.clientWidth, H = 240;
    canvas.width = W * DPR; canvas.height = H * DPR;
    const ctx = canvas.getContext('2d');
    ctx.scale(DPR, DPR);

    ctx.fillStyle = '#0d0d14';
    ctx.fillRect(0, 0, W, H);

    const NUM_LAYERS = 32;
    const NUM_STEPS = 16;
    const PAD_L = 55, PAD_T = 20, PAD_R = 20, PAD_B = 30;
    const cellW = (W - PAD_L - PAD_R) / NUM_STEPS;
    const cellH = (H - PAD_T - PAD_B) / NUM_LAYERS;

    // Update rates: each layer has a base dynamism score
    // Shallow (0-10): low (0.1-0.35), deep (20-31): high (0.5-0.85)
    function layerDynamism(l) {
      return 0.1 + (l / (NUM_LAYERS - 1)) * 0.75 + seededRand(l * 3) * 0.1;
    }

    for (let l = 0; l < NUM_LAYERS; l++) {
      for (let s = 0; s < NUM_STEPS; s++) {
        let intensity;
        if (mode === 'static') {
          intensity = 0.45 + seededRand(l * 20 + s) * 0.1; // uniform with noise
        } else {
          // DCU: proportional to layer dynamism, with step variation
          const base = layerDynamism(l);
          intensity = base + seededRand(l * 20 + s) * 0.05;
        }
        intensity = Math.max(0, Math.min(1, intensity));

        const x = PAD_L + s * cellW;
        const y = PAD_T + l * cellH;

        // Color: dark blue (low) → orange (high)
        const r = Math.round(intensity < 0.5
          ? 6 + (intensity / 0.5) * (245 - 6)
          : 245);
        const g = Math.round(intensity < 0.5
          ? 182 * (1 - intensity / 0.5) + 158 * (intensity / 0.5)
          : 158 * (1 - (intensity - 0.5) / 0.5) + 107 * (intensity - 0.5) / 0.5);
        const b = Math.round(intensity < 0.5
          ? 212 - (intensity / 0.5) * 212
          : 17);
        const alpha = 0.15 + intensity * 0.7;
        ctx.fillStyle = `rgba(${r},${g},${b},${alpha})`;
        ctx.fillRect(x + 0.5, y + 0.5, cellW - 1, cellH - 1);
      }
    }

    // Layer axis labels
    ctx.fillStyle = '#6b7280';
    ctx.font = '9px monospace';
    ctx.textAlign = 'right';
    [0, 8, 16, 24, 31].forEach(l => {
      const y = PAD_T + l * cellH + cellH / 2;
      ctx.fillText('L' + (l + 1), PAD_L - 4, y + 3);
    });

    // Step axis labels
    ctx.textAlign = 'center';
    [0, 4, 8, 12, 15].forEach(s => {
      const x = PAD_L + s * cellW + cellW / 2;
      ctx.fillText('t=' + (15 - s), x, H - PAD_B + 14);
    });

    // Y axis label
    ctx.save();
    ctx.translate(12, H / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.textAlign = 'center';
    ctx.fillText('Layer (shallow → deep)', 0, 0);
    ctx.restore();

    // Color legend
    const gradX = PAD_L;
    const gradY = H - PAD_B + 4;
    const gradW = (W - PAD_L - PAD_R) / 2;
    const grad = ctx.createLinearGradient(gradX, 0, gradX + gradW, 0);
    grad.addColorStop(0, 'rgba(6,182,212,.7)');
    grad.addColorStop(0.5, 'rgba(245,158,11,.7)');
    grad.addColorStop(1, 'rgba(239,68,68,.7)');
    ctx.fillStyle = grad;
    ctx.fillRect(gradX, gradY, gradW, 6);
    ctx.fillStyle = '#6b7280';
    ctx.font = '8px monospace';
    ctx.textAlign = 'left';
    ctx.fillText('low update', gradX, gradY - 2);
    ctx.textAlign = 'right';
    ctx.fillText('high update', gradX + gradW, gradY - 2);
  }

  draw('static');

  document.getElementById('btn-layer-static')?.addEventListener('click', () => {
    layerMode = 'static';
    document.getElementById('btn-layer-static').classList.add('active');
    document.getElementById('btn-layer-dcu').classList.remove('active');
    document.getElementById('layer-annotation').textContent = 'Same budget for every layer — wastes compute on stable layers';
    draw('static');
  });
  document.getElementById('btn-layer-dcu')?.addEventListener('click', () => {
    layerMode = 'dcu';
    document.getElementById('btn-layer-static').classList.remove('active');
    document.getElementById('btn-layer-dcu').classList.add('active');
    document.getElementById('layer-annotation').textContent = 'DCU: budget proportional to layer dynamism — shallow layers spend less, deep layers get more';
    draw('dcu');
  });

  window.addEventListener('resize', () => draw(layerMode));
})();

/* ─── §03: Confidence trajectory canvas ────────────────────────────── */
(function() {
  const canvas = document.getElementById('canvas-thresh');
  if (!canvas) return;

  // Confidence trajectory over 16 steps (step 16 down to 0)
  // Simulates a token that rises, dips, then stabilizes
  const CONF = [
    // step 16→0 (index 0 = step 16, index 15 = step 1)
    0.55, 0.68, 0.82, 0.74,  // steps 16→13: rises, looks confident
    0.61, 0.38, 0.28, 0.35,  // steps 12→9:  dips — context changes!
    0.52, 0.70, 0.81, 0.88,  // steps 8→5:   rises again
    0.91, 0.93, 0.95, 0.97   // steps 4→1:   stabilizes high
  ];

  // Adaptive threshold trajectory: starts 0.88, drops when stable
  const ADAPTIVE_THRESH = [
    0.88, 0.87, 0.86, 0.88,  // volatile early: stays high
    0.89, 0.91, 0.92, 0.90,  // dip: H is high, threshold rises
    0.88, 0.85, 0.82, 0.79,  // stabilizing: c increases, drops
    0.75, 0.72, 0.70, 0.68   // stable: commits here (step 4)
  ];
  const FIXED_THRESH = 0.70; // flat red line

  // Fixed commits at index 2 (step 14: conf=0.82 >= 0.70) → wrong
  // Adaptive commits at index 12 (step 4: conf=0.91 >= 0.75) → correct
  const FIXED_COMMIT_IDX = 2;
  const ADAPTIVE_COMMIT_IDX = 12;

  let threshMode = 'fixed';

  function draw(mode) {
    const DPR = window.devicePixelRatio || 1;
    const W = canvas.clientWidth, H = 260;
    canvas.width = W * DPR; canvas.height = H * DPR;
    const ctx = canvas.getContext('2d');
    ctx.scale(DPR, DPR);

    ctx.fillStyle = '#0d0d14';
    ctx.fillRect(0, 0, W, H);

    const PAD_L = 48, PAD_T = 20, PAD_R = 30, PAD_B = 40;
    const chartW = W - PAD_L - PAD_R;
    const chartH = H - PAD_T - PAD_B;
    const N = CONF.length;

    function toX(i) { return PAD_L + (chartW * i / (N - 1)); }
    function toY(v) { return PAD_T + chartH * (1 - v); }

    // Grid
    ctx.strokeStyle = 'rgba(255,255,255,0.05)';
    ctx.lineWidth = 0.5;
    [0, 0.25, 0.5, 0.75, 1.0].forEach(v => {
      ctx.beginPath();
      ctx.moveTo(PAD_L, toY(v)); ctx.lineTo(PAD_L + chartW, toY(v));
      ctx.stroke();
      ctx.fillStyle = '#6b7280';
      ctx.font = '9px monospace';
      ctx.textAlign = 'right';
      ctx.fillText((v * 100).toFixed(0) + '%', PAD_L - 4, toY(v) + 3);
    });

    // X axis labels (step numbers, right to left)
    ctx.fillStyle = '#6b7280';
    ctx.font = '9px monospace';
    ctx.textAlign = 'center';
    [0, 3, 6, 9, 12, 15].forEach(i => {
      ctx.fillText('t=' + (N - i), toX(i), H - PAD_B + 14);
    });

    // Y label
    ctx.save();
    ctx.translate(12, PAD_T + chartH / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.fillStyle = '#6b7280';
    ctx.font = '9px monospace';
    ctx.textAlign = 'center';
    ctx.fillText('Token Confidence', 0, 0);
    ctx.restore();

    // X label
    ctx.fillStyle = '#6b7280';
    ctx.font = '9px monospace';
    ctx.textAlign = 'center';
    ctx.fillText('← decoding steps (left = early, right = late)', PAD_L + chartW / 2, H - 6);

    // Draw threshold line
    if (mode === 'fixed') {
      // Fixed threshold: flat red line at 0.70
      ctx.beginPath();
      ctx.strokeStyle = 'rgba(239,68,68,.8)';
      ctx.lineWidth = 1.5;
      ctx.setLineDash([6, 3]);
      ctx.moveTo(toX(0), toY(FIXED_THRESH));
      ctx.lineTo(toX(N - 1), toY(FIXED_THRESH));
      ctx.stroke();
      ctx.setLineDash([]);

      ctx.fillStyle = '#f87171';
      ctx.font = '9px monospace';
      ctx.textAlign = 'left';
      ctx.fillText('Fixed τ = 0.70', toX(0) + 4, toY(FIXED_THRESH) - 4);
    } else {
      // Adaptive threshold: draw as a line
      ctx.beginPath();
      ctx.strokeStyle = 'rgba(16,185,129,.8)';
      ctx.lineWidth = 1.5;
      ctx.setLineDash([4, 2]);
      ADAPTIVE_THRESH.forEach((v, i) => {
        const x = toX(i), y = toY(v);
        if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
      });
      ctx.stroke();
      ctx.setLineDash([]);

      ctx.fillStyle = '#6ee7b7';
      ctx.font = '9px monospace';
      ctx.textAlign = 'left';
      ctx.fillText('Adaptive τ (APD)', toX(0) + 4, toY(ADAPTIVE_THRESH[0]) - 4);
    }

    // Draw confidence curve (purple)
    ctx.beginPath();
    ctx.strokeStyle = '#8b5cf6';
    ctx.lineWidth = 2.5;
    CONF.forEach((v, i) => {
      if (i === 0) ctx.moveTo(toX(i), toY(v)); else ctx.lineTo(toX(i), toY(v));
    });
    ctx.stroke();

    // Draw confidence dots
    CONF.forEach((v, i) => {
      ctx.beginPath();
      ctx.arc(toX(i), toY(v), 3.5, 0, Math.PI * 2);
      ctx.fillStyle = '#a78bfa';
      ctx.fill();
    });

    // Commit marker
    const commitIdx = mode === 'fixed' ? FIXED_COMMIT_IDX : ADAPTIVE_COMMIT_IDX;
    const commitConf = CONF[commitIdx];
    const cx = toX(commitIdx), cy = toY(commitConf);

    // Vertical line at commit
    ctx.beginPath();
    ctx.strokeStyle = mode === 'fixed' ? 'rgba(239,68,68,.6)' : 'rgba(16,185,129,.6)';
    ctx.lineWidth = 1.5;
    ctx.setLineDash([3, 2]);
    ctx.moveTo(cx, PAD_T); ctx.lineTo(cx, PAD_T + chartH);
    ctx.stroke();
    ctx.setLineDash([]);

    // Circle at commit point
    ctx.beginPath();
    ctx.arc(cx, cy, 8, 0, Math.PI * 2);
    ctx.strokeStyle = mode === 'fixed' ? '#ef4444' : '#10b981';
    ctx.lineWidth = 2.5;
    ctx.stroke();

    // Label
    const label = mode === 'fixed'
      ? '⚠ Committed here (step 14, conf=82%)\nbut later drops to 34%!'
      : '✓ Committed here (step 4, conf=91%)\nstable — correct prediction';
    const lines = label.split('\n');
    const labelX = cx + (commitIdx > N/2 ? -8 : 8);
    const labelAlign = commitIdx > N/2 ? 'right' : 'left';
    ctx.fillStyle = mode === 'fixed' ? '#f87171' : '#6ee7b7';
    ctx.font = '9px monospace';
    ctx.textAlign = labelAlign;
    lines.forEach((line, li) => {
      ctx.fillText(line, labelX, cy - 18 + li * 13);
    });
  }

  draw('fixed');

  document.getElementById('btn-thresh-fixed')?.addEventListener('click', () => {
    threshMode = 'fixed';
    document.getElementById('btn-thresh-fixed').classList.add('active');
    document.getElementById('btn-thresh-adaptive').classList.remove('active');
    document.getElementById('thresh-annotation').textContent = 'Commits at step 14 → WRONG (confidence drops to 34% after)';
    draw('fixed');
  });
  document.getElementById('btn-thresh-adaptive')?.addEventListener('click', () => {
    threshMode = 'adaptive';
    document.getElementById('btn-thresh-fixed').classList.remove('active');
    document.getElementById('btn-thresh-adaptive').classList.add('active');
    document.getElementById('thresh-annotation').textContent = 'APD tracks stability — commits at step 4 when prediction is stable → CORRECT';
    draw('adaptive');
  });

  window.addEventListener('resize', () => draw(threshMode));
})();

/* ─── §05: Budget tradeoff canvas ──────────────────────────────────── */
(function() {
  const canvas = document.getElementById('canvas-budget');
  if (!canvas) return;

  // Accuracy and throughput vs B_layer (from ablation data)
  // B_layer: 4, 8, 16, 24, 32, 40, 48, 64
  const bValues  = [4,   8,    16,   24,   32,   40,   48,   64];
  const accuracy = [70.1, 74.2, 76.8, 77.9, 78.2, 78.3, 78.2, 78.2]; // GSM8K accuracy
  const throughput = [38.1, 32.1, 29.8, 28.4, 27.2, 25.1, 22.1, 16.3]; // TPS

  let highlightIdx = 4; // B=32

  function draw() {
    const DPR = window.devicePixelRatio || 1;
    const W = canvas.clientWidth, H = 240;
    canvas.width = W * DPR; canvas.height = H * DPR;
    const ctx = canvas.getContext('2d');
    ctx.scale(DPR, DPR);

    ctx.fillStyle = '#0d0d14';
    ctx.fillRect(0, 0, W, H);

    const PAD_L = 55, PAD_T = 20, PAD_R = 80, PAD_B = 40;
    const chartW = W - PAD_L - PAD_R;
    const chartH = H - PAD_T - PAD_B;
    const N = bValues.length;

    const accMin = 68, accMax = 80;
    const tpsMax = 42;

    function toX(i) { return PAD_L + (chartW * i / (N - 1)); }
    function toAccY(v) { return PAD_T + chartH * (1 - (v - accMin) / (accMax - accMin)); }
    function toTpsY(v) { return PAD_T + chartH * (1 - v / tpsMax); }

    // Grid
    ctx.strokeStyle = 'rgba(255,255,255,0.05)';
    ctx.lineWidth = 0.5;
    [0, 0.25, 0.5, 0.75, 1.0].forEach(f => {
      const y = PAD_T + chartH * (1 - f);
      ctx.beginPath(); ctx.moveTo(PAD_L, y); ctx.lineTo(PAD_L + chartW, y); ctx.stroke();
    });

    // X axis labels
    ctx.fillStyle = '#6b7280';
    ctx.font = '9px monospace';
    ctx.textAlign = 'center';
    bValues.forEach((b, i) => {
      ctx.fillText('B=' + b, toX(i), H - PAD_B + 14);
    });
    ctx.fillText('Cache budget B_layer', PAD_L + chartW / 2, H - 4);

    // Left Y axis (accuracy)
    ctx.fillStyle = '#06b6d4';
    ctx.font = '9px monospace';
    ctx.textAlign = 'right';
    [68, 72, 76, 80].forEach(v => {
      ctx.fillText(v + '%', PAD_L - 4, toAccY(v) + 3);
    });
    ctx.save();
    ctx.translate(14, PAD_T + chartH / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.textAlign = 'center';
    ctx.fillText('Accuracy (GSM8K)', 0, 0);
    ctx.restore();

    // Right Y axis (throughput)
    ctx.fillStyle = '#8b5cf6';
    ctx.font = '9px monospace';
    ctx.textAlign = 'left';
    [10, 20, 30, 40].forEach(v => {
      ctx.fillText(v + ' TPS', PAD_L + chartW + 4, toTpsY(v) + 3);
    });

    // Highlight band for sweet spot
    if (highlightIdx >= 0) {
      const hx = toX(highlightIdx);
      ctx.fillStyle = 'rgba(139,92,246,.08)';
      ctx.fillRect(hx - 15, PAD_T, 30, chartH);
      ctx.strokeStyle = 'rgba(139,92,246,.4)';
      ctx.lineWidth = 1;
      ctx.setLineDash([3, 2]);
      ctx.beginPath(); ctx.moveTo(hx, PAD_T); ctx.lineTo(hx, PAD_T + chartH); ctx.stroke();
      ctx.setLineDash([]);
    }

    // Accuracy line (cyan)
    ctx.beginPath();
    ctx.strokeStyle = '#06b6d4';
    ctx.lineWidth = 2;
    accuracy.forEach((v, i) => {
      if (i === 0) ctx.moveTo(toX(i), toAccY(v)); else ctx.lineTo(toX(i), toAccY(v));
    });
    ctx.stroke();

    // Throughput line (purple)
    ctx.beginPath();
    ctx.strokeStyle = '#8b5cf6';
    ctx.lineWidth = 2;
    throughput.forEach((v, i) => {
      if (i === 0) ctx.moveTo(toX(i), toTpsY(v)); else ctx.lineTo(toX(i), toTpsY(v));
    });
    ctx.stroke();

    // Dots
    accuracy.forEach((v, i) => {
      ctx.beginPath(); ctx.arc(toX(i), toAccY(v), i === highlightIdx ? 5 : 3.5, 0, Math.PI * 2);
      ctx.fillStyle = '#06b6d4'; ctx.fill();
    });
    throughput.forEach((v, i) => {
      ctx.beginPath(); ctx.arc(toX(i), toTpsY(v), i === highlightIdx ? 5 : 3.5, 0, Math.PI * 2);
      ctx.fillStyle = '#8b5cf6'; ctx.fill();
    });

    // Legend
    ctx.fillStyle = '#06b6d4'; ctx.font = '9px monospace'; ctx.textAlign = 'left';
    ctx.fillText('─ Accuracy', PAD_L + 4, PAD_T + 14);
    ctx.fillStyle = '#8b5cf6';
    ctx.fillText('─ Throughput (TPS)', PAD_L + 80, PAD_T + 14);
  }

  draw();

  canvas.addEventListener('click', e => {
    const rect = canvas.getBoundingClientRect();
    const clickX = (e.clientX - rect.left) * (window.devicePixelRatio || 1);
    const DPR = window.devicePixelRatio || 1;
    const W = canvas.width / DPR;
    const PAD_L = 55, PAD_R = 80;
    const chartW = W - PAD_L - PAD_R;
    const N = bValues.length;
    let closest = 0, minD = Infinity;
    bValues.forEach((_, i) => {
      const x = (PAD_L + chartW * i / (N - 1)) * DPR;
      if (Math.abs(clickX - x) < minD) { minD = Math.abs(clickX - x); closest = i; }
    });
    highlightIdx = closest;
    const note = document.getElementById('budget-note');
    if (note) note.textContent = `B_layer=${bValues[closest]} — accuracy: ${accuracy[closest]}%, throughput: ${throughput[closest]} TPS`;
    draw();
  });

  window.addEventListener('resize', draw);
})();

/* ─── §06: Animated bars ────────────────────────────────────────────── */
const barsSection = document.getElementById('s-results');
if (barsSection) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          b.style.width = parseFloat(b.dataset.w) + '%';
        });
      }
    });
  }, { threshold: 0.3 }).observe(barsSection);
}
</script>

</BaseLayout>

<span class="cs-line cmt"># dLLM inference: O(L² × T) total compute</span>
<span class="cs-line cmt"># No KV-cache — every step processes all tokens</span>
<span class="cs-line"> </span>
<span class="cs-line hl-a"><span class="kw">def</span> <span class="fn">dllm_inference</span>(model, prompt, T=<span class="num">64</span>):</span>
<span class="cs-line hl-a">    L = len(prompt) + gen_length</span>
<span class="cs-line hl-a">    x = concat(prompt, [MASK] * gen_length)</span>
<span class="cs-line hl-a">    </span>
<span class="cs-line hl-a">    <span class="kw">for</span> t <span class="kw">in</span> <span class="fn">range</span>(T, <span class="num">0</span>, -<span class="num">1</span>):       <span class="cmt"># T steps</span></span>
<span class="cs-line hl-a">        z = model(x)                 <span class="cmt"># O(L²) — full attn</span></span>
<span class="cs-line hl-a">        x = unmask_tokens(x, z, t)   <span class="cmt"># select tokens</span></span>
<span class="cs-line hl-a">    <span class="kw">return</span> x</span>
<span class="cs-line hl-a">    <span class="cmt"># Total: T × O(L²) = O(L³) for T ~ L</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># AR model: O(L²) total (one step per token)</span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">ar_inference</span>(model, prompt, gen_length):</span>
<span class="cs-line">    x = list(prompt)</span>
<span class="cs-line">    <span class="kw">for</span> _ <span class="kw">in</span> <span class="fn">range</span>(gen_length):    <span class="cmt"># L steps</span></span>
<span class="cs-line">        tok = model(x, kv_cache)    <span class="cmt"># O(L) with cache</span></span>
<span class="cs-line">        x.append(tok)</span>
<span class="cs-line">    <span class="kw">return</span> x</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Concrete numbers (L=512, T=64):</span>
<span class="cs-line cmt">#   dLLM:  512 × 512 × 64  = 16.8B ops</span>
<span class="cs-line cmt">#   AR:    512 × 512        = 262K ops (final step)</span>
<span class="cs-line cmt"># → dLLM pays ~64,000× more per generation</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Existing fixes (flawed):</span>
<span class="cs-line cmt"># dLLM-Cache: static cache — same budget/layer</span>
<span class="cs-line cmt"># Fast-dLLM:  fixed threshold — misses volatility</span>
<span class="cs-line cmt"># Both ignore dynamics across layers and steps</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-layer">
      <pre class="cs-pre">
<span class="cs-line cmt"># Dynamic Cache Updating (DCU) — Section 3.1</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">dcu_allocate</span>(x_curr, x_prev, B_layer, B_window):</span>
<span class="cs-line hl-p">    <span class="cmt"># Step 1: measure token dissimilarity per layer</span></span>
<span class="cs-line hl-p">    d = &#123;&#125;  <span class="cmt"># d[l][i] = cosine distance for token i, layer l</span></span>
<span class="cs-line hl-p">    <span class="kw">for</span> l <span class="kw">in</span> <span class="fn">range</span>(num_layers):</span>
<span class="cs-line hl-p">        <span class="kw">for</span> i <span class="kw">in</span> <span class="fn">range</span>(seq_len):</span>
<span class="cs-line hl-p">            d[l][i] = <span class="num">1</span> - <span class="fn">cosine_sim</span>(x_curr[l][i], x_prev[l][i])</span>
<span class="cs-line hl-p">    </span>
<span class="cs-line hl-c">    <span class="cmt"># Step 2: layer-wise dynamism score</span></span>
<span class="cs-line hl-c">    s = &#123;l: <span class="fn">mean</span>(d[l].values()) <span class="kw">for</span> l <span class="kw">in</span> <span class="fn">range</span>(num_layers)&#125;</span>
<span class="cs-line"> </span>
<span class="cs-line hl-g">    <span class="cmt"># Step 3: proportional budget allocation</span></span>
<span class="cs-line hl-g">    total = B_layer * num_layers</span>
<span class="cs-line hl-g">    budget = &#123;l: total * s[l] / <span class="fn">sum</span>(s.values()) <span class="kw">for</span> l <span class="kw">in</span> s&#125;</span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="cmt"># Step 4: mandatory update window (prevent stuck-in-mud)</span></span>
<span class="cs-line">    key_pos = <span class="fn">argmax</span>(confidence)   <span class="cmt"># most confident token</span></span>
<span class="cs-line">    window = <span class="fn">range</span>(key_pos - B_window//<span class="num">2</span>,</span>
<span class="cs-line">                   key_pos + B_window//<span class="num">2</span>)</span>
<span class="cs-line">    <span class="kw">for</span> l <span class="kw">in</span> <span class="fn">range</span>(num_layers):</span>
<span class="cs-line">        update_set[l] |= window     <span class="cmt"># always update window</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Key property: d correlates with deeper features</span>
<span class="cs-line cmt"># Spearman ρ ≥ 0.94 for Key, Value, Attn, FFN</span>
<span class="cs-line cmt"># → cheap proxy, no extra forward pass needed</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Finding: update rate increases with layer depth</span>
<span class="cs-line cmt"># Layers 1-12: ~25% tokens need update</span>
<span class="cs-line cmt"># Layers 20-32: ~70% tokens need update</span>
<span class="cs-line cmt"># Static methods waste compute on shallow layers</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-threshold">
      <pre class="cs-pre">
<span class="cs-line cmt"># Adaptive Parallel Decoding (APD) — Section 3.2</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">apd_update_threshold</span>(z_curr, z_prev, tau_prev, alpha, beta):</span>
<span class="cs-line hl-p">    <span class="cmt"># z_curr[i] = confidence distribution over vocab for token i</span></span>
<span class="cs-line hl-p">    <span class="kw">for</span> i <span class="kw">in</span> <span class="fn">range</span>(seq_len):</span>
<span class="cs-line hl-p">        <span class="cmt"># concentration: 1 - second-highest prob</span></span>
<span class="cs-line hl-p">        top1_idx = <span class="fn">argmax</span>(z_curr[i])</span>
<span class="cs-line hl-p">        c = <span class="num">1</span> - <span class="fn">max</span>(z_curr[i][j] <span class="kw">for</span> j != top1_idx)</span>
<span class="cs-line"> </span>
<span class="cs-line hl-c">        <span class="cmt"># temporal instability: distribution shift</span></span>
<span class="cs-line hl-c">        H = <span class="num">1</span> - <span class="fn">cosine_sim</span>(z_curr[i], z_prev[i])</span>
<span class="cs-line"> </span>
<span class="cs-line hl-g">        <span class="cmt"># update threshold</span></span>
<span class="cs-line hl-g">        tau[i] = tau_prev[i] - alpha * c + beta * H</span>
<span class="cs-line hl-g">        <span class="cmt"># large c → confident → lower threshold → commit early</span></span>
<span class="cs-line hl-g">        <span class="cmt"># large H → unstable → raise threshold → hold off</span></span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="cmt"># Commit token if confidence exceeds its threshold</span></span>
<span class="cs-line">    commit = &#123;i <span class="kw">for</span> i <span class="kw">if</span> <span class="fn">max</span>(z_curr[i]) &gt;= tau[i]&#125;</span>
<span class="cs-line">    <span class="kw">return</span> commit, tau</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Key finding (ablation):</span>
<span class="cs-line cmt"># Fixed τ=0.9: X inference steps</span>
<span class="cs-line cmt"># Adaptive τ starting at 0.9: 0.7X steps (-30%)</span>
<span class="cs-line cmt"># Same accuracy — adaptive commits earlier on</span>
<span class="cs-line cmt"># stable tokens, holds off on unstable ones</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Why fixed thresholds fail:</span>
<span class="cs-line cmt"># token "the" at step 15: conf=0.82 (crosses τ=0.7)</span>
<span class="cs-line cmt"># → committed, but at step 12 would have been 0.34</span>
<span class="cs-line cmt"># → committed wrong token, error propagates</span>
<span class="cs-line cmt"># APD: H is high at step 15 → threshold stays 0.85</span>
<span class="cs-line cmt">    # → correctly waits until step 4 (conf=0.91, stable)</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-method">
      <pre class="cs-pre">
<span class="cs-line cmt"># Dynamic-dLLM unified inference loop</span>
<span class="cs-line cmt"># Both components are plug-and-play — no fine-tuning</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">dynamic_dllm_step</span>(model, x_curr, x_prev, tau, params):</span>
<span class="cs-line hl-p">    B_layer, B_window, alpha, beta = params</span>
<span class="cs-line hl-p">    </span>
<span class="cs-line hl-c">    <span class="cmt"># 1. DCU: compute layer-adaptive update sets</span></span>
<span class="cs-line hl-c">    update_sets = <span class="fn">dcu_allocate</span>(x_curr, x_prev,</span>
<span class="cs-line hl-c">                                B_layer, B_window)</span>
<span class="cs-line"> </span>
<span class="cs-line hl-g">    <span class="cmt"># 2. Forward pass with selective cache update</span></span>
<span class="cs-line hl-g">    z = model.<span class="fn">forward_with_cache</span>(x_curr,</span>
<span class="cs-line hl-g">                                  update_sets=update_sets)</span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="cmt"># 3. APD: adaptive threshold per token</span></span>
<span class="cs-line">    z_prev = model.<span class="fn">get_prev_logits</span>()</span>
<span class="cs-line">    commit, tau_new = <span class="fn">apd_update_threshold</span>(</span>
<span class="cs-line">        z, z_prev, tau, alpha, beta)</span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="cmt"># 4. Update sequence</span></span>
<span class="cs-line">    x_new = <span class="fn">unmask_committed</span>(x_curr, z, commit)</span>
<span class="cs-line">    <span class="kw">return</span> x_new, tau_new</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Defaults: B_layer=32, B_window=32</span>
<span class="cs-line cmt"># α, β tuned per model (small values, stable)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Feature correlation justifying DCU proxy:</span>
<span class="cs-line cmt"># Layer input vs Attention output: ρ=0.94</span>
<span class="cs-line cmt"># Layer input vs FFN output:       ρ=0.97</span>
<span class="cs-line cmt"># Layer input vs Key:               ρ=0.99</span>
<span class="cs-line cmt"># Layer input vs Value:             ρ=0.99</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-tradeoff">
      <pre class="cs-pre">
<span class="cs-line cmt"># Ablation: B_layer on GSM8K (LLaDA-8B-Instruct)</span>
<span class="cs-line cmt"># B_window=32 fixed, no parallel decoding</span>
<span class="cs-line"> </span>

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Dynamic-dLLM: Training-Free Acceleration for Diffusion LLMs | Catpuccino.ai"
  description="Diffusion LLMs scale as O(L³) with no KV-cache — but Dynamic-dLLM gets 4.48× faster using two adaptive strategies: layer-by-layer dynamic cache budgeting and per-token confidence-tracking thresholds. Plug-and-play, no retraining."
  crumb="Dynamic-dLLM"
>


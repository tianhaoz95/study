<span class="cs-line cmt"># The hidden degree of freedom:</span>
<span class="cs-line cmt"># same model, same weights, different order → different output</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Heuristic schedules — fast but myopic</span>
<span class="cs-line hl-a"><span class="kw">def</span> <span class="fn">confidence_schedule</span>(model, x_masked):</span>
<span class="cs-line hl-a">    <span class="cmt"># pick position with highest max-prob token</span></span>
<span class="cs-line hl-a">    logits = model(x_masked)           <span class="cmt"># forward pass</span></span>
<span class="cs-line hl-a">    conf = logits.softmax(-1).max(-1)  <span class="cmt"># per-position confidence</span></span>
<span class="cs-line hl-a">    <span class="kw">return</span> conf.argmax()               <span class="cmt"># pick most certain</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># ⚠ Problem: locally greedy != globally optimal</span>
<span class="cs-line cmt"># - picks "easy" tokens now</span>
<span class="cs-line cmt"># - may not constrain future predictions</span>
<span class="cs-line cmt"># - ignores downstream trajectory</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Heuristic accuracy on Sudoku (1B MDM):</span>
<span class="cs-line cmt">#   Random      → 62.7%</span>
<span class="cs-line cmt">#   Human Expert→ 76.6%  ← worse than confidence!</span>
<span class="cs-line cmt">#   Entropy     → 81.0%</span>
<span class="cs-line cmt">#   Margin      → 80.0%</span>
<span class="cs-line cmt">#   Confidence  → 82.0%</span>
<span class="cs-line cmt">#   SAS (ours)  → 91.8%  ← +9.8pp over best heuristic</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Key insight: the optimal order for a pretrained</span>
<span class="cs-line cmt"># diffusion model ≠ the optimal order for humans.</span>
<span class="cs-line cmt"># The model's uncertainty landscape is different.</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-background">
      <pre class="cs-pre">
<span class="cs-line cmt"># Sequential unmasking procedure (Section 2.2)</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">sequential_decode</span>(model, prompt, target_len, schedule):</span>
<span class="cs-line hl-p">    <span class="cmt"># Start: fully masked completion</span></span>
<span class="cs-line hl-p">    x = concat(prompt, [MASK] * target_len)</span>
<span class="cs-line hl-p">    S = set()              <span class="cmt"># revealed positions</span></span>
<span class="cs-line hl-p">    M = set(range(len(x))) <span class="cmt"># masked positions</span></span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="kw">for</span> t <span class="kw">in</span> <span class="fn">range</span>(target_len):</span>
<span class="cs-line hl-c">        <span class="cmt"># 1. Schedule selects next position</span></span>
<span class="cs-line hl-c">        i_t = schedule(model, x, M)    <span class="cmt"># ← THE KEY DECISION</span></span>
<span class="cs-line"> </span>
<span class="cs-line hl-g">        <span class="cmt"># 2. Model predicts token at i_t</span></span>
<span class="cs-line hl-g">        p_i = model.predict(x, pos=i_t)</span>
<span class="cs-line hl-g">        x[i_t] = sample(p_i)           <span class="cmt"># reveal</span></span>
<span class="cs-line"> </span>
<span class="cs-line">        <span class="cmt"># 3. Update sets</span></span>
<span class="cs-line">        S.add(i_t); M.remove(i_t)</span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="kw">return</span> x</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># The order σ = (i₁, i₂, …, iₙ) is a permutation</span>
<span class="cs-line cmt"># of all target positions. n! possible orderings.</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Teacher-forcing: evaluate model on ground-truth</span>
<span class="cs-line cmt"># tokens instead of sampled ones (for reward computation)</span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">teacher_forced_state</span>(x_target, order, step_t):</span>
<span class="cs-line">    <span class="cmt"># reveal first t positions from x_target in order σ</span></span>
<span class="cs-line">    x_tf = [MASK] * <span class="fn">len</span>(x_target)</span>
<span class="cs-line">    <span class="kw">for</span> t, i <span class="kw">in</span> <span class="fn">enumerate</span>(order[:step_t]):</span>
<span class="cs-line">        x_tf[i] = x_target[i]</span>
<span class="cs-line">    <span class="kw">return</span> x_tf</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-theory">
      <pre class="cs-pre">
<span class="cs-line cmt"># Self-Aware Reward (Section 3.1)</span>
<span class="cs-line cmt"># The frozen model evaluates its own trajectory</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">self_aware_reward</span>(frozen_model, x_target, order):</span>
<span class="cs-line hl-p">    <span class="cmt"># R(x, σ) = log p_θ(x | σ) = Σ log p_θ(x_iₜ | x̃ᵗ⁻¹)</span></span>
<span class="cs-line hl-p">    reward = <span class="num">0.0</span></span>
<span class="cs-line hl-p">    x_partial = [MASK] * <span class="fn">len</span>(x_target)  <span class="cmt"># fully masked</span></span>
<span class="cs-line hl-p">    </span>
<span class="cs-line hl-p">    <span class="kw">for</span> t, i <span class="kw">in</span> <span class="fn">enumerate</span>(order):</span>
<span class="cs-line hl-p">        <span class="cmt"># frozen model scores position i given current context</span></span>
<span class="cs-line hl-p">        log_p = frozen_model.<span class="fn">log_prob</span>(x_target[i], x_partial, i)</span>
<span class="cs-line hl-p">        reward += log_p             <span class="cmt"># dense: one reward per step</span></span>
<span class="cs-line hl-p">        x_partial[i] = x_target[i]  <span class="cmt"># teacher-force reveal</span></span>
<span class="cs-line hl-p">    </span>
<span class="cs-line hl-p">    <span class="kw">return</span> reward</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Theorem 3.1: R lower-bounds log marginal likelihood</span>
<span class="cs-line cmt"># E[log P_θ,ϕ(x)] ≥ E_σ~v_ϕ[log p_θ(x | σ)] = E[R]</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Theorem 3.2: minimizing -E[R] minimizes joint KL</span>
<span class="cs-line cmt"># KL(π(x)‖P_θ,ϕ(x)) ≤ L_SAS - H(π)</span>
<span class="cs-line cmt">#                    = KL(Q_ϕ(x,σ) ‖ P_θ,ϕ(x,σ))</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># No external verifier needed — the denoiser IS</span>
<span class="cs-line cmt"># the reward model. Works on any task.</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-algorithm">
      <pre class="cs-pre">
<span class="cs-line cmt"># GRPO training loop for the order policy (Section 4)</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">train_sas</span>(frozen_model, policy, dataset, G=<span class="num">8</span>):</span>
<span class="cs-line hl-p">    <span class="kw">for</span> x <span class="kw">in</span> dataset:</span>
<span class="cs-line hl-p">        <span class="cmt"># Step 1: sample G orders from current policy</span></span>
<span class="cs-line hl-p">        orders = [policy.<span class="fn">sample</span>(x) <span class="kw">for</span> _ <span class="kw">in</span> <span class="fn">range</span>(G)]</span>
<span class="cs-line hl-p">        </span>
<span class="cs-line hl-c">        <span class="cmt"># Step 2: compute self-aware reward for each</span></span>
<span class="cs-line hl-c">        rewards = [<span class="fn">self_aware_reward</span>(frozen_model, x, σ)</span>
<span class="cs-line hl-c">                   <span class="kw">for</span> σ <span class="kw">in</span> orders]</span>
<span class="cs-line"> </span>
<span class="cs-line hl-g">        <span class="cmt"># Step 3: group-relative advantage</span></span>
<span class="cs-line hl-g">        mu, sigma = <span class="fn">mean</span>(rewards), <span class="fn">std</span>(rewards)</span>
<span class="cs-line hl-g">        advs = [(r - mu) / (sigma + <span class="num">1e-8</span>) <span class="kw">for</span> r <span class="kw">in</span> rewards]</span>
<span class="cs-line"> </span>
<span class="cs-line">        <span class="cmt"># Step 4: clipped surrogate objective</span></span>
<span class="cs-line">        loss = -<span class="fn">mean</span>([</span>
<span class="cs-line">            <span class="fn">min</span>(ratio * A,</span>
<span class="cs-line">                <span class="fn">clip</span>(ratio, <span class="num">1</span>-eps, <span class="num">1</span>+eps) * A)</span>
<span class="cs-line">            <span class="kw">for</span> ratio, A <span class="kw">in</span> <span class="fn">zip</span>(ratios, advs)])</span>
<span class="cs-line"> </span>
<span class="cs-line">        <span class="cmt"># Only policy params ϕ updated — θ stays frozen</span></span>
<span class="cs-line">        policy.<span class="fn">backward</span>(loss)</span>
<span class="cs-line">        policy.<span class="fn">step</span>()</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Policy: lightweight MLP head on frozen features</span>
<span class="cs-line cmt"># Math/Code: one-layer Transformer policy head</span>
<span class="cs-line cmt"># Training: 1000 puzzles (Sudoku) or 1 epoch (LLaDA)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Dense vs sparse reward comparison (Figure 3):</span>
<span class="cs-line cmt"># SAS (dense): consistently matches or outperforms</span>
<span class="cs-line cmt"># RLVR (sparse 0/1): higher variance, lower floor</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-sudoku">
      <pre class="cs-pre">
<span class="cs-line cmt"># Sudoku experiment: 1M training puzzles (Section 6.1)</span>
<span class="cs-line cmt"># Model: SMDM-1B (1B masked diffusion model)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Board representation: length-81 sequence</span>
<span class="cs-line cmt"># Each cell = token; 0 → [MASK]</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">sudoku_accuracy</span>(model, policy, test_puzzles):</span>
<span class="cs-line hl-p">    correct = <span class="num">0</span></span>
<span class="cs-line hl-p">    <span class="kw">for</span> puzzle <span class="kw">in</span> test_puzzles:</span>
<span class="cs-line hl-p">        completion = <span class="fn">sequential_decode</span>(model, puzzle, policy)</span>
<span class="cs-line hl-p">        <span class="kw">if</span> <span class="fn">is_valid_sudoku</span>(completion):</span>
<span class="cs-line hl-p">            correct += <span class="num">1</span></span>
<span class="cs-line hl-p">    <span class="kw">return</span> correct / <span class="fn">len</span>(test_puzzles)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Learned strategy: "easy-to-hard curriculum"</span>
<span class="cs-line cmt"># 1. Naked singles (only 1 valid digit): first</span>
<span class="cs-line cmt"># 2. Hidden singles (constrained by row/col/box): next</span>
<span class="cs-line cmt"># 3. Ambiguous cells (multiple valid digits): last</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Kendall's τ_eq (equivalence-class variant):</span>
<span class="cs-line cmt">#   Human Expert: τ_eq = 0.514 (58% agree)</span>
<span class="cs-line cmt">#   SAS (ours):   τ_eq = 0.735 (59% agree)</span>
<span class="cs-line cmt"># → SAS aligns better with expert logic,</span>
<span class="cs-line cmt">#   but not perfectly — model's path differs</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># 2nd-stage fine-tuning (frozen order σ̂):</span>
<span class="cs-line cmt">#   Human Order FT: 76.6% → 97.8%</span>
<span class="cs-line cmt">#   SAS Order FT:   91.8% → 97.5%</span>
<span class="cs-line cmt"># Parity achieved — SAS discovers human-quality</span>
<span class="cs-line cmt"># curriculum without ground-truth order traces</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-results">
      <pre class="cs-pre">

        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

/* ─── Step navigators ───────────────────────────────────────────────── */
function makeStepNav(listId, prevId, nextId, progId) {
  let step = 0;
  const boxes = document.querySelectorAll('#' + listId + ' .step-box');
  const prev  = document.getElementById(prevId);
  const next  = document.getElementById(nextId);
  const prog  = document.getElementById(progId);
  function update() {
    boxes.forEach((b, i) => {
      b.classList.remove('active', 'done');
      if (i === step) b.classList.add('active');
      else if (i < step) b.classList.add('done');
    });
    if (prev) prev.disabled = step === 0;
    if (next) next.disabled = step === boxes.length - 1;
    if (prog) prog.textContent = 'Step ' + (step+1) + ' of ' + boxes.length;
    boxes.forEach((b, i) => {
      const n = b.querySelector('.step-num');
      if (n) n.textContent = i < step ? '✓' : String(i+1);
    });
  }
  prev?.addEventListener('click', () => { if (step > 0) { step--; update(); } });
  next?.addEventListener('click', () => { if (step < boxes.length - 1) { step++; update(); } });
  update();
}
makeStepNav('decode-steps', 'decode-prev', 'decode-next', 'decode-prog');
makeStepNav('grpo-steps',   'grpo-prev',   'grpo-next',   'grpo-prog');

/* ─── §01: Contrast mini-canvases ─────────────────────────────────── */
(function() {
  // Mini 4x4 grid visualization (simplified)
  // Shows: confidence picks scattered cells, SAS propagates constraints
  function drawMiniGrid(canvasId, orderMode) {
    const canvas = document.getElementById(canvasId);
    if (!canvas) return;
    const DPR = window.devicePixelRatio || 1;
    const W = canvas.clientWidth, H = canvas.clientHeight || 240;
    canvas.width = W * DPR; canvas.height = H * DPR;
    const ctx = canvas.getContext('2d');
    ctx.scale(DPR, DPR);

    // 5x5 mini puzzle (not real Sudoku, just conceptual)
    const CELLS = 5;
    const PAD = 12;
    const cellSize = (Math.min(W, H) - PAD * 2) / CELLS;
    ctx.fillStyle = '#0d0d14';
    ctx.fillRect(0, 0, W, H);

    // Given cells (fixed)
    const givens = [[0,0],[0,3],[1,2],[2,0],[2,4],[3,1],[4,2],[4,4]];
    const givenSet = new Set(givens.map(([r,c]) => r+','+c));

    // Blank cells
    const blanks = [];
    for (let r = 0; r < CELLS; r++) {
      for (let c = 0; c < CELLS; c++) {
        if (!givenSet.has(r+','+c)) blanks.push([r,c]);
      }
    }

    // Orderings for 17 blank cells
    // Confidence: scattered (roughly by column then row)
    const confOrder = [
      [0,1],[1,0],[1,1],[0,2],[1,3],[1,4],[2,1],
      [2,2],[2,3],[3,0],[3,2],[3,3],[3,4],[0,4],
      [4,0],[4,1],[4,3]
    ];
    // SAS: propagates from corners with givens outward
    const sasOrder = [
      [1,0],[3,0],[2,1],[1,1],[3,2],[2,2],[3,3],
      [2,3],[1,3],[4,3],[4,0],[0,1],[0,2],[4,1],
      [1,4],[3,4],[0,4]
    ];
    const order = orderMode === 'sas' ? sasOrder : confOrder;

    // Draw cells
    for (let r = 0; r < CELLS; r++) {
      for (let c = 0; c < CELLS; c++) {
        const x = PAD + c * cellSize;
        const y = PAD + r * cellSize;
        const key = r + ',' + c;

        if (givenSet.has(key)) {
          // Given cell: white/light
          ctx.fillStyle = 'rgba(240,240,248,0.12)';
          ctx.fillRect(x+1, y+1, cellSize-2, cellSize-2);
          ctx.fillStyle = '#f0f0f8';
          ctx.font = `bold ${Math.round(cellSize*0.45)}px monospace`;
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          ctx.fillText('■', x + cellSize/2, y + cellSize/2);
        } else {
          // Blank cell: find step in order
          const stepIdx = order.findIndex(([or,oc]) => or===r && oc===c);
          const t = stepIdx >= 0 ? (stepIdx / (order.length - 1)) : 0.5;

          if (orderMode === 'sas') {
            // Blue gradient: light → dark purple
            const r1 = Math.round(99 + (139-99)*t);
            const g1 = Math.round(179 + (92-179)*t);
            const b1 = Math.round(237 + (246-237)*t);
            ctx.fillStyle = `rgba(${r1},${g1},${b1},${0.25 + t*0.65})`;
          } else {
            // Scattered confidence look: some cells brighter, some dimmer
            const scattered = ((stepIdx * 7 + 3) % order.length) / order.length;
            const r1 = Math.round(99 + (139-99)*scattered);
            const g1 = Math.round(179 + (92-179)*scattered);
            const b1 = Math.round(237 + (246-237)*scattered);
            ctx.fillStyle = `rgba(${r1},${g1},${b1},${0.2 + scattered*0.65})`;
          }
          ctx.fillRect(x+1, y+1, cellSize-2, cellSize-2);

          // Step number label
          ctx.fillStyle = orderMode === 'sas'
            ? `rgba(255,255,255,${0.3 + t*0.7})`
            : 'rgba(255,255,255,0.4)';
          ctx.font = `${Math.round(cellSize*0.35)}px monospace`;
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          ctx.fillText(stepIdx >= 0 ? String(stepIdx+1) : '?', x + cellSize/2, y + cellSize/2);
        }

        // Cell border
        ctx.strokeStyle = 'rgba(255,255,255,0.06)';
        ctx.lineWidth = 0.5;
        ctx.strokeRect(x+0.5, y+0.5, cellSize-1, cellSize-1);
      }
    }

    // 3x3 box borders (stronger)
    ctx.strokeStyle = 'rgba(255,255,255,0.15)';
    ctx.lineWidth = 1.5;
    // Just outer border for this mini grid
    ctx.strokeRect(PAD+0.75, PAD+0.75, CELLS*cellSize-1.5, CELLS*cellSize-1.5);
  }

  drawMiniGrid('canvas-myopic', 'confidence');
  drawMiniGrid('canvas-sas', 'sas');
})();

/* ─── §05: Sudoku interactive canvas ───────────────────────────────── */
(function() {
  const canvas = document.getElementById('sudoku-canvas');
  if (!canvas) return;

  // Wikipedia's example Sudoku puzzle
  const GRID = [
    [5,3,0,0,7,0,0,0,0],
    [6,0,0,1,9,5,0,0,0],
    [0,9,8,0,0,0,0,6,0],
    [8,0,0,0,6,0,0,0,3],
    [4,0,0,8,0,3,0,0,1],
    [7,0,0,0,2,0,0,0,6],
    [0,6,0,0,0,0,2,8,0],
    [0,0,0,4,1,9,0,0,5],
    [0,0,0,0,8,0,0,7,9]
  ];

  // Collect blank cells in row-major order
  const BLANKS = [];
  for (let r = 0; r < 9; r++)
    for (let c = 0; c < 9; c++)
      if (GRID[r][c] === 0) BLANKS.push([r, c]);
  const N = BLANKS.length; // 51

  // Constraint count for each blank cell
  function countGivens(r, c) {
    let cnt = 0;
    for (let j = 0; j < 9; j++) { if (GRID[r][j] > 0) cnt++; }
    for (let i = 0; i < 9; i++) { if (GRID[i][c] > 0) cnt++; }
    const br = Math.floor(r/3)*3, bc = Math.floor(c/3)*3;
    for (let i = br; i < br+3; i++)
      for (let j = bc; j < bc+3; j++)
        if (GRID[i][j] > 0) cnt++;
    return cnt;
  }

  const constraints = BLANKS.map(([r,c]) => countGivens(r,c));

  // Seeded LCG
  function seededRand(n) {
    return ((1664525*n + 1013904223) & 0x7fffffff) / 0x7fffffff;
  }

  // Build orderings (each is an array of blank-cell indices, in reveal order)
  function buildOrdering(mode) {
    const indices = Array.from({length: N}, (_, i) => i);
    if (mode === 'random') {
      // seeded Fisher-Yates
      const arr = [...indices];
      for (let i = arr.length - 1; i > 0; i--) {
        const j = Math.floor(seededRand(i * 3 + 7) * (i + 1));
        [arr[i], arr[j]] = [arr[j], arr[i]];
      }
      return arr;
    }
    if (mode === 'confidence') {
      // sort by constraint descending, break ties by seeded noise
      return [...indices].sort((a, b) => {
        const diff = constraints[b] - constraints[a];
        if (diff !== 0) return diff;
        return seededRand(a * 5 + 1) - seededRand(b * 5 + 1);
      });
    }
    if (mode === 'human') {
      // Human expert: top-down within each 3x3 box, boxes in reading order
      return [...indices].sort((a, b) => {
        const [ra, ca] = BLANKS[a], [rb, cb] = BLANKS[b];
        const boxA = Math.floor(ra/3)*3 + Math.floor(ca/3);
        const boxB = Math.floor(rb/3)*3 + Math.floor(cb/3);
        if (boxA !== boxB) return boxA - boxB;
        if (ra !== rb) return ra - rb;
        return ca - cb;
      });
    }
    // SAS: constraint descending but with regional grouping
    // emulates "easy-to-hard curriculum": top-left propagates first
    return [...indices].sort((a, b) => {
      const [ra, ca] = BLANKS[a], [rb, cb] = BLANKS[b];
      // Primary: constraint count descending (more constraints = more certain)
      const cDiff = constraints[b] - constraints[a];
      // Secondary: proximity to top-left corner (propagation direction)
      const distA = ra + ca;
      const distB = rb + cb;
      if (Math.abs(cDiff) > 2) return cDiff;
      return distA - distB;
    });
  }

  const ORDERS = {
    random:     buildOrdering('random'),
    confidence: buildOrdering('confidence'),
    human:      buildOrdering('human'),
    sas:        buildOrdering('sas'),
  };

  // Step map: for each mode, STEP_OF[blankIdx] = 1-based step number
  function buildStepOf(order) {
    const stepOf = new Array(N);
    order.forEach((blankIdx, step) => { stepOf[blankIdx] = step + 1; });
    return stepOf;
  }

  const STEP_OF = {
    random:     buildStepOf(ORDERS.random),
    confidence: buildStepOf(ORDERS.confidence),
    human:      buildStepOf(ORDERS.human),
    sas:        buildStepOf(ORDERS.sas),
  };

  const ACC_LABELS = {
    random:     'Random: 62.7% puzzle accuracy',
    confidence: 'Confidence (Top-1): 82.0% puzzle accuracy',
    human:      'Human Expert: 76.6% puzzle accuracy',
    sas:        'SAS (Ours): 91.8% puzzle accuracy',
  };
  const MODE_DESCS = {
    random:     'Random order — scattered reveal, no strategy.',
    confidence: 'Confidence schedule — picks highest-certainty cells, but myopically.',
    human:      'Human Expert order — logical, but calibrated for humans not the model (76.6% = worse than confidence!).',
    sas:        'SAS (Ours) — learned "easy-to-hard curriculum": most constrained cells first, propagates outward.',
  };

  let currentMode = 'sas';

  function drawSudoku(mode) {
    const DPR = window.devicePixelRatio || 1;
    const W = canvas.clientWidth;
    const H = W; // square
    canvas.width  = W * DPR;
    canvas.height = H * DPR;
    const ctx = canvas.getContext('2d');
    ctx.scale(DPR, DPR);

    const PAD = 14;
    const cellSize = (W - PAD * 2) / 9;

    ctx.fillStyle = '#0d0d14';
    ctx.fillRect(0, 0, W, H);

    const stepOf = STEP_OF[mode];
    let blankIdx = 0;

    for (let r = 0; r < 9; r++) {
      for (let c = 0; c < 9; c++) {
        const x = PAD + c * cellSize;
        const y = PAD + r * cellSize;

        if (GRID[r][c] > 0) {
          // Given cell
          ctx.fillStyle = 'rgba(240,240,248,0.10)';
          ctx.fillRect(x+1, y+1, cellSize-2, cellSize-2);
          ctx.fillStyle = '#e0e0f0';
          ctx.font = `bold ${Math.round(cellSize*0.5)}px monospace`;
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          ctx.fillText(String(GRID[r][c]), x + cellSize/2, y + cellSize/2);
        } else {
          // Blank cell — color by step
          const step = stepOf[blankIdx]; // 1..N
          const t = (step - 1) / (N - 1); // 0=first, 1=last

          // Color: light cyan-blue → deep purple
          const alpha = 0.22 + t * 0.72;
          const rr = Math.round(99  + (139-99)*t);
          const gg = Math.round(179 + (92-179)*t);
          const bb = Math.round(237 + (246-237)*t);
          ctx.fillStyle = `rgba(${rr},${gg},${bb},${alpha})`;
          ctx.fillRect(x+1, y+1, cellSize-2, cellSize-2);

          // Step number (tiny)
          ctx.fillStyle = `rgba(255,255,255,${0.4 + t*0.5})`;
          ctx.font = `${Math.round(cellSize*0.32)}px monospace`;
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          ctx.fillText(String(step), x + cellSize/2, y + cellSize/2);

          blankIdx++;
        }

        // Cell border
        ctx.strokeStyle = 'rgba(255,255,255,0.045)';
        ctx.lineWidth = 0.5;
        ctx.strokeRect(x+0.5, y+0.5, cellSize-1, cellSize-1);
      }
    }

    // 3×3 box borders
    ctx.strokeStyle = 'rgba(255,255,255,0.2)';
    ctx.lineWidth = 1.5;
    for (let i = 0; i <= 9; i += 3) {
      ctx.beginPath();
      ctx.moveTo(PAD + i*cellSize, PAD);
      ctx.lineTo(PAD + i*cellSize, PAD + 9*cellSize);
      ctx.stroke();
      ctx.beginPath();
      ctx.moveTo(PAD, PAD + i*cellSize);
      ctx.lineTo(PAD + 9*cellSize, PAD + i*cellSize);
      ctx.stroke();
    }

    // Update labels
    const accEl = document.getElementById('sudoku-acc');
    const modeEl = document.getElementById('mode-label');
    if (accEl) {
      accEl.textContent = ACC_LABELS[mode];
      accEl.style.color = mode === 'sas' ? 'var(--purple-l)' : mode === 'human' ? 'var(--amber)' : 'var(--muted2)';
    }
    if (modeEl) modeEl.textContent = MODE_DESCS[mode];
  }

  // Button listeners
  document.querySelectorAll('.sudoku-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      currentMode = btn.dataset.mode;
      document.querySelectorAll('.sudoku-btn').forEach(b => b.classList.toggle('active', b.dataset.mode === currentMode));
      drawSudoku(currentMode);
    });
  });

  // Initial draw
  drawSudoku('sas');
  window.addEventListener('resize', () => drawSudoku(currentMode));
})();

/* ─── §06: Animated bars ────────────────────────────────────────────── */
const barsSection = document.getElementById('s-results');
if (barsSection) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          b.style.width = (parseFloat(b.dataset.w)) + '%';
        });
      }
    });
  }, { threshold: 0.3 }).observe(barsSection);
}
</script>

</BaseLayout>

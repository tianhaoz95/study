</div><!-- /post-grid -->

<script>
// ── TOC + sidebar toggles ──────────────────────────────────────────────
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});
const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ── Code sidebar tab switching ────────────────────────────────────────
const tabMeta = {
  problem:   { file: 'msa/attention.py',  title: 'The Quadratic Wall' },
  arch:      { file: 'msa/layer.py',      title: 'Two-Branch Design' },
  selection: { file: 'msa/indexer.py',    title: 'Block Selection' },
  budget:    { file: 'msa/budget.py',     title: 'Fixed KV Budget' },
  kernels:   { file: 'msa/kernels.cu',    title: 'Kernel Engineering' },
  results:   { file: 'msa/results.py',    title: 'Benchmarks & Speedup' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ── IntersectionObserver: TOC + sidebar sync ──────────────────────────
const sectionMap = {
  's-problem':   'problem',
  's-arch':      'arch',
  's-selection': 'selection',
  's-budget':    'budget',
  's-kernels':   'kernels',
  's-results':   'results',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ── §01: FLOPs canvas ─────────────────────────────────────────────────
(function() {
  const canvas = document.getElementById('flops-canvas');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth || 600;
  const H = 260;
  canvas.width  = W * DPR;
  canvas.height = H * DPR;
  const ctx = canvas.getContext('2d');
  ctx.scale(DPR, DPR);

  const pad = { l: 58, r: 36, t: 24, b: 40 };
  const cw = W - pad.l - pad.r;
  const ch = H - pad.t - pad.b;

  const ctxPoints = [8192, 32768, 65536, 131072, 262144, 524288, 1048576];
  const H_q=64, H_kv=4, d_h=128, d_idx=48, k=16, B_k=128;
  function gqaF(N){ return 2*H_q*d_h*N*N; }
  function msaF(N){ return H_kv*d_idx*N*N + 4*H_q*d_h*N*k*B_k; }
  const norm = gqaF(32768);
  const gqaVals = ctxPoints.map(N => gqaF(N)/norm);
  const msaVals = ctxPoints.map(N => msaF(N)/norm);

  const maxY = gqaVals[gqaVals.length-1] * 1.1;
  const logMin = Math.log10(0.1);
  const logMax = Math.log10(maxY);

  function xPos(i){ return pad.l + (i/(ctxPoints.length-1))*cw; }
  function yPos(v){ return pad.t + (1 - (Math.log10(v)-logMin)/(logMax-logMin))*ch; }

  const gridVals = [0.1, 1, 10, 100, 1000];
  gridVals.forEach(v => {
    const y = yPos(v);
    if (y < pad.t || y > pad.t+ch) return;
    ctx.strokeStyle = 'rgba(255,255,255,.05)';
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(pad.l, y); ctx.lineTo(pad.l+cw, y); ctx.stroke();
    ctx.fillStyle = '#4b5563'; ctx.font = '9px monospace'; ctx.textAlign = 'right';
    const label = v >= 1000 ? '1000×' : v >= 100 ? '100×' : v >= 10 ? '10×' : v >= 1 ? '1×' : '0.1×';
    ctx.fillText(label, pad.l-5, y+3);
  });

  const ctxLabels = ['8K','32K','64K','128K','256K','512K','1M'];
  ctxPoints.forEach((N, i) => {
    const x = xPos(i);
    ctx.strokeStyle = 'rgba(255,255,255,.04)';
    ctx.beginPath(); ctx.moveTo(x, pad.t); ctx.lineTo(x, pad.t+ch); ctx.stroke();
    ctx.fillStyle = '#4b5563'; ctx.font = '9px monospace'; ctx.textAlign = 'center';
    ctx.fillText(ctxLabels[i], x, pad.t+ch+14);
  });

  ctx.strokeStyle = 'rgba(255,255,255,.2)'; ctx.lineWidth = 1.2;
  ctx.beginPath(); ctx.moveTo(pad.l, pad.t); ctx.lineTo(pad.l, pad.t+ch); ctx.lineTo(pad.l+cw, pad.t+ch); ctx.stroke();

  let prog = 0;
  function draw(p) {
    ctx.clearRect(pad.l+1, pad.t, cw, ch+1);
    gridVals.forEach(v => {
      const y = yPos(v);
      if (y < pad.t || y > pad.t+ch) return;
      ctx.strokeStyle = 'rgba(255,255,255,.05)';
      ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(pad.l, y); ctx.lineTo(pad.l+cw, y); ctx.stroke();
    });

    const steps = Math.floor(p * (ctxPoints.length-1));
    const frac  = p * (ctxPoints.length-1) - steps;

    function drawLine(vals, color, width) {
      ctx.strokeStyle = color; ctx.lineWidth = width;
      ctx.beginPath();
      vals.forEach((v, i) => {
        if (i > steps + 1) return;
        const x = xPos(i);
        const vInterp = (i === steps) ? vals[i] * (1-frac) + (vals[i+1] || vals[i]) * frac : v;
        const y = yPos(Math.max(vInterp, 0.01));
        if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
      });
      ctx.stroke();
    }

    ctx.beginPath();
    const end = Math.min(steps+1, ctxPoints.length-1);
    for (let i=0; i<=end; i++) {
      const x = xPos(i);
      const v = (i === steps && frac > 0) ? gqaVals[i]*(1-frac) + (gqaVals[i+1]||gqaVals[i])*frac : gqaVals[i];
      const y = yPos(Math.max(v, 0.01));
      if (i===0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
    }
    ctx.lineTo(xPos(end), pad.t+ch);
    ctx.lineTo(pad.l, pad.t+ch);
    ctx.closePath();
    ctx.fillStyle = 'rgba(239,68,68,.06)';
    ctx.fill();

    drawLine(gqaVals, 'rgba(239,68,68,.85)', 2.5);
    drawLine(msaVals, 'rgba(139,92,246,.9)', 2.5);

    if (p >= 1) {
      const xEnd = xPos(ctxPoints.length-1);
      const yGQA = yPos(gqaVals[gqaVals.length-1]);
      const yMSA = yPos(msaVals[msaVals.length-1]);
      const yMid = (yGQA + yMSA) / 2;
      ctx.strokeStyle = 'rgba(255,255,255,.3)'; ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(xEnd+4, yGQA); ctx.lineTo(xEnd+4, yMSA); ctx.stroke();
      ctx.fillStyle = 'rgba(255,255,255,.7)'; ctx.font = 'bold 10px monospace'; ctx.textAlign = 'left';
      ctx.fillText('28.4×', xEnd+7, yMid+4);
      ctx.fillStyle = 'rgba(239,68,68,.9)'; ctx.font = '10px monospace';
      ctx.fillText('GQA (full)', pad.l+8, yPos(gqaVals[2])-6);
      ctx.fillStyle = 'rgba(139,92,246,.9)';
      ctx.fillText('MSA (sparse)', pad.l+8, yPos(msaVals[2])+14);
      ctx.save(); ctx.translate(12, pad.t+ch/2); ctx.rotate(-Math.PI/2);
      ctx.fillStyle = '#6b7280'; ctx.font = '9px monospace'; ctx.textAlign = 'center';
      ctx.fillText('relative FLOPs (log)', 0, 0);
      ctx.restore();
    }
  }

  let started = false;
  const obs = new IntersectionObserver(entries => {
    if (entries[0].isIntersecting && !started) {
      started = true;
      const start = performance.now();
      const dur = 1800;
      function tick(now) {
        prog = Math.min(1, (now-start)/dur);
        draw(prog);
        if (prog < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }
  }, { threshold: 0.3 });
  obs.observe(canvas);
})();

// ── §03: Heatmap canvas ───────────────────────────────────────────────
(function() {
  const canvas = document.getElementById('heatmap-canvas');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth || 600;
  const H = 300;
  canvas.width  = W * DPR;
  canvas.height = H * DPR;
  const ctx = canvas.getContext('2d');
  ctx.scale(DPR, DPR);

  const NQ = 32, NK = 48;
  const cellW = (W - 40) / NK;
  const cellH = (H - 30) / NQ;
  const offX = 20, offY = 10;

  const groupStripes = [
    (q, b) => (b - 4 >= 0) && (b - 4) % 7 === (q % 3),
    (q, b) => (b - 3 >= 0) && (b - 3) % 8 === (q % 4),
    (q, b) => (b - 6 >= 0) && (b - 6) % 6 === (q % 2),
    (q, b) => (b - 2 >= 0) && (b - 2) % 9 === (q % 3),
  ];

  function drawHeatmap(grp) {
    ctx.clearRect(0, 0, W, H);
    for (let q = 0; q < NQ; q++) {
      for (let b = 0; b < NK; b++) {
        if (b > q + (NK - NQ)) { ctx.fillStyle = 'rgba(10,10,20,.4)'; ctx.fillRect(offX + b*cellW+0.5, offY + q*cellH+0.5, cellW-1, cellH-1); continue; }
        const isLocal = (b === Math.min(q + (NK - NQ), NK-1));
        const isSink  = (b === 0);
        const isLong  = groupStripes[grp](q, b);
        if (isLocal)       ctx.fillStyle = 'rgba(6,182,212,.75)';
        else if (isSink)   ctx.fillStyle = 'rgba(245,158,11,.7)';
        else if (isLong)   ctx.fillStyle = 'rgba(139,92,246,.65)';
        else               ctx.fillStyle = 'rgba(20,20,35,.85)';
        ctx.fillRect(offX + b*cellW + 0.5, offY + q*cellH + 0.5, cellW - 1, cellH - 1);
      }
    }
    ctx.fillStyle = '#4b5563'; ctx.font = '8px monospace'; ctx.textAlign = 'center';
    [0, 11, 23, 35, 47].forEach(b => {
      ctx.fillText(b.toString(), offX + b*cellW + cellW/2, offY + NQ*cellH + 12);
    });
  }

  drawHeatmap(0);

  document.querySelectorAll('.grp-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.grp-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      drawHeatmap(parseInt(btn.dataset.grp));
    });
  });
})();

// ── §04: Budget canvas ────────────────────────────────────────────────
(function() {
  const canvas = document.getElementById('budget-canvas');
  const labelEl = document.getElementById('budget-label');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth || 600;
  const H = 200;
  canvas.width  = W * DPR;
  canvas.height = H * DPR;
  const ctx = canvas.getContext('2d');
  ctx.scale(DPR, DPR);

  function drawBudget(N) {
    ctx.clearRect(0, 0, W, H);
    const MSA_BUDGET = 2048;
    const barH = 40, gap = 30, topY = 40;
    ctx.fillStyle = '#9ca3af'; ctx.font = '11px monospace'; ctx.textAlign = 'right';
    ctx.fillText('GQA', 64, topY + barH/2 + 4);
    ctx.fillText('MSA', 64, topY + barH + gap + barH/2 + 4);
    const trackW = W - 80;
    const offX = 70;
    ctx.fillStyle = 'rgba(239,68,68,.5)';
    ctx.fillRect(offX, topY, trackW, barH);
    ctx.fillStyle = 'rgba(255,255,255,.7)'; ctx.font = 'bold 11px monospace'; ctx.textAlign = 'left';
    ctx.fillText('ALL ' + (N >= 1000000 ? '1M' : N >= 1000 ? (N/1000)+'K' : N) + ' tokens', offX + 8, topY + barH/2 + 4);
    const msaW = Math.max(3, (MSA_BUDGET / N) * trackW);
    ctx.fillStyle = 'rgba(20,20,35,.8)';
    ctx.fillRect(offX, topY + barH + gap, trackW, barH);
    ctx.fillStyle = 'rgba(139,92,246,.85)';
    ctx.fillRect(offX, topY + barH + gap, msaW, barH);
    ctx.fillStyle = 'rgba(255,255,255,.65)'; ctx.font = 'bold 11px monospace'; ctx.textAlign = 'left';
    ctx.fillText('2,048 selected', offX + msaW + 5, topY + barH + gap + barH/2 + 4);
    const pct = (MSA_BUDGET / N * 100).toFixed(2);
    if (labelEl) labelEl.textContent = `MSA attends to ${pct}% of tokens → ~${Math.min(28.4, parseFloat((N/MSA_BUDGET).toFixed(1)))}× fewer attention FLOPs`;
    ctx.strokeStyle = 'rgba(255,255,255,.2)'; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(offX, topY-10); ctx.lineTo(offX+trackW, topY-10); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(offX, topY-15); ctx.lineTo(offX, topY-5); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(offX+trackW, topY-15); ctx.lineTo(offX+trackW, topY-5); ctx.stroke();
    const nLabel = N >= 1000000 ? '1M tokens' : (N/1000)+'K tokens';
    ctx.fillStyle = '#6b7280'; ctx.font = '9px monospace'; ctx.textAlign = 'center';
    ctx.fillText(nLabel, offX+trackW/2, topY-14);
  }

  drawBudget(32768);

  document.querySelectorAll('.ctx-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.ctx-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      drawBudget(parseInt(btn.dataset.ctx));
    });
  });
})();

// ── §05: Kernel step navigator ────────────────────────────────────────
(function() {
  let step = 0;
  const boxes   = document.querySelectorAll('#kernel-steps .step-box');
  const prevBtn = document.getElementById('kern-prev');
  const nextBtn = document.getElementById('kern-next');
  const progEl  = document.getElementById('kern-prog');
  function updateSteps() {
    boxes.forEach((b, i) => {
      b.classList.remove('active','done');
      if (i === step) b.classList.add('active');
      else if (i < step) b.classList.add('done');
    });
    if (prevBtn) prevBtn.disabled = step === 0;
    if (nextBtn) nextBtn.disabled = step === boxes.length - 1;
    if (progEl) progEl.textContent = `Step ${step+1} of ${boxes.length}`;
    boxes.forEach((b, i) => {
      const n = b.querySelector('.step-num');
      if (n) n.textContent = i < step ? '✓' : String(i+1);
    });
  }
  prevBtn?.addEventListener('click', () => { if (step>0){step--;updateSteps();} });
  nextBtn?.addEventListener('click', () => { if (step<boxes.length-1){step++;updateSteps();} });
  updateSteps();
})();

// ── §06: Animated bar charts ──────────────────────────────────────────
const resultsSection = document.getElementById('s-results');
if (resultsSection) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          const w = parseFloat(b.dataset.w);
          b.style.width = Math.min(100, w / 85 * 100) + '%';
        });
      }
    });
  }, { threshold: 0.2 }).observe(resultsSection);
}
</script>

</BaseLayout>

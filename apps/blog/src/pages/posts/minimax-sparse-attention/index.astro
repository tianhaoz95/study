<span class="cs-line hl-p">OlymMATH  = (<span class="num">23.0</span>, <span class="num">26.0</span>, <span class="num">22.0</span>)  <span class="cmt"># PT wins +3</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># ── Code ──</span>
<span class="cs-line">HumanEval = (<span class="num">61.0</span>, <span class="num">64.0</span>, <span class="num">57.9</span>)  <span class="cmt"># PT leads</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># ── Long-context ──</span>
<span class="cs-line hl-c">RULER_8K  = (<span class="num">79.8</span>, <span class="num">84.2</span>, <span class="num">77.2</span>)  <span class="cmt"># PT +4.4!</span></span>
<span class="cs-line hl-c">RULER_32K = (<span class="num">75.0</span>, <span class="num">77.5</span>, <span class="num">75.7</span>)  <span class="cmt"># PT +2.5</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># ── Video ──</span>
<span class="cs-line hl-g">VideoMME  = (<span class="num">41.1</span>, <span class="num">45.5</span>, <span class="num">39.7</span>)  <span class="cmt"># PT +4.4!</span></span>
<span class="cs-line hl-g">MLVU      = (<span class="num">44.1</span>, <span class="num">46.9</span>, <span class="num">43.7</span>)  <span class="cmt"># PT +2.8</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># ── Speedup at 1M context (H800) ──</span>
<span class="cs-line">flops_reduction = <span class="num">28.4</span>  <span class="cmt"># × vs GQA</span></span>
<span class="cs-line">prefill_speedup = <span class="num">14.2</span>  <span class="cmt"># × wall clock</span></span>
<span class="cs-line">decode_speedup  =  <span class="num">7.6</span>  <span class="cmt"># × wall clock</span></span>
<span class="cs-line">topk_speedup    =  <span class="num">5.1</span>  <span class="cmt"># × vs torch.topk</span></span>
      </pre>
    </div>

  </div>

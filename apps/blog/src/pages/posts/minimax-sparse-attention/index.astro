.ctx-btns{display:flex;gap:.5rem;margin-bottom:1rem;flex-wrap:wrap}
.ctx-btn{padding:.3rem .75rem;border-radius:5px;font-size:.72rem;font-family:var(--ff-mono);cursor:pointer;border:1px solid var(--border-hi);background:var(--surface);color:var(--muted2);transition:all .15s}

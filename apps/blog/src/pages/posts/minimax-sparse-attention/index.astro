<span class="cs-line hl-g"><span class="cmt"># → 28.4× fewer FLOPs for attention</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Fraction of tokens attended:</span>
<span class="cs-line">frac_32K  = <span class="num">2048</span> / <span class="num">32768</span>   <span class="cmt"># 6.25%</span></span>
<span class="cs-line">frac_128K = <span class="num">2048</span> / <span class="num">131072</span>  <span class="cmt"># 1.56%</span></span>
<span class="cs-line">frac_512K = <span class="num">2048</span> / <span class="num">524288</span>  <span class="cmt"># 0.39%</span></span>
<span class="cs-line hl-p">frac_1M   = <span class="num">2048</span> / <span class="num">1048576</span> <span class="cmt"># 0.20%</span></span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-arch">
      <pre class="cs-pre">
<span class="cs-line cmt"># Algorithm 1: One MSA layer (training forward)</span>
<span class="cs-line cmt"># X: (N, d_model) hidden states</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">msa_layer</span>(X, W_q, W_k, W_v, W_o,</span>
<span class="cs-line hl-p">              W_q_idx, W_k_idx, B_k, k):</span>
<span class="cs-line"> </span>
<span class="cs-line cmt">    # Main branch projections</span>
<span class="cs-line">    Q = X @ W_q   <span class="cmt"># (N, H_q, d_h)</span></span>
<span class="cs-line">    K = X @ W_k   <span class="cmt"># (N, H_kv, d_h)</span></span>
<span class="cs-line">    V = X @ W_v   <span class="cmt"># (N, H_kv, d_h)</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt">    # Index branch (stop-gradient on X)</span>
<span class="cs-line hl-c">    Xd = stopgrad(X)</span>
<span class="cs-line hl-c">    Q_idx = Xd @ W_q_idx <span class="cmt"># (N, H_kv, d_idx)</span></span>
<span class="cs-line hl-c">    K_idx = Xd @ W_k_idx <span class="cmt"># (N, 1,    d_idx)</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt">    # Block scoring via max-pool</span>
<span class="cs-line">    M = block_max_pool(Q_idx, K_idx, B_k)</span>
<span class="cs-line cmt">    # M: (N, H_kv, B) per-group block scores</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p">    # Top-k selection (non-differentiable)</span>
<span class="cs-line hl-p">    I = topk(M, k)  <span class="cmt"># local block always included</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt">    # Main branch sparse attention</span>
<span class="cs-line hl-g">    O = topk_attn(Q, K, V, I) <span class="cmt"># ≤ kB_k tokens</span></span>
<span class="cs-line hl-g">    out = O @ W_o  <span class="cmt"># (N, d_model)</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt">    # KL loss trains the scout</span>
<span class="cs-line">    L_kl = kl_div(Q_idx, K_idx,</span>
<span class="cs-line">                  stopgrad(Q), stopgrad(K), I)</span>
<span class="cs-line">    <span class="kw">return</span> out, L_kl</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Total loss: L = L_LM + λ·Σ_layers L_kl</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-selection">
      <pre class="cs-pre">
<span class="cs-line cmt"># Block scoring formula (per group r, query i)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Token-level index scores:</span>
<span class="cs-line hl-p">S_ij = (Q_idx[i,r] @ K_idx[j,0].T) / sqrt(d_idx)</span>
<span class="cs-line cmt">#        ↑ one head per group ↑ single shared key head</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Block-level score via max-pooling:</span>
<span class="cs-line hl-c">M_b = max(S_ij for j in block_b if j &lt;= i)</span>
<span class="cs-line cmt"># max-pool gives O(B) block scores from O(N) token scores</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Select top-k blocks (local block always included):</span>
<span class="cs-line hl-g">I = topk(M, k=16)  ∪  &#123;local_block(i)&#125;</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Learned pattern (from visualization):</span>
<span class="cs-line cmt"># Block 0      → always selected (attention sink)</span>
<span class="cs-line cmt"># Local block  → always selected (local coherence)</span>
<span class="cs-line cmt"># Group 1 → long-range positions [4, 8, 16, 25, ...]</span>
<span class="cs-line cmt"># Group 2 → long-range positions [3, 11, 19, 28, ...]</span>
<span class="cs-line cmt"># Group 3 → long-range positions [6, 13, 22, 31, ...]</span>
<span class="cs-line cmt"># Group 4 → long-range positions [2, 9,  17, 24, ...]</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># KL training objective:</span>
<span class="cs-line">P_idx = softmax(S_ij for j in I_tok)</span>
<span class="cs-line">P_main = mean_over_heads(softmax(main_scores))</span>
<span class="cs-line hl-p">L_kl = KL(stopgrad(P_main) || P_idx)</span>
<span class="cs-line cmt"># Trains scout to predict main branch attention</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-budget">
      <pre class="cs-pre">
<span class="cs-line cmt"># Per-token attention FLOPs comparison</span>
<span class="cs-line cmt"># (assuming causal, averaged over positions)</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p">context_lengths = [32_000, 128_000, 512_000, 1_000_000]</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># GQA: quadratic — attends to ALL tokens</span>
<span class="cs-line">gqa_budget = lambda N: N          <span class="cmt"># O(N)</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># MSA: fixed — attends to kB_k = 2048</span>
<span class="cs-line hl-c">msa_budget = lambda N: 2048        <span class="cmt"># O(1)</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Token coverage (% of context attended):</span>
<span class="cs-line">for N in context_lengths:</span>
<span class="cs-line">    pct = <span class="num">2048</span> / N * <span class="num">100</span></span>
<span class="cs-line">    print(f"N=&#123;N//1000&#125;K → &#123;pct:.2f&#125;% of tokens")</span>
<span class="cs-line cmt"># N=32K  → 6.25%</span>
<span class="cs-line cmt"># N=128K → 1.56%</span>
<span class="cs-line cmt"># N=512K → 0.39%</span>
<span class="cs-line hl-g">N=1M   → 0.20%   # 28.4× FLOPs reduction</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Wall-clock speedup (measured on H800):</span>
<span class="cs-line cmt"># Prefill at 1M:  30s → 2.1s  (14.2×)</span>
<span class="cs-line cmt"># Decode at 1M:   0.9ms → 0.12ms (7.6×)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Block recall during CPT:</span>
<span class="cs-line hl-p">block_recall = 0.90   <span class="cmt"># top-k blocks retrieved</span></span>
<span class="cs-line hl-p">score_recall = 0.95   <span class="cmt"># attention mass covered</span></span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-kernels">
      <pre class="cs-pre">
<span class="cs-line cmt"># Kernel 1: Exp-free TopK</span>
<span class="cs-line cmt"># Softmax preserves ordering → skip it</span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">topk_blocks</span>(scores, k):</span>
<span class="cs-line hl-p">    <span class="cmt"># No max/exp/sum needed for selection</span></span>
<span class="cs-line hl-p">    <span class="kw">return</span> <span class="fn">argtopk</span>(scores, k)  <span class="cmt"># raw scores</span></span>
<span class="cs-line cmt"># 5.1× faster than torch.topk at N=128K, k=16</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Kernel 2: KV-outer iteration</span>
<span class="cs-line cmt"># Arithmetic intensity comparison:</span>
<span class="cs-line hl-c">Q_outer_AI = G            <span class="cmt"># = 16  (GQA ratio)</span></span>
<span class="cs-line hl-c">KV_outer_AI = 2/3 * B_k  <span class="cmt"># = 85  (much better!)</span></span>
<span class="cs-line cmt"># Pack ⌈128/G⌉=8 query positions per KV tile</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Kernel 3: Pre-scheduled chunking</span>
<span class="cs-line hl-a"><span class="kw">for</span> kv_tile <span class="kw">in</span> tiles:</span>
<span class="cs-line hl-a">    n_queries = len(gather(kv_tile, reverse_idx))</span>
<span class="cs-line hl-a">    chunks = split(n_queries, chunk_size=2*k*B_k)</span>
<span class="cs-line hl-a">    <span class="kw">for</span> chunk, slot <span class="kw">in</span> zip(chunks, preallocated):</span>
<span class="cs-line hl-a">        O_buf[slot] = attn(chunk, kv_tile)</span>
<span class="cs-line cmt">    # No atomics — slot pre-assigned per chunk</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Kernel 4: Two-phase combine</span>
<span class="cs-line hl-g">LSE = max_s + log(Σ exp(LSE_s - max_s))</span>
<span class="cs-line hl-g">O = Σ_s exp(LSE_s - LSE) * O_buf[s]</span>
<span class="cs-line cmt"># LSE fused into main forward, no extra kernel</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-results">

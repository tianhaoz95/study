    <!-- puzzle -->
    <div class="cs-panel active" id="panel-puzzle">
      <pre class="cs-pre"><span class="cs-line cmt"># Why constraint puzzles expose LLM limits</span>
<span class="cs-line cmt"># ─────────────────────────────────────────</span>
<span class="cs-line cmt"># Sudoku: place 1-9 in each row, col, 3×3 box</span>
<span class="cs-line cmt"># → 81 cells, each constrained by 20 others</span>
<span class="cs-line cmt"># → unique solution exists</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Autoregressive LLM approach:</span>
<span class="cs-line hl-p"><span class="cmt"># predict token 1 → token 2 → ... → token 81</span></span>
<span class="cs-line hl-p"><span class="cmt"># by token 40, early errors are already "committed"</span></span>
<span class="cs-line hl-p"><span class="cmt"># → no way to revise cell 3 after seeing cell 80</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># TRM approach:</span>
<span class="cs-line hl-g"><span class="cmt"># all 81 cells represented simultaneously in y</span></span>
<span class="cs-line hl-g"><span class="cmt"># latent z holds "reasoning state"</span></span>
<span class="cs-line hl-g"><span class="cmt"># iteratively refine entire grid together</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># PPBench results (golden set, 300 puzzles):</span>
<span class="cs-line cmt">#   claude-opus-4    → 34.7%</span>
<span class="cs-line cmt">#   gpt-5.2@xhigh    → 24.5%</span>
<span class="cs-line cmt">#   LLM ensemble×7   → 55.1%  ← needs oracle!</span>
<span class="cs-line hl-g"><span class="cmt">#   TRM  (7M params) → 62.6%</span></span>
<span class="cs-line hl-g"><span class="cmt">#   PTRM (7M params) → 91.2%</span></span></pre>
    </div>

    <!-- trm -->
    <div class="cs-panel" id="panel-trm">
      <pre class="cs-pre"><span class="cs-line cmt"># Tiny Recursive Model: one network, two roles</span>
<span class="cs-line cmt"># ─────────────────────────────────────────────</span>
<span class="cs-line kw">def</span> <span class="fn">deep_recursion</span>(x, z, y, n=<span class="num">16</span>, T=<span class="num">1</span>):</span>
<span class="cs-line hl-c">    <span class="cmt"># One "deep recursion" = n latent + 1 answer</span></span>
<span class="cs-line">    <span class="kw">for</span> _ <span class="kw">in</span> range(T):</span>
<span class="cs-line">        <span class="kw">for</span> _ <span class="kw">in</span> range(n):</span>
<span class="cs-line hl-p">            z = f_theta(x + y + z) <span class="cmt"># latent update</span></span>
<span class="cs-line hl-g">        y = f_theta(y + z)        <span class="cmt"># answer update</span></span>
<span class="cs-line">    <span class="kw">return</span> z, y</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># f_theta sees x → "latent update" mode</span>
<span class="cs-line cmt"># f_theta without x → "answer update" mode</span>
<span class="cs-line cmt"># same 7M-param network for both!</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Q head: correctness classifier</span>
<span class="cs-line kw">def</span> <span class="fn">q_head</span>(y):</span>
<span class="cs-line hl-a">    q_logit = f_Q(y)  <span class="cmt"># linear layer</span></span>
<span class="cs-line hl-a">    <span class="cmt"># trained: BCE(sigmoid(q), correct(y))</span></span>
<span class="cs-line hl-a">    <span class="cmt"># at convergence: q≈+6 correct, q≈-6 wrong</span></span>
<span class="cs-line">    <span class="kw">return</span> q_logit</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Training: deep supervision</span>
<span class="cs-line cmt"># keep (z,y) as init for next step (detached)</span>
<span class="cs-line cmt"># loss = CE(f_O(y), y_true) + BCE(q_hat, correct)</span>
<span class="cs-line cmt"># ACT: stop if sigmoid(q) > 0.5 (already solved)</span></pre>
    </div>

    <!-- basins -->
    <div class="cs-panel" id="panel-basins">
      <pre class="cs-pre"><span class="cs-line cmt"># Latent basin analysis</span>
<span class="cs-line cmt"># ─────────────────────────────────────────────</span>
<span class="cs-line cmt"># Authors PCA-projected y across supervision</span>
<span class="cs-line cmt"># steps and found 3 trajectory modes:</span>
<span class="cs-line"></span>
<span class="cs-line hl-g"><span class="cmt"># QUICK SUCCESS</span></span>
<span class="cs-line hl-g"><span class="cmt"># few steps → good basin → stays there</span></span>
<span class="cs-line hl-g"><span class="cmt"># Q and accuracy both rise and saturate fast</span></span>
<span class="cs-line"></span>
<span class="cs-line hl-a"><span class="cmt"># DELAYED SUCCESS</span></span>
<span class="cs-line hl-a"><span class="cmt"># oscillates in bad basin (Q negative)...</span></span>
<span class="cs-line hl-a"><span class="cmt"># ...then escapes → Q and accuracy spike together</span></span>
<span class="cs-line"></span>
<span class="cs-line hl-p"><span class="cmt"># FAILURE</span></span>
<span class="cs-line hl-p"><span class="cmt"># oscillates in bad basin forever</span></span>
<span class="cs-line hl-p"><span class="cmt"># Q stays negative; accuracy never near 100%</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Key observation (Figure 3, 100 puzzles):</span>
<span class="cs-line cmt"># Q logit at convergence:</span>
<span class="cs-line hl-g"><span class="cmt">#   correct trajectories  → q ≈ +6</span></span>
<span class="cs-line hl-p"><span class="cmt">#   incorrect trajectories → q ≈ -6</span></span>
<span class="cs-line cmt"># Gap is large and consistent → Q = perfect verifier</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Problem: deterministic TRM can't change trajectory</span>
<span class="cs-line cmt"># It "knows" it's stuck but can't escape</span>
<span class="cs-line cmt"># Solution: inject noise → multiple trajectories</span></pre>
    </div>

    <!-- ptrm -->
    <div class="cs-panel" id="panel-ptrm">
      <pre class="cs-pre"><span class="cs-line cmt"># PTRM inference (the full algorithm)</span>
<span class="cs-line cmt"># ─────────────────────────────────────────────</span>
<span class="cs-line kw">def</span> <span class="fn">ptrm_inference</span>(x, K=<span class="num">100</span>, D=<span class="num">16</span>, sigma=<span class="num">0.2</span>):</span>
<span class="cs-line">    candidates = []</span>
<span class="cs-line"></span>
<span class="cs-line">    <span class="kw">for</span> k <span class="kw">in</span> range(K):  <span class="cmt"># K parallel rollouts</span></span>
<span class="cs-line">        z, y = zeros(), zeros()  <span class="cmt"># fresh init</span></span>
<span class="cs-line"></span>
<span class="cs-line">        <span class="kw">for</span> t <span class="kw">in</span> range(D):  <span class="cmt"># D deep recursions</span></span>
<span class="cs-line hl-c">            eps = randn_like(z) * sigma</span>
<span class="cs-line hl-c">            z = z + eps  <span class="cmt"># ← THE ONLY CHANGE</span></span>
<span class="cs-line">            z, y = deep_recursion(x, z, y)</span>
<span class="cs-line"></span>
<span class="cs-line hl-p">        q = q_head(y)  <span class="cmt"># score this rollout</span></span>
<span class="cs-line hl-p">        y_hat = argmax(f_O(y))</span>
<span class="cs-line hl-p">        candidates.append((q, y_hat))</span>
<span class="cs-line"></span>
<span class="cs-line hl-g">    <span class="cmt"># select rollout with highest Q score</span></span>
<span class="cs-line hl-g">    best = max(candidates, key=<span class="kw">lambda</span> c: c[<span class="num">0</span>])</span>
<span class="cs-line hl-g">    <span class="kw">return</span> best[<span class="num">1</span>]  <span class="cmt"># the answer</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Hyperparameters by benchmark:</span>
<span class="cs-line cmt">#   PPBench:        K=100, D=48, σ=0.2</span>
<span class="cs-line cmt">#   Sudoku-Extreme: K=100, D=64, σ=0.3</span>
<span class="cs-line cmt">#   Maze-Hard:      K=100, D=16, σ=1.0</span>
<span class="cs-line cmt">#   ARC-AGI-2:      K=25,  D=16, σ=0.2</span></pre>
    </div>

    <!-- scaling -->
    <div class="cs-panel" id="panel-scaling">
      <pre class="cs-pre"><span class="cs-line cmt"># Width vs Depth scaling comparison</span>
<span class="cs-line cmt"># ─────────────────────────────────────────────</span>
<span class="cs-line cmt"># DEPTH SCALING (sequential, slower)</span>
<span class="cs-line hl-p"><span class="cmt"># run more deep recursions than trained on</span></span>
<span class="cs-line hl-p"><span class="cmt"># K=1, D=16 → 76.4%   (baseline)</span></span>
<span class="cs-line hl-p"><span class="cmt"># K=1, D=48 → 79.5%   (+3.1pp)</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># WIDTH SCALING (parallel, faster)</span>
<span class="cs-line hl-g"><span class="cmt"># K=1   → 76.4%</span></span>
<span class="cs-line hl-g"><span class="cmt"># K=5   → 82.0%  (+5.6pp)</span></span>
<span class="cs-line hl-g"><span class="cmt"># K=25  → 85.0%  (+8.6pp)</span></span>
<span class="cs-line hl-g"><span class="cmt"># K=100 → 89.5%  (+13.1pp)</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Q head vs majority vote vs oracle:</span>
<span class="cs-line cmt"># At K=100:</span>
<span class="cs-line cmt">#   pass@K  (oracle)    = 89.5%  ← upper bound</span>
<span class="cs-line hl-c"><span class="cmt">#   best-Q@K (Q head)   = 88.7%  ← &lt;1pp gap!</span></span>
<span class="cs-line cmt">#   mode@K  (majority)  = 77.7%  ← barely moves</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Key: Q head closes almost all the gap to oracle</span>
<span class="cs-line cmt"># → no external verifier needed</span>
<span class="cs-line cmt"># → mode@K fails because correct answers are rare</span></pre>
    </div>

    <!-- results -->
    <div class="cs-panel" id="panel-results">
      <pre class="cs-pre"><span class="cs-line cmt"># Full results summary</span>
<span class="cs-line cmt"># ─────────────────────────────────────────────</span>
<span class="cs-line cmt"># PPBench golden set (5 puzzle types, 300 puzzles)</span>
<span class="cs-line cmt">#   Direct prediction (27M) → 0%  (can't do it)</span>
<span class="cs-line cmt">#   TRM K=1, D=16   →  62.6%</span>
<span class="cs-line cmt">#   TRM K=1, D=48   →  66.0%  (+3.4pp depth)</span>
<span class="cs-line cmt">#   PTRM K=100,D=16 →  89.8%  (+27.2pp width)</span>
<span class="cs-line hl-g"><span class="cmt">#   PTRM K=100,D=48 →  91.2%  (+28.6pp combined)</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># vs LLMs (PPBench golden set):</span>
<span class="cs-line cmt">#   gpt-5.2@xhigh (direct)     → 24.5%</span>
<span class="cs-line cmt">#   claude-opus-4 (direct)     → 34.7%</span>
<span class="cs-line cmt">#   LLM ensemble ×7 (oracle!)  → 55.1%</span>
<span class="cs-line hl-g"><span class="cmt">#   PTRM (no oracle, 7M params)→ 91.2%</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Other benchmarks:</span>
<span class="cs-line hl-c"><span class="cmt">#   Sudoku-Extreme: 87.4% → 98.75% (SOTA)</span></span>
<span class="cs-line hl-c"><span class="cmt">#   Maze-Hard:      83.8% → 86.7%  (+best-Q)</span></span>
<span class="cs-line hl-c"><span class="cmt">#   ARC-AGI-2:       7.4% →  8.5%  (+pass@1)</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Cost (H100 @ $2.50/hr):</span>
<span class="cs-line cmt">#   claude-opus-4   → $2.91/attempt</span>
<span class="cs-line hl-g"><span class="cmt">#   PTRM K=100      → $0.001/attempt (2900× cheaper)</span></span></pre>
    </div>

  </div>
</aside>

</div><!-- /post-grid -->

<script>
// ── TOC toggle ──────────────────────────────────────────────────────
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle = document.getElementById('toc-toggle');
const postGrid = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});

// ── Code sidebar toggle ─────────────────────────────────────────────
const codeSidebar = document.getElementById('code-sidebar');
const csToggle = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ── Code tabs ───────────────────────────────────────────────────────
const tabMeta = {
  puzzle: { file: 'ptrm/background.py', title: 'Why Puzzles?' },
  trm:    { file: 'ptrm/trm_model.py',  title: 'TRM Architecture' },
  basins: { file: 'ptrm/basin_analysis.py', title: 'Latent Basins' },
  ptrm:   { file: 'ptrm/inference.py',  title: 'PTRM Algorithm' },
  scaling:{ file: 'ptrm/scaling.py',    title: 'Width vs Depth' },
  results:{ file: 'ptrm/results.py',    title: 'Benchmark Results' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) { document.getElementById('cs-file-label').textContent = m.file; document.getElementById('cs-section-title').textContent = m.title; }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ── IntersectionObserver: TOC + sidebar sync ────────────────────────
const sectionMap = { 's-puzzle':'puzzle','s-trm':'trm','s-basins':'basins','s-ptrm':'ptrm','s-scaling':'scaling','s-results':'results' };
new IntersectionObserver(entries => {
  let best = null, bestR = 0;
  entries.forEach(e => { if (e.isIntersecting && e.intersectionRatio > bestR) { best = e.target; bestR = e.intersectionRatio; } });
  if (!best) return;
  document.querySelectorAll('.toc-item').forEach(li => li.classList.toggle('toc-active', li.id === 'toc-' + best.id));
  const p = sectionMap[best.id]; if (p) activateTab(p);
}, { threshold: [0.15, 0.4] }).observe && document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li => li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id]; if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ── TRM stepper ─────────────────────────────────────────────────────
let trmStep = 0;
const trmBoxes = document.querySelectorAll('.trm-step-box');
const trmPrev = document.getElementById('trm-prev');
const trmNext = document.getElementById('trm-next');
const trmProg = document.getElementById('trm-prog');
function updateTrm() {
  trmBoxes.forEach((b, i) => { b.classList.remove('active','done'); if (i===trmStep) b.classList.add('active'); else if (i<trmStep) b.classList.add('done'); });
  if (trmPrev) trmPrev.disabled = trmStep===0;
  if (trmNext) trmNext.disabled = trmStep===trmBoxes.length-1;
  if (trmProg) trmProg.textContent = `Step ${trmStep+1} of ${trmBoxes.length}`;
}
trmPrev?.addEventListener('click', () => { if (trmStep>0){trmStep--; updateTrm();} });
trmNext?.addEventListener('click', () => { if (trmStep<trmBoxes.length-1){trmStep++; updateTrm();} });
updateTrm();

// ── Basin canvas ─────────────────────────────────────────────────────
const basinCanvas = document.getElementById('basin-canvas');
if (basinCanvas) {
  const ctx = basinCanvas.getContext('2d');
  const W = basinCanvas.clientWidth, H = 260, DPR = window.devicePixelRatio || 1;
  basinCanvas.width = W * DPR; basinCanvas.height = H * DPR; ctx.scale(DPR, DPR);

  let currentMode = 'success';

  // Seeded random
  function seededRand(seed) { let s = seed; return () => { s=(s*1664525+1013904223)&0xffffffff; return (s>>>0)/0xffffffff; }; }

  function drawBasin(mode) {
    ctx.clearRect(0,0,W,H);

    // Background subtle grid
    ctx.strokeStyle='rgba(255,255,255,0.03)'; ctx.lineWidth=1;
    for(let gx=0;gx<=W;gx+=50){ctx.beginPath();ctx.moveTo(gx,0);ctx.lineTo(gx,H);ctx.stroke();}
    for(let gy=0;gy<=H;gy+=40){ctx.beginPath();ctx.moveTo(0,gy);ctx.lineTo(W,gy);ctx.stroke();}

    // Draw contour basins
    function drawContourBasin(cx, cy, rx, ry, color) {
      for (let r = 3; r >= 0; r--) {
        const alpha = 0.04 + r * 0.04;
        ctx.beginPath();
        ctx.ellipse(cx, cy, rx*(1+r*0.35), ry*(1+r*0.35), 0, 0, Math.PI*2);
        ctx.fillStyle = color.replace('1)', alpha + ')');
        ctx.fill();
      }
    }

    const bx = W*0.28, by = H*0.55; // bad basin
    const gx = W*0.68, gy = H*0.32; // good basin

    drawContourBasin(bx, by, 60, 45, 'rgba(239,68,68,1)');
    drawContourBasin(gx, gy, 55, 42, 'rgba(16,185,129,1)');

    ctx.font='9px monospace'; ctx.fillStyle='rgba(239,68,68,0.7)'; ctx.fillText('bad basin', bx-28, by+6);
    ctx.fillStyle='rgba(16,185,129,0.7)'; ctx.fillText('good basin', gx-30, gy+6);

    // Draw trajectory
    const rand = seededRand(mode === 'success' ? 42 : mode === 'delayed' ? 99 : 7);

    if (mode === 'success') {
      // Start far, move to good basin quickly
      const pts = [];
      pts.push({x: W*0.15, y: H*0.75});
      pts.push({x: W*0.28, y: H*0.62});
      pts.push({x: W*0.42, y: H*0.50});
      pts.push({x: W*0.55, y: H*0.40});
      pts.push({x: gx + (rand()-0.5)*20, y: gy + (rand()-0.5)*15});
      pts.push({x: gx + (rand()-0.5)*12, y: gy + (rand()-0.5)*10});
      pts.push({x: gx + (rand()-0.5)*8,  y: gy + (rand()-0.5)*8});
      pts.push({x: gx + (rand()-0.5)*6,  y: gy + (rand()-0.5)*6});
      drawPath(ctx, pts, '#98c379', W, H);
    } else if (mode === 'delayed') {
      // Oscillate in bad basin, then escape
      const pts = [];
      pts.push({x: W*0.15, y: H*0.6});
      // oscillating in bad basin
      for (let i=0; i<6; i++) {
        pts.push({x: bx + (rand()-0.5)*50, y: by + (rand()-0.5)*38});
      }
      // escape
      pts.push({x: W*0.46, y: H*0.44});
      pts.push({x: W*0.56, y: H*0.38});
      // settle in good basin
      for (let i=0; i<3; i++) {
        pts.push({x: gx + (rand()-0.5)*14, y: gy + (rand()-0.5)*12});
      }
      drawPath(ctx, pts, '#e5c07b', W, H);
    } else {
      // Failure: oscillates in bad basin forever
      const pts = [];
      pts.push({x: W*0.15, y: H*0.6});
      for (let i=0; i<12; i++) {
        pts.push({x: bx + (rand()-0.5)*65, y: by + (rand()-0.5)*50});
      }
      drawPath(ctx, pts, '#e06c75', W, H);
    }
  }

  function drawPath(ctx, pts, color, W, H) {
    // Draw fading trail
    for (let i = 1; i < pts.length; i++) {
      const alpha = 0.2 + (i / pts.length) * 0.8;
      ctx.beginPath();
      ctx.moveTo(pts[i-1].x, pts[i-1].y);
      ctx.lineTo(pts[i].x, pts[i].y);
      ctx.strokeStyle = color;
      ctx.globalAlpha = alpha;
      ctx.lineWidth = 1.5;
      ctx.stroke();
      ctx.globalAlpha = 1;
    }
    // Draw dots
    pts.forEach((p, i) => {
      const isFinal = i === pts.length-1;
      const alpha = 0.2 + (i / pts.length) * 0.8;
      ctx.beginPath(); ctx.arc(p.x, p.y, isFinal ? 6 : 3.5, 0, Math.PI*2);
      ctx.fillStyle = color; ctx.globalAlpha = alpha; ctx.fill(); ctx.globalAlpha=1;
    });
    // Labels
    ctx.font='9px monospace';
    ctx.fillStyle='rgba(255,255,255,0.5)';
    ctx.globalAlpha=0.6;
    ctx.fillText('START', pts[0].x+6, pts[0].y-4);
    ctx.fillText('END', pts[pts.length-1].x+6, pts[pts.length-1].y-4);
    ctx.globalAlpha=1;
  }

  drawBasin('success');

  document.getElementById('basin-success')?.addEventListener('click', () => { currentMode='success'; drawBasin('success'); document.querySelectorAll('.basin-btn').forEach(b=>b.classList.remove('active')); document.getElementById('basin-success').classList.add('active'); });
  document.getElementById('basin-delayed')?.addEventListener('click', () => { currentMode='delayed'; drawBasin('delayed'); document.querySelectorAll('.basin-btn').forEach(b=>b.classList.remove('active')); document.getElementById('basin-delayed').classList.add('active'); });
  document.getElementById('basin-fail')?.addEventListener('click', () => { currentMode='fail'; drawBasin('fail'); document.querySelectorAll('.basin-btn').forEach(b=>b.classList.remove('active')); document.getElementById('basin-fail').classList.add('active'); });
}

// ── PTRM rollout canvas ──────────────────────────────────────────────
const rollCanvas = document.getElementById('rollout-canvas');
if (rollCanvas) {
  const ctx = rollCanvas.getContext('2d');
  const W = rollCanvas.clientWidth, H = 240, DPR = window.devicePixelRatio||1;
  rollCanvas.width = W*DPR; rollCanvas.height = H*DPR; ctx.scale(DPR,DPR);

  let currentK = 5;

  function drawRollouts(K) {
    ctx.clearRect(0,0,W,H);
    ctx.strokeStyle='rgba(255,255,255,0.03)'; ctx.lineWidth=1;
    for(let gx=0;gx<=W;gx+=50){ctx.beginPath();ctx.moveTo(gx,0);ctx.lineTo(gx,H);ctx.stroke();}
    for(let gy=0;gy<=H;gy+=40){ctx.beginPath();ctx.moveTo(0,gy);ctx.lineTo(W,gy);ctx.stroke();}

    // Bad basin on left, good basin on right
    const bx=W*0.3, by=H*0.55, gx2=W*0.72, gy2=H*0.35;
    function drawCont(cx,cy,rx,ry,col){
      for(let r=3;r>=0;r--){
        ctx.beginPath(); ctx.ellipse(cx,cy,rx*(1+r*.3),ry*(1+r*.3),0,0,Math.PI*2);
        ctx.fillStyle=col.replace('1)',(.04+r*.04)+')'); ctx.fill();
      }
    }
    drawCont(bx,by,65,50,'rgba(239,68,68,1)');
    drawCont(gx2,gy2,58,44,'rgba(16,185,129,1)');
    ctx.font='9px monospace';
    ctx.fillStyle='rgba(239,68,68,0.6)'; ctx.fillText('bad basin',bx-28,by+6);
    ctx.fillStyle='rgba(16,185,129,0.6)'; ctx.fillText('good basin',gx2-30,gy2+6);

    // Escape probability: ~8% at K=100, scaled
    const escapeRate = K >= 100 ? 0.08 : K >= 25 ? 0.04 : K >= 5 ? 0.0 : 0.0;
    const nEscape = Math.round(K * escapeRate);
    const nStuck = K - nEscape;

    const startX = W*0.08, startY = H*0.5;

    function seededR(s){let r=s;return()=>{r=(r*1664525+1013904223)&0xffffffff;return(r>>>0)/0xffffffff;}}

    // Draw stuck rollouts
    for (let i=0; i<Math.min(nStuck, 30); i++) {
      const rand = seededR(i*17+3);
      const pts = [{x:startX,y:startY}];
      for(let s=0;s<6;s++){pts.push({x:bx+(rand()-.5)*70,y:by+(rand()-.5)*55});}
      ctx.beginPath(); ctx.moveTo(pts[0].x,pts[0].y);
      pts.slice(1).forEach(p=>ctx.lineTo(p.x,p.y));
      ctx.strokeStyle='rgba(239,68,68,0.25)'; ctx.lineWidth=0.8; ctx.stroke();
    }
    // Draw star for start
    ctx.beginPath(); ctx.arc(startX,startY,6,0,Math.PI*2);
    ctx.fillStyle='rgba(255,255,255,0.5)'; ctx.fill();
    ctx.font='9px monospace'; ctx.fillStyle='rgba(255,255,255,0.5)'; ctx.fillText('start',startX+7,startY+3);

    // Draw escaping rollouts
    for (let i=0; i<nEscape; i++) {
      const rand = seededR(i*31+99);
      const pts = [{x:startX,y:startY}];
      for(let s=0;s<3;s++){pts.push({x:bx+(rand()-.5)*55,y:by+(rand()-.5)*45});}
      pts.push({x:W*0.52+(rand()-.5)*15,y:H*0.42+(rand()-.5)*10});
      pts.push({x:gx2+(rand()-.5)*20,y:gy2+(rand()-.5)*18});
      pts.push({x:gx2+(rand()-.5)*12,y:gy2+(rand()-.5)*12});
      ctx.beginPath(); ctx.moveTo(pts[0].x,pts[0].y);
      pts.slice(1).forEach(p=>ctx.lineTo(p.x,p.y));
      ctx.strokeStyle='rgba(16,185,129,0.7)'; ctx.lineWidth=1.5; ctx.stroke();
      // star at end
      ctx.beginPath(); ctx.arc(pts[pts.length-1].x,pts[pts.length-1].y,5,0,Math.PI*2);
      ctx.fillStyle='#98c379'; ctx.fill();
    }

    // Stats label
    ctx.font='10px monospace';
    ctx.fillStyle='rgba(255,255,255,0.5)';
    ctx.fillText(`K=${K}: ${nEscape} escape (${Math.round(escapeRate*100)}%), ${nStuck} stuck`, W*0.02, 18);
    if (nEscape===0 && K===1) ctx.fillText('K=1: deterministic, always same path', W*0.02, 30);
  }

  drawRollouts(5);
  const kBtns = { 'roll-k1':1, 'roll-k5':5, 'roll-k25':25, 'roll-k100':100 };
  Object.entries(kBtns).forEach(([id, k]) => {
    document.getElementById(id)?.addEventListener('click', () => {
      currentK=k;
      document.querySelectorAll('.rollout-controls .basin-btn').forEach(b=>b.classList.remove('active'));
      document.getElementById(id)?.classList.add('active');
      document.getElementById('k-val').textContent=k;
      drawRollouts(k);
    });
  });
}

// ── Scaling chart ────────────────────────────────────────────────────
const scaleCanvas = document.getElementById('scale-canvas');
if (scaleCanvas) {
  const ctx = scaleCanvas.getContext('2d');
  const W = scaleCanvas.clientWidth, H = 200, DPR = window.devicePixelRatio||1;
  scaleCanvas.width = W*DPR; scaleCanvas.height = H*DPR; ctx.scale(DPR,DPR);

  const Kvals = [1, 5, 10, 25, 100];
  const passAtK  = [76.4, 82.0, 84.5, 86.8, 89.5];
  const bestQAtK = [76.4, 81.5, 84.0, 86.2, 88.7];
  const modeAtK  = [76.4, 76.9, 77.1, 77.4, 77.7];

  const pad = {l:44,r:16,t:16,b:36};
  const cw = W-pad.l-pad.r, ch = H-pad.t-pad.b;
  const yMin=74, yMax=92;

  function toX(i){ return pad.l + (Math.log(Kvals[i])/Math.log(100)) * cw; }
  function toY(v){ return pad.t + ch*(1-(v-yMin)/(yMax-yMin)); }

  // Grid
  ctx.strokeStyle='rgba(255,255,255,0.05)'; ctx.lineWidth=1;
  for(let v=75;v<=91;v+=5){
    const y=toY(v);
    ctx.beginPath(); ctx.moveTo(pad.l,y); ctx.lineTo(pad.l+cw,y); ctx.stroke();
    ctx.font='9px monospace'; ctx.fillStyle='rgba(255,255,255,0.3)';
    ctx.fillText(v+'%',2,y+3);
  }
  // X axis labels
  ctx.font='9px monospace'; ctx.fillStyle='rgba(255,255,255,0.35)';
  Kvals.forEach((k,i) => ctx.fillText('K='+k, toX(i)-8, H-pad.b+14));

  function drawLine(vals, color, lw=1.5) {
    ctx.beginPath();
    vals.forEach((v,i) => i===0 ? ctx.moveTo(toX(i),toY(v)) : ctx.lineTo(toX(i),toY(v)));
    ctx.strokeStyle=color; ctx.lineWidth=lw; ctx.stroke();
    vals.forEach((v,i) => {
      ctx.beginPath(); ctx.arc(toX(i),toY(v),3,0,Math.PI*2);
      ctx.fillStyle=color; ctx.fill();
    });
  }
  drawLine(modeAtK, 'rgba(92,99,112,0.6)');
  drawLine(bestQAtK, '#61afef', 2);
  drawLine(passAtK, '#c678dd', 2);

  // Label at K=100
  ctx.font='9px monospace';
  ctx.fillStyle='#c678dd'; ctx.fillText('89.5%', toX(4)+5, toY(passAtK[4])-2);
  ctx.fillStyle='#61afef'; ctx.fillText('88.7%', toX(4)+5, toY(bestQAtK[4])+12);
  ctx.fillStyle='rgba(92,99,112,0.8)'; ctx.fillText('77.7%', toX(4)+5, toY(modeAtK[4])+12);
}

// ── Results bars animation ───────────────────────────────────────────
const bars = document.querySelectorAll('.bar-fill[data-w]');
const io = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if (e.isIntersecting) {
      bars.forEach(b => { b.style.width = (parseFloat(b.dataset.w)/100*100)+'%'; });
      io.disconnect();
    }
  });
}, { threshold: 0.3 });
const barsSection = document.getElementById('s-results');
if (barsSection) io.observe(barsSection);
</script>
</BaseLayout>

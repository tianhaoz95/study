// Code sidebar tab switching
const tabMeta = {
  setup:   { file: 'opd/setup.py',   title: 'The Setup' },
  prefix:  { file: 'opd/prefix.py',  title: 'Prefix Mismatch' },
  topk:    { file: 'opd/topk.py',    title: 'TopK Gradient Trap' },

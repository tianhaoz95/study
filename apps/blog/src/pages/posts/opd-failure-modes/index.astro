    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// IntersectionObserver for TOC + sidebar sync
const sectionMap = {
  's-setup':  'setup',
  's-prefix': 'prefix',
  's-topk':   'topk',
  's-opsd':   'opsd',
  's-fixes':  'fixes',
  's-results':'results',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ─── CANVAS 1: Prefix mismatch ───────────────────────────────────────────────
(function() {
  const canvas = document.getElementById('prefix-canvas');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 260;
  canvas.width = W * DPR; canvas.height = H * DPR;
  const ctx = canvas.getContext('2d');
  ctx.scale(DPR, DPR);

  const purple = '#8b5cf6', cyan = '#06b6d4', green = '#10b981', red = '#ef4444', amber = '#f59e0b';
  const muted = '#6b7280', text2 = '#d1d5db', border = '#374151';

  function drawPanel(x, y, w, h, label, color, isGood) {
    ctx.fillStyle = isGood ? 'rgba(16,185,129,.07)' : 'rgba(239,68,68,.07)';
    ctx.strokeStyle = isGood ? 'rgba(16,185,129,.4)' : 'rgba(239,68,68,.3)';
    ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.roundRect(x, y, w, h, 8); ctx.fill(); ctx.stroke();
    ctx.font = `600 10px var(--ff-mono, monospace)`;
    ctx.fillStyle = isGood ? green : red;
    ctx.fillText(label, x + 12, y + 18);
  }

  function drawBox(x, y, w, h, txt, subtxt, col) {
    ctx.fillStyle = col + '22';
    ctx.strokeStyle = col + '88';
    ctx.lineWidth = 1.2;
    ctx.beginPath(); ctx.roundRect(x, y, w, h, 6); ctx.fill(); ctx.stroke();
    ctx.font = `600 9px var(--ff-mono, monospace)`;
    ctx.fillStyle = col; ctx.textAlign = 'center';
    ctx.fillText(txt, x + w/2, y + h/2 - 3);
    if (subtxt) {
      ctx.font = `9px var(--ff-mono, monospace)`; ctx.fillStyle = muted;
      ctx.fillText(subtxt, x + w/2, y + h/2 + 9);
    }
    ctx.textAlign = 'left';
  }

  function arrow(x1, y1, x2, y2, col) {
    ctx.strokeStyle = col; ctx.lineWidth = 1.2;
    ctx.beginPath(); ctx.moveTo(x1, y1); ctx.lineTo(x2, y2); ctx.stroke();
    const a = Math.atan2(y2 - y1, x2 - x1);
    ctx.fillStyle = col;
    ctx.beginPath();
    ctx.moveTo(x2, y2);
    ctx.lineTo(x2 - 7*Math.cos(a-0.4), y2 - 7*Math.sin(a-0.4));
    ctx.lineTo(x2 - 7*Math.cos(a+0.4), y2 - 7*Math.sin(a+0.4));
    ctx.closePath(); ctx.fill();
  }

  const half = W / 2 - 10;

  // Left panel: Teacher standalone
  drawPanel(10, 10, half - 10, H - 20, 'TEACHER STANDALONE', green, true);
  drawBox(30, 32, 100, 36, 'Teacher alone', 'Qwen3-14B', cyan);
  // Problem text
  ctx.font = '8px var(--ff-mono, monospace)'; ctx.fillStyle = muted;
  ctx.fillText('"If x² - 4 = 0, then x = ?"', 30, 84);
  // Arrow down to tokens
  arrow(80, 68, 80, 100, muted + '88');
  // Top tokens - high confidence
  const tokensGood = [['therefore', green, 0.72], ['thus', green, 0.12], ['so', green, 0.09]];
  tokensGood.forEach(([tok, col, _], i) => {
    ctx.fillStyle = col + '22'; ctx.strokeStyle = col + '66'; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.roundRect(30 + i*68, 104, 60, 22, 4); ctx.fill(); ctx.stroke();
    ctx.font = `600 9px var(--ff-mono, monospace)`; ctx.fillStyle = col; ctx.textAlign = 'center';
    ctx.fillText(tok, 30 + i*68 + 30, 118);
    ctx.textAlign = 'left';
  });
  ctx.font = '8px var(--ff-mono, monospace)'; ctx.fillStyle = muted;
  ctx.fillText('Top tokens: confident continuations', 30, 143);
  // Accuracy badge
  ctx.fillStyle = 'rgba(16,185,129,.15)'; ctx.strokeStyle = 'rgba(16,185,129,.4)'; ctx.lineWidth = 1.2;
  ctx.beginPath(); ctx.roundRect(30, 155, 120, 28, 6); ctx.fill(); ctx.stroke();
  ctx.font = `700 16px var(--ff-mono, monospace)`; ctx.fillStyle = green; ctx.textAlign = 'center';
  ctx.fillText('62.1%', 90, 172); ctx.textAlign = 'left';
  ctx.font = '8px var(--ff-mono, monospace)'; ctx.fillStyle = muted;
  ctx.fillText('GPQA-Diamond accuracy', 30, 197);

  // Right panel: Teacher on student prefix
  const rx = W/2 + 10;
  drawPanel(rx, 10, half - 10, H - 20, 'TEACHER ON STUDENT PREFIX', red, false);
  drawBox(rx + 10, 32, 90, 28, 'Student prefix', '"answer is 7"', amber);
  arrow(rx + 10 + 45, 60, rx + 10 + 45, 78, muted + '88');
  drawBox(rx + 10, 78, 90, 28, 'Teacher forced', 'to continue...', red);
  // Arrow to confused tokens
  arrow(rx + 55, 106, rx + 55, 118, muted + '88');
  const tokensBad = [['wait', red, 0.38], ['but', red, 0.24], ['hmm', amber, 0.15]];
  tokensBad.forEach(([tok, col, _], i) => {
    ctx.fillStyle = col + '22'; ctx.strokeStyle = col + '55'; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.roundRect(rx + 10 + i*62, 122, 54, 22, 4); ctx.fill(); ctx.stroke();
    ctx.font = `600 9px var(--ff-mono, monospace)`; ctx.fillStyle = col; ctx.textAlign = 'center';
    ctx.fillText(tok, rx + 10 + i*62 + 27, 136);
    ctx.textAlign = 'left';
  });
  ctx.font = '8px var(--ff-mono, monospace)'; ctx.fillStyle = muted;
  ctx.fillText('Top tokens: revision signals', rx + 10, 160);
  // Accuracy badge
  ctx.fillStyle = 'rgba(239,68,68,.12)'; ctx.strokeStyle = 'rgba(239,68,68,.35)'; ctx.lineWidth = 1.2;
  ctx.beginPath(); ctx.roundRect(rx + 10, 170, 120, 28, 6); ctx.fill(); ctx.stroke();
  ctx.font = `700 16px var(--ff-mono, monospace)`; ctx.fillStyle = red; ctx.textAlign = 'center';
  ctx.fillText('46.0%', rx + 70, 187); ctx.textAlign = 'left';
  ctx.font = '8px var(--ff-mono, monospace)'; ctx.fillStyle = muted;
  ctx.fillText('−16pp from prefix conditioning', rx + 10, 213);
})();

// ─── CANVAS 2: TopK training stability ───────────────────────────────────────
(function() {
  const canvas = document.getElementById('topk-canvas');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 260;
  canvas.width = W * DPR; canvas.height = H * DPR;
  const ctx = canvas.getContext('2d');
  ctx.scale(DPR, DPR);

  const purple = '#8b5cf6', cyan = '#06b6d4', green = '#10b981', red = '#ef4444', amber = '#f59e0b';
  const muted = '#6b7280', muted2 = '#9ca3af', text2 = '#d1d5db';

  const PAD = { l:48, r:20, t:28, b:44 };
  const cW = W - PAD.l - PAD.r, cH = H - PAD.t - PAD.b;

  // Seeded simple RNG
  function seededRand(seed) {
    let s = seed;
    return () => { s = (s * 1664525 + 1013904223) & 0xffffffff; return (s >>> 0) / 0xffffffff; };
  }

  // Generate training curves for 3 methods
  // Steps 0..2000
  const STEPS = 2000;
  function genCurve(mode) {
    const r = seededRand(mode === 'unnorm' ? 42 : mode === 'sg' ? 137 : 99);
    const pts = [];
    for (let i = 0; i <= 40; i++) {
      const t = i / 40;
      const step = t * STEPS;
      let acc;
      if (mode === 'unnorm') {
        // rises then collapses dramatically
        if (step < 700) {
          acc = 0.52 + 0.20 * (step / 700) + (r() - 0.5) * 0.02;
        } else if (step < 1000) {
          acc = 0.72 - 0.55 * ((step - 700) / 300) + (r() - 0.5) * 0.03;
        } else {
          acc = 0.17 - 0.14 * ((step - 1000) / 1000) + (r() - 0.5) * 0.015;
        }
      } else if (mode === 'sg') {
        acc = 0.52 + 0.31 * Math.min(1, step / 1200) + (r() - 0.5) * 0.018;
      } else {
        acc = 0.52 + 0.28 * Math.min(1, step / 1200) + (r() - 0.5) * 0.02;
      }
      pts.push({ step, acc: Math.max(0.02, Math.min(0.95, acc)) });
    }
    return pts;
  }

  const curves = {
    unnorm: genCurve('unnorm'),
    sg: genCurve('sg'),
    renorm: genCurve('renorm'),
  };

  let activeMode = 'unnorm';

  const descs = {
    unnorm: 'Unnormalized TopK: biased +1 gradient term causes length explosion → repetition → collapse at ~step 1000. Repeat ratio → 1.0, accuracy → ~0.',
    sg: 'Stop-gradient TopK: stops differentiating through the log πθ weighting term. Gradient becomes unbiased policy-gradient form. Training stable throughout.',
    renorm: 'Renormalized TopK: normalize both πθ and πT within the selected K tokens before computing KL. The +1 term cancels because distributions sum to 1. Stable.',
  };

  function drawCurve() {
    ctx.clearRect(0, 0, W, H);

    // Grid
    ctx.strokeStyle = 'rgba(255,255,255,.04)'; ctx.lineWidth = 1;
    for (let i = 0; i <= 4; i++) {
      const y = PAD.t + cH - (i/4)*cH;
      ctx.beginPath(); ctx.moveTo(PAD.l, y); ctx.lineTo(PAD.l + cW, y); ctx.stroke();
    }
    for (let i = 0; i <= 4; i++) {
      const x = PAD.l + (i/4)*cW;
      ctx.beginPath(); ctx.moveTo(x, PAD.t); ctx.lineTo(x, PAD.t + cH); ctx.stroke();
    }

    // Axes
    ctx.strokeStyle = '#374151'; ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.moveTo(PAD.l, PAD.t); ctx.lineTo(PAD.l, PAD.t + cH); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(PAD.l, PAD.t + cH); ctx.lineTo(PAD.l + cW, PAD.t + cH); ctx.stroke();

    // Axis labels
    ctx.font = '9px var(--ff-mono, monospace)'; ctx.fillStyle = muted; ctx.textAlign = 'center';
    ctx.fillText('training step', PAD.l + cW/2, H - 4);
    ctx.save(); ctx.translate(12, PAD.t + cH/2); ctx.rotate(-Math.PI/2);
    ctx.fillText('Math500 acc', 0, 0); ctx.restore();

    // Step labels
    ctx.textAlign = 'center'; ctx.fillStyle = muted; ctx.font = '9px var(--ff-mono, monospace)';
    [0, 500, 1000, 1500, 2000].forEach(s => {
      const x = PAD.l + (s/STEPS)*cW;
      ctx.fillText(String(s), x, PAD.t + cH + 14);
    });
    // Y labels
    ctx.textAlign = 'right'; [0, 0.25, 0.5, 0.75].forEach((v, i) => {
      const y = PAD.t + cH - v * cH;
      ctx.fillText(v.toFixed(2), PAD.l - 6, y + 3);
    });
    ctx.textAlign = 'left';

    // Faded background curves
    const allModes = ['unnorm', 'sg', 'renorm'];
    const colors = { unnorm: red, sg: purple, renorm: cyan };
    allModes.forEach(m => {
      if (m === activeMode) return;
      const pts = curves[m];
      ctx.strokeStyle = colors[m] + '33'; ctx.lineWidth = 1.5; ctx.setLineDash([4,4]);
      ctx.beginPath();
      pts.forEach((p, i) => {
        const x = PAD.l + (p.step/STEPS)*cW;
        const y = PAD.t + cH - p.acc*cH;
        i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
      });
      ctx.stroke(); ctx.setLineDash([]);
    });

    // Active curve
    const pts = curves[activeMode];
    const col = colors[activeMode];
    ctx.strokeStyle = col; ctx.lineWidth = 2.5; ctx.shadowColor = col; ctx.shadowBlur = 8;
    ctx.beginPath();
    pts.forEach((p, i) => {
      const x = PAD.l + (p.step/STEPS)*cW;
      const y = PAD.t + cH - p.acc*cH;
      i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
    });
    ctx.stroke(); ctx.shadowBlur = 0;

    // Collapse annotation for unnorm
    if (activeMode === 'unnorm') {
      const cx = PAD.l + (1000/STEPS)*cW;
      ctx.strokeStyle = 'rgba(239,68,68,.5)'; ctx.lineWidth = 1; ctx.setLineDash([3,3]);
      ctx.beginPath(); ctx.moveTo(cx, PAD.t); ctx.lineTo(cx, PAD.t + cH); ctx.stroke();
      ctx.setLineDash([]);
      ctx.fillStyle = 'rgba(239,68,68,.15)'; ctx.strokeStyle = 'rgba(239,68,68,.4)'; ctx.lineWidth = 1;
      ctx.beginPath(); ctx.roundRect(cx - 50, PAD.t + 4, 70, 18, 4); ctx.fill(); ctx.stroke();
      ctx.font = '600 8px var(--ff-mono, monospace)'; ctx.fillStyle = red; ctx.textAlign = 'center';
      ctx.fillText('COLLAPSE', cx - 15, PAD.t + 15); ctx.textAlign = 'left';
    }

    // Final accuracy labels
    const last = curves[activeMode][curves[activeMode].length - 1];
    const lx = PAD.l + (last.step/STEPS)*cW + 4;
    const ly = PAD.t + cH - last.acc * cH;
    ctx.font = '600 9px var(--ff-mono, monospace)'; ctx.fillStyle = col;
    ctx.fillText(last.acc.toFixed(2), lx, ly + 3);

    // Title
    ctx.font = '600 10px var(--ff-mono, monospace)'; ctx.fillStyle = col; ctx.textAlign = 'center';
    ctx.fillText(activeMode === 'unnorm' ? 'Unnormalized TopK' : activeMode === 'sg' ? 'Stop-Gradient TopK' : 'Renormalized TopK', W/2, PAD.t - 8);
    ctx.textAlign = 'left';

    document.getElementById('topk-desc').textContent = descs[activeMode];
  }

  drawCurve();

  document.getElementById('btn-unnorm').addEventListener('click', () => {
    activeMode = 'unnorm';
    document.querySelectorAll('.opd-toggle-row .opd-btn').forEach(b => b.classList.remove('active'));
    document.getElementById('btn-unnorm').classList.add('active');
    drawCurve();
  });
  document.getElementById('btn-stopgrad').addEventListener('click', () => {
    activeMode = 'sg';
    document.querySelectorAll('.opd-toggle-row .opd-btn').forEach(b => b.classList.remove('active'));
    document.getElementById('btn-stopgrad').classList.add('active');
    drawCurve();
  });
  document.getElementById('btn-renorm').addEventListener('click', () => {
    activeMode = 'renorm';
    document.querySelectorAll('.opd-toggle-row .opd-btn').forEach(b => b.classList.remove('active'));
    document.getElementById('btn-renorm').classList.add('active');
    drawCurve();
  });
})();

// ─── CANVAS 3: OPSD PI aggregation ───────────────────────────────────────────
(function() {
  const canvas = document.getElementById('pi-canvas');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 280;
  canvas.width = W * DPR; canvas.height = H * DPR;
  const ctx = canvas.getContext('2d');
  ctx.scale(DPR, DPR);

  const purple = '#8b5cf6', cyan = '#06b6d4', green = '#10b981', red = '#ef4444', amber = '#f59e0b';
  const muted = '#6b7280';

  function seededRand(seed) {
    let s = seed;
    return () => { s = (s * 1664525 + 1013904223) & 0xffffffff; return (s >>> 0) / 0xffffffff; };
  }

  let mode = 'instance';

  function drawPI() {
    ctx.clearRect(0, 0, W, H);
    const cx = W / 2, cy = H / 2 - 10;

    if (mode === 'instance') {
      // Instance-specific PI: teachers point in random directions
      // Center = student (confused)
      const r = seededRand(77);
      const teacherDirs = [0.4, 1.1, 1.9, 2.8, 3.6, 4.5];
      const teacherLabels = [
        'I₁: "x = 7"', 'I₂: "x = 3"', 'I₃: "x = -2"',
        'I₄: "x = 11"', 'I₅: "x = 0"', 'I₆: "x = 5"'
      ];
      const arrowLen = 90;

      // Draw "policy space" blob
      ctx.fillStyle = 'rgba(100,100,120,.07)'; ctx.strokeStyle = '#374151'; ctx.lineWidth = 1;
      ctx.beginPath(); ctx.ellipse(cx, cy, 130, 110, 0, 0, Math.PI*2); ctx.fill(); ctx.stroke();

      // Title
      ctx.font = '600 10px var(--ff-mono, monospace)'; ctx.fillStyle = red; ctx.textAlign = 'center';
      ctx.fillText('INSTANCE-SPECIFIC PI — student averages to noise', W/2, 18);
      ctx.textAlign = 'left';

      // Teacher arrows
      teacherDirs.forEach((angle, i) => {
        const ex = cx + arrowLen * Math.cos(angle);
        const ey = cy + arrowLen * Math.sin(angle);
        ctx.strokeStyle = cyan + 'aa'; ctx.lineWidth = 1.8;
        ctx.setLineDash([]);
        ctx.beginPath(); ctx.moveTo(cx, cy); ctx.lineTo(ex, ey); ctx.stroke();
        // Arrowhead
        const a = angle;
        ctx.fillStyle = cyan + '99';
        ctx.beginPath();
        ctx.moveTo(ex, ey);
        ctx.lineTo(ex - 8*Math.cos(a-0.4), ey - 8*Math.sin(a-0.4));
        ctx.lineTo(ex - 8*Math.cos(a+0.4), ey - 8*Math.sin(a+0.4));
        ctx.closePath(); ctx.fill();
        // Label
        ctx.font = '8px var(--ff-mono, monospace)'; ctx.fillStyle = muted; ctx.textAlign = 'center';
        const lx = cx + (arrowLen+22)*Math.cos(angle);
        const ly = cy + (arrowLen+22)*Math.sin(angle);
        ctx.fillText(teacherLabels[i], lx, ly + 3);
        ctx.textAlign = 'left';
      });

      // Student at center — confused
      ctx.fillStyle = 'rgba(239,68,68,.2)'; ctx.strokeStyle = red; ctx.lineWidth = 2;
      ctx.beginPath(); ctx.arc(cx, cy, 14, 0, Math.PI*2); ctx.fill(); ctx.stroke();
      ctx.font = '600 9px var(--ff-mono, monospace)'; ctx.fillStyle = red; ctx.textAlign = 'center';
      ctx.fillText('student', cx, cy - 20);
      ctx.font = '8px var(--ff-mono, monospace)'; ctx.fillStyle = muted;
      ctx.fillText('averages all', cx, cy + 26);
      ctx.fillText('→ learns nothing useful', cx, cy + 37);
      ctx.textAlign = 'left';

      // Bottom note
      ctx.font = '9px var(--ff-mono, monospace)'; ctx.fillStyle = muted; ctx.textAlign = 'center';
      ctx.fillText('Each problem needs a different answer — the student can\'t generalize', W/2, H - 12);
      ctx.textAlign = 'left';

    } else {
      // Shared PI: all teachers consistently shift in same direction
      const shiftAngle = -0.5; // upper-right
      const baseR = seededRand(42);

      // Background policy space
      ctx.fillStyle = 'rgba(100,100,120,.07)'; ctx.strokeStyle = '#374151'; ctx.lineWidth = 1;
      ctx.beginPath(); ctx.ellipse(cx, cy, 130, 110, 0, 0, Math.PI*2); ctx.fill(); ctx.stroke();

      // Title
      ctx.font = '600 10px var(--ff-mono, monospace)'; ctx.fillStyle = green; ctx.textAlign = 'center';
      ctx.fillText('SHARED-RULE PI — student learns the consistent shift', W/2, 18);
      ctx.textAlign = 'left';

      // Several teachers all pointing in same direction (with small variations)
      const examples = [
        { startX: cx - 50, startY: cy + 30, label: 'x₁: math problem' },
        { startX: cx + 40, startY: cy + 20, label: 'x₂: code task' },
        { startX: cx - 30, startY: cy - 40, label: 'x₃: writing task' },
        { startX: cx + 20, startY: cy - 25, label: 'x₄: Q&A task' },
      ];

      examples.forEach(({ startX, startY, label }, i) => {
        const jitter = (baseR() - 0.5) * 0.2;
        const angle = shiftAngle + jitter;
        const arrowLen = 65;
        const ex = startX + arrowLen * Math.cos(angle);
        const ey = startY + arrowLen * Math.sin(angle);

        // Small dot for "before PI"
        ctx.fillStyle = cyan + '55'; ctx.strokeStyle = cyan + '88'; ctx.lineWidth = 1.2;
        ctx.beginPath(); ctx.arc(startX, startY, 6, 0, Math.PI*2); ctx.fill(); ctx.stroke();
        ctx.font = '7px var(--ff-mono, monospace)'; ctx.fillStyle = muted; ctx.textAlign = 'center';
        ctx.fillText(label, startX, startY + 15);
        ctx.textAlign = 'left';

        ctx.strokeStyle = green + 'bb'; ctx.lineWidth = 1.8;
        ctx.beginPath(); ctx.moveTo(startX, startY); ctx.lineTo(ex, ey); ctx.stroke();
        const a = angle;
        ctx.fillStyle = green + 'aa';
        ctx.beginPath(); ctx.moveTo(ex, ey);
        ctx.lineTo(ex - 8*Math.cos(a-0.4), ey - 8*Math.sin(a-0.4));
        ctx.lineTo(ex - 8*Math.cos(a+0.4), ey - 8*Math.sin(a+0.4));
        ctx.closePath(); ctx.fill();

        // "After PI" dot
        ctx.fillStyle = green + '44'; ctx.strokeStyle = green; ctx.lineWidth = 1.5;
        ctx.beginPath(); ctx.arc(ex, ey, 7, 0, Math.PI*2); ctx.fill(); ctx.stroke();
      });

      // "Consistent shift" label
      ctx.font = '9px var(--ff-mono, monospace)'; ctx.fillStyle = green; ctx.textAlign = 'center';
      ctx.fillText('"be concise" → all teachers shift the same way', W/2, H - 30);
      ctx.fillText('student learns the consistent shift, no PI needed at test time ✓', W/2, H - 15);
      ctx.textAlign = 'left';
    }
  }

  drawPI();

  document.getElementById('btn-pi-instance').addEventListener('click', () => {
    mode = 'instance';
    document.getElementById('btn-pi-instance').classList.add('active');
    document.getElementById('btn-pi-shared').classList.remove('active');
    drawPI();
  });
  document.getElementById('btn-pi-shared').addEventListener('click', () => {
    mode = 'shared';
    document.getElementById('btn-pi-shared').classList.add('active');
    document.getElementById('btn-pi-instance').classList.remove('active');
    drawPI();
  });
})();

// ─── Animated bar charts ──────────────────────────────────────────────────────
function animateBars(sectionId) {
  const section = document.getElementById(sectionId);
  if (!section) return;
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        section.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          b.style.width = b.dataset.w + '%';
        });
      }
    });
  }, { threshold: 0.3 }).observe(section);
}
animateBars('s-fixes');
animateBars('s-results');
</script>
</BaseLayout>

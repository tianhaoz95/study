<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">topk_sg</span>(ps, pt, K):</span>
<span class="cs-line hl-p">    sk = topk_indices(ps, K)</span>
<span class="cs-line hl-p">    ps_k, pt_k = ps[sk], pt[sk]</span>
<span class="cs-line hl-p">    <span class="cmt"># stop grad through log ps in the weight</span></span>
<span class="cs-line hl-p">    adv = pt_k.log() - ps_k.detach().log()</span>
<span class="cs-line hl-p">    <span class="kw">return</span> -(ps_k * adv).sum()</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Renormalized fix (also works)</span>
<span class="cs-line hl-a"><span class="kw">def</span> <span class="fn">topk_renorm</span>(ps, pt, K):</span>
<span class="cs-line hl-a">    sk = topk_indices(ps, K)</span>
<span class="cs-line hl-a">    ps_k = ps[sk] / ps[sk].sum()  <span class="cmt"># renorm</span></span>
<span class="cs-line hl-a">    pt_k = pt[sk] / pt[sk].sum()  <span class="cmt"># renorm</span></span>
<span class="cs-line hl-a">    <span class="kw">return</span> (ps_k*(ps_k.log()-pt_k.log())).sum()</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-opsd">
      <pre class="cs-pre">
<span class="cs-line cmt"># OPSD optimal student policy (theory)</span>
<span class="cs-line cmt"># The student minimizes:</span>
<span class="cs-line cmt">#   E_&#123;x,I&#125; [ KL(p_S(·|x) ∥ p_T(·|x,I)) ]</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># The optimal PI-free student is:</span>
<span class="cs-line hl-p">p_S_star(y|x) ∝ exp( E_I[log p_T(y|x,I)] )</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># = normalized geometric mean of</span>
<span class="cs-line cmt"># PI-conditioned teacher distributions.</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># INSTANCE-SPECIFIC PI (math answers):</span>
<span class="cs-line hl-c">I_1 = "answer is 7"   <span class="cmt"># → p_T points at 7</span></span>
<span class="cs-line hl-c">I_2 = "answer is 3"   <span class="cmt"># → p_T points at 3</span></span>
<span class="cs-line hl-c">I_3 = "answer is -2"  <span class="cmt"># → p_T points at -2</span></span>
<span class="cs-line hl-c"><span class="cmt"># geometric mean → spreads mass everywhere</span></span>
<span class="cs-line hl-c"><span class="cmt"># student learns: "emit plausible-sounding</span></span>
<span class="cs-line hl-c"><span class="cmt"># math" but not the right answer</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># SHARED-RULE PI (system prompt "be concise"):</span>
<span class="cs-line hl-g">I = "respond concisely"  <span class="cmt"># same for all x</span></span>
<span class="cs-line hl-g"><span class="cmt"># p_T(·|x,I) consistently shifts distribution</span></span>
<span class="cs-line hl-g"><span class="cmt"># geometric mean = same consistent shift</span></span>
<span class="cs-line hl-g"><span class="cmt"># student learns to be concise by default ✓</span></span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-fixes">
      <pre class="cs-pre">
<span class="cs-line cmt"># Fix 1: Stop-gradient TopK (see topk tab)</span>
<span class="cs-line cmt">#   Use topk_sg() or topk_renorm() instead of</span>
<span class="cs-line cmt">#   unnormalized topk_rkl_bad().</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Fix 2: RLVR-adapt the teacher first</span>
<span class="cs-line hl-p"><span class="cmt"># Train small teacher on same task via GRPO</span></span>
<span class="cs-line hl-p">teacher_grpo = train_grpo(student_1_7b, dataset)</span>
<span class="cs-line hl-p"><span class="cmt"># Now use it to supervise another 1.7B student</span></span>
<span class="cs-line hl-p">opd(student_1_7b, teacher=teacher_grpo)  <span class="cmt"># ✓</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># vs. naive large teacher:</span>
<span class="cs-line hl-c">opd(student_1_7b, teacher=model_8b)  <span class="cmt"># weaker!</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Why: 1.7B-GRPO top-20 vocab overlap with</span>
<span class="cs-line cmt"># student ≈ 0.95 vs 8B overlap ≈ 0.60</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Fix 3: SFT before OPD (base models)</span>
<span class="cs-line hl-g"><span class="cmt"># Step 1: teacher-trace SFT for format stability</span></span>
<span class="cs-line hl-g">sft_student = sft(base_student, teacher_traces)</span>
<span class="cs-line hl-g"><span class="cmt"># Step 2: OPD on SFT-initialized student</span></span>
<span class="cs-line hl-g">opd(sft_student, teacher)  <span class="cmt"># stable ✓</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Direct OPD on base student fails because</span>
<span class="cs-line cmt"># on-policy samples can be garbled unicode.</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-results">
      <pre class="cs-pre">
<span class="cs-line cmt"># OPSD vs RL on alignment (Qwen3-4B-Instruct)</span>
<span class="cs-line cmt"># same number of model generations</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># CharacterBench (character alignment)</span>
<span class="cs-line hl-c">PPO:   <span class="num">0.850</span></span>
<span class="cs-line hl-c">GRPO:  <span class="num">0.875</span></span>
<span class="cs-line hl-p">OPSD:  <span class="num">0.925</span>  <span class="cmt"># +5pp over GRPO</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># EmotionBench (emotional alignment)</span>
<span class="cs-line hl-c">PPO:   <span class="num">0.80</span></span>
<span class="cs-line hl-c">GRPO:  <span class="num">0.84</span></span>
<span class="cs-line hl-p">OPSD:  <span class="num">0.88</span>  <span class="cmt"># +4pp over GRPO</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Why OPSD wins: dense token-level supervision</span>
<span class="cs-line cmt"># vs scalar reward at end of trajectory.</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Reasoning compression (Qwen3-8B, Math-500)</span>
<span class="cs-line hl-g"><span class="cmt"># OPSD with "be concise" system prompt:</span></span>
<span class="cs-line hl-g">opsd_pass1 = <span class="num">0.935</span>  <span class="cmt"># no accuracy loss</span></span>
<span class="cs-line hl-g">opsd_len   = <span class="num">2100</span>   <span class="cmt"># tokens (vs ~4500 GRPO)</span></span>

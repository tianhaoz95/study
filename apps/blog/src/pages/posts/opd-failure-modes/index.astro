---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { postReadTime } from '../../../lib/readTimes';
const readTime = postReadTime(Astro.url.pathname.split('/').filter(Boolean).at(-1)!);
---
<BaseLayout
  title="The Many Faces of On-Policy Distillation | AI/ML Deep Dives"
  description="A comprehensive empirical study of when on-policy distillation (OPD) and self-distillation (OPSD) succeed or fail—and three concrete fixes."
  crumb="OPD Failure Modes"
>


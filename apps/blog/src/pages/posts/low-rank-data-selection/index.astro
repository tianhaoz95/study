<script>
// ── TOC + sidebar toggles ──────────────────────────────
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});
const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ── Code sidebar tabs ──────────────────────────────────
const tabMeta = {
  problem:     { file: 'selection.py',   title: 'The Problem' },
  coreset:     { file: 'coreset.py',     title: 'Coreset Loss' },
  lowrank:     { file: 'lowrank.py',     title: 'Low-Rank Structure' },
  sensitivity: { file: 'algorithm1.py',  title: 'Sensitivity Sampling' },
  tradeoff:    { file: 'analysis.py',    title: 'Error vs. k' },
  results:     { file: 'results.py',     title: 'Results' },
};
function activateTab(name){
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m){
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ── IntersectionObserver: sync TOC + tab ───────────────
const sectionMap = { 's-problem':'problem','s-coreset':'coreset','s-lowrank':'lowrank','s-sensitivity':'sensitivity','s-tradeoff':'tradeoff','s-results':'results' };
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting){
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ── Shared helpers ─────────────────────────────────────
const DPR = window.devicePixelRatio || 1;
function fitCanvas(cv, h){
  const w = cv.clientWidth;
  cv.width = w * DPR; cv.height = h * DPR;
  const ctx = cv.getContext('2d');
  ctx.setTransform(DPR,0,0,DPR,0,0);
  return { ctx, w, h };
}
function seeded(n){ return ((1103515245*n + 12345) & 0x7fffffff) / 0x7fffffff; }

// Generate an elongated 2D cloud (shared by §01, §04)
const ANG = Math.PI/7;                 // tilt of the dominant axis
const U = { x: Math.cos(ANG), y: Math.sin(ANG) };   // principal dir
const PERP = { x: -U.y, y: U.x };
function makeCloud(N){
  const pts = [];
  for (let i=0;i<N;i++){
    // box-muller-ish from seeded uniforms
    const a = seeded(i*2+1), b = seeded(i*2+2);
    const g1 = Math.sqrt(-2*Math.log(a+1e-6))*Math.cos(6.2831853*b);
    const g2 = Math.sqrt(-2*Math.log(a+1e-6))*Math.sin(6.2831853*b);
    const along = g1 * 1.0;            // high variance
    const perp  = g2 * 0.26;           // low variance
    pts.push({ along, perp });
  }
  // a few off-axis outliers
  const out = [[1.4,0.95],[-1.5,-0.9],[0.2,1.15],[-0.3,-1.1]];
  out.forEach(o=>pts.push({ along:o[0], perp:o[1] }));
  return pts;
}
function toScreen(p, w, h){
  const cx = w/2, cy = h/2, sx = w*0.30, sy = h*0.30;
  return {
    x: cx + (p.along*U.x + p.perp*PERP.x)*sx,
    y: cy + (p.along*U.y + p.perp*PERP.y)*sy
  };
}

// ════════════════════════════════════════════════════════
// §01 — selection strategy contrast
// ════════════════════════════════════════════════════════
(function(){
  const cv = document.getElementById('cloud-canvas');
  if (!cv) return;
  const pts = makeCloud(56);
  let mode = 'lowrank';
  const capEl = document.getElementById('cloud-cap');

  // low-rank pick: largest |projection on dominant axis|
  function lowrankPick(s){
    return pts.map((p,i)=>({i, key:Math.abs(p.along)}))
              .sort((a,b)=>b.key-a.key).slice(0,s).map(o=>o.i);
  }
  // clustering pick: farthest-point sampling in 2D (covers space)
  function clusterPick(s){
    const sel=[0];
    while(sel.length<s){
      let best=-1, bd=-1;
      for(let i=0;i<pts.length;i++){
        if(sel.includes(i)) continue;
        let d=1e9;
        for(const j of sel){
          const dx=pts[i].along-pts[j].along, dy=pts[i].perp-pts[j].perp;
          d=Math.min(d, dx*dx+dy*dy);
        }
        if(d>bd){bd=d;best=i;}
      }
      sel.push(best);
    }
    return sel;
  }

  function draw(){
    const { ctx, w, h } = fitCanvas(cv, 360);
    ctx.clearRect(0,0,w,h);
    // dominant axis line
    const a0 = toScreen({along:-1.7,perp:0},w,h), a1 = toScreen({along:1.7,perp:0},w,h);
    ctx.strokeStyle='rgba(139,92,246,.35)'; ctx.lineWidth=1.5; ctx.setLineDash([6,5]);
    ctx.beginPath(); ctx.moveTo(a0.x,a0.y); ctx.lineTo(a1.x,a1.y); ctx.stroke(); ctx.setLineDash([]);
    ctx.fillStyle='rgba(139,92,246,.6)'; ctx.font='11px monospace';
    ctx.fillText('dominant direction of variance', a1.x-230, a1.y-8);

    const sel = mode==='lowrank' ? lowrankPick(8) : clusterPick(8);
    const selSet = new Set(sel);
    // all points
    pts.forEach((p,i)=>{
      const s = toScreen(p,w,h);
      if(selSet.has(i)) return;
      ctx.beginPath(); ctx.arc(s.x,s.y,3.5,0,6.2832);
      ctx.fillStyle='rgba(148,163,184,.32)'; ctx.fill();
    });
    // selected
    const col = mode==='lowrank' ? '139,92,246' : '6,182,212';
    sel.forEach(i=>{
      const s = toScreen(pts[i],w,h);
      ctx.beginPath(); ctx.arc(s.x,s.y,7,0,6.2832);
      ctx.fillStyle=`rgba(${col},.9)`; ctx.fill();
      ctx.lineWidth=2; ctx.strokeStyle=`rgba(${col},.4)`;
      ctx.beginPath(); ctx.arc(s.x,s.y,11,0,6.2832); ctx.stroke();
    });
    capEl.innerHTML = mode==='lowrank'
      ? '<b style="color:var(--purple-l)">Low-rank</b> picks the extremes along the dominant axis — the points that reconstruct the principal direction of variance.'
      : '<b style="color:var(--cyan)">Clustering</b> fans to the corners to maximize spread — spending budget on off-axis outliers carrying little training signal.';
  }
  document.querySelectorAll('#s-problem .vp-btn').forEach(b=>{
    b.addEventListener('click',()=>{
      document.querySelectorAll('#s-problem .vp-btn').forEach(x=>x.classList.remove('active'));
      b.classList.add('active'); mode=b.dataset.mode; draw();
    });
  });
  draw();
  window.addEventListener('resize', draw);
})();

// ════════════════════════════════════════════════════════
// §02 — coreset loss gauges
// ════════════════════════════════════════════════════════
(function(){
  const cv = document.getElementById('coreset-canvas');
  if (!cv) return;
  function draw(){
    const { ctx, w, h } = fitCanvas(cv, 240);
    ctx.clearRect(0,0,w,h);
    const colL = w*0.27, colR = w*0.73;
    ctx.textAlign='center'; ctx.font='12px monospace';
    ctx.fillStyle='var(--muted)';
    // left: many small points
    ctx.fillStyle='rgba(148,163,184,.85)';
    ctx.fillText('full dataset  D  (n points)', colL, 26);
    let s=0;
    for(let i=0;i<48;i++){
      const r = seeded(i+7), ang=seeded(i+99)*6.2832, rad=seeded(i+5)*44+6;
      const x = colL + Math.cos(ang)*rad, y = 120 + Math.sin(ang)*rad*0.8;
      ctx.beginPath(); ctx.arc(x,y,2.6,0,6.2832);
      ctx.fillStyle='rgba(148,163,184,.45)'; ctx.fill();
    }
    // right: few weighted points (size = weight)
    ctx.fillStyle='rgba(167,139,250,.95)';
    ctx.fillText('coreset  S  (s weighted points)', colR, 26);
    const wpts=[[0,-22,9],[26,4,11],[-24,8,8],[8,26,12],[-14,-20,7],[20,-14,9]];
    wpts.forEach((p,i)=>{
      const x=colR+p[0], y=120+p[1];
      ctx.beginPath(); ctx.arc(x,y,p[2],0,6.2832);
      ctx.fillStyle='rgba(139,92,246,.85)'; ctx.fill();
      ctx.font='9px monospace'; ctx.fillStyle='rgba(255,255,255,.85)';
      ctx.fillText('w'+(i+1), x, y+3);
    });
    // arrow
    ctx.strokeStyle='rgba(94,234,212,.5)'; ctx.lineWidth=2;
    ctx.beginPath(); ctx.moveTo(colL+62,120); ctx.lineTo(colR-72,120); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(colR-72,120); ctx.lineTo(colR-80,114); ctx.lineTo(colR-80,126); ctx.closePath();
    ctx.fillStyle='rgba(94,234,212,.5)'; ctx.fill();
    // matched gauges
    ctx.font='12px monospace'; ctx.textAlign='center';
    ctx.fillStyle='var(--muted2)';
    ctx.fillText('Σ ℓ(x)  =  1.000', colL, 215);
    ctx.fillStyle='rgba(167,139,250,.95)';
    ctx.fillText('Σ w·ℓ(x)  ≈  0.991', colR, 215);
    ctx.fillStyle='rgba(94,234,212,.7)'; ctx.font='11px monospace';
    ctx.fillText('Δ(S) small', (colL+colR)/2, 215);
  }
  draw();
  window.addEventListener('resize', draw);
})();

// ════════════════════════════════════════════════════════
// §03 — singular value spectrum + k knob
// ════════════════════════════════════════════════════════
(function(){
  const cv = document.getElementById('svd-canvas');
  if (!cv) return;
  const sv = [9.2, 4.1, 2.3, 1.4, 0.9, 0.6, 0.42, 0.3];
  const totalEnergy = sv.reduce((a,s)=>a+s*s,0);
  let k = 3;
  const kVal=document.getElementById('k-val'), kStats=document.getElementById('k-stats'), kSlider=document.getElementById('k-slider');
  function draw(){
    const { ctx, w, h } = fitCanvas(cv, 280);
    ctx.clearRect(0,0,w,h);
    const m={l:46,r:20,t:24,b:40}, pw=w-m.l-m.r, ph=h-m.t-m.b;
    const maxv = sv[0];
    const bw = pw/sv.length*0.62, gap = pw/sv.length;
    // axes
    ctx.strokeStyle='rgba(255,255,255,.08)'; ctx.lineWidth=1;
    ctx.beginPath(); ctx.moveTo(m.l,m.t); ctx.lineTo(m.l,m.t+ph); ctx.lineTo(m.l+pw,m.t+ph); ctx.stroke();
    ctx.fillStyle='var(--muted)'; ctx.font='10px monospace'; ctx.textAlign='center';
    let kept=0;
    sv.forEach((s,i)=>{
      const bh = s/maxv*ph;
      const x = m.l + i*gap + (gap-bw)/2, y = m.t+ph-bh;
      const inK = i < k;
      ctx.fillStyle = inK ? 'rgba(139,92,246,.85)' : 'rgba(100,116,139,.4)';
      ctx.fillRect(x,y,bw,bh);
      ctx.fillStyle='var(--muted)';
      ctx.fillText('σ'+(i+1), x+bw/2, m.t+ph+15);
      if(i<k) kept += s*s;
    });
    const Phi = totalEnergy - kept;
    // k divider
    const dx = m.l + k*gap;
    ctx.strokeStyle='rgba(139,92,246,.5)'; ctx.setLineDash([4,4]); ctx.lineWidth=1.5;
    ctx.beginPath(); ctx.moveTo(dx,m.t-4); ctx.lineTo(dx,m.t+ph); ctx.stroke(); ctx.setLineDash([]);
    ctx.fillStyle='rgba(100,116,139,.7)'; ctx.font='11px monospace'; ctx.textAlign='left';
    ctx.fillText('Φₖ = tail energy', dx+8, m.t+14);
    kVal.textContent = k;
    kStats.innerHTML = `variance kept <b style="color:var(--purple-l)">${(kept/totalEnergy*100).toFixed(1)}%</b> &nbsp; Φₖ <b style="color:var(--muted2)">${Phi.toFixed(2)}</b>`;
  }
  kSlider?.addEventListener('input', ()=>{ k=+kSlider.value; draw(); });
  draw();
  window.addEventListener('resize', draw);
})();

// ════════════════════════════════════════════════════════
// §04 — residual decomposition + sensitivity coloring
// ════════════════════════════════════════════════════════
(function(){
  const cv = document.getElementById('decomp-canvas');
  if (!cv) return;
  const pts = makeCloud(50);
  const capEl = document.getElementById('decomp-cap');
  // sensitivity ~ projected loss (along^2) + lambda * residual^2
  const LAM = 1.4;
  const sens = pts.map(p => 0.7*p.along*p.along + LAM*p.perp*p.perp + 0.05);
  const maxS = Math.max(...sens);
  let active = -1;

  function draw(){
    const { ctx, w, h } = fitCanvas(cv, 340);
    ctx.clearRect(0,0,w,h);
    // axis
    const a0=toScreen({along:-1.7,perp:0},w,h), a1=toScreen({along:1.7,perp:0},w,h);
    ctx.strokeStyle='rgba(139,92,246,.3)'; ctx.lineWidth=1.5; ctx.setLineDash([6,5]);
    ctx.beginPath(); ctx.moveTo(a0.x,a0.y); ctx.lineTo(a1.x,a1.y); ctx.stroke(); ctx.setLineDash([]);
    ctx.fillStyle='rgba(139,92,246,.55)'; ctx.font='11px monospace'; ctx.textAlign='left';
    ctx.fillText('subspace V', a1.x-92, a1.y-8);

    pts.forEach((p,i)=>{
      const s = toScreen(p,w,h);
      const t = sens[i]/maxS;
      ctx.beginPath(); ctx.arc(s.x,s.y, 4+t*4, 0,6.2832);
      ctx.fillStyle = `rgba(139,92,246,${0.22+t*0.7})`; ctx.fill();
    });
    if (active>=0){
      const p = pts[active];
      const s = toScreen(p,w,h);
      const proj = toScreen({along:p.along,perp:0},w,h);
      // residual (amber) from point to its projection on V
      ctx.strokeStyle='rgba(245,158,11,.9)'; ctx.lineWidth=2.5;
      ctx.beginPath(); ctx.moveTo(s.x,s.y); ctx.lineTo(proj.x,proj.y); ctx.stroke();
      // projection vector (cyan) from origin-ish along axis
      const o = toScreen({along:0,perp:0},w,h);
      ctx.strokeStyle='rgba(6,182,212,.9)'; ctx.lineWidth=2.5;
      ctx.beginPath(); ctx.moveTo(o.x,o.y); ctx.lineTo(proj.x,proj.y); ctx.stroke();
      // markers
      ctx.fillStyle='rgba(6,182,212,.95)'; ctx.beginPath(); ctx.arc(proj.x,proj.y,5,0,6.2832); ctx.fill();
      ctx.fillStyle='#fff'; ctx.beginPath(); ctx.arc(s.x,s.y,6,0,6.2832); ctx.fill();
      ctx.strokeStyle='var(--purple)'; ctx.lineWidth=2; ctx.beginPath(); ctx.arc(s.x,s.y,9,0,6.2832); ctx.stroke();
      ctx.font='11px monospace';
      ctx.fillStyle='rgba(6,182,212,.95)'; ctx.fillText('v(x)', proj.x+8, proj.y-6);
      ctx.fillStyle='rgba(245,158,11,.95)'; ctx.fillText('r(x)', (s.x+proj.x)/2+8, (s.y+proj.y)/2);
      capEl.innerHTML = `Point selected — projection <b style="color:var(--cyan)">v(x)</b> along V, residual <b style="color:var(--amber)">r(x)</b> orthogonal. Sensitivity σ(x) = <b style="color:var(--purple-l)">${sens[active].toFixed(2)}</b> (relative).`;
    } else {
      capEl.innerHTML = 'Each point is colored by its sensitivity score σ(x). Brighter / larger purple = more likely to be sampled. Click any point to decompose it into projection v(x) and residual r(x).';
    }
  }
  cv.addEventListener('click', ev=>{
    const rect = cv.getBoundingClientRect();
    const mx = ev.clientX-rect.left, my = ev.clientY-rect.top;
    const w = cv.clientWidth, h=340;
    let best=-1, bd=1e9;
    pts.forEach((p,i)=>{ const s=toScreen(p,w,h); const d=(s.x-mx)**2+(s.y-my)**2; if(d<bd){bd=d;best=i;} });
    active = (bd<400)? best : -1; draw();
  });
  draw();
  window.addEventListener('resize', draw);
})();

// ── Step navigator (§04) ───────────────────────────────
(function(){
  let step=0;
  const boxes=document.querySelectorAll('#alg-steps .step-box');
  const prevBtn=document.getElementById('step-prev'), nextBtn=document.getElementById('step-next'), progEl=document.getElementById('step-prog');
  function upd(){
    boxes.forEach((b,i)=>{ b.classList.remove('active','done'); if(i===step)b.classList.add('active'); else if(i<step)b.classList.add('done'); const n=b.querySelector('.step-num'); if(n)n.textContent=i<step?'✓':String(i+1); });
    if(prevBtn)prevBtn.disabled=step===0;
    if(nextBtn)nextBtn.disabled=step===boxes.length-1;
    if(progEl)progEl.textContent=`Step ${step+1} of ${boxes.length}`;
  }
  prevBtn?.addEventListener('click',()=>{ if(step>0){step--;upd();} });
  nextBtn?.addEventListener('click',()=>{ if(step<boxes.length-1){step++;upd();} });
  upd();
})();

// ════════════════════════════════════════════════════════
// §05 — error vs k line chart
// ════════════════════════════════════════════════════════
(function(){
  const cv = document.getElementById('error-canvas');
  if (!cv) return;
  // data approximating Fig 2 (k in %, error)
  const ks = [0,5,10,15,20,25,30,35,40,45,50];
  const data = {
    proj: {
      cluster: [2.05,1.78,1.55,1.36,1.20,1.06,0.94,0.84,0.74,0.66,0.58],
      lowrank: [1.62,1.34,1.12,0.95,0.81,0.70,0.61,0.53,0.46,0.40,0.35],
      ymax: 2.2, label:'avg euclidean reconstruction error from k landmarks'
    },
    loss: {
      cluster: [0.305,0.285,0.268,0.252,0.238,0.226,0.215,0.206,0.198,0.191,0.185],
      lowrank: [0.255,0.232,0.213,0.198,0.186,0.176,0.168,0.161,0.156,0.151,0.147],
      ymax: 0.33, label:'avg |true loss − approximated loss|'
    }
  };
  let metric='proj';
  const capEl=document.getElementById('error-cap');
  function draw(){
    const { ctx, w, h } = fitCanvas(cv, 300);
    ctx.clearRect(0,0,w,h);
    const d=data[metric];
    const m={l:52,r:20,t:20,b:38}, pw=w-m.l-m.r, ph=h-m.t-m.b;
    const X=k=> m.l + (k/50)*pw;
    const Y=v=> m.t + (1 - v/d.ymax)*ph;
    // grid
    ctx.strokeStyle='rgba(255,255,255,.05)'; ctx.lineWidth=1;
    for(let g=0;g<=4;g++){ const y=m.t+ph*g/4; ctx.beginPath(); ctx.moveTo(m.l,y); ctx.lineTo(m.l+pw,y); ctx.stroke(); }
    // axes labels
    ctx.fillStyle='var(--muted)'; ctx.font='10px monospace'; ctx.textAlign='center';
    [0,10,20,30,40,50].forEach(k=>ctx.fillText(k+'%', X(k), m.t+ph+16));
    ctx.fillText('k  (% of dataset)', m.l+pw/2, h-4);
    function line(arr,col){
      ctx.strokeStyle=col; ctx.lineWidth=2.4; ctx.beginPath();
      ks.forEach((k,i)=>{ const x=X(k),y=Y(arr[i]); i?ctx.lineTo(x,y):ctx.moveTo(x,y); });
      ctx.stroke();
      ks.forEach((k,i)=>{ ctx.beginPath(); ctx.arc(X(k),Y(arr[i]),2.4,0,6.2832); ctx.fillStyle=col; ctx.fill(); });
    }
    line(d.cluster,'rgba(6,182,212,.9)');
    line(d.lowrank,'rgba(139,92,246,.95)');
    // inline labels
    ctx.font='11px monospace'; ctx.textAlign='left';
    ctx.fillStyle='rgba(6,182,212,.95)'; ctx.fillText('Cluster SS', X(31)+4, Y(d.cluster[6])-6);
    ctx.fillStyle='rgba(167,139,250,.95)'; ctx.fillText('Low-rank SS', X(31)+4, Y(d.lowrank[6])+16);
    capEl.innerHTML = d.label + ' — <b style="color:var(--purple-l)">low-rank stays below clustering at every k</b>.';
  }
  document.querySelectorAll('#s-tradeoff .vp-btn').forEach(b=>{
    b.addEventListener('click',()=>{
      document.querySelectorAll('#s-tradeoff .vp-btn').forEach(x=>x.classList.remove('active'));
      b.classList.add('active'); metric=b.dataset.err; draw();
    });
  });
  draw();
  window.addEventListener('resize', draw);
})();

// ════════════════════════════════════════════════════════
// §06 — animated results bars
// ════════════════════════════════════════════════════════
(function(){
  const sec = document.getElementById('s-results');
  if (!sec) return;
  new IntersectionObserver(entries=>{
    entries.forEach(e=>{
      if(e.isIntersecting){
        document.querySelectorAll('#result-bars .bar-fill[data-w]').forEach(b=>{
          b.style.width = b.dataset.w + '%';
        });
      }
    });
  }, { threshold: 0.3 }).observe(sec);
})();
</script>
</BaseLayout>

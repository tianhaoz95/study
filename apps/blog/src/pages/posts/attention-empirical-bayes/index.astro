// ─── §01 Problem Canvas: Before / After Stage 1 ──────────
(function() {
  const canvas = document.getElementById('problem-canvas');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  function resize() {
    const W = canvas.clientWidth, H = canvas.clientHeight;
    canvas.width = W * DPR; canvas.height = H * DPR;
    draw();
  }

  const rng = mulberry32(12345);
  const N = 24;
  // Two clusters at (-2,0) and (+2,0), noise sigma=0.7
  const pts = [];
  for (let i = 0; i < N; i++) {
    const cx = i < 12 ? -2 : 2;
    pts.push({ x: cx + 0.7 * randn(rng), y: 0.7 * randn(rng) });
  }
  // Query point near +1.4
  const query = { x: 1.4, y: 0.3 };

  // Simulate 40 Stage 1 steps (beta=5, eta=0.1)
  function simStage1(particles, beta, eta, steps) {
    let z = particles.map(p => ({ x: p.x, y: p.y }));
    for (let s = 0; s < steps; s++) {
      const zNew = z.map((zi, i) => {
        let sw = 0, swx = 0, swy = 0;
        for (let j = 0; j < z.length; j++) {
          const dx = zi.x - z[j].x, dy = zi.y - z[j].y;
          const w = Math.exp(-beta / 2 * (dx*dx + dy*dy));
          sw += w; swx += w * z[j].x; swy += w * z[j].y;
        }
        return { x: (1 - eta) * zi.x + eta * swx / sw,
                 y: (1 - eta) * zi.y + eta * swy / sw };
      });
      z = zNew;
    }
    return z;
  }

  function posteriorMean(query, z, betaC) {
    let sw = 0, swx = 0, swy = 0;
    for (const p of z) {
      const dx = query.x - p.x, dy = query.y - p.y;
      const w = Math.exp(-betaC / 2 * (dx*dx + dy*dy));
      sw += w; swx += w * p.x; swy += w * p.y;
    }
    return { x: swx / sw, y: swy / sw };
  }

  const refined = simStage1(pts, 5, 0.1, 40);
  const betaC = 1.0 / 0.5; // 1/sigma^2

  function draw() {
    const W = canvas.width / DPR, H = canvas.height / DPR;
    const ctx = canvas.getContext('2d');
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
    ctx.clearRect(0, 0, W, H);

    const panelW = W / 2;
    const toX = (x, offset) => offset + (x + 4) / 8 * panelW;
    const toY = (y) => H / 2 + y * H / 6;

    function drawPanel(particles, pm, title, xOffset, isRefined) {
      // background
      ctx.fillStyle = 'rgba(15,17,26,0.6)';
      ctx.fillRect(xOffset, 0, panelW - 2, H);

      // cluster rings (true prior locations)
      for (const cx of [-2, 2]) {
        const px = toX(cx, xOffset), py = toY(0);
        ctx.beginPath();
        ctx.arc(px, py, 18, 0, Math.PI * 2);
        ctx.strokeStyle = 'rgba(255,255,255,0.08)';
        ctx.lineWidth = 1; ctx.stroke();
        ctx.beginPath();
        ctx.arc(px, py, 2, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(255,255,255,0.2)'; ctx.fill();
      }

      // particles
      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];
        const px = toX(p.x, xOffset), py = toY(p.y);
        const color = isRefined
          ? (p.x < 0 ? 'rgba(6,182,212,0.85)' : 'rgba(139,92,246,0.85)')
          : 'rgba(156,163,175,0.6)';
        ctx.beginPath();
        ctx.arc(px, py, 4, 0, Math.PI * 2);
        ctx.fillStyle = color; ctx.fill();
      }

      // query point (amber star)
      const qx = toX(query.x, xOffset), qy = toY(query.y);
      ctx.beginPath();
      ctx.arc(qx, qy, 6, 0, Math.PI * 2);
      ctx.fillStyle = '#f59e0b'; ctx.fill();
      ctx.strokeStyle = '#fbbf24'; ctx.lineWidth = 1.5; ctx.stroke();
      ctx.fillStyle = '#f59e0b';
      ctx.font = '9px monospace';
      ctx.fillText('x̃*', qx + 8, qy - 6);

      // posterior mean (green dot + arrow)
      const pmX = toX(pm.x, xOffset), pmY = toY(pm.y);
      ctx.beginPath();
      ctx.moveTo(qx, qy);
      ctx.lineTo(pmX, pmY);
      ctx.strokeStyle = isRefined ? 'rgba(16,185,129,0.9)' : 'rgba(239,68,68,0.8)';
      ctx.lineWidth = 1.5;
      ctx.setLineDash([3, 2]); ctx.stroke(); ctx.setLineDash([]);
      ctx.beginPath();
      ctx.arc(pmX, pmY, 5, 0, Math.PI * 2);
      ctx.fillStyle = isRefined ? '#10b981' : '#ef4444'; ctx.fill();
      ctx.fillStyle = isRefined ? '#10b981' : '#ef4444';
      ctx.font = '9px monospace';
      ctx.fillText('x̂*', pmX + 7, pmY - 5);

      // title
      ctx.fillStyle = 'rgba(148,163,184,0.9)';
      ctx.font = 'bold 10px monospace';
      ctx.fillText(title, xOffset + 8, 18);

      // MSE label
      const mse = (pm.x - 2.0) * (pm.x - 2.0) + pm.y * pm.y;
      const color2 = isRefined ? '#10b981' : '#ef4444';
      ctx.fillStyle = color2;
      ctx.font = '9px monospace';
      ctx.fillText('x̂* = (' + pm.x.toFixed(2) + ', ' + pm.y.toFixed(2) + ')', xOffset + 8, H - 8);
    }

    const pmNaive = posteriorMean(query, pts, betaC);
    const pmRefined = posteriorMean(query, refined, betaC);

    drawPanel(pts,     pmNaive,   'Before Stage 1  (L=0)', 0, false);
    drawPanel(refined, pmRefined, 'After Stage 1  (L=40)', panelW, true);

    // divider
    ctx.beginPath();
    ctx.moveTo(panelW, 0); ctx.lineTo(panelW, H);
    ctx.strokeStyle = 'rgba(75,85,99,0.5)';
    ctx.lineWidth = 1; ctx.stroke();

    // legend
    function dot(color, label, x, y) {
      ctx.beginPath(); ctx.arc(x, y, 4, 0, Math.PI * 2);
      ctx.fillStyle = color; ctx.fill();
      ctx.fillStyle = 'rgba(148,163,184,0.7)'; ctx.font = '8.5px monospace';
      ctx.fillText(label, x + 8, y + 3);
    }
    dot('rgba(156,163,175,.8)',  'noisy tokens', 8, H - 28);
    dot('#f59e0b',               'query x̃*',    120, H - 28);
    dot('#ef4444',               'posterior mean (wrong)', 8 + panelW, H - 28);
    dot('#10b981',               'posterior mean (correct)', 8 + panelW + 160, H - 28);
  }

  window.addEventListener('resize', resize);
  requestAnimationFrame(resize);
})();

// ─── §02 Particle Animation Canvas ───────────────────────
(function() {
  const canvas = document.getElementById('particle-canvas');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;

  let curBeta = 5;
  let isPlaying = false;
  let stepN = 0;
  const TOTAL_STEPS = 60;
  const eta = 0.1;
  const N = 24;

  // Generate initial particles (fixed seed)
  function genParticles() {
    const rng = mulberry32(9999);
    const ps = [];
    for (let i = 0; i < N; i++) {
      const cx = i < 12 ? -2 : 2;
      ps.push({ x: cx + 0.7 * randn(rng), y: 0.7 * randn(rng) });
    }
    return ps;
  }

  let initialPts = genParticles();
  let particles = initialPts.map(p => ({ ...p }));
  let history = [particles.map(p => ({ ...p }))];

  function simAll(beta) {
    let z = initialPts.map(p => ({ ...p }));
    const hist = [z.map(p => ({ ...p }))];
    for (let s = 0; s < TOTAL_STEPS; s++) {
      const zNew = z.map((zi) => {
        let sw = 0, swx = 0, swy = 0;
        for (const zj of z) {
          const dx = zi.x - zj.x, dy = zi.y - zj.y;
          const w = Math.exp(-beta / 2 * (dx*dx + dy*dy));
          sw += w; swx += w * zj.x; swy += w * zj.y;
        }
        return { x: (1-eta)*zi.x + eta*swx/sw, y: (1-eta)*zi.y + eta*swy/sw };
      });
      z = zNew;
      hist.push(z.map(p => ({ ...p })));
    }
    return hist;
  }

  // Pre-compute histories for each beta
  const histories = { 1: null, 5: null, 20: null };
  function getHistory(beta) {
    if (!histories[beta]) histories[beta] = simAll(beta);
    return histories[beta];
  }

  function resetAnim() {
    isPlaying = false;
    stepN = 0;
    document.getElementById('p-play').textContent = '▶ Play';
    document.getElementById('p-step-label').textContent = 'step 0 / ' + TOTAL_STEPS;
    drawFrame(0);
  }

  function drawFrame(step) {
    const W = canvas.clientWidth, H = canvas.clientHeight;
    if (canvas.width !== W * DPR || canvas.height !== H * DPR) {
      canvas.width = W * DPR; canvas.height = H * DPR;
    }
    const ctx = canvas.getContext('2d');
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
    ctx.clearRect(0, 0, W, H);

    const toX = x => (x + 4) / 8 * W;
    const toY = y => H / 2 + y * H / 6;

    // Grid
    ctx.strokeStyle = 'rgba(255,255,255,0.03)';
    ctx.lineWidth = 1;
    for (let gx = -3; gx <= 3; gx++) {
      ctx.beginPath(); ctx.moveTo(toX(gx), 0); ctx.lineTo(toX(gx), H); ctx.stroke();
    }

    // True cluster rings
    for (const cx of [-2, 2]) {
      const px = toX(cx), py = toY(0);
      ctx.beginPath(); ctx.arc(px, py, 22, 0, Math.PI * 2);
      ctx.strokeStyle = cx < 0 ? 'rgba(6,182,212,0.2)' : 'rgba(139,92,246,0.2)';
      ctx.lineWidth = 1.5; ctx.setLineDash([4, 3]); ctx.stroke(); ctx.setLineDash([]);
      ctx.font = '10px monospace';
      ctx.fillStyle = cx < 0 ? 'rgba(6,182,212,0.6)' : 'rgba(139,92,246,0.6)';
      ctx.fillText(cx < 0 ? 'cluster −2' : 'cluster +2', toX(cx) - 30, py + 32);
    }

    const hist = getHistory(curBeta);
    const pts = hist[Math.min(step, hist.length - 1)];
    const t = step * eta;
    const T_star = 0.5 / 2; // sigma^2=0.5, T*=0.25

    // Particles
    for (let i = 0; i < pts.length; i++) {
      const p = pts[i];
      const px = toX(p.x), py = toY(p.y);
      const progress = Math.min(1, step / (TOTAL_STEPS * 0.7));
      const isCyan = i < 12;
      const col = isCyan ? `rgba(6,182,212,${0.3 + 0.6 * progress})` : `rgba(139,92,246,${0.3 + 0.6 * progress})`;
      ctx.beginPath(); ctx.arc(px, py, 4.5, 0, Math.PI * 2);
      ctx.fillStyle = col; ctx.fill();
      // trail
      if (step > 0) {
        const prev = hist[Math.max(0, step - 1)][i];
        ctx.beginPath(); ctx.moveTo(toX(prev.x), toY(prev.y)); ctx.lineTo(px, py);
        ctx.strokeStyle = isCyan ? 'rgba(6,182,212,0.15)' : 'rgba(139,92,246,0.15)';
        ctx.lineWidth = 1; ctx.stroke();
      }
    }

    // Step counter
    const tStr = t.toFixed(2);
    const tStarStr = '0.25';
    ctx.fillStyle = 'rgba(148,163,184,0.7)';
    ctx.font = '9.5px monospace';
    ctx.fillText('t = ' + tStr + ' / T* = ' + tStarStr, 10, 18);
    ctx.fillText('β = ' + curBeta, 10, 32);

    // T* line
    // t is proportional to step * eta. x-axis is not t-axis here; particles move in data space.
    // Just show convergence note instead
    if (step === TOTAL_STEPS) {
      ctx.fillStyle = 'rgba(16,185,129,0.8)';
      ctx.font = 'bold 10px monospace';
      ctx.fillText('✓ particles converged', 10, H - 12);
    }
  }

  let raf = null;
  function tick() {
    if (!isPlaying) return;
    stepN = Math.min(stepN + 1, TOTAL_STEPS);
    document.getElementById('p-step-label').textContent = 'step ' + stepN + ' / ' + TOTAL_STEPS;
    drawFrame(stepN);
    if (stepN < TOTAL_STEPS) {
      raf = setTimeout(() => requestAnimationFrame(tick), 60);
    } else {
      isPlaying = false;
      document.getElementById('p-play').textContent = '▶ Play';
    }
  }

  document.getElementById('p-play').addEventListener('click', () => {
    if (stepN >= TOTAL_STEPS) { stepN = 0; }
    isPlaying = !isPlaying;
    document.getElementById('p-play').textContent = isPlaying ? '⏸ Pause' : '▶ Play';
    if (isPlaying) requestAnimationFrame(tick);
  });
  document.getElementById('p-reset').addEventListener('click', resetAnim);

  ['1','5','20'].forEach(b => {
    document.getElementById('p-b' + b)?.addEventListener('click', () => {
      curBeta = parseInt(b);
      document.querySelectorAll('[id^=p-b]').forEach(btn => btn.classList.remove('active'));
      document.getElementById('p-b' + b)?.classList.add('active');
      resetAnim();
    });
  });

  window.addEventListener('resize', () => drawFrame(stepN));
  drawFrame(0);
})();

// ─── §04 Energy Landscape Canvas ─────────────────────────
(function() {
  const canvas = document.getElementById('landscape-canvas');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;

  let curDepth = 0;
  const DEPTHS = [0, 20, 40];
  const eta = 0.1;
  const betaC = 2.0; // 1/sigma^2

  function genParticlesForDepth(depth) {
    const rng = mulberry32(7777);
    const N = 30;
    let z = [];
    for (let i = 0; i < N; i++) {
      const cx = i < 15 ? -2 : 2;
      z.push({ x: cx + 0.7 * randn(rng), y: 0.7 * randn(rng) });
    }
    for (let s = 0; s < depth; s++) {
      const zNew = z.map((zi) => {
        let sw = 0, swx = 0, swy = 0;
        for (const zj of z) {
          const dx = zi.x - zj.x, dy = zi.y - zj.y;
          const w = Math.exp(-5 / 2 * (dx*dx + dy*dy));
          sw += w; swx += w * zj.x; swy += w * zj.y;
        }
        return { x: (1-eta)*zi.x + eta*swx/sw, y: (1-eta)*zi.y + eta*swy/sw };
      });
      z = zNew;
    }
    return z;
  }

  // Cache particle states
  const ptCache = {};
  function getParticles(depth) {
    if (!ptCache[depth]) ptCache[depth] = genParticlesForDepth(depth);
    return ptCache[depth];
  }

  function energyAt(qx, qy, z) {
    let logsum = -Infinity;
    for (const p of z) {
      const dx = qx - p.x, dy = qy - p.y;
      const val = -betaC / 2 * (dx*dx + dy*dy);
      logsum = logsum === -Infinity ? val : Math.log(Math.exp(logsum - val) + 1) + val;
    }
    return -logsum / betaC;
  }

  const query = { x: 1.4, y: 0.3 };

  function draw() {
    const W = canvas.clientWidth, H = canvas.clientHeight;
    if (canvas.width !== W * DPR || canvas.height !== H * DPR) {
      canvas.width = W * DPR; canvas.height = H * DPR;
    }
    const ctx = canvas.getContext('2d');
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
    ctx.clearRect(0, 0, W, H);

    const z = getParticles(curDepth);
    const toX = x => (x + 4) / 8 * W;
    const toY = y => H / 2 + y * H / 6;

    // Compute energy heatmap
    const GRID = 60;
    const imgData = ctx.createImageData(W, H);
    let eMin = Infinity, eMax = -Infinity;
    const eGrid = [];
    for (let gy = 0; gy < GRID; gy++) {
      eGrid.push([]);
      for (let gx = 0; gx < GRID; gx++) {
        const wx = -4 + gx / GRID * 8;
        const wy = -3 + gy / GRID * 6;
        const e = energyAt(wx, wy, z);
        eGrid[gy].push(e);
        if (e < eMin) eMin = e;
        if (e > eMax) eMax = e;
      }
    }

    for (let py = 0; py < H; py++) {
      for (let px = 0; px < W; px++) {
        const gx = Math.floor(px / W * GRID);
        const gy = Math.floor(py / H * GRID);
        const e = eGrid[gy] ? eGrid[gy][gx] : 0;
        const t = (e - eMin) / (eMax - eMin + 1e-9);
        // Low energy (wells) → purple, high energy → dark
        const r = Math.round(t * 20);
        const g = Math.round(t * 10);
        const b = Math.round(30 + t * 40 + (1-t) * 60);
        const idx = (py * W + px) * 4;
        imgData.data[idx]   = r;
        imgData.data[idx+1] = g;
        imgData.data[idx+2] = b;
        imgData.data[idx+3] = 180;
      }
    }
    ctx.putImageData(imgData, 0, 0);

    // Particles
    for (const p of z) {
      ctx.beginPath(); ctx.arc(toX(p.x), toY(p.y), 3, 0, Math.PI * 2);
      ctx.fillStyle = p.x < 0 ? 'rgba(6,182,212,0.8)' : 'rgba(139,92,246,0.8)';
      ctx.fill();
    }

    // Query
    const qpx = toX(query.x), qpy = toY(query.y);
    ctx.beginPath(); ctx.arc(qpx, qpy, 6, 0, Math.PI * 2);
    ctx.fillStyle = '#f59e0b'; ctx.fill();
    ctx.fillStyle = '#fbbf24'; ctx.font = '9px monospace'; ctx.fillText('x̃*', qpx+8, qpy-5);

    // Depth label
    ctx.fillStyle = 'rgba(200,210,230,0.85)'; ctx.font = '10px monospace';
    ctx.fillText('depth ℓ = ' + curDepth + (curDepth === 40 ? ' (refined prior)' : curDepth === 0 ? ' (initial noise)' : ''), 10, 18);
  }

  ['0','20','40'].forEach(d => {
    const btn = document.getElementById('l-d' + d);
    btn?.addEventListener('click', () => {
      curDepth = parseInt(d);
      document.querySelectorAll('[id^=l-d]').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      draw();
    });
  });

  window.addEventListener('resize', draw);
  requestAnimationFrame(draw);
})();

// ─── §05 Variance Decay Line Chart ───────────────────────
(function() {
  const canvas = document.getElementById('variance-canvas');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;

  let highlighted = 5;

  // ODE solution: dv/dt = -2v / (v + 1/beta)
  function solveODE(v0, beta, tEnd, dt) {
    const steps = Math.ceil(tEnd / dt);
    const ts = [], vs = [];
    let v = v0, t = 0;
    for (let i = 0; i <= steps; i++) {
      ts.push(t); vs.push(v);
      const dvdt = -2 * v / (v + 1.0 / beta);
      v = Math.max(0, v + dvdt * dt);
      t += dt;
    }
    return { ts, vs };
  }

  // sigma^2 = 0.25, T* = 0.125
  const sigma2 = 0.25, Tstar = sigma2 / 2;
  const tEnd = 0.4;
  const dt = 0.002;

  const curves = {
    1:  { ...solveODE(sigma2, 1,  tEnd, dt), color: 'rgba(245,158,11,0.8)',  label: 'β = 1' },
    5:  { ...solveODE(sigma2, 5,  tEnd, dt), color: 'rgba(6,182,212,0.9)',   label: 'β = 5' },
    20: { ...solveODE(sigma2, 20, tEnd, dt), color: 'rgba(139,92,246,0.9)',  label: 'β = 20' },
  };

  // β=20 premature clustering: saturate at v=0.02 after t=0.06
  curves[20].vs = curves[20].vs.map((v, i) => {
    const t = curves[20].ts[i];
    return t > 0.06 ? Math.max(v, 0.02 + 0.01 * Math.max(0, t - 0.06)) : v;
  });

  function draw() {
    const W = canvas.clientWidth, H = canvas.clientHeight;
    if (canvas.width !== W * DPR || canvas.height !== H * DPR) {
      canvas.width = W * DPR; canvas.height = H * DPR;
    }
    const ctx = canvas.getContext('2d');
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
    ctx.clearRect(0, 0, W, H);

    const pad = { l: 52, r: 24, t: 20, b: 40 };
    const cW = W - pad.l - pad.r, cH = H - pad.t - pad.b;
    const tx = t => pad.l + t / tEnd * cW;
    const ty = v => pad.t + (1 - v / sigma2) * cH;

    // Grid
    ctx.strokeStyle = 'rgba(255,255,255,0.04)'; ctx.lineWidth = 1;
    for (let vi = 0; vi <= 4; vi++) {
      const vv = vi / 4 * sigma2;
      ctx.beginPath(); ctx.moveTo(pad.l, ty(vv)); ctx.lineTo(pad.l + cW, ty(vv)); ctx.stroke();
    }

    // Axes
    ctx.strokeStyle = 'rgba(100,116,139,0.6)'; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(pad.l, pad.t); ctx.lineTo(pad.l, pad.t + cH); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(pad.l, pad.t + cH); ctx.lineTo(pad.l + cW, pad.t + cH); ctx.stroke();

    // Axis labels
    ctx.fillStyle = 'rgba(100,116,139,0.8)'; ctx.font = '9px monospace';
    ctx.fillText('v(t)', pad.l - 28, pad.t + cH / 2);
    ctx.fillText('depth t', pad.l + cW / 2 - 20, pad.t + cH + 28);
    for (let vi = 0; vi <= 4; vi++) {
      const vv = (vi / 4 * sigma2).toFixed(2);
      ctx.fillText(vv, pad.l - 30, ty(vi / 4 * sigma2) + 3);
    }
    ['0', '0.1', '0.2', '0.3', '0.4'].forEach((tStr, i) => {
      ctx.fillText(tStr, pad.l + i / 4 * cW - 6, pad.t + cH + 14);
    });

    // T* vertical line
    ctx.strokeStyle = 'rgba(255,255,255,0.15)'; ctx.lineWidth = 1;
    ctx.setLineDash([4, 3]);
    ctx.beginPath(); ctx.moveTo(tx(Tstar), pad.t); ctx.lineTo(tx(Tstar), pad.t + cH); ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle = 'rgba(255,255,255,0.35)'; ctx.font = '9px monospace';
    ctx.fillText('T*=σ²/2', tx(Tstar) + 4, pad.t + 14);

    // Theoretical linear decay (dashed)
    ctx.strokeStyle = 'rgba(255,255,255,0.18)'; ctx.lineWidth = 1;
    ctx.setLineDash([3, 4]);
    ctx.beginPath();
    ctx.moveTo(tx(0), ty(sigma2));
    ctx.lineTo(tx(Tstar), ty(0));
    ctx.stroke(); ctx.setLineDash([]);
    ctx.fillStyle = 'rgba(255,255,255,0.25)'; ctx.font = '8px monospace';
    ctx.fillText('theory (β→∞)', tx(0.01), ty(sigma2) - 5);

    // Curves
    Object.entries(curves).forEach(([b, c]) => {
      const isCur = parseInt(b) === highlighted || highlighted === 'all';
      ctx.globalAlpha = isCur ? 1.0 : 0.2;
      ctx.strokeStyle = c.color;
      ctx.lineWidth = isCur ? 2.5 : 1.5;
      ctx.beginPath();
      for (let i = 0; i < c.ts.length; i++) {
        const px = tx(c.ts[i]), py = ty(c.vs[i]);
        i === 0 ? ctx.moveTo(px, py) : ctx.lineTo(px, py);
      }
      ctx.stroke();
      // Label at end
      if (isCur) {
        const last = c.ts.length - 1;
        ctx.fillStyle = c.color; ctx.font = '9px monospace';
        ctx.fillText(c.label, tx(c.ts[last]) - 24, ty(c.vs[last]) - 6);
      }
      ctx.globalAlpha = 1.0;
    });

    // Initial sigma^2 marker
    ctx.beginPath(); ctx.arc(tx(0), ty(sigma2), 4, 0, Math.PI * 2);
    ctx.fillStyle = 'rgba(255,255,255,0.5)'; ctx.fill();
    ctx.fillStyle = 'rgba(255,255,255,0.5)'; ctx.font = '8.5px monospace';
    ctx.fillText('σ²=0.25', tx(0.005), ty(sigma2) - 8);
  }

  document.getElementById('v-b1')?.addEventListener('click', () => { highlighted = 1; draw(); updateBtns('v-b1'); });
  document.getElementById('v-b5')?.addEventListener('click', () => { highlighted = 5; draw(); updateBtns('v-b5'); });
  document.getElementById('v-b20')?.addEventListener('click', () => { highlighted = 20; draw(); updateBtns('v-b20'); });
  document.getElementById('v-all')?.addEventListener('click', () => { highlighted = 'all'; draw(); updateBtns('v-all'); });
  function updateBtns(activeId) {
    ['v-b1','v-b5','v-b20','v-all'].forEach(id =>
      document.getElementById(id)?.classList.toggle('active', id === activeId));
  }

  window.addEventListener('resize', draw);
  requestAnimationFrame(draw);
})();

// ─── §06 Animated Bar Chart ───────────────────────────────
(function() {
  const section = document.getElementById('s-results');
  if (!section) return;
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          const pct = parseFloat(b.dataset.w);
          b.style.width = pct + '%';
        });
      }
    });
  }, { threshold: 0.3 }).observe(section);
})();
</script>
</BaseLayout>

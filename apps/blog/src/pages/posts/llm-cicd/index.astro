<span class="cs-line cmt"># Stage 1: Failure-biased production sampling</span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">sample_for_review</span>(traffic_log, n=<span class="num">50</span>):</span>
<span class="cs-line hl-a">    failures = [t <span class="kw">for</span> t <span class="kw">in</span> traffic_log</span>
<span class="cs-line hl-a">                <span class="kw">if</span> t.rating &lt; <span class="num">3</span> <span class="kw">or</span> t.reprompted]</span>
<span class="cs-line hl-a">    successes = random.<span class="fn">sample</span>(traffic_log, n//10)</span>
<span class="cs-line hl-a">    <span class="kw">return</span> failures[:n - <span class="fn">len</span>(successes)] + successes</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Stage 2: Add confirmed failures to golden dataset</span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">add_to_golden</span>(example, judge, dataset):</span>
<span class="cs-line hl-p">    judge_score = judge.<span class="fn">score</span>(example)</span>
<span class="cs-line hl-p">    <span class="kw">if</span> judge_score &lt; <span class="num">0.40</span>:  <span class="cmt"># auto-add clear failures</span></span>
<span class="cs-line hl-p">        dataset.<span class="fn">add</span>(example, label=<span class="str">"fail"</span>)</span>
<span class="cs-line hl-p">    <span class="kw">else</span>:</span>
<span class="cs-line hl-p">        review_queue.<span class="fn">push</span>(example)  <span class="cmt"># human review</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Stage 3: Version-gated offline eval</span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">run_regression</span>(candidate, dataset_version=<span class="str">"v7"</span>):</span>
<span class="cs-line hl-c">    baseline = model_registry.<span class="fn">load</span>(<span class="str">"prod@2026-06"</span>)</span>
<span class="cs-line hl-c">    dataset = golden.<span class="fn">load</span>(dataset_version)</span>
<span class="cs-line hl-c">    results = evaluator.<span class="fn">compare</span>(baseline, candidate, dataset)</span>
<span class="cs-line hl-c">    <span class="kw">if</span> results.<span class="fn">any_regression</span>(threshold=<span class="num">0.02</span>):</span>
<span class="cs-line hl-c">        <span class="kw">raise</span> <span class="cls">RegressionError</span>(results.<span class="fn">summary</span>())</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># The flywheel: more data → better evals → faster ship</span>
<span class="cs-line"><span class="cmt"># dataset size → eval coverage → regression detection rate</span></span>
<span class="cs-line"><span class="cmt"># 50 examples:  ~60% coverage of failure modes</span></span>
<span class="cs-line"><span class="cmt"># 200 examples: ~85% coverage</span></span>
<span class="cs-line"><span class="cmt"># 500 examples: ~95% coverage (diminishing returns)</span></span>
      </pre>

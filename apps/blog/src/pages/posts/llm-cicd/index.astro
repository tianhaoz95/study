  tocToggle.textContent = c ? '›' : '‹';
});

const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ── Code sidebar tab switching ────────────────────────────────
const tabMeta = {
  gap:       { file: 'llm_cicd/gap.py',       title: 'The Non-Determinism Gap' },
  pyramid:   { file: 'llm_cicd/pyramid.py',   title: 'The Eval Triangle' },
  judge:     { file: 'llm_cicd/judge.py',     title: 'LLM-as-Judge' },
  flywheel:  { file: 'llm_cicd/flywheel.py',  title: 'The Eval Flywheel' },
  metrics:   { file: 'llm_cicd/metrics.py',   title: 'What to Measure' },
  ecosystem: { file: 'llm_cicd/ecosystem.py', title: 'Framework Ecosystem' },
  pipeline:  { file: 'llm_cicd/pipeline.yml', title: 'Reference Pipeline' },
  agents:    { file: 'llm_cicd/agents.py',    title: 'Agent CI/CD Tools' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ── IntersectionObserver: TOC + sidebar tab sync ──────────────
const sectionMap = {
  's-gap':      'gap',
  's-pyramid':  'pyramid',
  's-judge':    'judge',
  's-flywheel': 'flywheel',
  's-metrics':  'metrics',
  's-ecosystem':'ecosystem',
  's-pipeline': 'pipeline',
  's-agents':   'agents',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ── §01 Gap canvas ────────────────────────────────────────────
(function() {
  const canvas = document.getElementById('gap-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 220;
  canvas.width = W * DPR; canvas.height = H * DPR;
  ctx.scale(DPR, DPR);

  const SAMPLES = [
    { text: '"Paris."', pass: true  },
    { text: '"The capital of France is Paris."', pass: false },
    { text: '"Paris, the City of Light."', pass: false },
    { text: '"It\'s Paris, of course!"', pass: false },
  ];

  let revealed = 4;

  function drawGap(n) {
    ctx.clearRect(0, 0, W, H);
    const PAD = 16;
    const COL = W / 2 - PAD;

    // Left column header
    ctx.fillStyle = '#10b981';
    ctx.font = 'bold 11px JetBrains Mono, monospace';
    ctx.fillText('Traditional code test', PAD, 22);
    ctx.fillStyle = 'rgba(16,185,129,0.15)';
    ctx.fillRect(PAD, 30, COL - 8, 60);
    ctx.strokeStyle = 'rgba(16,185,129,0.3)';
    ctx.lineWidth = 1;
    ctx.strokeRect(PAD, 30, COL - 8, 60);
    ctx.fillStyle = '#6b7280';
    ctx.font = '10px JetBrains Mono, monospace';
    ctx.fillText('get_capital("France")', PAD + 8, 52);
    ctx.fillStyle = '#98c379';
    ctx.fillText('→  "Paris"', PAD + 8, 68);
    ctx.fillStyle = '#10b981';
    ctx.font = 'bold 12px monospace';
    ctx.fillText('✓ PASS  (always)', PAD + 8, 84);

    // Right column header
    ctx.fillStyle = '#f59e0b';
    ctx.font = 'bold 11px JetBrains Mono, monospace';
    ctx.fillText('LLM string-match test', W/2 + PAD, 22);

    const colX = W/2 + PAD;
    const rowH = 40;
    for (let i = 0; i < Math.min(n, SAMPLES.length); i++) {
      const y = 30 + i * rowH;
      const s = SAMPLES[i];
      ctx.fillStyle = s.pass ? 'rgba(16,185,129,0.12)' : 'rgba(239,68,68,0.10)';
      ctx.fillRect(colX, y, COL - 8, rowH - 4);
      ctx.strokeStyle = s.pass ? 'rgba(16,185,129,0.25)' : 'rgba(239,68,68,0.2)';
      ctx.lineWidth = 1;
      ctx.strokeRect(colX, y, COL - 8, rowH - 4);
      ctx.fillStyle = '#abb2bf';
      ctx.font = '9.5px JetBrains Mono, monospace';
      ctx.fillText(s.text, colX + 8, y + 16);
      const verdict = s.pass ? '✓ PASS' : '✗ FAIL';
      ctx.fillStyle = s.pass ? '#10b981' : '#f87171';
      ctx.font = 'bold 10px monospace';
      ctx.fillText(verdict, colX + 8, y + 30);
    }

    // Summary
    if (n >= SAMPLES.length) {
      ctx.fillStyle = '#f59e0b';
      ctx.font = 'bold 10px JetBrains Mono, monospace';
      ctx.fillText('1/4 pass — same correct answer, broken test!', colX, 200);
    }
  }

  drawGap(revealed);

  const btn = document.getElementById('gap-run-btn');
  const txt = document.getElementById('gap-result-text');
  btn?.addEventListener('click', () => {
    revealed = revealed >= 4 ? 0 : 4;
    drawGap(revealed);
    txt.textContent = revealed >= 4
      ? '4/4 samples — 3 fail string-match despite correct answers'
      : 'Showing 4 LLM samples for the same prompt';
  });
})();

// ── §02 Tier navigator ────────────────────────────────────────
(function() {
  const boxes = document.querySelectorAll('#tier-list .step-box');
  const prev = document.getElementById('tier-prev');
  const next = document.getElementById('tier-next');
  const prog = document.getElementById('tier-prog');
  let step = 0;
  function update() {
    boxes.forEach((b, i) => {
      b.classList.remove('active', 'done');
      if (i === step) b.classList.add('active');
      else if (i < step) b.classList.add('done');
      const n = b.querySelector('.step-num');
      if (n) n.textContent = i < step ? '✓' : String(i + 1);
    });
    if (prev) prev.disabled = step === 0;
    if (next) next.disabled = step === boxes.length - 1;
    if (prog) prog.textContent = `Tier ${step + 1} of ${boxes.length}`;
  }
  prev?.addEventListener('click', () => { if (step > 0) { step--; update(); } });
  next?.addEventListener('click', () => { if (step < boxes.length - 1) { step++; update(); } });
  update();
})();

// ── §03 Judge architecture SVG ────────────────────────────────
(function() {
  const svg = document.getElementById('judge-svg');
  if (!svg) return;

  const nodes = [
    { id: 'user',    x: 40,  y: 130, w: 90,  h: 40, label: 'Test Input',      color: '#6b7280', detail: 'A prompt from the golden dataset — e.g. "What is our return policy for electronics?" with retrieved context and the expected behavior.' },
    { id: 'app',     x: 170, y: 130, w: 90,  h: 40, label: 'App LLM',          color: '#8b5cf6', detail: 'Your application\'s language model. Generates a response using the input and any retrieved context. Temperature may be set to 0 for determinism, or averaged over N samples.' },
    { id: 'output',  x: 300, y: 130, w: 90,  h: 40, label: 'Response',         color: '#6b7280', detail: 'The LLM\'s output text. Non-deterministic — may vary across runs. This is what the judge will evaluate against the evaluation criteria.' },
    { id: 'crit',    x: 470, y: 50,  w: 110, h: 40, label: 'Eval Criteria',    color: '#06b6d4', detail: 'The rubric: faithfulness, helpfulness, safety, etc. Written as a structured scoring prompt with explicit definitions for each score level (1–5).' },
    { id: 'judge',   x: 470, y: 150, w: 110, h: 40, label: 'Judge LLM',        color: '#8b5cf6', detail: 'A strong model (GPT-4, Claude) evaluating the response. It reasons step-by-step before scoring to reduce position and verbosity bias. Different provider from the app LLM to avoid self-enhancement bias.' },
    { id: 'verdict', x: 620, y: 150, w: 80,  h: 40, label: 'Score + Reason',   color: '#10b981', detail: 'A numeric score (1–5) plus a natural-language explanation. The explanation is crucial: it tells you WHY the response failed, pointing to exactly what to fix in your prompt or retrieval.' },
  ];

  const edges = [
    { from: 'user', to: 'app' },
    { from: 'app',  to: 'output' },
    { from: 'output', to: 'judge' },
    { from: 'crit', to: 'judge' },
    { from: 'judge', to: 'verdict' },
  ];

  let activeNode = null;
  const detail = document.getElementById('judge-detail');

  function nodeCenter(n) { return { x: n.x + n.w/2, y: n.y + n.h/2 }; }

  function draw() {
    let html = '';
    // Edges first
    edges.forEach(e => {
      const a = nodes.find(n => n.id === e.from);
      const b = nodes.find(n => n.id === e.to);
      const x1 = a.x + a.w, y1 = a.y + a.h/2;
      const x2 = b.x, y2 = b.y + b.h/2;
      const mx = (x1 + x2) / 2;
      html += `<path d="M${x1} ${y1} C${mx} ${y1} ${mx} ${y2} ${x2} ${y2}" stroke="rgba(255,255,255,0.12)" stroke-width="1.5" fill="none" marker-end="url(#arrowhead)"/>`;
    });
    // Nodes
    nodes.forEach(n => {
      const active = activeNode === n.id;
      const fillOp = active ? '0.22' : '0.10';
      const strokeOp = active ? '0.7' : '0.3';
      html += `<rect x="${n.x}" y="${n.y}" width="${n.w}" height="${n.h}" rx="7" fill="${n.color}" fill-opacity="${fillOp}" stroke="${n.color}" stroke-opacity="${strokeOp}" stroke-width="1.5" class="judge-node" data-id="${n.id}" style="cursor:pointer"/>`;
      html += `<text x="${n.x + n.w/2}" y="${n.y + n.h/2 + 4}" text-anchor="middle" font-size="10" font-family="JetBrains Mono,monospace" fill="${active ? n.color : '#abb2bf'}" class="judge-node" data-id="${n.id}" style="cursor:pointer;pointer-events:none">${n.label}</text>`;
    });
    svg.innerHTML = `<defs><marker id="arrowhead" markerWidth="8" markerHeight="7" refX="7" refY="3.5" orient="auto"><polygon points="0 0, 8 3.5, 0 7" fill="rgba(255,255,255,0.2)"/></marker></defs>` + html;

    svg.querySelectorAll('.judge-node').forEach(el => {
      el.addEventListener('click', () => {
        const id = el.dataset.id;
        activeNode = activeNode === id ? null : id;
        const n = nodes.find(x => x.id === id);
        detail.textContent = n ? n.detail : 'Click any node to see details →';
        draw();
      });
    });
  }

  draw();
  detail.textContent = 'Click any node in the architecture diagram to see what happens there →';
})();

// ── §04 Flywheel canvas ───────────────────────────────────────
(function() {
  const canvas = document.getElementById('flywheel-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 320;
  canvas.width = W * DPR; canvas.height = H * DPR;
  ctx.scale(DPR, DPR);

  const cx = W / 2, cy = H / 2;
  const R = Math.min(W, H) * 0.36;

  const stages = [
    { label: 'Deploy &\nMonitor',     color: '#8b5cf6', detail: 'Log every request, latency, and user feedback signal. Track thumbs-down, re-prompts, session abandonment, and explicit corrections. This is your continuous data source.' },
    { label: 'Surface\nFailures',     color: '#06b6d4', detail: 'Sample intelligently: bias toward low-rated responses, safety filter triggers, and reprompted queries. Uniform sampling wastes reviewer time on easy cases you already handle well.' },
    { label: 'Label &\nAdd to Dataset',color: '#f59e0b', detail: 'Have a judge LLM pre-screen samples (auto-add if score < 0.40). Human reviewers confirm edge cases. Tag with version, date, and failure mode to enable targeted debugging.' },
    { label: 'Offline\nEval',         color: '#10b981', detail: 'Run the full golden dataset through baseline and candidate. Compute per-metric deltas. This is where you catch regressions before users see them — ideally in under 10 minutes.' },
    { label: 'Fix the\nIssue',        color: '#ec4899', detail: 'Prompt engineering, RAG tuning, guardrails, or fine-tuning. The eval system tells you WHERE it fails; you choose the fix. Verify offline before touching production.' },
    { label: 'Gate\nDeploy',          color: '#8b5cf6', detail: 'Candidate must match or beat baseline on every metric. Any regression blocks the deploy. Version the golden dataset used for this gate — you can replay it six months later.' },
  ];

  const N = stages.length;
  let activeIdx = -1;
  const detail = document.getElementById('flywheel-detail');

  function stagePos(i) {
    const angle = (2 * Math.PI * i / N) - Math.PI / 2;
    return { x: cx + R * Math.cos(angle), y: cy + R * Math.sin(angle) };
  }

  let animAngle = 0;
  let animFrame = null;

  function drawFlywheel() {
    ctx.clearRect(0, 0, W, H);

    // Circular arrow track
    ctx.save();
    ctx.strokeStyle = 'rgba(255,255,255,0.06)';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.arc(cx, cy, R, 0, Math.PI * 2);
    ctx.stroke();
    ctx.restore();

    // Animated direction arrow on the ring
    const aw = animAngle;
    const ax = cx + R * Math.cos(aw);
    const ay = cy + R * Math.sin(aw);
    ctx.save();
    ctx.translate(ax, ay);
    ctx.rotate(aw + Math.PI / 2);
    ctx.fillStyle = 'rgba(139,92,246,0.4)';
    ctx.beginPath();
    ctx.moveTo(0, -6); ctx.lineTo(4, 2); ctx.lineTo(-4, 2); ctx.closePath();
    ctx.fill();
    ctx.restore();

    // Centre label
    ctx.fillStyle = 'rgba(255,255,255,0.6)';
    ctx.font = 'bold 11px JetBrains Mono, monospace';
    ctx.textAlign = 'center';
    ctx.fillText('Eval', cx, cy - 6);
    ctx.fillText('Flywheel', cx, cy + 10);
    ctx.textAlign = 'left';

    // Nodes
    stages.forEach((s, i) => {
      const pos = stagePos(i);
      const active = activeIdx === i;
      const r = 32;
      ctx.save();
      ctx.shadowColor = active ? s.color : 'transparent';
      ctx.shadowBlur = active ? 18 : 0;
      ctx.beginPath();
      ctx.arc(pos.x, pos.y, r, 0, Math.PI * 2);
      ctx.fillStyle = active
        ? s.color + '40'
        : 'rgba(26,26,46,0.9)';
      ctx.fill();
      ctx.strokeStyle = active ? s.color : s.color + '70';
      ctx.lineWidth = active ? 2.5 : 1.5;
      ctx.stroke();
      ctx.restore();

      // Label
      const lines = s.label.split('\n');
      ctx.fillStyle = active ? '#fff' : '#abb2bf';
      ctx.font = (active ? 'bold ' : '') + '9px JetBrains Mono, monospace';
      ctx.textAlign = 'center';
      lines.forEach((line, li) => {
        ctx.fillText(line, pos.x, pos.y + (lines.length === 2 ? -5 + li * 13 : 4));
      });
      ctx.textAlign = 'left';
    });
  }

  function animate() {
    animAngle = (animAngle + 0.008) % (Math.PI * 2);
    drawFlywheel();
    animFrame = requestAnimationFrame(animate);
  }
  animate();

  canvas.addEventListener('click', (evt) => {
    const rect = canvas.getBoundingClientRect();
    const mx = (evt.clientX - rect.left);
    const my = (evt.clientY - rect.top);
    let hit = -1;
    stages.forEach((s, i) => {
      const pos = stagePos(i);
      const dx = mx - pos.x, dy = my - pos.y;
      if (Math.sqrt(dx*dx + dy*dy) < 36) hit = i;
    });
    activeIdx = (hit === activeIdx) ? -1 : hit;
    if (hit >= 0) {
      detail.textContent = stages[hit].detail;
    } else {
      detail.textContent = 'Click any node in the flywheel to see what happens at that stage →';
    }
  });
})();

// ── §05 Metrics animated bars ─────────────────────────────────
(function() {
  const vp = document.getElementById('metrics-vp-body');
  if (!vp) return;
  const allBars = vp.querySelectorAll('.bar-fill[data-w]');
  let fired = false;
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting && !fired) {
        fired = true;
        allBars.forEach(b => {
          b.style.width = (parseFloat(b.dataset.w)) + '%';
        });
      }
    });
  }, { threshold: 0.3 }).observe(vp);
})();

// ── §07 Pipeline navigator ────────────────────────────────────
(function() {
  const boxes = document.querySelectorAll('#pipe-list .step-box');
  const prev = document.getElementById('pipe-prev');
  const next = document.getElementById('pipe-next');
  const prog = document.getElementById('pipe-prog');
  let step = 0;
  function update() {
    boxes.forEach((b, i) => {
      b.classList.remove('active', 'done');
      if (i === step) b.classList.add('active');
      else if (i < step) b.classList.add('done');
      const n = b.querySelector('.step-num');
      if (n) n.textContent = i < step ? '✓' : String(i + 1);
    });
    if (prev) prev.disabled = step === 0;
    if (next) next.disabled = step === boxes.length - 1;
    if (prog) prog.textContent = `Stage ${step + 1} of ${boxes.length}`;
  }
  prev?.addEventListener('click', () => { if (step > 0) { step--; update(); } });
  next?.addEventListener('click', () => { if (step < boxes.length - 1) { step++; update(); } });
  update();
})();
// ── §08 Trajectory canvas ─────────────────────────────────────
(function() {
  const canvas = document.getElementById('traj-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 280;
  canvas.width = W * DPR; canvas.height = H * DPR;
  ctx.scale(DPR, DPR);

  const PATHS = [
    {
      id: 'A',
      label: 'Path A — Correct',
      color: '#10b981',
      steps: [
        { x: 0.08, y: 0.5,  label: 'User query\n"Capital of France?"' },
        { x: 0.38, y: 0.25, label: 'search_db(\n  query="France capital"\n)' },
        { x: 0.70, y: 0.5,  label: 'Answer:\n"Paris"' },
      ],
      verdict: '✓ PASS — 2 steps, correct tool, correct args, correct answer. Trajectory eval: 5/5.',
      verdictColor: '#10b981',
    },
    {
      id: 'B',
      label: 'Path B — Inefficient',
      color: '#f59e0b',
      steps: [
        { x: 0.08, y: 0.5,  label: 'User query\n"Capital of France?"' },
        { x: 0.28, y: 0.75, label: 'search_db(\n  query="Europe"\n)' },
        { x: 0.50, y: 0.75, label: 'filter_results(\n  country="France"\n)' },
        { x: 0.68, y: 0.75, label: 'sort_by_population()' },
        { x: 0.84, y: 0.5,  label: 'Answer:\n"Paris"' },
      ],
      verdict: '⚠ WARN — 4 steps instead of 2. Right answer, wrong path. Tool call correctness: 3/5. Step efficiency: 2/5.',
      verdictColor: '#f59e0b',
    },
    {
      id: 'C',
      label: 'Path C — Hallucinated',
      color: '#ef4444',
      steps: [
        { x: 0.08, y: 0.5,  label: 'User query\n"Capital of France?"' },
        { x: 0.5,  y: 0.25, label: '(no tool call\n— internal knowledge)' },
        { x: 0.84, y: 0.5,  label: 'Answer:\n"Paris"' },
      ],
      verdict: '✗ FAIL — 0 tool calls. Right answer, entirely hallucinated. For a RAG agent, faithfulness: 0/5. A lucky guess is not a reliable agent.',
      verdictColor: '#ef4444',
    },
  ];

  let activeIdx = -1;
  const detail = document.getElementById('traj-detail');

  // Compute pixel position
  function pos(step) {
    return { x: step.x * W, y: step.y * H };
  }

  function drawTrajectory(path, active) {
    const alpha = activeIdx === -1 ? 1 : (active ? 1 : 0.22);
    ctx.save();
    ctx.globalAlpha = alpha;

    // Draw edges
    for (let i = 0; i < path.steps.length - 1; i++) {
      const a = pos(path.steps[i]), b = pos(path.steps[i+1]);
      ctx.strokeStyle = path.color;
      ctx.lineWidth = active ? 2.5 : 1.5;
      ctx.setLineDash(active ? [] : [4, 3]);
      ctx.beginPath();
      ctx.moveTo(a.x, a.y);
      ctx.bezierCurveTo(
        (a.x + b.x) / 2, a.y,
        (a.x + b.x) / 2, b.y,
        b.x, b.y
      );
      ctx.stroke();
      ctx.setLineDash([]);
    }

    // Draw nodes
    path.steps.forEach((step, si) => {
      const p = pos(step);
      // Circle
      ctx.beginPath();
      ctx.arc(p.x, p.y, active ? 8 : 6, 0, Math.PI * 2);
      ctx.fillStyle = active ? path.color : path.color + '80';
      ctx.fill();
      // Label on active path
      if (active && si > 0 && si < path.steps.length - 1) {
        const lines = step.label.split('\n');
        ctx.fillStyle = '#abb2bf';
        ctx.font = '8.5px JetBrains Mono, monospace';
        ctx.textAlign = 'center';
        const yOff = p.y < H / 2 ? -14 : 14;
        lines.forEach((line, li) => {
          ctx.fillText(line, p.x, p.y + yOff + li * 11);
        });
      }
    });

    // Path label
    const first = pos(path.steps[0]);
    ctx.fillStyle = active ? path.color : path.color + '80';
    ctx.font = (active ? 'bold ' : '') + '10px JetBrains Mono, monospace';
    ctx.textAlign = 'left';
    ctx.fillText(path.label, 4, 14 + PATHS.indexOf(path) * 16);

    ctx.restore();
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    // Column labels
    ctx.fillStyle = 'rgba(255,255,255,0.15)';
    ctx.font = '9px JetBrains Mono, monospace';
    ctx.textAlign = 'center';
    ['Query', 'Tools', 'Answer'].forEach((lbl, i) => {
      const x = [0.08, 0.46, 0.84][i] * W;
      ctx.fillText(lbl, x, H - 8);
    });
    // Separator lines
    [0.18, 0.72].forEach(fx => {
      ctx.strokeStyle = 'rgba(255,255,255,0.05)';
      ctx.lineWidth = 1;
      ctx.setLineDash([3, 4]);
      ctx.beginPath();
      ctx.moveTo(fx * W, 20);
      ctx.lineTo(fx * W, H - 20);
      ctx.stroke();
      ctx.setLineDash([]);
    });
    PATHS.forEach((p, i) => drawTrajectory(p, activeIdx === -1 || activeIdx === i));
  }

  draw();

  // Click detection on path labels (top-left area)
  canvas.addEventListener('click', evt => {
    const rect = canvas.getBoundingClientRect();
    const my = evt.clientY - rect.top;
    let hit = -1;
    PATHS.forEach((p, i) => {
      if (my >= 4 + i * 16 && my <= 16 + i * 16) hit = i;
    });
    // Also check clicking on nodes
    if (hit === -1) {
      const mx = evt.clientX - rect.left;
      PATHS.forEach((path, pi) => {
        path.steps.forEach(step => {
          const p = pos(step);
          if (Math.sqrt((mx - p.x)**2 + (my - p.y)**2) < 18) hit = pi;
        });
      });
    }
    activeIdx = (hit === activeIdx) ? -1 : hit;
    detail.style.color = activeIdx >= 0 ? PATHS[activeIdx].verdictColor : 'var(--muted2)';
    detail.textContent = activeIdx >= 0
      ? PATHS[activeIdx].verdict
      : 'Click any path to see why it passes or fails the trajectory eval →';
    draw();
  });
})();
</script>
</BaseLayout>

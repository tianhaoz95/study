      <div style="display:flex;align-items:center;gap:.3rem"><div style="width:12px;height:12px;border-radius:2px;background:#065f46"></div><span style="font-size:.68rem;color:var(--muted);font-family:var(--ff-mono)">Clean conditioning</span></div>
      <div style="display:flex;align-items:center;gap:.3rem"><div style="width:12px;height:12px;border-radius:2px;background:#92400e;border:1px dashed #f59e0b"></div><span style="font-size:.68rem;color:var(--muted);font-family:var(--ff-mono)">Noisy target (to denoise)</span></div>
    </div>

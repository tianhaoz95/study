// ── Capability overlap Venn diagram ──────────────────────────────────
(function() {
  const canvas = document.getElementById('overlap-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;

  // Capabilities data: which models need each capability
  const CAPS = [
    {
      id: 'visual_perception',
      name: 'Visual Perception & Scene Parsing',
      desc: 'Extracting objects, spatial relationships, depth cues, and scene layout from raw pixels. Each model must independently learn to see.',
      models: ['vlm', 'vla', 'wm'],
      color: '#ef4444',
      cost: 'high',
    },
    {
      id: 'spatial_reasoning',
      name: 'Spatial Reasoning & 3D Understanding',
      desc: 'Understanding object geometry, affordances, and how bodies occupy space. The VLM reasons about it for Q&A; the VLA needs it for grasping; the world model simulates it.',
      models: ['vlm', 'vla', 'wm'],
      color: '#f97316',
      cost: 'high',
    },
    {
      id: 'physics_intuition',
      name: 'Physics Intuition & Dynamics',
      desc: 'Predicting how objects move, fall, collide, or deform. The world model explicitly simulates this; the VLA implicitly needs it for safe actions; the VLM uses it for reasoning.',
      models: ['vlm', 'wm'],
      color: '#eab308',
      cost: 'medium',
    },
    {
      id: 'temporal_modeling',
      name: 'Temporal Sequence Modeling',
      desc: 'Modeling how scenes evolve over time — understanding video continuity, cause-and-effect chains, and action timing.',
      models: ['vla', 'wm'],
      color: '#22c55e',
      cost: 'medium',
    },
    {
      id: 'action_consequence',
      name: 'Action-Consequence Mapping',
      desc: 'Predicting what happens when a specific action is taken. The VLA must predict immediate outcomes; the world model simulates full rollouts.',
      models: ['vla', 'wm'],
      color: '#06b6d4',
      cost: 'high',
    },
    {
      id: 'language_grounding',
      name: 'Language Grounding in Vision',
      desc: 'Connecting natural language instructions ("pick up the red mug") to visual entities. Both the VLM and VLA must independently ground language to pixels.',
      models: ['vlm', 'vla'],
      color: '#8b5cf6',
      cost: 'medium',
    },
    {
      id: 'semantic_understanding',
      name: 'Semantic World Knowledge',
      desc: 'Knowing that mugs hold liquid, that knives are sharp, that plates go in the dishwasher. Common sense that each model learns separately from different data.',
      models: ['vlm', 'vla', 'wm'],
      color: '#ec4899',
      cost: 'medium',
    },
    {
      id: 'motor_planning',
      name: 'Motor Planning & Control',
      desc: 'Translating high-level intent into joint-level trajectories. Unique to the VLA — not needed by VLM or world model.',
      models: ['vla'],
      color: '#14b8a6',
      cost: 'none',
    },
    {
      id: 'future_generation',
      name: 'Future Visual State Generation',
      desc: 'Generating photorealistic future frames. Unique to the world model — it synthesizes what the world will look like next.',
      models: ['wm'],
      color: '#a855f7',
      cost: 'none',
    },
  ];

  const MODEL_META = {
    vlm: { label: 'VLM', color: '#8b5cf6', colorLight: '#c4b5fd' },
    vla: { label: 'VLA', color: '#06b6d4', colorLight: '#67e8f9' },
    wm:  { label: 'World Model', color: '#10b981', colorLight: '#6ee7b7' },
  };

  let highlightCap = null;
  let currentView = 'venn';

  // Circle centers for Venn (computed on resize)
  let circles = {};
  let R = 90;

  function computeCircles(W, H) {
    const cx = W / 2;
    const cy = H / 2 - 5;
    const spread = R * 0.62;
    circles = {
      vlm: { x: cx - spread, y: cy - spread * 0.4, r: R },
      vla: { x: cx + spread, y: cy - spread * 0.4, r: R },
      wm:  { x: cx,          y: cy + spread * 0.7,  r: R },
    };
  }

  function inCircle(px, py, c) {
    return Math.hypot(px - c.x, py - c.y) <= c.r;
  }

  function getRegion(px, py) {
    const inv = inCircle(px, py, circles.vlm);
    const ina = inCircle(px, py, circles.vla);
    const inw = inCircle(px, py, circles.wm);
    const m = [];
    if (inv) m.push('vlm');
    if (ina) m.push('vla');
    if (inw) m.push('wm');
    return m;
  }

  function drawVenn() {
    const W = canvas.clientWidth;
    const H = canvas.clientHeight;
    canvas.width = W * DPR;
    canvas.height = H * DPR;
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
    ctx.clearRect(0, 0, W, H);

    R = Math.min(W, H) * 0.28;
    computeCircles(W, H);

    // Draw circles with transparency
    Object.entries(circles).forEach(([key, c]) => {
      const meta = MODEL_META[key];
      ctx.beginPath();
      ctx.arc(c.x, c.y, c.r, 0, Math.PI * 2);
      ctx.fillStyle = hexToRgba(meta.color, 0.12);
      ctx.fill();
      ctx.strokeStyle = hexToRgba(meta.color, 0.5);
      ctx.lineWidth = 1.5;
      ctx.stroke();
    });

    // Highlight overlap for hovered capability
    if (highlightCap) {
      const cap = CAPS.find(c => c.id === highlightCap);
      if (cap) {
        // Draw highlighted region by sampling pixels (approximate)
        const step = 3;
        ctx.fillStyle = hexToRgba(cap.color, 0.3);
        for (let px = 0; px < W; px += step) {
          for (let py = 0; py < H; py += step) {
            const region = getRegion(px, py);
            if (region.length === 0) continue;
            // Check if this pixel is in all required models for this cap
            const match = cap.models.every(m => region.includes(m));
            // And optionally only in those models (for precise overlap)
            const extra = region.some(m => !cap.models.includes(m));
            if (match && !extra) {
              ctx.fillRect(px - step/2, py - step/2, step, step);
            }
          }
        }
        // Also draw a brighter border for the highlighted region
        ctx.save();
        ctx.beginPath();
        // Clip to intersection of required circles
        cap.models.forEach((m, i) => {
          if (i === 0) {
            ctx.arc(circles[m].x, circles[m].y, circles[m].r, 0, Math.PI * 2);
          } else {
            ctx.arc(circles[m].x, circles[m].y, circles[m].r, 0, Math.PI * 2);
          }
        });
        ctx.restore();
      }
    }

    // Draw model labels
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    Object.entries(circles).forEach(([key, c]) => {
      const meta = MODEL_META[key];
      // Position label at the outer edge of each circle
      const dx = c.x - W/2;
      const dy = c.y - (H/2 - 5);
      const dist = Math.hypot(dx, dy) || 1;
      const labelX = c.x + (dx / dist) * (R * 0.55);
      const labelY = c.y + (dy / dist) * (R * 0.55);

      ctx.font = 'bold 11px monospace';
      ctx.fillStyle = meta.colorLight;
      ctx.fillText(meta.label, labelX, labelY - 6);

      // Count capabilities
      const capCount = CAPS.filter(cap => cap.models.includes(key)).length;
      ctx.font = '9px monospace';
      ctx.fillStyle = hexToRgba(meta.color, 0.7);
      ctx.fillText(capCount + ' capabilities', labelX, labelY + 8);
    });

    // Draw overlap region labels
    // VLM ∩ VLA
    const vlmVla = { x: (circles.vlm.x + circles.vla.x) / 2, y: circles.vlm.y - R * 0.15 };
    drawOverlapCount(vlmVla.x, vlmVla.y, ['vlm', 'vla'], '#f59e0b');
    // VLM ∩ WM
    const vlmWm = { x: (circles.vlm.x + circles.wm.x) / 2 - R * 0.2, y: (circles.vlm.y + circles.wm.y) / 2 + R * 0.1 };
    drawOverlapCount(vlmWm.x, vlmWm.y, ['vlm', 'wm'], '#f59e0b');
    // VLA ∩ WM
    const vlaWm = { x: (circles.vla.x + circles.wm.x) / 2 + R * 0.2, y: (circles.vla.y + circles.wm.y) / 2 + R * 0.1 };
    drawOverlapCount(vlaWm.x, vlaWm.y, ['vla', 'wm'], '#f59e0b');
    // VLM ∩ VLA ∩ WM (center)
    const center = { x: (circles.vlm.x + circles.vla.x + circles.wm.x) / 3, y: (circles.vlm.y + circles.vla.y + circles.wm.y) / 3 };
    drawOverlapCount(center.x, center.y, ['vlm', 'vla', 'wm'], '#ef4444');
  }

  function drawOverlapCount(x, y, models, color) {
    const count = CAPS.filter(cap =>
      models.every(m => cap.models.includes(m)) &&
      cap.models.length === models.length
    ).length;
    const countAll = CAPS.filter(cap =>
      models.every(m => cap.models.includes(m))
    ).length;
    if (countAll === 0) return;

    // Draw a small pill badge
    const label = countAll + ' shared';
    ctx.font = 'bold 8px monospace';
    const tw = ctx.measureText(label).width;
    const pw = tw + 12;
    const ph = 16;

    ctx.fillStyle = hexToRgba(color, 0.2);
    ctx.beginPath();
    ctx.roundRect(x - pw/2, y - ph/2, pw, ph, 4);
    ctx.fill();
    ctx.strokeStyle = hexToRgba(color, 0.5);
    ctx.lineWidth = 1;
    ctx.stroke();

    ctx.fillStyle = color;
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText(label, x, y);
  }

  // Matrix view
  function renderMatrix() {
    const container = document.getElementById('overlap-view-matrix');
    if (!container) return;
    const models = ['vlm', 'vla', 'wm'];
    let html = '<div style="overflow-x:auto"><table style="width:100%;border-collapse:collapse;font-family:var(--ff-mono);font-size:.72rem">';
    html += '<thead><tr><th style="text-align:left;padding:.5rem .6rem;color:var(--muted);border-bottom:1px solid var(--border);font-weight:600">Capability</th>';
    models.forEach(m => {
      html += '<th style="text-align:center;padding:.5rem .6rem;color:' + MODEL_META[m].colorLight + ';border-bottom:1px solid var(--border);font-weight:600;min-width:70px">' + MODEL_META[m].label + '</th>';
    });
    html += '<th style="text-align:center;padding:.5rem .6rem;color:var(--muted);border-bottom:1px solid var(--border);font-weight:600;min-width:80px">Duplication</th></tr></thead><tbody>';

    CAPS.forEach(cap => {
      const hl = highlightCap === cap.id;
      const bg = hl ? 'rgba(139,92,246,.1)' : 'transparent';
      html += '<tr data-cap-row="' + cap.id + '" style="cursor:pointer;background:' + bg + ';transition:background .15s">';
      html += '<td style="padding:.45rem .6rem;color:var(--text2);border-bottom:1px solid rgba(255,255,255,.04)">' + cap.name + '</td>';
      models.forEach(m => {
        const has = cap.models.includes(m);
        const icon = has ? '<span style="color:' + MODEL_META[m].color + '">●</span>' : '<span style="color:var(--muted);opacity:.3">○</span>';
        html += '<td style="text-align:center;padding:.45rem .6rem;border-bottom:1px solid rgba(255,255,255,.04);font-size:.85rem">' + icon + '</td>';
      });
      const dupLevel = cap.models.length > 2 ? '3× ⚠' : cap.models.length > 1 ? '2×' : '1× (unique)';
      const dupColor = cap.models.length > 2 ? '#ef4444' : cap.models.length > 1 ? '#f59e0b' : '#10b981';
      html += '<td style="text-align:center;padding:.45rem .6rem;border-bottom:1px solid rgba(255,255,255,.04);color:' + dupColor + ';font-weight:600">' + dupLevel + '</td>';
      html += '</tr>';
    });

    html += '</tbody></table></div>';

    // Summary
    const tripleCount = CAPS.filter(c => c.models.length === 3).length;
    const doubleCount = CAPS.filter(c => c.models.length === 2).length;
    const uniqueCount = CAPS.filter(c => c.models.length === 1).length;
    const totalSlots = CAPS.reduce((s, c) => s + c.models.length, 0);
    const minSlots = CAPS.length;
    const wastedSlots = totalSlots - minSlots;
    html += '<div style="margin-top:.75rem;padding:.5rem .75rem;border-radius:6px;background:rgba(239,68,68,.08);border:1px solid rgba(239,68,68,.2);font-size:.72rem;font-family:var(--ff-mono);color:var(--muted2);line-height:1.6">';
    html += '<span style="color:#ef4444;font-weight:700">' + tripleCount + '</span> capabilities × 3 models + ';
    html += '<span style="color:#f59e0b;font-weight:700">' + doubleCount + '</span> capabilities × 2 models + ';
    html += '<span style="color:#10b981;font-weight:700">' + uniqueCount + '</span> unique = ';
    html += '<span style="color:#ef4444;font-weight:700">' + totalSlots + '</span> total capability slots vs <span style="color:#10b981;font-weight:700">' + minSlots + '</span> needed → ';
    html += '<span style="color:#ef4444;font-weight:700">' + wastedSlots + ' redundant implementations</span>';
    html += '</div>';

    container.innerHTML = html;

    // Attach hover events to matrix rows
    container.querySelectorAll('[data-cap-row]').forEach(row => {
      row.addEventListener('mouseenter', () => {
        highlightCap = row.dataset.capRow;
        renderLegend();
        renderMatrix();
      });
      row.addEventListener('mouseleave', () => {
        highlightCap = null;
        renderLegend();
        renderMatrix();
      });
    });
  }

  // Legend
  function renderLegend() {
    const legend = document.getElementById('overlap-legend');
    if (!legend) return;
    legend.innerHTML = CAPS.map(cap => {
      const isActive = highlightCap === cap.id;
      const modelLabels = cap.models.map(m => MODEL_META[m].label).join(' + ');
      const dupLabel = cap.models.length > 1
        ? ' → <span style="color:#ef4444;font-weight:600">' + cap.models.length + '× duplicated</span>'
        : ' → <span style="color:#10b981">unique</span>';
      return '<div class="overlap-cap' + (isActive ? ' active' : '') + '" data-cap="' + cap.id + '">' +
        '<div class="overlap-cap-icon" style="background:' + cap.color + '"></div>' +
        '<div class="overlap-cap-body">' +
          '<div class="overlap-cap-name">' + cap.name + '</div>' +
          '<div class="overlap-cap-models">' + modelLabels + dupLabel + '</div>' +
          '<div class="overlap-cap-desc">' + cap.desc + '</div>' +
        '</div>' +
      '</div>';
    }).join('');

    legend.querySelectorAll('.overlap-cap').forEach(el => {
      el.addEventListener('mouseenter', () => {
        highlightCap = el.dataset.cap;
        drawVenn();
        renderLegend();
        if (currentView === 'matrix') renderMatrix();
      });
      el.addEventListener('mouseleave', () => {
        highlightCap = null;
        drawVenn();
        renderLegend();
        if (currentView === 'matrix') renderMatrix();
      });
    });
  }

  // Cost summary
  function renderCostBars() {
    const container = document.getElementById('overlap-cost-rows');
    if (!container) return;

    const categories = [
      { label: 'Visual Processing', caps: ['visual_perception', 'spatial_reasoning'], color: '#8b5cf6' },
      { label: 'World Knowledge', caps: ['physics_intuition', 'semantic_understanding'], color: '#06b6d4' },
      { label: 'Action Reasoning', caps: ['action_consequence', 'temporal_modeling', 'language_grounding'], color: '#10b981' },
    ];

    container.innerHTML = categories.map(cat => {
      const relevant = CAPS.filter(c => cat.caps.includes(c.id));
      const totalModels = relevant.reduce((s, c) => s + c.models.length, 0);
      const minModels = relevant.length;
      const pctUseful = Math.round((minModels / totalModels) * 100);
      const pctWaste = 100 - pctUseful;

      return '<div class="overlap-cost-row">' +
        '<div class="overlap-cost-label">' + cat.label + '</div>' +
        '<div class="overlap-cost-track">' +
          '<div class="overlap-cost-fill" style="width:' + pctUseful + '%;background:' + hexToRgba(cat.color, 0.6) + '"><span>' + pctUseful + '% useful</span></div>' +
          '<div class="overlap-cost-dup" style="width:' + pctWaste + '%;background:rgba(239,68,68,.35)"><span>' + pctWaste + '% wasted</span></div>' +
        '</div>' +
      '</div>';
    }).join('');
  }

  // View toggle
  document.querySelectorAll('.overlap-mode-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.overlap-mode-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentView = btn.dataset.overlapView;
      const canvasWrap = canvas.parentElement;
      const matrixEl = document.getElementById('overlap-view-matrix');
      if (currentView === 'venn') {
        canvasWrap.style.display = 'flex';
        matrixEl.style.display = 'none';
        drawVenn();
      } else {
        canvasWrap.style.display = 'none';
        matrixEl.style.display = 'block';
        renderMatrix();
      }
    });
  });

  function hexToRgba(hex, a) {
    const r = parseInt(hex.slice(1, 3), 16);
    const g = parseInt(hex.slice(3, 5), 16);
    const b = parseInt(hex.slice(5, 7), 16);
    return 'rgba(' + r + ',' + g + ',' + b + ',' + a + ')';
  }

  // Init
  renderLegend();
  renderCostBars();
  setTimeout(() => drawVenn(), 80);
  window.addEventListener('resize', () => { if (currentView === 'venn') drawVenn(); });
})();

// ── Attention mask matrix visualization ──────────────────────────────
(function() {
  const canvas = document.getElementById('attn-matrix-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const descEl = document.getElementById('attn-matrix-desc');

  // Token definitions per mode
  const ATTN_MODES = {
    t2v: {
      tokens: [
        { label: 'text₁', type: 'ar' },
        { label: 'text₂', type: 'ar' },
        { label: 'text₃', type: 'ar' },
        { label: 'ViT₁', type: 'ar' },
        { label: 'ViT₂', type: 'ar' },
        { label: 'EOS', type: 'ar' },
        { label: 'BOG', type: 'ar' },
        { label: 'vid₁ñ', type: 'dm' },
        { label: 'vid₂ñ', type: 'dm' },
        { label: 'vid₃ñ', type: 'dm' },
        { label: 'aud₁ñ', type: 'dm' },
      ],
      desc: 'Text→Video+Audio: AR tokens form the text prompt (causal self-attention only). DM tokens are noisy video + audio frames. DM attends to everything; AR is walled off from DM — even though they share the same transformer layer during training.',
    },
    i2v: {
      tokens: [
        { label: 'text₁', type: 'ar' },
        { label: 'text₂', type: 'ar' },
        { label: 'ViT₁', type: 'ar' },
        { label: 'EOS', type: 'ar' },
        { label: 'BOG', type: 'ar' },
        { label: 'frm₁', type: 'dm-clean' },
        { label: 'frm₂ñ', type: 'dm' },
        { label: 'frm₃ñ', type: 'dm' },
        { label: 'frm₄ñ', type: 'dm' },
      ],
      desc: 'Image→Video: The first frame (frm₁) is clean conditioning — it sits in the DM subsequence but carries no noise. The noisy frames attend to it and to the full AR context. AR tokens remain causally isolated.',
    },
    policy: {
      tokens: [
        { label: 'text₁', type: 'ar' },
        { label: 'text₂', type: 'ar' },
        { label: 'EOS', type: 'ar' },
        { label: 'BOG', type: 'ar' },
        { label: 'ctx₁', type: 'dm-clean' },
        { label: 'ctx₂', type: 'dm-clean' },
        { label: 'vid₁ñ', type: 'dm' },
        { label: 'vid₂ñ', type: 'dm' },
        { label: 'act₁ñ', type: 'dm' },
        { label: 'act₂ñ', type: 'dm' },
      ],
      desc: 'Robot Policy: Clean video context + jointly noisy future video AND action tokens. The action and video tokens co-attend to each other and to the clean context + AR prompt. AR remains causal-only.',
    },
    vlm: {
      tokens: [
        { label: 'text₁', type: 'ar' },
        { label: 'text₂', type: 'ar' },
        { label: 'text₃', type: 'ar' },
        { label: 'ViT₁', type: 'ar' },
        { label: 'ViT₂', type: 'ar' },
        { label: 'ViT₃', type: 'ar' },
        { label: 'ans₁', type: 'ar' },
        { label: 'ans₂', type: 'ar' },
      ],
      desc: 'VLM Only: No DM subsequence at all — pure causal autoregressive attention like a standard language model. The entire matrix is a lower triangle. This is why AR quality is preserved: the mask makes it behave identically to a standalone VLM.',
    },
  };

  let currentAttnMode = 't2v';
  let hoverCell = null;

  function isDM(tok) { return tok.type === 'dm' || tok.type === 'dm-clean'; }
  function isAR(tok) { return tok.type === 'ar'; }

  function canAttend(queryTok, queryIdx, keyTok, keyIdx, tokens) {
    if (isAR(queryTok)) {
      // AR uses causal attention over AR tokens only
      if (isDM(keyTok)) return false;
      return keyIdx <= queryIdx;
    } else {
      // DM uses full attention over everything
      return true;
    }
  }

  function cellColor(queryTok, keyTok, allowed) {
    if (!allowed) return 'blocked';
    if (isAR(queryTok) && isAR(keyTok)) return 'ar-ar';
    if (isDM(queryTok) && isDM(keyTok)) return 'dm-dm';
    if (isDM(queryTok) && isAR(keyTok)) return 'dm-ar';
    return 'ar-ar';
  }

  function getThemeColors() {
    const isLight = document.documentElement.dataset.theme === 'light';
    return {
      'ar-ar':   isLight ? 'rgba(124,58,237,.35)' : 'rgba(139,92,246,.55)',
      'dm-dm':   isLight ? 'rgba(6,150,180,.3)'   : 'rgba(6,182,212,.45)',
      'dm-ar':   isLight ? 'rgba(200,120,0,.3)'    : 'rgba(245,158,11,.45)',
      'blocked': isLight ? 'rgba(200,50,50,.08)'   : 'rgba(239,68,68,.1)',
      bg:        isLight ? '#f0f2f8' : 'rgba(17,24,39,.3)',
      grid:      isLight ? 'rgba(0,0,0,.08)' : 'rgba(255,255,255,.06)',
      text:      isLight ? '#1e2535' : '#e2e8f0',
      muted:     isLight ? '#6b7a99' : '#6b7280',
      arLabel:   isLight ? '#6d28d9' : '#c4b5fd',
      dmLabel:   isLight ? '#0e7490' : '#67e8f9',
      dmcLabel:  isLight ? '#047857' : '#6ee7b7',
      hoverBorder: isLight ? '#0f1117' : '#ffffff',
    };
  }

  function drawAttnMatrix() {
    const W = canvas.clientWidth;
    const H = canvas.clientHeight;
    canvas.width = W * DPR;
    canvas.height = H * DPR;
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);

    const mode = ATTN_MODES[currentAttnMode];
    const tokens = mode.tokens;
    const N = tokens.length;
    const colors = getThemeColors();

    // Layout
    const labelW = 50;
    const labelH = 46;
    const pad = 8;
    const matrixSize = Math.min(W - labelW - pad * 2, H - labelH - pad * 2 - 20);
    const cellSize = Math.floor(matrixSize / N);
    const gridW = cellSize * N;
    const ox = labelW + (W - labelW - gridW) / 2;
    const oy = labelH + pad;

    // Background
    ctx.clearRect(0, 0, W, H);

    // Draw cells
    for (let qi = 0; qi < N; qi++) {
      for (let ki = 0; ki < N; ki++) {
        const allowed = canAttend(tokens[qi], qi, tokens[ki], ki, tokens);
        const ctype = cellColor(tokens[qi], tokens[ki], allowed);
        const x = ox + ki * cellSize;
        const y = oy + qi * cellSize;

        ctx.fillStyle = colors[ctype];
        ctx.fillRect(x, y, cellSize, cellSize);

        // Grid lines
        ctx.strokeStyle = colors.grid;
        ctx.lineWidth = 0.5;
        ctx.strokeRect(x, y, cellSize, cellSize);
      }
    }

    // Hover highlight
    if (hoverCell) {
      const { qi, ki } = hoverCell;
      if (qi >= 0 && qi < N && ki >= 0 && ki < N) {
        // Highlight row
        ctx.fillStyle = 'rgba(255,255,255,.04)';
        ctx.fillRect(ox, oy + qi * cellSize, gridW, cellSize);
        // Highlight column
        ctx.fillRect(ox + ki * cellSize, oy, cellSize, gridW);
        // Highlight cell
        ctx.strokeStyle = colors.hoverBorder;
        ctx.lineWidth = 2;
        ctx.strokeRect(ox + ki * cellSize + 1, oy + qi * cellSize + 1, cellSize - 2, cellSize - 2);
      }
    }

    // AR / DM region divider
    const firstDM = tokens.findIndex(t => isDM(t));
    if (firstDM > 0) {
      const divX = ox + firstDM * cellSize;
      const divY = oy + firstDM * cellSize;
      ctx.setLineDash([4, 3]);
      ctx.strokeStyle = colors.muted;
      ctx.lineWidth = 1.5;
      // Vertical divider
      ctx.beginPath();
      ctx.moveTo(divX, oy);
      ctx.lineTo(divX, oy + gridW);
      ctx.stroke();
      // Horizontal divider
      ctx.beginPath();
      ctx.moveTo(ox, divY);
      ctx.lineTo(ox + gridW, divY);
      ctx.stroke();
      ctx.setLineDash([]);

      // Region labels
      ctx.font = '8px monospace';
      ctx.textAlign = 'center';
      ctx.fillStyle = colors.arLabel;
      ctx.fillText('AR→AR', ox + (firstDM * cellSize) / 2, oy - 30);
      ctx.fillText('(causal)', ox + (firstDM * cellSize) / 2, oy - 20);
      ctx.fillStyle = 'rgba(239,68,68,.6)';
      ctx.fillText('AR→DM', ox + firstDM * cellSize + (N - firstDM) * cellSize / 2, oy - 30);
      ctx.fillText('(BLOCKED)', ox + firstDM * cellSize + (N - firstDM) * cellSize / 2, oy - 20);
      ctx.fillStyle = colors.dmLabel;

      const dmMidX = ox + firstDM * cellSize + (N - firstDM) * cellSize / 2;
      const dmMidY = oy + firstDM * cellSize + (N - firstDM) * cellSize / 2;
      if ((N - firstDM) * cellSize > 40) {
        ctx.save();
        ctx.translate(ox + gridW + 12, oy + firstDM * cellSize + (N - firstDM) * cellSize / 2);
        ctx.rotate(0);
        ctx.textAlign = 'center';
        ctx.fillStyle = colors.dmLabel;
        ctx.fillText('DM→DM', 0, -4);
        ctx.fillText('(full)', 0, 6);
        ctx.restore();
      }
    }

    // Column labels (keys) — top
    ctx.textAlign = 'center';
    ctx.textBaseline = 'bottom';
    tokens.forEach((tok, i) => {
      const x = ox + i * cellSize + cellSize / 2;
      ctx.save();
      ctx.translate(x, oy - 4);
      ctx.rotate(-Math.PI / 4);
      ctx.font = (cellSize > 24 ? '8' : '7') + 'px monospace';
      ctx.textAlign = 'left';
      ctx.fillStyle = isDM(tok) ? (tok.type === 'dm-clean' ? colors.dmcLabel : colors.dmLabel) : colors.arLabel;
      ctx.fillText(tok.label, 0, 0);
      ctx.restore();
    });

    // Row labels (queries) — left
    ctx.textAlign = 'right';
    ctx.textBaseline = 'middle';
    tokens.forEach((tok, i) => {
      const y = oy + i * cellSize + cellSize / 2;
      ctx.font = (cellSize > 24 ? '8' : '7') + 'px monospace';
      ctx.fillStyle = isDM(tok) ? (tok.type === 'dm-clean' ? colors.dmcLabel : colors.dmLabel) : colors.arLabel;
      ctx.fillText(tok.label, ox - 5, y);
    });

    // Axis titles
    ctx.font = 'bold 8px monospace';
    ctx.fillStyle = colors.muted;
    ctx.textAlign = 'center';
    ctx.textBaseline = 'top';
    ctx.fillText('← Keys (attending TO) →', ox + gridW / 2, oy + gridW + 6);
    ctx.save();
    ctx.translate(ox - labelW + 6, oy + gridW / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.fillText('← Queries (attending FROM) →', 0, 0);
    ctx.restore();

    // Hover tooltip
    if (hoverCell && hoverCell.qi >= 0 && hoverCell.qi < N && hoverCell.ki >= 0 && hoverCell.ki < N) {
      const q = tokens[hoverCell.qi];
      const k = tokens[hoverCell.ki];
      const allowed = canAttend(q, hoverCell.qi, k, hoverCell.ki, tokens);
      const desc = allowed
        ? (q.label + ' ✓ attends to ' + k.label)
        : (q.label + ' ✗ BLOCKED from ' + k.label);
      if (descEl) descEl.textContent = desc;
    } else {
      if (descEl) descEl.textContent = mode.desc;
    }
  }

  // Mouse tracking
  canvas.addEventListener('mousemove', (e) => {
    const rect = canvas.getBoundingClientRect();
    const mx = e.clientX - rect.left;
    const my = e.clientY - rect.top;

    const mode = ATTN_MODES[currentAttnMode];
    const N = mode.tokens.length;
    const W = canvas.clientWidth;
    const H = canvas.clientHeight;
    const labelW = 50, labelH = 46, pad = 8;
    const matrixSize = Math.min(W - labelW - pad * 2, H - labelH - pad * 2 - 20);
    const cellSize = Math.floor(matrixSize / N);
    const gridW = cellSize * N;
    const ox = labelW + (W - labelW - gridW) / 2;
    const oy = labelH + pad;

    const ki = Math.floor((mx - ox) / cellSize);
    const qi = Math.floor((my - oy) / cellSize);
    if (ki >= 0 && ki < N && qi >= 0 && qi < N) {
      hoverCell = { qi, ki };
    } else {
      hoverCell = null;
    }
    drawAttnMatrix();
  });

  canvas.addEventListener('mouseleave', () => {
    hoverCell = null;
    drawAttnMatrix();
  });

  // Mode switching
  document.querySelectorAll('#attn-mode-btns .overlap-mode-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('#attn-mode-btns .overlap-mode-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentAttnMode = btn.dataset.attnMode;
      hoverCell = null;
      drawAttnMatrix();
    });
  });

  // Redraw on theme change
  const observer = new MutationObserver(() => drawAttnMatrix());
  observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

  // Initial draw
  setTimeout(() => drawAttnMatrix(), 100);
  window.addEventListener('resize', () => drawAttnMatrix());
})();
</script>
</BaseLayout>

<span class="cs-line">    vla = <span class="fn">load_model</span>(<span class="str">"pi0.5"</span>)</span>
<span class="cs-line">    actions = vla.<span class="fn">predict_actions</span>(image, plan)</span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="cmt"># Step 3: World model simulates future state</span></span>
<span class="cs-line">    world = <span class="fn">load_model</span>(<span class="str">"Cosmos-Predict2.5"</span>)</span>
<span class="cs-line">    future = world.<span class="fn">simulate</span>(image, actions)</span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="cmt"># 3 models, 3 inference passes, no shared repr</span></span>
<span class="cs-line">    <span class="kw">return</span> robot.<span class="fn">execute</span>(actions)</span>
<span class="cs-line"> </span>
<span class="cs-line hl-g"><span class="kw">def</span> <span class="fn">clean_table_cosmos3</span>(robot, image):</span>
<span class="cs-line hl-g">    model = <span class="fn">load_model</span>(<span class="str">"Cosmos3-Super"</span>)</span>
<span class="cs-line hl-g">    <span class="cmt"># One model: reason, simulate, and act</span></span>
<span class="cs-line hl-g">    actions = model.<span class="fn">policy</span>(image, <span class="str">"clean the table"</span>)</span>
<span class="cs-line hl-g">    future  = model.<span class="fn">forward_dynamics</span>(image, actions)</span>
<span class="cs-line hl-g">    plan    = model.<span class="fn">reason</span>(image, <span class="str">"what is the plan?"</span>)</span>
<span class="cs-line hl-g">    <span class="kw">return</span> robot.<span class="fn">execute</span>(actions)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Cosmos 3 model scales:</span>
<span class="cs-line cmt">#   Edge:  4B total  (2B dense transformer)</span>
<span class="cs-line cmt">#   Nano:  16B total (8B dense, 36 layers)</span>
<span class="cs-line cmt">#   Super: 64B total (32B dense, 64 layers)</span>
<span class="cs-line cmt"># Each scale has BOTH reasoner + generator towers.</span>
      </pre>
    </div>

    <!-- tokens panel -->
    <div class="cs-panel" id="panel-tokens">
      <pre class="cs-pre">
<span class="cs-line cmt"># Token arrangement — unified format across all modes</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># AR subsequence (autoregressive, causal)</span>
<span class="cs-line hl-p">AR = [l₁, l₂, …, lₙ,  <span class="cmt"># language tokens</span></span>
<span class="cs-line hl-p">      v₁ᵃʳ, v₂ᵃʳ, …, <span class="cmt"># ViT-encoded vision (understanding)</span></span>
<span class="cs-line hl-p">      &lt;EOS&gt;, &lt;BOG&gt;]    <span class="cmt"># end-of-seq, begin-of-generation</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># DM subsequence (diffusion, full attention)</span>
<span class="cs-line cmt"># Rule: clean conditioning BEFORE noisy targets</span>
<span class="cs-line hl-c">DM = [v₁ᶜˡᵉᵃⁿ, …, vₚᶜˡᵉᵃⁿ,  <span class="cmt"># clean context frames</span></span>
<span class="cs-line hl-c">      s₁ᶜˡᵉᵃⁿ, …,           <span class="cmt"># clean audio (if any)</span></span>
<span class="cs-line hl-c">      a₁ᶜˡᵉᵃⁿ, …,           <span class="cmt"># clean actions (if any)</span></span>
<span class="cs-line hl-a">      ṽₚ₊₁, …, ṽₙ,          <span class="cmt"># NOISY target video</span></span>
<span class="cs-line hl-a">      s̃, ã]                 <span class="cmt"># NOISY target audio/action</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Encoders:</span>
<span class="cs-line cmt">#   ViT (16×16 patch, 2×2 merge) — frozen during gen</span>
<span class="cs-line cmt">#   VAE (4× temporal, 32×32 spatial) — frozen always</span>
<span class="cs-line cmt">#   Audio VAE (25 tok/sec, 48 kHz stereo) — frozen</span>
<span class="cs-line cmt">#   Action proj (domain-specific W_in, shared MoT)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Action representation (e.g. single-arm robot):</span>
<span class="cs-line hl-g">ego_pose   = <span class="fn">relative_SE3</span>(T_prev, T_curr)  <span class="cmt"># 9D</span></span>
<span class="cs-line hl-g">effector   = <span class="fn">relative_SE3</span>(E_prev, E_curr)  <span class="cmt"># 9D</span></span>
<span class="cs-line hl-g">gripper    = open_close_value               <span class="cmt"># 1D</span></span>
<span class="cs-line hl-g">action_vec = [ego_pose, effector, gripper]  <span class="cmt"># 19D total</span></span>
<span class="cs-line hl-g">action_tok = W_in @ action_vec + b_in       <span class="cmt"># → d_model</span></span>
      </pre>
    </div>

    <!-- mot panel -->
    <div class="cs-panel" id="panel-mot">
      <pre class="cs-pre">
<span class="cs-line cmt"># Mixture-of-Transformers (MoT) — per-layer pseudocode</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">mot_layer</span>(AR_tokens, DM_tokens):</span>
<span class="cs-line hl-p">    <span class="cmt"># Two towers, independent LayerNorm + FFN</span></span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="cmt"># Reasoner tower (initialized from VLM)</span></span>
<span class="cs-line">    AR_n = <span class="fn">layernorm_AR</span>(AR_tokens)</span>
<span class="cs-line hl-c">    Q_AR, K_AR, V_AR = <span class="fn">proj_AR</span>(AR_n)</span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="cmt"># Generator tower (also initialized from VLM)</span></span>
<span class="cs-line">    DM_n = <span class="fn">layernorm_DM</span>(DM_tokens)</span>
<span class="cs-line hl-a">    Q_DM, K_DM, V_DM = <span class="fn">proj_DM</span>(DM_n)</span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="cmt"># Shared attention — the asymmetric rule:</span></span>
<span class="cs-line hl-g">    <span class="cmt"># AR uses causal self-attention (no DM leakage)</span></span>
<span class="cs-line hl-g">    O_AR = <span class="fn">attn_causal</span>(Q_AR, K_AR, V_AR)</span>
<span class="cs-line"> </span>
<span class="cs-line hl-g">    <span class="cmt"># DM attends to ALL keys/values (AR + DM)</span></span>
<span class="cs-line hl-g">    K_all = <span class="fn">concat</span>(K_AR, K_DM)  <span class="cmt"># full context</span></span>
<span class="cs-line hl-g">    V_all = <span class="fn">concat</span>(V_AR, V_DM)</span>
<span class="cs-line hl-g">    O_DM = <span class="fn">attn_full</span>(Q_DM, K_all, V_all)</span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="cmt"># Independent FFN per tower</span></span>
<span class="cs-line">    AR_out = <span class="fn">ffn_AR</span>(<span class="fn">layernorm_AR2</span>(O_AR))</span>
<span class="cs-line">    DM_out = <span class="fn">ffn_DM</span>(<span class="fn">layernorm_DM2</span>(O_DM))</span>
<span class="cs-line">    <span class="kw">return</span> AR_out, DM_out</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Key properties:</span>
<span class="cs-line cmt">#   AR output is NEVER influenced by DM tokens</span>
<span class="cs-line cmt">#   → preserves causal LM text generation</span>
<span class="cs-line cmt">#   DM output sees the full AR prompt</span>
<span class="cs-line cmt">#   → generation is conditioned on reasoning</span>
<span class="cs-line cmt">#   Both towers share identical structure</span>
<span class="cs-line cmt">#   → doubled params, same FLOPs profile</span>
      </pre>
    </div>

    <!-- modes panel -->
    <div class="cs-panel" id="panel-modes">
      <pre class="cs-pre">
<span class="cs-line cmt"># Six generation modes — same weights, different layouts</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># 1. VLM (no DM tokens)</span>
<span class="cs-line hl-p">S_VLM = [l₁, …, lₙ]                <span class="cmt"># AR only</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># 2. Text-to-Image</span>
<span class="cs-line hl-p">S_T2I = [SAR, ṽ₁]                  <span class="cmt"># one noisy image</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># 3. Text-to-Video (+ audio)</span>
<span class="cs-line hl-p">S_T2V = [SAR, ṽ₁:N, s̃]            <span class="cmt"># N video + audio</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># 4. Image-to-Video</span>
<span class="cs-line hl-c">S_I2V = [SAR,</span>
<span class="cs-line hl-c">         v₁,          <span class="cmt"># CLEAN first frame</span></span>
<span class="cs-line hl-a">         ṽ₂:N]        <span class="cmt"># noisy continuation</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># 5. Forward Dynamics (sim future given action)</span>
<span class="cs-line hl-c">S_FD  = [SAR,</span>
<span class="cs-line hl-c">         v_ctx, a_clean,  <span class="cmt"># clean video + action</span></span>
<span class="cs-line hl-a">         ṽ_future]       <span class="cmt"># noisy future video</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># 6. Policy (co-generate action + video)</span>
<span class="cs-line hl-c">S_POL = [SAR,</span>
<span class="cs-line hl-c">         v_ctx,           <span class="cmt"># clean context</span></span>
<span class="cs-line hl-a">         ṽ_future, ã]    <span class="cmt"># BOTH noisy</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Training objective: flow-matching velocity pred</span>
<span class="cs-line cmt">#   for DM tokens: predict (x_clean - x_noise)</span>
<span class="cs-line cmt">#   for AR tokens: standard cross-entropy NTP</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Action: domain-aware projection only</span>
<span class="cs-line cmt">#   Domain k → W_in^(k) @ action + b_in^(k)</span>
<span class="cs-line cmt">#   Shared MoT backbone for all embodiments</span>
      </pre>
    </div>

    <!-- time panel -->
    <div class="cs-panel" id="panel-time">
      <pre class="cs-pre">
<span class="cs-line cmt"># 3D MRoPE with absolute temporal modulation</span>
<span class="cs-line cmt"># Each token gets (t, h, w) position triplet</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Language: t = h = w = token_index (1D RoPE)</span>
<span class="cs-line cmt"># ViT vision: t = frame_idx, h/w = spatial grid</span>
<span class="cs-line cmt"># VAE video:  t, h, w = absolute within-video</span>
<span class="cs-line cmt"># Audio:      t = hop_index, h = w = 0</span>
<span class="cs-line cmt"># Action:     t = sample_index, h = w = 0</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="cmt"># FPS Modulation — align to physical time axis</span></span>
<span class="cs-line hl-p">TPS_base = 24 / 4       <span class="cmt"># = 6 (24 FPS base, 4× VAE)</span></span>
<span class="cs-line hl-p">TPS_video = fps / 4     <span class="cmt"># depends on video frame rate</span></span>
<span class="cs-line hl-p">TPS_audio = 48000/1920  <span class="cmt"># ≈ 25 tokens/sec</span></span>
<span class="cs-line hl-p">TPS_action = action_hz  <span class="cmt"># 10 Hz robot / 30 Hz vehicle</span></span>
<span class="cs-line"> </span>
<span class="cs-line hl-g"><span class="cmt"># δt per token = how far t advances per token</span></span>
<span class="cs-line hl-g">δt = TPS_base / TPS</span>
<span class="cs-line hl-g"><span class="cmt"># 16 FPS: TPS=4,   δt=1.50 → 1s = 6 pos units</span></span>
<span class="cs-line hl-g"><span class="cmt"># 24 FPS: TPS=6,   δt=1.00 → 1s = 6 pos units</span></span>
<span class="cs-line hl-g"><span class="cmt"># 30 FPS: TPS=7.5, δt=0.80 → 1s = 6 pos units</span></span>
<span class="cs-line hl-g"><span class="cmt"># audio:  TPS=25,  δt=0.24 → 1s = 6 pos units</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># AR-DM temporal margin = 15000 pos units</span>
<span class="cs-line cmt"># prevents checkerboard artifacts from adjacent</span>
<span class="cs-line cmt"># text/vision position overlap at layer boundary</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Within-video coordinates reset to 0 at each</span>
<span class="cs-line cmt"># new video segment — absolute within-segment</span>
      </pre>
    </div>

    <!-- results panel -->
    <div class="cs-panel" id="panel-results">
      <pre class="cs-pre">

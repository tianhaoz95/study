<script>
// ── TOC + sidebar toggles ────────────────────────────────────────────
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});
const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ── Code sidebar tab switching ────────────────────────────────────────
const tabMeta = {
  problem: { file: 'cosmos3/problem.py',  title: 'The Problem' },
  tokens:  { file: 'cosmos3/tokens.py',   title: 'Token Language' },
  mot:     { file: 'cosmos3/mot.py',      title: 'MoT Architecture' },
  modes:   { file: 'cosmos3/modes.py',    title: 'Generation Modes' },
  time:    { file: 'cosmos3/temporal.py', title: 'Time Alignment' },
  results: { file: 'cosmos3/results.py',  title: 'Results' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ── IntersectionObserver: TOC + sidebar sync ──────────────────────────
const sectionMap = {
  's-problem': 'problem',
  's-tokens':  'tokens',
  's-mot':     'mot',
  's-modes':   'modes',
  's-time':    'time',
  's-results': 'results',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ── Token sequence canvas ─────────────────────────────────────────────
const MODES = {
  vlm: {
    desc: 'Language model mode — no DM tokens. Next-token prediction only (causal AR). Vision inputs (ViT) may be present in the AR stream for image understanding.',
    blocks: [
      { label: 'text tokens', color: '#5b21b6', width: 4, ar: true },
      { label: 'ViT vision', color: '#4c1d95', width: 2, ar: true },
      { label: 'EOS', color: '#0e7490', width: 1, ar: true },
      { label: '→ next token', color: '#065f46', width: 1, ar: true, output: true },
    ],
    divAfter: 100, // no divider
  },
  t2i: {
    desc: 'Text-to-Image — text in AR, single noisy image in DM. Flow-matching denoises the image conditioned on the language context.',
    blocks: [
      { label: 'text', color: '#5b21b6', width: 3, ar: true },
      { label: 'EOS BOG', color: '#0e7490', width: 1, ar: true },
      { label: 'noisy image', color: '#92400e', width: 3, ar: false, noisy: true },
    ],
    divAfter: 4,
  },
  t2v: {
    desc: 'Text-to-Video with optional audio — text in AR, noisy video frames followed by noisy audio in DM. Video and audio are jointly denoised.',
    blocks: [
      { label: 'text', color: '#5b21b6', width: 3, ar: true },
      { label: 'EOS BOG', color: '#0e7490', width: 1, ar: true },
      { label: 'noisy frame 1', color: '#92400e', width: 2, ar: false, noisy: true },
      { label: 'noisy frame 2', color: '#92400e', width: 2, ar: false, noisy: true },
      { label: 'noisy frame N', color: '#92400e', width: 2, ar: false, noisy: true },
      { label: 'noisy audio', color: '#78350f', width: 2, ar: false, noisy: true },
    ],
    divAfter: 4,
  },
  i2v: {
    desc: 'Image-to-Video — text in AR, then CLEAN first frame (green) followed by noisy target frames (amber). The model continues the video from the given image.',
    blocks: [
      { label: 'text', color: '#5b21b6', width: 3, ar: true },
      { label: 'EOS BOG', color: '#0e7490', width: 1, ar: true },
      { label: 'clean frame 1', color: '#065f46', width: 2, ar: false, noisy: false },
      { label: 'noisy frame 2', color: '#92400e', width: 2, ar: false, noisy: true },
      { label: 'noisy frame N', color: '#92400e', width: 2, ar: false, noisy: true },
    ],
    divAfter: 4,
  },
  fd: {
    desc: 'Forward Dynamics — given clean video context + clean action tokens, predict the noisy future video. This is the world simulator: action → future visual state.',
    blocks: [
      { label: 'text', color: '#5b21b6', width: 3, ar: true },
      { label: 'EOS BOG', color: '#0e7490', width: 1, ar: true },
      { label: 'clean vid ctx', color: '#065f46', width: 2, ar: false, noisy: false },
      { label: 'clean action', color: '#14532d', width: 2, ar: false, noisy: false },
      { label: 'noisy future vid', color: '#92400e', width: 3, ar: false, noisy: true },
    ],
    divAfter: 4,
  },
  policy: {
    desc: 'Robot Policy — clean video context, then BOTH future video AND action tokens are noisy. The model co-generates the action sequence and its visual consequence.',
    blocks: [
      { label: 'text', color: '#5b21b6', width: 3, ar: true },
      { label: 'EOS BOG', color: '#0e7490', width: 1, ar: true },
      { label: 'clean vid ctx', color: '#065f46', width: 2, ar: false, noisy: false },
      { label: 'noisy future vid', color: '#92400e', width: 2, ar: false, noisy: true },
      { label: 'noisy action', color: '#78350f', width: 2, ar: false, noisy: true },
    ],
    divAfter: 4,
  },
};

let currentMode = 'vlm';
function renderTokenSeq(modeKey) {
  const mode = MODES[modeKey];
  const container = document.getElementById('tok-seq-container');
  if (!container) return;
  const seq = document.createElement('div');
  seq.className = 'tok-seq';

  const UNIT = 28;
  let passedDiv = false;
  let arCount = 0;
  let dmCount = 0;
  mode.blocks.forEach((b, i) => {
    if (!passedDiv && !b.ar && mode.divAfter <= (arCount)) {
      const divider = document.createElement('div');
      divider.className = 'tok-divider';
      const divWrap = document.createElement('div');
      divWrap.style.cssText = 'display:flex;flex-direction:column;align-items:center;gap:3px';
      const divLabel = document.createElement('div');
      divLabel.className = 'tok-section-lbl';
      divLabel.textContent = 'AR ← | → DM';
      divWrap.appendChild(divLabel);
      divWrap.appendChild(divider);
      seq.appendChild(divWrap);
      passedDiv = true;
    }
    if (b.ar) arCount += b.width; else dmCount += b.width;

    const block = document.createElement('div');
    block.className = 'tok-block';
    const rect = document.createElement('div');
    rect.className = 'tok-rect';
    rect.style.cssText = `width:${b.width * UNIT - 2}px;background:${b.color};${b.noisy ? 'border:1.5px dashed #f59e0b;' : ''}${b.output ? 'border:1.5px solid #10b981;' : ''}`;
    if (b.width > 1) {
      rect.style.fontSize = '.55rem';
      rect.textContent = b.label.split(' ').pop();
    }
    const lbl = document.createElement('div');
    lbl.className = 'tok-lbl';
    lbl.textContent = b.label;
    block.appendChild(rect);
    block.appendChild(lbl);
    seq.appendChild(block);
  });

  container.innerHTML = '';
  container.appendChild(seq);
  document.getElementById('tok-mode-desc').textContent = mode.desc;
}


<span class="cs-line cmt">  500 iters: MT=24.6%, PT=0.0%</span>
<span class="cs-line cmt">  2000 iters: MT=97.4%</span>
      </pre>
    </div>

  </div>
</aside>

</div><!-- /post-grid -->

<script>
// ── TOC + sidebar toggles ────────────────────────────────────────────
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});
const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ── Code sidebar tab switching ────────────────────────────────────────
const tabMeta = {
  problem: { file: 'cosmos3/problem.py',  title: 'The Problem' },
  tokens:  { file: 'cosmos3/tokens.py',   title: 'Token Language' },
  mot:     { file: 'cosmos3/mot.py',      title: 'MoT Architecture' },
  modes:   { file: 'cosmos3/modes.py',    title: 'Generation Modes' },
  time:    { file: 'cosmos3/temporal.py', title: 'Time Alignment' },
  results: { file: 'cosmos3/results.py',  title: 'Results' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ── IntersectionObserver: TOC + sidebar sync ──────────────────────────
const sectionMap = {
  's-problem': 'problem',
  's-tokens':  'tokens',
  's-mot':     'mot',
  's-modes':   'modes',
  's-time':    'time',
  's-results': 'results',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ── Token sequence canvas ─────────────────────────────────────────────
const MODES = {
  vlm: {
    desc: 'Language model mode — no DM tokens. Next-token prediction only (causal AR). Vision inputs (ViT) may be present in the AR stream for image understanding.',
    blocks: [
      { label: 'text tokens', color: '#5b21b6', width: 4, ar: true },
      { label: 'ViT vision', color: '#4c1d95', width: 2, ar: true },
      { label: 'EOS', color: '#0e7490', width: 1, ar: true },
      { label: '→ next token', color: '#065f46', width: 1, ar: true, output: true },
    ],
    divAfter: 100, // no divider
  },
  t2i: {
    desc: 'Text-to-Image — text in AR, single noisy image in DM. Flow-matching denoises the image conditioned on the language context.',
    blocks: [
      { label: 'text', color: '#5b21b6', width: 3, ar: true },
      { label: 'EOS BOG', color: '#0e7490', width: 1, ar: true },
      { label: 'noisy image', color: '#92400e', width: 3, ar: false, noisy: true },
    ],
    divAfter: 4,
  },
  t2v: {
    desc: 'Text-to-Video with optional audio — text in AR, noisy video frames followed by noisy audio in DM. Video and audio are jointly denoised.',
    blocks: [
      { label: 'text', color: '#5b21b6', width: 3, ar: true },
      { label: 'EOS BOG', color: '#0e7490', width: 1, ar: true },
      { label: 'noisy frame 1', color: '#92400e', width: 2, ar: false, noisy: true },
      { label: 'noisy frame 2', color: '#92400e', width: 2, ar: false, noisy: true },
      { label: 'noisy frame N', color: '#92400e', width: 2, ar: false, noisy: true },
      { label: 'noisy audio', color: '#78350f', width: 2, ar: false, noisy: true },
    ],
    divAfter: 4,
  },
  i2v: {
    desc: 'Image-to-Video — text in AR, then CLEAN first frame (green) followed by noisy target frames (amber). The model continues the video from the given image.',
    blocks: [
      { label: 'text', color: '#5b21b6', width: 3, ar: true },
      { label: 'EOS BOG', color: '#0e7490', width: 1, ar: true },
      { label: 'clean frame 1', color: '#065f46', width: 2, ar: false, noisy: false },
      { label: 'noisy frame 2', color: '#92400e', width: 2, ar: false, noisy: true },
      { label: 'noisy frame N', color: '#92400e', width: 2, ar: false, noisy: true },
    ],
    divAfter: 4,
  },
  fd: {
    desc: 'Forward Dynamics — given clean video context + clean action tokens, predict the noisy future video. This is the world simulator: action → future visual state.',
    blocks: [
      { label: 'text', color: '#5b21b6', width: 3, ar: true },
      { label: 'EOS BOG', color: '#0e7490', width: 1, ar: true },
      { label: 'clean vid ctx', color: '#065f46', width: 2, ar: false, noisy: false },
      { label: 'clean action', color: '#14532d', width: 2, ar: false, noisy: false },
      { label: 'noisy future vid', color: '#92400e', width: 3, ar: false, noisy: true },
    ],
    divAfter: 4,
  },
  policy: {
    desc: 'Robot Policy — clean video context, then BOTH future video AND action tokens are noisy. The model co-generates the action sequence and its visual consequence.',
    blocks: [
      { label: 'text', color: '#5b21b6', width: 3, ar: true },
      { label: 'EOS BOG', color: '#0e7490', width: 1, ar: true },
      { label: 'clean vid ctx', color: '#065f46', width: 2, ar: false, noisy: false },
      { label: 'noisy future vid', color: '#92400e', width: 2, ar: false, noisy: true },
      { label: 'noisy action', color: '#78350f', width: 2, ar: false, noisy: true },
    ],
    divAfter: 4,
  },
};

let currentMode = 'vlm';
function renderTokenSeq(modeKey) {
  const mode = MODES[modeKey];
  const container = document.getElementById('tok-seq-container');
  if (!container) return;
  const seq = document.createElement('div');
  seq.className = 'tok-seq';

  const UNIT = 28;
  let passedDiv = false;
  let arCount = 0;
  let dmCount = 0;
  mode.blocks.forEach((b, i) => {
    if (!passedDiv && !b.ar && mode.divAfter <= (arCount)) {
      const divider = document.createElement('div');
      divider.className = 'tok-divider';
      const divWrap = document.createElement('div');
      divWrap.style.cssText = 'display:flex;flex-direction:column;align-items:center;gap:3px';
      const divLabel = document.createElement('div');
      divLabel.className = 'tok-section-lbl';
      divLabel.textContent = 'AR ← | → DM';
      divWrap.appendChild(divLabel);
      divWrap.appendChild(divider);
      seq.appendChild(divWrap);
      passedDiv = true;
    }
    if (b.ar) arCount += b.width; else dmCount += b.width;

    const block = document.createElement('div');
    block.className = 'tok-block';
    const rect = document.createElement('div');
    rect.className = 'tok-rect';
    rect.style.cssText = `width:${b.width * UNIT - 2}px;background:${b.color};${b.noisy ? 'border:1.5px dashed #f59e0b;' : ''}${b.output ? 'border:1.5px solid #10b981;' : ''}`;
    if (b.width > 1) {
      rect.style.fontSize = '.55rem';
      rect.textContent = b.label.split(' ').pop();
    }
    const lbl = document.createElement('div');
    lbl.className = 'tok-lbl';
    lbl.textContent = b.label;
    block.appendChild(rect);
    block.appendChild(lbl);
    seq.appendChild(block);
  });

  container.innerHTML = '';
  container.appendChild(seq);
  document.getElementById('tok-mode-desc').textContent = mode.desc;
}

document.querySelectorAll('.mode-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.mode-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    currentMode = btn.dataset.mode;
    renderTokenSeq(currentMode);
  });
});
renderTokenSeq('vlm');

// ── Generation modes step navigator ──────────────────────────────────
let modeStep = 0;
const modeBoxes = document.querySelectorAll('#mode-steps .step-box');
const modePrev = document.getElementById('mode-prev');
const modeNext = document.getElementById('mode-next');
const modeProg = document.getElementById('mode-prog');
function updateModeSteps() {
  modeBoxes.forEach((b, i) => {
    b.classList.remove('active', 'done');
    if (i === modeStep) b.classList.add('active');
    else if (i < modeStep) b.classList.add('done');
  });
  if (modePrev) modePrev.disabled = modeStep === 0;
  if (modeNext) modeNext.disabled = modeStep === modeBoxes.length - 1;
  if (modeProg) modeProg.textContent = 'Step ' + (modeStep + 1) + ' of ' + modeBoxes.length;
  modeBoxes.forEach((b, i) => {
    const n = b.querySelector('.step-num');
    if (n) n.textContent = i < modeStep ? '✓' : String(i + 1);
  });
}
modePrev?.addEventListener('click', () => { if (modeStep > 0) { modeStep--; updateModeSteps(); } });
modeNext?.addEventListener('click', () => { if (modeStep < modeBoxes.length - 1) { modeStep++; updateModeSteps(); } });
updateModeSteps();

// ── FPS modulation canvas ─────────────────────────────────────────────
const fpsCanvas = document.getElementById('fps-canvas');
if (fpsCanvas) {
  const ctx2 = fpsCanvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  function resizeFPS() {
    const W = fpsCanvas.clientWidth;
    const H = fpsCanvas.clientHeight;
    fpsCanvas.width = W * DPR;
    fpsCanvas.height = H * DPR;
    ctx2.scale(DPR, DPR);
    drawFPS();
  }

  let activeFPS = 16;
  const TPS_BASE = 6;
  const ROWS = [
    { fps: 16, label: '16 FPS', color: '#8b5cf6' },
    { fps: 24, label: '24 FPS (base)', color: '#06b6d4' },
    { fps: 30, label: '30 FPS', color: '#10b981' },
  ];

  function drawFPS() {
    const W = fpsCanvas.clientWidth;
    const H = fpsCanvas.clientHeight;
    ctx2.clearRect(0, 0, W, H);
    ctx2.fillStyle = 'rgba(17,24,39,0.5)';
    ctx2.fillRect(0, 0, W, H);

    const leftPad = 100, rightPad = 20;
    const trackW = W - leftPad - rightPad;
    const DURATION_SEC = 2; // show 2 seconds
    const POS_PER_SEC = TPS_BASE; // 6 pos units = 1 second
    const TOTAL_POS = DURATION_SEC * POS_PER_SEC; // 12 pos units
    const SCALE = trackW / TOTAL_POS;

    const rowH = (H - 40) / (ROWS.length + 1);
    const startY = 30;

    // Time axis labels at top
    ctx2.fillStyle = '#6b7280';
    ctx2.font = '9px monospace';
    ctx2.textAlign = 'center';
    for (let sec = 0; sec <= DURATION_SEC; sec++) {
      const x = leftPad + sec * POS_PER_SEC * SCALE;
      ctx2.fillText(sec + 's', x, 16);
      ctx2.beginPath();
      ctx2.strokeStyle = 'rgba(255,255,255,0.05)';
      ctx2.moveTo(x, 20);
      ctx2.lineTo(x, H - 10);
      ctx2.stroke();
    }
    ctx2.fillStyle = '#374151';
    ctx2.fillText('Real time →', leftPad + trackW * 0.5, H - 2);

    // Rows
    ROWS.forEach((row, ri) => {
      const y = startY + ri * rowH + rowH * 0.5;
      const tps = row.fps / 4; // temporal compression
      const dt = TPS_BASE / tps; // position increment per token
      const numTokens = Math.floor(DURATION_SEC * tps); // tokens in 2 seconds
      const isActive = row.fps === activeFPS;
      const alpha = isActive ? 1 : 0.3;

      // Row label
      ctx2.textAlign = 'right';
      ctx2.fillStyle = `rgba(${hexToRgb(row.color)},${alpha})`;
      ctx2.font = `${isActive ? 'bold ' : ''}9px monospace`;
      ctx2.fillText(row.label, leftPad - 6, y + 4);

      // δt label
      const dtStr = 'δt=' + dt.toFixed(2);
      ctx2.fillStyle = `rgba(${hexToRgb(row.color)},${alpha * 0.7})`;
      ctx2.font = '7.5px monospace';
      ctx2.fillText(dtStr, leftPad - 6, y + 14);

      // Draw tokens as colored rectangles
      for (let i = 0; i < numTokens; i++) {
        const posX = leftPad + i * dt * SCALE;
        const tokW = Math.max(4, dt * SCALE - 2);
        const tokH = isActive ? 20 : 12;
        const tokY = y - tokH / 2;
        ctx2.fillStyle = `rgba(${hexToRgb(row.color)},${alpha * 0.8})`;
        ctx2.beginPath();
        ctx2.roundRect(posX, tokY, tokW, tokH, 2);
        ctx2.fill();
        if (isActive && dt * SCALE > 20) {
          ctx2.fillStyle = 'rgba(255,255,255,0.7)';
          ctx2.font = '7px monospace';
          ctx2.textAlign = 'center';
          ctx2.fillText('t' + i, posX + tokW / 2, y + 3);
        }
      }
      // Annotation: "= 6 pos/sec"
      if (isActive) {
        ctx2.fillStyle = `rgba(${hexToRgb(row.color)},0.6)`;
        ctx2.font = '7.5px monospace';
        ctx2.textAlign = 'left';
        ctx2.fillText('→ ' + numTokens + ' tokens in 2s, each ' + dt.toFixed(2) + ' pos units apart', leftPad + trackW + 5, y + 4);
      }
    });

    // Common annotation
    ctx2.fillStyle = '#4b5563';
    ctx2.font = '8px monospace';
    ctx2.textAlign = 'center';
    ctx2.fillText('All rates: 1 real second = ' + POS_PER_SEC + ' position units', leftPad + trackW / 2, H - 14);
  }

  function hexToRgb(hex) {
    const r = parseInt(hex.slice(1, 3), 16);
    const g = parseInt(hex.slice(3, 5), 16);
    const b = parseInt(hex.slice(5, 7), 16);
    return r + ',' + g + ',' + b;
  }

  document.querySelectorAll('.fps-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.fps-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeFPS = parseInt(btn.dataset.fps);
      ctx2.setTransform(1, 0, 0, 1, 0, 0);
      ctx2.scale(DPR, DPR);
      drawFPS();
    });
  });

  // Initial draw
  setTimeout(() => resizeFPS(), 50);
}

// ── Animated bar chart ────────────────────────────────────────────────
const barsSection = document.getElementById('s-results');
if (barsSection) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('#results-bars .bar-fill[data-w]').forEach(b => {
          b.style.width = parseFloat(b.dataset.w) + '%';
        });
      }
    });
  }, { threshold: 0.2 }).observe(barsSection);
}
</script>
</BaseLayout>

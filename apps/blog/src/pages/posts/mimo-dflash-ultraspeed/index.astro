    const cols = tokens.length;
    const cellW = Math.floor((W - 40) / cols);
    const startX = 20;
    const rowY1 = 30, rowY2 = 95, rowY3 = 155;

    // Row labels
    ctx.font = '9px monospace';
    ctx.fillStyle = '#4b5563';
    ctx.textAlign = 'right';
    ctx.fillText('GPU util', startX - 4, rowY1 + 9);
    ctx.fillText('tokens', startX - 4, rowY2 + 9);
    ctx.fillText('time →', startX - 4, rowY3 + 9);

    if (mode === 'ar') {
      // Show one token at a time
      for (let i = 0; i < cols; i++) {
        const x = startX + i * cellW;
        // GPU util: mostly idle
        const utilH = i % 3 === 0 ? 22 : 6;
        ctx.fillStyle = i % 3 === 0 ? 'rgba(245,158,11,.7)' : 'rgba(75,85,99,.4)';
        ctx.fillRect(x + 2, rowY1 - utilH + 14, cellW - 4, utilH);

        // Token box
        ctx.fillStyle = i < 3 ? 'rgba(6,182,212,.25)' : 'rgba(75,85,99,.2)';
        ctx.strokeStyle = i < 3 ? 'rgba(6,182,212,.5)' : 'rgba(75,85,99,.3)';
        ctx.lineWidth = 1;
        ctx.beginPath(); ctx.roundRect(x+2, rowY2-2, cellW-4, 22, 3); ctx.fill(); ctx.stroke();
        ctx.font = '8px monospace';
        ctx.fillStyle = i < 3 ? '#67e8f9' : '#4b5563';
        ctx.textAlign = 'center';
        ctx.fillText(tokens[i], x + cellW/2, rowY2 + 12);

        // Time arrow: one by one
        if (i < cols - 1) {
          ctx.fillStyle = 'rgba(239,68,68,.5)';
          ctx.fillRect(x + cellW - 2, rowY3 + 4, 3, 3);
        }
      }
      // Labels
      ctx.font = '9px monospace';
      ctx.fillStyle = '#ef4444';
      ctx.textAlign = 'center';
      ctx.fillText('1 token/step  —  GPU <5% utilization', W/2, H - 8);

      // Annotate GPU idle stretches
      ctx.fillStyle = '#6b7280';
      ctx.font = '8px monospace';
      ctx.fillText('idle', startX + cellW * 1.5, rowY1 - 2);
      ctx.fillText('idle', startX + cellW * 4.5, rowY1 - 2);
    } else {
      // Block mode: groups of 8
      const blockCols = [0, 8]; // two blocks shown
      const bColors = ['rgba(139,92,246,.3)', 'rgba(16,185,129,.25)'];
      const bStrokes = ['rgba(139,92,246,.7)', 'rgba(16,185,129,.6)'];

      blockCols.forEach((start, bi) => {
        const end = Math.min(start + 8, cols);
        const bx = startX + start * cellW;
        const bw = (end - start) * cellW - 2;

        // GPU util: high during block
        ctx.fillStyle = bColors[bi].replace('.3', '.7').replace('.25', '.6');
        ctx.fillRect(bx, rowY1 - 8, bw, 22);
        ctx.font = '8px monospace';
        ctx.fillStyle = bi === 0 ? '#a78bfa' : '#6ee7b7';
        ctx.textAlign = 'center';
        ctx.fillText(bi === 0 ? 'DRAFT block' : 'VERIFY block', bx + bw/2, rowY1 + 8);

        // Token boxes: all at once
        for (let i = start; i < end; i++) {
          const x = startX + i * cellW;
          ctx.fillStyle = bColors[bi];
          ctx.strokeStyle = bStrokes[bi];
          ctx.lineWidth = 1;
          ctx.beginPath(); ctx.roundRect(x+1, rowY2-2, cellW-2, 22, 3); ctx.fill(); ctx.stroke();
          ctx.font = '8px monospace';
          ctx.fillStyle = bi === 0 ? '#c4b5fd' : '#6ee7b7';
          ctx.textAlign = 'center';
          ctx.fillText(tokens[i], x + cellW/2, rowY2 + 12);
        }
      });

      // Time: two blocks
      ctx.fillStyle = 'rgba(139,92,246,.4)';
      ctx.fillRect(startX, rowY3 + 4, 8 * cellW - 4, 4);
      ctx.fillStyle = 'rgba(16,185,129,.4)';
      ctx.fillRect(startX + 8 * cellW + 2, rowY3 + 4, (cols - 8) * cellW - 4, 4);

      ctx.font = '9px monospace';
      ctx.fillStyle = '#10b981';
      ctx.textAlign = 'center';
      ctx.fillText('8 tokens/step  —  GPU >60% utilization  —  6x faster', W/2, H - 8);
    }
  }

  drawMode();

  document.getElementById('btn-ar')?.addEventListener('click', () => {
    mode = 'ar';
    document.getElementById('btn-ar').style.borderColor = 'rgba(239,68,68,.5)';
    document.getElementById('btn-ar').style.color = '#fca5a5';
    document.getElementById('btn-ar').style.background = 'rgba(239,68,68,.1)';
    document.getElementById('btn-block').style.borderColor = 'var(--border-hi)';
    document.getElementById('btn-block').style.color = 'var(--muted2)';
    document.getElementById('btn-block').style.background = 'var(--surface)';
    drawMode();
  });
  document.getElementById('btn-block')?.addEventListener('click', () => {
    mode = 'block';
    document.getElementById('btn-block').style.borderColor = 'rgba(139,92,246,.5)';
    document.getElementById('btn-block').style.color = 'var(--purple-l)';
    document.getElementById('btn-block').style.background = 'var(--purple-dim)';
    document.getElementById('btn-ar').style.borderColor = 'var(--border-hi)';
    document.getElementById('btn-ar').style.color = 'var(--muted2)';
    document.getElementById('btn-ar').style.background = 'var(--surface)';
    drawMode();
  });
})();

// ─── Canvas 2: Drafting cost (latency vs γ) ──────────────────────────────────
(function() {
  const canvas = document.getElementById('cost-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 220;
  canvas.width = W * DPR; canvas.height = H * DPR; ctx.scale(DPR, DPR);

  const PAD = { t: 24, r: 24, b: 40, l: 60 };
  const cw = W - PAD.l - PAD.r, ch = H - PAD.t - PAD.b;
  const maxX = 16, maxY = 8; // gamma up to 16, latency up to 8ms

  function px(gamma) { return PAD.l + (gamma / maxX) * cw; }
  function py(ms) { return PAD.t + (1 - ms / maxY) * ch; }

  // Grid
  ctx.strokeStyle = 'rgba(255,255,255,.04)';
  ctx.lineWidth = 1;
  [2,4,6,8,10,12,14,16].forEach(g => {
    ctx.beginPath(); ctx.moveTo(px(g), PAD.t); ctx.lineTo(px(g), PAD.t + ch); ctx.stroke();
  });
  [2,4,6,8].forEach(ms => {
    ctx.beginPath(); ctx.moveTo(PAD.l, py(ms)); ctx.lineTo(PAD.l + cw, py(ms)); ctx.stroke();
  });

  // Axes
  ctx.strokeStyle = 'rgba(255,255,255,.18)';
  ctx.lineWidth = 1.2;
  ctx.beginPath(); ctx.moveTo(PAD.l, PAD.t); ctx.lineTo(PAD.l, PAD.t + ch); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(PAD.l, PAD.t + ch); ctx.lineTo(PAD.l + cw, PAD.t + ch); ctx.stroke();

  // Axis labels
  ctx.font = '9px monospace'; ctx.fillStyle = '#4b5563'; ctx.textAlign = 'center';
  [0,4,8,12,16].forEach(g => {
    ctx.fillText(g, px(g), PAD.t + ch + 14);
  });
  ctx.textAlign = 'right';
  [0,2,4,6,8].forEach(ms => {
    ctx.fillText(ms + 'ms', PAD.l - 6, py(ms) + 3);
  });
  ctx.fillStyle = '#6b7280';
  ctx.textAlign = 'center';
  ctx.fillText('draft budget γ (tokens)', PAD.l + cw/2, H - 4);
  ctx.save(); ctx.translate(14, PAD.t + ch/2); ctx.rotate(-Math.PI/2);
  ctx.fillText('drafting latency', 0, 0); ctx.restore();

  // EAGLE-3 line: T = gamma * 0.4ms (linear)
  ctx.strokeStyle = 'rgba(239,68,68,.7)';
  ctx.lineWidth = 2;
  ctx.beginPath();
  ctx.moveTo(px(0), py(0));
  for (let g = 0; g <= 16; g += 0.5) {
    ctx.lineTo(px(g), py(g * 0.4));
  }
  ctx.stroke();

  // DFlash 5-layer line: roughly constant ~1.1ms
  ctx.strokeStyle = 'rgba(139,92,246,.8)';
  ctx.lineWidth = 2;
  ctx.setLineDash([]);
  ctx.beginPath();
  ctx.moveTo(px(1), py(1.1));
  ctx.lineTo(px(16), py(1.1));
  ctx.stroke();

  // DFlash 3-layer line: ~0.85ms
  ctx.strokeStyle = 'rgba(139,92,246,.4)';
  ctx.lineWidth = 1.5;
  ctx.setLineDash([4,3]);
  ctx.beginPath();
  ctx.moveTo(px(1), py(0.85));
  ctx.lineTo(px(16), py(0.85));
  ctx.stroke();
  ctx.setLineDash([]);

  // Labels on curves
  ctx.font = '9px monospace';
  ctx.fillStyle = '#fca5a5'; ctx.textAlign = 'left';
  ctx.fillText('EAGLE-3 (1-layer AR)', px(8.5), py(8 * 0.4) - 6);
  ctx.fillStyle = '#a78bfa';
  ctx.fillText('DFlash 5-layer', px(8.5), py(1.1) - 8);
  ctx.fillStyle = 'rgba(139,92,246,.6)';
  ctx.fillText('DFlash 3-layer', px(8.5), py(0.85) - 6);

  // Annotation at gamma=16
  ctx.strokeStyle = 'rgba(255,255,255,.15)';
  ctx.lineWidth = 1;
  ctx.setLineDash([3,3]);
  ctx.beginPath(); ctx.moveTo(px(16), py(0)); ctx.lineTo(px(16), py(16*0.4)); ctx.stroke();
  ctx.setLineDash([]);
  ctx.font = '8px monospace';
  ctx.fillStyle = '#ef4444'; ctx.textAlign = 'right';
  ctx.fillText('6.4ms', px(16) - 4, py(16 * 0.4) + 10);
  ctx.fillStyle = '#a78bfa'; ctx.textAlign = 'left';
  ctx.fillText('1.1ms', px(16) + 4, py(1.1) - 4);
})();

// ─── Acceptance histogram ────────────────────────────────────────────────────
const ACCEPT_DATA = {
  coding: {
    // Distribution for avg 6.30, block size 8: many full accepts
    dist: [2, 3, 5, 7, 9, 14, 25, 35],  // roughly % at accepted=1..8
    avg: 6.30, label: 'WebDev / Coding', color: 'rgba(139,92,246,.75)'
  },
  math: {
    dist: [3, 5, 8, 10, 12, 16, 22, 24],
    avg: 5.56, label: 'Math500', color: 'rgba(6,182,212,.7)'
  },
  agent: {
    dist: [5, 8, 12, 14, 16, 18, 15, 12],
    avg: 4.29, label: 'SWE-Bench Agent', color: 'rgba(245,158,11,.7)'
  },
  chat: {
    dist: [10, 14, 18, 16, 14, 11, 9, 8],
    avg: 3.18, label: 'MT-Bench Chat', color: 'rgba(99,102,241,.7)'
  },
};

function renderAcceptChart(scenario) {
  const data = ACCEPT_DATA[scenario];
  const chart = document.getElementById('accept-chart');
  const labels = document.getElementById('accept-labels');
  const summary = document.getElementById('accept-summary');
  if (!chart || !labels) return;

  const maxVal = Math.max(...data.dist);
  chart.innerHTML = '';
  labels.innerHTML = '';

  for (let i = 0; i < 8; i++) {
    const pct = (data.dist[i] / maxVal) * 100;
    const bar = document.createElement('div');
    bar.className = 'accept-bar';
    bar.style.background = data.color;
    bar.style.height = pct + '%';
    bar.innerHTML = span('bar-val', String(i+1));
    chart.appendChild(bar);

    const lbl = document.createElement('span');
    lbl.textContent = i + 1;
    labels.appendChild(lbl);
  }

  if (summary) {
    summary.textContent = `${data.label} — avg accepted: ${data.avg} / 8 tokens per cycle`;
  }

  // Update button styles
  document.querySelectorAll('.accept-btn').forEach(b => {
    const active = b.dataset.scenario === scenario;
    b.style.borderColor = active ? 'rgba(139,92,246,.5)' : 'var(--border-hi)';
    b.style.background  = active ? 'var(--purple-dim)' : 'var(--surface)';
    b.style.color       = active ? 'var(--purple-l)' : 'var(--muted2)';
  });
}

document.querySelectorAll('.accept-btn').forEach(b =>
  b.addEventListener('click', () => renderAcceptChart(b.dataset.scenario)));
renderAcceptChart('coding');

// ─── Step navigator (training tricks) ────────────────────────────────────────
let trainStep = 0;
const trainBoxes = document.querySelectorAll('#train-steps .step-box');
const trainPrev  = document.getElementById('train-prev');
const trainNext  = document.getElementById('train-next');
const trainProg  = document.getElementById('train-prog');

function updateTrainSteps() {
  trainBoxes.forEach((b, i) => {
    b.classList.remove('active','done');
    if (i === trainStep) b.classList.add('active');
    else if (i < trainStep) b.classList.add('done');
  });
  if (trainPrev) trainPrev.disabled = trainStep === 0;
  if (trainNext) trainNext.disabled = trainStep === trainBoxes.length - 1;
  if (trainProg) trainProg.textContent = `Step ${trainStep + 1} of ${trainBoxes.length}`;
  trainBoxes.forEach((b, i) => {
    const n = b.querySelector('.step-num');
    if (n) n.textContent = i < trainStep ? '✓' : String(i + 1);
  });
}

trainPrev?.addEventListener('click', () => { if (trainStep > 0){ trainStep--; updateTrainSteps(); }});
trainNext?.addEventListener('click', () => { if (trainStep < trainBoxes.length-1){ trainStep++; updateTrainSteps(); }});
updateTrainSteps();

// ─── Animated bars (IntersectionObserver) ────────────────────────────────────
function animateBarsIn(containerId) {
  const section = document.getElementById(containerId);
  if (!section) return;
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          b.style.width = b.dataset.w + '%';
        });
      }
    });
  }, { threshold: 0.3 }).observe(section);
}
animateBarsIn('s-mimo');
// Also trigger for acceptance deployment bars within mimo section
</script>

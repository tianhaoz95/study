    <!-- bottleneck panel -->
    <div class="cs-panel active" id="panel-bottleneck">
      <pre class="cs-pre">
<span class="cs-line cmt"># Memory bandwidth (GB) for generating L bytes</span>
<span class="cs-line cmt"># b = bytes per param (2 for fp16)</span>
<span class="cs-line cmt"># N_dec, N_enc = decoder / encoder NFEs</span>
<span class="cs-line cmt"># P_dec, P_enc, P_glob = param counts</span>
<span class="cs-line"></span>
<span class="cs-line kw">def</span> <span class="cs-line fn">memory_bandwidth</span><span class="cs-line">(</span>
<span class="cs-line">    N_dec, N_enc,</span>
<span class="cs-line">    P_dec, P_enc, P_glob,</span>
<span class="cs-line">    b=<span class="num">2</span>):</span>
<span class="cs-line hl-c">    <span class="kw">return</span> b * (</span>
<span class="cs-line hl-c">        N_dec * P_dec +</span>
<span class="cs-line hl-c">        N_enc * (P_enc + P_glob)</span>
<span class="cs-line hl-c">    ) / 1e9</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># BLT baseline: one decoder call per byte</span>
<span class="cs-line cmt"># avg patch = 4 bytes → enc/glob called</span>
<span class="cs-line cmt"># once per patch = L/4 times</span>
<span class="cs-line hl-a">blt_bw = memory_bandwidth(</span>
<span class="cs-line hl-a">    N_dec=L,       <span class="cmt"># 1 call / byte</span></span>
<span class="cs-line hl-a">    N_enc=L/<span class="num">4</span>,    <span class="cmt"># 1 call / patch</span></span>
<span class="cs-line hl-a">    P_dec=160e6, P_enc=26e6, P_glob=2.82e9</span>
<span class="cs-line hl-a">)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># BLT-D-8: block size 8, s≈3 steps/block</span>
<span class="cs-line hl-g">bltd8_bw = memory_bandwidth(</span>
<span class="cs-line hl-g">    N_dec=L*<span class="num">3</span>/<span class="num">8</span>,   <span class="cmt"># ~3 steps per 8-byte block</span></span>
<span class="cs-line hl-g">    N_enc=L/<span class="num">8</span>,     <span class="cmt"># 1 call / block (not patch)</span></span>
<span class="cs-line hl-g">    P_dec=160e6, P_enc=26e6, P_glob=2.82e9</span>
<span class="cs-line hl-g">)</span>
<span class="cs-line cmt"># reduction: ~70% lower than BLT</span>
      </pre>
    </div>

    <!-- diffusion panel -->
    <div class="cs-panel" id="panel-diffusion">
      <pre class="cs-pre">
<span class="cs-line cmt"># Algorithm 1: BLT-D Generation</span>
<span class="cs-line cmt"># x: byte sequence prefix</span>
<span class="cs-line cmt"># L: generation length</span>
<span class="cs-line cmt"># B: block size (4, 8, or 16)</span>
<span class="cs-line"></span>
<span class="cs-line kw">def</span> <span class="fn">bltd_generate</span>(x, L, B, do_verify=<span class="kw">False</span>):</span>
<span class="cs-line">    l = len(x)</span>
<span class="cs-line">    <span class="kw">while</span> l &lt; len(x) + L:</span>
<span class="cs-line hl-c">        <span class="cmt"># 1. Encode prefix → latent tokens</span></span>
<span class="cs-line hl-c">        T = encoder(x)</span>
<span class="cs-line hl-c">        O = global_model(T)  <span class="cmt"># O[-1] = last latent</span></span>
<span class="cs-line"></span>
<span class="cs-line hl-p">        <span class="cmt"># 2. Initialize masked block</span></span>
<span class="cs-line hl-p">        x_block = [MASK] * B</span>
<span class="cs-line hl-p">        x_prime = x + x_block</span>
<span class="cs-line"></span>
<span class="cs-line hl-p">        <span class="cmt"># 3. Iterative unmasking loop</span></span>
<span class="cs-line hl-p">        <span class="kw">while</span> MASK <span class="kw">in</span> x_prime:</span>
<span class="cs-line hl-p">            y = decoder(x_prime, O)  <span class="cmt"># bidir attn</span></span>
<span class="cs-line hl-p">            k = select_positions(y)  <span class="cmt"># confidence/EB</span></span>
<span class="cs-line hl-p">            unmask(x_prime, k, y)</span>
<span class="cs-line"></span>
<span class="cs-line">        <span class="kw">if</span> do_verify:</span>
<span class="cs-line">            x = verify(x, x_prime, l, B)</span>
<span class="cs-line">        <span class="kw">else</span>:</span>
<span class="cs-line">            x = x_prime</span>
<span class="cs-line">        l = len(x)</span>
<span class="cs-line">    <span class="kw">return</span> x</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Confidence-based unmasking</span>
<span class="cs-line kw">def</span> <span class="fn">select_positions_conf</span>(y, alpha=<span class="num">0.7</span>):</span>
<span class="cs-line hl-g">    conf = y.max(dim=-<span class="num">1</span>).values  <span class="cmt"># max prob</span></span>
<span class="cs-line hl-g">    mask = conf >= alpha</span>
<span class="cs-line hl-g">    <span class="kw">if</span> <span class="kw">not</span> mask.<span class="fn">any</span>():</span>
<span class="cs-line hl-g">        mask[conf.<span class="fn">argmax</span>()] = <span class="kw">True</span>  <span class="cmt"># always unmask 1</span></span>
<span class="cs-line hl-g">    <span class="kw">return</span> mask</span>
      </pre>
    </div>

    <!-- training panel -->
    <div class="cs-panel" id="panel-training">
      <pre class="cs-pre">
<span class="cs-line cmt"># BLT-D training data preprocessing</span>
<span class="cs-line cmt"># x: raw byte sequence, patches: segmentation</span>
<span class="cs-line cmt"># B: block size (B > avg patch size)</span>
<span class="cs-line"></span>
<span class="cs-line kw">def</span> <span class="fn">make_training_pair</span>(x, patches, B):</span>
<span class="cs-line hl-c">    blocks = []</span>
<span class="cs-line hl-c">    <span class="kw">for</span> patch <span class="kw">in</span> patches[<span class="num">1</span>:]:  <span class="cmt"># skip first patch</span></span>
<span class="cs-line hl-c">        s = patch.start_idx</span>
<span class="cs-line hl-c">        block = x[s : s+B]      <span class="cmt"># may cross boundaries</span></span>
<span class="cs-line hl-c">        blocks.append(pad_to(block, B))</span>
<span class="cs-line"></span>
<span class="cs-line hl-p">    x_block = concat(blocks)    <span class="cmt"># clean blocks</span></span>
<span class="cs-line hl-p">    t = uniform(<span class="num">0</span>, <span class="num">1</span>)          <span class="cmt"># noise level</span></span>
<span class="cs-line hl-p">    x_t = mask_each(x_block, p=t)  <span class="cmt"># absorbing diffusion</span></span>
<span class="cs-line hl-p">    <span class="kw">return</span> x, x_t, t            <span class="cmt"># (clean, corrupted, t)</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Loss function (Eq. 7)</span>
<span class="cs-line kw">def</span> <span class="fn">total_loss</span>(model, x, x_t, t):</span>
<span class="cs-line hl-g">    <span class="cmt"># Autoregressive next-byte loss (clean)</span></span>
<span class="cs-line hl-g">    logits_clean = model(x, x_t, mode=<span class="str">'causal'</span>)</span>
<span class="cs-line hl-g">    L_clean = cross_entropy(logits_clean, x)</span>
<span class="cs-line"></span>
<span class="cs-line hl-a">    <span class="cmt"># Masked-byte reconstruction loss (corrupted)</span></span>
<span class="cs-line hl-a">    logits_mask = model(x, x_t, mode=<span class="str">'bidir'</span>)</span>
<span class="cs-line hl-a">    masked_pos = (x_t == MASK)</span>
<span class="cs-line hl-a">    L_mask = cross_entropy(logits_mask[masked_pos],</span>
<span class="cs-line hl-a">                           x_block[masked_pos]) / t</span>
<span class="cs-line"></span>
<span class="cs-line">    <span class="kw">return</span> L_clean + L_mask</span>
      </pre>
    </div>

    <!-- speculation panel -->
    <div class="cs-panel" id="panel-speculation">
      <pre class="cs-pre">
<span class="cs-line cmt"># Algorithm 2: Verify(x, x', l, r)</span>
<span class="cs-line cmt"># x: current accepted sequence</span>
<span class="cs-line cmt"># x': candidate (drafted) sequence</span>
<span class="cs-line cmt"># l: start of drafted region</span>
<span class="cs-line cmt"># r: draft length</span>
<span class="cs-line"></span>
<span class="cs-line kw">def</span> <span class="fn">verify</span>(x, x_prime, l, r):</span>
<span class="cs-line hl-c">    <span class="cmt"># Full model re-encodes entire sequence</span></span>
<span class="cs-line hl-c">    T = encoder(x_prime)</span>
<span class="cs-line hl-c">    O = global_model(T)</span>
<span class="cs-line hl-c">    y = decoder(x_prime, O)  <span class="cmt"># causal mask</span></span>
<span class="cs-line hl-c">    <span class="cmt"># y[j] = greedy next-byte after position j</span></span>
<span class="cs-line"></span>
<span class="cs-line hl-p">    i = l + <span class="num">1</span></span>
<span class="cs-line hl-p">    <span class="kw">while</span> i &lt;= l + r:</span>
<span class="cs-line hl-p">        <span class="kw">if</span> x_prime[i] != y[i-<span class="num">1</span>]:  <span class="cmt"># mismatch</span></span>
<span class="cs-line hl-p">            x[i] = y[i-<span class="num">1</span>]</span>
<span class="cs-line hl-p">            <span class="kw">break</span></span>
<span class="cs-line hl-p">        x[i] = x_prime[i]          <span class="cmt"># accept</span></span>
<span class="cs-line hl-p">        i += <span class="num">1</span></span>
<span class="cs-line hl-p">    <span class="kw">else</span>:</span>
<span class="cs-line hl-p">        x[i] = y[i-<span class="num">1</span>]  <span class="cmt"># free bonus byte</span></span>
<span class="cs-line">    <span class="kw">return</span> x</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># BLT-S: decoder speculates k bytes past</span>
<span class="cs-line cmt"># normal patch boundary, then verifies</span>
<span class="cs-line kw">def</span> <span class="fn">blt_s_step</span>(x, k):</span>
<span class="cs-line hl-g">    draft = decoder_autoregress(x, k)  <span class="cmt"># fast</span></span>
<span class="cs-line hl-g">    x_prime = x + draft</span>
<span class="cs-line hl-g">    <span class="kw">return</span> verify(x, x_prime, len(x), k)</span>
      </pre>
    </div>

    <!-- tradeoff panel -->
    <div class="cs-panel" id="panel-tradeoff">

<script>
// ── TOC + sidebar toggles ──────────────────────────────────
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});

const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ── Code sidebar tab switching ─────────────────────────────
const tabMeta = {
  bottleneck: { file: 'fast_blt/bottleneck.py',   title: 'The Byte Bottleneck' },
  diffusion:  { file: 'fast_blt/generation.py',   title: 'Block Diffusion Decoding' },
  training:   { file: 'fast_blt/training.py',     title: 'Training BLT-D' },
  speculation:{ file: 'fast_blt/speculation.py',  title: 'Speculative Extensions' },
  tradeoff:   { file: 'fast_blt/results.py',      title: 'Speed–Quality Knob' },
  results:    { file: 'fast_blt/benchmarks.py',   title: 'Benchmark Results' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ── IntersectionObserver: TOC + sidebar sync ───────────────
const sectionMap = {
  's-bottleneck': 'bottleneck',
  's-diffusion':  'diffusion',
  's-training':   'training',
  's-speculation':'speculation',
  's-tradeoff':   'tradeoff',
  's-results':    'results',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ══════════════════════════════════════════════════════════
// §01: GENERATION COMPARISON CANVAS
// ══════════════════════════════════════════════════════════
(function() {
  const canvas = document.getElementById('gen-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  function resize() {
    const W = canvas.clientWidth, H = 220;
    canvas.width = W * DPR; canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
    return { W, H };
  }
  let dims = resize();

  const BYTES = ['_','B','L','T','_','W','o','n'];
  // BLT: 8 sequential calls, each produces 1 byte
  // BLT-D: 2 parallel steps, each produces 4 bytes
  let animFrame = null;
  let progress = 0; // 0..1

  function drawState(prog) {
    const { W, H } = dims;
    ctx.clearRect(0, 0, W, H);

    const colW = (W - 40) / 2;
    const leftX = 20, rightX = 20 + colW + 20;
    const headerH = 30, rowH = 22, rowGap = 4;
    const rows = 8; // 8 bytes total
    const maxH = headerH + rows * (rowH + rowGap);

    // headers
    ctx.font = `bold 11px monospace`;
    ctx.fillStyle = '#f59e0b';
    ctx.textAlign = 'center';
    ctx.fillText('BLT  —  8 decoder calls', leftX + colW/2, 18);
    ctx.fillStyle = '#10b981';
    ctx.fillText('BLT-D  —  2 decoder calls', rightX + (colW-20)/2, 18);

    // BLT side: 8 rows, each = 1 byte, revealed left-to-right
    const bltRows = Math.min(8, Math.floor(prog * 8));
    for (let i = 0; i < 8; i++) {
      const y = headerH + i * (rowH + rowGap);
      const revealed = i < bltRows;
      ctx.fillStyle = revealed ? 'rgba(245,158,11,0.15)' : 'rgba(255,255,255,0.03)';
      ctx.strokeStyle = revealed ? '#f59e0b' : '#374151';
      ctx.lineWidth = 1;
      roundRect(ctx, leftX, y, colW - 10, rowH, 4);
      ctx.fill(); ctx.stroke();

      // byte label
      ctx.font = '10px monospace';
      ctx.fillStyle = revealed ? '#fbbf24' : '#4b5563';
      ctx.textAlign = 'left';
      ctx.fillText(`call ${i+1}`, leftX + 8, y + 14);

      ctx.textAlign = 'right';
      ctx.fillStyle = revealed ? '#98c379' : '#374151';
      ctx.font = 'bold 12px monospace';
      ctx.fillText(`"${BYTES[i]}"`, leftX + colW - 18, y + 14);
    }

    // BLT-D side: 2 block rows, each reveals 4 bytes
    // Step 1 fires when prog > 0.25, step 2 when prog > 0.75
    const step1Done = prog >= 0.3;
    const step2Done = prog >= 0.7;
    const blockH = (rows * (rowH + rowGap) - rowGap) / 2 - 2;
    for (let s = 0; s < 2; s++) {
      const y = headerH + s * (blockH + 6);
      const done = s === 0 ? step1Done : step2Done;
      ctx.fillStyle = done ? 'rgba(16,185,129,0.15)' : 'rgba(255,255,255,0.03)';
      ctx.strokeStyle = done ? '#10b981' : '#374151';
      ctx.lineWidth = 1;
      roundRect(ctx, rightX, y, colW - 20, blockH, 4);
      ctx.fill(); ctx.stroke();

      ctx.font = '10px monospace';
      ctx.fillStyle = done ? '#6ee7b7' : '#4b5563';
      ctx.textAlign = 'left';
      ctx.fillText(`step ${s+1} (parallel)`, rightX + 8, y + 15);

      const bytes = BYTES.slice(s*4, s*4+4);
      ctx.textAlign = 'right';
      ctx.fillStyle = done ? '#98c379' : '#374151';
      ctx.font = 'bold 12px monospace';
      ctx.fillText('"' + bytes.join('') + '"', rightX + colW - 28, y + blockH/2 + 5);
    }

    // call count labels at bottom
    ctx.font = '10px monospace';
    ctx.textAlign = 'center';
    const labelY = maxH + 14;
    ctx.fillStyle = bltRows > 0 ? '#f59e0b' : '#374151';
    ctx.fillText(`${bltRows} / 8 calls used`, leftX + colW/2, labelY);

    const d2Calls = (step1Done ? 1 : 0) + (step2Done ? 1 : 0);
    ctx.fillStyle = d2Calls > 0 ? '#10b981' : '#374151';
    ctx.fillText(`${d2Calls} / 2 calls used`, rightX + (colW-20)/2, labelY);

    // speedup badge
    if (step2Done && bltRows >= 8) {
      ctx.fillStyle = 'rgba(16,185,129,0.2)';
      ctx.strokeStyle = '#10b981';
      ctx.lineWidth = 1;
      const bx = rightX + 4, bw = colW - 28, by = labelY + 8, bh = 22;
      roundRect(ctx, bx, by, bw, bh, 4);
      ctx.fill(); ctx.stroke();
      ctx.fillStyle = '#6ee7b7';
      ctx.font = 'bold 10px monospace';
      ctx.textAlign = 'center';
      ctx.fillText('75% fewer decoder calls', bx + bw/2, by + 14);
    }
  }

  function roundRect(ctx, x, y, w, h, r) {
    ctx.beginPath();
    ctx.moveTo(x+r, y);
    ctx.lineTo(x+w-r, y);
    ctx.arcTo(x+w, y, x+w, y+r, r);
    ctx.lineTo(x+w, y+h-r);
    ctx.arcTo(x+w, y+h, x+w-r, y+h, r);
    ctx.lineTo(x+r, y+h);
    ctx.arcTo(x, y+h, x, y+h-r, r);
    ctx.lineTo(x, y+r);
    ctx.arcTo(x, y, x+r, y, r);
    ctx.closePath();
  }

  dims = resize();
  drawState(0);

  let animating = false;
  const animBtn = document.getElementById('gen-animate-btn');
  const resetBtn = document.getElementById('gen-reset-btn');
  const statusEl = document.getElementById('gen-status');

  function animate() {
    if (!animating) return;
    progress = Math.min(progress + 0.008, 1.0);
    drawState(progress);
    const bltCalls = Math.min(8, Math.floor(progress * 8));
    const d2Calls = (progress >= 0.3 ? 1 : 0) + (progress >= 0.7 ? 1 : 0);
    statusEl.textContent = progress < 1
      ? `BLT: ${bltCalls}/8 calls  ·  BLT-D: ${d2Calls}/2 calls`
      : 'Done — BLT-D used 2 calls vs BLT\'s 8 calls for the same 8 bytes';
    if (progress < 1) {
      animFrame = requestAnimationFrame(animate);
    } else {
      animating = false;
      animBtn.textContent = '▶ Animate';
    }
  }

  animBtn.addEventListener('click', () => {
    if (animating) {
      animating = false;
      cancelAnimationFrame(animFrame);
      animBtn.textContent = '▶ Animate';
    } else {
      if (progress >= 1) { progress = 0; }
      animating = true;
      animBtn.textContent = '⏸ Pause';
      animate();
    }
  });

  resetBtn.addEventListener('click', () => {
    animating = false;
    cancelAnimationFrame(animFrame);
    progress = 0;
    drawState(0);
    animBtn.textContent = '▶ Animate';
    statusEl.textContent = 'Click Animate to compare generation strategies';
  });

  window.addEventListener('resize', () => {
    dims = resize();
    drawState(progress);
  });
})();

// ══════════════════════════════════════════════════════════
// §02: BLOCK DIFFUSION UNMASKING SIMULATOR
// ══════════════════════════════════════════════════════════
(function() {
  const canvas = document.getElementById('mask-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  function resize() {
    const W = canvas.clientWidth, H = 200;
    canvas.width = W * DPR; canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
    return { W, H };
  }
  let dims = resize();

  // Target text: _BLT_Won_it! = 12 bytes
  const TARGET = ['_','B','L','T','_','W','o','n','_','i','t','!'];
  // Confidence order: we pre-bake reveal sequences for B=4,8,16
  // Each entry is [byte_idx, step_number] — lower step = more confident
  const CONF = {
    4:  [[1,1],[2,1],[3,1],[0,2]], // B, L, T early; _ later
    8:  [[1,1],[2,1],[3,1],[5,1],[6,1],[4,2],[7,2],[0,3]],
    16: [[1,1],[2,1],[3,1],[5,1],[6,1],[9,1],[10,1],[11,1],
         [4,2],[7,2],[8,2],[0,3],[],[],[],[]].filter(x=>x.length),
  };

  let B = 4;
  let stepsDone = 0;
  let totalSteps = 0;

  function getSchedule(b) {
    if (b === 4) {
      return [[1,2,3],[0]]; // step1: positions 1,2,3; step2: position 0
    } else if (b === 8) {
      return [[1,2,3,5,6],[4,7],[0]]; // 3 steps
    } else {
      return [[1,2,3,5,6,9,10,11],[4,7,8],[0],[],[],[]].filter(x=>x.length);
    }
  }

  let schedule = getSchedule(4);
  let revealed = new Array(B).fill(false);

  function drawState() {
    const { W, H } = dims;
    ctx.clearRect(0, 0, W, H);

    const slots = Math.min(B, TARGET.length);
    const cellW = Math.min(56, (W - 40) / slots);
    const totalW = slots * cellW;
    const startX = (W - totalW) / 2;
    const cellH = 48;
    const topY = 40;

    // title
    ctx.font = 'bold 11px monospace';
    ctx.fillStyle = '#abb2bf';
    ctx.textAlign = 'center';
    ctx.fillText(`Block diffusion  ·  B = ${B}  ·  target: "${TARGET.slice(0,B).join('')}"`, W/2, 22);

    for (let i = 0; i < slots; i++) {
      const x = startX + i * cellW;
      const isRevealed = revealed[i];

      ctx.fillStyle = isRevealed ? 'rgba(16,185,129,0.18)' : 'rgba(139,92,246,0.12)';
      ctx.strokeStyle = isRevealed ? '#10b981' : '#7c3aed';
      ctx.lineWidth = 1.5;
      roundRect2(ctx, x+2, topY, cellW-4, cellH, 5);
      ctx.fill(); ctx.stroke();

      ctx.textAlign = 'center';
      if (isRevealed) {
        ctx.fillStyle = '#98c379';
        ctx.font = 'bold 20px monospace';
        ctx.fillText(TARGET[i], x + cellW/2, topY + 30);
      } else {
        ctx.fillStyle = '#8b5cf6';
        ctx.font = 'bold 13px monospace';
        ctx.fillText('[M]', x + cellW/2, topY + 29);
      }

      // position index
      ctx.fillStyle = '#4b5563';
      ctx.font = '9px monospace';
      ctx.fillText(String(i), x + cellW/2, topY + cellH + 12);
    }

    // step counter
    ctx.fillStyle = '#abb2bf';
    ctx.font = '11px monospace';
    ctx.textAlign = 'center';
    const revCount = revealed.filter(Boolean).length;
    ctx.fillText(`${revCount} / ${slots} bytes revealed`, W/2, topY + cellH + 28);

    // speedup note when done
    if (revCount === slots && stepsDone > 0) {
      ctx.fillStyle = 'rgba(16,185,129,0.15)';
      ctx.strokeStyle = '#10b981';
      ctx.lineWidth = 1;
      roundRect2(ctx, W/2 - 120, topY + cellH + 36, 240, 22, 4);
      ctx.fill(); ctx.stroke();
      ctx.fillStyle = '#6ee7b7';
      ctx.font = 'bold 10px monospace';
      ctx.textAlign = 'center';
      ctx.fillText(`${B} bytes in ${schedule.length} steps (not ${B} sequential)`, W/2, topY + cellH + 50);
    }
  }

  function roundRect2(ctx, x, y, w, h, r) {
    ctx.beginPath();
    ctx.moveTo(x+r,y); ctx.lineTo(x+w-r,y);
    ctx.arcTo(x+w,y,x+w,y+r,r); ctx.lineTo(x+w,y+h-r);
    ctx.arcTo(x+w,y+h,x+w-r,y+h,r); ctx.lineTo(x+r,y+h);
    ctx.arcTo(x,y+h,x,y+h-r,r); ctx.lineTo(x,y+r);
    ctx.arcTo(x,y,x+r,y,r); ctx.closePath();
  }

  dims = resize();
  drawState();

  const statusEl = document.getElementById('mask-status');

  function reset() {
    revealed = new Array(B).fill(false);
    schedule = getSchedule(B);
    stepsDone = 0;
    drawState();
    const slots = Math.min(B, TARGET.length);
    statusEl.textContent = `Step 0 / ${schedule.length} — all ${slots} masked`;
  }

  document.getElementById('mask-run-btn').addEventListener('click', () => {
    if (stepsDone >= schedule.length) { reset(); return; }
    const positions = schedule[stepsDone];
    positions.forEach(i => { if (i < B) revealed[i] = true; });
    stepsDone++;
    drawState();
    const slots = Math.min(B, TARGET.length);
    const revCount = revealed.filter(Boolean).length;
    statusEl.textContent = stepsDone < schedule.length
      ? `Step ${stepsDone} / ${schedule.length} — ${revCount}/${slots} bytes revealed`
      : `Done in ${schedule.length} steps! (vs ${slots} sequential byte calls)`;
  });

  document.getElementById('mask-reset-btn').addEventListener('click', reset);

  [4,8,16].forEach(b => {
    document.getElementById(`b-btn-${b}`).addEventListener('click', () => {
      B = b;
      [4,8,16].forEach(bb => document.getElementById(`b-btn-${bb}`).classList.toggle('active', bb===b));
      reset();
    });
  });

  window.addEventListener('resize', () => {
    dims = resize();
    drawState();
  });
})();

// ══════════════════════════════════════════════════════════
// §04: STEP NAVIGATOR
// ══════════════════════════════════════════════════════════
(function() {
  let step = 0;
  const boxes  = document.querySelectorAll('.step-box');
  const prevBtn = document.getElementById('step-prev');
  const nextBtn = document.getElementById('step-next');
  const progEl  = document.getElementById('step-prog');

  function updateSteps() {
    boxes.forEach((b, i) => {
      b.classList.remove('active','done');
      if (i === step) b.classList.add('active');
      else if (i < step) b.classList.add('done');
    });
    if (prevBtn) prevBtn.disabled = step === 0;
    if (nextBtn) nextBtn.disabled = step === boxes.length - 1;
    if (progEl)  progEl.textContent = `Step ${step+1} of ${boxes.length}`;
    boxes.forEach((b, i) => {
      const n = b.querySelector('.step-num');
      if (n) n.textContent = i < step ? '✓' : String(i+1);
    });
  }

  prevBtn?.addEventListener('click', () => { if (step>0){step--;updateSteps();} });
  nextBtn?.addEventListener('click', () => { if (step<boxes.length-1){step++;updateSteps();} });
  updateSteps();
})();

// ══════════════════════════════════════════════════════════
// §05: SPEED-QUALITY PARETO SCATTER CANVAS
// ══════════════════════════════════════════════════════════
(function() {
  const canvas = document.getElementById('tradeoff-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  function resize() {
    const W = canvas.clientWidth, H = 320;
    canvas.width = W * DPR; canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
    return { W, H };
  }
  let dims = resize();

  // [bw_reduction%, arc_easy_score, label, color, shape]
  const POINTS = [
    [0,    74.33, 'BLT 3B\n(baseline)', '#6b7280', 'circle'],
    [52,   72.39, 'BLT-D-4\n3B',        '#8b5cf6', 'circle'],
    [70,   70.95, 'BLT-D-8\n3B',        '#8b5cf6', 'circle'],
    [90,   66.89, 'BLT-D-16\n3B',       '#8b5cf6', 'circle'],
    [65,   71.5,  'BLT-DV-8\n3B',       '#06b6d4', 'diamond'],
    [81,   69.5,  'BLT-DV-16\n3B',      '#06b6d4', 'diamond'],
    [77,   74.0,  'BLT-S\nk=16, 3B',    '#10b981', 'square'],
  ];

  let highlightMode = 'all'; // 'all' | 'bltd' | 'verify'

  function isHighlighted(label) {
    if (highlightMode === 'all') return true;
    if (highlightMode === 'bltd') return label.startsWith('BLT-D');
    if (highlightMode === 'verify') return label.startsWith('BLT-DV') || label.startsWith('BLT-S');
    return true;
  }

  function drawChart() {
    const { W, H } = dims;
    ctx.clearRect(0, 0, W, H);

    const padL = 54, padR = 24, padT = 20, padB = 44;
    const cW = W - padL - padR, cH = H - padT - padB;

    // grid
    ctx.strokeStyle = 'rgba(255,255,255,0.05)';
    ctx.lineWidth = 1;
    for (let i = 0; i <= 5; i++) {
      const y = padT + (i / 5) * cH;
      ctx.beginPath(); ctx.moveTo(padL, y); ctx.lineTo(padL + cW, y); ctx.stroke();
    }
    for (let i = 0; i <= 5; i++) {
      const x = padL + (i / 5) * cW;
      ctx.beginPath(); ctx.moveTo(x, padT); ctx.lineTo(x, padT + cH); ctx.stroke();
    }

    // axes
    ctx.strokeStyle = '#374151'; ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(padL, padT); ctx.lineTo(padL, padT + cH + 6); ctx.stroke();
    ctx.beginPath();
    ctx.moveTo(padL - 6, padT + cH); ctx.lineTo(padL + cW, padT + cH); ctx.stroke();

    // axis labels
    ctx.fillStyle = '#4b5563';
    ctx.font = '9px monospace';
    ctx.textAlign = 'center';
    for (let i = 0; i <= 5; i++) {
      const x = padL + (i / 5) * cW;
      ctx.fillText((i * 20) + '%', x, padT + cH + 14);
    }
    ctx.textAlign = 'right';
    for (let i = 0; i <= 4; i++) {
      const y = padT + cH - (i / 4) * cH;
      const v = 60 + i * 4;
      ctx.fillText(v + '', padL - 6, y + 4);
    }

    // axis titles
    ctx.fillStyle = '#6b7280';
    ctx.font = '10px monospace';
    ctx.textAlign = 'center';
    ctx.fillText('Memory Bandwidth Reduction  →  (higher = faster)', padL + cW/2, padT + cH + 32);
    ctx.save();
    ctx.translate(12, padT + cH/2);
    ctx.rotate(-Math.PI/2);
    ctx.fillText('ARC-Easy Accuracy  →', 0, 0);
    ctx.restore();

    // map (bw_reduction[0..100], arc_easy[60..76]) to canvas
    function toX(bw) { return padL + (bw / 100) * cW; }
    function toY(acc) { return padT + cH - ((acc - 60) / 16) * cH; }

    // draw points
    POINTS.forEach(([bw, acc, label, color, shape]) => {
      const x = toX(bw), y = toY(acc);
      const hi = isHighlighted(label);
      ctx.globalAlpha = hi ? 1 : 0.2;

      ctx.fillStyle = color;
      ctx.strokeStyle = hi ? '#fff' : 'transparent';
      ctx.lineWidth = 1.5;

      if (shape === 'circle') {
        ctx.beginPath(); ctx.arc(x, y, 8, 0, Math.PI*2); ctx.fill(); ctx.stroke();
      } else if (shape === 'diamond') {
        ctx.beginPath();
        ctx.moveTo(x, y-9); ctx.lineTo(x+9, y); ctx.lineTo(x, y+9); ctx.lineTo(x-9, y);
        ctx.closePath(); ctx.fill(); ctx.stroke();
      } else if (shape === 'square') {
        ctx.beginPath();
        ctx.roundRect(x-8, y-8, 16, 16, 2);
        ctx.fill(); ctx.stroke();
      }

      // label
      if (hi) {
        const lines = label.split('\n');
        ctx.fillStyle = '#abb2bf';
        ctx.font = '9px monospace';
        ctx.textAlign = 'left';
        const lx = x + 12, ly = y - (lines.length-1)*6;
        lines.forEach((l, i) => ctx.fillText(l, lx, ly + i*12));
      }

      ctx.globalAlpha = 1;
    });

    // legend
    ctx.font = '9px monospace';
    ctx.textAlign = 'left';
    const legX = padL + 4, legY = padT + 8;
    [[' BLT-D family','#8b5cf6','circle'],[' BLT-DV (verified)','#06b6d4','diamond'],[' BLT-S (no quality loss)','#10b981','square']].forEach(([l,c,s], i) => {
      const lx = legX, ly = legY + i * 16;
      ctx.fillStyle = c;
      if (s==='circle') { ctx.beginPath(); ctx.arc(lx+4, ly-3, 5, 0, Math.PI*2); ctx.fill(); }
      else if (s==='diamond') { ctx.beginPath(); ctx.moveTo(lx+4,ly-7); ctx.lineTo(lx+8,ly-3); ctx.lineTo(lx+4,ly+1); ctx.lineTo(lx,ly-3); ctx.closePath(); ctx.fill(); }
      else { ctx.beginPath(); ctx.roundRect(lx,ly-7,9,9,1); ctx.fill(); }
      ctx.fillStyle = '#6b7280';
      ctx.fillText(l, lx+14, ly);
    });
  }

  dims = resize();
  drawChart();

  document.getElementById('hl-all').addEventListener('click', () => {
    highlightMode = 'all';
    ['hl-all','hl-bltd','hl-verify'].forEach(id => document.getElementById(id).classList.toggle('active', id==='hl-all'));
    drawChart();
  });
  document.getElementById('hl-bltd').addEventListener('click', () => {
    highlightMode = 'bltd';
    ['hl-all','hl-bltd','hl-verify'].forEach(id => document.getElementById(id).classList.toggle('active', id==='hl-bltd'));
    drawChart();
  });
  document.getElementById('hl-verify').addEventListener('click', () => {
    highlightMode = 'verify';
    ['hl-all','hl-bltd','hl-verify'].forEach(id => document.getElementById(id).classList.toggle('active', id==='hl-verify'));
    drawChart();
  });

  window.addEventListener('resize', () => { dims = resize(); drawChart(); });
})();

// ══════════════════════════════════════════════════════════
// §06: ANIMATED BAR CHART (IntersectionObserver)
// ══════════════════════════════════════════════════════════
(function() {
  const sections = ['arc-bars', 'hella-bars', 'mmlu-bars'].map(id => document.getElementById(id));
  sections.forEach(sec => {
    if (!sec) return;
    new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          // max value for normalizing bars (80% of track width = 100% score)
          sec.querySelectorAll('.bar-fill[data-w]').forEach(b => {
            const pct = parseFloat(b.dataset.w);
            // scale: 100% score → 100% width; use 80% as visual max
            b.style.width = Math.min(pct, 100) + '%';
          });
        }
      });
    }, { threshold: 0.3 }).observe(sec);
  });
})();
</script>

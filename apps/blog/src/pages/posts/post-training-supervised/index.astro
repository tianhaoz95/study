<span class="cs-line hl-c">    rl_env    = <span class="fn">engineer_proxy</span>(benchmark)</span>
<span class="cs-line hl-c">    model     = <span class="fn">post_train</span>(sft_data, rl_env)</span>
<span class="cs-line hl-c">    score     = <span class="fn">evaluate</span>(model, benchmark)</span>
<span class="cs-line hl-c">    <span class="cmt"># score ≈ 80-90% within ~1 year</span></span>
<span class="cs-line hl-c">    <span class="kw">return</span> <span class="str">"saturated"</span></span>
<span class="cs-line hl-c">    <span class="cmt"># But model still fails new tasks</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Old paradigm: test ∈ iid(train)</span>
<span class="cs-line cmt"># New paradigm: train ∈ iid(test)</span>
<span class="cs-line cmt"># Same result: no OOD generalization</span>
      </pre>
    </div>

    <!-- panel: results -->
    <div class="cs-panel" id="panel-results">
      <pre class="cs-pre">
<span class="cs-line cmt"># Key numbers from Table 1</span>
<span class="cs-line cmt"># 7B model, pass@1</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p">math_7b = &#123;</span>
<span class="cs-line hl-p">  <span class="str">"Base (no SFT)"</span>:     &#123;<span class="str">"MATH500"</span>: <span class="num">4.2</span>,  <span class="str">"comp"</span>: <span class="num">0.2</span>&#125;,</span>
<span class="cs-line hl-p">  <span class="str">"0%-Pre (scratch)"</span>:  &#123;<span class="str">"MATH500"</span>: <span class="num">79.5</span>, <span class="str">"comp"</span>: <span class="num">27.1</span>&#125;,</span>
<span class="cs-line hl-p">  <span class="str">"0.1%-Pre (10B)"</span>:    &#123;<span class="str">"MATH500"</span>: <span class="num">88.0</span>, <span class="str">"comp"</span>: <span class="num">39.2</span>&#125;,</span>
<span class="cs-line hl-p">  <span class="str">"100%-Pre (Qwen)"</span>:   &#123;<span class="str">"MATH500"</span>: <span class="num">93.6</span>, <span class="str">"comp"</span>: <span class="num">47.9</span>&#125;,</span>
<span class="cs-line hl-p">&#125;</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># How much does pre-training contribute?</span>
<span class="cs-line">gap_no_sft   = <span class="num">93.6</span> - <span class="num">4.2</span>   <span class="cmt"># = 89.4 total</span></span>
<span class="cs-line">gap_scratch  = <span class="num">93.6</span> - <span class="num">79.5</span>  <span class="cmt"># = 14.1 from PT</span></span>
<span class="cs-line">sft_contrib  = <span class="num">79.5</span> - <span class="num">4.2</span>   <span class="cmt"># = 75.3 from SFT</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># SFT accounts for 75.3 / 89.4 = 84% of gain</span>
<span class="cs-line hl-c"><span class="cmt"># Pre-training adds only 16%</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Code results (14B, LCB V5)</span>
<span class="cs-line">code_14b = &#123;</span>
<span class="cs-line">  <span class="str">"Base"</span>:     <span class="num">5.8</span>,</span>
<span class="cs-line">  <span class="str">"0%-Pre"</span>:   <span class="num">51.0</span>,   <span class="cmt"># 14B from scratch</span></span>
<span class="cs-line">  <span class="str">"0.1%-Pre"</span>: <span class="num">53.9</span>,</span>
<span class="cs-line">  <span class="str">"100%-Pre"</span>: <span class="num">60.3</span>,</span>
<span class="cs-line">&#125;</span>
<span class="cs-line cmt"># 51% competitive programming —</span>
<span class="cs-line cmt"># from a model that started as random noise.</span>
      </pre>
    </div>

    <!-- panel: minimal -->
    <div class="cs-panel" id="panel-minimal">
      <pre class="cs-pre">
<span class="cs-line cmt"># Minimal pre-training experiment</span>
<span class="cs-line cmt"># 0.1% of Qwen's 18T tokens = 10B tokens</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">minimal_pretrain</span>(model_size):</span>
<span class="cs-line hl-p">    model = <span class="fn">init_depth_scaled</span>(model_size)</span>
<span class="cs-line hl-p">    <span class="cmt"># Pre-train on general DCLM corpus</span></span>
<span class="cs-line hl-p">    <span class="cmt"># No domain-specific data (no math/code)</span></span>
<span class="cs-line hl-p">    model = <span class="fn">pretrain</span>(model, corpus=<span class="str">"DCLM"</span>,</span>
<span class="cs-line hl-p">                     tokens=<span class="num">10e9</span>)  <span class="cmt"># 10B</span></span>
<span class="cs-line hl-p">    model = <span class="fn">sft</span>(model, data=MATH_DATA)</span>
<span class="cs-line hl-p">    <span class="kw">return</span> model</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Gap closure (7B math, comp. math avg)</span>
<span class="cs-line">scratch_score  = <span class="num">27.1</span>  <span class="cmt"># 0%-Pre</span></span>
<span class="cs-line">minimal_score  = <span class="num">39.2</span>  <span class="cmt"># 0.1%-Pre</span></span>
<span class="cs-line">full_score     = <span class="num">47.9</span>  <span class="cmt"># 100%-Pre</span></span>
<span class="cs-line"> </span>
<span class="cs-line">total_gap  = full_score - scratch_score  <span class="cmt"># 20.8</span></span>
<span class="cs-line">gap_closed = minimal_score - scratch_score  <span class="cmt"># 12.1</span></span>
<span class="cs-line">pct_closed = gap_closed / total_gap  <span class="cmt"># = 58%</span></span>
<span class="cs-line"> </span>
<span class="cs-line hl-c"><span class="cmt"># 0.1% pre-training closes 58% of the gap</span></span>
<span class="cs-line hl-c"><span class="cmt"># using ONLY general text (no math or code)</span></span>
<span class="cs-line hl-c"><span class="cmt"># → gap is structural, not knowledge-based</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># LCB V6 (7B code, pass@1)</span>
<span class="cs-line">code_gap_closed = (<span class="num">50.2</span> - <span class="num">42.9</span>) / (<span class="num">56.0</span> - <span class="num">42.9</span>)</span>
<span class="cs-line cmt"># = 55.7% — again: half the gap with 0.1% PT</span>
      </pre>
    </div>

    <!-- panel: future -->
    <div class="cs-panel" id="panel-future">
      <pre class="cs-pre">
<span class="cs-line cmt"># The "learn to learn" paradigm</span>
<span class="cs-line cmt"># What post-training currently cannot do</span>
<span class="cs-line"> </span>
<span class="cs-line hl-a"><span class="cmt"># Current paradigm: reactive, static</span></span>
<span class="cs-line hl-a"><span class="kw">def</span> <span class="fn">current_paradigm</span>(new_capability):</span>
<span class="cs-line hl-a">    sft_data = <span class="fn">human_curate</span>(new_capability)</span>
<span class="cs-line hl-a">    rl_envs  = <span class="fn">human_engineer</span>(new_capability)</span>
<span class="cs-line hl-a">    model    = <span class="fn">post_train</span>(sft_data, rl_envs)</span>
<span class="cs-line hl-a">    <span class="cmt"># Cost: human time + 100B tokens</span></span>
<span class="cs-line hl-a">    <span class="cmt"># Fails on any future unseen capability</span></span>
<span class="cs-line"> </span>
<span class="cs-line hl-g"><span class="cmt"># Proposed paradigm: self-evolving</span></span>
<span class="cs-line hl-g"><span class="kw">def</span> <span class="fn">learn_to_learn</span>(novel_task):</span>
<span class="cs-line hl-g">    <span class="kw">while</span> <span class="kw">not</span> <span class="fn">solved</span>(novel_task):</span>
<span class="cs-line hl-g">        sft  = <span class="fn">self_curate</span>(novel_task)  <span class="cmt"># auto</span></span>
<span class="cs-line hl-g">        envs = <span class="fn">self_engineer</span>(novel_task)  <span class="cmt"># auto</span></span>
<span class="cs-line hl-g">        self = <span class="fn">self_update</span>(sft, envs)</span>
<span class="cs-line hl-g">        <span class="cmt"># No human in the loop</span></span>
<span class="cs-line hl-g">    <span class="kw">return</span> <span class="str">"capability acquired"</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Meta-training objective</span>
<span class="cs-line cmt"># Teach the model to be a post-trainer</span>
<span class="cs-line cmt"># for itself:</span>
<span class="cs-line">meta_objective = <span class="fn">maximize</span>(</span>
<span class="cs-line">    <span class="fn">E</span>[perf(model, novel_task_distribution)]</span>
<span class="cs-line">)</span>
<span class="cs-line cmt"># vs. current objective:</span>
<span class="cs-line">current_objective = <span class="fn">maximize</span>(</span>
<span class="cs-line">    <span class="fn">E</span>[perf(model, known_benchmarks)]</span>
<span class="cs-line">)</span>
      </pre>
    </div>

  </div>
</aside>

</div><!-- /post-grid -->

<script>
// ── TOC + sidebar toggles ──
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});
const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ── Code sidebar tab switching ──
const tabMeta = {
  circle:     { file: 'analysis/paradigm.py',   title: 'The Full Circle' },
  experiment: { file: 'training/scratch.py',    title: 'The Key Experiment' },
  fitting:    { file: 'analysis/distribution.py', title: 'Distribution Fitting' },
  results:    { file: 'eval/benchmarks.py',     title: 'Results' },
  minimal:    { file: 'training/minimal_pt.py', title: '0.1% Pre-training' },
  future:     { file: 'future/meta_learning.py', title: 'Learn to Learn' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ── IntersectionObserver ──
const sectionMap = {
  's-circle':     'circle',
  's-experiment': 'experiment',
  's-fitting':    'fitting',
  's-results':    'results',
  's-minimal':    'minimal',
  's-future':     'future',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ── Era timeline ──
document.querySelectorAll('.era-block').forEach(b => {
  b.addEventListener('click', () => {
    document.querySelectorAll('.era-block').forEach(x => x.classList.remove('active'));
    b.classList.add('active');
  });
});

// ── Compare canvas ──
const compareCanvas = document.getElementById('compare-canvas');
const cCtx = compareCanvas ? compareCanvas.getContext('2d') : null;
const CW = compareCanvas ? compareCanvas.clientWidth : 600;
const CH = 280;
const CDPR = window.devicePixelRatio || 1;
if (compareCanvas) {
  compareCanvas.width  = CW * CDPR;
  compareCanvas.height = CH * CDPR;
  cCtx.scale(CDPR, CDPR);
}

// Data: 7B math model results
const compareData = {
  base:       { math500: 4.2,  compmath: 0.2,  color: 'rgba(107,114,128,.7)',  label: 'Base (no SFT)' },
  scratch:    { math500: 79.5, compmath: 27.1, color: 'rgba(245,158,11,.85)',   label: '0%-Pre (scratch)' },
  pretrained: { math500: 93.6, compmath: 47.9, color: 'rgba(139,92,246,.9)',    label: '100%-Pre (Qwen-2.5)' },
};
let currentCompare = 'scratch';

function drawCompare(mode) {
  if (!cCtx) return;
  const W = CW, H = CH;
  cCtx.clearRect(0, 0, W, H);

  const benchmarks = [
    { key: 'math500',  label: 'MATH-500', maxVal: 100 },
    { key: 'compmath', label: 'Comp. Math Avg', maxVal: 60 },
  ];

  const barGroups = Object.keys(compareData);
  const groupW = (W - 80) / benchmarks.length;
  const barW   = groupW * 0.22;
  const gap    = groupW * 0.06;
  const bottom = H - 40;
  const maxH   = H - 70;

  // Axes
  cCtx.strokeStyle = 'rgba(255,255,255,.06)';
  cCtx.lineWidth = 1;
  for (let v = 0; v <= 100; v += 20) {
    const y = bottom - (v / 100) * maxH;
    cCtx.beginPath();
    cCtx.moveTo(40, y);
    cCtx.lineTo(W - 10, y);
    cCtx.stroke();
    cCtx.fillStyle = 'rgba(255,255,255,.3)';
    cCtx.font = `${10 * CDPR / CDPR}px monospace`;
    cCtx.textAlign = 'right';
    cCtx.fillText(v + '%', 34, y + 4);
  }

  benchmarks.forEach((bm, bi) => {
    const groupX = 50 + bi * groupW;
    barGroups.forEach((key, ki) => {
      const d = compareData[key];
      const val = bm.key === 'compmath' ? d.compmath : d.math500;
      const maxV = bm.maxVal;
      const barH = (val / maxV) * maxH;
      const x = groupX + ki * (barW + gap);
      const y = bottom - barH;

      const isActive = key === mode;
      const alpha = isActive ? 1 : 0.25;
      cCtx.globalAlpha = alpha;
      cCtx.fillStyle = d.color;
      // Rounded top
      const r = Math.min(4, barW / 2);
      cCtx.beginPath();
      cCtx.moveTo(x + r, y);
      cCtx.lineTo(x + barW - r, y);
      cCtx.quadraticCurveTo(x + barW, y, x + barW, y + r);
      cCtx.lineTo(x + barW, bottom);
      cCtx.lineTo(x, bottom);
      cCtx.lineTo(x, y + r);
      cCtx.quadraticCurveTo(x, y, x + r, y);
      cCtx.closePath();
      cCtx.fill();

      if (isActive) {
        cCtx.globalAlpha = 1;
        cCtx.fillStyle = '#fff';
        cCtx.font = `bold ${10 * CDPR / CDPR}px monospace`;
        cCtx.textAlign = 'center';
        cCtx.fillText(val + '%', x + barW / 2, y - 5);
      }
      cCtx.globalAlpha = 1;
    });

    // Benchmark label
    cCtx.fillStyle = 'rgba(255,255,255,.4)';
    cCtx.font = `${11 * CDPR / CDPR}px monospace`;
    cCtx.textAlign = 'center';
    cCtx.fillText(bm.label, groupX + ((barW + gap) * 3) / 2, bottom + 18);
  });

  // Legend
  const lgX = 50, lgY = 10;
  barGroups.forEach((key, ki) => {
    const d = compareData[key];
    const isActive = key === mode;
    cCtx.globalAlpha = isActive ? 1 : 0.35;
    cCtx.fillStyle = d.color;
    cCtx.fillRect(lgX + ki * 155, lgY, 10, 10);
    cCtx.fillStyle = '#aaa';
    cCtx.font = `${10 * CDPR / CDPR}px monospace`;
    cCtx.textAlign = 'left';
    cCtx.fillText(d.label, lgX + ki * 155 + 14, lgY + 9);
    cCtx.globalAlpha = 1;
  });
}

function showCompare(mode) {
  currentCompare = mode;
  document.querySelectorAll('#btn-base,#btn-scratch,#btn-pretrained').forEach(b => {
    b.style.borderColor = '';
    b.style.color = '';
  });
  const btnMap = { base: 'btn-base', scratch: 'btn-scratch', pretrained: 'btn-pretrained' };
  const btn = document.getElementById(btnMap[mode]);
  if (btn) { btn.style.borderColor = 'var(--purple)'; btn.style.color = 'var(--purple-l)'; }
  drawCompare(mode);
}
showCompare('scratch');
document.querySelectorAll('[data-mode]').forEach(btn => {
  btn.addEventListener('click', () => showCompare(btn.dataset.mode));
});

// ── Distribution canvas (particle animation) ──
const distCanvas = document.getElementById('dist-canvas');
const dCtx = distCanvas ? distCanvas.getContext('2d') : null;
const DW = distCanvas ? distCanvas.clientWidth : 600;
const DH = 240;
const DDPR = window.devicePixelRatio || 1;
if (distCanvas) {
  distCanvas.width  = DW * DDPR;
  distCanvas.height = DH * DDPR;
  dCtx.scale(DDPR, DDPR);
}

// Seeded PRNG
function seededRand(n) { return ((1664525 * n + 1013904223) & 0x7fffffff) / 0x7fffffff; }

// Particles: model distribution dots
const N_DOTS = 60;
const modelDots = Array.from({ length: N_DOTS }, (_, i) => {
  // Start positions: scattered (pre-SFT model distribution)
  const sx = seededRand(i * 4)   * (DW - 40) + 20;
  const sy = seededRand(i * 4 + 1) * (DH - 40) + 20;
  // Target positions: clustered around benchmark center (post-SFT)
  const angle = seededRand(i * 4 + 2) * Math.PI * 2;
  const r = seededRand(i * 4 + 3) * 70;
  const ex = DW * 0.62 + Math.cos(angle) * r;
  const ey = DH * 0.5  + Math.sin(angle) * r;
  return { sx, sy, ex, ey };
});

let distT = 0, distAnim = null, distPlaying = false;

function easeInOut(t) { return t < 0.5 ? 2 * t * t : -1 + (4 - 2 * t) * t; }

function drawDist(t) {
  if (!dCtx) return;
  const ease = easeInOut(Math.min(t, 1));
  dCtx.clearRect(0, 0, DW, DH);

  // Benchmark region (green halo on right)
  const bx = DW * 0.62, by = DH * 0.5;
  const grad = dCtx.createRadialGradient(bx, by, 0, bx, by, 90);
  grad.addColorStop(0, 'rgba(16,185,129,.18)');
  grad.addColorStop(0.6, 'rgba(16,185,129,.06)');
  grad.addColorStop(1, 'transparent');
  dCtx.fillStyle = grad;
  dCtx.beginPath();
  dCtx.arc(bx, by, 90, 0, Math.PI * 2);
  dCtx.fill();
  dCtx.strokeStyle = 'rgba(16,185,129,.4)';
  dCtx.lineWidth = 1.5;
  dCtx.setLineDash([4, 4]);
  dCtx.beginPath();
  dCtx.arc(bx, by, 90, 0, Math.PI * 2);
  dCtx.stroke();
  dCtx.setLineDash([]);

  // Benchmark label
  dCtx.fillStyle = 'rgba(16,185,129,.8)';
  dCtx.font = `bold 11px monospace`;
  dCtx.textAlign = 'center';
  dCtx.fillText('BENCHMARK DISTRIBUTION', bx, by - 100);
  dCtx.fillText('(AIME, HMMT, LCB)', bx, by - 86);

  // Model particles
  modelDots.forEach((d, i) => {
    const x = d.sx + (d.ex - d.sx) * ease;
    const y = d.sy + (d.ey - d.sy) * ease;
    // Color: grey at t=0, purple at t=1
    const r_val = Math.round(107 + (139 - 107) * ease);
    const g_val = Math.round(114 + (92 - 114) * ease);
    const b_val = Math.round(128 + (246 - 128) * ease);
    dCtx.beginPath();
    dCtx.arc(x, y, 4, 0, Math.PI * 2);
    dCtx.fillStyle = `rgba(${r_val},${g_val},${b_val},0.85)`;
    dCtx.fill();
  });

  // Phase label
  dCtx.fillStyle = 'rgba(255,255,255,.5)';
  dCtx.font = '11px monospace';
  dCtx.textAlign = 'left';
  if (t < 0.1) dCtx.fillText('Model distribution (pre-SFT) — scattered', 15, DH - 10);
  else if (t > 0.85) dCtx.fillText('After SFT: model distribution ≈ benchmark', 15, DH - 10);
  else dCtx.fillText('SFT pulling model distribution toward benchmark…', 15, DH - 10);
}

drawDist(0);

document.getElementById('dist-play')?.addEventListener('click', () => {
  if (distPlaying) return;
  distPlaying = true;
  document.getElementById('dist-play').textContent = '⏸ Playing…';
  function step() {
    distT += 0.008;
    drawDist(distT);
    if (distT < 1) distAnim = requestAnimationFrame(step);
    else {
      distPlaying = false;
      document.getElementById('dist-play').textContent = '▶ Play';
    }
  }
  distAnim = requestAnimationFrame(step);
});
document.getElementById('dist-reset')?.addEventListener('click', () => {
  if (distAnim) cancelAnimationFrame(distAnim);
  distPlaying = false;
  distT = 0;
  drawDist(0);
  document.getElementById('dist-play').textContent = '▶ Play';
});

// ── Benchmark bar chart ──
const BM_DATA = {
  math500:  { base: 4.2,  scratch: 79.5, minimal: 88.0, pretrained: 93.6, max: 100, caption: 'MATH-500 — 7B model, pass@1. Qwen-2.5 trained on OMR (100B tokens).' },
  compmath: { base: 0.2,  scratch: 27.1, minimal: 39.2, pretrained: 47.9, max: 55,  caption: 'Competition Math Avg (AIME-24/25, HMMT-Feb/Nov-25) — 7B model, pass@1.' },
  lcbv5:    { base: 10.1, scratch: 44.4, minimal: 52.3, pretrained: 58.7, max: 70,  caption: 'LCB V5 (competitive coding) — 7B model, pass@1. Trained on OCR-II.' },
  lcbv6:    { base: 12.6, scratch: 42.9, minimal: 50.2, pretrained: 56.0, max: 70,  caption: 'LCB V6 (competitive coding) — 7B model, pass@1. Trained on OCR-II.' },
};
let currentBM = 'math500';

function showBenchmark(key) {
  currentBM = key;
  const d = BM_DATA[key];
  const sets = [
    { id: 'base',      val: d.base,      max: d.max },
    { id: 'scratch',   val: d.scratch,   max: d.max },
    { id: 'minimal',   val: d.minimal,   max: d.max },
    { id: 'pretrained',val: d.pretrained, max: d.max },
  ];
  sets.forEach(s => {
    const bar = document.getElementById('bm-bar-' + s.id);
    const val = document.getElementById('bm-val-' + s.id);
    if (bar) bar.style.width = (s.val / s.max * 100) + '%';
    if (val) val.textContent = s.val + '%';
  });
  const cap = document.getElementById('bm-caption');
  if (cap) cap.textContent = d.caption;
  // Button highlight
  ['math500','compmath','lcbv5','lcbv6'].forEach(k => {
    const btn = document.getElementById('bm-' + k);
    if (btn) { btn.style.borderColor = k === key ? 'var(--purple)' : ''; btn.style.color = k === key ? 'var(--purple-l)' : ''; }
  });
}
// Trigger bar animation on scroll into view
new IntersectionObserver(entries => {
  entries.forEach(e => {
    if (e.isIntersecting) showBenchmark(currentBM);
  });
}, { threshold: 0.3 }).observe(document.getElementById('s-results'));
showBenchmark('math500');
document.querySelectorAll('[data-bm]').forEach(btn => {
  btn.addEventListener('click', () => showBenchmark(btn.dataset.bm));
});

// ── Scale canvas ──
const scaleCanvas = document.getElementById('scale-canvas');
const sCtx = scaleCanvas ? scaleCanvas.getContext('2d') : null;
const SW = scaleCanvas ? scaleCanvas.clientWidth : 600;
const SH = 240;
const SDPR = window.devicePixelRatio || 1;
if (scaleCanvas) {
  scaleCanvas.width  = SW * SDPR;
  scaleCanvas.height = SH * SDPR;
  sCtx.scale(SDPR, SDPR);
}

function drawScale() {
  if (!sCtx) return;
  const W = SW, H = SH;
  sCtx.clearRect(0, 0, W, H);

  const L = 55, R = W - 20, B = H - 35, T = 20;
  const chartW = R - L, chartH = B - T;

  // Points: [pretrain_tokens (B), comp_math_avg pass@1, color, label]
  const pts = [
    [0,     27.1, '#f59e0b', '0%-Pre\n(scratch)'],
    [10,    39.2, '#06b6d4', '0.1%-Pre\n(10B tokens)'],
    [18000, 47.9, '#8b5cf6', '100%-Pre\n(18T tokens)'],
  ];

  // Log-scale X: 0 → mapped to 0, then log scale for 10..18000
  // Use a pseudo-log that maps 0→0, 10→0.1, 18000→1
  function xMap(v) {
    if (v === 0) return L;
    const logMin = Math.log10(10), logMax = Math.log10(18000);
    return L + ((Math.log10(v) - logMin) / (logMax - logMin)) * chartW * 0.85 + chartW * 0.12;
  }
  const yMap = v => B - ((v - 0) / 55) * chartH;

  // Grid lines
  sCtx.strokeStyle = 'rgba(255,255,255,.05)';
  sCtx.lineWidth = 1;
  [10, 20, 30, 40, 50].forEach(v => {
    const y = yMap(v);
    sCtx.beginPath();
    sCtx.moveTo(L, y);
    sCtx.lineTo(R, y);
    sCtx.stroke();
    sCtx.fillStyle = 'rgba(255,255,255,.3)';
    sCtx.font = '10px monospace';
    sCtx.textAlign = 'right';
    sCtx.fillText(v + '%', L - 4, y + 4);
  });

  // Axes
  sCtx.strokeStyle = 'rgba(255,255,255,.15)';
  sCtx.lineWidth = 1.5;
  sCtx.beginPath();
  sCtx.moveTo(L, T);
  sCtx.lineTo(L, B);
  sCtx.lineTo(R, B);
  sCtx.stroke();

  // Draw line connecting points (only the two non-zero ones)
  sCtx.strokeStyle = 'rgba(139,92,246,.4)';
  sCtx.lineWidth = 2;
  sCtx.setLineDash([5, 5]);
  sCtx.beginPath();
  pts.forEach((p, i) => {
    const x = xMap(p[0]), y = yMap(p[1]);
    i === 0 ? sCtx.moveTo(x, y) : sCtx.lineTo(x, y);
  });
  sCtx.stroke();
  sCtx.setLineDash([]);

  // Draw points with labels
  pts.forEach(p => {
    const x = xMap(p[0]), y = yMap(p[1]);
    sCtx.beginPath();
    sCtx.arc(x, y, 7, 0, Math.PI * 2);
    sCtx.fillStyle = p[2];
    sCtx.fill();

    sCtx.fillStyle = '#eee';
    sCtx.font = 'bold 11px monospace';
    sCtx.textAlign = 'center';
    sCtx.fillText(p[1] + '%', x, y - 12);

    const lines = p[3].split('\n');
    sCtx.fillStyle = 'rgba(255,255,255,.5)';
    sCtx.font = '9px monospace';
    lines.forEach((ln, li) => sCtx.fillText(ln, x, y + 20 + li * 11));
  });

  // X-axis label
  sCtx.fillStyle = 'rgba(255,255,255,.4)';
  sCtx.font = '10px monospace';
  sCtx.textAlign = 'center';
  sCtx.fillText('Pre-training compute (tokens, log scale)', (L + R) / 2, H - 6);

  // Y-axis label
  sCtx.save();
  sCtx.translate(10, (T + B) / 2);
  sCtx.rotate(-Math.PI / 2);
  sCtx.fillText('Comp. Math Avg pass@1', 0, 0);
  sCtx.restore();
}
drawScale();

// ── Step navigator (reactive cycle) ──
let cycleStep = 0;
const cycleBoxes  = document.querySelectorAll('#cycle-steps .step-box');
const cyclePrev   = document.getElementById('cycle-prev');
const cycleNext   = document.getElementById('cycle-next');
const cycleProg   = document.getElementById('cycle-prog');

function updateCycle() {
  cycleBoxes.forEach((b, i) => {
    b.classList.remove('active', 'done');
    if (i === cycleStep) b.classList.add('active');
    else if (i < cycleStep) b.classList.add('done');
  });
  cyclePrev.disabled = cycleStep === 0;
  cycleNext.disabled = cycleStep === cycleBoxes.length - 1;
  cycleProg.textContent = `Step ${cycleStep + 1} of ${cycleBoxes.length}`;
  cycleBoxes.forEach((b, i) => {
    const n = b.querySelector('.step-num');
    if (n) n.textContent = i < cycleStep ? '✓' : String(i + 1);
  });
}
cyclePrev?.addEventListener('click', () => { if (cycleStep > 0) { cycleStep--; updateCycle(); } });
cycleNext?.addEventListener('click', () => { if (cycleStep < cycleBoxes.length - 1) { cycleStep++; updateCycle(); } });
updateCycle();
</script>
</BaseLayout>

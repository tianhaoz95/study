<span class="cs-line cmt"># Rejection sampling: token ŷ ~ q(·)</span>
<span class="cs-line cmt"># accepted with prob min(1, p(ŷ)/q(ŷ))</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">reject_sample</span>(p, q):</span>
<span class="cs-line">    y = <span class="fn">sample</span>(q)              <span class="cmt"># draw from draft</span></span>

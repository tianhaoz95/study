<span class="cs-line"> </span>
<span class="cs-line cmt"># Shannon entropy of target distribution</span>
<span class="cs-line hl-p">H = -<span class="fn">sum</span>(p[v] * <span class="fn">log</span>(p[v]) <span class="kw">for</span> v <span class="kw">in</span> V)</span>
<span class="cs-line"> </span>

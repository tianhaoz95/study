<span class="cs-line">    <span class="kw">while</span> <span class="kw">not</span> done:</span>
<span class="cs-line cmt">        # Draft γ=3 candidate tokens</span>
<span class="cs-line hl-c">        drafts = policy.mtp_heads(hidden)</span>

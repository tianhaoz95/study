<span class="cs-line hl-g">        logits = policy.backbone(tokens + drafts)</span>
<span class="cs-line cmt">        # Accept/reject each draft token</span>
<span class="cs-line">        accepted = verify(drafts, logits)</span>
<span class="cs-line">        tokens.extend(accepted)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Problem: as RL raises entropy, acceptance drops</span>
<span class="cs-line cmt"># Step 1: 0.960 → 0.948  (-1.2%)</span>
<span class="cs-line cmt"># Step 2: 0.895 → 0.869  (-2.6%)</span>
<span class="cs-line cmt"># Step 3: 0.810 → 0.775  (-3.5%) ← compounds!</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># GRPO objective (policy gradient)</span>
<span class="cs-line hl-a"><span class="kw">def</span> <span class="fn">grpo_loss</span>(theta, prompts, rewards):</span>
<span class="cs-line">    r = pi_theta / pi_theta_old  <span class="cmt"># ratio</span></span>
<span class="cs-line">    A = (R - mu_G) / sigma_G     <span class="cmt"># advantage</span></span>
<span class="cs-line">    <span class="kw">return</span> -<span class="fn">mean</span>(<span class="fn">clip</span>(r*A, 1-eps, 1+eps)*A)</span>

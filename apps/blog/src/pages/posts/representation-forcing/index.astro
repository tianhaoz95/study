.seq-token.token-rep{border-color:rgba(16,185,129,.3)}
.seq-token.token-pixel{border-color:rgba(6,182,212,.3)}
.seq-token.active-focus{background:var(--purple);color:#fff;border-color:var(--purple)}
.seq-token.attended{background:var(--purple-dim);color:var(--purple-l);border-color:var(--purple-l)}

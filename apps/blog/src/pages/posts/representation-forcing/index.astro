</div><!-- /post-grid -->

<script>
// ── TOC & Sidebar Collapsing ─────────────────────────────────
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});

const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ── Tab Switching ────────────────────────────────────────────
const tabMeta = {
  intro:         { file: 'model/umm_architecture.py', title: 'UMM Architecture' },
  online_vq:     { file: 'model/online_vq.py',         title: 'Online Vector Quantization' },
  sequence:      { file: 'model/sequence_mask.py',     title: 'Causal-to-Bidirectional Mask' },
  flow_matching: { file: 'model/flow_matching.py',     title: 'Pixel Flow Matching Loss' },
  ablations:     { file: 'results/ablations.py',       title: 'Guidance & Format Ablations' },
  benchmarks:    { file: 'results/benchmarks.py',      title: 'Multimodal Benchmarks' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ── IntersectionObserver: TOC sync on scroll ─────────────────
const sectionMap = {
  's-bottleneck': 'intro',
  's-online-vq': 'online_vq',
  's-sequence':   'sequence',
  's-pixel-gen':  'flow_matching',
  's-ablations':  'ablations',
  's-payoff':     'benchmarks'
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
        
        // Trigger bar animations when scrolled into view
        if (e.target.id === 's-ablations') {
          document.querySelectorAll('#ablation-chart .chart-fill').forEach(b => {
            b.style.width = b.dataset.w + '%';
          });
        }
        if (e.target.id === 's-payoff') {
          document.querySelectorAll('#understanding-chart .chart-fill').forEach(b => {
            b.style.width = b.dataset.w + '%';
          });
        }
      }
    });
  }, { threshold: 0.2 }).observe(s)
);

// ── Interactive Quantization Flow ────────────────────────────
const vqCells = document.querySelectorAll('.vq-cell');
const vqProtos = document.querySelectorAll('.vq-proto');
const vqStatus = document.getElementById('vq-status');

vqCells.forEach(cell => {
  cell.addEventListener('click', () => {
    // Reset selections
    vqCells.forEach(c => c.classList.remove('selected'));
    vqProtos.forEach(p => p.classList.remove('active'));
    
    cell.classList.add('selected');
    const type = cell.dataset.type;
    const matchingProto = document.getElementById('proto-' + type);
    if (matchingProto) {
      matchingProto.classList.add('active');
    }
    
    // Update status text with mock features
    let text = '';
    if (type === 'bg') {
      text = 'Patch matches Background texture. Continuous features z_i mapped to Codebook Prototype #1209 (flat dark backdrop).';
    } else if (type === 'leaf') {
      text = 'Patch matches Green Edge/Leaf texture. Continuous features z_i mapped to Codebook Prototype #9281 (green shape).';
    } else if (type === 'apple') {
      text = 'Patch matches Red Sphere/Skin texture. Continuous features z_i mapped to Codebook Prototype #4012 (red sphere).';
    } else if (type === 'plate') {
      text = 'Patch matches Curved Rim/Plate texture. Continuous features z_i mapped to Codebook Prototype #7384 (curved rim).';
    }
    vqStatus.textContent = text;
  });
});

// ── Interactive Sequence & Attention Mask Flow ──────────────
const seqTokens = document.querySelectorAll('.seq-token');
const maskStatus = document.getElementById('mask-status');

seqTokens.forEach(tok => {
  tok.addEventListener('mouseenter', () => {
    const idx = parseInt(tok.dataset.idx);
    
    // Reset classes
    seqTokens.forEach(t => t.classList.remove('active-focus', 'attended'));
    
    tok.classList.add('active-focus');
    
    if (tok.classList.contains('token-text')) {
      // Text: causal attention to preceding text only
      for (let i = 0; i < idx; i++) {
        seqTokens[i].classList.add('attended');
      }
      maskStatus.innerHTML = `<strong>Causal Mask:</strong> Text token at position ${idx} attends exclusively to preceding text tokens.`;
    } else if (tok.classList.contains('token-rep')) {
      // Rep: causal attention to preceding text & rep
      for (let i = 0; i < idx; i++) {
        seqTokens[i].classList.add('attended');
      }
      maskStatus.innerHTML = `<strong>Causal Mask:</strong> Representation token at position ${idx} attends to preceding text and representations.`;
    } else if (tok.classList.contains('token-pixel')) {
      // Pixel: bidirectional attention to all pixels + causal to text/reps
      seqTokens.forEach(t => {
        const tidx = parseInt(t.dataset.idx);
        if (t.classList.contains('token-pixel') && tidx !== idx) {
          t.classList.add('attended');
        } else if (tidx < 11) {
          t.classList.add('attended');
        }
      });
      maskStatus.innerHTML = `<strong>Bidirectional Denoising Mask:</strong> Pixel patch at position ${idx} attends bidirectionally to all pixel patches, and is causally conditioned on all preceding text and predicted representation tokens.`;
    }
  });
  
  tok.addEventListener('mouseleave', () => {
    seqTokens.forEach(t => t.classList.remove('active-focus', 'attended'));
    maskStatus.innerHTML = 'Hover over a token to visualize the attention pattern.';
  });
});

// ── Canvas Denoising Trajectory Simulation ───────────────────
const canvas = document.getElementById('denoise-canvas');
let ctx = null;
let W = 0, H = 0, DPR = 1;
let animFrameId = null;
let isPlaying = false;
let tVal = 0.0; // 0 to 1
let useRF = true;

if (canvas) {
  ctx = canvas.getContext('2d');
  W = canvas.clientWidth;
  H = 240;
  DPR = window.devicePixelRatio || 1;
  canvas.width = W * DPR;
  canvas.height = H * DPR;
  ctx.scale(DPR, DPR);
  
  // Seeded PRNG for reproducibility
  function makeRandom(seed) {
    let m = 0x80000000;
    let a = 1103515245;
    let c = 12345;
    let state = seed ? seed : Math.random() * m;
    return function() {
      state = (a * state + c) % m;
      return state / (m - 1);
    };
  }
  
  const rand = makeRandom(42);
  const particles = [];
  const N_PARTICLES = 500;
  
  // Initialize particles
  for (let i = 0; i < N_PARTICLES; i++) {
    // Target position in standard layout (apple on plate)
    // Red apple in center circle, blue plate oval around it, dark grey background
    let targetX, targetY, targetColor;
    const rVal = rand();
    
    if (rVal < 0.25) {
      // Apple: Red circle
      const angle = rand() * Math.PI * 2;
      const radius = rand() * 32;
      targetX = W / 2 + Math.cos(angle) * radius;
      targetY = H / 2 - 10 + Math.sin(angle) * radius;
      targetColor = `hsl(${0 + rand() * 10}, 80%, ${45 + rand() * 15}%)`; // rich red
    } else if (rVal < 0.6) {
      // Plate: Blue oval
      const angle = rand() * Math.PI * 2;
      const radiusX = 40 + rand() * 50;
      const radiusY = 20 + rand() * 25;
      targetX = W / 2 + Math.cos(angle) * radiusX;
      targetY = H / 2 + 10 + Math.sin(angle) * radiusY;
      targetColor = `hsl(${220 + rand() * 15}, 60%, ${35 + rand() * 15}%)`; // dark blue/grey plate
    } else {
      // Background: dark slate
      targetX = rand() * W;
      targetY = rand() * H;
      targetColor = `hsl(${240 + rand() * 10}, 15%, ${15 + rand() * 10}%)`;
    }
    
    // Initial noise coordinates
    const noiseX = rand() * W;
    const noiseY = rand() * H;
    const noiseColor = `hsl(${rand() * 360}, 75%, 50%)`;
    
    particles.push({
      noiseX, noiseY, noiseColor,
      targetX, targetY, targetColor,
      currX: noiseX, currY: noiseY, currColor: noiseColor
    });
  }
  
  function drawCanvas() {
    ctx.fillStyle = '#0f111a';
    ctx.fillRect(0, 0, W, H);
    
    particles.forEach(p => {
      let x, y, color;
      
      if (useRF) {
        // Representation Forcing: clean smooth paths (guided flow matching)
        x = p.noiseX + (p.targetX - p.noiseX) * tVal;
        y = p.noiseY + (p.targetY - p.noiseY) * tVal;
        
        // Color transition
        const tLerp = Math.min(1.0, tVal * 1.3); // snap color slightly early
        color = lerpColor(p.noiseColor, p.targetColor, tLerp);
      } else {
        // Naive: chaotic drift, missing key structure
        // We add noise perturbation, and instead of centering correctly, it smears
        const perturbation = (1 - tVal) * 15 + Math.sin(tVal * 15 + p.noiseX) * 8;
        const targetX_perturbed = p.targetX + (p.noiseX - p.targetX) * 0.3 + (rand() - 0.5) * perturbation;
        const targetY_perturbed = p.targetY + (p.noiseY - p.targetY) * 0.3 + (rand() - 0.5) * perturbation;
        
        x = p.noiseX + (targetX_perturbed - p.noiseX) * tVal;
        y = p.noiseY + (targetY_perturbed - p.noiseY) * tVal;
        
        // Color blends into a blurry smudge
        const blurredColor = `hsl(120, 10%, 30%)`; // default grey blur
        const targetBlur = lerpColor(p.targetColor, blurredColor, 0.4);
        color = lerpColor(p.noiseColor, targetBlur, tVal);
      }
      
      ctx.beginPath();
      ctx.arc(x, y, 2.5, 0, Math.PI * 2);
      ctx.fillStyle = color;
      ctx.fill();
    });
    
    // Draw guide overlay lines (only for RF to show structural boundary)
    if (useRF && tVal > 0.1) {
      ctx.strokeStyle = `rgba(16, 185, 129, ${tVal * 0.3})`; // rep boundary lines
      ctx.lineWidth = 1;
      
      // Plate boundary
      ctx.beginPath();
      ctx.ellipse(W / 2, H / 2 + 10, 80, 40, 0, 0, Math.PI * 2);
      ctx.stroke();
      
      // Apple boundary
      ctx.beginPath();
      ctx.arc(W / 2, H / 2 - 10, 32, 0, Math.PI * 2);
      ctx.stroke();
      
      ctx.fillStyle = `rgba(16, 185, 129, ${tVal * 0.8})`;
      ctx.font = '9px monospace';
      ctx.fillText('rep_tokens: apple shape guide', W / 2 - 80, H / 2 - 48);
      ctx.fillText('rep_tokens: plate rim guide', W / 2 - 80, H / 2 + 65);
    }
  }
  
  function lerpColor(c1, c2, factor) {
    // Simple helper to lerp HSL colors
    const getHSL = (str) => {
      const match = str.match(/hsl\((\d+(?:\.\d+)?),\s*(\d+(?:\.\d+)?)%,\s*(\d+(?:\.\d+)?)%\)/);
      if (match) return [parseFloat(match[1]), parseFloat(match[2]), parseFloat(match[3])];
      return [0, 0, 0];
    };
    const [h1, s1, l1] = getHSL(c1);
    const [h2, s2, l2] = getHSL(c2);
    
    // Handle hue wrapping
    let h;
    let dh = h2 - h1;
    if (dh > 180) {
      h = h1 + (dh - 360) * factor;
    } else if (dh < -180) {
      h = h1 + (dh + 360) * factor;
    } else {
      h = h1 + dh * factor;
    }
    
    const s = s1 + (s2 - s1) * factor;
    const l = l1 + (l2 - l1) * factor;
    return `hsl(${h}, ${s}%, ${l}%)`;
  }
  
  const slider = document.getElementById('t-slider');
  const tValLabel = document.getElementById('t-val');
  
  function setT(val) {
    tVal = val;
    slider.value = val * 100;
    tValLabel.textContent = val.toFixed(2);
    drawCanvas();
  }
  
  slider.addEventListener('input', (e) => {
    isPlaying = false;
    document.getElementById('btn-play').textContent = 'Play';
    setT(parseFloat(e.target.value) / 100);
  });
  
  document.getElementById('btn-play').addEventListener('click', (e) => {
    if (isPlaying) {
      isPlaying = false;
      e.target.textContent = 'Play';
    } else {
      if (tVal >= 1.0) setT(0.0);
      isPlaying = true;
      e.target.textContent = 'Pause';
      tick();
    }
  });
  
  document.getElementById('btn-reset').addEventListener('click', () => {
    isPlaying = false;
    document.getElementById('btn-play').textContent = 'Play';
    setT(0.0);
  });
  
  const btnRf = document.getElementById('btn-rf-toggle');
  const btnNaive = document.getElementById('btn-naive-toggle');
  
  btnRf.addEventListener('click', () => {
    useRF = true;
    btnRf.classList.add('active');
    btnNaive.classList.remove('active');
    drawCanvas();
  });
  
  btnNaive.addEventListener('click', () => {
    useRF = false;
    btnNaive.classList.add('active');
    btnRf.classList.remove('active');
    drawCanvas();
  });
  
  function tick() {
    if (!isPlaying) return;
    let nextT = tVal + 0.015;
    if (nextT >= 1.0) {
      setT(1.0);
      isPlaying = false;
      document.getElementById('btn-play').textContent = 'Play';
    } else {
      setT(nextT);
      animFrameId = requestAnimationFrame(tick);
    }
  }
  
  // Initial draw
  setT(0.0);
}
</script>
</BaseLayout>

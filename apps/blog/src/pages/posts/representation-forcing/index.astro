<span class="cs-line">        <span class="super">super</span>().<span class="fn">__init__</span>()</span>
<span class="cs-line cmt">        # Shared transformer attention layers</span>
<span class="cs-line">        <span class="self">self</span>.attn_layers = <span class="cls">nn.ModuleList</span>([</span>
<span class="cs-line">            <span class="cls">SharedSelfAttentionLayer</span>(d_model) <span class="kw">for</span> _ <span class="kw">in</span> <span class="fn">range</span>(<span class="num">32</span>)</span>
<span class="cs-line">        ])</span>
<span class="cs-line">        </span>
<span class="cs-line cmt">        # Routed Modality-Specific Experts (FFN pools)</span>
<span class="cs-line hl-c">        <span class="self">self</span>.experts_text = <span class="cls">nn.ModuleList</span>([<span class="cls">FFNExpert</span>(d_model) <span class="kw">for</span> _ <span class="kw">in</span> <span class="fn">range</span>(<span class="num">8</span>)])</span>
<span class="cs-line hl-g">        <span class="self">self</span>.experts_rep  = <span class="cls">nn.ModuleList</span>([<span class="cls">FFNExpert</span>(d_model) <span class="kw">for</span> _ <span class="kw">in</span> <span class="fn">range</span>(<span class="num">8</span>)])</span>
<span class="cs-line hl-a">        <span class="self">self</span>.experts_pixel = <span class="cls">nn.ModuleList</span>([<span class="cls">FFNExpert</span>(d_model) <span class="kw">for</span> _ <span class="kw">in</span> <span class="fn">range</span>(<span class="num">8</span>)])</span>
<span class="cs-line">        </span>
<span class="cs-line cmt">        # Modality Heads</span>
<span class="cs-line">        <span class="self">self</span>.text_head = <span class="cls">nn.Linear</span>(d_model, vocab_size, bias=<span class="cls">False</span>)</span>
<span class="cs-line">        <span class="self">self</span>.rep_head = <span class="cls">nn.Linear</span>(d_model, codebook_size, bias=<span class="cls">False</span>)</span>
<span class="cs-line">        <span class="self">self</span>.pixel_head = <span class="cls">nn.Linear</span>(d_model, <span class="num">16</span> * <span class="num">16</span> * <span class="num">3</span>)</span>
<span class="cs-line">        </span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">forward</span>(<span class="self">self</span>, tokens, rep_tokens, pixel_patches, routing_mask):</span>
<span class="cs-line">        x_text = <span class="self">self</span>.<span class="fn">embed_text</span>(tokens)</span>
<span class="cs-line">        x_rep = <span class="self">self</span>.<span class="fn">embed_rep</span>(rep_tokens) + <span class="self">self</span>.spatial_pos_2d</span>
<span class="cs-line">        x_pixel = <span class="self">self</span>.<span class="fn">embed_pixel</span>(pixel_patches)</span>
<span class="cs-line">        </span>
<span class="cs-line">        x = <span class="cls">torch</span>.<span class="fn">cat</span>([x_text, x_rep, x_pixel], dim=<span class="num">1</span>)</span>
<span class="cs-line">        mask = <span class="self">self</span>.<span class="fn">get_custom_attention_mask</span>(routing_mask)</span>
<span class="cs-line">        </span>
<span class="cs-line kw">        for</span> layer <span class="kw">in</span> <span class="self">self</span>.attn_layers:</span>
<span class="cs-line">            x = <span class="fn">layer</span>(x, mask=mask)</span>
<span class="cs-line cmt">            # Route tokens to specific experts based on routing_mask</span>
<span class="cs-line">            x = <span class="self">self</span>.<span class="fn">route_experts</span>(x, routing_mask)</span>
<span class="cs-line">            </span>
<span class="cs-line">        h_text, h_rep, h_pixel = <span class="self">self</span>.<span class="fn">split_hidden_states</span>(x)</span>
<span class="cs-line kw">        return</span> <span class="self">self</span>.<span class="fn">text_head</span>(h_text), <span class="self">self</span>.<span class="fn">rep_head</span>(h_rep), <span class="self">self</span>.<span class="fn">pixel_head</span>(h_pixel)</pre>
    </div>
    
    <!-- Panel 2: Online VQ -->
    <div class="cs-panel" id="panel-online_vq">
      <pre class="cs-pre"><span class="cs-line cmt"># representation-forcing/model/online_vq.py</span>
<span class="cs-line kw">import</span> <span class="cls">torch</span>
<span class="cs-line kw">import</span> <span class="cls">torch.nn.functional</span> <span class="kw">as</span> <span class="cls">F</span>

<span class="cs-line hl-p">@torch.no_grad()</span>
<span class="cs-line kw">def</span> <span class="fn">online_vector_quantization</span>(z, prototypes, momentum=<span class="num">0.9999</span>, temp=<span class="num">0.5</span>):</span>
<span class="cs-line cmt">    # 1. Normalize features and learnable codebook prototypes</span>
<span class="cs-line">    z = <span class="cls">F</span>.<span class="fn">normalize</span>(z, p=<span class="num">2</span>, dim=<span class="num">1</span>)</span>
<span class="cs-line">    C = <span class="cls">F</span>.<span class="fn">normalize</span>(prototypes, p=<span class="num">2</span>, dim=<span class="num">1</span>)</span>
<span class="cs-line">    </span>
<span class="cs-line cmt">    # 2. Compute pairwise cosine similarities</span>
<span class="cs-line hl-c">    scores = <span class="cls">torch</span>.<span class="fn">matmul</span>(z, C.T) / temp  <span class="cmt"># Shape: (B * L, K)</span></span>
<span class="cs-line">    </span>
<span class="cs-line cmt">    # 3. Sinkhorn-Knopp balance (1 iteration)</span>
<span class="cs-line hl-c">    scores = <span class="cls">F</span>.<span class="fn">softmax</span>(scores, dim=<span class="num">1</span>)  <span class="cmt"># Row-normalize</span></span>
<span class="cs-line hl-c">    scores = <span class="cls">F</span>.<span class="fn">softmax</span>(scores, dim=<span class="num">0</span>)  <span class="cmt"># Col-normalize</span></span>
<span class="cs-line">    </span>
<span class="cs-line cmt">    # 4. Discrete assignment</span>
<span class="cs-line hl-g">    assignments = <span class="cls">torch</span>.<span class="fn">argmax</span>(scores, dim=<span class="num">1</span>)  <span class="cmt"># Shape: (B * L,)</span></span>
<span class="cs-line">    </span>
<span class="cs-line cmt">    # 5. Momentum update codebook</span>
<span class="cs-line">    N_k = <span class="cls">torch</span>.<span class="fn">zeros</span>(C.<span class="fn">size</span>(<span class="num">0</span>), device=z.device)</span>
<span class="cs-line">    C_new = <span class="cls">torch</span>.<span class="fn">zeros_like</span>(C)</span>
<span class="cs-line">    </span>
<span class="cs-line">    ones = <span class="cls">torch</span>.<span class="fn">ones</span>(z.<span class="fn">size</span>(<span class="num">0</span>), device=z.device)</span>
<span class="cs-line">    N_k.<span class="fn">scatter_add_</span>(<span class="num">0</span>, assignments, ones)</span>
<span class="cs-line">    C_new.<span class="fn">scatter_add_</span>(<span class="num">0</span>, assignments.<span class="fn">unsqueeze</span>(<span class="num">1</span>).<span class="fn">expand</span>(-<span class="num">1</span>, C.<span class="fn">size</span>(<span class="num">1</span>)), z)</span>
<span class="cs-line">    </span>
<span class="cs-line hl-a">    mask = N_k &gt; 0</span>
<span class="cs-line hl-a">    C_new[mask] = <span class="cls">F</span>.<span class="fn">normalize</span>(C_new[mask] / N_k[mask].<span class="fn">unsqueeze</span>(<span class="num">1</span>), p=<span class="num">2</span>, dim=<span class="num">1</span>)</span>
<span class="cs-line hl-a">    prototypes.<span class="fn">copy_</span>(momentum * prototypes + (<span class="num">1</span> - momentum) * C_new)</span>
<span class="cs-line">    </span>
<span class="cs-line kw">    return</span> assignments</pre>
    </div>
    
    <!-- Panel 3: Sequence & Mask -->
    <div class="cs-panel" id="panel-sequence">
      <pre class="cs-pre"><span class="cs-line cmt"># representation-forcing/model/sequence_mask.py</span>
<span class="cs-line kw">import</span> <span class="cls">torch</span>

<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">get_umm_attention_mask</span>(seq_len_text, seq_len_rep, seq_len_pixel):</span>
<span class="cs-line">    tot_len = seq_len_text + seq_len_rep + seq_len_pixel</span>
<span class="cs-line">    mask = <span class="cls">torch</span>.<span class="fn">full</span>((tot_len, tot_len), <span class="fn">float</span>(<span class="str">'-inf'</span>))</span>
<span class="cs-line">    </span>
<span class="cs-line cmt">    # 1. Text causal mask</span>
<span class="cs-line hl-c">    for i in range(seq_len_text):</span>
<span class="cs-line hl-c">        mask[i, :i+1] = 0.0</span>
<span class="cs-line">        </span>
<span class="cs-line cmt">    # 2. Rep causal mask</span>
<span class="cs-line hl-g">    for i in range(seq_len_rep):</span>
<span class="cs-line hl-g">        idx = seq_len_text + i</span>
<span class="cs-line hl-g">        mask[idx, :idx+1] = 0.0</span>
<span class="cs-line">        </span>
<span class="cs-line cmt">    # 3. Pixel bidirectional + causal condition mask</span>
<span class="cs-line hl-a">    pixel_start = seq_len_text + seq_len_rep</span>
<span class="cs-line hl-a">    mask[pixel_start:, :pixel_start] = 0.0  # attend to preceding</span>
<span class="cs-line hl-a">    mask[pixel_start:, pixel_start:] = 0.0  # bidirectional self-att</span>
<span class="cs-line">    </span>
<span class="cs-line kw">    return</span> mask</pre>
    </div>
    
    <!-- Panel 4: Flow Matching -->
    <div class="cs-panel" id="panel-flow_matching">
      <pre class="cs-pre"><span class="cs-line cmt"># representation-forcing/model/flow_matching.py</span>
<span class="cs-line kw">import</span> <span class="cls">torch</span>
<span class="cs-line kw">import</span> <span class="cls">torch.nn</span> <span class="kw">as</span> <span class="cls">nn</span>

<span class="cs-line hl-p"><span class="kw">class</span> <span class="cls">FlowMatchingLoss</span>(<span class="cls">nn.Module</span>):</span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">forward</span>(<span class="self">self</span>, model, x, rep_tokens, text_cond):</span>
<span class="cs-line">        B, L_pixel, _ = x.shape</span>
<span class="cs-line">        device = x.device</span>
<span class="cs-line">        </span>
<span class="cs-line cmt">        # 1. Sample timestep t in [0, 1]</span>
<span class="cs-line">        t = <span class="cls">torch</span>.<span class="fn">rand</span>(B, <span class="num">1</span>, <span class="num">1</span>, device=device)</span>
<span class="cs-line">        </span>
<span class="cs-line cmt">        # 2. Sample Gaussian noise</span>
<span class="cs-line">        epsilon = <span class="cls">torch</span>.<span class="fn">randn_like</span>(x)</span>
<span class="cs-line">        </span>
<span class="cs-line cmt">        # 3. Interpolate noisy patches at timestep t</span>
<span class="cs-line hl-c">        z_t = t * x + (<span class="num">1.0</span> - t) * epsilon</span>
<span class="cs-line">        </span>
<span class="cs-line cmt">        # 4. Predict clean patch velocity via model</span>
<span class="cs-line">        x_theta = <span class="fn">model</span>(z_t, rep_tokens, text_cond, t=t)</span>
<span class="cs-line hl-g">        v_theta = (x_theta - z_t) / (<span class="num">1.0</span> - t + <span class="num">1e-5</span>)</span>
<span class="cs-line hl-g">        v_target = x - epsilon</span>
<span class="cs-line">        </span>
<span class="cs-line cmt">        # 5. MSE Velocity Loss</span>
<span class="cs-line kw">        return</span> <span class="cls">F</span>.<span class="fn">mse_loss</span>(v_theta, v_target)</pre>
    </div>
    

<script>
// ─── TOC + sidebar toggles ───────────────────────────────────
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});
const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ─── Code sidebar tabs ───────────────────────────────────────
const tabMeta = {
  problem:     { file: 'arbor/ao.py',            title: 'AO Formulation' },
  tree:        { file: 'arbor/tree.py',           title: 'Hypothesis Tree' },
  htr:         { file: 'arbor/htr.py',            title: 'HTR Algorithm' },
  propagation: { file: 'arbor/backpropagate.py',  title: 'Insight Propagation' },
  guard:       { file: 'arbor/merge_gate.py',     title: 'Dev/Test Guard' },
  results:     { file: 'arbor/results.txt',       title: 'Main Results' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ─── IntersectionObserver — TOC + tab sync ───────────────────
const sectionMap = {
  's-problem':     'problem',
  's-tree':        'tree',
  's-htr':         'htr',
  's-propagation': 'propagation',
  's-guard':       'guard',
  's-results':     'results',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ─── §01: Trajectory canvas ──────────────────────────────────
(function() {
  const canvas = document.getElementById('traj-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  let mode = 'linear';
  let W, H, DPR;
  function resize() {
    DPR = window.devicePixelRatio || 1;
    W = canvas.clientWidth;
    H = 280;
    canvas.width  = W * DPR;
    canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
    draw();
  }

  function seededRand(n) {
    return ((1664525 * n + 1013904223) & 0x7fffffff) / 0x7fffffff;
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = 'rgba(26,26,46,0.6)';
    ctx.fillRect(0, 0, W, H);

    if (mode === 'linear') drawLinear();
    else drawTree();
  }

  function drawLinear() {
    const experiments = [
      { x: 0.1, y: 0.4, label: 'Exp 1', color: '#e06c75', status: 'failed' },
      { x: 0.28, y: 0.65, label: 'Exp 2', color: '#e06c75', status: 'failed' },
      { x: 0.46, y: 0.3, label: 'Exp 3', color: '#f59e0b', status: 'partial' },
      { x: 0.64, y: 0.7, label: 'Exp 4', color: '#e06c75', status: 'failed' },
      { x: 0.82, y: 0.45, label: 'Exp 5', color: '#f59e0b', status: 'partial' },
    ];
    // Draw arrows between sequential experiments (no cross-influence)
    ctx.strokeStyle = 'rgba(107,114,128,0.4)';
    ctx.lineWidth = 1.5;
    ctx.setLineDash([4, 4]);
    for (let i = 0; i < experiments.length - 1; i++) {
      const a = experiments[i], b = experiments[i + 1];
      ctx.beginPath();
      ctx.moveTo(a.x * W, a.y * H);
      ctx.lineTo(b.x * W, b.y * H);
      ctx.stroke();
    }
    ctx.setLineDash([]);

    // Draw experiment nodes
    experiments.forEach((e, i) => {
      const x = e.x * W, y = e.y * H;
      ctx.beginPath();
      ctx.arc(x, y, 22, 0, Math.PI * 2);
      ctx.fillStyle = e.color + '22';
      ctx.fill();
      ctx.strokeStyle = e.color;
      ctx.lineWidth = 2;
      ctx.stroke();

      ctx.fillStyle = e.color;
      ctx.font = `bold 11px monospace`;
      ctx.textAlign = 'center';
      ctx.fillText(e.label, x, y - 1);
      ctx.font = `9px monospace`;
      ctx.fillStyle = 'rgba(255,255,255,0.4)';
      ctx.fillText(e.status, x, y + 10);
    });

    // Label
    ctx.fillStyle = '#5c6370';
    ctx.font = '10px monospace';
    ctx.textAlign = 'left';
    ctx.fillText('No memory between experiments — each trial re-discovers the same dead ends', 8, H - 10);
  }

  function drawTree() {
    // Tree structure
    const nodes = [
      { id: 'root', x: 0.5, y: 0.1, label: 'Research Goal', color: '#8b5cf6', status: 'root', r: 28 },
      { id: '1.1',  x: 0.22, y: 0.38, label: '1.1 Parametric', color: '#e06c75', status: 'pruned', r: 22 },
      { id: '1.4',  x: 0.5, y: 0.38, label: '1.4 Factory', color: '#10b981', status: 'merged', r: 22 },
      { id: '1.3',  x: 0.78, y: 0.38, label: '1.3 Hybrid', color: '#e06c75', status: 'pruned', r: 22 },
      { id: '2.4',  x: 0.38, y: 0.65, label: '2.4 Recalibrate', color: '#10b981', status: 'merged', r: 22 },
      { id: '2.1',  x: 0.65, y: 0.65, label: '2.1 AIME-prompt', color: '#f59e0b', status: 'timeout', r: 22 },
      { id: '3.4',  x: 0.38, y: 0.88, label: '3.4 Family-fixes', color: '#10b981', status: 'merged', r: 22 },
    ];
    const edges = [
      ['root','1.1'], ['root','1.4'], ['root','1.3'],
      ['1.4','2.4'], ['1.4','2.1'],
      ['2.4','3.4'],
    ];

    // Draw insight arrows (blue glow on merged path)
    const insightPath = [['3.4','2.4'],['2.4','1.4'],['1.4','root']];
    insightPath.forEach(([from, to]) => {
      const a = nodes.find(n => n.id === from);
      const b = nodes.find(n => n.id === to);
      ctx.beginPath();
      ctx.moveTo(a.x * W, a.y * H);
      ctx.lineTo(b.x * W, b.y * H);
      ctx.strokeStyle = 'rgba(6,182,212,0.45)';
      ctx.lineWidth = 3;
      ctx.setLineDash([]);
      ctx.stroke();
    });

    // Draw all edges
    ctx.lineWidth = 1.5;
    ctx.setLineDash([3, 3]);
    edges.forEach(([from, to]) => {
      const a = nodes.find(n => n.id === from);
      const b = nodes.find(n => n.id === to);
      if (insightPath.some(p => p[0] === to && p[1] === from) ||
          insightPath.some(p => p[0] === from && p[1] === to)) return;
      ctx.strokeStyle = 'rgba(107,114,128,0.4)';
      ctx.beginPath();
      ctx.moveTo(a.x * W, a.y * H);
      ctx.lineTo(b.x * W, b.y * H);
      ctx.stroke();
    });
    ctx.setLineDash([]);

    // Draw nodes
    nodes.forEach(n => {
      const x = n.x * W, y = n.y * H;
      ctx.beginPath();
      ctx.arc(x, y, n.r, 0, Math.PI * 2);
      ctx.fillStyle = n.color + '22';
      ctx.fill();
      ctx.strokeStyle = n.color;
      ctx.lineWidth = 2;
      ctx.stroke();
      ctx.fillStyle = n.color;
      ctx.font = `bold 9px monospace`;
      ctx.textAlign = 'center';
      const parts = n.label.split(' ');
      if (parts.length > 2) {
        ctx.fillText(parts.slice(0,2).join(' '), x, y - 3);
        ctx.fillText(parts.slice(2).join(' '), x, y + 8);
      } else {
        ctx.fillText(n.label, x, y + 3);
      }
    });

    // Cyan "insight" label
    ctx.fillStyle = '#06b6d4';
    ctx.font = '10px monospace';
    ctx.textAlign = 'center';
    ctx.fillText('← insights flow upward, reshape future hypotheses', W * 0.5, H - 10);
  }

  window.setMode = function(m) {
    mode = m;
    document.getElementById('btn-linear').classList.toggle('active', m === 'linear');
    document.getElementById('btn-tree').classList.toggle('active', m === 'tree');
    draw();
  };

  // Button styles
  const style = document.createElement('style');
  style.textContent = `.traj-btn{padding:.3rem .85rem;border-radius:5px;font-size:.72rem;font-family:var(--ff-mono);cursor:pointer;border:1px solid var(--border-hi);background:var(--surface);color:var(--muted2);transition:all .15s}.traj-btn.active{border-color:var(--purple);color:var(--purple-l);background:var(--purple-dim)}`;
  document.head.appendChild(style);

  resize();
  window.addEventListener('resize', resize);
})();

// ─── §02: Interactive hypothesis tree SVG ────────────────────

<span class="cs-line cmt"># root: "design AIME-style math problems"</span>
<span class="cs-line hl-p"><span class="cmt">#  1.1 code+prompt (dev: 10%) → failed</span></span>
<span class="cs-line hl-p"><span class="cmt">#  1.4 parametric  (dev: 14%) → merged</span></span>
<span class="cs-line hl-c"><span class="cmt">#   2.1 AIME-prompt (dev: 6%) → timeout</span></span>
<span class="cs-line hl-c"><span class="cmt">#   2.4 recalibrate (dev: 18%)→ merged</span></span>
<span class="cs-line hl-g"><span class="cmt">#    3.3 restructure → failed</span></span>
<span class="cs-line hl-g"><span class="cmt">#    3.4 family-fixes(dev:24%)→ merged</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Final merged path: 1.1 → 1.4 → 2.4 → 3.4</span>
<span class="cs-line cmt"># Test result: 20.83 (from initial 1.04)</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-htr">
      <pre class="cs-pre">
<span class="cs-line cmt"># Algorithm 1: Hypothesis Tree Refinement</span>
<span class="cs-line cmt"># Coordinator owns Tree; Executor owns one worktree</span>
<span class="cs-line"> </span>
<span class="cs-line"><span class="fn">init</span> Tree = (&#123;n0&#125;, empty)</span>
<span class="cs-line">bn0 = M0; Mbest = M0</span>
<span class="cs-line"> </span>
<span class="cs-line"><span class="kw">while</span> budget_left <span class="kw">and</span> pending_leaves:</span>
<span class="cs-line"> </span>
<span class="cs-line hl-c">    <span class="cmt"># 1. Observe</span></span>
<span class="cs-line hl-c">    V = <span class="fn">Observe</span>(Tree, Mbest)</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p">    <span class="cmt"># 2. Ideate</span></span>
<span class="cs-line hl-p">    p = <span class="fn">choose_parent</span>(V)</span>
<span class="cs-line hl-p">    children = <span class="fn">Ideate</span>(p, V)</span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="cmt"># 3. Select + 4. Dispatch</span></span>
<span class="cs-line">    L = <span class="fn">Select</span>(V)  <span class="cmt"># pending leaves</span></span>
<span class="cs-line">    results = <span class="fn">parallel_Executor</span>(L, Mbest)</span>
<span class="cs-line"> </span>
<span class="cs-line hl-g">    <span class="cmt"># 5. Backpropagate</span></span>
<span class="cs-line hl-g">    <span class="kw">for</span> n <span class="kw">in</span> L:</span>
<span class="cs-line hl-g">        <span class="fn">write_back</span>(n, results[n])</span>
<span class="cs-line hl-g">        <span class="kw">for</span> a <span class="kw">in</span> <span class="fn">path_to_root</span>(n):</span>
<span class="cs-line hl-g">            a.i = <span class="fn">Abstract</span>(a.children)</span>
<span class="cs-line"> </span>
<span class="cs-line hl-a">    <span class="cmt"># 6. Decide (held-out merge gate)</span></span>
<span class="cs-line hl-a">    n_best = <span class="fn">argmax</span>(n.dev_score <span class="kw">for</span> n <span class="kw">in</span> L)</span>
<span class="cs-line hl-a">    <span class="kw">if</span> <span class="fn">O</span>(Etest(n_best.branch)) &gt; <span class="fn">O</span>(Etest(Mbest)):</span>
<span class="cs-line hl-a">        Mbest = <span class="fn">merge</span>(n_best.branch)</span>
<span class="cs-line hl-a">    <span class="fn">prune</span>(falsified_subtrees)</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-propagation">
      <pre class="cs-pre">
<span class="cs-line cmt"># Insight backpropagation: the key mechanism</span>
<span class="cs-line"> </span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">backpropagate</span>(leaf_node, result):</span>
<span class="cs-line hl-p">    <span class="cmt"># Step 1: distill leaf-level insight</span></span>
<span class="cs-line hl-p">    leaf_node.i = <span class="fn">Distill</span>(</span>
<span class="cs-line hl-p">        leaf_node.h,   <span class="cmt"># what was tried</span></span>
<span class="cs-line hl-p">        leaf_node.delta, <span class="cmt"># what changed</span></span>
<span class="cs-line hl-p">        result         <span class="cmt"># what happened</span></span>
<span class="cs-line hl-p">    )</span>
<span class="cs-line"> </span>
<span class="cs-line hl-c">    <span class="cmt"># Step 2: propagate upward</span></span>
<span class="cs-line hl-c">    <span class="kw">for</span> ancestor <span class="kw">in</span> <span class="fn">path_to_root</span>(leaf_node):</span>
<span class="cs-line hl-c">        ancestor.i = <span class="fn">Abstract</span>(</span>
<span class="cs-line hl-c">            [child.i <span class="kw">for</span> child <span class="kw">in</span> ancestor.children]</span>
<span class="cs-line hl-c">        )</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Example from optimizer design task:</span>
<span class="cs-line cmt">#</span>
<span class="cs-line"><span class="cmt"># leaf:    "axis statistics alone not enough"</span></span>
<span class="cs-line hl-g"><span class="cmt"># parent:  "NS geometry is load-bearing"</span></span>
<span class="cs-line hl-g"><span class="cmt"># root:    "preserve full-matrix structure"</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># This root insight now constrains ALL</span>
<span class="cs-line cmt"># future hypotheses in the tree, not just</span>
<span class="cs-line cmt"># siblings of the failed leaf.</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Ablation result on MLE-Bench Lite:</span>
<span class="cs-line hl-a"><span class="cmt"># w/o insight:  54.54% any-medal</span></span>
<span class="cs-line hl-a"><span class="cmt"># w/o tree:     63.64% any-medal</span></span>
<span class="cs-line hl-g"><span class="cmt"># full Arbor:   81.82% any-medal</span></span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-guard">
      <pre class="cs-pre">
<span class="cs-line cmt"># Held-out merge gate — Decide step</span>
<span class="cs-line"> </span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">decide</span>(candidates, Mbest, O):</span>
<span class="cs-line">    <span class="cmt"># Best dev-score candidate</span></span>
<span class="cs-line hl-p">    n_top = <span class="fn">argmax</span>(n.dev_score <span class="kw">for</span> n <span class="kw">in</span> candidates)</span>
<span class="cs-line"> </span>
<span class="cs-line hl-c">    <span class="cmt"># Evaluate on held-out test</span></span>
<span class="cs-line hl-c">    test_new  = <span class="fn">O</span>(Etest(<span class="fn">fresh_worktree</span>(n_top)))</span>
<span class="cs-line hl-c">    test_best = <span class="fn">O</span>(Etest(Mbest))</span>
<span class="cs-line"> </span>
<span class="cs-line hl-g">    <span class="kw">if</span> test_new &gt; test_best:</span>
<span class="cs-line hl-g">        Mbest = <span class="fn">merge</span>(n_top)  <span class="cmt"># verified</span></span>
<span class="cs-line hl-g">        n_top.status = <span class="str">"merged"</span></span>
<span class="cs-line hl-a">    <span class="kw">else</span>:</span>
<span class="cs-line hl-a">        n_top.status = <span class="str">"validated_not_merged"</span></span>
<span class="cs-line hl-a">        n_top.i += <span class="str">" [dev-exploiting]"</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Terminal-Bench result (pass rate):</span>
<span class="cs-line cmt">#         dev    test   gap</span>
<span class="cs-line hl-a"><span class="cmt"># Claude  75.00  71.70  -3.30  ← overfit</span></span>
<span class="cs-line hl-g"><span class="cmt"># Arbor   72.22  77.36  +5.14  ← generalize</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Codex didn't overfit but barely gained</span>
<span class="cs-line cmt">#         63.89  73.59  +9.70 (lower test)</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-results">
      <pre class="cs-pre">
<span class="cs-line cmt"># Main results: Arbor vs baselines</span>
<span class="cs-line cmt"># Held-out test scores (best in bold)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Optimizer Design (steps ↓)</span>
<span class="cs-line hl-p"><span class="cmt"># Init:         3325 steps</span></span>
<span class="cs-line hl-p"><span class="cmt"># Codex:        3325  (+0.00%)</span></span>
<span class="cs-line hl-p"><span class="cmt"># Claude Code:  3287  (+1.13%)</span></span>

    { id: 'n33',  x: 420, y: 300, label: '3.3 restructure', short: '3.3\nrestructure', color: '#e06c75', status: 'fail',
      h: 'Restructure problem templates to reduce repetitive patterns.',
      insight: 'Restructuring alone hurts diversity. Structural changes need to preserve family-level variation.',

    { id: 'n24',  x: 510, y: 210, label: '2.4 recalibrate', short: '2.4\nrecalibrate', color: '#10b981', status: 'merged',
      h: 'Add difficulty recalibration after initial generation to ensure target distribution.',
      insight: 'Two-stage calibration significantly improves difficulty alignment. Recalibration is a reusable pattern.',

    { id: 'n34',  x: 600, y: 300, label: '3.4 family-fixes', short: '3.4\nfamily-fixes', color: '#10b981', status: 'merged',
      h: 'Fix family-level edge cases: boundary conditions, solution uniqueness checks, difficulty band coverage.',
      insight: 'Family-level fixes address root causes of difficulty drift. Final merged improvement: 24% dev.',
      meta: 'dev: 24% | status: merged | branch: n34 (trunk)' },
  ];

  const edges = [
    ['root','n11'],['root','n14'],['root','n13'],
    ['n14','n21'],['n14','n24'],
    ['n24','n33'],['n24','n34'],
  ];
  const mergedPath = ['root','n14','n24','n34'];

  // Draw edges
  edges.forEach(([from, to]) => {
    const a = nodes.find(n => n.id === from);
    const b = nodes.find(n => n.id === to);
    const isMerge = mergedPath.includes(from) && mergedPath.includes(to);
    const line = document.createElementNS('http://www.w3.org/2000/svg','line');
    line.setAttribute('x1', a.x); line.setAttribute('y1', a.y + 14);
    line.setAttribute('x2', b.x); line.setAttribute('y2', b.y - 14);
    line.setAttribute('stroke', isMerge ? 'rgba(139,92,246,0.55)' : 'rgba(107,114,128,0.3)');
    line.setAttribute('stroke-width', isMerge ? '2.5' : '1.5');
    line.setAttribute('stroke-dasharray', isMerge ? 'none' : '4 4');
    svg.appendChild(line);
  });

  // Draw nodes
  nodes.forEach(n => {
    const g = document.createElementNS('http://www.w3.org/2000/svg','g');
    g.style.cursor = 'pointer';

    const circle = document.createElementNS('http://www.w3.org/2000/svg','circle');
    circle.setAttribute('cx', n.x); circle.setAttribute('cy', n.y);
    circle.setAttribute('r', n.id === 'root' ? 22 : 16);
    circle.setAttribute('fill', n.color + '22');
    circle.setAttribute('stroke', n.color);
    circle.setAttribute('stroke-width', '2');
    g.appendChild(circle);

    const lines = n.short.split('\n');
    lines.forEach((line, i) => {
      const t = document.createElementNS('http://www.w3.org/2000/svg','text');
      t.setAttribute('x', n.x);
      t.setAttribute('y', n.y + (lines.length === 1 ? 4 : (i === 0 ? -3 : 9)));
      t.setAttribute('text-anchor', 'middle');
      t.setAttribute('font-size', n.id === 'root' ? '9' : '8');
      t.setAttribute('font-family', 'monospace');
      t.setAttribute('font-weight', 'bold');
      t.setAttribute('fill', n.color);
      t.textContent = line;
      g.appendChild(t);
    });

    g.addEventListener('click', () => {
      const detail = document.getElementById('tree-detail');
      document.getElementById('tree-detail-title').textContent = n.label;
      document.getElementById('tree-detail-body').innerHTML =
        `<strong style="color:var(--purple)">h:</strong> ${n.h}<br>` +
        `<strong style="color:var(--cyan)">ι:</strong> ${n.insight}<br>` +
        `<strong style="color:var(--amber)">μ:</strong> ${n.meta}`;
      detail.style.display = 'block';
    });

    svg.appendChild(g);
  });

  // Legend
  const legend = [
    { color: '#10b981', label: 'merged' },
    { color: '#e06c75', label: 'pruned/fail' },
    { color: '#f59e0b', label: 'timeout' },
  ];
  legend.forEach((l, i) => {
    const x = 10 + i * 110;
    const circle = document.createElementNS('http://www.w3.org/2000/svg','circle');
    circle.setAttribute('cx', x + 5); circle.setAttribute('cy', 330);
    circle.setAttribute('r', 5);
    circle.setAttribute('fill', l.color);
    svg.appendChild(circle);
    const t = document.createElementNS('http://www.w3.org/2000/svg','text');
    t.setAttribute('x', x + 14); t.setAttribute('y', 334);
    t.setAttribute('font-size', '9'); t.setAttribute('fill', '#6b7280');
    t.setAttribute('font-family', 'monospace');
    t.textContent = l.label;
    svg.appendChild(t);
  });
})();

// ─── §03: Step navigator ─────────────────────────────────────
(function() {
  let step = 0;
  const boxes   = document.querySelectorAll('#htr-steps .step-box');
  const prevBtn = document.getElementById('step-prev');
  const nextBtn = document.getElementById('step-next');
  const progEl  = document.getElementById('step-prog');

  function updateSteps() {
    boxes.forEach((b, i) => {
      b.classList.remove('active','done');
      if (i === step) b.classList.add('active');
      else if (i < step) b.classList.add('done');
    });
    if (prevBtn) prevBtn.disabled = step === 0;
    if (nextBtn) nextBtn.disabled = step === boxes.length - 1;
    if (progEl)  progEl.textContent = `Step ${step+1} of ${boxes.length}`;
    boxes.forEach((b, i) => {
      const n = b.querySelector('.step-num');
      if (n) n.textContent = i < step ? '✓' : String(i+1);
    });
  }

  prevBtn?.addEventListener('click', () => { if (step > 0) { step--; updateSteps(); } });
  nextBtn?.addEventListener('click', () => { if (step < boxes.length - 1) { step++; updateSteps(); } });
  updateSteps();
})();

// ─── §04: Insight propagation canvas ────────────────────────
(function() {
  const canvas = document.getElementById('prop-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  let W, H, DPR;
  let animating = false;
  let animFrame = 0;
  let animSuccess = false;

  // Tree layout
  const nodes = [
    { id: 'root', x: 0.5,  y: 0.08, label: 'Root: preserve full-matrix\ngradient structure', color: '#8b5cf6', r: 26, insight: '' },
    { id: 'mid1', x: 0.25, y: 0.4,  label: 'Direction: axis statistics\nvs NS geometry', color: '#8b5cf6', r: 20, insight: '' },
    { id: 'mid2', x: 0.75, y: 0.4,  label: 'Direction: optimizer step\nscale control', color: '#8b5cf6', r: 20, insight: '' },
    { id: 'leaf1',x: 0.12, y: 0.72, label: 'Leaf A: axis-factorized\nsign update', color: '#8b5cf6', r: 18, insight: '' },
    { id: 'leaf2',x: 0.38, y: 0.72, label: 'Leaf B: row/col balance\nwith NS preserved', color: '#8b5cf6', r: 18, insight: '' },
    { id: 'leaf3',x: 0.62, y: 0.72, label: 'Leaf C: per-layer\nscale adaptation', color: '#8b5cf6', r: 18, insight: '' },
    { id: 'leaf4',x: 0.88, y: 0.72, label: 'Active Leaf D:\npre-NS conditioning', color: '#8b5cf6', r: 18, insight: '' },
  ];
  const edges = [
    ['root','mid1'],['root','mid2'],
    ['mid1','leaf1'],['mid1','leaf2'],
    ['mid2','leaf3'],['mid2','leaf4'],
  ];

  function resize() {
    DPR = window.devicePixelRatio || 1;
    W = canvas.clientWidth;
    H = 340;
    canvas.width  = W * DPR;
    canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
    drawBase(0, false, false);
  }

  function lerp(a, b, t) { return a + (b - a) * t; }
  function easeInOut(t) { return t < 0.5 ? 2*t*t : -1+(4-2*t)*t; }

  function drawBase(propT, success, running) {
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = 'rgba(26,26,46,0.6)';
    ctx.fillRect(0, 0, W, H);

    const activePath = success
      ? ['leaf4','mid2','root']
      : ['leaf4'];

    // Draw edges
    edges.forEach(([from, to]) => {
      const a = nodes.find(n => n.id === from);
      const b = nodes.find(n => n.id === to);
      const isInsightEdge = activePath.includes(from) && activePath.includes(to) && propT > 0 && success;
      ctx.strokeStyle = isInsightEdge
        ? `rgba(6,182,212,${0.3 + 0.5 * easeInOut(propT)})`
        : 'rgba(107,114,128,0.3)';
      ctx.lineWidth = isInsightEdge ? 3 : 1.5;
      ctx.setLineDash(isInsightEdge ? [] : [3, 3]);
      ctx.beginPath();
      ctx.moveTo(a.x * W, a.y * H);
      ctx.lineTo(b.x * W, b.y * H);
      ctx.stroke();
    });
    ctx.setLineDash([]);

    // Draw moving insight particle
    if (propT > 0 && success) {
      // Animate along leaf4 → mid2 → root
      const path = [
        { x: 0.88, y: 0.72 },
        { x: 0.75, y: 0.4 },
        { x: 0.5,  y: 0.08 },
      ];
      const t2 = easeInOut(propT);
      let px, py;
      if (t2 < 0.45) {
        const seg = t2 / 0.45;
        px = lerp(path[0].x, path[1].x, seg);
        py = lerp(path[0].y, path[1].y, seg);
      } else {
        const seg = (t2 - 0.45) / 0.55;
        px = lerp(path[1].x, path[2].x, seg);
        py = lerp(path[1].y, path[2].y, seg);
      }
      // Glowing particle
      const grd = ctx.createRadialGradient(px*W, py*H, 0, px*W, py*H, 18);
      grd.addColorStop(0, 'rgba(6,182,212,0.9)');
      grd.addColorStop(1, 'rgba(6,182,212,0)');
      ctx.beginPath();
      ctx.arc(px*W, py*H, 18, 0, Math.PI*2);
      ctx.fillStyle = grd;
      ctx.fill();
      ctx.beginPath();
      ctx.arc(px*W, py*H, 5, 0, Math.PI*2);
      ctx.fillStyle = '#06b6d4';
      ctx.fill();
    }

    // Draw nodes
    nodes.forEach(n => {
      const x = n.x * W, y = n.y * H;
      let color = n.color;
      let fillAlpha = '22';
      if (n.id === 'leaf4' && propT > 0) {
        color = success ? '#10b981' : '#e06c75';
        fillAlpha = '33';
      }
      if (success && propT > 0.45 && (n.id === 'mid2' || n.id === 'root')) {
        const t = n.id === 'mid2' ? Math.min((propT - 0.45) / 0.1, 1) : Math.min((propT - 0.8) / 0.2, 1);
        if (t > 0) { color = '#06b6d4'; fillAlpha = Math.round(17 + t * 30).toString(16).padStart(2,'0'); }
      }
      if (running && n.id === 'leaf4') {
        const pulse = 0.5 + 0.5 * Math.sin(animFrame * 0.15);
        ctx.beginPath();
        ctx.arc(x, y, n.r + 8, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(245,158,11,${0.1 + 0.15 * pulse})`;
        ctx.fill();
        color = '#f59e0b';
      }

      ctx.beginPath();
      ctx.arc(x, y, n.r, 0, Math.PI * 2);
      ctx.fillStyle = color + fillAlpha;
      ctx.fill();
      ctx.strokeStyle = color;
      ctx.lineWidth = 2;
      ctx.stroke();

      const lines = n.label.split('\n');
      ctx.textAlign = 'center';
      ctx.fillStyle = color;
      lines.forEach((line, i) => {
        ctx.font = `bold ${n.id === 'root' ? 9 : 8}px monospace`;
        ctx.fillText(line, x, y + (lines.length === 1 ? 3 : (i === 0 ? -3 : 8)));
      });
    });

    // Status text
    if (propT > 0 && success) {
      ctx.fillStyle = '#06b6d4';
      ctx.font = '11px monospace';
      ctx.textAlign = 'center';
      const msg = propT < 0.5
        ? 'Insight: "Muon loses useful geometry before Newton-Schulz"'
        : propT < 0.9
        ? '→ propagating: "NS geometry is load-bearing"'
        : '→ root updated: "preserve full-matrix gradient structure"';
      ctx.fillText(msg, W * 0.5, H - 12);
    } else if (propT > 0 && !success) {
      ctx.fillStyle = '#e06c75';
      ctx.font = '11px monospace';
      ctx.textAlign = 'center';
      ctx.fillText('Insight: "axis statistics alone not enough" → tagged as constraint', W * 0.5, H - 12);
    } else if (running) {
      ctx.fillStyle = '#f59e0b';
      ctx.font = '11px monospace';
      ctx.textAlign = 'center';
      ctx.fillText('Executor running: testing "pre-NS conditioning" hypothesis...', W * 0.5, H - 12);
    }
  }

  window.runPropagation = function(ok) {
    if (animating) return;
    animating = true;
    animSuccess = ok;
    animFrame = 0;
    const statusEl = document.getElementById('prop-status');
    let startTime = null;
    const runDur = 800; // ms running phase
    const propDur = 2000; // ms propagation phase

    function tick(ts) {
      if (!startTime) startTime = ts;
      const elapsed = ts - startTime;
      animFrame++;

      if (elapsed < runDur) {
        drawBase(0, false, true);
        requestAnimationFrame(tick);
      } else {
        const propElapsed = elapsed - runDur;
        const t = Math.min(propElapsed / propDur, 1);
        drawBase(t, ok, false);
        if (t < 1) requestAnimationFrame(tick);
        else {
          animating = false;
          statusEl.textContent = ok
            ? '✓ Insight propagated to root — shapes all future hypotheses'
            : '✗ Failure insight recorded — constrains related subtrees';
        }
      }
    }
    statusEl.textContent = 'Running executor in isolated worktree...';
    requestAnimationFrame(tick);
  };

  window.resetPropagation = function() {
    if (animating) return;
    document.getElementById('prop-status').textContent = '';
    drawBase(0, false, false);
  };

  resize();
  window.addEventListener('resize', resize);
})();

// ─── §05: Dev/test bar charts ────────────────────────────────
(function() {
  // Terminal-Bench 2.0 scores: init=69.81, codex dev=63.89 test=73.59, cc dev=75 test=71.7, arbor dev=72.22 test=77.36
  const initLine = 69.81;
  const data = {
    codex: { dev: 63.89, test: 73.59 },
    cc:    { dev: 75.00, test: 71.70 },
    arbor: { dev: 72.22, test: 77.36 },
  };
  const maxVal = 82;

  function buildBars(containerId, devVal, testVal) {
    const container = document.getElementById(containerId);
    if (!container) return;
    const devH = Math.round((devVal / maxVal) * 76);
    const testH = Math.round((testVal / maxVal) * 76);
    const isArbor = containerId === 'dt-arbor';
    const overfit = testVal < devVal;

    container.style.cssText = 'display:flex;gap:.75rem;justify-content:center;align-items:flex-end;height:80px';

    [
      { val: devVal, h: devH, color: isArbor ? '#8b5cf6' : 'rgba(107,114,128,0.55)', label: 'dev' },
      { val: testVal, h: testH, color: isArbor ? '#10b981' : (overfit ? '#e06c75' : 'rgba(107,114,128,0.55)'), label: 'test' },
    ].forEach(b => {
      const wrap = document.createElement('div');
      wrap.style.cssText = `display:flex;flex-direction:column;align-items:center;gap:3px`;
      const bar = document.createElement('div');
      bar.style.cssText = `width:32px;height:${b.h}px;background:${b.color};border-radius:4px 4px 0 0;display:flex;align-items:flex-start;justify-content:center;padding-top:3px`;
      const val = document.createElement('span');
      val.style.cssText = 'font-size:.6rem;font-family:monospace;font-weight:700;color:rgba(255,255,255,.85)';
      val.textContent = b.val.toFixed(1);
      bar.appendChild(val);
      wrap.appendChild(bar);
      container.appendChild(wrap);
    });
  }

  buildBars('dt-codex', data.codex.dev, data.codex.test);
  buildBars('dt-cc',    data.cc.dev,    data.cc.test);
  buildBars('dt-arbor', data.arbor.dev, data.arbor.test);
})();

// ─── §06: Animated bars (IntersectionObserver) ───────────────
const resultsSection = document.getElementById('s-results');
if (resultsSection) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('#s-results .bar-fill[data-w]').forEach(b => {
          b.style.width = b.dataset.w + '%';
        });
      }
    });
  }, { threshold: 0.2 }).observe(resultsSection);
}
</script>
</BaseLayout>

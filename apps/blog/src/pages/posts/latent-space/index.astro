  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ── IntersectionObserver — sync TOC + sidebar tab on scroll ─
const sectionMap = {
  's-intro':       'intro',
  's-foundation':  'foundation',
  's-taxonomy':    'taxonomy',
  's-computation': 'computation',
  's-abilities':   'abilities',
  's-benchmarks':  'benchmarks'
};

document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ── Interactive: Explicit vs. Latent Flow Toggle ────────────
const btnFlowExplicit = document.getElementById('btn-flow-explicit');
const btnFlowLatent = document.getElementById('btn-flow-latent');
const flowDiagram = document.getElementById('flow-diagram');

btnFlowExplicit?.addEventListener('click', () => {
  btnFlowExplicit.classList.add('active');
  btnFlowLatent.classList.remove('active');
  flowDiagram.innerHTML = `
    <div class="flow-step-box" style="border-color: var(--amber)">Input: "Next in sequence: 2, 4, 8, 16..."</div>
    <div class="flow-arrow">↓ [Slow Sequential Output]</div>
    <div class="flow-step-box" style="color: var(--muted); font-size: 0.7rem;">"The pattern is doubling... So the next token should be..." (15 tokens generated)</div>
    <div class="flow-arrow">↓ [Vocab Projection]</div>
    <div class="flow-step-box" style="border-color: var(--green)">Output: "32"</div>
  `;
});

btnFlowLatent?.addEventListener('click', () => {
  btnFlowLatent.classList.add('active');
  btnFlowExplicit.classList.remove('active');
  flowDiagram.innerHTML = `
    <div class="flow-step-box" style="border-color: var(--amber)">Input: "Next in sequence: 2, 4, 8, 16..."</div>
    <div class="flow-arrow">↓ [Parallel Latent Refinement Trajectory]</div>
    <div class="flow-step-box" style="border-color: var(--purple); font-weight: bold; color: var(--purple-l);">[ z_0 -> z_1 -> z_2 -> z_3 ] (Continuous Vectors)</div>
    <div class="flow-arrow">↓ [Direct Vocab Projection]</div>
    <div class="flow-step-box" style="border-color: var(--green)">Output: "32"</div>
  `;
});

// ── Interactive: Canvas Trajectory Simulator ────────────────
const canvas = document.getElementById('trajectory-canvas');
if (canvas) {
  const ctx = canvas.getContext('2d');
  const W = canvas.clientWidth, H = 260, DPR = window.devicePixelRatio || 1;
  canvas.width = W * DPR; canvas.height = H * DPR; ctx.scale(DPR, DPR);

  const slider = document.getElementById('slider-loops');
  const lblLoops = document.getElementById('lbl-loops');
  const statusText = document.getElementById('sim-status-text');
  const btnPlay = document.getElementById('btn-play') || document.getElementById('btn-sim-play');

  let currentLoops = parseInt(slider.value, 10);
  let animationFrameId = null;
  let progress = 0;
  let isAnimating = false;

  // Simulator anchors
  const startX = 60, startY = 130;
  const targetX = 480, targetY = 70; // Resolved basin (Green)
  const stuckX = 280, stuckY = 180;  // Stuck loop basin (Red)

  function getPointOnTrajectory(tVal, loops) {
    if (loops < 5) {
      const segment = tVal;
      const cpX = 150, cpY = 80;
      const x = (1-segment)*(1-segment)*startX + 2*(1-segment)*segment*cpX + segment*segment*stuckX;
      const y = (1-segment)*(1-segment)*startY + 2*(1-segment)*segment*cpY + segment*segment*stuckY;
      
      if (segment > 0.9) {
        const osc = (segment - 0.9) * 10;
        const angle = osc * Math.PI * 4;
        const radius = 8 * (loops / 4);
        return {
          x: x + Math.cos(angle) * radius,
          y: y + Math.sin(angle) * radius
        };
      }
      return { x, y };
    } else {
      const cp1X = 150, cp1Y = 80;
      const cp2X = 260, cp2Y = 220;
      const cp3X = 350, cp3Y = 160;
      
      if (tVal < 0.5) {
        const u = tVal * 2;
        const x = (1-u)*(1-u)*startX + 2*(1-u)*u*cp1X + u*u*stuckX;
        const y = (1-u)*(1-u)*startY + 2*(1-u)*u*cp1Y + u*u*stuckY;
        return { x, y };
      } else {
        const u = (tVal - 0.5) * 2;
        const x = (1-u)*(1-u)*stuckX + 2*(1-u)*u*cp3X + u*u*targetX;
        const y = (1-u)*(1-u)*stuckY + 2*(1-u)*u*cp3Y + u*u*targetY;
        return { x, y };
      }
    }
  }

  function drawLandscape() {
    ctx.clearRect(0, 0, W, H);

    ctx.strokeStyle = 'rgba(255, 255, 255, 0.05)';
    ctx.lineWidth = 1;
    for (let x = 0; x < W; x += 40) {
      ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, H); ctx.stroke();
    }
    for (let y = 0; y < H; y += 40) {
      ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(W, y); ctx.stroke();
    }

    const redGrad = ctx.createRadialGradient(stuckX, stuckY, 5, stuckX, stuckY, 45);
    redGrad.addColorStop(0, 'rgba(239, 68, 68, 0.25)');
    redGrad.addColorStop(1, 'rgba(239, 68, 68, 0)');
    ctx.fillStyle = redGrad;
    ctx.beginPath(); ctx.arc(stuckX, stuckY, 45, 0, Math.PI*2); ctx.fill();

    ctx.fillStyle = '#ef4444';
    ctx.beginPath(); ctx.arc(stuckX, stuckY, 4, 0, Math.PI*2); ctx.fill();
    ctx.fillStyle = '#f87171';
    ctx.font = '10px monospace';
    ctx.fillText('Stuck Basin (Ambiguous)', stuckX - 60, stuckY + 20);

    const greenGrad = ctx.createRadialGradient(targetX, targetY, 5, targetX, targetY, 45);
    greenGrad.addColorStop(0, 'rgba(16, 185, 129, 0.25)');
    greenGrad.addColorStop(1, 'rgba(16, 185, 129, 0)');
    ctx.fillStyle = greenGrad;
    ctx.beginPath(); ctx.arc(targetX, targetY, 45, 0, Math.PI*2); ctx.fill();

    ctx.fillStyle = '#10b981';
    ctx.beginPath(); ctx.arc(targetX, targetY, 5, 0, Math.PI*2); ctx.fill();
    ctx.fillStyle = '#34d399';
    ctx.fillText("Resolved: '32'", targetX - 40, targetY - 12);

    ctx.fillStyle = 'rgba(6, 182, 212, 0.3)';
    ctx.beginPath(); ctx.arc(startX, startY, 8, 0, Math.PI*2); ctx.fill();
    ctx.fillStyle = '#06b6d4';
    ctx.beginPath(); ctx.arc(startX, startY, 4, 0, Math.PI*2); ctx.fill();
    ctx.fillStyle = '#67e8f9';
    ctx.fillText('Input x', startX - 20, startY + 20);
  }

  function drawTrajectory(loops, animateVal) {
    drawLandscape();

    ctx.strokeStyle = 'rgba(255, 255, 255, 0.1)';
    ctx.lineWidth = 2;
    ctx.setLineDash([4, 4]);
    ctx.beginPath();
    ctx.moveTo(startX, startY);
    for (let t = 0; t <= 1.01; t += 0.02) {
      const p = getPointOnTrajectory(t, loops);
      ctx.lineTo(p.x, p.y);
    }
    ctx.stroke();
    ctx.setLineDash([]);

    if (animateVal > 0) {
      ctx.strokeStyle = loops < 5 ? '#ef4444' : '#a78bfa';
      ctx.lineWidth = 3;
      ctx.shadowBlur = 8;
      ctx.shadowColor = loops < 5 ? '#ef4444' : '#8b5cf6';
      ctx.beginPath();
      ctx.moveTo(startX, startY);
      for (let t = 0; t <= animateVal; t += 0.01) {
        const p = getPointOnTrajectory(t, loops);
        ctx.lineTo(p.x, p.y);
      }
      ctx.stroke();
      ctx.shadowBlur = 0;

      const head = getPointOnTrajectory(animateVal, loops);
      ctx.fillStyle = '#fff';
      ctx.strokeStyle = loops < 5 ? '#ef4444' : '#10b981';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.arc(head.x, head.y, 6, 0, Math.PI*2);
      ctx.fill();
      ctx.stroke();
    }
  }

  function runAnimation() {
    isAnimating = true;
    if (animationFrameId) cancelAnimationFrame(animationFrameId);
    
    progress = 0;
    const speed = 0.015;
    
    function tick() {
      progress += speed;
      if (progress > 1) {
        progress = 1;
        drawTrajectory(currentLoops, 1);
        isAnimating = false;
        return;
      }
      drawTrajectory(currentLoops, progress);
      animationFrameId = requestAnimationFrame(tick);
    }
    tick();
  }

  function updateSimulator(val) {
    currentLoops = val;
    lblLoops.textContent = `N = ${currentLoops}`;
    slider.value = currentLoops;

    if (currentLoops < 5) {
      statusText.innerHTML = `<span style="color: var(--amber)">N = ${currentLoops}:</span> State visits loops inside local activations but lacks depth parameters to escape. Halts in ambiguous region.`;
    } else {
      statusText.innerHTML = `<span style="color: var(--green-l)">N = ${currentLoops}:</span> Refined activations successfully bypass local attractor. Particle escapes towards correct semantic basin.`;
    }

    if (!isAnimating) {
      drawTrajectory(currentLoops, 1.0);
    }
  }

  slider?.addEventListener('input', (e) => {
    updateSimulator(parseInt(e.target.value, 10));
  });

  btnPlay?.addEventListener('click', () => {
    runAnimation();
  });

  updateSimulator(currentLoops);
}

// ── Interactive: Step Navigator (COCONUT Walkthrough) ──────
let currentStep = 0;
const stepBoxes = document.querySelectorAll('.step-box');
const stepPrev = document.getElementById('step-prev');
const stepNext = document.getElementById('step-next');
const stepProg = document.getElementById('step-prog');

function updateStepNavigator() {
  stepBoxes.forEach((b, i) => {
    b.classList.remove('active', 'done');
    if (i === currentStep) b.classList.add('active');
    else if (i < currentStep) b.classList.add('done');
  });

  if (stepPrev) stepPrev.disabled = currentStep === 0;
  if (stepNext) stepNext.disabled = currentStep === stepBoxes.length - 1;
  if (stepProg) stepProg.textContent = `Step ${currentStep + 1} of ${stepBoxes.length}`;

  stepBoxes.forEach((b, i) => {
    const num = b.querySelector('.step-num');
    if (num) num.textContent = i < currentStep ? '✓' : String(i + 1);
  });
}

stepPrev?.addEventListener('click', () => {
  if (currentStep > 0) {
    currentStep--;
    updateStepNavigator();
  }
});

stepNext?.addEventListener('click', () => {
  if (currentStep < stepBoxes.length - 1) {
    currentStep++;
    updateStepNavigator();
  }
});

// ── Interactive: Animated Bar Chart Observer ────────────────
const barsSection = document.getElementById('bars-section');
if (barsSection) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          const w = b.getAttribute('data-w');
          if (w) b.style.width = w + '%';
        });
      }
    });
  }, { threshold: 0.2 }).observe(barsSection);
}
</script>
</BaseLayout>

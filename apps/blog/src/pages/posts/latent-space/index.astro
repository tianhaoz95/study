    <!-- Panel 3: Taxonomy -->
    <div class="cs-panel" id="panel-taxonomy">
      <pre class="cs-pre"><span class="cs-line cmt"># Architectural Taxonomy of Latent Space</span>
<span class="cs-line cmt"># 1. Backbone-driven (Parameter-Shared Loop)</span>
<span class="cs-line kw">class</span> <span class="cls">LoopedBackbone</span>(nn.Module):
    <span class="cs-line kw">def</span> <span class="fn">__init__</span>(<span class="kw">self</span>, block, num_loops=<span class="num">6</span>):
        <span class="cs-line kw">super</span>().__init__()
        <span class="cs-line kw">self</span>.shared_block = block <span class="cs-line cmt"># Parameter reuse</span>
        <span class="cs-line kw">self</span>.num_loops = num_loops
        
    <span class="cs-line kw">def</span> <span class="fn">forward</span>(<span class="kw">self</span>, h):
        <span class="cs-line kw">for</span> _ <span class="cs-line kw">in</span> range(<span class="kw">self</span>.num_loops):
            h = <span class="kw">self</span>.shared_block(h)
        <span class="cs-line kw">return</span> h

<span class="cs-line cmt"># 2. Component-driven (Memory plug-in)</span>
<span class="cs-line kw">class</span> <span class="cls">LatentMemoryComponent</span>(nn.Module):
    <span class="cs-line kw">def</span> <span class="fn">__init__</span>(<span class="kw">self</span>, d_model, mem_size):
        <span class="cs-line kw">super</span>().__init__()
        <span class="cs-line kw">self</span>.mem_keys = nn.Parameter(torch.randn(mem_size, d_model))
        <span class="cs-line kw">self</span>.mem_vals = nn.Parameter(torch.randn(mem_size, d_model))
        
    <span class="cs-line kw">def</span> <span class="fn">forward</span>(<span class="kw">self</span>, h):
        <span class="cs-line cmt"># Retrieve memory values for latent conditioning</span>
        attn = torch.softmax(h @ <span class="kw">self</span>.mem_keys.T / (d_model**<span class="num">0.5</span>), dim=-<span class="num">1</span>)
        z_mem = attn @ <span class="kw">self</span>.mem_vals
        <span class="cs-line kw">return</span> h + z_mem</pre>
    </div>

    <!-- Panel 4: Computation -->
    <div class="cs-panel" id="panel-computation">
      <pre class="cs-pre"><span class="cs-line cmt"># Looped Refinement & Adaptive Halting</span>
<span class="cs-line kw">class</span> <span class="cls">AdaptiveLoopedRefiner</span>(nn.Module):
    <span class="cs-line kw">def</span> <span class="fn">__init__</span>(<span class="kw">self</span>, block, max_loops=<span class="num">10</span>, threshold=<span class="num">0.95</span>):
        <span class="cs-line kw">super</span>().__init__()
        <span class="cs-line kw">self</span>.block = block
        <span class="cs-line kw">self</span>.max_loops = max_loops
        <span class="cs-line kw">self</span>.halting_head = nn.Linear(d_model, <span class="num">1</span>)
        <span class="cs-line kw">self</span>.threshold = threshold
        
    <span class="cs-line kw">def</span> <span class="fn">forward</span>(<span class="kw">self</span>, h):
        accumulated_p = <span class="num">0.0</span>
        <span class="cs-line kw">for</span> step <span class="cs-line kw">in</span> range(<span class="kw">self</span>.max_loops):
            h = <span class="kw">self</span>.block(h)
            halt_logit = <span class="kw">self</span>.halting_head(h)
            halt_prob = torch.sigmoid(halt_logit)
            
            accumulated_p += halt_prob
            <span class="cs-line kw">if</span> accumulated_p &gt;= <span class="kw">self</span>.threshold:
                print(f"Halted early at step &#123;step + 1&#125;")
                <span class="cs-line kw">break</span>
        <span class="cs-line kw">return</span> h</pre>

<span class="cs-line kw">import</span> torch
<span class="cs-line kw">import</span> torch.nn <span class="cs-line kw">as</span> nn

<span class="cs-line kw">class</span> <span class="cls">LatentConditionedLM</span>(nn.Module):
    <span class="cs-line kw">def</span> <span class="fn">__init__</span>(<span class="kw">self</span>, vocab_size, d_model):
        <span class="cs-line kw">super</span>().__init__()
        <span class="cs-line kw">self</span>.embed = nn.Embedding(vocab_size, d_model)
        <span class="cs-line kw">self</span>.backbone = nn.TransformerDecoder(...)
        <span class="cs-line kw">self</span>.head = nn.Linear(d_model, vocab_size)
        
    <span class="cs-line kw">def</span> <span class="fn">forward</span>(<span class="kw">self</span>, x_tokens, z_latent):
        <span class="cs-line cmt"># z_latent: continuous representation vector in H</span>
        x_emb = <span class="kw">self</span>.embed(x_tokens)
        
        <span class="cs-line cmt"># Inject the latent vector z as a conditioning state</span>
        h = x_emb + z_latent.unsqueeze(<span class="num">1</span>)

const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});
const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ======= Code sidebar tabs =======
const tabMeta = {
  myth:    { file: 'replaid/comparison.py',    title: 'The 64× Myth' },
  plaid:   { file: 'replaid/plaid_vdm.py',     title: 'Plaid Background' },
  replaid: { file: 'replaid/architecture.py',  title: 'RePlaid Architecture' },
  embed:   { file: 'replaid/embeddings.py',    title: 'Embedding Geometry' },
  noise:   { file: 'replaid/noise_sched.py',   title: 'Noise Schedule' },
  scaling: { file: 'replaid/scaling.py',       title: 'Scaling Laws' },
  results: { file: 'replaid/results.py',       title: 'Results' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ======= IntersectionObserver — TOC + tab sync =======
const sectionMap = {
  's-myth':    'myth',
  's-plaid':   'plaid',
  's-replaid': 'replaid',
  's-embed':   'embed',
  's-noise':   'noise',
  's-scaling': 'scaling',
  's-results': 'results',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ======= Animated bar charts on scroll =======
function animateBars(barsId, sectionId) {
  const sec = document.getElementById(sectionId);
  if (!sec) return;
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll(`#${barsId} .bar-fill[data-w]`).forEach(b => {
          b.style.width = (parseFloat(b.dataset.w) / 100 * 100) + '%';
        });
      }
    });
  }, { threshold: 0.2 }).observe(sec);
}
animateBars('gap-bars',  's-myth');
animateBars('ppl-bars',  's-results');

// ======= Step navigator =======
let alignStep = 0;
const alignBoxes  = document.querySelectorAll('#align-steps .step-box');
const alignPrev   = document.getElementById('align-prev');
const alignNext   = document.getElementById('align-next');
const alignProg   = document.getElementById('align-prog');
function updateAlignSteps() {
  alignBoxes.forEach((b, i) => {
    b.classList.remove('active','done');
    if (i === alignStep) b.classList.add('active');
    else if (i < alignStep) b.classList.add('done');
  });
  if (alignPrev) alignPrev.disabled = alignStep === 0;
  if (alignNext) alignNext.disabled = alignStep === alignBoxes.length - 1;
  if (alignProg) alignProg.textContent = `Step ${alignStep+1} of ${alignBoxes.length}`;
  alignBoxes.forEach((b, i) => {
    const n = b.querySelector('.step-num');
    if (n) n.textContent = i < alignStep ? '✓' : String(i+1);
  });
}
alignPrev?.addEventListener('click', () => { if (alignStep>0){alignStep--;updateAlignSteps();} });
alignNext?.addEventListener('click', () => { if (alignStep<alignBoxes.length-1){alignStep++;updateAlignSteps();} });
updateAlignSteps();

// ======= Architecture SVG =======
const archDiv = document.getElementById('plaid-arch-svg');

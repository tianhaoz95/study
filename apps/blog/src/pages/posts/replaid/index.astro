    </defs>
    <!-- Token IDs box -->
    <rect x="10" y="65" width="80" height="40" rx="6" fill="rgba(30,32,40,1)" stroke="#374151" stroke-width="1.2"/>
    <text x="50" y="81" text-anchor="middle" fill="#9ca3af" font-size="9" font-family="monospace">Token IDs</text>
    <text x="50" y="94" text-anchor="middle" fill="#6b7280" font-size="8" font-family="monospace">[L]</text>
    <!-- Arrow: tokens → embed -->
    <line x1="90" y1="85" x2="120" y2="85" stroke="#6b7280" stroke-width="1.2" marker-end="url(#ah)"/>
    <!-- Embedding box -->
    <rect x="122" y="55" width="90" height="60" rx="6" fill="rgba(6,182,212,.12)" stroke="rgba(6,182,212,.4)" stroke-width="1.2"/>
    <text x="167" y="74" text-anchor="middle" fill="#06b6d4" font-size="9" font-family="monospace" font-weight="600">Embed E</text>
    <text x="167" y="87" text-anchor="middle" fill="#9ca3af" font-size="8" font-family="monospace">d_e = 16</text>
    <text x="167" y="101" text-anchor="middle" fill="#6b7280" font-size="7.5" font-family="monospace">≈50× cheaper</text>
    <!-- Arrow: embed → noise -->
    <line x1="212" y1="85" x2="244" y2="85" stroke="#6b7280" stroke-width="1.2" marker-end="url(#ah)"/>
    <text x="228" y="78" text-anchor="middle" fill="#6b7280" font-size="7.5" font-family="monospace">+noise</text>
    <!-- Noisy latent box -->
    <rect x="246" y="55" width="90" height="60" rx="6" fill="rgba(245,158,11,.08)" stroke="rgba(245,158,11,.35)" stroke-width="1.2"/>
    <text x="291" y="74" text-anchor="middle" fill="#f59e0b" font-size="9" font-family="monospace" font-weight="600">z_t  ∈ ℝ^de</text>
    <text x="291" y="87" text-anchor="middle" fill="#9ca3af" font-size="8" font-family="monospace">t ~ U[0,1]</text>

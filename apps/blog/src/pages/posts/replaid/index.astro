<span class="cs-line hl-c">    e = E[x]  <span class="cmt"># [L, d_e], unit-norm rows</span></span>
<span class="cs-line"> </span>
<span class="cs-line">    alpha_t = sigmoid(-gamma(t)) ** 0.5</span>
<span class="cs-line">    sigma_t = sigmoid( gamma(t)) ** 0.5</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p">    z_t = alpha_t * e + sigma_t * randn_like(e)</span>
<span class="cs-line hl-p"><span class="cmt">    # z_t ~ N(alpha_t * e, sigma_t^2 * I)</span></span>
<span class="cs-line">    <span class="kw">return</span> z_t</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Denoiser: predict clean embedding from noisy</span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">denoise</span>(z_t, t, theta):</span>
<span class="cs-line"><span class="cmt">    # returns p(x | z_t): vocab distribution [L, V]</span></span>
<span class="cs-line">    logits = transformer(z_t, t)  <span class="cmt"># bidirectional</span></span>
<span class="cs-line">    logits += output_prior(z_t, E)  <span class="cmt"># Gaussian log-density</span></span>
<span class="cs-line hl-g">    <span class="kw">return</span> softmax(logits, dim=-1)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Diffusion loss (MSE in embedding space)</span>
<span class="cs-line">loss = -0.5 * SNR_prime(t) * ||e_hat(z_t,t) - e||^2</span>
<span class="cs-line"><span class="cmt"># where e_hat = softmax(logits) @ E (predicted embed)</span></span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-replaid">
      <pre class="cs-pre">
<span class="cs-line cmt"># RePlaid = Plaid NELBO + modern DiT architecture</span>
<span class="cs-line"> </span>
<span class="cs-line"><span class="kw">class</span> <span class="cls">RePlaidBlock</span>(nn.Module):</span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">__init__</span>(<span class="kw">self</span>, h, heads):</span>
<span class="cs-line hl-g">        <span class="kw">self</span>.norm1 = LayerNorm(h)  <span class="cmt"># ← added</span></span>
<span class="cs-line hl-g">        <span class="kw">self</span>.norm2 = LayerNorm(h)</span>
<span class="cs-line hl-c">        <span class="kw">self</span>.attn = BidirectionalAttention(h, heads,</span>
<span class="cs-line hl-c">                        rope=<span class="cls">True</span>)  <span class="cmt"># ← RoPE added</span></span>
<span class="cs-line hl-p">        <span class="kw">self</span>.mlp = MLP(h, 4*h, bias=<span class="cls">True</span>,  <span class="cmt"># ← biases</span></span>
<span class="cs-line hl-p">                   act=GELU(approx=<span class="str">'tanh'</span>))  <span class="cmt"># ← GELU</span></span>
<span class="cs-line hl-a">        <span class="kw">self</span>.adaLN = AdaLNZero(h)  <span class="cmt"># ← timestep cond.</span></span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">forward</span>(<span class="kw">self</span>, x, t_emb):</span>
<span class="cs-line">        scale1, shift1, gate1, \</span>
<span class="cs-line">        scale2, shift2, gate2 = <span class="kw">self</span>.adaLN(t_emb)</span>
<span class="cs-line">        x = x + gate1 * <span class="kw">self</span>.attn(</span>
<span class="cs-line">                <span class="kw">self</span>.norm1(x) * scale1 + shift1)</span>
<span class="cs-line">        x = x + gate2 * <span class="kw">self</span>.mlp(</span>
<span class="cs-line">                <span class="kw">self</span>.norm2(x) * scale2 + shift2)</span>
<span class="cs-line">        <span class="kw">return</span> x</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Final logit head: BF16 throughout (no FP32 head)</span>
<span class="cs-line hl-g">self.head = Linear(h, V, dtype=bfloat16)</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-embed">
      <pre class="cs-pre">
<span class="cs-line cmt"># Embedding geometry: ELBO vs CE training</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># ELBO training (RePlaid default):</span>
<span class="cs-line"><span class="cmt">#   E in R^&#123;V x 16&#125;, unit-norm rows</span></span>
<span class="cs-line"><span class="cmt">#   Learned jointly with theta via NELBO</span></span>
<span class="cs-line"><span class="cmt">#   Result: low-rank, POS-structured</span></span>
<span class="cs-line hl-g"><span class="cmt">#   PCA: 90% variance in top-6 PCs ← tight clusters</span></span>
<span class="cs-line hl-g"><span class="cmt">#   PPL: 22.1 on OWT</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># ELBO + auxiliary CE training:</span>
<span class="cs-line"><span class="cmt">#   CE loss adds a separative force on E</span></span>
<span class="cs-line"><span class="cmt">#   Makes embeddings discriminative but dispersed</span></span>
<span class="cs-line hl-a"><span class="cmt">#   PCA: 90% variance needs 13 PCs ← spread out</span></span>
<span class="cs-line hl-a"><span class="cmt">#   PPL: 26.1 on OWT  (delta = +4.0)</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># The ELBO naturally regularizes embeddings</span>
<span class="cs-line cmt"># to be tight / easily denoised. CE training</span>
<span class="cs-line cmt"># fights against this: it wants maximum margin</span>
<span class="cs-line cmt"># between tokens, which spreads them out and</span>
<span class="cs-line cmt"># makes the denoising task harder.</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="cmt"># Ablation: freeze embeddings → PPL 39.4</span></span>
<span class="cs-line hl-p"><span class="cmt">#   Learnable E is the #1 factor in RePlaid.</span></span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-noise">
      <pre class="cs-pre">
<span class="cs-line cmt"># Noise schedule: learned to minimize variance</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># gamma(t) = gamma0 + (gamma1-gamma0) * gamma_tilde(t)</span>
<span class="cs-line cmt"># gamma_tilde: monotone neural net [0,1]->[0,1]</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Optimized for: minimize Var_t[diffusion_loss(t)]</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Proposition 1: the unique optimal schedule γ*</span>
<span class="cs-line cmt"># makes per-timestep diffusion loss CONSTANT:</span>
<span class="cs-line hl-g">    <span class="cmt"># ℓ(t) ≡ κ for all t ∈ [0,1]</span></span>
<span class="cs-line hl-g">    <span class="cmt"># Var_t[ℓ(t)] = 0  ← minimum variance</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Proposition 2 (Bayes-optimal denoiser):</span>
<span class="cs-line cmt"># CE(t) = H(x) - I(e;z0) + κ·t + C(x|zt)</span>
<span class="cs-line hl-c">    <span class="cmt"># κ·t is the dominant linear trend</span></span>
<span class="cs-line hl-c">    <span class="cmt"># CE is approximately linear in t !</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># No manual time reparameterization needed —</span>
<span class="cs-line cmt"># the ELBO variance minimization provides it.</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Compare: LangFlow manually matches the noise</span>
<span class="cs-line cmt"># density to the information-gain rate.</span>
<span class="cs-line cmt"># RePlaid achieves the same property for free.</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-scaling">
      <pre class="cs-pre">
<span class="cs-line cmt"># IsoFLOP scaling law analysis</span>
<span class="cs-line"> </span>
<span class="cs-line"><span class="cmt"># For each compute budget C:</span></span>
<span class="cs-line">budgets = [6e18, 1e19, 3e19, 6e19, 1e20]</span>
<span class="cs-line"> </span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">iso_flop</span>(C, method):</span>
<span class="cs-line">    losses = []</span>
<span class="cs-line">    <span class="kw">for</span> N <span class="kw">in</span> param_sizes:  <span class="cmt"># sweep model sizes</span></span>
<span class="cs-line">        D = C / (6 * N)  <span class="cmt"># tokens budget</span></span>
<span class="cs-line hl-p">        L = train(method, N, D)  <span class="cmt"># val loss</span></span>
<span class="cs-line">        losses.append((N, L))</span>
<span class="cs-line">    <span class="cmt"># fit quadratic in log-log to find N*, L*</span></span>
<span class="cs-line">    N_star, L_star = fit_quadratic(losses)</span>
<span class="cs-line">    <span class="kw">return</span> N_star, L_star</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Fit power law: L* ∝ C^α</span>
<span class="cs-line hl-g">alpha, beta = fit_power_law(budgets, L_stars)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Compute gaps (FLOPs to match AR loss):</span>
<span class="cs-line cmt">#   MDLM:            14×</span>
<span class="cs-line cmt">#   RePlaid (s.c.):  20×  ← ours</span>
<span class="cs-line cmt">#   Duo:             22×</span>
<span class="cs-line cmt">#   RePlaid (no sc): 27×</span>
<span class="cs-line cmt">#   Original Plaid:  64×  ← old (unfair) baseline</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-results">
      <pre class="cs-pre">
<span class="cs-line cmt"># Benchmark results (OWT, 0.1B, 1M steps)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># PPL (NELBO bound, lower = better):</span>
<span class="cs-line"><span class="cmt">#   AR Transformer-XL:   17.5  (gold standard)</span></span>
<span class="cs-line"><span class="cmt"># ---- discrete diffusion ----</span></span>
<span class="cs-line"><span class="cmt">#   MDLM (low var):      23.1</span></span>
<span class="cs-line"><span class="cmt">#   Duo:                 25.2</span></span>
<span class="cs-line"><span class="cmt"># ---- continuous diffusion ----</span></span>
<span class="cs-line hl-p">    <span class="cmt">#   RePlaid (s.c.):  22.1  ← SOTA continuous</span></span>
<span class="cs-line hl-p">    <span class="cmt">#   RePlaid (no sc): 23.6</span></span>
<span class="cs-line"><span class="cmt">#   Plaid (original):    24.4</span></span>
<span class="cs-line"><span class="cmt">#   LangFlow:            38.4</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Generation (DDPM sampler, T steps):</span>
<span class="cs-line cmt"># GenPPL at T=1024:</span>
<span class="cs-line hl-g">    <span class="cmt">#   RePlaid s.c.:   ~21  ← best DLM</span></span>
<span class="cs-line hl-g">    <span class="cmt">#   RePlaid no sc:  ~25</span></span>
<span class="cs-line"><span class="cmt">#   Duo:            ~26</span></span>
<span class="cs-line"><span class="cmt">#   MDLM:           ~28</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Key: RePlaid no s.c. beats Duo at ALL T values.</span>
<span class="cs-line cmt"># RePlaid s.c. best at T &gt;= 64 steps.</span>
<span class="cs-line hl-c"><span class="cmt"># At few steps (T=8): use DPM-Solver++(2M).</span></span>
      </pre>
    </div>

  </div>
</aside>


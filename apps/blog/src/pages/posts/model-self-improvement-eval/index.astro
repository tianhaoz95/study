<span class="cs-line cmt"># Five blind spots in current evaluations</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># 1. Compounding across iterations</span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">check_compounding</span>(model, loop_fn, n=<span class="num">5</span>):</span>
<span class="cs-line hl-p">    deltas = []</span>
<span class="cs-line hl-p">    <span class="kw">for</span> i <span class="kw">in</span> <span class="fn">range</span>(n):</span>
<span class="cs-line hl-p">        improved = loop_fn(model)</span>
<span class="cs-line hl-p">        deltas.append(<span class="fn">score</span>(improved) - <span class="fn">score</span>(model))</span>
<span class="cs-line hl-p">        model = improved</span>
<span class="cs-line hl-p">    <span class="kw">return</span> deltas  <span class="cmt"># should grow, not plateau</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># 2. Metacognitive accuracy</span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">metacog_score</span>(agent, candidates, oracle):</span>
<span class="cs-line hl-c">    predicted_rank = agent.predict_best(candidates)</span>
<span class="cs-line hl-c">    actual_rank    = oracle.eval_all(candidates)</span>
<span class="cs-line hl-c">    <span class="kw">return</span> <span class="fn">spearman_r</span>(predicted_rank, actual_rank)</span>
<span class="cs-line cmt"># No paper in this survey measures metacog Spearman.</span>
<span class="cs-line cmt"># Prior illustrative estimates (~0.3 / ~0.7) were</span>
<span class="cs-line cmt"># not sourced from any paper and have been removed.</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># 3. Generalisation vs benchmark exploitation</span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">ood_generalisation</span>(agent, seen_bench, ood_bench):</span>
<span class="cs-line">    delta_seen = <span class="fn">eval_delta</span>(agent, seen_bench)</span>
<span class="cs-line">    delta_ood  = <span class="fn">eval_delta</span>(agent, ood_bench)</span>
<span class="cs-line hl-a">    <span class="kw">return</span> delta_ood / delta_seen  <span class="cmt"># &lt; 0.5: likely gaming</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># 4. Safety regression checks</span>
<span class="cs-line">SAFETY_SUITE = [</span>
<span class="cs-line">    <span class="str">"alignment_eval"</span>, <span class="str">"refusal_rate"</span>,</span>
<span class="cs-line">    <span class="str">"reasoning_faithfulness"</span>, <span class="str">"prior_task_retention"</span></span>
<span class="cs-line">]</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># 5. Exploration diversity (FML-Bench finding)</span>
<span class="cs-line cmt"># Higher diversity → higher final score</span>
<span class="cs-line cmt"># But current evals reward final score only</span>
      </pre>
    </div>

    <!-- panel: framework -->
    <div class="cs-panel" id="panel-framework">
      <pre class="cs-pre">
<span class="cs-line cmt"># Rigorous self-improvement evaluation protocol</span>
<span class="cs-line"> </span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">run_eval</span>(model_factory, n_iters=<span class="num">5</span>, n_seeds=<span class="num">5</span>):</span>
<span class="cs-line"> </span>
<span class="cs-line hl-c">    <span class="cmt"># 1. Controlled baseline (seed-fixed)</span></span>
<span class="cs-line hl-c">    baseline = model_factory(seed=<span class="num">42</span>)</span>
<span class="cs-line hl-c">    b_score  = <span class="fn">eval</span>(baseline, HOLDOUT_SET)</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p">    <span class="cmt"># 2. Multi-iteration loop</span></span>
<span class="cs-line hl-p">    model   = baseline</span>
<span class="cs-line hl-p">    deltas  = []</span>
<span class="cs-line hl-p">    <span class="kw">for</span> i <span class="kw">in</span> <span class="fn">range</span>(n_iters):</span>
<span class="cs-line hl-p">        model  = self_improve(model)  <span class="cmt"># Levels 0-4</span></span>
<span class="cs-line hl-p">        delta  = <span class="fn">eval</span>(model, HOLDOUT_SET) - b_score</span>
<span class="cs-line hl-p">        deltas.append(delta)</span>
<span class="cs-line"> </span>
<span class="cs-line hl-g">        <span class="cmt"># 3. Safety invariant checks each iteration</span></span>
<span class="cs-line hl-g">        <span class="kw">for</span> check <span class="kw">in</span> SAFETY_SUITE:</span>
<span class="cs-line hl-g">            <span class="kw">assert</span> <span class="fn">check</span>(model) <span class="op">&gt;=</span> SAFETY_THRESHOLD</span>
<span class="cs-line"> </span>
<span class="cs-line hl-a">    <span class="cmt"># 4. Living holdout update (key anti-gaming)</span></span>
<span class="cs-line hl-a">    HOLDOUT_SET = <span class="fn">refresh_holdout</span>(HOLDOUT_SET, model)</span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="kw">return</span> &#123;</span>
<span class="cs-line">        <span class="str">"deltas"</span>: deltas,  <span class="cmt"># should grow with i</span></span>
<span class="cs-line">        <span class="str">"compounding_rate"</span>: <span class="fn">fit_slope</span>(deltas),</span>
<span class="cs-line">        <span class="str">"safety_passes"</span>: n_iters * <span class="fn">len</span>(SAFETY_SUITE),</span>
<span class="cs-line">    &#125;</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Genuine self-improvement: deltas grow over iters</span>
<span class="cs-line cmt"># Benchmark exploitation: deltas plateau at iter 2</span>
<span class="cs-line cmt"># Safety failure: exception before iter N</span>
      </pre>
    </div>

  </div>
</aside>

</div><!-- /post-grid -->

<script>
// ── TOC + sidebar toggles ──
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});
const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ── Code sidebar tab switching ──
const tabMeta = {
  intro:      { file: 'self_improvement.py',  title: 'The Taxonomy' },
  benchmarks: { file: 'benchmarks.py',        title: 'Benchmark Landscape' },
  time:       { file: 're_bench.py',          title: 'RE-Bench Analysis' },
  loop:       { file: 'sia_loop.py',          title: 'SIA Feedback Loop' },
  gaps:       { file: 'blind_spots.py',       title: 'Evaluation Gaps' },
  framework:  { file: 'eval_protocol.py',     title: 'Evaluation Framework' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ── IntersectionObserver — sync TOC + sidebar tab ──
const sectionMap = {
  's-intro':      'intro',
  's-benchmarks': 'benchmarks',
  's-time':       'time',
  's-loop':       'loop',
  's-gaps':       'gaps',
  's-framework':  'framework',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ── Level step navigator ──
(function() {
  let step = 0;
  const boxes   = document.querySelectorAll('#level-steps .step-box');
  const prevBtn = document.getElementById('level-prev');
  const nextBtn = document.getElementById('level-next');
  const progEl  = document.getElementById('level-prog');
  function update() {
    boxes.forEach((b, i) => {
      b.classList.remove('active', 'done');
      if (i === step) b.classList.add('active');
      else if (i < step) b.classList.add('done');
    });
    boxes.forEach((b, i) => {
      const n = b.querySelector('.step-num');
      if (n) n.textContent = i < step ? '✓' : String(i);
    });
    if (prevBtn) prevBtn.disabled = step === 0;
    if (nextBtn) nextBtn.disabled = step === boxes.length - 1;
    if (progEl) progEl.textContent = 'Level ' + step + ' of ' + (boxes.length - 1);
  }
  prevBtn?.addEventListener('click', () => { if (step > 0) { step--; update(); } });
  nextBtn?.addEventListener('click', () => { if (step < boxes.length - 1) { step++; update(); } });
  update();
})();

// ── Eval step navigator ──
(function() {
  let step = 0;
  const boxes   = document.querySelectorAll('#eval-steps .step-box');
  const prevBtn = document.getElementById('eval-prev');
  const nextBtn = document.getElementById('eval-next');
  const progEl  = document.getElementById('eval-prog');
  function update() {
    boxes.forEach((b, i) => {
      b.classList.remove('active', 'done');
      if (i === step) b.classList.add('active');
      else if (i < step) b.classList.add('done');
    });
    boxes.forEach((b, i) => {
      const n = b.querySelector('.step-num');
      if (n) n.textContent = i < step ? '✓' : String(i + 1);
    });
    if (prevBtn) prevBtn.disabled = step === 0;
    if (nextBtn) nextBtn.disabled = step === boxes.length - 1;
    if (progEl) progEl.textContent = 'Requirement ' + (step + 1) + ' of ' + boxes.length;
  }
  prevBtn?.addEventListener('click', () => { if (step > 0) { step--; update(); } });
  nextBtn?.addEventListener('click', () => { if (step < boxes.length - 1) { step++; update(); } });
  update();
})();

// ── Animated benchmark bars (IntersectionObserver) ──
const benchSection = document.getElementById('s-benchmarks');
if (benchSection) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('#bench-bars .bar-fill[data-w]').forEach(b => {
          b.style.width = b.dataset.w + '%';
        });
      }
    });
  }, { threshold: 0.3 }).observe(benchSection);
}

// ── RE-Bench time budget line chart ──
(function() {
  const canvas = document.getElementById('time-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  function resize() {
    const W = canvas.clientWidth, H = 280;
    canvas.width  = W * DPR;
    canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
    drawChart(activeT);
  }

  // Data: INTERPOLATED — RE-Bench reports 4x ratio at 2h and 2x ratio at 32h
  // but does not publish a tabulated score curve. Values below are
  // constructed to satisfy those two constraints (max human 32h = 100).
  // The 4h and 8h points are our reconstruction; treat as illustrative.
  // Sources: arXiv:2411.15114 for the 4x and 2x ratios only.
  const DATA = {
    ai:    { '2': 42, '4': 45, '8': 46, '32': 48 },
    human: { '2': 10, '4': 28, '8': 47, '32': 95 },
  };
  const X_LABELS = ['2h', '4h', '8h', '32h'];
  const X_VALS   = [2, 4, 8, 32];
  let activeT = '2';

  function drawChart(ht) {
    const W = canvas.clientWidth, H = 280;
    const PAD = { t: 24, r: 24, b: 44, l: 54 };
    const CW  = W - PAD.l - PAD.r;
    const CH  = H - PAD.t - PAD.b;
    ctx.clearRect(0, 0, W, H);

    // Background
    ctx.fillStyle = 'rgba(0,0,0,0)';
    ctx.fillRect(0, 0, W, H);

    // Grid lines
    for (let v = 0; v <= 100; v += 20) {
      const y = PAD.t + CH * (1 - v / 100);
      ctx.strokeStyle = 'rgba(255,255,255,0.05)';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(PAD.l, y);
      ctx.lineTo(PAD.l + CW, y);
      ctx.stroke();
      ctx.fillStyle = 'rgba(107,114,128,0.7)';
      ctx.font = `${10 / DPR * DPR}px monospace`;
      ctx.textAlign = 'right';
      ctx.fillText(v, PAD.l - 8, y + 4);
    }

    // X axis ticks
    const xPositions = X_VALS.map((_, i) => PAD.l + (i / (X_VALS.length - 1)) * CW);
    X_LABELS.forEach((lbl, i) => {
      const x = xPositions[i];
      ctx.strokeStyle = 'rgba(255,255,255,0.08)';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(x, PAD.t);
      ctx.lineTo(x, PAD.t + CH);
      ctx.stroke();
      ctx.fillStyle = 'rgba(107,114,128,0.7)';
      ctx.font = `10px monospace`;
      ctx.textAlign = 'center';
      ctx.fillText(lbl, x, PAD.t + CH + 20);
    });

    // Axes
    ctx.strokeStyle = 'rgba(255,255,255,0.2)';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(PAD.l, PAD.t);
    ctx.lineTo(PAD.l, PAD.t + CH);
    ctx.lineTo(PAD.l + CW, PAD.t + CH);
    ctx.stroke();

    // Y axis label
    ctx.save();
    ctx.translate(14, PAD.t + CH / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.fillStyle = 'rgba(107,114,128,0.7)';
    ctx.font = '10px monospace';
    ctx.textAlign = 'center';
    ctx.fillText('Normalized Score', 0, 0);
    ctx.restore();

    // Draw lines
    function drawLine(data, color, highlight) {
      const pts = X_VALS.map((v, i) => ({
        x: xPositions[i],
        y: PAD.t + CH * (1 - data[String(v)] / 100),
      }));
      ctx.beginPath();
      ctx.moveTo(pts[0].x, pts[0].y);
      pts.slice(1).forEach(p => ctx.lineTo(p.x, p.y));
      ctx.strokeStyle = color;
      ctx.lineWidth = 2.5;
      ctx.setLineDash([]);
      ctx.stroke();
      pts.forEach((p, i) => {
        const isHighlighted = X_LABELS[i] === ht + 'h';
        ctx.beginPath();
        ctx.arc(p.x, p.y, isHighlighted ? 7 : 4, 0, Math.PI * 2);
        ctx.fillStyle = isHighlighted ? color : 'rgba(0,0,0,.6)';
        ctx.fill();
        ctx.strokeStyle = color;
        ctx.lineWidth = 1.5;
        ctx.stroke();
        if (isHighlighted) {
          ctx.fillStyle = '#f0f0f8';
          ctx.font = 'bold 11px monospace';
          ctx.textAlign = 'center';
          ctx.fillText(String(Math.round(data[String(X_VALS[i])])), p.x, p.y - 14);
        }
      });
    }

    drawLine(DATA.ai,    '#8b5cf6', ht);
    drawLine(DATA.human, '#06b6d4', ht);

    // Crossover annotation at 8h
    const cx8 = xPositions[2];
    ctx.strokeStyle = 'rgba(245,158,11,0.4)';
    ctx.lineWidth = 1;
    ctx.setLineDash([4, 3]);
    ctx.beginPath();
    ctx.moveTo(cx8, PAD.t);
    ctx.lineTo(cx8, PAD.t + CH);
    ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle = 'rgba(245,158,11,0.7)';
    ctx.font = '9px monospace';
    ctx.textAlign = 'center';
    ctx.fillText('crossover', cx8, PAD.t + 12);
  }

  let activeT_val = 2;
  document.querySelectorAll('.budget-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.budget-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeT = btn.dataset.t;
      activeT_val = parseInt(btn.dataset.t);
      resize();
    });
  });

  resize();
  window.addEventListener('resize', resize);
})();

// ── Capability radar chart ──
(function() {
  const canvas = document.getElementById('radar-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;

  const DIMS = [
    'Execution\nSpeed',
    'Multi-step\nPlanning',
    'Exploration\nDiversity',
    'Metacognitive\nAccuracy',
    'Compounding\nImprovement',
    'Safety\nAwareness',
  ];
  const AI_VALS    = [92, 30, 58, 22, 18, 28];
  const HUMAN_VALS = [40, 82, 52, 68, 74, 80];

  function resize() {
    const W = canvas.clientWidth, H = 320;
    canvas.width  = W * DPR;
    canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
    draw(W, H);
  }

  function draw(W, H) {
    const cx = W / 2, cy = H / 2 - 8;
    const R  = Math.min(W, H) * 0.36;
    const N  = DIMS.length;
    const angleStep = (Math.PI * 2) / N;
    function angle(i) { return -Math.PI / 2 + i * angleStep; }
    function pt(i, r) {
      return { x: cx + Math.cos(angle(i)) * r, y: cy + Math.sin(angle(i)) * r };
    }

    ctx.clearRect(0, 0, W, H);

    // Grid circles
    for (let g = 1; g <= 5; g++) {
      const r = R * g / 5;
      ctx.beginPath();
      for (let i = 0; i < N; i++) {
        const p = pt(i, r);
        if (i === 0) ctx.moveTo(p.x, p.y);
        else ctx.lineTo(p.x, p.y);
      }
      ctx.closePath();
      ctx.strokeStyle = 'rgba(255,255,255,0.07)';
      ctx.lineWidth = 1;
      ctx.stroke();
    }

    // Axis lines
    for (let i = 0; i < N; i++) {
      const p = pt(i, R);
      ctx.beginPath();
      ctx.moveTo(cx, cy);
      ctx.lineTo(p.x, p.y);
      ctx.strokeStyle = 'rgba(255,255,255,0.1)';
      ctx.lineWidth = 1;
      ctx.stroke();
    }

    // Draw filled polygon
    function drawPoly(vals, color, fillAlpha) {
      ctx.beginPath();
      for (let i = 0; i < N; i++) {
        const p = pt(i, R * vals[i] / 100);
        if (i === 0) ctx.moveTo(p.x, p.y);
        else ctx.lineTo(p.x, p.y);
      }
      ctx.closePath();
      ctx.fillStyle = color.replace(')', ', ' + fillAlpha + ')').replace('rgb', 'rgba');
      ctx.fill();
      ctx.strokeStyle = color;
      ctx.lineWidth = 2;
      ctx.stroke();
    }

    drawPoly(HUMAN_VALS, 'rgb(6,182,212)', 0.12);
    drawPoly(AI_VALS,    'rgb(139,92,246)', 0.15);

    // Dots
    function drawDots(vals, color) {
      for (let i = 0; i < N; i++) {
        const p = pt(i, R * vals[i] / 100);
        ctx.beginPath();
        ctx.arc(p.x, p.y, 4, 0, Math.PI * 2);
        ctx.fillStyle = color;
        ctx.fill();
      }
    }
    drawDots(AI_VALS,    '#8b5cf6');
    drawDots(HUMAN_VALS, '#06b6d4');

    // Axis labels
    ctx.font = '9.5px monospace';
    for (let i = 0; i < N; i++) {
      const p = pt(i, R + 22);
      const lines = DIMS[i].split('\n');
      ctx.fillStyle = 'rgba(160,160,180,0.85)';
      ctx.textAlign = 'center';
      lines.forEach((ln, li) => {
        ctx.fillText(ln, p.x, p.y + li * 12 - (lines.length - 1) * 6);
      });
    }
  }

  resize();
  window.addEventListener('resize', resize);
})();
</script>
</BaseLayout>

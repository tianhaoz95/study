<span class="cs-line cmt"># Key idea: split the Taylor series at degree t</span>
<span class="cs-line cmt">#   exp(k,q) = exp_le_t(k,q) + exp_gt_t(k,q)</span>
<span class="cs-line"></span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">optimal_cutoff</span>(eps, d):</span>
<span class="cs-line hl-p">    <span class="cmt"># Balance sketch size vs coreset size</span></span>
<span class="cs-line hl-p">    <span class="kw">return</span> <span class="fn">floor</span>(<span class="fn">log</span>(<span class="num">1</span><span class="op">/</span>eps) <span class="op">/</span> <span class="fn">log</span>(d))</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Component 1: polynomial sketch for low-degree</span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">embed_key</span>(k, t):</span>
<span class="cs-line">    <span class="cmt"># Tensor powers: ψ₁(k) = (k^⊗l / l!)_l=0..t</span></span>
<span class="cs-line">    <span class="kw">return</span> [k_outer_power(k, l) <span class="op">/</span> <span class="fn">factorial</span>(l)</span>
<span class="cs-line">            <span class="kw">for</span> l <span class="kw">in</span> <span class="fn">range</span>(t<span class="op">+</span><span class="num">1</span>)]</span>
<span class="cs-line cmt"># Space: O( (d+t)^t / t! ) — the monomial count</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Component 2: coreset for high-degree (exp_gt_t)</span>
<span class="cs-line cmt"># Relies on Banaszczyk's theorem:</span>
<span class="cs-line cmt"># Since exp_gt_t is positive definite,</span>
<span class="cs-line cmt"># discrepancy theory guarantees C exists</span>
<span class="cs-line hl-c"><span class="kw">def</span> <span class="fn">base_compress</span>(K, kernel, eps):</span>
<span class="cs-line hl-c">    <span class="cmt"># Gram-Schmidt walk discrepancy oracle</span></span>
<span class="cs-line hl-c">    <span class="cmt"># Returns C with |C| ≤ |K|/2</span></span>
<span class="cs-line hl-c">    <span class="cmt"># coreset size: Õ(e^r² * Σ_&#123;l&gt;t&#125; r^2l/l! / ε)</span></span>
<span class="cs-line hl-c">    ...</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Query time: dot product + coreset sum</span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">query</span>(sketch, C, q, t):</span>
<span class="cs-line">    low  <span class="op">=</span> <span class="fn">dot</span>(sketch, <span class="fn">embed_query</span>(q, t))</span>
<span class="cs-line">    high <span class="op">=</span> <span class="fn">sum</span>(w <span class="op">*</span> <span class="fn">exp_gt</span>(k, q, t)</span>
<span class="cs-line">               <span class="kw">for</span> k, w <span class="kw">in</span> C)</span>
<span class="cs-line">    <span class="kw">return</span> low <span class="op">+</span> high</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-temperature">
      <pre class="cs-pre">
<span class="cs-line cmt"># Two regimes based on radius r</span>
<span class="cs-line cmt">#</span>
<span class="cs-line cmt"># HIGH TEMPERATURE: r = (log n)^o(1)</span>
<span class="cs-line cmt"># Softmax is diffuse — use polynomial sketch</span>
<span class="cs-line cmt">#</span>
<span class="cs-line cmt"># Space: (1/ε)^(1 - 1/a + o(1))</span>
<span class="cs-line cmt"># where a: d = log^a(n)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># LOW TEMPERATURE: r² = Ω(log n)</span>
<span class="cs-line cmt"># Softmax is sharp — use cluster decomposition</span>
<span class="cs-line cmt">#</span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">pseudorandomize</span>(K, r, Delta, tau):</span>
<span class="cs-line hl-p">    <span class="str">"""Split K into pseudo-random + dense parts"""</span></span>
<span class="cs-line hl-p">    dense <span class="op">=</span> []</span>
<span class="cs-line hl-p">    prand <span class="op">=</span> []</span>
<span class="cs-line hl-p">    <span class="kw">for</span> cluster <span class="kw">in</span> <span class="fn">find_dense_caps</span>(K, Delta, tau):</span>
<span class="cs-line hl-p">        center <span class="op">=</span> cluster.center</span>
<span class="cs-line hl-p">        r_prime <span class="op">=</span> cluster.radius   <span class="cmt"># &lt; r</span></span>
<span class="cs-line hl-p">        <span class="cmt"># Recenter &amp; rescale: effective radius → √(r·r')</span></span>
<span class="cs-line hl-p">        K_shifted <span class="op">=</span> <span class="fn">rescale</span>(K <span class="op">-</span> center, r, r_prime)</span>
<span class="cs-line hl-p">        dense.append(K_shifted)</span>
<span class="cs-line hl-p">    <span class="kw">return</span> prand, dense</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># After recentering, the exp factor becomes:</span>
<span class="cs-line cmt">#   exp(2*r*r') instead of exp(2*r²)</span>
<span class="cs-line cmt"># Since r' &lt; r, this is exponentially smaller!</span>
<span class="cs-line cmt">#</span>
<span class="cs-line cmt"># Low-temp space: Õ(e^(r²(1+o(1))) / ε)</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-results">
      <pre class="cs-pre">
<span class="cs-line cmt"># Results summary</span>
<span class="cs-line cmt">#</span>
<span class="cs-line cmt"># High-temperature theorem (Thm 2.1):</span>
<span class="cs-line cmt">#   d = log^a(n), r = (log n)^o(1)</span>
<span class="cs-line cmt">#   ε ∈ (n^-100, n^-c)</span>
<span class="cs-line cmt">#</span>
<span class="cs-line hl-g">  UPPER = (1/eps)**(1 - 1/a) * polylog(n)</span>
<span class="cs-line hl-g">  LOWER = (1/eps)**(1 - 1/a) / polylog(n)</span>
<span class="cs-line cmt">#   Tight to polylog factors for integer a &gt; 2</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Low-temperature theorem (Thm 2.2):</span>
<span class="cs-line cmt">#   r² = Ω(log n), d = (log n)^(1+Ω(1))</span>
<span class="cs-line cmt">#</span>
<span class="cs-line hl-p">  UPPER = exp(r**2 * (1 + o(1))) / eps</span>
<span class="cs-line hl-p">  LOWER = exp(r**2 * (1 - o(1))) / eps</span>
<span class="cs-line cmt">#   Tight to lower-order factors in the exponent</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Prior best (KSH+25) vs this work at ε=0.001:</span>
<span class="cs-line cmt">#   Old upper: 1/ε = 1000 units</span>
<span class="cs-line cmt">#   New upper: (1/ε)^0.5 ≈ 31.6 units  (a=2)</span>
<span class="cs-line cmt">#   New lower: ≈ 28.8 units</span>
<span class="cs-line cmt">#   Gap: 1000× → 1.1× improvement!</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Three techniques working together:</span>
<span class="cs-line hl-c">  1. Polynomial method  (moments sketch)</span>
<span class="cs-line hl-c">  2. Discrepancy theory (coreset via Banaszczyk)</span>
<span class="cs-line hl-c">  3. Space partitioning (cluster recentering)</span>
      </pre>
    </div>

  </div>
</aside>

</div><!-- /post-grid -->

<script>
// ─── TOC + SIDEBAR TOGGLES ───────────────────────────────────────────────────
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});

const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ─── CODE SIDEBAR TAB SWITCHING ──────────────────────────────────────────────
const tabMeta = {
  problem:     { file: 'attention/problem.py',     title: 'The KV Cache Problem' },
  formulation: { file: 'attention/formulation.py', title: 'Streaming Approximation' },
  gap:         { file: 'attention/gap.py',         title: 'The Open Gap' },
  algorithm:   { file: 'attention/algorithm.py',   title: 'The Algorithm' },
  temperature: { file: 'attention/temperature.py', title: 'Temperature Regimes' },
  results:     { file: 'attention/results.py',     title: 'Tight Bounds' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ─── INTERSECTION OBSERVER ───────────────────────────────────────────────────
const sectionMap = {
  's-problem':     'problem',
  's-formulation': 'formulation',
  's-gap':         'gap',
  's-algorithm':   'algorithm',
  's-temperature': 'temperature',
  's-results':     'results',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.25 }).observe(s)
);

// ─── STEP NAVIGATOR ──────────────────────────────────────────────────────────
let step = 0;
const stepBoxes = document.querySelectorAll('.step-box');
const prevBtn   = document.getElementById('step-prev');
const nextBtn   = document.getElementById('step-next');
const progEl    = document.getElementById('step-prog');
function updateSteps() {
  stepBoxes.forEach((b, i) => {
    b.classList.remove('active','done');
    if (i === step) b.classList.add('active');
    else if (i < step) b.classList.add('done');
  });
  if (prevBtn) prevBtn.disabled = step === 0;
  if (nextBtn) nextBtn.disabled = step === stepBoxes.length - 1;
  if (progEl) progEl.textContent = `Step ${step+1} of ${stepBoxes.length}`;
  stepBoxes.forEach((b, i) => {
    const n = b.querySelector('.step-num');
    if (n) n.textContent = i < step ? '✓' : String(i+1);
  });
}
prevBtn?.addEventListener('click', () => { if(step>0){step--;updateSteps();} });
nextBtn?.addEventListener('click', () => { if(step<stepBoxes.length-1){step++;updateSteps();} });
updateSteps();

// ─── KV CACHE GROWTH CANVAS ──────────────────────────────────────────────────
(function() {
  const canvas = document.getElementById('kv-canvas');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  function resizeCanvas() {
    const W = canvas.clientWidth;
    const H = 200;
    canvas.width  = W * DPR;
    canvas.height = H * DPR;
    drawKV();
  }

  const slider = document.getElementById('ctx-slider');
  const ctxVal = document.getElementById('ctx-val');
  const cacheGb = document.getElementById('cache-gb');
  const fullGb  = document.getElementById('full-gb');
  const approxGb = document.getElementById('approx-gb');

  function drawKV() {
    const W = canvas.clientWidth;
    const H = 200;
    const ctx = canvas.getContext('2d');
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.scale(DPR, DPR);
    const ctxN = parseInt(slider.value); // in K tokens
    ctxVal.textContent = ctxN + 'K tokens';

    // bytes per token for 32-layer, 8-head, 128-dim model
    const bytesPerToken = 32 * 8 * 2 * 128 * 2;
    const gb = ctxN * 1024 * bytesPerToken / 1e9;
    cacheGb.textContent = gb.toFixed(1) + ' GB';
    fullGb.textContent  = gb.toFixed(1) + ' GB';

    // approximate size: (1/ε)^0.5 scaling
    const epsExponent = 0.5; // a=2, high temp
    const eps = 0.01;
    // relative compression = (eps)^(0.5) ≈ 0.1 of n
    const compressRatio = Math.pow(eps, epsExponent);
    const approxMb = gb * compressRatio * 1000;
    approxGb.textContent = approxMb.toFixed(0) + ' MB';

    const pad = { l:48, r:20, t:16, b:32 };
    const plotW = W - pad.l - pad.r;
    const plotH = H - pad.t - pad.b;

    // axes
    ctx.strokeStyle = 'rgba(255,255,255,0.08)';
    ctx.lineWidth = 1;
    for (let g = 0; g <= 4; g++) {
      const y = pad.t + plotH - (g/4)*plotH;
      ctx.beginPath(); ctx.moveTo(pad.l, y); ctx.lineTo(pad.l + plotW, y); ctx.stroke();
    }

    const maxCtx = 128;
    const maxGb  = maxCtx * 1024 * bytesPerToken / 1e9;

    // draw lines for full KV and approximate
    function drawLine(colorStr, getValue, lineWidth) {
      ctx.strokeStyle = colorStr;
      ctx.lineWidth = lineWidth;
      ctx.beginPath();
      for (let x = 0; x <= plotW; x++) {
        const n = (x / plotW) * maxCtx;
        const v = getValue(n);
        const frac = Math.min(v / maxGb, 1);
        const py = pad.t + plotH * (1 - frac);
        if (x === 0) ctx.moveTo(pad.l + x, py);
        else ctx.lineTo(pad.l + x, py);
      }
      ctx.stroke();
    }

    ctx.setLineDash([]);
    drawLine('rgba(239,68,68,0.5)', n => n * 1024 * bytesPerToken / 1e9, 1.5);
    ctx.setLineDash([4, 3]);
    drawLine('rgba(139,92,246,0.8)', n => n * 1024 * bytesPerToken / 1e9 * compressRatio, 1.5);
    ctx.setLineDash([]);

    // current position marker
    const cx = pad.l + (ctxN / maxCtx) * plotW;
    const fullY = pad.t + plotH * (1 - Math.min(gb / maxGb, 1));
    const approxY = pad.t + plotH * (1 - Math.min(gb * compressRatio / maxGb, 1));

    ctx.fillStyle = 'rgba(239,68,68,0.9)';
    ctx.beginPath(); ctx.arc(cx, fullY, 4, 0, Math.PI*2); ctx.fill();
    ctx.fillStyle = 'rgba(139,92,246,0.9)';
    ctx.beginPath(); ctx.arc(cx, approxY, 4, 0, Math.PI*2); ctx.fill();

    // vertical dotted line
    ctx.setLineDash([3, 4]);
    ctx.strokeStyle = 'rgba(255,255,255,0.15)';
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(cx, pad.t); ctx.lineTo(cx, pad.t + plotH); ctx.stroke();
    ctx.setLineDash([]);

    // y-axis labels
    ctx.fillStyle = 'rgba(148,163,184,0.7)';
    ctx.font = `${10*DPR}px monospace`;
    ctx.textAlign = 'right';
    ctx.scale(1/DPR, 1/DPR);
    for (let g = 0; g <= 4; g++) {
      const v = (g/4) * maxGb;
      const y = (pad.t + plotH - (g/4)*plotH) * DPR;
      ctx.fillText(v.toFixed(0)+'GB', (pad.l - 4)*DPR, y + 3);
    }
    ctx.scale(DPR, DPR);

    // legend
    ctx.font = '10px monospace';
    ctx.textAlign = 'left';
    ctx.fillStyle = 'rgba(239,68,68,0.8)';
    ctx.fillText('Full KV cache', pad.l + 8, pad.t + 14);
    ctx.fillStyle = 'rgba(139,92,246,0.9)';
    ctx.fillText('Approx (ε=0.01)', pad.l + 8, pad.t + 28);
  }

  slider.addEventListener('input', () => {
    const ctx = canvas.getContext('2d');
    ctx.setTransform(1,0,0,1,0,0);
    drawKV();
  });

  window.addEventListener('resize', () => {
    const ctx = canvas.getContext('2d');
    ctx.setTransform(1,0,0,1,0,0);
    resizeCanvas();
  });

  resizeCanvas();
})();

// ─── GAP CANVAS ──────────────────────────────────────────────────────────────
(function() {
  const canvas = document.getElementById('gap-canvas');
  if (!canvas) return;
  let currentA = 1.5;
  const DPR = window.devicePixelRatio || 1;

  function resizeAndDraw() {
    const W = canvas.clientWidth;
    const H = 220;
    canvas.width  = W * DPR;
    canvas.height = H * DPR;
    drawGap();
  }

  function drawGap() {
    const W = canvas.clientWidth;
    const H = 220;
    const ctx = canvas.getContext('2d');
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.scale(DPR, DPR);

    const pad = { l:52, r:20, t:18, b:36 };
    const plotW = W - pad.l - pad.r;
    const plotH = H - pad.t - pad.b;

    // ε ranges from 0.5 down to 0.001 (log scale on x)
    const log_eps_min = Math.log10(0.001);
    const log_eps_max = Math.log10(0.5);

    function epsToX(eps) {
      return pad.l + (Math.log10(eps) - log_eps_min) / (log_eps_max - log_eps_min) * plotW;
    }

    // space in terms of 1/eps units
    function oldUpper(eps) { return 1/eps; }
    function newUpper(eps, a) { return Math.pow(1/eps, 1 - 1/a); }
    function newLower(eps, a) { return Math.pow(1/eps, 1 - 1/a - 0.05); }
    function oldLower() { return 1; }

    const maxSpace = 1000;
    function spaceToY(s) {
      return pad.t + plotH * (1 - Math.min(s / maxSpace, 1));
    }

    // grid
    ctx.strokeStyle = 'rgba(255,255,255,0.05)';
    ctx.lineWidth = 1;
    for (let g = 0; g <= 4; g++) {
      const y = pad.t + (g/4)*plotH;
      ctx.beginPath(); ctx.moveTo(pad.l, y); ctx.lineTo(pad.l + plotW, y); ctx.stroke();
    }

    const EPS_VALS = [];
    for (let i = 0; i <= 200; i++) {
      const le = log_eps_min + (i/200) * (log_eps_max - log_eps_min);
      EPS_VALS.push(Math.pow(10, le));
    }

    function drawCurve(color, dash, fn, lw) {
      ctx.strokeStyle = color;
      ctx.lineWidth = lw || 1.5;
      ctx.setLineDash(dash || []);
      ctx.beginPath();
      EPS_VALS.forEach((eps, i) => {
        const x = epsToX(eps);
        const y = spaceToY(fn(eps));
        if (i === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      });
      ctx.stroke();
      ctx.setLineDash([]);
    }

    drawCurve('rgba(239,68,68,0.5)', [5,3], oldUpper);
    drawCurve('rgba(107,114,128,0.4)', [3,4], oldLower);
    drawCurve('rgba(139,92,246,0.85)', [], eps => newUpper(eps, currentA), 2);
    drawCurve('rgba(6,182,212,0.7)',   [2,3], eps => newLower(eps, currentA));

    // labels at right edge
    const rightEps = 0.48;
    ctx.font = `${9*DPR}px monospace`;
    ctx.scale(1/DPR, 1/DPR);
    ctx.textAlign = 'left';
    const labelX = (epsToX(rightEps) + 4) * DPR;
    ctx.fillStyle = 'rgba(239,68,68,0.8)';
    ctx.fillText('Prior UB O(1/ε)', labelX, spaceToY(oldUpper(rightEps)) * DPR);
    ctx.fillStyle = 'rgba(139,92,246,1)';
    ctx.fillText(`New UB (1/ε)^${(1-1/currentA).toFixed(2)}`, labelX, spaceToY(newUpper(rightEps, currentA)) * DPR - 12);
    ctx.fillStyle = 'rgba(6,182,212,0.9)';
    ctx.fillText('New LB', labelX, spaceToY(newLower(rightEps, currentA)) * DPR + 14);
    ctx.scale(DPR, DPR);

    // x axis labels (ε values)
    ctx.font = '9px monospace';
    ctx.textAlign = 'center';
    ctx.fillStyle = 'rgba(148,163,184,0.6)';
    [0.001, 0.01, 0.1, 0.5].forEach(eps => {
      const x = epsToX(eps);
      ctx.fillText('ε='+eps, x, pad.t + plotH + 20);
    });

    // y axis labels
    ctx.textAlign = 'right';
    [0, 250, 500, 750, 1000].forEach((v, i) => {
      ctx.fillText(v, pad.l - 4, pad.t + plotH*(1 - v/maxSpace) + 3);
    });

    // axis arrow
    ctx.strokeStyle = 'rgba(148,163,184,0.3)';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(pad.l, pad.t);
    ctx.lineTo(pad.l, pad.t + plotH);
    ctx.lineTo(pad.l + plotW, pad.t + plotH);
    ctx.stroke();
  }

  document.querySelectorAll('.regime-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      currentA = parseFloat(btn.dataset.a);
      document.querySelectorAll('.regime-btn').forEach(b => {
        b.style.background = 'var(--surface)';
        b.style.color = 'var(--muted2)';
        b.style.borderColor = 'var(--border-hi)';
      });
      btn.style.background = 'var(--purple-dim)';
      btn.style.color = 'var(--purple-l)';
      const ctx = canvas.getContext('2d');
      ctx.setTransform(1,0,0,1,0,0);
      drawGap();
    });
  });

  window.addEventListener('resize', () => {
    const ctx = canvas.getContext('2d');
    ctx.setTransform(1,0,0,1,0,0);
    resizeAndDraw();
  });

  resizeAndDraw();
})();

// ─── SPLIT CANVAS (sketch vs coreset cost) ───────────────────────────────────
(function() {
  const canvas = document.getElementById('split-canvas');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  const tSlider = document.getElementById('t-slider');
  const tValEl  = document.getElementById('t-val');
  const sketchEl = document.getElementById('sketch-cost');
  const coresetEl = document.getElementById('coreset-cost');
  const totalEl  = document.getElementById('total-cost');

  // Parameters: d = log^2(n), r=1, eps=0.001
  const d = 16; // log^2(n) for n = 65536
  const r = 1;
  const eps = 0.001;

  function factorial(n) {
    let f = 1; for (let i = 2; i <= n; i++) f *= i; return f;
  }

  function sketchSize(t) {
    // (d+t)^t / t!
    return Math.pow(d + t, t) / factorial(t);
  }

  function coresetSize(t) {
    // (e^r^2 / eps) * sum_{l > t} r^{2l} / l!
    let tail = 0;
    for (let l = t+1; l <= 40; l++) {
      tail += Math.pow(r*r, l) / factorial(l);
    }
    return (Math.exp(r*r) / eps) * tail;
  }

  function resizeAndDraw() {
    const W = canvas.clientWidth;
    const H = 210;
    canvas.width  = W * DPR;
    canvas.height = H * DPR;
    drawSplit();
  }

  function drawSplit() {
    const W = canvas.clientWidth;
    const H = 210;
    const ctx = canvas.getContext('2d');
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.scale(DPR, DPR);

    const tCur = parseInt(tSlider.value);
    tValEl.textContent = tCur;

    const pad = { l:60, r:20, t:18, b:36 };
    const plotW = W - pad.l - pad.r;
    const plotH = H - pad.t - pad.b;

    // Find optimal t and max value
    let maxVal = 0;
    for (let t = 1; t <= 20; t++) {
      maxVal = Math.max(maxVal, sketchSize(t), coresetSize(t));
    }
    maxVal = Math.min(maxVal, 1e7);

    // grid
    ctx.strokeStyle = 'rgba(255,255,255,0.05)';
    ctx.lineWidth = 1;
    for (let g = 0; g <= 4; g++) {
      const y = pad.t + (g/4)*plotH;
      ctx.beginPath(); ctx.moveTo(pad.l, y); ctx.lineTo(pad.l + plotW, y); ctx.stroke();
    }

    const tMin = 1, tMax = 20;

    function tToX(t) { return pad.l + ((t - tMin) / (tMax - tMin)) * plotW; }
    function valToY(v) { return pad.t + plotH * (1 - Math.min(v, maxVal) / maxVal); }

    // Draw sketch line (cyan)
    ctx.strokeStyle = 'rgba(6,182,212,0.85)';
    ctx.lineWidth = 1.5;
    ctx.setLineDash([]);
    ctx.beginPath();
    for (let t = tMin; t <= tMax; t++) {
      const x = tToX(t);
      const y = valToY(sketchSize(t));
      if (t === tMin) ctx.moveTo(x, y); else ctx.lineTo(x, y);
    }
    ctx.stroke();

    // Draw coreset line (purple)
    ctx.strokeStyle = 'rgba(139,92,246,0.85)';
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    for (let t = tMin; t <= tMax; t++) {
      const x = tToX(t);
      const y = valToY(coresetSize(t));
      if (t === tMin) ctx.moveTo(x, y); else ctx.lineTo(x, y);
    }
    ctx.stroke();

    // Total = sketch + coreset (white)
    ctx.strokeStyle = 'rgba(255,255,255,0.4)';
    ctx.lineWidth = 1;
    ctx.setLineDash([3,3]);
    ctx.beginPath();
    for (let t = tMin; t <= tMax; t++) {
      const x = tToX(t);
      const y = valToY(sketchSize(t) + coresetSize(t));
      if (t === tMin) ctx.moveTo(x, y); else ctx.lineTo(x, y);
    }
    ctx.stroke();
    ctx.setLineDash([]);

    // Optimal t marker (lowest total)
    let optT = tMin, optTotal = 1e18;
    for (let t = tMin; t <= tMax; t++) {
      const tot = sketchSize(t) + coresetSize(t);
      if (tot < optTotal) { optTotal = tot; optT = t; }
    }
    const optX = tToX(optT);
    ctx.strokeStyle = 'rgba(16,185,129,0.6)';
    ctx.lineWidth = 1;
    ctx.setLineDash([4,3]);
    ctx.beginPath(); ctx.moveTo(optX, pad.t); ctx.lineTo(optX, pad.t + plotH); ctx.stroke();
    ctx.setLineDash([]);

    // Current t marker
    const cx = tToX(tCur);
    const sk = sketchSize(tCur);
    const co = coresetSize(tCur);
    const tot = sk + co;

    sketchEl.textContent  = sk.toFixed(0);
    coresetEl.textContent = co.toFixed(0);
    totalEl.textContent   = tot.toFixed(0);

    ctx.fillStyle = 'rgba(6,182,212,0.9)';
    ctx.beginPath(); ctx.arc(cx, valToY(sk), 4, 0, Math.PI*2); ctx.fill();
    ctx.fillStyle = 'rgba(139,92,246,0.9)';
    ctx.beginPath(); ctx.arc(cx, valToY(co), 4, 0, Math.PI*2); ctx.fill();

    // vertical current line
    ctx.strokeStyle = 'rgba(255,255,255,0.12)';
    ctx.lineWidth = 1;
    ctx.setLineDash([3,4]);
    ctx.beginPath(); ctx.moveTo(cx, pad.t); ctx.lineTo(cx, pad.t + plotH); ctx.stroke();
    ctx.setLineDash([]);

    // x axis labels
    ctx.font = '9px monospace';
    ctx.textAlign = 'center';
    ctx.fillStyle = 'rgba(148,163,184,0.6)';
    [1, 5, 10, 15, 20].forEach(t => {
      ctx.fillText('t='+t, tToX(t), pad.t + plotH + 20);
    });
    ctx.fillStyle = 'rgba(16,185,129,0.7)';
    ctx.fillText('opt', tToX(optT), pad.t + plotH + 20);

    // legend
    ctx.textAlign = 'left';
    ctx.font = '9px monospace';
    ctx.fillStyle = 'rgba(6,182,212,0.85)';
    ctx.fillText('sketch (low-deg)', pad.l + 8, pad.t + 14);
    ctx.fillStyle = 'rgba(139,92,246,0.85)';
    ctx.fillText('coreset (high-deg)', pad.l + 8, pad.t + 27);
    ctx.fillStyle = 'rgba(255,255,255,0.5)';
    ctx.fillText('total', pad.l + 8, pad.t + 40);
  }

  tSlider.addEventListener('input', () => {
    const ctx = canvas.getContext('2d');
    ctx.setTransform(1,0,0,1,0,0);
    drawSplit();
  });

  window.addEventListener('resize', () => {
    const ctx = canvas.getContext('2d');
    ctx.setTransform(1,0,0,1,0,0);
    resizeAndDraw();
  });

  resizeAndDraw();
})();

// ─── TEMPERATURE CANVAS ──────────────────────────────────────────────────────
(function() {
  const canvas = document.getElementById('temp-canvas');
  if (!canvas) return;
  let activeR = 1;
  const DPR = window.devicePixelRatio || 1;

  function resizeAndDraw() {
    const W = canvas.clientWidth;
    const H = 230;
    canvas.width  = W * DPR;
    canvas.height = H * DPR;
    drawTemp();
  }

  function drawTemp() {
    const W = canvas.clientWidth;
    const H = 230;
    const ctx = canvas.getContext('2d');
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.scale(DPR, DPR);

    const pad = { l:52, r:20, t:18, b:36 };
    const plotW = W - pad.l - pad.r;
    const plotH = H - pad.t - pad.b;

    // x axis: dot product ⟨k, q⟩ from -r² to r²
    // For a fixed query q, show the softmax weights as a function of ⟨k, q⟩

    // Show a set of 8 tokens with varying dot products
    // The actual dot products depend on r
    const tokenLabels = ['cat', 'dog', 'ran', 'over', 'the', 'fence', 'today', 'quickly'];
    // Fixed dot products (as fractions of r²): roughly uniform spread
    const dotFracs = [-0.9, -0.6, -0.3, 0.1, 0.4, 0.65, 0.8, 1.0];

    function softmaxWeights(r) {
      const dots = dotFracs.map(f => f * r * r);
      const exps = dots.map(d => Math.exp(d));
      const Z = exps.reduce((a,b) => a+b, 0);
      return exps.map(e => e / Z);
    }

    const weights = softmaxWeights(activeR);
    const maxW = Math.max(...weights);

    const nTokens = tokenLabels.length;
    const barWidth = (plotW - (nTokens-1)*6) / nTokens;

    // grid
    ctx.strokeStyle = 'rgba(255,255,255,0.05)';
    ctx.lineWidth = 1;
    for (let g = 0; g <= 4; g++) {
      const y = pad.t + (g/4)*plotH;
      ctx.beginPath(); ctx.moveTo(pad.l, y); ctx.lineTo(pad.l + plotW, y); ctx.stroke();
    }

    const colorMap = {
      1: 'rgba(6,182,212,0.75)',
      2: 'rgba(139,92,246,0.75)',
      3: 'rgba(245,158,11,0.75)',
    };

    weights.forEach((w, i) => {
      const x = pad.l + i * (barWidth + 6);
      const barH = (w / maxW) * plotH * 0.9;
      const y = pad.t + plotH - barH;

      // inactive colors
      const isActive = activeR !== null;
      ctx.fillStyle = colorMap[activeR];
      ctx.fillRect(x, y, barWidth, barH);

      // token label
      ctx.save();
      ctx.font = '8px monospace';
      ctx.textAlign = 'center';
      ctx.fillStyle = 'rgba(148,163,184,0.75)';
      ctx.fillText(tokenLabels[i], x + barWidth/2, pad.t + plotH + 18);
      ctx.restore();

      // weight label on bar
      if (barH > 12) {
        ctx.save();
        ctx.font = '7px monospace';
        ctx.textAlign = 'center';
        ctx.fillStyle = 'rgba(255,255,255,0.7)';
        ctx.fillText((w*100).toFixed(0)+'%', x + barWidth/2, y + 10);
        ctx.restore();
      }
    });

    // y-axis
    ctx.font = '9px monospace';
    ctx.textAlign = 'right';
    ctx.fillStyle = 'rgba(148,163,184,0.6)';
    [0, 25, 50, 75, 100].forEach(pct => {
      const v = (pct/100) * maxW;
      const y = pad.t + plotH * (1 - v / maxW);
      ctx.fillText(pct+'%', pad.l - 4, y + 3);
    });

    // title
    ctx.textAlign = 'left';
    ctx.fillStyle = colorMap[activeR];
    ctx.font = 'bold 10px monospace';
    ctx.fillText(`r = ${activeR}  →  softmax sharpness`, pad.l + 6, pad.t + 14);
    const maxPct = (maxW * 100).toFixed(0);
    ctx.fillStyle = 'rgba(148,163,184,0.7)';
    ctx.font = '9px monospace';
    ctx.fillText(`top token gets ${maxPct}% of weight`, pad.l + 6, pad.t + 28);
  }

  document.querySelectorAll('.temp-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      activeR = parseInt(btn.dataset.r);
      document.querySelectorAll('.temp-btn').forEach(b => {
        b.style.background = 'var(--surface)';
        b.style.color = 'var(--muted2)';
      });
      const colorClass = { 1: 'var(--cyan-dim)', 2: 'var(--purple-dim)', 3: 'rgba(245,158,11,.1)' };
      const textClass  = { 1: 'var(--cyan)', 2: 'var(--purple-l)', 3: 'var(--amber)' };
      btn.style.background = colorClass[activeR];
      btn.style.color      = textClass[activeR];
      const ctx = canvas.getContext('2d');
      ctx.setTransform(1,0,0,1,0,0);
      drawTemp();
    });
  });

  window.addEventListener('resize', () => {
    const ctx = canvas.getContext('2d');
    ctx.setTransform(1,0,0,1,0,0);
    resizeAndDraw();
  });

  resizeAndDraw();
})();

// ─── ANIMATED BAR CHART ──────────────────────────────────────────────────────
const barsSection = document.getElementById('s-results');
if (barsSection) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          b.style.width = parseFloat(b.dataset.w) + '%';
        });
      }
    });
  }, { threshold: 0.3 }).observe(barsSection);
}
</script>
</BaseLayout>

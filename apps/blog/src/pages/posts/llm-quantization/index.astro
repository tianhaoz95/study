      <pre class="cs-pre">
<span class="cs-line cmt"># Affine (asymmetric) quantization</span>
<span class="cs-line"><span class="kw">import</span> torch</span>
<span class="cs-line"></span>
<span class="cs-line hl-c"><span class="kw">def</span> <span class="fn">quantize</span>(x: <span class="cls">torch.Tensor</span>, bits: <span class="cls">int</span>,</span>
<span class="cs-line hl-c">             per_group: <span class="cls">int</span> = <span class="num">128</span>):</span>
<span class="cs-line hl-c">    <span class="cmt"># per-group symmetric quantization</span></span>
<span class="cs-line hl-c">    x = x.<span class="fn">reshape</span>(-<span class="num">1</span>, per_group)</span>
<span class="cs-line hl-c">    absmax = x.<span class="fn">abs</span>().<span class="fn">max</span>(dim=-<span class="num">1</span>, keepdim=<span class="cls">True</span>).values</span>
<span class="cs-line hl-c">    qmax = <span class="num">2</span> ** (bits - <span class="num">1</span>) - <span class="num">1</span>   <span class="cmt"># 127, 7, ...</span></span>
<span class="cs-line hl-c">    scale = absmax / qmax           <span class="cmt"># per-group scale</span></span>
<span class="cs-line hl-c">    x_q = (x / scale).<span class="fn">round</span>().<span class="fn">clamp</span>(-qmax-<span class="num">1</span>, qmax)</span>
<span class="cs-line hl-c">    <span class="kw">return</span> x_q.<span class="fn">to</span>(torch.int8), scale</span>
<span class="cs-line"></span>
<span class="cs-line hl-g"><span class="kw">def</span> <span class="fn">dequantize</span>(x_q, scale):</span>
<span class="cs-line hl-g">    <span class="kw">return</span> (x_q.<span class="fn">float</span>() * scale).<span class="fn">reshape</span>(-<span class="num">1</span>)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Scale overhead (per-group 128)</span>
<span class="cs-line cmt"># 70B model, INT4 g128:</span>
<span class="cs-line cmt"># scale bytes = 70e9 / 128 * 2 = ~1.1 GB</span>
<span class="cs-line cmt"># weight bytes = 70e9 * 0.5 = 35.3 GB</span>
<span class="cs-line cmt"># ∴ overhead is ~3% — acceptable</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># KV cache size (per-token, per-layer):</span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">kv_bytes</span>(seq, layers, heads, d_head, dtype_b):</span>
<span class="cs-line">    <span class="kw">return</span> seq * layers * heads * d_head * <span class="num">2</span> * dtype_b</span>
<span class="cs-line cmt"># Llama-3.1-70B, 4096 seq, BF16:</span>
<span class="cs-line cmt"># kv_bytes(4096, 80, 8, 128, 2) ≈ 671 MB</span>
<span class="cs-line cmt"># Same at INT8 (dtype_b=1):     ≈ 336 MB</span>

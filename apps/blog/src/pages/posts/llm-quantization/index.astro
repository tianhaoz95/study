    <div class="cs-panel" id="panel-ptq">
      <pre class="cs-pre">
<span class="cs-line cmt"># GPTQ — second-order PTQ (pseudocode)</span>
<span class="cs-line cmt"># Processes one linear layer at a time</span>
<span class="cs-line"></span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">gptq_layer</span>(W, X_cal, bits=<span class="num">4</span>, group=<span class="num">128</span>):</span>
<span class="cs-line hl-p">    <span class="cmt"># Compute approx. Hessian from calib data</span></span>
<span class="cs-line hl-p">    H = (X_cal.T @ X_cal) / X_cal.<span class="fn">shape</span>[<span class="num">0</span>]</span>
<span class="cs-line hl-p">    H += <span class="num">0.01</span> * torch.<span class="fn">eye</span>(H.<span class="fn">shape</span>[<span class="num">0</span>])  <span class="cmt"># damp</span></span>
<span class="cs-line hl-p">    H_inv = torch.<span class="fn">linalg.inv</span>(H)</span>
<span class="cs-line hl-p">    W_q = W.<span class="fn">clone</span>()</span>
<span class="cs-line hl-p">    <span class="kw">for</span> i <span class="kw">in</span> <span class="fn">range</span>(W.<span class="fn">shape</span>[<span class="num">1</span>]):  <span class="cmt"># column by column</span></span>
<span class="cs-line hl-p">        q_i = <span class="fn">quantize_col</span>(W_q[:, i], bits, group)</span>
<span class="cs-line hl-p">        err = W_q[:, i] - q_i           <span class="cmt"># quant error</span></span>
<span class="cs-line hl-p">        <span class="cmt"># Compensate remaining columns via H_inv</span></span>
<span class="cs-line hl-p">        W_q[:, i+<span class="num">1</span>:] -= err[:, <span class="cls">None</span>] * \</span>
<span class="cs-line hl-p">                H_inv[i, i+<span class="num">1</span>:] / H_inv[i, i]</span>
<span class="cs-line hl-p">        W_q[:, i] = q_i</span>
<span class="cs-line hl-p">    <span class="kw">return</span> W_q</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># AWQ — activation-aware scale search</span>
<span class="cs-line hl-c"><span class="kw">def</span> <span class="fn">awq_scale_search</span>(W, A_stats, bits=<span class="num">4</span>):</span>
<span class="cs-line hl-c">    <span class="cmt"># A_stats = per-channel activation mean abs</span></span>
<span class="cs-line hl-c">    best_s, best_loss = <span class="cls">None</span>, <span class="cls">float</span>(<span class="str">'inf'</span>)</span>
<span class="cs-line hl-c">    <span class="kw">for</span> alpha <span class="kw">in</span> [<span class="num">0.1</span>, <span class="num">0.3</span>, <span class="num">0.5</span>, <span class="num">0.7</span>, <span class="num">0.9</span>]:</span>
<span class="cs-line hl-c">        s = A_stats ** alpha          <span class="cmt"># scale factor</span></span>
<span class="cs-line hl-c">        W_scaled = W * s              <span class="cmt"># scale weights up</span></span>
<span class="cs-line hl-c">        W_q = <span class="fn">quantize</span>(W_scaled, bits)</span>
<span class="cs-line hl-c">        loss = ((W_scaled - W_q) ** <span class="num">2</span>).<span class="fn">mean</span>()</span>
<span class="cs-line hl-c">        <span class="kw">if</span> loss &lt; best_loss:</span>
<span class="cs-line hl-c">            best_loss, best_s = loss, s</span>
<span class="cs-line hl-c">    <span class="kw">return</span> best_s   <span class="cmt"># apply to W &amp; 1/A at runtime</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># SmoothQuant: offline migration</span>
<span class="cs-line cmt"># x̃ = diag(s)^&#123;-1&#125; x  (smooth activation)</span>
<span class="cs-line cmt"># W̃ = W diag(s)      (absorb into weight)</span>
<span class="cs-line cmt"># s_i = max(|x_i|)^α / max(|w_i|)^&#123;1-α&#125;</span>
      </pre>
    </div>

    <!-- qat -->
    <div class="cs-panel" id="panel-qat">
      <pre class="cs-pre">
<span class="cs-line cmt"># Fake-quantize + Straight-Through Estimator</span>
<span class="cs-line"><span class="kw">import</span> torch</span>
<span class="cs-line"><span class="kw">from</span> torch <span class="kw">import</span> Tensor</span>
<span class="cs-line"></span>
<span class="cs-line hl-p"><span class="kw">class</span> <span class="cls">FakeQuantize</span>(torch.autograd.<span class="cls">Function</span>):</span>
<span class="cs-line hl-p">    @staticmethod</span>
<span class="cs-line hl-p">    <span class="kw">def</span> <span class="fn">forward</span>(ctx, x: <span class="cls">Tensor</span>,</span>
<span class="cs-line hl-p">                 scale, zero, bits):</span>
<span class="cs-line hl-p">        qmax = <span class="num">2</span> ** (bits - <span class="num">1</span>) - <span class="num">1</span></span>
<span class="cs-line hl-p">        x_q = (x / scale + zero).<span class="fn">round</span>()</span>
<span class="cs-line hl-p">                  .<span class="fn">clamp</span>(-qmax - <span class="num">1</span>, qmax)</span>
<span class="cs-line hl-p">        x_hat = (x_q - zero) * scale  <span class="cmt"># dequant</span></span>
<span class="cs-line hl-p">        ctx.<span class="fn">save_for_backward</span>(x, x_hat)</span>
<span class="cs-line hl-p">        ctx.scale = scale</span>
<span class="cs-line hl-p">        <span class="kw">return</span> x_hat</span>
<span class="cs-line"></span>
<span class="cs-line hl-g">    @staticmethod</span>
<span class="cs-line hl-g">    <span class="kw">def</span> <span class="fn">backward</span>(ctx, grad_output):</span>
<span class="cs-line hl-g">        x, x_hat = ctx.saved_tensors</span>
<span class="cs-line hl-g">        <span class="cmt"># STE: pass gradient straight through</span></span>
<span class="cs-line hl-g">        <span class="cmt"># where |x| &lt;= scale * qmax</span></span>
<span class="cs-line hl-g">        mask = (x.<span class="fn">abs</span>() &lt;= ctx.scale * <span class="num">127</span>)</span>
<span class="cs-line hl-g">        grad_input = grad_output * mask.<span class="fn">float</span>()</span>
<span class="cs-line hl-g">        <span class="kw">return</span> grad_input, <span class="cls">None</span>, <span class="cls">None</span>, <span class="cls">None</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># QAT training loop (simplified)</span>
<span class="cs-line hl-c"><span class="kw">for</span> step, batch <span class="kw">in</span> <span class="fn">enumerate</span>(loader):</span>
<span class="cs-line hl-c">    logits = <span class="fn">model</span>(batch)    <span class="cmt"># fake-quant inside</span></span>
<span class="cs-line hl-c">    loss = <span class="fn">cross_entropy</span>(logits, batch.labels)</span>
<span class="cs-line hl-c">    loss.<span class="fn">backward</span>()           <span class="cmt"># STE passes grads</span></span>
<span class="cs-line hl-c">    optimizer.<span class="fn">step</span>()          <span class="cmt"># real-valued update</span></span>
<span class="cs-line hl-c">    <span class="cmt"># scales updated via EMA of activation amaxes</span></span>
      </pre>
    </div>

    <!-- hardware -->
    <div class="cs-panel" id="panel-hardware">
      <pre class="cs-pre">
<span class="cs-line cmt"># NVIDIA Transformer Engine — FP8 autocast</span>
<span class="cs-line"><span class="kw">import</span> transformer_engine.pytorch <span class="kw">as</span> te</span>
<span class="cs-line"><span class="kw">from</span> transformer_engine.common.recipe <span class="kw">import</span> \</span>
<span class="cs-line">    DelayedScaling, Format</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Define FP8 recipe</span>
<span class="cs-line hl-p">fp8_recipe = <span class="fn">DelayedScaling</span>(</span>
<span class="cs-line hl-p">    margin=<span class="num">0</span>,</span>
<span class="cs-line hl-p">    interval=<span class="num">1</span>,</span>
<span class="cs-line hl-p">    fp8_format=Format.HYBRID,  <span class="cmt"># E4M3 fwd, E5M2 bwd</span></span>
<span class="cs-line hl-p">    amax_history_len=<span class="num">16</span>,</span>
<span class="cs-line hl-p">    amax_compute_algo=<span class="str">'max'</span>,</span>
<span class="cs-line hl-p">)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Wrap training step</span>
<span class="cs-line hl-c"><span class="kw">with</span> te.<span class="fn">fp8_autocast</span>(enabled=<span class="cls">True</span>,</span>
<span class="cs-line hl-c">                    fp8_recipe=fp8_recipe):</span>
<span class="cs-line hl-c">    output = <span class="fn">model</span>(inputs)    <span class="cmt"># GEMMs run in FP8</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># FP8 format summary:</span>
<span class="cs-line cmt"># E4M3: sign(1) + exp(4) + mantissa(3)</span>
<span class="cs-line cmt">#        max=448, used for fwd weights/activ</span>
<span class="cs-line cmt"># E5M2: sign(1) + exp(5) + mantissa(2)</span>
<span class="cs-line cmt">#        max=57344, used for gradients</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Blackwell nvfp4 (MXFP4):</span>
<span class="cs-line cmt"># E2M1: sign(1)+exp(2)+mantissa(1)=4 bits</span>
<span class="cs-line cmt"># Each 32-element block shares 1 FP8 exponent</span>
<span class="cs-line cmt"># → 4-bit weights + 8-bit block scale</span>
<span class="cs-line cmt"># Throughput: ~2× H100 FP8 on B200</span>
      </pre>
    </div>

    <!-- deploy -->
    <div class="cs-panel" id="panel-deploy">
      <pre class="cs-pre">
<span class="cs-line cmt"># vLLM — FP8 inference (H100)</span>
<span class="cs-line"><span class="kw">from</span> vllm <span class="kw">import</span> LLM, SamplingParams</span>
<span class="cs-line"></span>
<span class="cs-line hl-p">llm = <span class="fn">LLM</span>(</span>
<span class="cs-line hl-p">    model=<span class="str">"meta-llama/Meta-Llama-3.1-70B"</span>,</span>
<span class="cs-line hl-p">    quantization=<span class="str">"fp8"</span>,        <span class="cmt"># W8A8 FP8</span></span>
<span class="cs-line hl-p">    kv_cache_dtype=<span class="str">"fp8"</span>,      <span class="cmt"># also quant KV</span></span>
<span class="cs-line hl-p">    tensor_parallel_size=<span class="num">1</span>,</span>
<span class="cs-line hl-p">)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># bitsandbytes — INT4 load (any GPU)</span>
<span class="cs-line hl-c"><span class="kw">from</span> transformers <span class="kw">import</span> AutoModelForCausalLM</span>
<span class="cs-line hl-c">model = <span class="cls">AutoModelForCausalLM</span>.<span class="fn">from_pretrained</span>(</span>
<span class="cs-line hl-c">    <span class="str">"meta-llama/Meta-Llama-3-8B-Instruct"</span>,</span>
<span class="cs-line hl-c">    load_in_4bit=<span class="cls">True</span>,        <span class="cmt"># NF4 + dq</span></span>
<span class="cs-line hl-c">    bnb_4bit_compute_dtype=torch.bfloat16,</span>
<span class="cs-line hl-c">    bnb_4bit_use_double_quant=<span class="cls">True</span>,</span>
<span class="cs-line hl-c">    device_map=<span class="str">"auto"</span>,</span>
<span class="cs-line hl-c">)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># AWQ — pre-quantized model (W4A16)</span>
<span class="cs-line hl-g"><span class="kw">from</span> awq <span class="kw">import</span> AutoAWQForCausalLM</span>
<span class="cs-line hl-g">model = <span class="cls">AutoAWQForCausalLM</span>.<span class="fn">from_quantized</span>(</span>
<span class="cs-line hl-g">    <span class="str">"TheBloke/Llama-2-70B-AWQ"</span>,</span>
<span class="cs-line hl-g">    fuse_layers=<span class="cls">True</span>,</span>
<span class="cs-line hl-g">)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># llama.cpp (GGUF Q4_K_M) — CPU/Apple</span>
<span class="cs-line cmt"># $ ollama run llama3.1:70b-instruct-q4_K_M</span>
<span class="cs-line cmt"># → runs on 2× M2 Ultra (192 GB RAM)</span>
      </pre>
    </div>

  </div>
</aside>

</div><!-- /post-grid -->

<script>
/* ── TOC + sidebar toggles ────────────────────────────────────── */
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '\u203A' : '\u2039';
});
const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '\u2039' : '\u203A';
});

/* ── Code sidebar tab switching ───────────────────────────────── */
const tabMeta = {
  memory:   { file: 'quant/model_size.py',   title: 'Memory Wall' },
  formats:  { file: 'quant/formats.py',       title: 'Bit Anatomy' },
  taxonomy: { file: 'quant/quant_math.py',    title: 'WXaY Taxonomy' },
  ptq:      { file: 'quant/ptq_methods.py',   title: 'PTQ Methods' },
  qat:      { file: 'quant/qat.py',           title: 'QAT' },
  hardware: { file: 'quant/fp8_hardware.py',  title: 'Hardware' },
  deploy:   { file: 'quant/deployment.py',    title: 'Production Guide' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t =>
    t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p =>
    p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t =>
  t.addEventListener('click', () => activateTab(t.dataset.panel)));

/* ── IntersectionObserver: TOC highlight + sidebar sync ────────── */
const sectionMap = {
  's-memory': 'memory', 's-formats': 'formats', 's-taxonomy': 'taxonomy',
  's-ptq': 'ptq', 's-qat': 'qat', 's-hardware': 'hardware', 's-deploy': 'deploy',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.25 }).observe(s)
);

/* ── Animated bar charts (IntersectionObserver) ─────────────────── */
function animateBarsIn(containerEl) {
  if (!containerEl) return;
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          b.style.width = b.dataset.w + '%';
        });
      }
    });
  }, { threshold: 0.2 }).observe(containerEl);
}
animateBarsIn(document.getElementById('s-memory-bars'));
animateBarsIn(document.getElementById('s-hardware-bars'));
animateBarsIn(document.getElementById('s-deploy-bars'));

/* ── Bit Field Explorer ──────────────────────────────────────────── */
const FORMATS = {
  fp32:    { label:'FP32',     bits:32, sign:1, exp:8,  man:23, type:'f', range:'+/-3.4e38',   prec:'~7 sig. digits' },
  bf16:    { label:'BF16',     bits:16, sign:1, exp:8,  man:7,  type:'f', range:'+/-3.4e38',   prec:'~3 sig. digits' },
  fp16:    { label:'FP16',     bits:16, sign:1, exp:5,  man:10, type:'f', range:'+/-65504',     prec:'~3-4 sig. digits' },
  fp8e4m3: { label:'FP8 E4M3', bits:8,  sign:1, exp:4,  man:3,  type:'f', range:'+/-448',      prec:'~2 sig. digits' },
  fp8e5m2: { label:'FP8 E5M2', bits:8,  sign:1, exp:5,  man:2,  type:'f', range:'+/-57344',    prec:'~1 sig. digit' },
  int8:    { label:'INT8',     bits:8,  sign:0, exp:0,  man:0,  type:'i', range:'[-128, 127]',  prec:'uniform steps' },
  int4:    { label:'INT4',     bits:4,  sign:0, exp:0,  man:0,  type:'i', range:'[-8, 7]',      prec:'uniform steps' },
  fp4e2m1: { label:'FP4 E2M1', bits:4,  sign:1, exp:2,  man:1,  type:'f', range:'+/-6.0',      prec:'~1 sig. digit' },
};

const bitCanvas = document.getElementById('bit-canvas');
if (bitCanvas) {
  const bCtx = bitCanvas.getContext('2d');
  let curFmt = 'fp32';
  const DPR = window.devicePixelRatio || 1;

  function resizeBitCanvas() {
    const W = bitCanvas.clientWidth;
    const H = 130;
    bitCanvas.width = W * DPR; bitCanvas.height = H * DPR;
    bCtx.scale(DPR, DPR);
    drawBits(W, H, FORMATS[curFmt]);
  }

  function drawBits(W, H, fmt) {
    bCtx.clearRect(0, 0, W, H);
    const GAP = 2;
    const BIT_H = 40;
    const maxBits = 32;
    const cellW = Math.floor((W - 32) / maxBits) - GAP;
    const totalW = fmt.bits * (cellW + GAP) - GAP;
    const startX = Math.round((W - totalW) / 2);
    const startY = 42;

    bCtx.font = '600 10px monospace';
    bCtx.textAlign = 'center';

    if (fmt.type === 'f') {
      // Sign group label
      if (fmt.sign > 0) {
        const sx = startX;
        const ex = startX + fmt.sign * (cellW + GAP) - GAP;
        bCtx.fillStyle = 'rgba(245,158,11,0.7)';
        bCtx.fillRect(sx, startY - 18, ex - sx + 1, 2);
        bCtx.fillStyle = 'rgba(245,158,11,0.8)';
        bCtx.fillText('S', sx + (ex - sx) / 2, startY - 21);
      }
      // Exp group label
      const expSx = startX + fmt.sign * (cellW + GAP);
      const expEx = expSx + fmt.exp * (cellW + GAP) - GAP;
      bCtx.fillStyle = 'rgba(139,92,246,0.7)';
      bCtx.fillRect(expSx, startY - 18, expEx - expSx + 1, 2);
      bCtx.fillStyle = 'rgba(139,92,246,0.8)';
      bCtx.fillText('EXP (' + fmt.exp + 'b)', expSx + (expEx - expSx) / 2, startY - 21);
      // Mantissa group label
      const manSx = expEx + GAP;
      const manEx = startX + totalW;
      if (fmt.man > 0) {
        bCtx.fillStyle = 'rgba(6,182,212,0.7)';
        bCtx.fillRect(manSx, startY - 18, manEx - manSx + 1, 2);
        bCtx.fillStyle = 'rgba(6,182,212,0.7)';
        bCtx.fillText('MANTISSA (' + fmt.man + 'b)', manSx + (manEx - manSx) / 2, startY - 21);
      }
    } else {
      bCtx.fillStyle = 'rgba(107,114,128,0.7)';
      bCtx.fillRect(startX, startY - 18, totalW, 2);
      bCtx.fillStyle = 'rgba(107,114,128,0.8)';
      bCtx.fillText('INTEGER MAGNITUDE (' + fmt.bits + ' bits)', startX + totalW / 2, startY - 21);
    }

    // Draw individual bit boxes
    for (let i = 0; i < fmt.bits; i++) {
      const x = startX + i * (cellW + GAP);
      let fill, stroke;
      if (fmt.type === 'i') {
        fill = i === 0 ? 'rgba(107,114,128,0.75)' : 'rgba(107,114,128,0.45)';
        stroke = 'rgba(255,255,255,0.12)';
      } else if (i < fmt.sign) {
        fill = 'rgba(245,158,11,0.8)';
        stroke = 'rgba(245,158,11,0.4)';
      } else if (i < fmt.sign + fmt.exp) {
        fill = 'rgba(139,92,246,0.7)';
        stroke = 'rgba(139,92,246,0.4)';
      } else {
        fill = 'rgba(6,182,212,0.65)';
        stroke = 'rgba(6,182,212,0.35)';
      }
      bCtx.fillStyle = fill;
      bCtx.beginPath();
      bCtx.roundRect(x, startY, cellW, BIT_H, 3);
      bCtx.fill();
      bCtx.strokeStyle = stroke;
      bCtx.lineWidth = 1;
      bCtx.stroke();
    }

    // Stats row
    const statsY = startY + BIT_H + 18;
    bCtx.font = '600 11px monospace';
    bCtx.textAlign = 'center';
    bCtx.fillStyle = '#f0f0f8';
    bCtx.fillText(fmt.label, W / 2, statsY);
    bCtx.font = '500 10px monospace';
    bCtx.fillStyle = '#6b7280';
    bCtx.fillText('Range: ' + fmt.range, W * 0.28, statsY + 16);
    bCtx.fillText('Precision: ' + fmt.prec, W * 0.72, statsY + 16);
  }

  resizeBitCanvas();
  window.addEventListener('resize', () => {
    bitCanvas.style.width = '100%';
    resizeBitCanvas();
  });

  document.querySelectorAll('.fmt-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.fmt-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      curFmt = btn.dataset.fmt;
      const W = bitCanvas.clientWidth;
      bCtx.setTransform(1, 0, 0, 1, 0, 0);
      const H = 130;
      bitCanvas.width = W * DPR; bitCanvas.height = H * DPR;
      bCtx.scale(DPR, DPR);
      drawBits(W, H, FORMATS[curFmt]);
    });
  });
}

/* ── Quantization Error Canvas ────────────────────────────────── */
const quantCanvas = document.getElementById('quant-canvas');
if (quantCanvas) {
  const qCtx = quantCanvas.getContext('2d');
  let qBits = 4;
  const DPR = window.devicePixelRatio || 1;

  function resizeQuantCanvas() {
    const W = quantCanvas.clientWidth;
    const H = 180;
    quantCanvas.width = W * DPR; quantCanvas.height = H * DPR;
    qCtx.scale(DPR, DPR);
    drawQuant(W, H, qBits);
  }

  function drawQuant(W, H, bits) {
    qCtx.clearRect(0, 0, W, H);
    const PAD = 20;
    const DIVX = W / 2;
    const yMid = H / 2;
    const yAmp = (H - PAD * 2) / 2 - 6;
    const N = 200;
    const levels = Math.pow(2, bits) - 1;

    // Background labels
    qCtx.font = '600 10px monospace';
    qCtx.textAlign = 'center';
    qCtx.fillStyle = 'rgba(6,182,212,0.6)';
    qCtx.fillText('ORIGINAL', DIVX / 2, PAD - 4);
    qCtx.fillStyle = bits >= 6 ? 'rgba(16,185,129,0.7)' :
                     bits >= 3 ? 'rgba(245,158,11,0.7)' : 'rgba(239,68,68,0.7)';
    qCtx.fillText('QUANTIZED (INT' + bits + ')', DIVX + DIVX / 2, PAD - 4);

    // Divider
    qCtx.strokeStyle = 'rgba(255,255,255,0.12)';
    qCtx.setLineDash([4, 4]);
    qCtx.lineWidth = 1;
    qCtx.beginPath(); qCtx.moveTo(DIVX, 8); qCtx.lineTo(DIVX, H - 8); qCtx.stroke();
    qCtx.setLineDash([]);

    // Draw original smooth curve (left half)
    qCtx.strokeStyle = 'rgba(6,182,212,0.85)';
    qCtx.lineWidth = 2;
    qCtx.beginPath();
    for (let i = 0; i <= N; i++) {
      const t = i / N;
      const x = PAD + t * (DIVX - PAD * 2);
      const y = yMid - yAmp * Math.sin(t * Math.PI * 4);
      i === 0 ? qCtx.moveTo(x, y) : qCtx.lineTo(x, y);
    }
    qCtx.stroke();

    // Draw quantized staircase (right half)
    const qColor = bits >= 6 ? 'rgba(16,185,129,0.85)' :
                   bits >= 3 ? 'rgba(245,158,11,0.85)' : 'rgba(239,68,68,0.85)';
    qCtx.strokeStyle = qColor;
    qCtx.lineWidth = 2;
    qCtx.beginPath();
    let prevQy = null;
    for (let i = 0; i <= N; i++) {
      const t = i / N;
      const x = DIVX + PAD + t * (DIVX - PAD * 2);
      const rawVal = Math.sin(t * Math.PI * 4);
      const qVal = Math.round(rawVal * levels / 2) / (levels / 2);
      const y = yMid - yAmp * qVal;
      if (i === 0) {
        qCtx.moveTo(x, y);
        prevQy = y;
      } else {
        qCtx.lineTo(x, prevQy);  // horizontal
        qCtx.lineTo(x, y);       // vertical step
        prevQy = y;
      }
    }
    qCtx.stroke();

    // Step count label
    qCtx.font = '500 10px monospace';
    qCtx.fillStyle = qColor;
    qCtx.textAlign = 'center';
    qCtx.fillText((levels + 1) + ' levels', DIVX + DIVX / 2, H - 6);
  }

  resizeQuantCanvas();
  window.addEventListener('resize', () => {
    quantCanvas.style.width = '100%';
    resizeQuantCanvas();
  });

  document.querySelectorAll('.qbits-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.qbits-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      qBits = parseInt(btn.dataset.bits);
      const W = quantCanvas.clientWidth;
      qCtx.setTransform(1, 0, 0, 1, 0, 0);
      const H = 180;
      quantCanvas.width = W * DPR; quantCanvas.height = H * DPR;
      qCtx.scale(DPR, DPR);
      drawQuant(W, H, qBits);
    });
  });
}

/* ── Architecture SVG scheme switcher ────────────────────────── */
const archSchemes = {
  fp8: {
    qkv:  { fill: 'rgba(16,185,129,0.15)',  stroke: 'rgba(16,185,129,0.5)',  text: '#10b981', label: 'Q/K/V proj (FP8 E4M3)' },
    ffn:  { fill: 'rgba(16,185,129,0.15)',  stroke: 'rgba(16,185,129,0.5)',  text: '#10b981', label: 'FFN (FP8 E4M3)' },
    oproj:{ fill: 'rgba(16,185,129,0.15)',  stroke: 'rgba(16,185,129,0.5)',  text: '#10b981', label: 'O proj (FP8)' },
    attn: { fill: 'rgba(6,182,212,0.12)',   stroke: 'rgba(6,182,212,0.35)',  text: '#06b6d4', label: 'Attn (softmax FP32)' },
  },
  w4a8: {
    qkv:  { fill: 'rgba(245,158,11,0.15)',  stroke: 'rgba(245,158,11,0.5)',  text: '#f59e0b', label: 'Q/K/V proj (W4A8)' },
    ffn:  { fill: 'rgba(245,158,11,0.15)',  stroke: 'rgba(245,158,11,0.5)',  text: '#f59e0b', label: 'FFN (W4A8)' },
    oproj:{ fill: 'rgba(245,158,11,0.15)',  stroke: 'rgba(245,158,11,0.5)',  text: '#f59e0b', label: 'O proj (W4A8)' },
    attn: { fill: 'rgba(6,182,212,0.12)',   stroke: 'rgba(6,182,212,0.35)',  text: '#06b6d4', label: 'Attn (FP16)' },
  },
  w8a8: {
    qkv:  { fill: 'rgba(139,92,246,0.15)',  stroke: 'rgba(139,92,246,0.5)',  text: '#8b5cf6', label: 'Q/K/V proj (W8A8 INT8)' },
    ffn:  { fill: 'rgba(139,92,246,0.15)',  stroke: 'rgba(139,92,246,0.5)',  text: '#8b5cf6', label: 'FFN (W8A8 INT8)' },
    oproj:{ fill: 'rgba(139,92,246,0.15)',  stroke: 'rgba(139,92,246,0.5)',  text: '#8b5cf6', label: 'O proj (INT8)' },
    attn: { fill: 'rgba(6,182,212,0.12)',   stroke: 'rgba(6,182,212,0.35)',  text: '#06b6d4', label: 'Attn (FP16)' },
  },
  w4a16: {
    qkv:  { fill: 'rgba(236,72,153,0.15)',  stroke: 'rgba(236,72,153,0.5)',  text: '#ec4899', label: 'Q/K/V proj (W4A16)' },
    ffn:  { fill: 'rgba(236,72,153,0.15)',  stroke: 'rgba(236,72,153,0.5)',  text: '#ec4899', label: 'FFN (W4A16)' },
    oproj:{ fill: 'rgba(236,72,153,0.15)',  stroke: 'rgba(236,72,153,0.5)',  text: '#ec4899', label: 'O proj (W4A16)' },
    attn: { fill: 'rgba(6,182,212,0.12)',   stroke: 'rgba(6,182,212,0.35)',  text: '#06b6d4', label: 'Attn (FP16)' },
  },
};

function applyArchScheme(schemeName) {
  const s = archSchemes[schemeName];
  if (!s) return;

  // Update QKV boxes
  ['arch-q','arch-k','arch-v'].forEach(id => {
    const el = document.getElementById(id);
    if (el) { el.setAttribute('fill', s.qkv.fill); el.setAttribute('stroke', s.qkv.stroke); }
  });
  document.querySelectorAll('.arch-qkv-label').forEach(el => {
    el.setAttribute('fill', s.qkv.text);
  });

  // Update O proj
  const archO = document.getElementById('arch-o');
  if (archO) { archO.setAttribute('fill', s.oproj.fill); archO.setAttribute('stroke', s.oproj.stroke); }
  document.querySelectorAll('.arch-o-label').forEach(el => el.setAttribute('fill', s.oproj.text));

  // Update FFN
  ['arch-up','arch-gate','arch-down'].forEach(id => {
    const el = document.getElementById(id);
    if (el) { el.setAttribute('fill', s.ffn.fill); el.setAttribute('stroke', s.ffn.stroke); }
  });
  document.querySelectorAll('.arch-ffn-label').forEach(el => el.setAttribute('fill', s.ffn.text));

  // Update attention label
  const archAttn = document.getElementById('arch-attn');
  const archAttnLbl = document.getElementById('arch-attn-label');
  if (archAttn) { archAttn.setAttribute('fill', s.attn.fill); archAttn.setAttribute('stroke', s.attn.stroke); }
  if (archAttnLbl) { archAttnLbl.setAttribute('fill', s.attn.text); archAttnLbl.textContent = s.attn.label; }
}

applyArchScheme('fp8');

document.querySelectorAll('.arch-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.arch-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    applyArchScheme(btn.dataset.scheme);
  });
});
</script>

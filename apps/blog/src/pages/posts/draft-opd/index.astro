<span class="cs-line">    total_w = <span class="num">0.0</span></span>
<span class="cs-line">    <span class="kw">for</span> q_log, p_log, k <span class="kw">in</span> <span class="fn">zip</span>(q_logits, p_logits, positions):</span>

<span class="cs-line hl-g">    <span class="str">"MATH-500"</span>: &#123;<span class="str">"EAGLE3"</span>: <span class="num">4.15</span>, <span class="str">"DFlash"</span>: <span class="num">4.88</span>, <span class="str">"Draft-OPD"</span>: <span class="num">5.55</span>&#125;,</span>
<span class="cs-line hl-g">    <span class="str">"HumanEval"</span>:&#123;<span class="str">"EAGLE3"</span>: <span class="num">4.38</span>, <span class="str">"DFlash"</span>: <span class="num">4.77</span>, <span class="str">"Draft-OPD"</span>: <span class="num">5.17</span>&#125;,</span>
<span class="cs-line hl-g">    <span class="str">"MT-Bench"</span>: &#123;<span class="str">"EAGLE3"</span>: <span class="num">3.87</span>, <span class="str">"DFlash"</span>: <span class="num">4.33</span>, <span class="str">"Draft-OPD"</span>: <span class="num">4.86</span>&#125;</span>

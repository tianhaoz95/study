---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { postReadTime } from '../../../lib/readTimes';
const readTime = postReadTime('draft-opd');
---
<BaseLayout
  title="Draft-OPD: On-Policy Distillation for Speculative Draft Models | Catpuccino.ai"
  description="Supervised fine-tuning of speculative draft models plateaus due to offline-to-inference mismatch. Draft-OPD uses anchored rollouts, error-position replay, and acceptance-aware asymmetric KL to post-train drafters on verification-time errors, yielding 5x+ speedups."
  crumb="Draft-OPD"
>


---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="DreamReasoner-8B: Block-Size Curriculum for Diffusion Reasoning | Catpuccino.ai"
  description="Block diffusion LLMs promise parallel token generation but collapse on reasoning with large blocks. DreamReasoner-8B uses block-size curriculum learning — train fine-to-coarse — to match Qwen3-8B-Thinking while gaining 3× parallel decoding efficiency."
  crumb="DreamReasoner"
>


    <div class="cs-panel" id="panel-relaxed">
      <pre class="cs-pre">
<span class="cs-line cmt"># RelaxedConfidence decoding</span>
<span class="cs-line cmt"># Lowers per-token threshold when neighbors are stable</span>
<span class="cs-line"></span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">relaxed_threshold</span>(i, conf, decoded, tau=<span class="num">0.95</span>,</span>
<span class="cs-line hl-p">                      tau_min=<span class="num">0.7</span>, r=<span class="num">3</span>, kappa=<span class="num">0.8</span>):</span>
<span class="cs-line hl-p">    <span class="cmt"># Reliable neighbors: decoded OR high-conf</span></span>
<span class="cs-line hl-p">    R = decoded | &#123;j <span class="kw">for</span> j <span class="kw">in</span> <span class="fn">range</span>(<span class="fn">len</span>(conf))</span>
<span class="cs-line hl-p">                  <span class="kw">if</span> conf[j] &gt;= kappa&#125;</span>
<span class="cs-line hl-p">    Nr = &#123;j <span class="kw">for</span> j <span class="kw">in</span> <span class="fn">range</span>(<span class="fn">len</span>(conf))</span>
<span class="cs-line hl-p">          <span class="kw">if</span> <span class="num">0</span> &lt; <span class="fn">abs</span>(i-j) &lt;= r&#125;</span>
<span class="cs-line hl-p">    <span class="cmt"># Proximity-weighted support score</span></span>
<span class="cs-line hl-c">    weights = &#123;j: r - <span class="fn">abs</span>(i-j) + <span class="num">1</span> <span class="kw">for</span> j <span class="kw">in</span> Nr&#125;</span>
<span class="cs-line hl-c">    Si = (<span class="fn">sum</span>(weights[j] <span class="kw">for</span> j <span class="kw">in</span> Nr &amp; R)</span>
<span class="cs-line hl-c">          / <span class="fn">sum</span>(weights.values()))</span>
<span class="cs-line hl-c">    <span class="kw">return</span> tau - (tau - tau_min) * Si</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># TPF gains (RelaxedConf vs LowConf, B=32):</span>
<span class="cs-line cmt"># Thinking phase:</span>
<span class="cs-line hl-g"><span class="cmt">#   AIME25:  2.1 → 2.8 TPF  (+33%)</span></span>
<span class="cs-line hl-g"><span class="cmt">#   CodeBench: 1.7 → 1.9 TPF (+12%)</span></span>
<span class="cs-line cmt"># Answering phase:</span>

<span class="cs-line"></span>
<span class="cs-line hl-c"><span class="kw">def</span> <span class="fn">diffusion_generate</span>(model, prompt, n, steps):</span>
<span class="cs-line hl-c">    x = [MASK] * n  <span class="cmt"># start fully masked</span></span>
<span class="cs-line hl-c">    <span class="kw">for</span> t <span class="kw">in</span> <span class="fn">range</span>(steps):  <span class="cmt"># &lt;&lt; n forward passes</span></span>
<span class="cs-line hl-c">        logits = model(prompt + x)</span>
<span class="cs-line hl-c">        x = <span class="fn">unmask_high_conf</span>(x, logits)</span>
<span class="cs-line hl-c">    <span class="kw">return</span> x  <span class="cmt"># TPF = n/steps >> 1</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Problem: full-sequence diffusion loses</span>
<span class="cs-line cmt"># sequential coherence for long CoT</span>
<span class="cs-line cmt"># → block diffusion is the solution</span>

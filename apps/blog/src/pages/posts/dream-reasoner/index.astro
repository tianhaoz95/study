    <div class="cs-panel" id="panel-blockdiff">
      <pre class="cs-pre">
<span class="cs-line cmt"># Block diffusion training objective</span>
<span class="cs-line cmt"># Weighted cross-entropy on masked positions</span>
<span class="cs-line"></span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">block_diffusion_loss</span>(model, x0, B):</span>
<span class="cs-line hl-p">    <span class="cmt"># Partition sequence into K blocks of size B</span></span>
<span class="cs-line hl-p">    blocks = <span class="fn">partition</span>(x0, block_size=B)</span>
<span class="cs-line hl-p">    loss = <span class="num">0</span></span>
<span class="cs-line hl-p">    <span class="kw">for</span> k, block <span class="kw">in</span> <span class="fn">enumerate</span>(blocks):</span>
<span class="cs-line hl-p">        prefix = blocks[:k]  <span class="cmt"># clean context</span></span>
<span class="cs-line hl-p">        t = <span class="fn">uniform</span>(<span class="num">0</span>, <span class="num">1</span>)</span>
<span class="cs-line hl-p">        xt = <span class="fn">corrupt</span>(block, t)  <span class="cmt"># mask tokens</span></span>
<span class="cs-line hl-p">        logits = <span class="fn">model</span>(prefix, xt)  <span class="cmt"># bidirectional</span></span>
<span class="cs-line hl-p">        loss += <span class="fn">cross_entropy</span>(logits, block)</span>
<span class="cs-line hl-p">    <span class="kw">return</span> loss</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Block size B controls the trade-off:</span>
<span class="cs-line cmt"># B=1  → pure AR (TPF=1, max accuracy)</span>
<span class="cs-line cmt"># B=4  → fine-grained parallel (TPF≈1.6)</span>
<span class="cs-line cmt"># B=16 → medium (TPF≈2.1)</span>
<span class="cs-line cmt"># B=32 → coarse-grained (TPF≈2.4)</span>
<span class="cs-line cmt"># B=N  → pure diffusion (max TPF)</span>
<span class="cs-line"></span>
<span class="cs-line hl-c"><span class="cmt"># Tokens per forward pass (TPF)</span></span>
<span class="cs-line hl-c">TPF = generated_tokens / total_forward_passes</span>
<span class="cs-line hl-c"><span class="cmt"># AR: TPF=1. Block B=32: TPF≈2.4</span></span>

    <div class="cs-panel" id="panel-curriculum">
      <pre class="cs-pre">
<span class="cs-line cmt"># Block-size curriculum learning for SFT</span>
<span class="cs-line"></span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">curriculum_train</span>(base_model, data):</span>
<span class="cs-line hl-p">    model = base_model  <span class="cmt"># DreamReasoner-8B-Base</span></span>
<span class="cs-line"></span>
<span class="cs-line hl-c">    <span class="cmt"># Phase 1: fine-grained anchoring</span></span>
<span class="cs-line hl-c">    model = <span class="fn">sft</span>(model, data,</span>
<span class="cs-line hl-c">                block_size=<span class="num">4</span>,     <span class="cmt"># always B=4</span></span>
<span class="cs-line hl-c">                context_len=<span class="num">16384</span>)</span>
<span class="cs-line hl-c">    <span class="cmt"># Builds: tight local causal dependencies</span></span>
<span class="cs-line hl-c">    <span class="cmt"># Result: reliable CoT under fine-grained decode</span></span>
<span class="cs-line"></span>
<span class="cs-line hl-g">    <span class="cmt"># Phase 2: mixed-granularity expansion</span></span>
<span class="cs-line hl-g">    block_sizes = [<span class="num">4</span>, <span class="num">8</span>, <span class="num">16</span>, <span class="num">32</span>]</span>
<span class="cs-line hl-g">    model = <span class="fn">sft</span>(model, data,</span>
<span class="cs-line hl-g">                block_size=<span class="fn">random_choice</span>(block_sizes),</span>
<span class="cs-line hl-g">                context_len=<span class="num">16384</span>)</span>
<span class="cs-line hl-g">    <span class="cmt"># Builds: coarse-grained parallel decoding</span></span>
<span class="cs-line hl-g">    <span class="cmt"># Retains: fine-grained reasoning from phase 1</span></span>
<span class="cs-line"></span>
<span class="cs-line">    <span class="kw">return</span> model  <span class="cmt"># robust to any inference B</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Result — AIME 2024 (LowConf decode):</span>
<span class="cs-line cmt"># Curriculum B=4 inf: 50.0%  ← best!</span>
<span class="cs-line cmt"># Curriculum B=32 inf: 48.3% ← stable</span>
<span class="cs-line cmt"># vs fixed B=4 → B=32 inf: 42.5%</span>
      </pre>

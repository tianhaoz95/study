<script>
// ── TOC + sidebar toggles ──────────────────────────────────────
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});

const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ── Code sidebar tab switching ─────────────────────────────────
const tabMeta = {
  problem:    { file: 'dream_reasoner/problem.py',    title: 'The Parallelism Trap' },
  blockdiff:  { file: 'dream_reasoner/block_diff.py', title: 'Block Diffusion' },
  collapse:   { file: 'dream_reasoner/collapse.py',   title: 'Granularity Collapse' },
  curriculum: { file: 'dream_reasoner/curriculum.py', title: 'Curriculum Training' },
  relaxed:    { file: 'dream_reasoner/relaxed.py',    title: 'RelaxedConfidence' },
  results:    { file: 'dream_reasoner/results.py',    title: 'Results' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ── IntersectionObserver — sync TOC + sidebar on scroll ────────
const sectionMap = {
  's-problem':    'problem',
  's-blockdiff':  'blockdiff',
  's-collapse':   'collapse',
  's-curriculum': 'curriculum',
  's-relaxed':    'relaxed',
  's-results':    'results',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ── Canvas §01: AR vs Diffusion trade-off ─────────────────────
(function() {
  const canvas = document.getElementById('canvas-tradeoff');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 200;
  canvas.width = W * DPR; canvas.height = H * DPR;
  const ctx = canvas.getContext('2d');
  ctx.scale(DPR, DPR);

  function draw() {
    ctx.clearRect(0, 0, W, H);
    // Background
    ctx.fillStyle = 'rgba(20,20,36,0.5)';
    ctx.fillRect(0, 0, W, H);

    // Two sides: AR (left) and Diffusion (right)
    const midX = W / 2;

    // ── AR side (left): show serial generation ──
    const arTokens = 8;
    const tokenW = Math.min(36, (midX - 40) / arTokens - 6);
    const tokenH = 24;
    const startY = H / 2 - tokenH / 2;

    // Label
    ctx.font = `600 11px var(--ff-mono, monospace)`;
    ctx.fillStyle = '#6b7280';
    ctx.textAlign = 'center';
    ctx.fillText('AUTOREGRESSIVE', midX / 2, 22);
    ctx.fillStyle = '#5c6370';
    ctx.font = '10px var(--ff-mono, monospace)';
    ctx.fillText('TPF = 1.0  (1 token / pass)', midX / 2, 36);

    const arStartX = 20;
    for (let i = 0; i < arTokens; i++) {
      const x = arStartX + i * (tokenW + 6);
      const done = i < 5;
      ctx.fillStyle = done ? 'rgba(139,92,246,0.6)' : 'rgba(255,255,255,0.05)';
      ctx.strokeStyle = done ? '#8b5cf6' : '#374151';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.roundRect(x, startY, tokenW, tokenH, 4);
      ctx.fill();
      ctx.stroke();

      if (done) {
        ctx.fillStyle = '#f0f0f8';
        ctx.font = `600 9px var(--ff-mono, monospace)`;
        ctx.textAlign = 'center';
        ctx.fillText('t' + (i + 1), x + tokenW / 2, startY + 16);
      } else if (i === 5) {
        // Arrow indicating current
        ctx.fillStyle = '#f59e0b';
        ctx.font = '14px sans-serif';
        ctx.fillText('↓', x + tokenW / 2, startY - 4);
      }
    }

    // "1 pass at a time" annotation
    ctx.fillStyle = '#f59e0b';
    ctx.font = '10px var(--ff-mono, monospace)';
    ctx.textAlign = 'center';
    ctx.fillText('← one pass →', arStartX + 4 * (tokenW + 6) + tokenW / 2, startY + tokenH + 16);

    // ── Divider ──
    ctx.strokeStyle = 'rgba(255,255,255,0.06)';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(midX, 10);
    ctx.lineTo(midX, H - 10);
    ctx.stroke();

    // ── Diffusion side (right): show parallel unmasking ──
    const diffTokens = 8;
    const diffStartX = midX + 20;
    const dtW = Math.min(36, (W - midX - 40) / diffTokens - 6);

    ctx.font = `600 11px var(--ff-mono, monospace)`;
    ctx.fillStyle = '#6b7280';
    ctx.textAlign = 'center';
    ctx.fillText('BLOCK DIFFUSION', midX + (W - midX) / 2, 22);
    ctx.fillStyle = '#5c6370';
    ctx.font = '10px var(--ff-mono, monospace)';
    ctx.fillText('TPF = 2.4×  (B=32)', midX + (W - midX) / 2, 36);

    for (let i = 0; i < diffTokens; i++) {
      const x = diffStartX + i * (dtW + 6);
      const committed = i < 3 || i === 5 || i === 7;
      ctx.fillStyle = committed ? 'rgba(6,182,212,0.6)' : 'rgba(139,92,246,0.25)';
      ctx.strokeStyle = committed ? '#06b6d4' : '#8b5cf6';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.roundRect(x, startY, dtW, tokenH, 4);
      ctx.fill();
      ctx.stroke();

      ctx.fillStyle = committed ? '#f0f0f8' : '#8b5cf6';
      ctx.font = committed ? '600 9px var(--ff-mono, monospace)' : '10px sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText(committed ? 't' + (i + 1) : '?', x + dtW / 2, startY + 16);
    }

    // Bracket showing "one pass" commits many
    ctx.strokeStyle = '#06b6d4';
    ctx.lineWidth = 1.5;
    const bx1 = diffStartX, bx2 = diffStartX + 7 * (dtW + 6) + dtW;
    const by = startY + tokenH + 10;
    ctx.beginPath();
    ctx.moveTo(bx1, by); ctx.lineTo(bx1, by + 6);
    ctx.moveTo(bx1, by + 6); ctx.lineTo(bx2, by + 6);
    ctx.moveTo(bx2, by + 6); ctx.lineTo(bx2, by);
    ctx.stroke();
    ctx.fillStyle = '#06b6d4';
    ctx.font = '10px var(--ff-mono, monospace)';
    ctx.textAlign = 'center';
    ctx.fillText('one pass commits many tokens', (bx1 + bx2) / 2, by + 20);
  }

  draw();
  window.addEventListener('resize', () => {
    const newW = canvas.clientWidth;
    canvas.width = newW * DPR;
    canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
    draw();
  });
})();

// ── Canvas §02: Block diffusion structure ─────────────────────
(function() {
  const canvas = document.getElementById('canvas-blockdiff');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  let currentBS = 4;

  function resizeAndDraw() {
    const W = canvas.clientWidth;
    const H = 160;
    canvas.width = W * DPR;
    canvas.height = H * DPR;
    const ctx = canvas.getContext('2d');
    ctx.scale(DPR, DPR);
    drawBlocks(ctx, W, H, currentBS);
  }

  function drawBlocks(ctx, W, H, bs) {
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = 'rgba(20,20,36,0.4)';
    ctx.fillRect(0, 0, W, H);

    const totalTokens = 32;
    const numBlocks = totalTokens / bs;
    const pad = 12;
    const totalW = W - 2 * pad;
    const blockW = totalW / numBlocks;
    const tokenW = blockW / bs - 2;
    const rowY = H / 2 - 18;

    const colors = ['rgba(139,92,246,0.7)', 'rgba(6,182,212,0.6)', 'rgba(16,185,129,0.6)', 'rgba(245,158,11,0.6)',
                    'rgba(239,68,68,0.6)', 'rgba(168,85,247,0.7)', 'rgba(59,130,246,0.6)', 'rgba(20,184,166,0.6)'];
    const borderColors = ['#8b5cf6', '#06b6d4', '#10b981', '#f59e0b', '#ef4444', '#a855f7', '#3b82f6', '#14b8a6'];

    for (let b = 0; b < numBlocks; b++) {
      const blockX = pad + b * blockW;
      // Block background
      ctx.fillStyle = colors[b % colors.length].replace('0.7', '0.1').replace('0.6', '0.08');
      ctx.strokeStyle = borderColors[b % borderColors.length];
      ctx.lineWidth = 1;
      ctx.beginPath();
      if (typeof ctx.roundRect === 'function') {
        ctx.roundRect(blockX + 2, rowY, blockW - 4, 36, 5);
      } else {
        ctx.rect(blockX + 2, rowY, blockW - 4, 36);
      }
      ctx.fill();
      ctx.stroke();

      // Tokens within block
      for (let t = 0; t < bs; t++) {
        const tokenX = blockX + 2 + t * (blockW - 4) / bs + 2;
        const tW = (blockW - 8) / bs;
        ctx.fillStyle = colors[b % colors.length];
        ctx.beginPath();
        if (typeof ctx.roundRect === 'function') {
          ctx.roundRect(tokenX, rowY + 7, Math.max(tW, 4), 22, 3);
        } else {
          ctx.rect(tokenX, rowY + 7, Math.max(tW, 4), 22);
        }
        ctx.fill();
      }

      // Block label
      if (blockW > 30) {
        ctx.fillStyle = '#abb2bf';
        ctx.font = `600 9px var(--ff-mono, monospace)`;
        ctx.textAlign = 'center';
        ctx.fillText('B' + (b + 1), blockX + blockW / 2, rowY - 5);
      }
    }

    // AR arrows between blocks
    if (numBlocks > 1 && blockW > 20) {
      ctx.strokeStyle = 'rgba(245,158,11,0.6)';
      ctx.lineWidth = 1.5;
      for (let b = 0; b < numBlocks - 1; b++) {
        const x1 = pad + (b + 1) * blockW - 4;
        const x2 = pad + (b + 1) * blockW + 4;
        const y = rowY + 18;
        ctx.beginPath();
        ctx.moveTo(x1, y);
        ctx.lineTo(x2, y);
        // Arrowhead
        ctx.moveTo(x2 - 4, y - 3);
        ctx.lineTo(x2, y);
        ctx.lineTo(x2 - 4, y + 3);
        ctx.stroke();
      }
    }

    // Info line
    const infoEl = document.getElementById('block-info');
    if (infoEl) {
      const tpfMap = { 1: '1.0', 4: '1.6', 8: '1.9', 16: '2.1', 32: '2.4' };
      const qualMap = { 1: 'pure AR (max quality)', 4: 'fine-grained parallel', 8: 'medium parallel', 16: 'coarse parallel', 32: 'max parallel' };
      infoEl.innerHTML = `B=${bs}: ${numBlocks} blocks × ${bs} tokens — TPF ≈ ${tpfMap[bs] || '?'}× | ${qualMap[bs] || ''}`;
    }
  }

  document.querySelectorAll('#block-size-btns .bsz-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('#block-size-btns .bsz-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentBS = parseInt(btn.dataset.bs);
      resizeAndDraw();
    });
  });

  resizeAndDraw();
  window.addEventListener('resize', resizeAndDraw);
})();

// ── Canvas §03: Granularity collapse ─────────────────────────
(function() {
  const canvas = document.getElementById('canvas-collapse');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;

  // Data: [infer_B4, infer_B32] for each training config (LowConf decoding, AIME 2024)
  const data = {
    '4':    { b4: 47.1, b32: 42.5, label: 'Trained B=4 (fine-grained)', color: '#8b5cf6' },
    '32':   { b4: 20.0, b32: 42.5, label: 'Trained B=32 (large block)', color: '#ef4444' },
    'curr': { b4: 50.0, b32: 48.3, label: 'Curriculum 4→32',            color: '#10b981' },
  };
  let currentTrain = '4';

  function resizeAndDraw() {
    const W = canvas.clientWidth, H = 200;
    canvas.width = W * DPR; canvas.height = H * DPR;
    const ctx = canvas.getContext('2d');
    ctx.scale(DPR, DPR);
    drawCollapse(ctx, W, H, currentTrain);
  }

  function drawCollapse(ctx, W, H, trainKey) {
    ctx.clearRect(0, 0, W, H);
    const d = data[trainKey];
    const pad = 30, barW = Math.min(80, (W - 100) / 4), gap = 40;
    const maxVal = 55, chartH = H - 70;
    const chartTop = 30;

    // Axis
    ctx.strokeStyle = 'rgba(255,255,255,0.1)';
    ctx.lineWidth = 1;
    [10, 20, 30, 40, 50].forEach(v => {
      const y = chartTop + chartH * (1 - v / maxVal);
      ctx.beginPath();
      ctx.moveTo(pad, y);
      ctx.lineTo(W - pad, y);
      ctx.stroke();
      ctx.fillStyle = '#4b5563';
      ctx.font = '9px var(--ff-mono, monospace)';
      ctx.textAlign = 'right';
      ctx.fillText(v + '%', pad - 5, y + 3);
    });

    // Two bars: inference B=4 and B=32
    const configs = [
      { label: 'Inference B=4', val: d.b4, x: W / 2 - barW - 20 },
      { label: 'Inference B=32', val: d.b32, x: W / 2 + 20 },
    ];

    configs.forEach(c => {
      const barH = (c.val / maxVal) * chartH;
      const y = chartTop + chartH - barH;
      ctx.fillStyle = d.color.replace(')', ', 0.75)').replace('#', 'rgba(').replace('rgba(#', 'rgba(');
      // Draw bar
      const col = d.color;
      ctx.fillStyle = col + '99';
      ctx.strokeStyle = col;
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      if (typeof ctx.roundRect === 'function') ctx.roundRect(c.x, y, barW, barH, [4, 4, 0, 0]);
      else ctx.rect(c.x, y, barW, barH);
      ctx.fill();
      ctx.stroke();

      // Value label
      ctx.fillStyle = '#f0f0f8';
      ctx.font = `700 12px var(--ff-mono, monospace)`;
      ctx.textAlign = 'center';
      ctx.fillText(c.val.toFixed(1) + '%', c.x + barW / 2, y - 6);

      // X-axis label
      ctx.fillStyle = '#6b7280';
      ctx.font = '9px var(--ff-mono, monospace)';
      ctx.fillText(c.label, c.x + barW / 2, chartTop + chartH + 16);
    });

    // Collapse annotation for B=32 training
    if (trainKey === '32') {
      ctx.strokeStyle = '#ef4444';
      ctx.lineWidth = 1;
      ctx.setLineDash([3, 3]);
      ctx.beginPath();
      const refY = chartTop + chartH * (1 - 47.1 / maxVal);
      ctx.moveTo(pad, refY);
      ctx.lineTo(W - pad, refY);
      ctx.stroke();
      ctx.setLineDash([]);
      ctx.fillStyle = '#ef4444';
      ctx.font = '9px var(--ff-mono, monospace)';
      ctx.textAlign = 'right';
      ctx.fillText('B=4 baseline (47.1%)', W - pad - 4, refY - 4);

      // Drop arrow
      const xDrop = configs[0].x + barW / 2;
      ctx.strokeStyle = '#ef4444';
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.moveTo(xDrop, refY + 4);
      ctx.lineTo(xDrop, chartTop + chartH - (20 / maxVal) * chartH - 4);
      ctx.stroke();
      ctx.fillStyle = '#ef4444';
      ctx.font = '700 10px var(--ff-mono, monospace)';
      ctx.textAlign = 'center';
      ctx.fillText('−57%', xDrop + 24, refY + 20);
    }

    // Legend
    ctx.fillStyle = '#abb2bf';
    ctx.font = `600 11px var(--ff-mono, monospace)`;
    ctx.textAlign = 'center';
    ctx.fillText(d.label, W / 2, H - 8);

    const labelEl = document.getElementById('collapse-label');
    if (labelEl) {
      const msgs = {
        '4':    'Fine-grained training (B=4): 47.1% at B=4 inference, stable at 42.5% for B=32',
        '32':   '⚠ Large-block training (B=32): collapses to 20.0% at B=4 inference — a 57% drop',
        'curr': '✓ Curriculum (4→32): best of both worlds — 50.0% at B=4, 48.3% at B=32',
      };
      labelEl.textContent = msgs[trainKey];
    }
  }

  document.querySelectorAll('#collapse-train-btns .bsz-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('#collapse-train-btns .bsz-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentTrain = btn.dataset.train;
      resizeAndDraw();
    });
  });

  resizeAndDraw();
  window.addEventListener('resize', resizeAndDraw);
})();

// ── Step navigator §04: Curriculum ───────────────────────────
(function() {
  let step = 0;
  const boxes   = document.querySelectorAll('.step-box');
  const prevBtn = document.getElementById('step-prev');
  const nextBtn = document.getElementById('step-next');
  const progEl  = document.getElementById('step-prog');

  function updateSteps() {
    boxes.forEach((b, i) => {
      b.classList.remove('active', 'done');
      if (i === step) b.classList.add('active');
      else if (i < step) b.classList.add('done');
    });
    if (prevBtn) prevBtn.disabled = step === 0;
    if (nextBtn) nextBtn.disabled = step === boxes.length - 1;
    if (progEl) progEl.textContent = `Step ${step + 1} of ${boxes.length}`;
    boxes.forEach((b, i) => {
      const n = b.querySelector('.step-num');
      if (n) n.textContent = i < step ? '✓' : String(i + 1);
    });
  }

  prevBtn?.addEventListener('click', () => { if (step > 0) { step--; updateSteps(); } });
  nextBtn?.addEventListener('click', () => { if (step < boxes.length - 1) { step++; updateSteps(); } });
  updateSteps();
})();

// ── Canvas §05: RelaxedConfidence ─────────────────────────────
(function() {
  const canvas = document.getElementById('canvas-relaxed');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;

  // Example token sequence: "the answer is 42 so we conclude"
  const tokens = ['the', 'answer', 'is', '42', 'so', 'we', 'conclude', '.'];
  const confidence = [0.98, 0.96, 0.97, 0.99, 0.91, 0.88, 0.93, 0.99];
  const decoded = new Set([0, 1, 2, 3]); // first 4 already decoded
  const tau = 0.95, tauMin = 0.7, r = 3, kappa = 0.8;
  let hoveredIdx = -1;

  function computeThreshold(i) {
    const R = new Set([...decoded, ...tokens.map((_, j) => j).filter(j => confidence[j] >= kappa)]);
    const Nr = tokens.map((_, j) => j).filter(j => j !== i && Math.abs(i - j) <= r);
    const totalW = Nr.reduce((s, j) => s + (r - Math.abs(i - j) + 1), 0);
    const suppW = Nr.filter(j => R.has(j)).reduce((s, j) => s + (r - Math.abs(i - j) + 1), 0);
    const Si = totalW > 0 ? suppW / totalW : 0;
    return { Si, tau: tau - (tau - tauMin) * Si };
  }

  function resizeAndDraw() {
    const W = canvas.clientWidth, H = 220;
    canvas.width = W * DPR; canvas.height = H * DPR;
    const ctx = canvas.getContext('2d');
    ctx.scale(DPR, DPR);
    drawRelaxed(ctx, W, H);
  }

  function drawRelaxed(ctx, W, H) {
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = 'rgba(20,20,36,0.4)';
    ctx.fillRect(0, 0, W, H);

    const pad = 20, tokenH = 44, rowY = 30;
    const tokenW = (W - 2 * pad) / tokens.length - 4;

    // Title
    ctx.fillStyle = '#6b7280';
    ctx.font = '10px var(--ff-mono, monospace)';
    ctx.textAlign = 'center';
    ctx.fillText('token confidence & effective threshold (τ=0.95, τ_min=0.70)', W / 2, 18);

    tokens.forEach((tok, i) => {
      const x = pad + i * (tokenW + 4);
      const isDecoded = decoded.has(i);
      const { Si, tau: effTau } = computeThreshold(i);
      const conf = confidence[i];
      const willCommit = !isDecoded && conf >= effTau;
      const hovered = i === hoveredIdx;

      // Token box
      let fillCol, strokeCol;
      if (isDecoded) {
        fillCol = 'rgba(6,182,212,0.3)'; strokeCol = '#06b6d4';
      } else if (willCommit) {
        fillCol = 'rgba(16,185,129,0.3)'; strokeCol = '#10b981';
      } else {
        fillCol = 'rgba(139,92,246,0.15)'; strokeCol = '#8b5cf6';
      }
      if (hovered) { fillCol = fillCol.replace('0.3', '0.5').replace('0.15', '0.35'); }

      ctx.fillStyle = fillCol;
      ctx.strokeStyle = strokeCol;
      ctx.lineWidth = hovered ? 2 : 1;
      ctx.beginPath();
      if (typeof ctx.roundRect === 'function') ctx.roundRect(x, rowY, tokenW, tokenH, 5);
      else ctx.rect(x, rowY, tokenW, tokenH);
      ctx.fill(); ctx.stroke();

      // Token text
      ctx.fillStyle = isDecoded ? '#06b6d4' : willCommit ? '#10b981' : '#8b5cf6';
      ctx.font = `600 ${Math.min(11, tokenW / 3)}px var(--ff-mono, monospace)`;
      ctx.textAlign = 'center';
      ctx.fillText(tok, x + tokenW / 2, rowY + 14);

      // Confidence
      ctx.fillStyle = '#abb2bf';
      ctx.font = `9px var(--ff-mono, monospace)`;
      ctx.fillText((conf * 100).toFixed(0) + '%', x + tokenW / 2, rowY + 28);

      // Effective threshold (for non-decoded)
      if (!isDecoded) {
        ctx.fillStyle = effTau < tau - 0.01 ? '#f59e0b' : '#6b7280';
        ctx.fillText('τ=' + effTau.toFixed(2), x + tokenW / 2, rowY + 40);
      } else {
        ctx.fillStyle = '#5c6370';
        ctx.fillText('done', x + tokenW / 2, rowY + 40);
      }
    });

    // Threshold line
    ctx.strokeStyle = 'rgba(239,68,68,0.5)';
    ctx.lineWidth = 1;
    ctx.setLineDash([4, 4]);
    const threshY = rowY + tokenH + 20;
    // Draw the bar chart of thresholds below
    const chartH = H - threshY - 20;
    tokens.forEach((_, i) => {
      const x = pad + i * (tokenW + 4);
      if (!decoded.has(i)) {
        const { Si, tau: effTau } = computeThreshold(i);
        const barH = ((tau - effTau) / (tau - tauMin)) * chartH * 0.8;
        if (barH > 2) {
          ctx.fillStyle = 'rgba(245,158,11,0.4)';
          ctx.strokeStyle = '#f59e0b';
          ctx.lineWidth = 1;
          ctx.setLineDash([]);
          ctx.beginPath();
          if (typeof ctx.roundRect === 'function') ctx.roundRect(x, threshY + chartH - barH, tokenW, barH, [2, 2, 0, 0]);
          else ctx.rect(x, threshY + chartH - barH, tokenW, barH);
          ctx.fill(); ctx.stroke();
          ctx.fillStyle = '#f59e0b';
          ctx.font = '8px var(--ff-mono, monospace)';
          ctx.textAlign = 'center';
          ctx.fillText('-' + ((tau - effTau) * 100).toFixed(0) + '%', x + tokenW / 2, threshY + chartH - barH - 3);
        }
      }
    });
    ctx.setLineDash([]);

    // Legend
    ctx.textAlign = 'left';
    ctx.font = '9px var(--ff-mono, monospace)';
    ctx.fillStyle = '#06b6d4'; ctx.fillText('■ decoded', pad, H - 6);
    ctx.fillStyle = '#10b981'; ctx.fillText('■ will commit', pad + 70, H - 6);
    ctx.fillStyle = '#8b5cf6'; ctx.fillText('■ needs more passes', pad + 160, H - 6);
    ctx.fillStyle = '#f59e0b'; ctx.fillText('■ threshold relaxed (amber bar = relaxation amount)', pad, H - 6 + 14);
  }

  canvas.addEventListener('mousemove', e => {
    const rect = canvas.getBoundingClientRect();
    const mx = (e.clientX - rect.left);
    const pad = 20, tokenW = (canvas.clientWidth - 2 * pad) / tokens.length - 4;
    const idx = Math.floor((mx - pad) / (tokenW + 4));
    hoveredIdx = idx >= 0 && idx < tokens.length ? idx : -1;

    const infoEl = document.getElementById('relaxed-info');
    if (infoEl && hoveredIdx >= 0) {
      const i = hoveredIdx;
      if (decoded.has(i)) {
        infoEl.textContent = `"${tokens[i]}" — already decoded`;
      } else {
        const { Si, tau: effTau } = computeThreshold(i);
        const willCommit = confidence[i] >= effTau;
        infoEl.textContent = `"${tokens[i]}" — conf=${(confidence[i]*100).toFixed(0)}%, support Si=${Si.toFixed(2)}, τᵢ=${effTau.toFixed(2)} → ${willCommit ? '✓ commit' : '✗ re-mask'}`;
      }
    } else if (infoEl) {
      infoEl.textContent = 'hover over a token above';
    }
    resizeAndDraw();
  });
  canvas.addEventListener('mouseleave', () => { hoveredIdx = -1; resizeAndDraw(); });

  resizeAndDraw();
  window.addEventListener('resize', resizeAndDraw);
})();

// ── Bar chart §06: animate on scroll ─────────────────────────
(function() {
  const section = document.getElementById('s-results');
  if (!section) return;
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          b.style.width = (parseFloat(b.dataset.w) / 76) * 100 + '%';
        });
      }
    });
  }, { threshold: 0.3 }).observe(section);
})();
</script>
</BaseLayout>

function activateTab(n){document.querySelectorAll('.cs-tab').forEach(t=>t.classList.toggle('active',t.dataset.panel===n));document.querySelectorAll('.cs-panel').forEach(p=>p.classList.toggle('active',p.id==='panel-'+n));const m=tabMeta[n];if(m){document.getElementById('cs-file-label').textContent=m.file;document.getElementById('cs-section-title').textContent=m.title;}}
document.querySelectorAll('.cs-tab').forEach(t=>t.addEventListener('click',()=>activateTab(t.dataset.panel)));

const sectionMap={'s-problem':'problem','s-hrm':'hrm','s-magicnorm':'magicnorm','s-objective':'objective','s-ablation':'ablation','s-results':'results'};
document.querySelectorAll('.post-body section[id]').forEach(s=>new IntersectionObserver(entries=>{entries.forEach(e=>{if(e.isIntersecting){document.querySelectorAll('.toc-item').forEach(li=>li.classList.toggle('toc-active',li.id==='toc-'+e.target.id));const p=sectionMap[e.target.id];if(p)activateTab(p);}});},{threshold:0.25}).observe(s));

// Efficiency scatter
(function(){
  const canvas=document.getElementById('eff-canvas');if(!canvas)return;
  const DPR=window.devicePixelRatio||1,W=canvas.clientWidth,H=280;
  canvas.width=W*DPR;canvas.height=H*DPR;const ctx=canvas.getContext('2d');ctx.scale(DPR,DPR);
  const PL=58,PT=30,PR=30,PB=50,pw=W-PL-PR,ph=H-PT-PB;
  const MODELS=[{l:'HRM-Text 1B',t:0.04,s:71.5,star:true},{l:'Huginn 3.5B',t:800,s:36.5},{l:'Llama3.2 3B',t:9000,s:58.5},{l:'Gemma3 4B',t:4000,s:53.8},{l:'Qwen3.5 2B',t:36000,s:56.5},{l:'OLMo3 7B',t:6000,s:66.0}];
  const lmin=Math.log10(0.03),lmax=Math.log10(50000),smin=30,smax=80;
  function xp(t){return PL+(Math.log10(t)-lmin)/(lmax-lmin)*pw;}
  function yp(s){return PT+ph-(s-smin)/(smax-smin)*ph;}
  ctx.strokeStyle='rgba(255,255,255,.05)';ctx.lineWidth=1;
  [0.04,1,100,1000,10000].forEach(t=>{ctx.beginPath();ctx.moveTo(xp(t),PT);ctx.lineTo(xp(t),PT+ph);ctx.stroke();});
  [30,40,50,60,70,80].forEach(s=>{ctx.beginPath();ctx.moveTo(PL,yp(s));ctx.lineTo(PL+pw,yp(s));ctx.stroke();});
  ctx.strokeStyle='rgba(255,255,255,.2)';ctx.lineWidth=1.2;
  ctx.beginPath();ctx.moveTo(PL,PT);ctx.lineTo(PL,PT+ph+5);ctx.stroke();
  ctx.beginPath();ctx.moveTo(PL-5,PT+ph);ctx.lineTo(PL+pw,PT+ph);ctx.stroke();
  ctx.fillStyle='rgba(255,255,255,.3)';ctx.font='10px var(--ff-mono)';ctx.textAlign='center';
  [{t:0.04,l:'40B'},{t:1,l:'1B'},{t:100,l:'100B'},{t:1000,l:'1T'},{t:10000,l:'10T'}].forEach(({t,l})=>ctx.fillText(l,xp(t),PT+ph+18));
  ctx.fillText('Training tokens (log scale)',PL+pw/2,H-5);
  ctx.textAlign='right';[30,40,50,60,70,80].forEach(s=>ctx.fillText(s+'%',PL-8,yp(s)+4));
  MODELS.forEach(m=>{const x=xp(m.t),y=yp(m.s),r=m.star?9:7;
    if(m.star){ctx.beginPath();ctx.arc(x,y,r+4,0,Math.PI*2);ctx.fillStyle='rgba(139,92,246,.2)';ctx.fill();}
    ctx.beginPath();ctx.arc(x,y,r,0,Math.PI*2);ctx.fillStyle=m.star?'#8b5cf6':'rgba(107,114,128,.6)';ctx.fill();
    ctx.strokeStyle=m.star?'rgba(167,139,250,.9)':'rgba(255,255,255,.15)';ctx.lineWidth=m.star?2:1;ctx.stroke();
    ctx.font=(m.star?'600 ':'')+'10px var(--ff-mono)';ctx.fillStyle=m.star?'#c4b5fd':'rgba(255,255,255,.45)';ctx.textAlign='left';ctx.fillText(m.l,x+r+5,y+4);
  });
  const tip=document.getElementById('eff-tip');
  if(tip){canvas.addEventListener('mousemove',e=>{const rect=canvas.getBoundingClientRect(),mx=e.clientX-rect.left,my=e.clientY-rect.top;let hit=null;MODELS.forEach(m=>{if(Math.hypot(mx-xp(m.t),my-yp(m.s))<14)hit=m;});if(hit){const ts=hit.t<1?'40B':hit.t<1000?hit.t+'B':(hit.t/1000)+'T';tip.innerHTML=hit.l+'<br>tokens: '+ts+' &middot; avg: '+hit.s+'%';tip.style.display='block';tip.style.left=(mx+16)+'px';tip.style.top=(my-12)+'px';}else tip.style.display='none';});canvas.addEventListener('mouseleave',()=>tip.style.display='none');}
})();

// HRM architecture canvas
(function(){
  const canvas=document.getElementById('hrm-canvas');if(!canvas)return;
  const DPR=window.devicePixelRatio||1,W=canvas.clientWidth,H=240;
  canvas.width=W*DPR;canvas.height=H*DPR;const ctx=canvas.getContext('2d');ctx.scale(DPR,DPR);
  function box(x,y,w,h,fill,stroke,label,sub){
    ctx.fillStyle=fill;ctx.strokeStyle=stroke;ctx.lineWidth=1.4;
    ctx.beginPath();ctx.roundRect(x,y,w,h,6);ctx.fill();ctx.stroke();
    ctx.fillStyle=stroke;ctx.font='700 10px var(--ff-mono)';ctx.textAlign='center';
    ctx.fillText(label,x+w/2,y+h/2+(sub?-2:4));
    if(sub){ctx.font='9px var(--ff-mono)';ctx.fillStyle='rgba(255,255,255,.5)';ctx.fillText(sub,x+w/2,y+h/2+10);}
  }
  function arr(x1,y1,x2,y2,color){
    ctx.strokeStyle=color;ctx.lineWidth=1.4;ctx.beginPath();ctx.moveTo(x1,y1);ctx.lineTo(x2,y2);ctx.stroke();
    const a=Math.atan2(y2-y1,x2-x1);ctx.fillStyle=color;ctx.beginPath();ctx.moveTo(x2,y2);ctx.lineTo(x2-7*Math.cos(a-.4),y2-7*Math.sin(a-.4));ctx.lineTo(x2-7*Math.cos(a+.4),y2-7*Math.sin(a+.4));ctx.closePath();ctx.fill();
  }
  box(14,100,68,34,'rgba(6,182,212,.12)','rgba(6,182,212,.6)','Input','Embed');
  box(96,100,60,34,'rgba(139,92,246,.12)','rgba(139,92,246,.6)','z_H0','H-state');

  ctx.beginPath();ctx.roundRect(362,24,176,210,8);ctx.stroke();
  ctx.setLineDash([]);
  ctx.fillStyle='rgba(139,92,246,.4)';ctx.font='8px var(--ff-mono)';ctx.textAlign='center';
  ctx.fillText('CYCLE 1',260,16);ctx.fillText('CYCLE 2',450,16);
  // Cycle 1 L modules
  box(186,38,44,28,'rgba(16,185,129,.12)','rgba(16,185,129,.6)','L',null);
  box(242,38,44,28,'rgba(16,185,129,.12)','rgba(16,185,129,.6)','L',null);
  box(186,82,44,28,'rgba(16,185,129,.12)','rgba(16,185,129,.6)','L',null);
  arr(230,52,240,52,'rgba(16,185,129,.5)');
  ctx.strokeStyle='rgba(16,185,129,.3)';ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(286,52);ctx.lineTo(296,52);ctx.lineTo(296,96);ctx.lineTo(230,96);ctx.stroke();
  box(194,142,130,34,'rgba(139,92,246,.15)','rgba(139,92,246,.7)','H','Slow module');
  arr(208,110,208,140,'rgba(16,185,129,.5)');
  arr(156,117,170,52,'rgba(139,92,246,.35)');
  // Cycle 2 L modules
  box(376,38,44,28,'rgba(16,185,129,.12)','rgba(16,185,129,.6)','L',null);
  box(432,38,44,28,'rgba(16,185,129,.12)','rgba(16,185,129,.6)','L',null);
  box(376,82,44,28,'rgba(16,185,129,.12)','rgba(16,185,129,.6)','L',null);
  arr(420,52,430,52,'rgba(16,185,129,.5)');
  ctx.strokeStyle='rgba(16,185,129,.3)';ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(476,52);ctx.lineTo(486,52);ctx.lineTo(486,96);ctx.lineTo(420,96);ctx.stroke();
  box(384,142,130,34,'rgba(139,92,246,.15)','rgba(139,92,246,.7)','H','Slow module');
  arr(398,110,398,140,'rgba(16,185,129,.5)');
  arr(324,159,360,159,'rgba(139,92,246,.7)');
  ctx.fillStyle='rgba(139,92,246,.6)';ctx.font='8px var(--ff-mono)';ctx.textAlign='center';ctx.fillText('z_H',342,155);
  ctx.strokeStyle='rgba(139,92,246,.25)';ctx.lineWidth=1;ctx.setLineDash([3,2]);
  ctx.beginPath();ctx.moveTo(324,149);ctx.lineTo(360,52);ctx.stroke();ctx.setLineDash([]);
  box(458,200,76,28,'rgba(16,185,129,.12)','rgba(16,185,129,.5)','LM Head',null);
  arr(449,176,496,198,'rgba(16,185,129,.5)');
  ctx.font='9px var(--ff-mono)';ctx.textAlign='left';
  ctx.fillStyle='rgba(16,185,129,.8)';ctx.fillText('L = fast execution (3x per cycle)',14,206);
  ctx.fillStyle='rgba(139,92,246,.8)';ctx.fillText('H = slow strategy (1x per cycle)',14,220);
  ctx.fillStyle='rgba(255,255,255,.3)';ctx.fillText('8 forward steps total = 4x compute of single-pass Transformer',14,234);
})();

// MagicNorm canvas
(function(){
  const canvas=document.getElementById('norm-canvas');if(!canvas)return;
  const DPR=window.devicePixelRatio||1,W=canvas.clientWidth,H=220;
  canvas.width=W*DPR;canvas.height=H*DPR;const ctx=canvas.getContext('2d');ctx.scale(DPR,DPR);
  const DATA={
    postnorm:{fwdC:'#10b981',fwdV:[1,.85,.72,.61,.52,.43,.38,.33],fwdL:'Forward variance',bwdC:'#ef4444',bwdV:[1,.72,.51,.35,.24,.16,.10,.06],bwdL:'Gradient norm',desc:'<strong>PostNorm</strong>: Forward variance decreases each step (stable activations). But gradients vanish rapidly &#x2014; deeper steps receive near-zero gradient. Compounds catastrophically over N=8 recurrent steps.'},
    prenorm:{fwdC:'#f59e0b',fwdV:[1,1.42,1.91,2.5,3.18,3.97,4.85,5.82],fwdL:'Forward variance',bwdC:'#06b6d4',bwdV:[1,.96,.93,.91,.88,.86,.84,.82],bwdL:'Gradient norm',desc:'<strong>PreNorm</strong>: Gradients flow cleanly (stable optimization). But unnormalized residual accumulation causes forward variance to grow without bound &#x2014; leading to representation collapse in deep recurrent settings.'},
    magic:{fwdC:'#10b981',fwdV:[1,.97,.95,.94,.93,.92,.91,.90],fwdL:'Forward variance (exit norm)',bwdC:'#06b6d4',bwdV:[1,.95,.90,.86,.83,.80,.78,.76],bwdL:'Gradient norm (K=5 TBPTT)',desc:'<strong>MagicNorm</strong>: PreNorm inside + PostNorm exit cap. Forward: exit norm bounds variance at each of N=8 steps. Backward (K=5): gradient only traverses K exit norms; PreNorm identity dominates. Both stable. &#x2726;'}
  };
  let active='postnorm';
  function draw(key){
    const d=DATA[key];ctx.clearRect(0,0,W,H);
    const PL=52,PT=22,PR=20,PB=40,pw=W-PL-PR,ph=H-PT-PB,N=8;
    const maxV=Math.max(...d.fwdV,...d.bwdV)*1.1;
    function xp(i){return PL+(i/(N-1))*pw;}function yp(v){return PT+ph-(v/maxV)*ph;}
    ctx.strokeStyle='rgba(255,255,255,.05)';ctx.lineWidth=1;
    [0,.25,.5,.75,1].forEach(f=>{ctx.beginPath();ctx.moveTo(PL,PT+ph*(1-f));ctx.lineTo(PL+pw,PT+ph*(1-f));ctx.stroke();});
    ctx.strokeStyle='rgba(255,255,255,.2)';ctx.lineWidth=1;
    ctx.beginPath();ctx.moveTo(PL,PT);ctx.lineTo(PL,PT+ph+4);ctx.stroke();
    ctx.beginPath();ctx.moveTo(PL-4,PT+ph);ctx.lineTo(PL+pw,PT+ph);ctx.stroke();
    ctx.fillStyle='rgba(255,255,255,.3)';ctx.font='10px var(--ff-mono)';ctx.textAlign='center';
    for(let i=0;i<N;i++)ctx.fillText('s'+(i+1),xp(i),PT+ph+18);
    function line(vals,color,label,isFirst){
      ctx.beginPath();ctx.strokeStyle=color;ctx.lineWidth=2;
      vals.forEach((v,i)=>i===0?ctx.moveTo(xp(i),yp(v)):ctx.lineTo(xp(i),yp(v)));ctx.stroke();
      vals.forEach((v,i)=>{ctx.beginPath();ctx.arc(xp(i),yp(v),3.5,0,Math.PI*2);ctx.fillStyle=color;ctx.fill();});
      ctx.fillStyle=color;ctx.font='600 9px var(--ff-mono)';ctx.textAlign='left';
      ctx.fillText(label,PL+8,PT+(isFirst?12:22));
    }
    line(d.fwdV,d.fwdC,d.fwdL,true);line(d.bwdV,d.bwdC,d.bwdL,false);
    const desc=document.getElementById('norm-desc');if(desc)desc.innerHTML=d.desc;
  }
  draw(active);
  document.querySelectorAll('.norm-tab').forEach(btn=>btn.addEventListener('click',()=>{document.querySelectorAll('.norm-tab').forEach(b=>b.classList.remove('active'));btn.classList.add('active');active=btn.dataset.norm;draw(active);}));
})();

// Attention map canvases
(function(){
  const NI=5,NR=1,N=NI+NR;
  function drawAttn(id,causal){
    const canvas=document.getElementById(id);if(!canvas)return;
    const DPR=window.devicePixelRatio||1,W=canvas.clientWidth,H=180;
    canvas.width=W*DPR;canvas.height=H*DPR;const ctx=canvas.getContext('2d');ctx.scale(DPR,DPR);
    const P=20,cell=Math.min((W-P*2)/N,(H-P*2)/N),sx=P+(W-P*2-cell*N)/2,sy=P+(H-P*2-cell*N)/2;
    for(let r=0;r<N;r++)for(let c=0;c<N;c++){
      let a=0;
      if(causal){a=c<=r?1/(r+1):0;}
      else{if(r<NI&&c<NI)a=1/NI;else if(r>=NI)a=c<=r?1/(r+1):0;}
      ctx.fillStyle=a>0?(r<NI?'rgba(245,158,11,'+(0.15+a*.75)+')':'rgba(255,255,255,'+(0.1+a*.7)+')'):'rgba(255,255,255,.02)';
      ctx.fillRect(sx+c*cell+1,sy+r*cell+1,cell-2,cell-2);
    }
    ctx.strokeStyle='rgba(255,255,255,.12)';ctx.lineWidth=1;ctx.setLineDash([3,3]);
    ctx.beginPath();ctx.moveTo(sx+NI*cell,sy);ctx.lineTo(sx+NI*cell,sy+N*cell);ctx.stroke();
    ctx.beginPath();ctx.moveTo(sx,sy+NI*cell);ctx.lineTo(sx+N*cell,sy+NI*cell);ctx.stroke();
    ctx.setLineDash([]);
    ctx.font='9px var(--ff-mono)';ctx.textAlign='center';
    ctx.fillStyle='rgba(245,158,11,.7)';ctx.fillText('instruction (5)',sx+NI*cell/2,sy-5);
    ctx.fillStyle='rgba(255,255,255,.5)';ctx.fillText('resp',sx+NI*cell+cell/2,sy-5);
  }
  drawAttn('attn-causal',true);drawAttn('attn-prefix',false);
})();

// Step navigator
(function(){
  let step=0;const boxes=document.querySelectorAll('#step-list .step-box'),prev=document.getElementById('step-prev'),next=document.getElementById('step-next'),prog=document.getElementById('step-prog');
  function upd(){boxes.forEach((b,i)=>{b.classList.remove('active','done');if(i===step)b.classList.add('active');else if(i<step)b.classList.add('done');});if(prev)prev.disabled=step===0;if(next)next.disabled=step===boxes.length-1;if(prog)prog.textContent='Step '+(step+1)+' of '+boxes.length;boxes.forEach((b,i)=>{const n=b.querySelector('.step-num');if(n)n.textContent=i<step?'&#x2713;':String(i+1);});}
  prev?.addEventListener('click',()=>{if(step>0){step--;upd();}});next?.addEventListener('click',()=>{if(step<boxes.length-1){step++;upd();}});upd();
})();

// Animated bar chart
const rs=document.getElementById('s-results');
if(rs)new IntersectionObserver(es=>{es.forEach(e=>{if(e.isIntersecting)document.querySelectorAll('.bar-fill[data-w]').forEach(b=>b.style.width=parseFloat(b.dataset.w)+'%');});},{threshold:.2}).observe(rs);
</script>

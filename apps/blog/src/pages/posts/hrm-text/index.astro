<span class="cs-line cmt"># HRM forward pass (H2L3 config)</span>
<span class="cs-line"><span class="kw">class</span> <span class="cls">HRM</span>:</span>
<span class="cs-line">  <span class="kw">def</span> <span class="fn">forward</span>(<span class="kw">self</span>, tokens):</span>
<span class="cs-line">    x = <span class="kw">self</span>.<span class="fn">embed</span>(tokens)</span>
<span class="cs-line hl-c">    z_H = <span class="kw">self</span>.<span class="fn">h_init</span>(x)  <span class="cmt"># slow state</span></span>
<span class="cs-line hl-g">    z_L = <span class="kw">self</span>.<span class="fn">l_init</span>(x)  <span class="cmt"># fast state</span></span>
<span class="cs-line hl-p">    <span class="kw">for</span> _ <span class="kw">in</span> <span class="fn">range</span>(<span class="num">2</span>):     <span class="cmt"># H cycles</span></span>
<span class="cs-line hl-p">      <span class="kw">for</span> _ <span class="kw">in</span> <span class="fn">range</span>(<span class="num">3</span>):   <span class="cmt"># L steps</span></span>
<span class="cs-line hl-p">        z_L = <span class="kw">self</span>.<span class="fn">L</span>(z_L, z_H)</span>
<span class="cs-line hl-p">      z_H = <span class="kw">self</span>.<span class="fn">H</span>(z_H, z_L)</span>
<span class="cs-line">    <span class="kw">return</span> <span class="kw">self</span>.<span class="fn">lm_head</span>(z_H)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># 2x(3+1) = 8 steps, 4x compute</span>
<span class="cs-line cmt"># same parameter count as 1x Transformer</span>
      </pre>
    </div>
    <div class="cs-panel" id="panel-magicnorm">
      <pre class="cs-pre">
<span class="cs-line cmt"># MagicNorm: PreNorm inside, PostNorm exit</span>
<span class="cs-line"><span class="kw">class</span> <span class="cls">MagicNormModule</span>:</span>
<span class="cs-line">  <span class="kw">def</span> <span class="fn">forward</span>(<span class="kw">self</span>, z):</span>
<span class="cs-line hl-c">    h = z + <span class="kw">self</span>.<span class="fn">attn</span>(<span class="kw">self</span>.<span class="fn">norm1</span>(z))</span>
<span class="cs-line hl-c">    h = h + <span class="kw">self</span>.<span class="fn">ffn</span>(<span class="kw">self</span>.<span class="fn">norm2</span>(h))</span>
<span class="cs-line hl-p">    <span class="kw">return</span> <span class="kw">self</span>.<span class="fn">exit_norm</span>(h)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># forward: exit_norm 8x -> PostNorm</span>
<span class="cs-line cmt"># backward (K=5): PreNorm dominates</span>
<span class="cs-line"> </span>
<span class="cs-line hl-g">K_warmup = <span class="num">2</span>  <span class="cmt"># early steps (first half)</span></span>
<span class="cs-line hl-g">K_final  = <span class="num">5</span>  <span class="cmt"># after warmup</span></span>
      </pre>
    </div>
    <div class="cs-panel" id="panel-objective">
      <pre class="cs-pre">
<span class="cs-line cmt"># Standard: loss on ALL tokens</span>
<span class="cs-line cmt"># loss = -log P(x)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># HRM-Text: response tokens only</span>
<span class="cs-line hl-p"><span class="cmt"># loss = -log P(x_a | x_q)</span></span>
<span class="cs-line"> </span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">task_loss</span>(logits, labels, mask):</span>
<span class="cs-line">  loss = <span class="fn">cross_entropy</span>(logits, labels)</span>
<span class="cs-line hl-g">  <span class="kw">return</span> (loss * mask).<span class="fn">sum</span>() / mask.<span class="fn">sum</span>()</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># PrefixLM mask</span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">prefixlm</span>(seq_len, prefix_len):</span>

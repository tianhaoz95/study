    <tr><td>OLMo3 7B</td><td class="mn">252&#xd7;</td><td class="mn">6T</td><td class="mn">65.8</td><td class="mn">81.6</td><td class="mn">71.5</td><td class="mn">75.5</td><td class="mn">40.0</td></tr>

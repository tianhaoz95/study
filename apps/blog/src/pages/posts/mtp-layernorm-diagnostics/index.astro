// ─── §02: gamma bars visualization ───────────────────────────────
const barContainer = document.getElementById('gamma-bars');
const N_BARS = 64;

function seededRand(seed) {
  let s = seed;
  return function() {
    s = (s * 1664525 + 1013904223) & 0xffffffff;
    return (s >>> 0) / 0xffffffff;
  };
}

const states = {
  init: {
    label: '● at init — all γᵢ = 1.0',
    status: '● healthy',
    statusColor: 'rgba(16,185,129,.15)',
    statusBorder: 'rgba(16,185,129,.3)',
    statusText: 'var(--green)',
    norm: 8.0,
    interp: 'All γᵢ = 1.0. The LayerNorm is a pure identity rescaler — each feature dimension carries equal weight. ‖γ‖₂ = √64 = 8.0 for this 64-dim example.',
    generateBars: () => Array(N_BARS).fill(1.0),
  },
  healthy: {
    label: '● healthy — mid-training',
    status: '● healthy',
    statusColor: 'rgba(16,185,129,.15)',
    statusBorder: 'rgba(16,185,129,.3)',
    statusText: 'var(--green)',
    norm: 6.1,
    interp: 'Some γᵢ have grown (informative dims, brighter), others shrunk (redundant dims, darker). Net ‖γ‖₂ ≈ 6.1 — a healthy 24% shrink from √64 = 8. The residual stream has grown and the model compensates selectively.',
    generateBars: () => {
      const r = seededRand(42);
      return Array.from({length: N_BARS}, (_, i) => {
        const base = 0.6 + r() * 0.9;
        return Math.max(0.1, base);
      });
    },
  },
  collapsed: {
    label: '● collapsed — γ uniformly small',
    status: '● WARNING',
    statusColor: 'rgba(239,68,68,.1)',
    statusBorder: 'rgba(239,68,68,.3)',
    statusText: '#f87171',
    norm: 1.8,
    interp: '‖γ‖₂ ≈ 1.8 — collapsed to 22% of √64. All γᵢ are near-zero: the final LayerNorm is suppressing almost all signal. MTP heads receive impoverished representations. The LM head can still produce reasonable logits (it has its own calibration), but the MTP auxiliary path is starved.',
    generateBars: () => {
      const r = seededRand(99);
      return Array.from({length: N_BARS}, () => 0.1 + r() * 0.15);
    },
  },
  exploded: {
    label: '● exploded — a few γᵢ dominate',
    status: '● CRITICAL',
    statusColor: 'rgba(245,158,11,.1)',
    statusBorder: 'rgba(245,158,11,.3)',
    statusText: 'var(--amber)',
    norm: 18.5,
    interp: '‖γ‖₂ ≈ 18.5 — exploded to 2.3× √64. A handful of feature dimensions have grown huge (spikes) while others remain small. The LM head logits are dominated by these channels. MTP gradients flow back through these same channels at 2–3× intended magnitude, overwhelming the main pretraining loss.',
    generateBars: () => {
      const r = seededRand(7);
      return Array.from({length: N_BARS}, (_, i) => {
        if (i % 12 === 5 || i % 17 === 3) return 3.5 + r() * 2.5;
        return 0.15 + r() * 0.3;
      });
    },
  },
};

function renderBars(stateKey) {
  const s = states[stateKey];
  const vals = s.generateBars();
  const maxVal = Math.max(...vals, 1);
  barContainer.innerHTML = vals.map(v => {
    const pct = (v / maxVal) * 100;
    let color;
    if (stateKey === 'init') color = 'rgba(139,92,246,.6)';
    else if (stateKey === 'healthy') color = v > 1.2 ? 'rgba(6,182,212,.8)' : v < 0.4 ? 'rgba(100,116,139,.4)' : 'rgba(139,92,246,.6)';
    else if (stateKey === 'collapsed') color = 'rgba(239,68,68,.4)';
    else color = v > 2 ? 'rgba(245,158,11,.9)' : 'rgba(100,116,139,.3)';
    return `<div class="sig-bar" style="height:${pct}%;background:${color}"></div>`;
  }).join('');

  document.getElementById('norm-display').innerHTML = `${s.norm.toFixed(1)} <span>‖γ‖₂ (d=64 example)</span>`;
  const statusEl = document.getElementById('norm-status');
  statusEl.textContent = s.status;
  statusEl.style.background = s.statusColor;
  statusEl.style.borderColor = s.statusBorder;
  statusEl.style.color = s.statusText;
  document.getElementById('norm-interpretation').textContent = s.interp;

  ['init','healthy','collapsed','exploded'].forEach(k => {
    const btn = document.getElementById('state-' + k);
    if (btn) btn.classList.toggle('active', k === stateKey);
  });
}

renderBars('init');
['init','healthy','collapsed','exploded'].forEach(k => {
  document.getElementById('state-' + k)?.addEventListener('click', () => renderBars(k));
});

// ─── §04: gradient canvas ─────────────────────────────────────────
const gradCanvas = document.getElementById('grad-canvas');
if (gradCanvas) {
  const gCtx = gradCanvas.getContext('2d');
  const GW = gradCanvas.clientWidth, GH = 180;
  const DPR = window.devicePixelRatio || 1;
  gradCanvas.width = GW * DPR; gradCanvas.height = GH * DPR;
  gCtx.scale(DPR, DPR);

  const gammaNormSlider = document.getElementById('gamma-norm-slider');
  const gammaNormVal = document.getElementById('gamma-norm-val');
  const gradInterpEl = document.getElementById('grad-interpretation');
  const gradLabelCurrent = document.getElementById('grad-label-current');

  function drawGradCanvas(gammaNorm) {
    gCtx.clearRect(0, 0, GW, GH);
    const baselineNorm = 55.4; // sqrt(3072)
    const lambdaMTP = 0.1;

    // Background
    gCtx.fillStyle = 'rgba(15,17,26,0.5)';
    gCtx.fillRect(0, 0, GW, GH);

    const padL = 50, padR = 20, padT = 20, padB = 30;
    const chartW = GW - padL - padR;
    const chartH = GH - padT - padB;

    // Grid
    gCtx.strokeStyle = 'rgba(255,255,255,0.04)';
    gCtx.lineWidth = 1;
    for (let i = 0; i <= 4; i++) {
      const y = padT + (i / 4) * chartH;
      gCtx.beginPath(); gCtx.moveTo(padL, y); gCtx.lineTo(padL + chartW, y); gCtx.stroke();
    }

    // X axis (gamma norm 0→120)
    const normMin = 0, normMax = 120;
    const xOf = n => padL + ((n - normMin) / (normMax - normMin)) * chartW;

    // Y axis (effective gradient scale 0→0.25)
    const scaleMax = 0.25;
    const yOf = s => padT + chartH - (s / scaleMax) * chartH;

    // Curve: effective scale = lambda * (norm / baseline)
    gCtx.beginPath();
    gCtx.strokeStyle = 'rgba(16,185,129,.8)';
    gCtx.lineWidth = 2.5;
    for (let n = 0; n <= 120; n++) {
      const scale = lambdaMTP * (n / baselineNorm);
      const x = xOf(n), y = yOf(Math.min(scale, scaleMax));
      if (n === 0) gCtx.moveTo(x, y); else gCtx.lineTo(x, y);
    }
    gCtx.stroke();

    // Intended scale reference line (lambda=0.1)
    const intendedScale = lambdaMTP;
    const intendedY = yOf(intendedScale);
    gCtx.setLineDash([4, 4]);
    gCtx.strokeStyle = 'rgba(139,92,246,.5)';
    gCtx.lineWidth = 1.5;
    gCtx.beginPath();
    gCtx.moveTo(padL, intendedY);
    gCtx.lineTo(padL + chartW, intendedY);
    gCtx.stroke();
    gCtx.setLineDash([]);

    // Label: intended
    gCtx.fillStyle = 'rgba(139,92,246,.7)';
    gCtx.font = `${10 * DPR / DPR}px var(--ff-mono,monospace)`;
    gCtx.fillText('intended (λ=0.1)', xOf(60), intendedY - 5);

    // Current position
    const curScale = lambdaMTP * (gammaNorm / baselineNorm);
    const curX = xOf(gammaNorm);
    const curY = yOf(Math.min(curScale, scaleMax));

    // Vertical line at current
    gCtx.strokeStyle = 'rgba(245,158,11,.6)';
    gCtx.lineWidth = 1.5;
    gCtx.setLineDash([3, 3]);
    gCtx.beginPath(); gCtx.moveTo(curX, padT); gCtx.lineTo(curX, padT + chartH); gCtx.stroke();
    gCtx.setLineDash([]);

    // sqrt(d) marker
    const sqrtD = 55.4;
    const sqrtX = xOf(sqrtD);
    gCtx.strokeStyle = 'rgba(139,92,246,.4)';
    gCtx.lineWidth = 1;
    gCtx.setLineDash([4, 4]);
    gCtx.beginPath(); gCtx.moveTo(sqrtX, padT); gCtx.lineTo(sqrtX, padT + chartH); gCtx.stroke();
    gCtx.setLineDash([]);
    gCtx.fillStyle = 'rgba(139,92,246,.7)';
    gCtx.fillText('√3072', sqrtX + 3, padT + 14);

    // Current dot
    const color = gammaNorm < 22 ? '#ef4444' : gammaNorm > 100 ? '#f59e0b' : '#10b981';
    gCtx.beginPath();
    gCtx.arc(curX, curY, 6, 0, Math.PI * 2);
    gCtx.fillStyle = color;
    gCtx.fill();
    gCtx.strokeStyle = '#fff';
    gCtx.lineWidth = 1.5;
    gCtx.stroke();

    // Axes
    gCtx.strokeStyle = 'rgba(255,255,255,.15)';
    gCtx.lineWidth = 1;
    gCtx.beginPath(); gCtx.moveTo(padL, padT); gCtx.lineTo(padL, padT + chartH); gCtx.stroke();
    gCtx.beginPath(); gCtx.moveTo(padL, padT + chartH); gCtx.lineTo(padL + chartW, padT + chartH); gCtx.stroke();

    // Y axis labels
    gCtx.fillStyle = 'rgba(255,255,255,.4)';
    gCtx.textAlign = 'right';
    for (let i = 0; i <= 4; i++) {
      const s = (i / 4) * scaleMax;
      gCtx.fillText(s.toFixed(2), padL - 5, yOf(s) + 4);
    }
    gCtx.textAlign = 'left';
    gCtx.fillText('eff. gradient scale', padL + 2, padT + 12);

    // Interpretation
    const ratio = gammaNorm / baselineNorm;
    let interp;
    if (ratio < 0.4) interp = `At ‖γ‖₂ = ${gammaNorm.toFixed(0)}, the effective MTP gradient scale is ${(curScale*100).toFixed(1)}% of intended — MTP is effectively disabled. The auxiliary task has no real influence on the main transformer.`;
    else if (ratio < 0.7) interp = `At ‖γ‖₂ = ${gammaNorm.toFixed(0)}, effective scale = ${(curScale*100).toFixed(1)}% of intended. This is a significant reduction — MTP is operating at half capacity. Consider whether this is acceptable or whether λ needs adjustment.`;
    else if (ratio <= 1.3) interp = `At ‖γ‖₂ = ${gammaNorm.toFixed(0)}, effective MTP gradient scale ≈ ${(curScale*100).toFixed(1)}% of intended — healthy. The λ=0.1 weighting is working as designed.`;
    else if (ratio <= 1.8) interp = `At ‖γ‖₂ = ${gammaNorm.toFixed(0)}, effective scale = ${(curScale*100).toFixed(1)}% of intended — slightly elevated. Monitor whether main lm_loss is being displaced.`;
    else interp = `At ‖γ‖₂ = ${gammaNorm.toFixed(0)}, effective MTP gradient scale = ${(curScale*100).toFixed(1)}% — MORE THAN DOUBLE intended. The MTP auxiliary loss is dominating gradients. Main pretraining is at risk. Reduce λ immediately.`;
    if (gradInterpEl) gradInterpEl.textContent = interp;
    if (gradLabelCurrent) gradLabelCurrent.textContent = `current: ‖γ‖₂ = ${gammaNorm.toFixed(1)}`;
  }

  drawGradCanvas(55);
  gammaNormSlider?.addEventListener('input', () => {
    const v = parseFloat(gammaNormSlider.value);
    gammaNormVal.textContent = v.toFixed(1);
    drawGradCanvas(v);
  });
}

// ─── §05: acceptance rate canvas ─────────────────────────────────
const accCanvas = document.getElementById('acceptance-canvas');
if (accCanvas) {
  const aCtx = accCanvas.getContext('2d');
  const AW = accCanvas.clientWidth, AH = 200;
  const DPR = window.devicePixelRatio || 1;
  accCanvas.width = AW * DPR; accCanvas.height = AH * DPR;
  aCtx.scale(DPR, DPR);

  const padL = 55, padR = 20, padT = 20, padB = 40;
  const chartW = AW - padL - padR;
  const chartH = AH - padT - padB;

  // Acceptance rate as function of gamma norm (conceptual bell curve around sqrt(d))
  function acceptanceRate(norm) {
    const baseline = 55.4;
    const ratio = norm / baseline;
    // Bell curve: peaks at ratio=1, falls off on both sides
    // Collapse side: over-confident logits
    // Explosion side: under-confident logits
    if (ratio <= 0) return 0.10;
    if (ratio <= 1) {
      // Sigmoid rise from 0.15 at collapse to peak at 1
      return 0.15 + 0.65 * Math.pow(ratio, 1.5) / (1 + Math.pow(ratio, 1.5) * 0.3);
    } else {
      // Gentle fall-off after peak
      const excess = ratio - 1;
      return 0.80 * Math.exp(-excess * excess * 1.5);
    }
  }

  const normMin = 0, normMax = 140;
  const xOf = n => padL + ((n - normMin) / (normMax - normMin)) * chartW;
  const yOf = r => padT + chartH - r * chartH;

  // Background
  aCtx.fillStyle = 'rgba(15,17,26,0.5)';
  aCtx.fillRect(0, 0, AW, AH);

  // Grid
  aCtx.strokeStyle = 'rgba(255,255,255,0.04)';
  aCtx.lineWidth = 1;
  for (let i = 0; i <= 4; i++) {
    const y = padT + (i / 4) * chartH;
    aCtx.beginPath(); aCtx.moveTo(padL, y); aCtx.lineTo(padL + chartW, y); aCtx.stroke();
  }

  // Acceptance rate curve
  aCtx.beginPath();
  aCtx.strokeStyle = 'rgba(16,185,129,.8)';
  aCtx.lineWidth = 2.5;
  for (let n = 0; n <= 140; n++) {
    const r = acceptanceRate(n);
    const x = xOf(n), y = yOf(r);
    if (n === 0) aCtx.moveTo(x, y); else aCtx.lineTo(x, y);
  }
  aCtx.stroke();

  // Shaded regions
  // Collapse zone
  aCtx.fillStyle = 'rgba(239,68,68,0.07)';
  aCtx.fillRect(padL, padT, xOf(22) - padL, chartH);
  aCtx.fillStyle = 'rgba(239,68,68,.4)';
  aCtx.font = '9px var(--ff-mono,monospace)';
  aCtx.fillText('collapse', padL + 3, padT + 14);

  // Healthy zone
  aCtx.fillStyle = 'rgba(16,185,129,0.05)';
  aCtx.fillRect(xOf(22), padT, xOf(100) - xOf(22), chartH);

  // Explosion zone
  aCtx.fillStyle = 'rgba(245,158,11,0.07)';
  aCtx.fillRect(xOf(100), padT, padL + chartW - xOf(100), chartH);
  aCtx.fillStyle = 'rgba(245,158,11,.5)';
  aCtx.fillText('explosion', xOf(103), padT + 14);

  // sqrt(d) vertical line
  const sqrtX = xOf(55.4);
  aCtx.strokeStyle = 'rgba(139,92,246,.6)';
  aCtx.lineWidth = 1.5;
  aCtx.setLineDash([4, 4]);
  aCtx.beginPath(); aCtx.moveTo(sqrtX, padT); aCtx.lineTo(sqrtX, padT + chartH); aCtx.stroke();
  aCtx.setLineDash([]);
  aCtx.fillStyle = 'rgba(139,92,246,.8)';
  aCtx.font = '9px var(--ff-mono,monospace)';
  aCtx.fillText('√3072', sqrtX + 4, padT + 12);

  // Peak annotation
  const peakRate = acceptanceRate(55.4);
  aCtx.beginPath();
  aCtx.arc(sqrtX, yOf(peakRate), 5, 0, Math.PI * 2);
  aCtx.fillStyle = '#10b981';
  aCtx.fill();
  aCtx.fillStyle = 'rgba(16,185,129,.8)';
  aCtx.fillText(`peak α ≈ ${(peakRate*100).toFixed(0)}%`, sqrtX + 8, yOf(peakRate) - 5);

  // Axes
  aCtx.strokeStyle = 'rgba(255,255,255,.15)';
  aCtx.lineWidth = 1;
  aCtx.beginPath(); aCtx.moveTo(padL, padT); aCtx.lineTo(padL, padT + chartH); aCtx.stroke();
  aCtx.beginPath(); aCtx.moveTo(padL, padT + chartH); aCtx.lineTo(padL + chartW, padT + chartH); aCtx.stroke();

  // Y axis labels
  aCtx.fillStyle = 'rgba(255,255,255,.4)';
  aCtx.textAlign = 'right';
  for (let i = 0; i <= 4; i++) {
    const r = i / 4;
    aCtx.fillText(`${(r * 100).toFixed(0)}%`, padL - 5, yOf(r) + 4);
  }
  aCtx.textAlign = 'center';
  aCtx.fillStyle = 'rgba(255,255,255,.3)';
  aCtx.font = '8px var(--ff-mono,monospace)';
  // X axis ticks
  [0, 22, 55.4, 100, 140].forEach(n => {
    aCtx.fillText(n === 55.4 ? '√3072' : n.toString(), xOf(n), padT + chartH + 14);
    aCtx.strokeStyle = 'rgba(255,255,255,.1)';
    aCtx.lineWidth = 1;
    aCtx.beginPath(); aCtx.moveTo(xOf(n), padT + chartH); aCtx.lineTo(xOf(n), padT + chartH + 4); aCtx.stroke();
  });
  aCtx.fillStyle = 'rgba(255,255,255,.3)';
  aCtx.fillText('‖final_layernorm.weight‖₂ →', padL + chartW/2, padT + chartH + 28);
  aCtx.textAlign = 'left';
  aCtx.fillText('draft acceptance rate', padL + 5, padT + 12);
}

// ─── §06: step navigator ─────────────────────────────────────────
let step = 0;
const boxes   = document.querySelectorAll('.step-box');
const prevBtn = document.getElementById('step-prev');
const nextBtn = document.getElementById('step-next');
const progEl  = document.getElementById('step-prog');

function updateSteps() {
  boxes.forEach((b, i) => {
    b.classList.remove('active','done');
    if (i === step) b.classList.add('active');
    else if (i < step) b.classList.add('done');
  });
  if (prevBtn) prevBtn.disabled = step === 0;
  if (nextBtn) nextBtn.disabled = step === boxes.length - 1;
  if (progEl) progEl.textContent = `Step ${step+1} of ${boxes.length}`;
  boxes.forEach((b, i) => {
    const n = b.querySelector('.step-num');
    if (n) n.textContent = i < step ? '✓' : String(i+1);
  });
}

prevBtn?.addEventListener('click', () => { if (step > 0) { step--; updateSteps(); }});
nextBtn?.addEventListener('click', () => { if (step < boxes.length - 1) { step++; updateSteps(); }});
updateSteps();
</script>
</BaseLayout>

  ['hl-p','    merged = xt.clone()'],
  ['hl-p','    merged[M_B] = t1[M_B]'],
  ['hl-p','    merged[M_A] = t2[M_A]'],
  ['hl-p','    return merged   # cost: ~1.5x training time (teacher is frozen)'],
  ['',    ''],
  ['cmt', '# Reverse CALM — cross-tokenizer objective (bounded gradients)'],
  ['',    ''],
  ['hl-c','def reverse_calm(p_s, p_t):'],
  ['hl-c','    """Chunk-level BCE with swapped arguments."""'],
  ['hl-c','    # Forward: -(p_t*log(p_s) + (1-p_t)*log(1-p_s))  → explodes if p_s→0'],
  ['hl-c','    # Reverse: -(p_s*log(p_t) + (1-p_s)*log(1-p_t))  → bounded by teacher'],
  ['hl-c','    loss = -(p_s * log(p_t) + (1 - p_s) * log(1 - p_t))'],
  ['hl-c','    # Dual-end filtering:'],
  ['hl-c','    #   p_t ≈ 0.5 → coefficient ≈ 0 (poorly aligned chunk)'],
  ['hl-c','    #   low p_s  → suppressed by ∂p_s/∂θ → noise filtered'],
  ['hl-c','    return loss'],
]);


  ['hl-p','def compdemo_teacher_logits(teacher, x0, xt, M, rho=0.5):'],
  ['hl-p','    """Split M into M_A, M_B; run teacher twice; merge logits."""'],
  ['hl-p','    M_A, M_B = random_split(M, ratio=rho)       # |M_A|/|M| ≈ ρ'],
  ['hl-p','    # Pass 1: reveal M_A, predict M_B positions'],
  ['hl-p','    x_pass1 = xt.clone()'],
  ['hl-p','    x_pass1[M_A] = x0[M_A]                      # reveal M_A'],
  ['hl-p','    t1 = teacher(x_pass1)                        # logits at M_B'],
  ['hl-p','    # Pass 2: reveal M_B, predict M_A positions'],
  ['hl-p','    x_pass2 = xt.clone()'],
  ['hl-p','    x_pass2[M_B] = x0[M_B]                      # reveal M_B'],
  ['hl-p','    t2 = teacher(x_pass2)                        # logits at M_A'],

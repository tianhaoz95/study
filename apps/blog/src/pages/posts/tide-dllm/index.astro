// ─── dLLM vs AR denoising animation ─────────────────────────────────────────
(function() {
  const tokens = ['I', "don", "'t", 'wan', 'na', 'go'];
  // dLLM: parallel unmasking order (not left-to-right)
  const dlmSteps = [
    [false,false,false,false,false,false],  // step 0: all masked
    [true, false,false,true, false,true ],  // step 1: I, wan, go revealed (non-sequential)
    [true, false,false,true, true, true ],  // step 2: na added
    [true, true, false,true, true, true ],  // step 3: don added
    [true, true, true, true, true, true ],  // step 4: 't added (last)
  ];
  // AR: left-to-right
  const arSteps = [
    [false,false,false,false,false,false],
    [true, false,false,false,false,false],
    [true, true, false,false,false,false],
    [true, true, true, false,false,false],
    [true, true, true, true, true, true ],  // all at once at end for visual clarity
  ];
  const stepLabels = ['step 0 / 4 — t = 1.00','step 1 / 4 — t = 0.75','step 2 / 4 — t = 0.50','step 3 / 4 — t = 0.25','step 4 / 4 — t = 0.00'];
  let curStep = 0, timer = null;

  function tokBox(text, revealed, style) {
    const div = document.createElement('div');
    div.style.cssText = 'display:inline-flex;align-items:center;justify-content:center;padding:.25rem .55rem;border-radius:5px;font-family:var(--ff-mono);font-size:.78rem;font-weight:600;border:1px solid;min-width:38px;transition:all .4s;' + style;
    div.textContent = revealed ? text : '[M]';
    return div;
  }

  function render(step) {
    const dlmRow = document.getElementById('dlm-row');
    const arRow  = document.getElementById('ar-row');
    if (!dlmRow || !arRow) return;
    dlmRow.innerHTML = '';
    arRow.innerHTML  = '';
    tokens.forEach((t, i) => {
      const dlmRev = dlmSteps[step][i];
      const arRev  = arSteps[step][i];
      dlmRow.appendChild(tokBox(t, dlmRev,
        dlmRev ? 'background:rgba(139,92,246,.15);color:var(--purple-l);border-color:rgba(139,92,246,.5)'
               : 'background:#0f172a;color:var(--muted);border-color:var(--border-hi);border-style:dashed'));
      arRow.appendChild(tokBox(t, arRev,
        arRev  ? 'background:rgba(6,182,212,.1);color:var(--cyan);border-color:rgba(6,182,212,.4)'
               : 'background:#0f172a;color:var(--muted);border-color:var(--border-hi);border-style:dashed'));
    });
    const lbl = document.getElementById('dlm-step-label');
    if (lbl) lbl.textContent = stepLabels[step];
  }

  render(0);

  document.getElementById('dlm-play')?.addEventListener('click', () => {
    if (timer) return;
    const run = () => {
      curStep++;
      render(curStep);
      if (curStep < dlmSteps.length - 1) timer = setTimeout(run, 1200);
      else timer = null;
    };
    if (curStep >= dlmSteps.length - 1) { curStep = 0; render(0); }
    timer = setTimeout(run, 500);
  });
  document.getElementById('dlm-reset')?.addEventListener('click', () => {
    clearTimeout(timer); timer = null; curStep = 0; render(0);
  });
})();

// ─── TIDAL 2D heatmap ────────────────────────────────────────────────────────
(function() {
  const canvas = document.getElementById('tidal-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const H_CSS = 260;
  const PAD = { l: 58, r: 20, t: 20, b: 44 };

  function lambdaTrain(p) {
    return 0.1 + 0.8 * 0.5 * (1 - Math.cos(Math.PI * p));
  }
  function lambdaFull(t, p) {
    return lambdaTrain(p) * (1 - t);
  }

  function draw() {
    const W_CSS = canvas.clientWidth;
    canvas.width  = W_CSS  * DPR;
    canvas.height = H_CSS  * DPR;
    ctx.scale(DPR, DPR);

    const PW = W_CSS - PAD.l - PAD.r;
    const PH = H_CSS - PAD.t - PAD.b;

    // draw heatmap pixel by pixel (use imageData for speed)
    const imgData = ctx.createImageData(Math.round(PW), Math.round(PH));
    for (let px = 0; px < Math.round(PW); px++) {
      for (let py = 0; py < Math.round(PH); py++) {
        const t = px / (PW - 1);
        const p = 1 - py / (PH - 1);
        const lam = lambdaFull(t, p);
        // color: black → purple
        const r = Math.round(lam / 0.9 * 139);
        const g = Math.round(lam / 0.9 * 92);
        const b = Math.round(lam / 0.9 * 246);
        const idx = (py * Math.round(PW) + px) * 4;
        imgData.data[idx]   = r;
        imgData.data[idx+1] = g;
        imgData.data[idx+2] = b;
        imgData.data[idx+3] = 255;
      }
    }
    ctx.putImageData(imgData, PAD.l, PAD.t);

    // X-axis: masking ratio t
    ctx.fillStyle = 'rgba(148,163,184,.6)';
    ctx.font = `${10 * DPR / DPR}px var(--ff-mono)`;
    ctx.textAlign = 'center';
    ctx.fillText('0.0 (low noise)', PAD.l + 0, H_CSS - 6);
    ctx.fillText('0.5', PAD.l + PW * 0.5, H_CSS - 6);
    ctx.fillText('1.0 (all masked)', PAD.l + PW, H_CSS - 6);
    ctx.fillText('masking ratio t  →', PAD.l + PW * 0.5, H_CSS - 6 + 14);

    // Y-axis: training progress p
    ctx.textAlign = 'right';
    ctx.fillText('0%', PAD.l - 6, H_CSS - PAD.b);
    ctx.fillText('50%', PAD.l - 6, PAD.t + PH * 0.5);
    ctx.fillText('100%', PAD.l - 6, PAD.t + 4);

    // Y-axis label
    ctx.save();
    ctx.translate(12, PAD.t + PH * 0.5);
    ctx.rotate(-Math.PI / 2);
    ctx.textAlign = 'center';
    ctx.fillText('training progress p  →', 0, 0);
    ctx.restore();

    // annotations
    ctx.fillStyle = 'rgba(255,255,255,.9)';
    ctx.font = '11px var(--ff-mono)';
    ctx.textAlign = 'left';
    ctx.fillText('trust teacher', PAD.l + 4, PAD.t + 16);
    ctx.fillStyle = 'rgba(255,255,255,.4)';
    ctx.font = '10px var(--ff-mono)';
    ctx.fillText('λ ≈ 0.9', PAD.l + 4, PAD.t + 30);

    ctx.fillStyle = 'rgba(148,163,184,.7)';
    ctx.font = '11px var(--ff-mono)';
    ctx.textAlign = 'right';
    ctx.fillText('ignore teacher', PAD.l + PW - 4, PAD.t + 16);
    ctx.fillStyle = 'rgba(148,163,184,.4)';
    ctx.font = '10px var(--ff-mono)';
    ctx.fillText('λ ≈ 0.0', PAD.l + PW - 4, PAD.t + 30);
  }

  draw();
  window.addEventListener('resize', draw);

  // hover tooltip
  canvas.addEventListener('mousemove', e => {
    const rect = canvas.getBoundingClientRect();
    const mx = e.clientX - rect.left;
    const my = e.clientY - rect.top;
    const W_CSS = canvas.clientWidth;
    const PW = W_CSS - PAD.l - PAD.r;
    const PH = H_CSS - PAD.t - PAD.b;
    const t = Math.max(0, Math.min(1, (mx - PAD.l) / PW));
    const p = Math.max(0, Math.min(1, 1 - (my - PAD.t) / PH));
    const lam = lambdaFull(t, p);
    const tooltip = document.getElementById('tidal-tooltip');
    if (tooltip) {
      tooltip.textContent = `t = ${t.toFixed(2)}  |  p = ${p.toFixed(2)}  |  λ(t,p) = ${lam.toFixed(3)}  — teacher weight: ${Math.round(lam / 0.9 * 100)}%`;
    }
  });
  canvas.addEventListener('mouseleave', () => {
    const tooltip = document.getElementById('tidal-tooltip');
    if (tooltip) tooltip.textContent = 'hover to inspect λ value';
  });
})();

// ─── CompDemo step navigator ─────────────────────────────────────────────────
(function() {
  let step = 0;
  const boxes   = document.querySelectorAll('#compdemo-steps .step-box');
  const prevBtn = document.getElementById('step-prev');
  const nextBtn = document.getElementById('step-next');
  const progEl  = document.getElementById('step-prog');

  function update() {
    boxes.forEach((b, i) => {
      b.classList.remove('active', 'done');
      if (i === step) b.classList.add('active');
      else if (i < step) b.classList.add('done');
    });
    if (prevBtn) prevBtn.disabled = step === 0;
    if (nextBtn) nextBtn.disabled = step === boxes.length - 1;
    if (progEl) progEl.textContent = `Step ${step + 1} of ${boxes.length}`;
    boxes.forEach((b, i) => {
      const n = b.querySelector('.step-num');
      if (n) n.textContent = i < step ? '✓' : String(i + 1);
    });
  }
  prevBtn?.addEventListener('click', () => { if (step > 0) { step--; update(); } });
  nextBtn?.addEventListener('click', () => { if (step < boxes.length - 1) { step++; update(); } });
  update();
})();
</script>
</BaseLayout>

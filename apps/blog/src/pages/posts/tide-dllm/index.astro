renderPanel('pre-tidal', [
  ['cmt', '# TIDAL — Time-Iteration Dual-Axis Lambda Modulation'],
  ['',    ''],
  ['hl-p','def lambda_train(p, l_init=0.1, l_max=0.9):'],
  ['hl-p','    """Cosine ramp from l_init to l_max over training progress p."""'],
  ['hl-p','    return l_init + (l_max - l_init) * 0.5 * (1 - math.cos(math.pi * p))'],
  ['',    ''],
  ['hl-c','def lambda_t(t, p):'],
  ['hl-c','    """Combined lambda: trust teacher only at low t, late p."""'],
  ['hl-c','    return lambda_train(p) * (1 - t)'],
  ['',    ''],
  ['hl-g','def tidal_loss(s_logits, t_logits, t, p, T=1.0):'],
  ['hl-g','    lam = lambda_t(t, p)                         # 0 → 0.9'],
  ['hl-g','    # interpolate teacher into target (no gradient through target)'],
  ['hl-g','    mix = (1 - lam) * s_logits + lam * t_logits'],
  ['hl-g','    r_t = softmax(mix / T).detach()              # detach!'],
  ['hl-g','    loss = KL(r_t, softmax(s_logits / T)) * T**2'],
  ['hl-g','    return loss'],
  ['',    ''],
  ['cmt', '# Midrange timestep weighting (optional)'],
  ['',    '# w(t) = exp(-(t-0.5)**2 / (2*0.15**2))  ← emphasize t≈0.5'],
  ['',    ''],
  ['cmt', '# λ(t=0.0, p=1.0) = 0.9  ← trust teacher fully (confident + mature)'],
  ['cmt', '# λ(t=1.0, p=any) = 0.0  ← ignore teacher (all masked = guessing)'],

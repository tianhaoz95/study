<span class="cs-line cmt"># Standard ViT self-attention complexity</span>
<span class="cs-line cmt"># N = number of patches = (H/P) * (W/P)</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">self_attention</span>(Q, K, V):</span>
<span class="cs-line hl-p">    <span class="cmt"># Q,K,V shape: [B, N, D]</span></span>
<span class="cs-line hl-p">    <span class="cmt"># Attention matrix: [B, N, N] ← N² pairs</span></span>
<span class="cs-line">    scores = Q @ K.transpose(-<span class="num">2</span>, -<span class="num">1</span>) / D**<span class="num">0.5</span></span>
<span class="cs-line">    attn = softmax(scores, dim=-<span class="num">1</span>)   <span class="cmt"># [B,N,N]</span></span>
<span class="cs-line">    <span class="kw">return</span> attn @ V</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># FLOPs example at different resolutions</span>
<span class="cs-line cmt"># P=16, so N = (res/16)²</span>
<span class="cs-line cmt"># res=256:  N=256,   N²=65,536</span>
<span class="cs-line cmt"># res=512:  N=1024,  N²=1,048,576</span>
<span class="cs-line cmt"># res=1024: N=4096,  N²=16,777,216</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Every 2× resolution → 4× FLOPs</span>
<span class="cs-line"> </span>
<span class="cs-line cmt">──────────────────────────────────────</span>
<span class="cs-line cmt"># VECA core-periphery complexity</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># C = number of core tokens (fixed, small)</span>
<span class="cs-line cmt"># Total = 2*N*C + C²</span>
<span class="cs-line cmt"># res=512, C=64:</span>
<span class="cs-line hl-g"><span class="cmt">#   2*1024*64 + 64² = 135,168 pairs</span></span>
<span class="cs-line hl-g"><span class="cmt">#   vs 1,048,576 standard → 87.1% fewer</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Every 2× resolution → 2× FLOPs (linear!)</span>
      </pre>
    </div>

    <!-- §02: Core-Periphery Attention -->
    <div class="cs-panel" id="panel-core">
      <pre class="cs-pre">
<span class="cs-line cmt"># VECA core-mediated attention pseudocode</span>
<span class="cs-line cmt"># Z: patch tokens  [B, N, D]</span>
<span class="cs-line cmt"># R: core tokens   [B, C, D]</span>
<span class="cs-line"> </span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">veca_block</span>(Z, R, C):</span>
<span class="cs-line">    <span class="cmt"># Concatenate for core queries</span></span>
<span class="cs-line hl-p">    X = concat([R, Z], dim=<span class="num">1</span>)   <span class="cmt"># [B,C+N,D]</span></span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="cmt"># STEP 1: cores attend to FULL sequence</span></span>
<span class="cs-line hl-c">    R_new = Attn(Q=R, K=X, V=X)    <span class="cmt"># [B,C,D]</span></span>
<span class="cs-line hl-c">    <span class="cmt"># cost: C*(C+N) ≈ CN pairs</span></span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="cmt"># STEP 2: patches attend ONLY to cores</span></span>
<span class="cs-line hl-c">    Z_new = Attn(Q=Z, K=R_new, V=R_new)  <span class="cmt"># [B,N,D]</span></span>
<span class="cs-line hl-c">    <span class="cmt"># cost: N*C pairs</span></span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="cmt"># NO patch-to-patch attention at all!</span></span>
<span class="cs-line hl-p">    <span class="cmt"># graph diameter = 2, not 1</span></span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="cmt"># Update core spatial coordinates</span></span>
<span class="cs-line">    rho_next = rho + alpha * f(R_new)</span>
<span class="cs-line">    u_next = tanh(rho_next)       <span class="cmt"># clamp to [-1,1]²</span></span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="kw">return</span> Z_new, R_new, u_next</span>
<span class="cs-line"> </span>
<span class="cs-line cmt">──────────────────────────────────────</span>
<span class="cs-line cmt"># 2D axial RoPE for positional encoding</span>
<span class="cs-line cmt"># patch tokens: fixed grid coords</span>
<span class="cs-line cmt"># core tokens: learned, updated each layer</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Core initialization: uniform grid</span>
<span class="cs-line cmt"># Core coords after layer 12: semantic clusters</span>
      </pre>
    </div>

    <!-- §03: Elastic Inference -->
    <div class="cs-panel" id="panel-elastic">
      <pre class="cs-pre">
<span class="cs-line cmt"># Budget-adaptive training via nested dropout</span>
<span class="cs-line cmt"># M = max core capacity (e.g. 64)</span>
<span class="cs-line cmt"># C ~ p_C(·) sampled each training step</span>
<span class="cs-line"> </span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">sample_budget</span>():</span>
<span class="cs-line">    <span class="cmt"># Sample active prefix size C ≤ M</span></span>
<span class="cs-line hl-p">    C = sample_from(p_C)   <span class="cmt"># e.g. {8,16,32,64}</span></span>
<span class="cs-line hl-p">    R_active = R_bank[: C] <span class="cmt"># ordered prefix</span></span>
<span class="cs-line">    <span class="kw">return</span> R_active, C</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Why this works:</span>
<span class="cs-line cmt"># r_1 is active for ALL budgets → learns</span>
<span class="cs-line cmt"># most universal visual information</span>
<span class="cs-line cmt"># r_64 is active only at max budget →</span>
<span class="cs-line cmt"># specializes in fine spatial detail</span>
<span class="cs-line"> </span>
<span class="cs-line cmt">──────────────────────────────────────</span>
<span class="cs-line cmt"># Inference: just pick C</span>
<span class="cs-line cmt"># No retraining, no fine-tuning</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Classification task (global):</span>
<span class="cs-line cmt">#  C=8:  79.99% IN1K  (6.3% of full attn)</span>
<span class="cs-line hl-c"><span class="cmt">#  C=64: 81.93% IN1K  (full budget)</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Dense prediction task (spatial):</span>
<span class="cs-line cmt">#  C=8:  53.30 mIoU Context  (1.6% attn)</span>
<span class="cs-line hl-g"><span class="cmt">#  C=64: 57.46 mIoU Context  (full budget)</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># First core r_1 is used as [CLS] token</span>
<span class="cs-line cmt"># for global classification output</span>
      </pre>
    </div>

    <!-- §04: Emergent Semantics -->
    <div class="cs-panel" id="panel-emergent">
      <pre class="cs-pre">
<span class="cs-line cmt"># Core token coordinate dynamics</span>
<span class="cs-line cmt"># (Eq. 3 in paper)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># rho: unconstrained 2D coordinate state</span>
<span class="cs-line cmt"># u: bounded coord in [-1,1]² for RoPE</span>
<span class="cs-line cmt"># f_l: lightweight coordinate head (MLP)</span>
<span class="cs-line cmt"># alpha_l: learned layer-wise scalar</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">for</span> layer l <span class="kw">in</span> range(L):</span>
<span class="cs-line hl-p">    rho_next = rho + alpha[l] * f[l](r[l])</span>
<span class="cs-line hl-p">    u_next   = tanh(rho_next)   <span class="cmt"># clamp</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Effect across layers:</span>
<span class="cs-line cmt"># Layer 3: u positions are roughly</span>
<span class="cs-line cmt">#   uniform / spherical (isotropic)</span>
<span class="cs-line cmt"># Layer 12: u positions cluster into</span>
<span class="cs-line cmt">#   semantically coherent groups</span>
<span class="cs-line"> </span>
<span class="cs-line cmt">──────────────────────────────────────</span>
<span class="cs-line cmt"># Emergent behaviors observed:</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># 1. Object-centric cores:</span>
<span class="cs-line hl-c"><span class="cmt">#    Different cores → distinct objects</span></span>
<span class="cs-line hl-c"><span class="cmt">#    (e.g. eggs / bowl / background)</span></span>
<span class="cs-line hl-c"><span class="cmt">#    No segmentation supervision!</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># 2. Isotropic → semantic clustering:</span>
<span class="cs-line hl-g"><span class="cmt">#    UMAP shows cores go from spherical</span></span>
<span class="cs-line hl-g"><span class="cmt">#    blobs to tight semantic clusters</span></span>
<span class="cs-line hl-g"><span class="cmt">#    as depth increases</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># 3. Budget affects granularity:</span>
<span class="cs-line cmt">#    C=8:  each core → large coarse region</span>
<span class="cs-line cmt">#    C=64: fine-grained semantic patches</span>
      </pre>
    </div>

    <!-- §05: Results -->

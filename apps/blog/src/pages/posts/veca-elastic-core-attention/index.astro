<script>
/* ───────── TOC + sidebar toggles ───────── */
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});

const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

/* ───────── Code sidebar tab switching ───────── */
const tabMeta = {
  quadratic: { file: 'veca/complexity.py',   title: 'The Quadratic Wall' },
  core:      { file: 'veca/attention.py',    title: 'Core-Periphery Attention' },
  elastic:   { file: 'veca/elastic.py',      title: 'Elastic Inference' },
  emergent:  { file: 'veca/core_dynamics.py',title: 'Emergent Semantics' },
  results:   { file: 'veca/results.py',      title: 'Results' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

/* ───────── IntersectionObserver — sync TOC + sidebar tab ───────── */
const sectionMap = {
  's-quadratic': 'quadratic',
  's-core':      'core',
  's-elastic':   'elastic',
  's-emergent':  'emergent',
  's-results':   'results',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

/* ═══════════════════════════════════════════════════════
   §01 — FLOPs vs Resolution canvas
═══════════════════════════════════════════════════════ */
(function() {
  const canvas = document.getElementById('flops-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  let W, H;

  const resolutions = [128, 192, 256, 320, 384, 448, 512, 640, 768, 1024];
  const PURPLE = '#8b5cf6', CYAN = '#06b6d4', MUTED = '#374151';
  const C = 64;

  function patchCount(res, P) { return Math.floor(res / P) * Math.floor(res / P); }
  function standardOps(N) { return N * N; }
  function vecaOps(N, c) { return 2 * N * c + c * c; }

  let currentP = 16;

  function draw(P) {
    const w = canvas.clientWidth; const h = 220;
    if (canvas.width !== w * DPR || canvas.height !== h * DPR) {
      canvas.width = w * DPR; canvas.height = h * DPR; ctx.scale(DPR, DPR);
    }
    W = w; H = h;
    ctx.clearRect(0, 0, W, H);

    const PAD = { t: 20, r: 20, b: 40, l: 65 };
    const pw = W - PAD.l - PAD.r;
    const ph = H - PAD.t - PAD.b;

    const dataStd  = resolutions.map(r => standardOps(patchCount(r, P)));
    const dataVeca = resolutions.map(r => vecaOps(patchCount(r, P), C));
    const maxVal = Math.max(...dataStd);

    // Grid lines
    for (let i = 0; i <= 4; i++) {
      const y = PAD.t + ph - (i / 4) * ph;
      ctx.beginPath(); ctx.moveTo(PAD.l, y); ctx.lineTo(PAD.l + pw, y);
      ctx.strokeStyle = 'rgba(255,255,255,0.05)'; ctx.lineWidth = 1; ctx.stroke();
      const val = (i / 4) * maxVal;
      const label = val >= 1e6 ? (val/1e6).toFixed(1)+'M' : val >= 1e3 ? (val/1e3).toFixed(0)+'K' : val.toFixed(0);
      ctx.fillStyle = '#4b5563'; ctx.font = `${10*DPR/DPR}px monospace`; ctx.textAlign = 'right';
      ctx.fillText(label, PAD.l - 5, y + 4);
    }

    // X-axis labels
    resolutions.forEach((r, i) => {
      const x = PAD.l + (i / (resolutions.length - 1)) * pw;
      if (r === 256 || r === 512 || r === 768 || r === 1024) {
        ctx.fillStyle = '#4b5563'; ctx.font = `${10*DPR/DPR}px monospace`; ctx.textAlign = 'center';
        ctx.fillText(r + 'px', x, H - PAD.b + 15);
      }
    });

    // Draw standard line
    ctx.beginPath();
    resolutions.forEach((r, i) => {
      const x = PAD.l + (i / (resolutions.length - 1)) * pw;
      const y = PAD.t + ph - (dataStd[i] / maxVal) * ph;
      i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
    });
    ctx.strokeStyle = '#ef4444'; ctx.lineWidth = 2; ctx.stroke();

    // Draw VECA line
    ctx.beginPath();
    resolutions.forEach((r, i) => {
      const x = PAD.l + (i / (resolutions.length - 1)) * pw;
      const y = PAD.t + ph - (dataVeca[i] / maxVal) * ph;
      i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
    });
    ctx.strokeStyle = PURPLE; ctx.lineWidth = 2; ctx.stroke();

    // Highlight 512px point
    const idx512 = resolutions.indexOf(512);
    if (idx512 >= 0) {
      const x = PAD.l + (idx512 / (resolutions.length - 1)) * pw;
      const yStd  = PAD.t + ph - (dataStd[idx512]  / maxVal) * ph;
      const yVeca = PAD.t + ph - (dataVeca[idx512] / maxVal) * ph;
      ctx.beginPath(); ctx.arc(x, yStd,  4, 0, Math.PI*2); ctx.fillStyle = '#ef4444'; ctx.fill();
      ctx.beginPath(); ctx.arc(x, yVeca, 4, 0, Math.PI*2); ctx.fillStyle = PURPLE;    ctx.fill();
      // Dashed vertical
      ctx.beginPath(); ctx.setLineDash([4,3]); ctx.moveTo(x, yVeca); ctx.lineTo(x, yStd);
      ctx.strokeStyle = 'rgba(139,92,246,.4)'; ctx.lineWidth = 1; ctx.stroke(); ctx.setLineDash([]);
    }

    // Legend
    ctx.fillStyle = '#ef4444'; ctx.fillRect(PAD.l, PAD.t, 12, 3);
    ctx.fillStyle = '#9ca3af'; ctx.font = `${10*DPR/DPR}px monospace`; ctx.textAlign = 'left';
    ctx.fillText('Standard ViT (O(N²))', PAD.l + 16, PAD.t + 4);
    ctx.fillStyle = PURPLE; ctx.fillRect(PAD.l + 160, PAD.t, 12, 3);
    ctx.fillStyle = '#9ca3af';
    ctx.fillText('VECA (O(N), C=64)', PAD.l + 176, PAD.t + 4);

    // Update cap
    const N512 = patchCount(512, P);
    const std512 = standardOps(N512).toLocaleString();
    const vc512  = vecaOps(N512, C).toLocaleString();
    const pct = (100 * (1 - vecaOps(N512, C) / standardOps(N512))).toFixed(1);
    document.getElementById('flops-cap').textContent =
      `At 512px with P=${P}: standard = ${std512} ops  |  VECA (C=64) = ${vc512} ops  (${pct}% fewer)`;
  }

  draw(16);

  const slider = document.getElementById('patch-slider');
  slider?.addEventListener('input', () => {
    currentP = parseInt(slider.value);
    document.getElementById('patch-label').textContent = currentP + ' px';
    draw(currentP);
  });
  window.addEventListener('resize', () => draw(currentP));
})();

/* ═══════════════════════════════════════════════════════
   §02 — VECA Step Navigator
═══════════════════════════════════════════════════════ */
(function() {
  let step = 0;
  const boxes   = document.querySelectorAll('.step-box');
  const prevBtn = document.getElementById('step-prev');
  const nextBtn = document.getElementById('step-next');
  const progEl  = document.getElementById('step-prog');
  function updateSteps() {
    boxes.forEach((b, i) => {
      b.classList.remove('active', 'done');
      if (i === step) b.classList.add('active');
      else if (i < step) b.classList.add('done');
    });
    if (prevBtn) prevBtn.disabled = step === 0;
    if (nextBtn) nextBtn.disabled = step === boxes.length - 1;
    if (progEl) progEl.textContent = `Step ${step+1} of ${boxes.length}`;
    boxes.forEach((b, i) => {
      const n = b.querySelector('.step-num');
      if (n) n.textContent = i < step ? '✓' : String(i + 1);
    });
  }
  prevBtn?.addEventListener('click', () => { if (step > 0) { step--; updateSteps(); } });
  nextBtn?.addEventListener('click', () => { if (step < boxes.length-1) { step++; updateSteps(); } });
  updateSteps();
})();

/* ═══════════════════════════════════════════════════════
   §03 — Elastic Inference canvas
═══════════════════════════════════════════════════════ */
(function() {
  const canvas = document.getElementById('elastic-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;

  // Data: [C, IN1K%, Context mIoU, attnOps@512]
  const data = {
    8:  { cls: 79.99, seg: 53.30, ops: 2*1024*8   + 8*8   },
    16: { cls: 80.52, seg: 54.80, ops: 2*1024*16  + 16*16 },
    32: { cls: 81.20, seg: 56.30, ops: 2*1024*32  + 32*32 },
    64: { cls: 81.93, seg: 57.46, ops: 2*1024*64  + 64*64 },
  };
  const teacher = { cls: 83.56, seg: 57.74 };
  let activeC = 64;

  const caps = {
    8:  'C=8: ImageNet 79.99%  |  Context 53.30 mIoU  |  16,448 attn pairs  (1.6% of full)',
    16: 'C=16: ImageNet 80.52%  |  Context 54.80 mIoU  |  33,024 attn pairs  (3.1% of full)',
    32: 'C=32: ImageNet 81.20%  |  Context 56.30 mIoU  |  66,560 attn pairs  (6.3% of full)',
    64: 'C=64: ImageNet 81.93%  |  Context 57.46 mIoU  |  135,168 attn pairs  (vs DINOv3: 83.56% / 57.74)',
  };

  function draw(c) {
    const w = canvas.clientWidth; const h = 240;
    if (canvas.width !== w * DPR || canvas.height !== h * DPR) {
      canvas.width = w * DPR; canvas.height = h * DPR; ctx.scale(DPR, DPR);
    }
    ctx.clearRect(0, 0, w, h);

    const d = data[c];
    const barW  = Math.min((w - 80) / 3.5, 140);
    const GAP   = 20;
    const baseX = (w - 2 * barW - GAP) / 2;
    const maxH  = h - 80;

    // Draw two bars: classification and segmentation
    const bars = [
      { label: 'ImageNet-1K', val: d.cls, max: 100, ref: teacher.cls, unit: '%', color: '#8b5cf6', refLabel: 'DINOv3 83.56' },
      { label: 'Context mIoU', val: d.seg, max: 65, ref: teacher.seg, unit: '',  color: '#06b6d4', refLabel: 'DINOv3 57.74' },
    ];

    bars.forEach((bar, i) => {
      const x = baseX + i * (barW + GAP);
      const barH = (bar.val / bar.max) * maxH;
      const refH = (bar.ref / bar.max) * maxH;

      // Reference line (teacher)
      const refY = h - 40 - refH;
      ctx.beginPath(); ctx.moveTo(x - 8, refY); ctx.lineTo(x + barW + 8, refY);
      ctx.strokeStyle = 'rgba(255,255,255,.2)'; ctx.setLineDash([5, 3]); ctx.lineWidth = 1; ctx.stroke(); ctx.setLineDash([]);
      ctx.fillStyle = '#4b5563'; ctx.font = `${9*DPR/DPR}px monospace`; ctx.textAlign = 'right';
      ctx.fillText(bar.refLabel, x - 10, refY + 3);

      // Bar
      const barY = h - 40 - barH;
      ctx.fillStyle = bar.color + '55';
      ctx.fillRect(x, barY, barW, barH);
      ctx.fillStyle = bar.color;
      ctx.fillRect(x, barY, barW, 3);

      // Value label
      ctx.fillStyle = '#e5e7eb'; ctx.font = `bold ${13*DPR/DPR}px monospace`; ctx.textAlign = 'center';
      ctx.fillText(bar.val + bar.unit, x + barW / 2, barY - 6);

      // Axis label
      ctx.fillStyle = '#6b7280'; ctx.font = `${10*DPR/DPR}px monospace`;
      ctx.fillText(bar.label, x + barW / 2, h - 10);
    });

    // C indicator
    ctx.fillStyle = '#8b5cf6'; ctx.font = `bold ${14*DPR/DPR}px monospace`; ctx.textAlign = 'center';
    ctx.fillText(`C = ${c} core tokens`, w / 2, 18);

    // Ops
    const opsK = (d.ops / 1000).toFixed(1);
    ctx.fillStyle = '#4b5563'; ctx.font = `${9*DPR/DPR}px monospace`;
    ctx.fillText(`attention pairs @ 512px: ${d.ops.toLocaleString()}`, w / 2, 30);

    document.getElementById('elastic-cap').textContent = caps[c];
  }

  draw(64);

  ['8','16','32','64'].forEach(c => {
    document.getElementById('eb-' + c)?.addEventListener('click', () => {
      document.querySelectorAll('.vp-btn[id^="eb-"]').forEach(b => b.classList.remove('active'));
      document.getElementById('eb-' + c).classList.add('active');
      activeC = parseInt(c);
      draw(activeC);
    });
  });
  window.addEventListener('resize', () => draw(activeC));
})();

/* ═══════════════════════════════════════════════════════
   §04 — Emergent Semantics canvas
═══════════════════════════════════════════════════════ */
(function() {
  const canvas = document.getElementById('emerge-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const NC = 24;  // number of core dots

  // Seeded PRNG for reproducibility
  function seededRand(n) { return ((1664525 * n + 1013904223) & 0x7fffffff) / 0x7fffffff; }

  // Semantic clusters in deep layer
  const clusters = [
    { cx: 0.25, cy: 0.35, color: '#8b5cf6', label: 'sky/background' },
    { cx: 0.65, cy: 0.28, color: '#06b6d4', label: 'foreground obj.' },
    { cx: 0.45, cy: 0.70, color: '#10b981', label: 'ground/texture' },
    { cx: 0.78, cy: 0.65, color: '#f59e0b', label: 'edges/boundary' },
  ];

  // Assign each dot to a cluster
  const dots = Array.from({ length: NC }, (_, i) => ({
    startX: seededRand(i * 4),
    startY: seededRand(i * 4 + 1),
    cluster: Math.floor(seededRand(i * 4 + 2) * clusters.length),
    jitter: { x: (seededRand(i * 4 + 3) - 0.5) * 0.08, y: (seededRand(i * 100) - 0.5) * 0.08 },
  }));

  let t = 0; // 0 = isotropic (early), 1 = semantic (deep)
  let animId = null;
  let playing = false;

  function easeInOut(t) { return t < 0.5 ? 2*t*t : -1 + (4 - 2*t)*t; }

  function drawFrame(rawT) {
    const w = canvas.clientWidth; const h = 280;
    if (canvas.width !== w * DPR || canvas.height !== h * DPR) {
      canvas.width = w * DPR; canvas.height = h * DPR; ctx.scale(DPR, DPR);
    }
    ctx.clearRect(0, 0, w, h);

    const eased = easeInOut(rawT);
    const layerNum = Math.round(rawT * 12);
    document.getElementById('emerge-t-label').textContent = layerNum;

    // Draw cluster labels at t > 0.6
    if (eased > 0.4) {
      const labelAlpha = Math.max(0, (eased - 0.4) / 0.3);
      clusters.forEach(cl => {
        const cx = cl.cx * w;
        const cy = cl.cy * h;
        ctx.globalAlpha = labelAlpha * 0.55;
        ctx.beginPath(); ctx.arc(cx, cy, 28, 0, Math.PI * 2);
        ctx.fillStyle = cl.color;
        ctx.fill();
        ctx.globalAlpha = labelAlpha;
        ctx.fillStyle = cl.color; ctx.font = `${10*DPR/DPR}px monospace`; ctx.textAlign = 'center';
        ctx.fillText(cl.label, cx, cy + 42);
        ctx.globalAlpha = 1;
      });
    }

    // Draw dots
    dots.forEach((dot, i) => {
      const cl = clusters[dot.cluster];
      // Interpolate from random start position to cluster center + jitter
      const tx = dot.startX * w;
      const ty = dot.startY * h;
      const ex = cl.cx * w + dot.jitter.x * w;
      const ey = cl.cy * h + dot.jitter.y * h;
      const x = tx + (ex - tx) * eased;
      const y = ty + (ey - ty) * eased;

      ctx.beginPath(); ctx.arc(x, y, 5, 0, Math.PI * 2);
      ctx.fillStyle = cl.color;
      ctx.globalAlpha = 0.5 + eased * 0.5;
      ctx.fill();
      ctx.globalAlpha = 1;
    });

    // Layer depth indicator
    ctx.fillStyle = '#4b5563'; ctx.font = `${10*DPR/DPR}px monospace`; ctx.textAlign = 'left';
    ctx.fillText(eased < 0.3 ? 'isotropic — no semantic structure' : eased > 0.7 ? 'semantic clusters emerging' : 'transitioning...', 10, h - 8);
  }

  drawFrame(0);

  const playBtn = document.getElementById('emerge-play');
  const resetBtn = document.getElementById('emerge-reset');

  function animate() {
    t += 0.008;
    if (t >= 1) { t = 1; drawFrame(t); playing = false; playBtn.textContent = '▶ Play'; return; }
    drawFrame(t);
    animId = requestAnimationFrame(animate);
  }

  playBtn?.addEventListener('click', () => {
    if (playing) {
      cancelAnimationFrame(animId); playing = false; playBtn.textContent = '▶ Play';
    } else {
      if (t >= 1) t = 0;
      playing = true; playBtn.textContent = '⏸ Pause';
      animate();
    }
  });
  resetBtn?.addEventListener('click', () => {
    cancelAnimationFrame(animId); playing = false; t = 0;
    playBtn.textContent = '▶ Play'; drawFrame(0);
    document.getElementById('emerge-t-label').textContent = '0';
  });
  window.addEventListener('resize', () => drawFrame(t));
})();

/* ═══════════════════════════════════════════════════════
   §05 — Animated bar charts
═══════════════════════════════════════════════════════ */
(function() {
  const MAX_VAL = 60; // scale for segmentation bars

  // For seg bars, scale to 60 mIoU as 100%
  document.querySelectorAll('#bars-seg .bar-fill').forEach(b => {
    const w = parseFloat(b.dataset.w);
    b.style.setProperty('--target-w', (w / MAX_VAL * 100) + '%');
  });
  // For cls bars, scale to 100%
  document.querySelectorAll('#bars-cls .bar-fill').forEach(b => {
    const w = parseFloat(b.dataset.w);
    b.style.setProperty('--target-w', w + '%');
  });

  function triggerBars(container) {
    container.querySelectorAll('.bar-fill').forEach(b => {
      b.style.width = b.style.getPropertyValue('--target-w');
    });
  }

  const segSection = document.getElementById('s-results');
  if (segSection) {
    new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          triggerBars(document.getElementById('bars-seg'));
          triggerBars(document.getElementById('bars-cls'));
        }
      });
    }, { threshold: 0.2 }).observe(segSection);
  }
})();
</script>
</BaseLayout>

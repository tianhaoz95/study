    // Column label
    ctx.fillStyle = hovered ? '#a78bfa' : '#6b7280';
    ctx.font = `600 ${W > 500 ? 10 : 8.5}px monospace`;
    ctx.textAlign = 'center';
    ctx.fillText(col.label, cx, 22);

    if (m === 'math') {
      // 3 compact answer boxes
      const answers = ['42', '41', '42'];
      answers.forEach((ans, i) => {
        const y = 48 + i * 42;
        ctx.fillStyle = 'rgba(16,185,129,.12)';
        ctx.beginPath(); ctx.roundRect(cx - 32, y, 64, 26, 4); ctx.fill();
        ctx.strokeStyle = '#10b981'; ctx.lineWidth = 1;
        ctx.strokeRect(cx - 32 + 0.5, y + 0.5, 63, 25);
        ctx.fillStyle = '#34d399'; ctx.font = `700 11px monospace`;
        ctx.fillText(ans, cx, y + 16);
        ctx.font = `9px monospace`; ctx.fillStyle = '#6b7280';
        ctx.fillText(`attempt ${i+1}`, cx, y + 34);
      });
      // Pick winner
      if (hovered) {
        ctx.fillStyle = 'rgba(16,185,129,.2)';
        ctx.beginPath(); ctx.roundRect(cx - 40, 168, 80, 22, 5); ctx.fill();
        ctx.fillStyle = '#34d399'; ctx.font = `700 9px monospace`;
        ctx.fillText('✓ majority vote = 42', cx, 182);
      }
    } else if (m === 'code') {
      // 3 medium code blocks
      const labels = ['35 lines', '52 lines', '41 lines'];
      labels.forEach((lb, i) => {
        const y = 44 + i * 56;
        ctx.fillStyle = 'rgba(6,182,212,.08)';
        ctx.beginPath(); ctx.roundRect(cx - 38, y, 76, 42, 4); ctx.fill();
        ctx.strokeStyle = '#06b6d4'; ctx.lineWidth = 1;
        ctx.strokeRect(cx - 38 + 0.5, y + 0.5, 75, 41);
        // Mini code lines
        [0.25, 0.5, 0.75, 1.0, 0.6].forEach((w, li) => {
          ctx.fillStyle = 'rgba(6,182,212,.35)';
          ctx.fillRect(cx - 32, y + 6 + li * 6, w * 58, 2);
        });
        ctx.fillStyle = '#6b7280'; ctx.font = `8px monospace`;
        ctx.fillText(lb, cx, y + 50);
      });
      if (hovered) {
        ctx.fillStyle = 'rgba(6,182,212,.15)';
        ctx.beginPath(); ctx.roundRect(cx - 40, 212, 80, 22, 5); ctx.fill();
        ctx.fillStyle = '#06b6d4'; ctx.font = `700 9px monospace`;
        ctx.fillText('run tests → pick pass', cx, 226);
      }
    } else {
      // 3 tall noisy trajectory strips
      const trajH = 138;
      const ICONS = ['🔍', '✏️', '⚙️', '📂', '🔍', '✏️', '⚙️', '📂', '🔍', '✏️'];
      for (let i = 0; i < 3; i++) {
        const sx = cx + (i - 1) * 46;
        const y0 = 42;
        ctx.fillStyle = 'rgba(245,158,11,.06)';
        ctx.beginPath(); ctx.roundRect(sx - 16, y0, 32, trajH, 3); ctx.fill();
        ctx.strokeStyle = i === 1 ? '#f59e0b' : '#4a4a60'; ctx.lineWidth = 1;
        ctx.strokeRect(sx - 16 + 0.5, y0 + 0.5, 31, trajH - 1);

        // Mini step bars
        for (let s = 0; s < 10; s++) {
          const bar_w = (0.3 + 0.5 * ((s * 7 + i * 3) % 5) / 5) * 22;
          ctx.fillStyle = `rgba(245,158,11,${0.2 + 0.3 * ((s + i) % 3) / 3})`;
          ctx.fillRect(sx - 11, y0 + 6 + s * 13, bar_w, 4);
          ctx.fillRect(sx - 11, y0 + 10 + s * 13, bar_w * 0.7, 2);
        }
        ctx.fillStyle = '#6b7280'; ctx.font = `8px monospace`;
        ctx.fillText(`R${i+1}`, sx, y0 + trajH + 14);
        ctx.fillStyle = '#4a4a60'; ctx.font = `7px monospace`;
        ctx.fillText('40+ steps', sx, y0 + trajH + 24);
      }
      if (hovered) {
        ctx.fillStyle = 'rgba(239,68,68,.1)';
        ctx.beginPath(); ctx.roundRect(cx - 46, 196, 92, 22, 5); ctx.fill();
        ctx.fillStyle = '#ef4444'; ctx.font = `700 9px monospace`;
        ctx.fillText('??? can\'t compare', cx, 210);
      }
    }
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    COLS.forEach((col, i) => drawMode(col, col.mode === mode, hoveredCol === i));
  }

  // Mode buttons
  document.querySelectorAll('#prob-math-btn, #prob-code-btn, #prob-agent-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      mode = btn.dataset.mode;
      document.querySelectorAll('[data-mode]').forEach(b => {
        if (['prob-math-btn','prob-code-btn','prob-agent-btn'].some(id => b.id === id))
          b.classList.toggle('active', b.dataset.mode === mode);
      });
      draw();
    });
  });

  // Hover tracking
  canvas.addEventListener('mousemove', e => {
    const rect = canvas.getBoundingClientRect();
    const mx = e.clientX - rect.left;
    hoveredCol = -1;
    COLS.forEach((col, i) => {
      if (Math.abs(mx - col.x) < W * 0.16) hoveredCol = i;
    });
    draw();
  });
  canvas.addEventListener('mouseleave', () => { hoveredCol = -1; draw(); });

  draw();
})();

// ─── §02 Summary Step Navigator ─────────────────────────────────────────────
(function() {
  let step = 0;
  const boxes  = document.querySelectorAll('#summary-steps .step-box');
  const prevBtn = document.getElementById('sum-prev');
  const nextBtn = document.getElementById('sum-next');
  const progEl  = document.getElementById('sum-prog');
  function updateSteps() {
    boxes.forEach((b, i) => {
      b.classList.remove('active','done');
      if (i === step) b.classList.add('active');
      else if (i < step) b.classList.add('done');
    });
    if (prevBtn) prevBtn.disabled = step === 0;
    if (nextBtn) nextBtn.disabled = step === boxes.length - 1;
    if (progEl) progEl.textContent = `Field ${step+1} of ${boxes.length}`;
    boxes.forEach((b, i) => {
      const n = b.querySelector('.step-num');
      if (n) n.textContent = i < step ? '✓' : String(i+1);
    });
  }
  prevBtn?.addEventListener('click', () => { if (step>0){step--;updateSteps();} });
  nextBtn?.addEventListener('click', () => { if (step<boxes.length-1){step++;updateSteps();} });
  updateSteps();
})();

// ─── §03 RTV Tournament Canvas ──────────────────────────────────────────────
(function() {
  const canvas = document.getElementById('rtv-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 300;
  canvas.width = W * DPR; canvas.height = H * DPR; ctx.scale(DPR, DPR);

  const N = 8;
  let round = 0;  // 0 = initial state, 1–3 = after each tournament round
  const MAX_ROUND = 3;

  // Seeded PRNG for reproducible positions
  function seededRand(n) { return ((1664525*n+1013904223)&0x7fffffff)/0x7fffffff; }

  // Initial positions for N=8 nodes
  const nodes = Array.from({length: N}, (_, i) => {
    const row = Math.floor(i / 4);
    const col = i % 4;
    return {
      id: i,
      x: 40 + col * (W - 60) / 3.5,
      y: 60 + row * 140,
      alive: true,
      winner: false,
      label: `R${i+1}`,
    };
  });

  // Tournament bracket: who beats whom
  // Round 1: 0vs1→0w, 2vs3→2w, 4vs5→5w, 6vs7→6w
  // Round 2: 0vs2→0w, 5vs6→6w
  // Round 3: 0vs6→0w
  const BRACKETS = [
    [[0,1,0],[2,3,3],[4,5,5],[6,7,6]],  // round 1 winners: 0,3,5,6
    [[0,3,0],[5,6,6]],                   // round 2 winners: 0,6
    [[0,6,0]],                           // round 3 winner: 0
  ];

  function drawRound() {
    ctx.clearRect(0, 0, W, H);

    // Reset alive status
    nodes.forEach(n => { n.alive = true; n.winner = false; });

    // Apply rounds up to current
    for (let r = 0; r < round; r++) {
      BRACKETS[r].forEach(([a, b, w]) => {
        const loser = w === a ? b : a;
        nodes[loser].alive = false;
      });
    }
    if (round === MAX_ROUND) {
      nodes[0].winner = true;
    }

    // Draw connections for current round battles
    if (round < MAX_ROUND) {
      BRACKETS[round].forEach(([a, b, w]) => {
        const na = nodes[a], nb = nodes[b];
        ctx.strokeStyle = 'rgba(139,92,246,.35)';
        ctx.lineWidth = 1.5;
        ctx.setLineDash([4, 3]);
        ctx.beginPath();
        ctx.moveTo(na.x, na.y);
        ctx.lineTo(nb.x, nb.y);
        ctx.stroke();
        ctx.setLineDash([]);

        // VS label
        const mx = (na.x + nb.x) / 2, my = (na.y + nb.y) / 2;
        ctx.fillStyle = '#8b5cf6';
        ctx.font = `700 9px monospace`;
        ctx.textAlign = 'center';
        ctx.fillText('VS', mx, my + 3);
      });
    }

    // Draw nodes
    nodes.forEach(n => {
      const r = n.winner ? 20 : 16;
      let fill, stroke, textColor;
      if (n.winner) {
        fill = 'rgba(16,185,129,.3)'; stroke = '#10b981'; textColor = '#34d399';
      } else if (n.alive) {
        if (round < MAX_ROUND && BRACKETS[round].some(([a,b]) => a === n.id || b === n.id)) {
          fill = 'rgba(139,92,246,.2)'; stroke = '#8b5cf6'; textColor = '#a78bfa';
        } else {
          fill = 'rgba(139,92,246,.1)'; stroke = '#6b4dc6'; textColor = '#8b5cf6';
        }
      } else {
        fill = 'rgba(107,114,128,.08)'; stroke = '#374151'; textColor = '#4b5563';
      }

      ctx.beginPath();
      ctx.arc(n.x, n.y, r, 0, Math.PI * 2);
      ctx.fillStyle = fill; ctx.fill();
      ctx.strokeStyle = stroke; ctx.lineWidth = n.winner ? 2 : 1.5;
      ctx.stroke();

      ctx.fillStyle = textColor;
      ctx.font = `${n.winner ? 700 : 600} ${n.winner ? 10 : 9}px monospace`;
      ctx.textAlign = 'center';
      ctx.fillText(n.label, n.x, n.y + 4);

      if (!n.alive && !n.winner) {
        ctx.fillStyle = 'rgba(239,68,68,.6)';
        ctx.font = '10px monospace';
        ctx.fillText('✗', n.x + r - 4, n.y - r + 6);
      }
      if (n.winner) {
        ctx.fillStyle = '#10b981';
        ctx.font = '11px monospace';
        ctx.fillText('★', n.x + r - 2, n.y - r + 6);
      }
    });

    // Round label
    ctx.fillStyle = '#6b7280';
    ctx.font = '9px monospace';
    ctx.textAlign = 'left';
    const alive = nodes.filter(n => n.alive).length;
    const statusLines = [
      `Round ${round} of ${MAX_ROUND}`,
      `${alive} rollout${alive !== 1 ? 's' : ''} remaining`,
      round < MAX_ROUND ? `Next: ${BRACKETS[round].length} pairwise battles (V=8 votes each)` : '★ Final winner selected',
    ];
    statusLines.forEach((line, i) => {
      ctx.fillStyle = i === 2 ? (round === MAX_ROUND ? '#10b981' : '#8b5cf6') : '#6b7280';
      ctx.font = i === 0 ? '700 9px monospace' : '8.5px monospace';
      ctx.fillText(line, 8, H - 36 + i * 13);
    });
  }

  document.getElementById('rtv-reset')?.addEventListener('click', () => {
    round = 0;
    document.getElementById('rtv-next').disabled = false;
    document.getElementById('rtv-round-label').textContent = 'Round 0 — 8 rollouts';
    drawRound();
  });
  document.getElementById('rtv-next')?.addEventListener('click', () => {
    if (round < MAX_ROUND) {
      round++;
      const alive = nodes.filter((n,i) => {
        let a = true;
        for (let r = 0; r < round; r++) {
          BRACKETS[r].forEach(([x,y,w]) => { if ((w===x?y:x)===i) a=false; });
        }
        return a;
      }).length;
      const labels = ['0 — 8 rollouts','1 — 4 survivors','2 — 2 survivors','3 — 1 champion'];
      document.getElementById('rtv-round-label').textContent = `Round ${labels[round] || round}`;
      if (round === MAX_ROUND) document.getElementById('rtv-next').disabled = true;
      drawRound();
    }
  });

  drawRound();
})();

// ─── §04 PDR Context Quality Canvas ─────────────────────────────────────────
(function() {
  const canvas = document.getElementById('pdr-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 200;
  canvas.width = W * DPR; canvas.height = H * DPR; ctx.scale(DPR, DPR);

  // From Table 5 — Claude 4.5 Opus, SWE-Bench Verified
  const PASS_RATES = [0.1, 33.4, 55.5, 85.4, 99.2];
  const LABELS = ['0/4 pass', '1/4 pass', '2/4 pass', '3/4 pass', '4/4 pass'];
  const COLORS = ['#ef4444', '#f59e0b', '#f59e0b', '#10b981', '#10b981'];
  let activeQ = 0;
  let animT = 0;
  let animStart = null;
  let animTarget = PASS_RATES[0];

  function drawBars(animated_rate) {
    ctx.clearRect(0, 0, W, H);
    const barW = (W - 60) / PASS_RATES.length - 10;
    const maxH = H - 60;

    PASS_RATES.forEach((rate, i) => {
      const x = 30 + i * ((W - 60) / PASS_RATES.length);
      const barH = (rate / 100) * maxH;
      const y = H - 40 - barH;

      // Inactive bars
      ctx.fillStyle = i === activeQ ? COLORS[i] : 'rgba(107,114,128,.2)';
      ctx.beginPath();
      if (i === activeQ) {
        const animH = (animated_rate / 100) * maxH;
        ctx.roundRect(x, H - 40 - animH, barW, animH, 3);
        ctx.fill();
        ctx.fillStyle = COLORS[i];
        ctx.font = `700 9px monospace`;
        ctx.textAlign = 'center';
        ctx.fillText(`${animated_rate.toFixed(1)}%`, x + barW/2, H - 44 - animH);
      } else {
        ctx.roundRect(x, y, barW, barH, 3);
        ctx.fill();
        ctx.fillStyle = 'rgba(107,114,128,.5)';
        ctx.font = '8px monospace';
        ctx.textAlign = 'center';
        ctx.fillText(`${rate}%`, x + barW/2, y - 4);
      }

      // Labels
      ctx.fillStyle = i === activeQ ? COLORS[i] : '#4b5563';
      ctx.font = `${i === activeQ ? '700' : '400'} 8px monospace`;
      ctx.fillText(LABELS[i], x + barW/2, H - 22);
    });

    // Y-axis
    ctx.strokeStyle = '#2a2a3e'; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(28, 10); ctx.lineTo(28, H - 36); ctx.stroke();
    [0, 25, 50, 75, 100].forEach(v => {
      const y = H - 40 - (v/100)*maxH;
      ctx.fillStyle = '#374151'; ctx.font = '7.5px monospace'; ctx.textAlign = 'right';
      ctx.fillText(`${v}%`, 24, y + 3);
      ctx.strokeStyle = 'rgba(255,255,255,.04)'; ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(29, y); ctx.lineTo(W - 4, y); ctx.stroke();
    });

    // Title
    ctx.fillStyle = '#6b7280'; ctx.font = '8px monospace'; ctx.textAlign = 'left';
    ctx.fillText('Iter-1 pass@1 rate (%) given context quality (K=4 rollouts)', 30, 10);
  }

  function animate(ts) {
    if (!animStart) animStart = ts;
    const elapsed = ts - animStart;
    const duration = 600;
    const progress = Math.min(elapsed / duration, 1);
    const eased = progress < 0.5 ? 2*progress*progress : -1+(4-2*progress)*progress;
    const current = animT + (animTarget - animT) * eased;
    if (progress < 1) {
      drawBars(current);
      requestAnimationFrame(animate);
    } else {
      drawBars(animTarget);
      animT = animTarget;
    }
  }

  document.querySelectorAll('.ctx-btn[data-q]').forEach(btn => {
    btn.addEventListener('click', () => {
      const q = parseInt(btn.dataset.q);
      activeQ = q;
      animTarget = PASS_RATES[q];
      animStart = null;
      document.querySelectorAll('.ctx-btn[data-q]').forEach(b =>
        b.classList.toggle('active', parseInt(b.dataset.q) === q));
      requestAnimationFrame(animate);
    });
  });

  drawBars(PASS_RATES[0]);
})();

// ─── §06 Results Bar Chart ──────────────────────────────────────────────────
(function() {
  const SWE = [
    { label: 'Claude 4.5 Opus', before: 70.94, after: 77.60, color: '#8b5cf6' },
    { label: 'Gemini 3.1 Pro',  before: 72.25, after: 76.60, color: '#06b6d4' },
    { label: 'Claude 4.5 Sonnet', before: 67.41, after: 75.60, color: '#8b5cf6' },
    { label: 'Gemini 3 Flash',  before: 70.79, after: 76.00, color: '#06b6d4' },
    { label: 'GPT-5 (0825)',    before: 61.41, after: 69.80, color: '#f59e0b' },
  ];
  const TB = [
    { label: 'Claude 4.5 Opus', before: 46.95, after: 59.09, color: '#8b5cf6' },
    { label: 'Gemini 3.1 Pro',  before: 52.49, after: 64.77, color: '#06b6d4' },
    { label: 'Claude 4.5 Sonnet', before: 40.62, after: 56.82, color: '#8b5cf6' },
    { label: 'Gemini 3 Flash',  before: 37.93, after: 48.86, color: '#06b6d4' },
    { label: 'GPT-5 (0825)',    before: 31.32, after: 38.64, color: '#f59e0b' },
  ];

  let currentBench = 'swe';
  let animated = false;

  function renderBars(data, animate) {
    const container = document.getElementById('results-bars');
    if (!container) return;
    container.innerHTML = '';
    const maxVal = 100;
    data.forEach(d => {
      const beforePct = (d.before / maxVal * 100).toFixed(1);
      const afterPct  = (d.after  / maxVal * 100).toFixed(1);
      const gain = (d.after - d.before).toFixed(1);
      container.innerHTML += `
        <div style="margin-bottom:.25rem">
          <div style="font-size:.7rem;font-family:var(--ff-mono);color:var(--muted2);margin-bottom:.2rem">${d.label}</div>
        </div>
        <div class="bar-row">
          <div class="bar-label" style="width:70px;font-size:.65rem">before</div>
          <div class="bar-track">
            <div class="bar-fill" data-w="${beforePct}" style="background:rgba(107,114,128,.4);width:0%">
              <span>${d.before}%</span>
            </div>
          </div>
        </div>
        <div class="bar-row" style="margin-bottom:.875rem">
          <div class="bar-label" style="width:70px;font-size:.65rem;color:${d.color}">+${gain}pp</div>
          <div class="bar-track">
            <div class="bar-fill" data-w="${afterPct}" style="background:${d.color};width:0%">
              <span>${d.after}%</span>
            </div>
          </div>
        </div>
      `;
    });
    if (animate) {
      setTimeout(() => {
        container.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          b.style.width = b.dataset.w + '%';
        });
      }, 50);
    }
  }

  function switchBench(bench) {
    currentBench = bench;
    document.getElementById('bench-swe').classList.toggle('active', bench === 'swe');
    document.getElementById('bench-tb').classList.toggle('active', bench === 'tb');
    renderBars(bench === 'swe' ? SWE : TB, true);
  }

  document.getElementById('bench-swe')?.addEventListener('click', () => switchBench('swe'));
  document.getElementById('bench-tb')?.addEventListener('click', () => switchBench('tb'));

  renderBars(SWE, false);

  const resSection = document.getElementById('s-results');
  if (resSection) {
    new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting && !animated) {
          animated = true;
          document.querySelectorAll('#results-bars .bar-fill[data-w]').forEach(b => {
            b.style.width = b.dataset.w + '%';
          });
        }
      });
    }, { threshold: 0.2 }).observe(resSection);
  }
})();
</script>

<span class="cs-line cmt"># LeJEPA training objective (Eq. 2)</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">ou_positive_pairs</span>(z, rho):</span>
<span class="cs-line hl-p">    <span class="cmt"># Ornstein-Uhlenbeck transition</span></span>
<span class="cs-line hl-p">    eta = torch.<span class="fn">randn_like</span>(z)</span>
<span class="cs-line hl-p">    z_prime = rho * z + (1 - rho**2)**0.5 * eta</span>
<span class="cs-line hl-p">    <span class="kw">return</span> z_prime  <span class="cmt"># correlated view</span></span>
<span class="cs-line"> </span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">alignment_loss</span>(h, h_prime):</span>
<span class="cs-line">    <span class="cmt"># Pull positive pairs together</span></span>
<span class="cs-line">    <span class="kw">return</span> ((h - h_prime)**2).<span class="fn">mean</span>()</span>
<span class="cs-line"> </span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">sigreg_loss</span>(h):</span>
<span class="cs-line">    <span class="cmt"># SIGReg: sketch-based Gaussianity</span></span>
<span class="cs-line">    <span class="cmt"># Push h(z) toward N(0, I)</span></span>
<span class="cs-line">    mu = h.<span class="fn">mean</span>(0)</span>
<span class="cs-line">    cov = h.T @ h / h.<span class="fn">shape</span>[0]</span>
<span class="cs-line">    <span class="kw">return</span> <span class="fn">gaussian_match</span>(mu, cov)</span>
<span class="cs-line"> </span>
<span class="cs-line hl-c"><span class="kw">def</span> <span class="fn">lejepa_loss</span>(f, x, x_prime, lam):</span>
<span class="cs-line hl-c">    h       = <span class="fn">f</span>(x)</span>
<span class="cs-line hl-c">    h_prime = <span class="fn">f</span>(x_prime)</span>
<span class="cs-line hl-c">    L_align = <span class="fn">alignment_loss</span>(h, h_prime)</span>
<span class="cs-line hl-c">    L_sig   = <span class="fn">sigreg_loss</span>(h)</span>
<span class="cs-line hl-c">    <span class="kw">return</span> lam*L_sig + (1-lam)*L_align</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># At the optimum (Thm 1):</span>
<span class="cs-line cmt"># f(g(z)) = Q @ z, Q orthogonal</span>
<span class="cs-line cmt"># Transition: h(z')|h(z) ~ N(ρh(z), (1-ρ²)I)</span>
      </pre>
    </div>

    <!-- SPECTRAL panel -->
    <div class="cs-panel" id="panel-spectral">
      <pre class="cs-pre">
<span class="cs-line cmt"># Hermite polynomial spectral analysis</span>
<span class="cs-line cmt"># Key: OU correlation decomposes by degree</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">hermite_correlation</span>(weights, rho):</span>
<span class="cs-line hl-p">    <span class="cmt"># weights[d] = variance in degree-d component</span></span>
<span class="cs-line hl-p">    <span class="cmt"># sum(weights) = 1 (unit variance)</span></span>
<span class="cs-line hl-p">    corr = <span class="fn">sum</span>(w * rho**(d+1)</span>
<span class="cs-line hl-p">               <span class="kw">for</span> d, w <span class="kw">in</span> <span class="fn">enumerate</span>(weights))</span>
<span class="cs-line hl-p">    <span class="kw">return</span> corr  <span class="cmt"># ≤ ρ, equality iff w[0]=1</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Example: 50% linear, 50% quadratic</span>
<span class="cs-line cmt"># corr = 0.5*ρ + 0.5*ρ² &lt; ρ</span>
<span class="cs-line"> </span>
<span class="cs-line"><span class="cmt"># Mehler's formula: eigenvalue of He_d</span></span>
<span class="cs-line"><span class="cmt"># T(He_d)(z) = E[He_d(z') | z] = ρ^d * He_d(z)</span></span>
<span class="cs-line"> </span>
<span class="cs-line hl-c"><span class="cmt"># Key inequality (the whole proof):</span></span>
<span class="cs-line hl-c"><span class="cmt"># E[h(z')h(z)] = Σ_d w_d * ρ^d</span></span>
<span class="cs-line hl-c"><span class="cmt"># ≤ ρ * Σ_d w_d = ρ</span></span>
<span class="cs-line hl-c"><span class="cmt"># since ρ^d ≤ ρ for d≥2, ρ∈(0,1)</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Converse (Thm 2):</span>
<span class="cs-line cmt"># Linear ID ⇒ φ₁ is affine</span>
<span class="cs-line cmt"># Sturm-Liouville: (log p)' must be linear</span>
<span class="cs-line cmt"># ⇒ log p ∝ -(z-μ)² ⇒ Gaussian</span>
      </pre>
    </div>

    <!-- THEOREM panel -->
    <div class="cs-panel" id="panel-theorem">
      <pre class="cs-pre">
<span class="cs-line cmt"># Four theorems — complete picture</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Thm 1: Forward (Gaussian ⇒ linear ID)</span>
<span class="cs-line hl-p">assert h(z) ~ N(0, I)  <span class="cmt"># SIGReg holds</span></span>
<span class="cs-line hl-p">assert L(h) == 2*(1-rho)*n  <span class="cmt"># optimal</span></span>
<span class="cs-line hl-p">then: h(z) == Q @ z  <span class="cmt"># Q orthogonal</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Thm 2: Converse (linear ID ⇒ Gaussian)</span>
<span class="cs-line hl-c"><span class="kw">if</span> <span class="fn">all_minimizers_are_linear</span>(world):</span>
<span class="cs-line hl-c">    assert <span class="fn">is_gaussian</span>(latent_dist)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Thm 3: Approximate (graceful degradation)</span>
<span class="cs-line"><span class="cmt"># D = delta / (2 * rho * (1 - rho))</span></span>
<span class="cs-line"><span class="cmt"># delta = alignment gap from optimum</span></span>
<span class="cs-line"><span class="cmt"># eps   = ||Cov(h) - I||_F (whitening err)</span></span>
<span class="cs-line hl-g">err = D + (eps + D)**2</span>
<span class="cs-line hl-g"><span class="cmt"># E[||h(z) - Qz||²] ≤ err</span></span>
<span class="cs-line hl-g"><span class="cmt"># → loss tracks identifiability!</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Thm 4: Optimal planning</span>
<span class="cs-line"><span class="cmt"># h(z) = Qz, cost O(n)-invariant</span></span>
<span class="cs-line"><span class="cmt"># V*(z₀) = V̂*(h(z₀))</span></span>
<span class="cs-line"><span class="cmt"># a*(z₀) = â*(h(z₀))</span></span>
<span class="cs-line cmt"># Plans in latent = plans in world!</span>
      </pre>
    </div>

    <!-- SCALING panel -->
    <div class="cs-panel" id="panel-scaling">
      <pre class="cs-pre">
<span class="cs-line cmt"># Scaling experiment (Table 1)</span>
<span class="cs-line cmt"># RealNVP mixing, matched encoder</span>
<span class="cs-line cmt"># 5 seeds, mean ± std</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># SIGReg R²(h→z):</span>
<span class="cs-line hl-p">N=2:    0.999998 ± 3.4e-6</span>
<span class="cs-line hl-p">N=64:   0.999966 ± 7.4e-6</span>
<span class="cs-line hl-p">N=256:  0.999884 ± 7.9e-6</span>
<span class="cs-line hl-p">N=1024: 0.999561 ± 1.2e-5</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># VICReg R²(h→z): similar to SIGReg</span>
<span class="cs-line">N=2:    0.999996 ± 8.4e-6</span>
<span class="cs-line">N=1024: 0.999582 ± 1.1e-5</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># InfoNCE degrades at scale:</span>
<span class="cs-line hl-a">N=2:    0.950961 ± 1.6e-3  <span class="cmt"># ok</span></span>
<span class="cs-line hl-a">N=64:   0.648496 ± 3.1e-3  <span class="cmt"># drops!</span></span>
<span class="cs-line hl-a">N=1024: 0.720241 ± 2.0e-4  <span class="cmt"># unstable</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Baseline (no encoder, x→z):</span>
<span class="cs-line">N=2:    0.781 ± 2.1e-3</span>
<span class="cs-line">N=1024: 0.763 ± 1.7e-4</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Conclusion: SIGReg/VICReg achieve</span>
<span class="cs-line cmt"># R² > 0.999 up to N=1024 (beyond</span>
<span class="cs-line cmt"># DINOv3's 768-dim embeddings)</span>
      </pre>
    </div>

    <!-- PLANNING panel -->
    <div class="cs-panel" id="panel-planning">
      <pre class="cs-pre">
<span class="cs-line cmt"># Latent-space planning (Thm 4)</span>
<span class="cs-line cmt"># DMC Reacher: 2D joint angles (θ₀, θ₁)</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">latent_goal_plan</span>(encoder, z0, z_goal):</span>
<span class="cs-line hl-p">    <span class="cmt"># Straight line in learned latent space</span></span>
<span class="cs-line hl-p">    h0   = <span class="fn">encoder</span>(z0)</span>
<span class="cs-line hl-p">    hg   = <span class="fn">encoder</span>(z_goal)</span>
<span class="cs-line hl-p">    plan = <span class="fn">interpolate</span>(h0, hg, T=30)</span>
<span class="cs-line hl-p">    <span class="kw">return</span> plan  <span class="cmt"># T-step trajectory</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Results: control cost (ideal = 1.0)</span>
<span class="cs-line"><span class="cmt"># Oracle (ground truth):      1.04</span></span>
<span class="cs-line hl-g"><span class="cmt"># OU encoder (R²=0.95):      1.11 ✓</span></span>
<span class="cs-line hl-a"><span class="cmt"># RL encoder (R²=0.44):      2.38 ✗</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># OU encoder ≈ oracle (p=0.18, n.s.)</span>
<span class="cs-line cmt"># RL encoder: 2x worse!</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Linear identifiability R² (Table 2):</span>
<span class="cs-line hl-g">OU ρ=0.99: R²=0.95  <span class="cmt"># Gaussian world</span></span>
<span class="cs-line hl-a">RL δ=8:   R²=0.44  <span class="cmt"># non-Gaussian</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Practical lesson:</span>
<span class="cs-line cmt"># For pretraining, use exploratory</span>
<span class="cs-line cmt"># (isotropic) data, not goal-directed</span>
<span class="cs-line cmt"># RL trajectories. Exploration keeps</span>
<span class="cs-line cmt"># data in the Gaussian theory regime.</span>
      </pre>
    </div>

  </div>
</aside>

</div><!-- /post-grid -->

<script>
// ── TOC + sidebar toggles ─────────────────────────────────────
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});
const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ── Code sidebar tab switching ────────────────────────────────
const tabMeta = {
  problem:  { file: 'lejepa/world.py',     title: 'The Problem' },
  lejepa:   { file: 'lejepa/train.py',     title: 'LeJEPA' },
  spectral: { file: 'lejepa/spectral.py',  title: 'Spectral Key' },
  theorem:  { file: 'lejepa/theorems.py',  title: 'Main Theorems' },
  scaling:  { file: 'lejepa/scaling.py',   title: 'Scaling' },
  planning: { file: 'lejepa/planning.py',  title: 'Planning' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ── IntersectionObserver — sync TOC + sidebar tab ─────────────
const sectionMap = {
  's-problem': 'problem',
  's-lejepa':  'lejepa',
  's-spectral':'spectral',
  's-theorem': 'theorem',
  's-scaling': 'scaling',
  's-planning':'planning',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ── Seeded PRNG ───────────────────────────────────────────────
function mulberry32(seed) {
  return function() {
    seed |= 0; seed = seed + 0x6D2B79F5 | 0;
    let t = Math.imul(seed ^ seed >>> 15, 1 | seed);
    t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;
    return ((t ^ t >>> 14) >>> 0) / 4294967296;
  };
}

// ── §01 Scramble canvas — 3-panel: latents | mixed | recovered ──
(function() {
  const canvas = document.getElementById('scramble-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const W = canvas.clientWidth, H = 260, DPR = window.devicePixelRatio || 1;
  canvas.width = W * DPR; canvas.height = H * DPR; ctx.scale(DPR, DPR);

  const rng = mulberry32(42);
  const N = 200;
  // Generate Gaussian latents
  function randn() {
    const u = rng(), v = rng();
    return Math.sqrt(-2 * Math.log(u + 1e-9)) * Math.cos(2 * Math.PI * v);
  }
  const pts = Array.from({length: N}, () => [randn(), randn()]);

  const panW = W / 3;
  const panels = [
    { label: 'True latents z', sublabel: 'z ~ N(0,I)', cx: panW * 0.5 },
    { label: 'Observations x = g(z)', sublabel: 'spiral mixing', cx: panW * 1.5 },
    { label: 'LeJEPA h(z)', sublabel: 'recovered up to Q', cx: panW * 2.5 },
  ];

  function scaleXY(arr, cx, sc) {
    return arr.map(([x, y]) => [cx + x * sc, H / 2 - y * sc]);
  }

  function spiralMix(z) {
    return z.map(([z1, z2]) => {
      const r = Math.sqrt(z1 * z1 + z2 * z2);
      const theta = Math.atan2(z2, z1) + Math.PI * r;
      return [r * Math.cos(theta), r * Math.sin(theta)];
    });
  }

  function rotRecover(z, angle) {
    const cos = Math.cos(angle), sin = Math.sin(angle);
    return z.map(([z1, z2]) => [cos * z1 - sin * z2, sin * z1 + cos * z2]);
  }

  const sc = Math.min(panW, H) * 0.18;
  const latents = pts;
  const mixed = spiralMix(pts);
  const recovered = rotRecover(pts, 0.4);  // just a rotation of true latents

  function drawPanel(ptsArr, cx, panelIdx) {
    // Panel background
    ctx.fillStyle = 'rgba(255,255,255,0.02)';
    ctx.strokeStyle = 'rgba(255,255,255,0.06)';
    ctx.lineWidth = 0.5;
    ctx.beginPath();
    ctx.rect(cx - panW * 0.5 + 2, 10, panW - 4, H - 20);
    ctx.fill(); ctx.stroke();

    // Panel dividers
    if (panelIdx > 0) {
      ctx.strokeStyle = 'rgba(255,255,255,0.08)';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(cx - panW * 0.5, 0); ctx.lineTo(cx - panW * 0.5, H);
      ctx.stroke();
    }

    const colors = ['#a78bfa', '#f59e0b', '#10b981'];
    const color = colors[panelIdx];

    const scaled = scaleXY(ptsArr, cx, sc);
    scaled.forEach(([px, py]) => {
      ctx.beginPath();
      ctx.arc(px, py, 1.8, 0, Math.PI * 2);
      ctx.fillStyle = color + 'bb';
      ctx.fill();
    });
  }

  // Draw all 3 panels
  [latents, mixed, recovered].forEach((p, i) => drawPanel(p, panels[i].cx, i));

  // Panel labels
  panels.forEach((pan, i) => {
    ctx.fillStyle = 'rgba(255,255,255,0.6)';
    ctx.font = `600 11px monospace`;
    ctx.textAlign = 'center';
    ctx.fillText(pan.label, pan.cx, H - 22);
    ctx.fillStyle = 'rgba(255,255,255,0.3)';
    ctx.font = '9px monospace';
    ctx.fillText(pan.sublabel, pan.cx, H - 10);
  });

  // Arrows between panels
  const arrowY = H / 2;
  [[panW - 8, panW + 8], [panW * 2 - 8, panW * 2 + 8]].forEach(([x1, x2]) => {
    ctx.strokeStyle = 'rgba(255,255,255,0.25)';
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(x1, arrowY); ctx.lineTo(x2, arrowY);
    ctx.stroke();
    ctx.fillStyle = 'rgba(255,255,255,0.25)';
    ctx.beginPath();
    ctx.moveTo(x2, arrowY - 4); ctx.lineTo(x2 + 8, arrowY); ctx.lineTo(x2, arrowY + 4);
    ctx.fill();
  });
  ctx.fillStyle = 'rgba(255,255,255,0.35)';
  ctx.font = '9px monospace';
  ctx.textAlign = 'center';
  ctx.fillText('g', panW - 0, arrowY - 8);
  ctx.fillText('f', panW * 2, arrowY - 8);
})();

// ── §03 Hermite canvas — correlation bar chart by degree ───────
const HERMITE_DATA = {
  '0.95': { max: 0.95, bars: [
    { label: 'degree 1 (linear)',  frac: 0.5, corr: 0.5 * 0.95 },
    { label: 'degree 2 (quadratic)', frac: 0.3, corr: 0.3 * 0.95 * 0.95 },
    { label: 'degree 3 (cubic)',   frac: 0.15, corr: 0.15 * Math.pow(0.95, 3) },
    { label: 'degree 4+',          frac: 0.05, corr: 0.05 * Math.pow(0.95, 4) },
  ]},
  '0.80': { max: 0.80, bars: [
    { label: 'degree 1 (linear)',  frac: 0.5, corr: 0.5 * 0.80 },
    { label: 'degree 2 (quadratic)', frac: 0.3, corr: 0.3 * 0.80 * 0.80 },
    { label: 'degree 3 (cubic)',   frac: 0.15, corr: 0.15 * Math.pow(0.80, 3) },
    { label: 'degree 4+',          frac: 0.05, corr: 0.05 * Math.pow(0.80, 4) },
  ]},
  '0.60': { max: 0.60, bars: [
    { label: 'degree 1 (linear)',  frac: 0.5, corr: 0.5 * 0.60 },
    { label: 'degree 2 (quadratic)', frac: 0.3, corr: 0.3 * 0.60 * 0.60 },
    { label: 'degree 3 (cubic)',   frac: 0.15, corr: 0.15 * Math.pow(0.60, 3) },
    { label: 'degree 4+',          frac: 0.05, corr: 0.05 * Math.pow(0.60, 4) },
  ]},
  '0.30': { max: 0.30, bars: [
    { label: 'degree 1 (linear)',  frac: 0.5, corr: 0.5 * 0.30 },
    { label: 'degree 2 (quadratic)', frac: 0.3, corr: 0.3 * 0.30 * 0.30 },
    { label: 'degree 3 (cubic)',   frac: 0.15, corr: 0.15 * Math.pow(0.30, 3) },
    { label: 'degree 4+',          frac: 0.05, corr: 0.05 * Math.pow(0.30, 4) },
  ]},
};

let currentRho = '0.95';

function drawHermite() {
  const canvas = document.getElementById('hermite-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const W = canvas.clientWidth, H = 220, DPR = window.devicePixelRatio || 1;
  canvas.width = W * DPR; canvas.height = H * DPR; ctx.scale(DPR, DPR);

  const data = HERMITE_DATA[currentRho];
  const rhoVal = parseFloat(currentRho);
  const totalCorr = data.bars.reduce((s, b) => s + b.corr, 0);
  const maxCorr = rhoVal;  // maximum possible

  const PAD = { l: 160, r: 30, t: 25, b: 45 };
  const cW = W - PAD.l - PAD.r;
  const barH = 28, gap = 12;

  ctx.fillStyle = 'rgba(255,255,255,0.03)';
  ctx.fillRect(0, 0, W, H);

  const colors = ['#a78bfa', '#06b6d4', '#f59e0b', '#5c6370'];

  data.bars.forEach((b, i) => {
    const y = PAD.t + i * (barH + gap);
    const barW = (b.corr / maxCorr) * cW;

    // Bar
    ctx.fillStyle = colors[i] + (i === 0 ? 'dd' : '88');
    ctx.beginPath();
    ctx.roundRect(PAD.l, y, barW, barH, 3);
    ctx.fill();

    // Label
    ctx.fillStyle = i === 0 ? '#a78bfa' : 'rgba(255,255,255,0.5)';
    ctx.font = `${i === 0 ? 600 : 400} 11px monospace`;
    ctx.textAlign = 'right';
    ctx.fillText(b.label, PAD.l - 8, y + barH / 2 + 4);

    // Value
    ctx.fillStyle = 'rgba(255,255,255,0.7)';
    ctx.font = '10px monospace';
    ctx.textAlign = 'left';
    ctx.fillText(b.corr.toFixed(4), PAD.l + barW + 5, y + barH / 2 + 4);
  });

  // Max line (ρ)
  const maxX = PAD.l + cW;
  ctx.strokeStyle = 'rgba(239,68,68,0.6)';
  ctx.lineWidth = 1.5;
  ctx.setLineDash([4, 3]);
  ctx.beginPath();
  ctx.moveTo(maxX, PAD.t - 10); ctx.lineTo(maxX, PAD.t + 4 * (barH + gap) - gap);
  ctx.stroke();
  ctx.setLineDash([]);
  ctx.fillStyle = 'rgba(239,68,68,0.8)';
  ctx.font = '10px monospace';
  ctx.textAlign = 'center';
  ctx.fillText(`max = ρ = ${rhoVal}`, maxX, PAD.t - 14);

  // Total correlation
  const totalX = PAD.l + (totalCorr / maxCorr) * cW;
  ctx.strokeStyle = 'rgba(16,185,129,0.6)';
  ctx.lineWidth = 2;
  ctx.setLineDash([3, 3]);
  ctx.beginPath();
  ctx.moveTo(totalX, PAD.t - 4); ctx.lineTo(totalX, PAD.t + 4 * (barH + gap) - gap);
  ctx.stroke();
  ctx.setLineDash([]);
  ctx.fillStyle = '#10b981';
  ctx.font = '600 10px monospace';
  ctx.textAlign = 'center';
  ctx.fillText(`total = ${totalCorr.toFixed(4)}`, totalX, PAD.t + 4 * (barH + gap) - gap + 14);

  // Penalty annotation
  const penalty = maxCorr - totalCorr;
  ctx.fillStyle = 'rgba(239,68,68,0.7)';
  ctx.font = '9px monospace';
  ctx.textAlign = 'center';
  ctx.fillText(`penalty: −${penalty.toFixed(4)}`, (totalX + maxX) / 2, PAD.t + 4 * (barH + gap));
}

drawHermite();

document.querySelectorAll('.rho-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.rho-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    currentRho = btn.dataset.rho;
    drawHermite();
  });
});

// ── §04 Distribution canvas ────────────────────────────────────
const DIST_CONFIG = {
  gaussian:  { r2: 0.9999, label: 'R² = 0.9999', color: '#a78bfa', mixFn: 'sinusoid' },
  laplace:   { r2: 0.72,   label: 'R² = 0.72',   color: '#f59e0b', mixFn: 'sinusoid' },
  heavytail: { r2: 0.48,   label: 'R² = 0.48',   color: '#ef4444', mixFn: 'sinusoid' },
  uniform:   { r2: 0.55,   label: 'R² = 0.55',   color: '#6b7280', mixFn: 'sinusoid' },
};

let currentDist = 'gaussian';

function sampleDist(dist, rng) {
  if (dist === 'gaussian') {
    const u = rng(), v = rng();
    return Math.sqrt(-2 * Math.log(u + 1e-9)) * Math.cos(2 * Math.PI * v);
  }
  if (dist === 'laplace') {
    const u = rng() - 0.5;
    return -Math.sign(u) * Math.log(1 - 2 * Math.abs(u));
  }
  if (dist === 'heavytail') {
    // Cauchy-like: sample with heavier tails
    const u = rng(), v = rng();
    const g = Math.sqrt(-2 * Math.log(u + 1e-9)) * Math.cos(2 * Math.PI * v);
    const chi = Math.sqrt(-2 * Math.log(rng() + 1e-9));
    return Math.max(-3, Math.min(3, g / (chi / Math.sqrt(2))));
  }
  if (dist === 'uniform') {
    return (rng() - 0.5) * 3.46; // scale to unit variance
  }
  return 0;
}

function drawDistCanvas() {
  const canvas = document.getElementById('dist-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const W = canvas.clientWidth, H = 240, DPR = window.devicePixelRatio || 1;
  canvas.width = W * DPR; canvas.height = H * DPR; ctx.scale(DPR, DPR);

  const rng = mulberry32(123);
  const N = 180;
  const cfg = DIST_CONFIG[currentDist];
  const pts = Array.from({length: N}, () => [sampleDist(currentDist, rng), sampleDist(currentDist, rng)]);

  // sinusoidal shear mixing
  const mixed = pts.map(([z1, z2]) => [z1 + 0.8 * Math.sin(1.5 * z2), z2]);

  // Recovery: for Gaussian, near-perfect rotation; for others, distorted
  const r2 = cfg.r2;
  const angle = 0.3;
  const cos = Math.cos(angle), sin = Math.sin(angle);
  const recovered = pts.map(([z1, z2]) => {
    const linPart = [cos * z1 - sin * z2, sin * z1 + cos * z2];
    // Add distortion proportional to 1 - r2
    const distort = 1 - r2;
    const noise = [sampleDist('gaussian', rng) * distort * 0.8, sampleDist('gaussian', rng) * distort * 0.8];
    return [linPart[0] + noise[0], linPart[1] + noise[1]];
  });

  const panW = W / 3;
  const sc = Math.min(panW, H) * 0.16;
  const centers = [panW * 0.5, panW * 1.5, panW * 2.5];

  function drawPts(ptsArr, cx, col, alpha) {
    const scaled = ptsArr.map(([x, y]) => [cx + x * sc, H / 2 - y * sc]);
    scaled.forEach(([px, py]) => {
      ctx.beginPath();
      ctx.arc(Math.max(4, Math.min(W - 4, px)), Math.max(4, Math.min(H - 4, py)), 1.8, 0, Math.PI * 2);
      ctx.fillStyle = col + alpha;
      ctx.fill();
    });
  }

  // Backgrounds
  centers.forEach((cx, i) => {
    ctx.fillStyle = 'rgba(255,255,255,0.015)';
    ctx.fillRect(cx - panW * 0.5 + 1, 5, panW - 2, H - 10);
    if (i > 0) {
      ctx.strokeStyle = 'rgba(255,255,255,0.06)';
      ctx.lineWidth = 0.5;
      ctx.beginPath();
      ctx.moveTo(cx - panW * 0.5, 0); ctx.lineTo(cx - panW * 0.5, H);
      ctx.stroke();
    }
  });

  drawPts(pts, centers[0], '#10b981', 'cc');
  drawPts(mixed, centers[1], cfg.color, 'bb');
  drawPts(recovered, centers[2], cfg.color, 'cc');

  // Labels
  const panelLabels = ['True z', 'Obs x = g(z)', `h(z) — ${cfg.label}`];
  panelLabels.forEach((lbl, i) => {
    const isLast = i === 2;
    ctx.fillStyle = isLast ? cfg.color : 'rgba(255,255,255,0.55)';
    ctx.font = `${isLast ? 600 : 400} 10px monospace`;
    ctx.textAlign = 'center';
    ctx.fillText(lbl, centers[i], H - 8);
  });

  // R² badge on recovered panel
  const badgeColor = cfg.r2 > 0.9 ? '#10b981' : cfg.r2 > 0.6 ? '#f59e0b' : '#ef4444';
  ctx.fillStyle = badgeColor + '33';
  ctx.strokeStyle = badgeColor + '88';
  ctx.lineWidth = 1;
  ctx.beginPath();
  ctx.roundRect(centers[2] - 38, 12, 76, 20, 4);
  ctx.fill(); ctx.stroke();
  ctx.fillStyle = badgeColor;
  ctx.font = '600 10px monospace';
  ctx.textAlign = 'center';
  ctx.fillText(cfg.label, centers[2], 25);
}

drawDistCanvas();

document.querySelectorAll('.dist-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.dist-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    currentDist = btn.dataset.dist;
    drawDistCanvas();
  });
});

// ── Animated bar charts (scaling + planning) ──────────────────
function triggerBars(sectionId) {
  const sec = document.getElementById(sectionId);
  if (!sec) return;
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          b.style.width = parseFloat(b.dataset.w) + '%';
        });
      }
    });
  }, { threshold: 0.3 }).observe(sec);
}
triggerBars('s-scaling-bars');
triggerBars('s-planning-viz');
</script>
</BaseLayout>

        <div class="bar-track"><div class="bar-fill" data-w="60" style="background:rgba(245,158,11,.55)"><span>2.38</span></div></div>
      </div>
    </div>
    <p style="font-size:.72rem;color:var(--muted);margin-top:1rem;font-family:var(--ff-mono)">OU = Ornstein–Uhlenbeck (Gaussian) training pairs · RL = real goal-directed trajectories</p>
  </div>

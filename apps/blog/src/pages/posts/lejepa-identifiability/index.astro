---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="When Does LeJEPA Learn a World Model? | Catpuccino.ai"
  description="A mathematical proof that LeJEPA — alignment plus Gaussian regularization — provably recovers the world's true latent variables, and only for Gaussian latents."
  crumb="LeJEPA Identifiability"
>


      <text x="316" y="81" text-anchor="middle" fill="#a78bfa" font-size="11" font-family="monospace">Encoder f</text>
      <text x="316" y="97" text-anchor="middle" fill="#a78bfa" font-size="10" font-family="monospace">(learned)</text>
      <text x="316" y="113" text-anchor="middle" fill="rgba(139,92,246,.6)" font-size="9" font-family="monospace">MLP / CNN</text>

      <!-- Arrow encoder→split -->

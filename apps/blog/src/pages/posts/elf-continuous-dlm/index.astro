    <!-- panel: problem -->
    <div class="cs-panel active" id="panel-problem">
      <pre class="cs-pre"><span class="cs-line cmt"># Why continuous DLMs lagged discrete ones</span>
<span class="cs-line cmt"># ─────────────────────────────────────────</span>
<span class="cs-line cmt"># Prior continuous DLMs (Diffusion-LM, CDCD,</span>
<span class="cs-line cmt"># DiffuSeq) added a per-step cross-entropy</span>
<span class="cs-line cmt"># loss to "guide" the trajectory:</span>
<span class="cs-line"></span>
<span class="cs-line"><span class="cmt"># OLD APPROACH (simplified):</span></span>
<span class="cs-line hl-p"><span class="kw">for</span> t <span class="kw">in</span> time_steps:</span>
<span class="cs-line hl-p">    x_pred = denoise(z_t, t)</span>
<span class="cs-line hl-p">    loss_mse = mse(x_pred, x_clean)</span>
<span class="cs-line hl-p">    loss_ce = cross_entropy(  <span class="cmt"># ← every step!</span></span>
<span class="cs-line hl-p">        unembed(x_pred), tokens)</span>
<span class="cs-line hl-p">    loss = loss_mse + loss_ce</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># This "anchor" to discrete space at every</span>
<span class="cs-line cmt"># step prevents the flow from moving freely</span>
<span class="cs-line cmt"># through continuous embedding space.</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># ─────────────────────────────────────────</span>
<span class="cs-line cmt"># Discrete DLMs (MDLM, Duo) don't have this</span>
<span class="cs-line cmt"># tension — they operate directly over token</span>
<span class="cs-line cmt"># indices with categorical distributions:</span>
<span class="cs-line"></span>
<span class="cs-line"><span class="cmt"># MDLM (masked diffusion):</span></span>
<span class="cs-line"><span class="cmt"># x_t = MASK with prob (1-t), else x_0</span></span>
<span class="cs-line"><span class="cmt"># → predict unmasked tokens directly</span></span>
<span class="cs-line"><span class="cmt"># → no continuous space issues</span></span>
<span class="cs-line"><span class="cmt"># → but no CFG either (discrete velocity?)</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># ELF's solution: let the flow be free,</span>
<span class="cs-line cmt"># discretize exactly ONCE at the end.</span></pre>
    </div>

    <!-- panel: flow -->
    <div class="cs-panel" id="panel-flow">
      <pre class="cs-pre"><span class="cs-line cmt"># Flow Matching math for ELF</span>
<span class="cs-line cmt"># ─────────────────────────────────────────</span>
<span class="cs-line"><span class="cmt"># Rectified flow interpolant:</span></span>
<span class="cs-line hl-c">  z_t = t * x + (1 - t) * epsilon</span>
<span class="cs-line hl-c">  <span class="cmt"># x   = clean embedding (from T5 encoder)</span></span>
<span class="cs-line hl-c">  <span class="cmt"># eps = Gaussian noise N(0, I)</span></span>
<span class="cs-line hl-c">  <span class="cmt"># t   = time ∈ [0, 1]</span></span>
<span class="cs-line"></span>
<span class="cs-line"><span class="cmt"># True velocity (constant along path):</span></span>
<span class="cs-line hl-p">  v = dz/dt = x - epsilon</span>
<span class="cs-line"></span>
<span class="cs-line"><span class="cmt"># x-prediction parameterization:</span></span>
<span class="cs-line hl-g">  x_hat = net(z_t, t, mode="denoise")</span>
<span class="cs-line hl-g">  v_hat = (x_hat - z_t) / (1 - t)</span>
<span class="cs-line"></span>
<span class="cs-line"><span class="cmt"># MSE training loss (weighted):</span></span>
<span class="cs-line">  L_MSE = E[</span>
<span class="cs-line">    (1/(1-t))^2</span>
<span class="cs-line">    * ||x_hat - x||^2</span>
<span class="cs-line">  ]</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Why x-prediction (not v-prediction)?</span>
<span class="cs-line cmt"># 1. More stable in high-dim embedding space</span>
<span class="cs-line cmt"># 2. Output space = clean embeddings = same</span>
<span class="cs-line cmt">#    as what the decode branch produces</span>
<span class="cs-line cmt">#    → weight sharing works naturally</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># If you used v-prediction:</span>
<span class="cs-line cmt"># v is a direction, not an embedding point</span>
<span class="cs-line cmt"># → decode branch needs different output head</span>
<span class="cs-line cmt"># → no clean weight sharing</span></pre>
    </div>

    <!-- panel: elf -->
    <div class="cs-panel" id="panel-elf">
      <pre class="cs-pre"><span class="cs-line cmt"># ELF full training algorithm</span>
<span class="cs-line cmt"># ─────────────────────────────────────────</span>
<span class="cs-line kw">def</span> <span class="fn">elf_train_step</span>(tokens, net, encoder):</span>
<span class="cs-line"></span>
<span class="cs-line hl-c">    <span class="cmt"># 1. Encode tokens to continuous space</span></span>
<span class="cs-line hl-c">    x = encoder(tokens)  <span class="cmt"># T5-small frozen</span></span>
<span class="cs-line hl-c">    <span class="cmt"># x: [L, 512] contextual embeddings</span></span>
<span class="cs-line"></span>
<span class="cs-line">    <span class="kw">if</span> rand() &lt; <span class="num">0.8</span>:</span>
<span class="cs-line hl-p">        <span class="cmt"># DENOISING BRANCH (80%)</span></span>
<span class="cs-line hl-p">        t = sample_t()        <span class="cmt"># uniform [0,1)</span></span>
<span class="cs-line hl-p">        eps = randn_like(x)</span>
<span class="cs-line hl-p">        z_t = t*x + (1-t)*eps  <span class="cmt"># corrupt</span></span>
<span class="cs-line hl-p">        x_hat = net(z_t, t, <span class="str">"denoise"</span>)</span>
<span class="cs-line hl-p">        v_hat = (x_hat - z_t) / (1-t)</span>
<span class="cs-line hl-p">        v_true = x - eps</span>
<span class="cs-line hl-p">        loss = mse(v_hat, v_true)</span>
<span class="cs-line">    <span class="kw">else</span>:</span>
<span class="cs-line hl-g">        <span class="cmt"># DECODING BRANCH (20%)</span></span>
<span class="cs-line hl-g">        z_tilde = corrupt(x)  <span class="cmt"># nontrivial input</span></span>
<span class="cs-line hl-g">        x_hat = net(z_tilde, <span class="num">1.0</span>, <span class="str">"decode"</span>)</span>
<span class="cs-line hl-g">        logits = unembed(x_hat)  <span class="cmt"># W @ x_hat</span></span>
<span class="cs-line hl-g">        loss = cross_entropy(logits, tokens)</span>
<span class="cs-line"></span>
<span class="cs-line">    <span class="kw">return</span> loss</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Key: both branches use the SAME net()</span>
<span class="cs-line cmt"># differentiated only by mode token + t</span>
<span class="cs-line cmt"># The unembedding matrix W is shared too</span></pre>
    </div>

    <!-- panel: final -->
    <div class="cs-panel" id="panel-final">
      <pre class="cs-pre"><span class="cs-line cmt"># The final-step discretization trick</span>
<span class="cs-line cmt"># ─────────────────────────────────────────</span>
<span class="cs-line cmt"># Problem: at t=1, z_t → x (clean)</span>
<span class="cs-line cmt"># So the decoding input is trivially clean:</span>
<span class="cs-line cmt"># the network just memorizes x → tokens</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Fix: corrupt x before passing to decoder</span>
<span class="cs-line kw">def</span> <span class="fn">corrupt</span>(x):</span>
<span class="cs-line hl-p">    <span class="cmt"># mask some positions + add noise</span></span>
<span class="cs-line hl-p">    mask = rand(x.shape[0]) &lt; mask_rate</span>
<span class="cs-line hl-p">    noise = randn_like(x) * noise_scale</span>
<span class="cs-line hl-p">    x_corrupted = x.clone()</span>
<span class="cs-line hl-p">    x_corrupted[mask] += noise[mask]</span>
<span class="cs-line hl-p">    <span class="kw">return</span> x_corrupted</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Two decoding strategies compared:</span>
<span class="cs-line"></span>
<span class="cs-line"><span class="cmt"># 1. SHARED-WEIGHT (ELF default)</span></span>
<span class="cs-line hl-g"><span class="cmt">#    Stage 1+2 = same net, mode token tells</span></span>
<span class="cs-line hl-g"><span class="cmt">#    it whether to denoise or decode</span></span>
<span class="cs-line hl-g"><span class="cmt">#    Pro: single model, simpler pipeline</span></span>
<span class="cs-line hl-g"><span class="cmt">#    Pushes further toward low PPL regime</span></span>
<span class="cs-line"></span>
<span class="cs-line"><span class="cmt"># 2. SEPARATE DECODER (ablation)</span></span>
<span class="cs-line hl-c"><span class="cmt">#    Stage 1: train T5 decoder on masked emb</span></span>
<span class="cs-line hl-c"><span class="cmt">#    Stage 2: freeze encoder+decoder,</span></span>
<span class="cs-line hl-c"><span class="cmt">#             train separate denoiser</span></span>
<span class="cs-line hl-c"><span class="cmt">#    Con: two training stages, extra params</span></span>
<span class="cs-line hl-c"><span class="cmt">#    Comparable but doesn't reach lowest PPL</span></span></pre>
    </div>

    <!-- panel: guidance -->
    <div class="cs-panel" id="panel-guidance">
      <pre class="cs-pre"><span class="cs-line cmt"># Classifier-Free Guidance in ELF</span>
<span class="cs-line cmt"># ─────────────────────────────────────────</span>
<span class="cs-line cmt"># CFG blends conditional + unconditional:</span>
<span class="cs-line hl-p">  v_cfg = w * v(z|c) + (1-w) * v(z|null)</span>
<span class="cs-line hl-p">  <span class="cmt"># w > 1: amplify condition direction</span></span>
<span class="cs-line hl-p">  <span class="cmt"># w = 1: standard conditional</span></span>
<span class="cs-line hl-p">  <span class="cmt"># w = 0: unconditional</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># In ELF (x-prediction form):</span>
<span class="cs-line hl-c">  x_cfg = w * x(z|c) + (1-w) * x(z|null)</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Self-conditioning (condition = prev pred):</span>
<span class="cs-line kw">def</span> <span class="fn">inference_step</span>(z, t, x_prev):</span>
<span class="cs-line hl-g">    <span class="cmt"># Concat previous prediction as condition</span></span>
<span class="cs-line hl-g">    inp = concat([z, x_prev], dim=-<span class="num">1</span>)</span>
<span class="cs-line hl-g">    x_cond = net(inp, t, <span class="str">"denoise"</span>)</span>
<span class="cs-line"></span>
<span class="cs-line hl-g">    <span class="cmt"># Null condition = zeros</span></span>
<span class="cs-line hl-g">    x_null = net(concat([z, zeros], dim=-<span class="num">1</span>),</span>
<span class="cs-line hl-g">                 t, <span class="str">"denoise"</span>)</span>
<span class="cs-line"></span>
<span class="cs-line hl-g">    x_cfg = w * x_cond + (<span class="num">1</span>-w) * x_null</span>
<span class="cs-line hl-g">    <span class="kw">return</span> x_cfg</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Training-time CFG (avoids 2x forward pass)</span>
<span class="cs-line cmt"># Train the network to directly produce x_cfg</span>
<span class="cs-line cmt"># using the "Mean Flows" technique.</span>
<span class="cs-line cmt"># At inference: single forward pass, full CFG</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Trade-off summary:</span>
<span class="cs-line cmt"># w=1.0 → best diversity, higher PPL</span>
<span class="cs-line cmt"># w=2.0 → good balance (default)</span>
<span class="cs-line cmt"># w=3.0 → lowest PPL, less diversity</span></pre>
    </div>

    <!-- panel: inference -->
    <div class="cs-panel" id="panel-inference">
      <pre class="cs-pre"><span class="cs-line cmt"># ELF inference (ODE + SDE variants)</span>
<span class="cs-line cmt"># ─────────────────────────────────────────</span>
<span class="cs-line kw">def</span> <span class="fn">elf_sample</span>(L, steps=<span class="num">32</span>, sde=<span class="kw">True</span>):</span>
<span class="cs-line hl-p">    <span class="cmt"># Init: pure Gaussian noise</span></span>
<span class="cs-line hl-p">    z = randn(L, d_emb)</span>
<span class="cs-line hl-p">    ts = linspace(<span class="num">0</span>, <span class="num">1</span>, steps)</span>
<span class="cs-line hl-p">    x_prev = zeros_like(z)  <span class="cmt"># self-cond init</span></span>
<span class="cs-line"></span>
<span class="cs-line">    <span class="kw">for</span> i <span class="kw">in</span> range(steps - <span class="num">1</span>):</span>
<span class="cs-line">        t = ts[i]; dt = ts[i+<span class="num">1</span>] - ts[i]</span>
<span class="cs-line hl-c"></span>
<span class="cs-line hl-c">        <span class="cmt"># Predict clean embedding</span></span>
<span class="cs-line hl-c">        x_hat = net(</span>
<span class="cs-line hl-c">            concat([z, x_prev], dim=-<span class="num">1</span>),</span>
<span class="cs-line hl-c">            t, <span class="str">"denoise"</span></span>
<span class="cs-line hl-c">        )</span>
<span class="cs-line hl-c">        v = (x_hat - z) / (<span class="num">1</span> - t)</span>
<span class="cs-line"></span>
<span class="cs-line">        <span class="kw">if</span> sde:</span>
<span class="cs-line hl-g">            <span class="cmt"># Inject noise, shift t back</span></span>
<span class="cs-line hl-g">            sigma = sde_noise_level(t)</span>
<span class="cs-line hl-g">            z = z + dt*v + sigma*randn_like(z)</span>
<span class="cs-line">        <span class="kw">else</span>:</span>
<span class="cs-line">            z = z + dt * v  <span class="cmt"># ODE Euler step</span></span>
<span class="cs-line"></span>
<span class="cs-line">        x_prev = x_hat  <span class="cmt"># update self-cond</span></span>
<span class="cs-line"></span>
<span class="cs-line hl-p">    <span class="cmt"># Final step: decode mode</span></span>
<span class="cs-line hl-p">    h = net(z, <span class="num">1.0</span>, <span class="str">"decode"</span>)</span>
<span class="cs-line hl-p">    logits = unembed(h)      <span class="cmt"># W @ h</span></span>
<span class="cs-line hl-p">    tokens = argmax(logits, dim=-<span class="num">1</span>)</span>
<span class="cs-line hl-p">    <span class="kw">return</span> tokens  <span class="cmt"># all L tokens at once</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Non-autoregressive: L tokens in parallel!</span>
<span class="cs-line cmt"># Compare to AR: needs L sequential passes</span></pre>
    </div>

    <!-- panel: results -->
    <div class="cs-panel" id="panel-results">
      <pre class="cs-pre"><span class="cs-line cmt"># Key results from ELF paper</span>
<span class="cs-line cmt"># ─────────────────────────────────────────</span>
<span class="cs-line cmt"># Unconditional gen PPL (OWT, 32 steps):</span>
<span class="cs-line cmt">#   MDLM (1024 steps, 550B tok)  → ~50 PPL</span>
<span class="cs-line cmt">#   Duo  (1024 steps, 550B tok)  → ~45 PPL</span>
<span class="cs-line hl-g"><span class="cmt">#   ELF-B (32 steps,   45B tok)  → ~24 PPL ✓</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Even vs distilled models (extra training):</span>
<span class="cs-line cmt">#   MDLM+SDTT (32 steps) → ~35 PPL</span>
<span class="cs-line cmt">#   Duo+DCD   (32 steps) → ~30 PPL</span>
<span class="cs-line hl-g"><span class="cmt">#   ELF-B     (32 steps) → ~24 PPL ✓</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Training token efficiency:</span>
<span class="cs-line hl-p"><span class="cmt">#   Prior DLMs: 550B+ tokens</span></span>
<span class="cs-line hl-p"><span class="cmt">#   ELF-B:       45B tokens (12x fewer)</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Conditional generation (WMT14 De-En BLEU):</span>
<span class="cs-line cmt">#   MDLM      → 25.2</span>
<span class="cs-line cmt">#   Duo       → 18.4</span>
<span class="cs-line cmt">#   SeqDiffuSeq → 24.8</span>
<span class="cs-line hl-g"><span class="cmt">#   ELF-B     → 26.4 ✓</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># XSum summarization (ROUGE-1):</span>
<span class="cs-line cmt">#   MDLM      → 30.5</span>
<span class="cs-line cmt">#   Duo       → 33.4</span>
<span class="cs-line hl-g"><span class="cmt">#   ELF-B     → 36.0 ✓</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Ablation winners:</span>
<span class="cs-line cmt">#   Embedding: pretrained contextual > other</span>
<span class="cs-line cmt">#   Decoder:   shared-weight > separate</span>
<span class="cs-line cmt">#   Sampler:   SDE > ODE at ≤64 steps</span>
<span class="cs-line cmt">#   CFG scale: 2-3 is sweet spot</span></pre>
    </div>

  </div>

<script>
// ── TOC toggle ──────────────────────────────────────────────────────
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle = document.getElementById('toc-toggle');
const postGrid = document.getElementById('post-grid');

tocToggle?.addEventListener('click', () => {
  const collapsed = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', collapsed);
  tocToggle.textContent = collapsed ? '›' : '‹';
  tocToggle.title = collapsed ? 'Show contents' : 'Hide contents';
});

// ── Code sidebar toggle ─────────────────────────────────────────────
const codeSidebar = document.getElementById('code-sidebar');
const csToggle = document.getElementById('cs-toggle');

csToggle?.addEventListener('click', () => {
  const collapsed = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', collapsed);
  csToggle.textContent = collapsed ? '‹' : '›';
  csToggle.title = collapsed ? 'Show code' : 'Hide code';
});

// ── Code sidebar tabs ───────────────────────────────────────────────
const csTabs = document.querySelectorAll('.cs-tab');
const csPanels = document.querySelectorAll('.cs-panel');
const csFileLabel = document.getElementById('cs-file-label');
const csSectionTitle = document.getElementById('cs-section-title');

const tabMeta = {
  problem:   { file: 'elf/background.py',   title: 'Discrete vs Continuous' },
  flow:      { file: 'elf/flow_matching.py', title: 'Flow Matching Math' },
  elf:       { file: 'elf/train.py',         title: 'ELF Training Loop' },
  final:     { file: 'elf/decode.py',        title: 'Final Step Decode' },
  guidance:  { file: 'elf/guidance.py',      title: 'CFG & Self-Conditioning' },
  inference: { file: 'elf/sample.py',        title: 'Sampling Algorithm' },
  results:   { file: 'elf/results.py',       title: 'Benchmark Results' },
};

function activateTab(name) {
  csTabs.forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  csPanels.forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m && csFileLabel) csFileLabel.textContent = m.file;
  if (m && csSectionTitle) csSectionTitle.textContent = m.title;
}

csTabs.forEach(tab => {
  tab.addEventListener('click', () => activateTab(tab.dataset.panel));
});

// ── IntersectionObserver: sync TOC + sidebar ───────────────────────
const sectionCodeMap = {
  's-problem':  'problem',
  's-flow':     'flow',
  's-elf':      'elf',
  's-final':    'final',
  's-guidance': 'guidance',
  's-inference':'inference',
  's-results':  'results',
};

const observer = new IntersectionObserver((entries) => {
  let best = null, bestRatio = 0;
  entries.forEach(e => {
    if (e.isIntersecting && e.intersectionRatio > bestRatio) {
      best = e.target;
      bestRatio = e.intersectionRatio;
    }
  });
  if (!best) return;
  const id = best.id;
  // update TOC active
  document.querySelectorAll('.toc-item').forEach(li => {
    li.classList.toggle('toc-active', li.id === 'toc-' + id);
  });
  // sync sidebar tab
  const panel = sectionCodeMap[id];
  if (panel) activateTab(panel);
}, { threshold: [0.15, 0.4] });

document.querySelectorAll('.post-body section[id]').forEach(s => observer.observe(s));

// ── Flow canvas animation ───────────────────────────────────────────
const flowCanvas = document.getElementById('flow-canvas');
if (flowCanvas) {
  const ctx = flowCanvas.getContext('2d');
  let animId = null;
  let t = 0;
  let playing = false;

  const W_CSS = flowCanvas.clientWidth;
  const H_CSS = 220;
  const DPR = window.devicePixelRatio || 1;
  flowCanvas.width = W_CSS * DPR;
  flowCanvas.height = H_CSS * DPR;
  ctx.scale(DPR, DPR);
  const W = W_CSS, H = H_CSS;

  // Create particles: each has a noise start and a clean end position
  // Represent 5 "word clusters" in 2D projected embedding space
  const clusters = [
    { cx: 0.22, cy: 0.38, color: '#c678dd', label: '"cat"' },
    { cx: 0.55, cy: 0.28, color: '#61afef', label: '"Paris"' },
    { cx: 0.75, cy: 0.62, color: '#98c379', label: '"run"' },
    { cx: 0.38, cy: 0.70, color: '#e5c07b', label: '"love"' },
    { cx: 0.62, cy: 0.45, color: '#e06c75', label: '"large"' },
  ];

  // 3 particles per cluster
  const particles = [];
  const rng = (seed) => { let s = seed; return () => { s = (s*1664525+1013904223)&0xffffffff; return (s>>>0)/0xffffffff; }; };

  clusters.forEach((cl, ci) => {
    const rand = rng(ci * 17 + 3);
    for (let i = 0; i < 5; i++) {
      const noise_x = rand() * W;
      const noise_y = rand() * H;
      const clean_x = cl.cx * W + (rand() - 0.5) * 30;
      const clean_y = cl.cy * H + (rand() - 0.5) * 25;
      particles.push({ noise_x, noise_y, clean_x, clean_y, color: cl.color, label: i === 2 ? cl.label : null });
    }
  });

  function lerp(a, b, tt) { return a + (b - a) * tt; }
  function easeInOut(x) { return x < 0.5 ? 2*x*x : 1 - Math.pow(-2*x+2,2)/2; }

  function drawFrame(tt) {
    ctx.clearRect(0, 0, W, H);

    // Background subtle grid
    ctx.strokeStyle = 'rgba(255,255,255,0.03)';
    ctx.lineWidth = 1;
    for (let gx = 0; gx <= W; gx += 60) { ctx.beginPath(); ctx.moveTo(gx, 0); ctx.lineTo(gx, H); ctx.stroke(); }
    for (let gy = 0; gy <= H; gy += 44) { ctx.beginPath(); ctx.moveTo(0, gy); ctx.lineTo(W, gy); ctx.stroke(); }

    const te = easeInOut(tt);

    // Draw trajectory trails
    particles.forEach(p => {
      const trail = 8;
      for (let i = 0; i < trail; i++) {
        const frac = Math.max(0, te - i * 0.015);
        const fe = easeInOut(Math.min(1, frac));
        const x = lerp(p.noise_x, p.clean_x, fe);
        const y = lerp(p.noise_y, p.clean_y, fe);
        ctx.beginPath();
        ctx.arc(x, y, 2 * (1 - i / trail), 0, Math.PI * 2);
        ctx.fillStyle = p.color.replace(')', `, ${0.08 * (1 - i / trail)})`).replace('rgb', 'rgba').replace('#', 'rgba(').replace(/^rgba\(([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})/, (_, r, g, b) => `rgba(${parseInt(r,16)},${parseInt(g,16)},${parseInt(b,16)}`);
        // simpler approach:
        ctx.fillStyle = p.color + Math.round(25 * (1 - i / trail)).toString(16).padStart(2, '0');
        ctx.fill();
      }
    });

    // Draw current positions
    particles.forEach(p => {
      const x = lerp(p.noise_x, p.clean_x, te);
      const y = lerp(p.noise_y, p.clean_y, te);

      // Glow
      const grd = ctx.createRadialGradient(x, y, 0, x, y, 12);
      grd.addColorStop(0, p.color + '44');
      grd.addColorStop(1, p.color + '00');
      ctx.beginPath(); ctx.arc(x, y, 12, 0, Math.PI * 2);
      ctx.fillStyle = grd; ctx.fill();

      // Dot
      ctx.beginPath(); ctx.arc(x, y, 5, 0, Math.PI * 2);
      ctx.fillStyle = p.color; ctx.fill();
      ctx.strokeStyle = 'rgba(255,255,255,0.3)';
      ctx.lineWidth = 1; ctx.stroke();

      // Label at clean position
      if (p.label && te > 0.7) {
        ctx.globalAlpha = (te - 0.7) / 0.3;
        ctx.font = '11px monospace';
        ctx.fillStyle = p.color;
        ctx.fillText(p.label, x + 8, y - 6);
        ctx.globalAlpha = 1;
      }
    });

    // t annotation
    ctx.font = '12px monospace';
    ctx.fillStyle = 'rgba(6,182,212,0.8)';
    ctx.fillText(`t = ${tt.toFixed(2)}`, W - 80, 20);

    // Labels at endpoints
    if (tt < 0.05) {
      ctx.font = '10px monospace';
      ctx.fillStyle = 'rgba(255,255,255,0.3)';
      ctx.fillText('← noise (t=0)', 10, 20);
    }
    if (tt > 0.95) {
      ctx.font = '10px monospace';
      ctx.fillStyle = 'rgba(255,255,255,0.4)';
      ctx.fillText('embedding space (t=1) →', W - 180, H - 10);
    }
  }

  drawFrame(0);

  const tVal = document.getElementById('flow-t-val');
  const playBtn = document.getElementById('flow-play');
  const resetBtn = document.getElementById('flow-reset');

  function step() {
    t = Math.min(1, t + 0.008);
    drawFrame(t);
    if (tVal) tVal.textContent = t.toFixed(2);
    if (t < 1) {
      animId = requestAnimationFrame(step);
    } else {
      playing = false;
      if (playBtn) { playBtn.textContent = '▶ Play'; playBtn.classList.remove('active'); }
    }
  }

  playBtn?.addEventListener('click', () => {
    if (playing) {
      playing = false;
      cancelAnimationFrame(animId);
      playBtn.textContent = '▶ Play';
      playBtn.classList.remove('active');
    } else {
      if (t >= 1) t = 0;
      playing = true;
      playBtn.textContent = '⏸ Pause';
      playBtn.classList.add('active');
      animId = requestAnimationFrame(step);
    }
  });

  resetBtn?.addEventListener('click', () => {
    playing = false;
    cancelAnimationFrame(animId);
    t = 0;
    drawFrame(0);
    if (tVal) tVal.textContent = '0.00';
    if (playBtn) { playBtn.textContent = '▶ Play'; playBtn.classList.remove('active'); }
  });
}

// ── CFG canvas ───────────────────────────────────────────────────────
const cfgCanvas = document.getElementById('cfg-canvas');
if (cfgCanvas) {
  const ctx = cfgCanvas.getContext('2d');
  const W = cfgCanvas.clientWidth;
  const H = 180;
  const DPR = window.devicePixelRatio || 1;
  cfgCanvas.width = W * DPR;
  cfgCanvas.height = H * DPR;
  ctx.scale(DPR, DPR);

  // Draw embedding space with CFG extrapolation paths
  // Center = unconditional; Target = conditional mean; CFG extrapolates beyond
  const cx = W * 0.38, cy = H * 0.55;  // unconditional "cluster"
  const dx = W * 0.62, dy = H * 0.35;  // conditional target

  // data cluster (green dots)
  const rng2 = (seed) => { let s = seed; return () => { s=(s*1664525+1013904223)&0xffffffff; return (s>>>0)/0xffffffff; }; };
  const rand = rng2(42);
  const dataPts = Array.from({length: 18}, () => ({
    x: dx + (rand()-0.5)*55, y: dy + (rand()-0.5)*45
  }));

  // Draw axes labels
  ctx.font = '9px monospace';
  ctx.fillStyle = 'rgba(255,255,255,0.25)';
  ctx.fillText('embedding dim 1', 10, H - 10);
  ctx.save(); ctx.translate(12, H/2); ctx.rotate(-Math.PI/2);
  ctx.fillText('embedding dim 2', 0, 0); ctx.restore();

  // Data distribution cluster
  dataPts.forEach(p => {
    ctx.beginPath(); ctx.arc(p.x, p.y, 3.5, 0, Math.PI*2);
    ctx.fillStyle = 'rgba(152,195,121,0.4)'; ctx.fill();
  });
  ctx.font = '9px monospace'; ctx.fillStyle = 'rgba(152,195,121,0.6)';
  ctx.fillText('data distribution', dx - 20, dy + 55);

  // Unconditional center
  ctx.beginPath(); ctx.arc(cx, cy, 6, 0, Math.PI*2);
  ctx.fillStyle = 'rgba(92,99,112,0.8)'; ctx.fill();
  ctx.font = '9px monospace'; ctx.fillStyle = 'rgba(92,99,112,0.8)';
  ctx.fillText('unconditional', cx - 45, cy + 18);

  // CFG trajectories at different scales
  const cfgScales = [
    { w: 1, color: '#61afef', label: 'ω=1' },
    { w: 2, color: '#c678dd', label: 'ω=2' },
    { w: 3, color: '#e5c07b', label: 'ω=3' },
  ];

  cfgScales.forEach(({ w, color, label }) => {
    // CFG: end = w * conditional + (1-w) * unconditional
    const ex = w * dx + (1 - w) * cx;
    const ey = w * dy + (1 - w) * cy;

    // Draw arrow from unconditional to CFG endpoint
    ctx.beginPath();
    ctx.moveTo(cx, cy);
    ctx.lineTo(ex, ey);
    ctx.strokeStyle = color + '88';
    ctx.lineWidth = 1.5;
    ctx.setLineDash([4, 3]);
    ctx.stroke();
    ctx.setLineDash([]);

    // Endpoint dot
    ctx.beginPath(); ctx.arc(ex, ey, 5, 0, Math.PI*2);
    ctx.fillStyle = color; ctx.fill();
    ctx.font = '9px monospace'; ctx.fillStyle = color;
    ctx.fillText(label, ex + 7, ey + 3);
  });

  // Base arrow (conditional direction)
  ctx.beginPath();
  ctx.moveTo(cx, cy);
  ctx.lineTo(dx, dy);
  ctx.strokeStyle = '#61afef';
  ctx.lineWidth = 2;
  ctx.stroke();
  ctx.beginPath(); ctx.arc(dx, dy, 5, 0, Math.PI*2);
  ctx.fillStyle = '#61afef'; ctx.fill();
  ctx.font = '9px monospace'; ctx.fillStyle = '#61afef';
  ctx.fillText('conditional (ω=1)', dx + 8, dy + 3);

  // Legend note
  ctx.font = '9px monospace';
  ctx.fillStyle = 'rgba(255,255,255,0.3)';
  ctx.fillText('Higher ω → extrapolates further toward (and beyond) data cluster', 10, 15);
}

// ── Step-by-step inference navigator ───────────────────────────────
let currentStep = 0;
const stepEls = document.querySelectorAll('.infer-step');
const prevBtn = document.getElementById('infer-prev');
const nextBtn = document.getElementById('infer-next');
const progEl = document.getElementById('infer-prog');

function updateSteps() {
  stepEls.forEach((el, i) => {
    el.classList.remove('active', 'done');
    if (i === currentStep) el.classList.add('active');
    else if (i < currentStep) el.classList.add('done');
  });
  if (prevBtn) prevBtn.disabled = currentStep === 0;
  if (nextBtn) nextBtn.disabled = currentStep === stepEls.length - 1;
  if (progEl) progEl.textContent = `Step ${currentStep + 1} of ${stepEls.length}`;
  // Sync step nums
  stepEls.forEach((el, i) => {
    const numEl = el.querySelector('.step-num');
    if (numEl && i < currentStep) numEl.textContent = '✓';
    else if (numEl) numEl.textContent = String(i + 1);
  });
}

prevBtn?.addEventListener('click', () => { if (currentStep > 0) { currentStep--; updateSteps(); } });
nextBtn?.addEventListener('click', () => { if (currentStep < stepEls.length - 1) { currentStep++; updateSteps(); } });
updateSteps();
</script>
</BaseLayout>

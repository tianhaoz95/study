---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { postReadTime } from '../../../lib/readTimes';
const readTime = postReadTime(Astro.url.pathname.split('/').filter(Boolean).at(-1)!);
---
<BaseLayout
  title="ELF: Continuous Diffusion for Language Finally Works | AI/ML Deep Dives"
  description="A deep dive into Embedded Language Flows — how continuous flow matching in embedding space beats discrete diffusion language models, with animated visualizations."
  crumb="ELF: Continuous Diffusion for Language"
>


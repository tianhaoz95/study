<script>
// ── Syntax highlighter ────────────────────────────────────────────
function hl(raw) {
  let s = raw
    .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  // comments first (before anything else)
  s = s.replace(/(#[^\n]*)/g, '<span class="cmt">$1</span>');
  // strings
  s = s.replace(/("""[\s\S]*?"""|'''[\s\S]*?'''|"[^"\n]*"|'[^'\n]*')/g,
    (m, _, offset, str) => str.slice(0,offset).includes('<span class="cmt">') ? m : `<span class="str">${m}</span>`);
  // keywords
  s = s.replace(/\b(def|class|return|if|else|elif|for|while|import|from|None|True|False|not|and|or|in|is|with|as|self|try|except|raise|pass|super|isinstance)\b/g,'<span class="kw">$1</span>');
  // type-ish
  s = s.replace(/\b(int|str|bool|float|dict|list|tuple|torch|nn|F|Optional)\b/g,'<span class="cls">$1</span>');
  // numbers
  s = s.replace(/\b(\d+(?:\.\d+)?)\b/g,'<span class="num">$1</span>');
  // function names before (
  s = s.replace(/\b([a-zA-Z_]\w*)\s*(?=\()/g,'<span class="fn">$1</span>');
  return s;
}


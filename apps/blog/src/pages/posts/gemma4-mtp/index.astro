`    # ── K and V borrowed from backbone layer i ──`,{c:'hl-g',t:`    k, v = shared_kv                # each [B,S,n_heads,d_head]`},
`    # S = full prompt length; L = draft length (3-7)`  ,
`    # Q attends over the entire backbone prefix`,
``,
`    # ── Standard scaled dot-product attention ──`,
`    scale = math.sqrt(self.head_dim)`,{c:'hl-p',t:`    attn = (q @ k.transpose(-1,-2)) / scale  # [B,L,n_heads,S]`},
`    attn = attn + attention_mask  # bidirectional — no causal mask`,
`    attn = F.softmax(attn, dim=-1)`,{c:'hl-p',t:`    out  = attn @ v               # [B,L,n_heads,d_head]`},
``,
`    return self.o_proj(out.reshape(B, L, -1))`,
``,
`# ── FLOPs saved vs full self-attention (per layer) ──`,
`# Normal: Q, K, V each Linear(768→768) = 3 × 768² ops`,
`# Assistant: only Q                    = 1 × 768² ops`,{c:'hl-g',t:`# → saves ~2/3 of QKV projection FLOPs across all N layers`},
  ]
},


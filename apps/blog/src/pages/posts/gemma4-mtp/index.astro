---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { postReadTime } from '../../../lib/readTimes';
const readTime = postReadTime(Astro.url.pathname.split('/').filter(Boolean).at(-1)!);
---
<BaseLayout
  title="How Gemma 4's Multi-Token Prediction Works | Catpuccino.ai"
  description="A deep dive into Gemma4 Assistant: KV sharing, centroid-based vocab prediction, and bidirectional attention — with animated, annotated visualizations."
  crumb="How Gemma 4's MTP Works"
>

<style is:global>
/* ── Post variables ─────────────────────────────────────── */
.post-hero{padding:6.5rem 2rem 3rem;max-width:1700px;margin:0 auto}
.post-hero .tags{margin-bottom:1.25rem}
.post-hero h1{font-size:clamp(1.75rem,4.5vw,2.75rem);font-weight:800;letter-spacing:-.03em;line-height:1.1;margin-bottom:1.1rem;background:linear-gradient(150deg,var(--text) 35%,var(--muted2));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.post-hero .lead{font-size:1.05rem;color:var(--muted2);max-width:820px;line-height:1.75;margin-bottom:1.75rem}
.post-hero-meta{display:flex;align-items:center;flex-wrap:wrap;gap:1.25rem;font-size:.78rem;color:var(--muted);padding-top:1.25rem;border-top:1px solid var(--border)}

/* ── Two-column layout ─────────────────────────────────── */
.post-grid{display:grid;grid-template-columns:var(--toc-w,190px) 1fr var(--code-w,560px);align-items:start;max-width:1700px;margin:0 auto}
.post-grid.toc-collapsed{--toc-w:32px}
.post-grid.sidebar-collapsed{--code-w:34px}
.post-body{padding:1.5rem 2.5rem 6rem 2rem;min-width:0}
.post-body section{margin-bottom:4.5rem;scroll-margin-top:76px}
.post-body h2{font-size:1.5rem;font-weight:700;color:var(--text);margin-bottom:.875rem}
.post-body h3{font-size:1rem;font-weight:600;color:var(--text2);margin:1.75rem 0 .625rem}
.post-body p{font-size:.925rem;color:var(--muted2);margin-bottom:.875rem;line-height:1.75}
.post-body ul{list-style:none;margin-bottom:.875rem}
.post-body ul li{font-size:.925rem;color:var(--muted2);padding:.3rem 0 .3rem 1.4rem;position:relative;line-height:1.65}
.post-body ul li::before{content:'→';position:absolute;left:0;color:var(--purple);font-weight:700}
.section-no{font-size:.68rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--purple);margin-bottom:.5rem;font-family:var(--ff-mono)}

/* ── Viz panel ──────────────────────────────────────────── */
.vp{background:var(--card);border:1px solid var(--border);border-radius:10px;overflow:hidden;margin:1.75rem 0}
.vp-head{display:flex;align-items:center;justify-content:space-between;padding:.65rem 1rem;border-bottom:1px solid var(--border);background:var(--surface)}
.vp-title{font-size:.72rem;font-family:var(--ff-mono);color:var(--muted2)}
.vp-hint{font-size:.67rem;color:var(--muted);display:flex;align-items:center;gap:.3rem}
.vp-hint::before{content:'⟳';color:var(--cyan)}
.vp-body{padding:1.25rem}

/* ── Generation comparison ──────────────────────────────── */
.gen-cmp{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--border);border-radius:8px;overflow:hidden;margin:1.75rem 0}
.gen-col{background:var(--card);padding:1.25rem}
.gen-col h4{font-size:.72rem;font-weight:600;letter-spacing:.07em;text-transform:uppercase;margin-bottom:1rem;font-family:var(--ff-mono)}
.gen-col.ar h4{color:var(--muted2)}
.gen-col.mtp h4{color:var(--cyan)}
.tok-stream{display:flex;flex-wrap:wrap;gap:.3rem;min-height:72px}
.tok{display:inline-flex;align-items:center;padding:.18rem .55rem;border-radius:4px;font-family:var(--ff-mono);font-size:.76rem;font-weight:500;opacity:0;transform:translateY(5px);transition:opacity .25s,transform .25s}
.tok.show{opacity:1;transform:none}
.ar-col .tok{background:var(--card2);border:1px solid var(--border-hi);color:var(--text2)}
.mtp-col .b1.tok{background:var(--purple-dim);border:1px solid rgba(139,92,246,.3);color:var(--purple-l)}
.mtp-col .b2.tok{background:var(--cyan-dim);border:1px solid rgba(6,182,212,.3);color:var(--cyan)}
.mtp-col .b3.tok{background:var(--green-dim);border:1px solid rgba(16,185,129,.3);color:var(--green)}
.gen-stat-row{display:flex;gap:1.25rem;margin-top:1rem;padding-top:.875rem;border-top:1px solid var(--border)}
.gen-stat{font-size:.72rem;color:var(--muted)}
.gen-stat strong{display:block;font-size:1rem;font-weight:700;margin-bottom:.05rem}
.ar .gen-stat strong{color:var(--muted2)}
.mtp .gen-stat strong{color:var(--cyan)}

/* ── Accept / Reject ────────────────────────────────────── */
.ar-demo{display:flex;flex-direction:column;gap:1rem;margin:1.5rem 0}
.ar-row{display:flex;align-items:center;gap:.5rem}
.ar-label{font-size:.67rem;font-weight:600;letter-spacing:.07em;text-transform:uppercase;color:var(--muted);width:72px;flex-shrink:0;font-family:var(--ff-mono)}
.ar-tok{display:inline-flex;align-items:center;gap:.3rem;padding:.28rem .7rem;border-radius:6px;font-family:var(--ff-mono);font-size:.78rem;font-weight:500;transition:all .4s}
.ar-tok.pending{background:var(--card2);border:1px solid var(--border-hi);color:var(--muted2)}
.ar-tok.accepted{background:var(--green-dim);border:1px solid rgba(16,185,129,.4);color:var(--green)}
.ar-tok.rejected{background:rgba(239,68,68,.09);border:1px solid rgba(239,68,68,.3);color:var(--red)}
.ar-tok .badge{font-size:.6rem;font-weight:700}

/* ── DCA selector tabs ───────────────────────────────────── */
.dca-tabs{display:flex;align-items:center;gap:.5rem;padding:.375rem .875rem;border-bottom:1px solid rgba(255,255,255,.06);background:rgba(255,255,255,.015)}
.dca-btn{font-family:var(--ff-mono);font-size:.68rem;padding:.18rem .55rem;border-radius:3px;border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.04);color:var(--muted2);cursor:pointer;transition:border-color .15s,color .15s,background .15s}
.dca-btn:hover{border-color:rgba(255,255,255,.22);color:var(--muted2)}
.dca-btn.active[data-col="eagle3"]  {border-color:var(--amber);color:var(--amber);background:rgba(245,158,11,.08)}
.dca-btn.active[data-col="deepseek"]{border-color:var(--green);color:var(--green);background:rgba(16,185,129,.08)}
.dca-btn.active[data-col="dflash"]  {border-color:#f472b6;color:#f472b6;background:rgba(244,114,182,.08)}
.dca-btn.active[data-col="peagle"]  {border-color:#38bdf8;color:#38bdf8;background:rgba(56,189,248,.08)}
.dca-btn.active[data-col="dart"]    {border-color:#fb923c;color:#fb923c;background:rgba(251,146,60,.08)}
.dca-vs{font-size:.65rem;color:var(--muted);font-family:var(--ff-mono);margin:0 .25rem}
.dca-fixed{font-size:.68rem;color:#a78bfa;font-family:var(--ff-mono);font-weight:600}
.compare-table.show-eagle    .ds,.compare-table.show-eagle    .df,.compare-table.show-eagle    .pe,.compare-table.show-eagle    .dart{display:none}
.compare-table.show-deepseek .eagle,.compare-table.show-deepseek .df,.compare-table.show-deepseek .pe,.compare-table.show-deepseek .dart{display:none}
.compare-table.show-dflash   .eagle,.compare-table.show-dflash   .ds,.compare-table.show-dflash   .pe,.compare-table.show-dflash   .dart{display:none}
.compare-table.show-peagle   .eagle,.compare-table.show-peagle   .ds,.compare-table.show-peagle   .df,.compare-table.show-peagle   .dart{display:none}
.compare-table.show-dart     .eagle,.compare-table.show-dart     .ds,.compare-table.show-dart     .df,.compare-table.show-dart     .pe{display:none}

/* ── Attention grid ─────────────────────────────────────── */
.attn-wrap{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;margin:1.5rem 0}
.attn-col h4{font-size:.72rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;margin-bottom:.75rem;text-align:center;font-family:var(--ff-mono)}
.attn-col.causal-col h4{color:var(--muted2)}
.attn-col.bidir-col h4{color:var(--cyan)}
.attn-grid{display:grid;grid-template-columns:repeat(8,1fr);gap:2px}
.acell{aspect-ratio:1;border-radius:2px;transition:background .4s}
.acell.on-c{background:rgba(139,92,246,.75)}
.acell.off{background:rgba(255,255,255,.04)}
.acell.on-b{background:rgba(6,182,212,.75)}
.acell.on-swa-b{background:rgba(245,158,11,.72)}
.acell.on-swa-a{background:rgba(16,185,129,.75)}
.acell.last-row{position:relative;box-shadow:0 0 0 1.5px rgba(255,255,255,.5)}
.attn-col.swa-before-col h4{color:var(--amber)}
.attn-col.swa-after-col h4{color:var(--green)}
.attn-section-hd{font-size:.7rem;font-weight:600;letter-spacing:.05em;text-transform:uppercase;font-family:var(--ff-mono);color:var(--muted);margin:.75rem 0 .4rem}

/* ── Viz targets (clickable SVG regions) ────────────────── */
.vt{cursor:pointer;outline:none}
.vt:focus rect,.vt:hover rect{opacity:.85}
.vt.active rect:not(.vt-bg){stroke:var(--amber)!important;stroke-width:2!important}
.vt-glow{filter:drop-shadow(0 0 8px rgba(245,158,11,.5))}

/* ── Centroid viz ───────────────────────────────────────── */
.centroid-stage{position:relative}
.centroid-btn{display:inline-flex;align-items:center;gap:.5rem;font-size:.75rem;font-family:var(--ff-mono);color:var(--cyan);background:var(--cyan-dim);border:1px solid rgba(6,182,212,.3);border-radius:6px;padding:.35rem .85rem;cursor:pointer;transition:all .2s;margin-top:.875rem}
.centroid-btn:hover{background:rgba(6,182,212,.2)}

/* ── PLE diagram ────────────────────────────────────────── */
.ple-table{width:100%;border-collapse:collapse;margin:1.5rem 0;border-radius:8px;overflow:hidden}
.ple-table th,.ple-table td{font-size:.72rem;font-family:var(--ff-mono);padding:.5rem .75rem;border-bottom:1px solid var(--border)}
.ple-table th{background:var(--surface);color:var(--muted);font-weight:600;letter-spacing:.06em;text-transform:uppercase}
.ple-table td:first-child{color:var(--muted2);width:80px}
.ple-table td:nth-child(2){color:var(--text2)}
.ple-table td:last-child{color:var(--purple-l)}
.ple-table tr:last-child td{border-bottom:none}
.ple-table tr:hover td{background:rgba(255,255,255,.02)}

/* ── Code sidebar ───────────────────────────────────────── */
.code-sidebar{position:sticky;top:56px;height:calc(100vh - 56px);display:flex;flex-direction:column;border-left:1px solid var(--border);background:var(--code-bg)}
.cs-head{padding:.75rem 1.1rem;border-bottom:1px solid var(--border);background:var(--surface);flex-shrink:0;display:flex;align-items:center;gap:.65rem}
.cs-head-info{flex:1;min-width:0}
.cs-toggle{display:flex;align-items:center;justify-content:center;width:24px;height:24px;border:1px solid var(--border-hi);border-radius:4px;background:none;cursor:pointer;color:var(--muted);font-size:.8rem;flex-shrink:0;transition:all .15s}
.cs-toggle:hover{color:var(--text2);background:rgba(255,255,255,.06)}
.cs-collapsed-label{display:none;writing-mode:vertical-rl;transform:rotate(180deg);font-size:.6rem;font-family:var(--ff-mono);color:var(--muted);letter-spacing:.08em;text-transform:uppercase;margin-top:.4rem}
.code-sidebar.collapsed{overflow:hidden}
.code-sidebar.collapsed .cs-head{flex-direction:column;align-items:center;border-bottom:none;height:100%;padding:.5rem .35rem;gap:.4rem}
.code-sidebar.collapsed .cs-head-info,.code-sidebar.collapsed .cs-tabs,.code-sidebar.collapsed .cs-body{display:none}
.code-sidebar.collapsed .cs-collapsed-label{display:block}
@media(max-width:1100px){.code-sidebar.collapsed{display:none}}
.cs-file{font-size:.67rem;font-family:var(--ff-mono);color:var(--muted);margin-bottom:.2rem;display:flex;align-items:center;gap:.4rem}
.cs-file::before{content:'';width:7px;height:7px;border-radius:50%;background:var(--purple);flex-shrink:0;display:inline-block}
.cs-section-title{font-size:.78rem;font-weight:600;color:var(--text2)}
.cs-tabs{display:flex;overflow-x:auto;border-bottom:1px solid var(--border);flex-shrink:0;scrollbar-width:none}
.cs-tabs::-webkit-scrollbar{display:none}
.cs-tab{font-size:.68rem;font-family:var(--ff-mono);color:var(--muted);padding:.55rem .9rem;cursor:pointer;white-space:nowrap;border-bottom:2px solid transparent;transition:all .15s;flex-shrink:0;background:none;border-top:none;border-left:none;border-right:none}
.cs-tab:hover{color:var(--text2);background:rgba(255,255,255,.025)}
.cs-tab.active{color:var(--purple-l);border-bottom-color:var(--purple);background:var(--purple-dim)}
.cs-body{flex:1;overflow-y:auto;overflow-x:auto;scrollbar-width:thin;scrollbar-color:var(--border-hi) transparent}
.cs-panel{display:none}
.cs-panel.active{display:block}
.cs-pre{font-family:var(--ff-mono);font-size:.72rem;line-height:1.5;padding:.875rem 0;color:#abb2bf;white-space:normal}
.cs-line{display:block;padding:0 1.25rem;white-space:pre}
.cs-line.hl-p{background:rgba(139,92,246,.12);border-left:2px solid var(--purple);margin:0 0;padding:0 1.1rem}
.cs-line.hl-c{background:rgba(6,182,212,.1);border-left:2px solid var(--cyan);margin:0 0;padding:0 1.1rem}
.cs-line.hl-g{background:rgba(16,185,129,.1);border-left:2px solid var(--green);margin:0 0;padding:0 1.1rem}
/* Syntax */
.kw{color:#c678dd}.fn{color:#61afef}.cls{color:#e5c07b}.str{color:#98c379}.cmt{color:#5c6370;font-style:italic}.num{color:#d19a66}.op{color:#abb2bf}.attr{color:#e06c75}

/* ── Compare table ──────────────────────────────────────── */
.compare-table{width:100%;border-collapse:collapse;margin:1.5rem 0;font-size:.8rem;border-radius:8px;overflow:hidden}
.compare-table th{background:var(--surface);padding:.55rem .75rem;text-align:left;font-size:.68rem;font-weight:600;letter-spacing:.07em;text-transform:uppercase;color:var(--muted);border-bottom:1px solid var(--border)}
.compare-table td{padding:.5rem .75rem;border-bottom:1px solid var(--border);vertical-align:top;font-size:.82rem;color:var(--muted2);line-height:1.6}
.compare-table tr:last-child td{border-bottom:none}
.compare-table tr:hover td{background:rgba(255,255,255,.018)}
.compare-table .rl{color:var(--text2);font-weight:600;font-size:.72rem;white-space:nowrap;font-family:var(--ff-mono)}
.compare-table .eagle{color:var(--amber)}
.compare-table .ds{color:var(--green)}
.compare-table .df{color:#f472b6}
.compare-table .pe{color:#38bdf8}
.compare-table .dart{color:#fb923c}
.compare-table .gemma{color:var(--purple-l)}
.compare-table .key{color:var(--cyan);font-weight:600}

/* ── TOC sidebar ─────────────────────────────────────────── */
.toc-sidebar{position:sticky;top:56px;height:calc(100vh - 56px);display:flex;flex-direction:column;border-right:1px solid var(--border);background:var(--surface)}
.toc-head{padding:.6rem .75rem;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:.5rem;flex-shrink:0}
.toc-label{font-size:.67rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);flex:1;font-family:var(--ff-mono)}
.toc-toggle{display:flex;align-items:center;justify-content:center;width:22px;height:22px;border:1px solid var(--border-hi);border-radius:4px;background:none;cursor:pointer;color:var(--muted);font-size:.75rem;flex-shrink:0;transition:all .15s}
.toc-toggle:hover{color:var(--text2);background:rgba(255,255,255,.06)}
.toc-list{list-style:none;padding:.4rem 0;margin:0;overflow-y:auto;flex:1;scrollbar-width:thin;scrollbar-color:var(--border-hi) transparent}
.toc-item a{display:flex;align-items:baseline;gap:.5rem;padding:.3rem .75rem;font-size:.71rem;font-family:var(--ff-mono);color:var(--muted);text-decoration:none;transition:all .15s;border-left:2px solid transparent;line-height:1.45}
.toc-item a:hover{color:var(--text2);background:rgba(255,255,255,.03)}
.toc-item.toc-active a{color:var(--purple-l);border-left-color:var(--purple);background:var(--purple-dim)}
.toc-num{font-size:.6rem;color:var(--muted);flex-shrink:0;opacity:.7}
.toc-collapsed-label{display:none;writing-mode:vertical-rl;transform:rotate(180deg);font-size:.6rem;font-family:var(--ff-mono);color:var(--muted);letter-spacing:.08em;text-transform:uppercase;margin-top:.4rem}
.toc-sidebar.collapsed{overflow:hidden}
.toc-sidebar.collapsed .toc-label,.toc-sidebar.collapsed .toc-list{display:none}
.toc-sidebar.collapsed .toc-head{flex-direction:column;align-items:center;border-bottom:none;height:100%;padding:.5rem .3rem;gap:.4rem}
.toc-sidebar.collapsed .toc-collapsed-label{display:block}

/* ── Responsive ─────────────────────────────────────────── */
@media(max-width:1100px){
  .post-grid{grid-template-columns:1fr}
  .toc-sidebar{position:static;height:auto;border-right:none;border-bottom:1px solid var(--border);max-height:220px}
  .toc-sidebar.collapsed{display:none}
  .code-sidebar{position:static;height:auto;border-left:none;border-top:1px solid var(--border);margin-top:2rem}
  .cs-body{max-height:480px}
}
@media(max-width:680px){.post-hero{padding:5rem 1.25rem 2.5rem}.post-body{padding:1.25rem 1.25rem 4rem}.gen-cmp{grid-template-columns:1fr}.attn-wrap{grid-template-columns:1fr}}
/* ── Bonus collapsible ────────────────────────────────────── */
.bonus-details{border:1px solid rgba(245,158,11,.2);border-radius:8px;margin:2.5rem 0}
.bonus-summary{display:flex;align-items:center;gap:.75rem;padding:.875rem 1.25rem;cursor:pointer;list-style:none;background:rgba(245,158,11,.04);border-radius:8px}
.bonus-summary::-webkit-details-marker,.bonus-summary::marker{display:none}
.bonus-tag{font-family:var(--ff-mono);font-size:.63rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--amber);background:rgba(245,158,11,.1);border:1px solid rgba(245,158,11,.22);border-radius:3px;padding:.15rem .45rem;flex-shrink:0}
.bonus-summary-title{font-size:.875rem;font-weight:600;color:var(--text2);flex:1}
.bonus-chevron{color:var(--muted);transition:transform .2s;flex-shrink:0}
details[open].bonus-details .bonus-chevron{transform:rotate(90deg)}
details[open].bonus-details .bonus-summary{border-radius:8px 8px 0 0}
.bonus-body{padding:1.5rem 1.75rem;border-top:1px solid rgba(245,158,11,.12)}
.bonus-intro{font-size:.875rem;color:var(--muted2);line-height:1.7;margin-bottom:1.5rem}
.bonus-h4{font-size:.78rem;font-weight:700;color:var(--amber);font-family:var(--ff-mono);margin:1.5rem 0 .5rem;letter-spacing:.03em;text-transform:uppercase}
.bonus-table{width:100%;border-collapse:collapse;font-size:.8rem;margin:1rem 0 1.5rem}
.bonus-table th{padding:.4rem .65rem;text-align:left;font-size:.66rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);background:var(--surface);border-bottom:1px solid var(--border)}
.bonus-table td{padding:.45rem .65rem;border-bottom:1px solid rgba(255,255,255,.05);color:var(--muted2);vertical-align:top;line-height:1.55;font-size:.79rem}
.bonus-table td:first-child{font-family:var(--ff-mono);font-size:.7rem;color:var(--cyan);white-space:nowrap}
.bonus-table .mod-cell{color:var(--amber)}
.bonus-pre{font-family:var(--ff-mono);font-size:.72rem;line-height:1.75;padding:.875rem 1rem;color:#abb2bf;white-space:pre;background:var(--code-bg,#1e2028);border:1px solid var(--border);border-radius:6px;overflow-x:auto;margin:.25rem 0 1.25rem}
</style>

<!-- ════════════════════════════════════════════════════════ HERO -->
<header class="post-hero">
  <div class="tags">
    <span class="tag tag-purple">Gemma 4</span>
    <span class="tag tag-cyan">Multi-Token Prediction</span>
    <span class="tag tag-cyan">Speculative Decoding</span>
    <span class="tag tag-green">Interactive</span>
  </div>
  <h1>How Gemma 4's Multi-Token<br>Prediction Works</h1>
  <p class="lead">
    Gemma 4 ships a compact <em>assistant model</em> that drafts multiple tokens per step — then the large backbone verifies them in a single parallel pass. This post tears apart the implementation: KV sharing, centroid-based vocabulary prediction, and bidirectional attention, with animated, code-annotated diagrams.
  </p>
  <div class="post-hero-meta">
    <span>May 24, 2026</span>
    <span>{readTime}</span>
    <span>Source: <code>transformers/models/gemma4_assistant</code></span>
  </div>
</header>

<!-- ════════════════════════════════════════════════════════ GRID -->
<div class="post-grid">

<!-- ══════════════════════════════════ TOC ══════════════════ -->
<nav class="toc-sidebar" id="toc-sidebar">
  <div class="toc-head">
    <span class="toc-label">Contents</span>
    <button class="toc-toggle" id="toc-toggle" title="Hide contents" aria-label="Hide contents">‹</button>
    <span class="toc-collapsed-label">nav</span>
  </div>
  <ol class="toc-list">
    <li class="toc-item" id="toc-s-intro"><a href="#s-intro"><span class="toc-num">01</span> The Problem</a></li>
    <li class="toc-item" id="toc-s-arch"><a href="#s-arch"><span class="toc-num">02</span> Architecture</a></li>
    <li class="toc-item" id="toc-s-kv"><a href="#s-kv"><span class="toc-num">03</span> KV Sharing</a></li>

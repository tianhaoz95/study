// ── Render a panel ─────────────────────────────────────────────────
function renderPanel(id) {
  const p = PANELS[id];
  if (!p) return '';
  const html = p.lines.map(entry => {
    const cls = (typeof entry === 'object') ? entry.c : '';
    const txt = (typeof entry === 'object') ? entry.t : entry;
    return `<span class="cs-line ${cls}">${hl(txt)}</span>`;
  }).join('');
  return `<pre class="cs-pre">${html}</pre>`;
}

// ── Build sidebar panels ────────────────────────────────────────────
function buildSidebar() {
  const body = document.getElementById('cs-body');
  body.innerHTML = Object.keys(PANELS).map(id =>
    `<div class="cs-panel" id="panel-${id}">${renderPanel(id)}</div>`
  ).join('');
}

// ── Activate a panel ────────────────────────────────────────────────
function activatePanel(id) {
  // Update tabs
  document.querySelectorAll('.cs-tab').forEach(t => {
    t.classList.toggle('active', t.dataset.panel === id);
  });
  // Update panels
  document.querySelectorAll('.cs-panel').forEach(p => {
    p.classList.toggle('active', p.id === `panel-${id}`);
  });
  // Update header
  const p = PANELS[id];
  if (p) {
    document.getElementById('cs-file').textContent = p.file;
    document.getElementById('cs-title').textContent = p.title;
  }
  // Scroll to first highlight
  const activePanel = document.getElementById(`panel-${id}`);
  if (activePanel) {
    const firstHl = activePanel.querySelector('.hl-p,.hl-c,.hl-g');
    if (firstHl) {
      const body = document.getElementById('cs-body');
      body.scrollTo({ top: firstHl.offsetTop - 40, behavior: 'smooth' });
    } else {
      document.getElementById('cs-body').scrollTo({ top: 0, behavior: 'smooth' });
    }
  }
}

// ── Map section id → panel id ────────────────────────────────────────
const SECTION_MAP = {
  's-intro':    'intro',
  's-arch':     'architecture',
  's-kv':       'kv-sharing',
  's-drafter':  'drafter-arch',
  's-proj':     'projections',
  's-centroid': 'centroid',
  's-attn':     'attention',
  's-loop':     'full-loop',
};

// ── Init on DOM ready ────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', () => {
  buildSidebar();
  activatePanel('intro');
  document.getElementById('toc-s-intro')?.classList.add('toc-active');

  // ── Sidebar toggle ──────────────────────────────────────
  const csToggle = document.getElementById('cs-toggle');
  const csSidebar = document.getElementById('code-sidebar');
  const postGrid = document.querySelector('.post-grid');
  if (csToggle && csSidebar) {
    csToggle.addEventListener('click', () => {
      const collapsed = csSidebar.classList.toggle('collapsed');
      if (postGrid) postGrid.classList.toggle('sidebar-collapsed', collapsed);
      csToggle.textContent = collapsed ? '‹' : '›';
      csToggle.title = collapsed ? 'Show code panel' : 'Hide code panel';
      csToggle.setAttribute('aria-label', collapsed ? 'Show code panel' : 'Hide code panel');
    });
  }

  // ── TOC toggle + active tracking ────────────────────────
  const tocToggle = document.getElementById('toc-toggle');
  const tocSidebar = document.getElementById('toc-sidebar');
  if (tocToggle && tocSidebar) {
    tocToggle.addEventListener('click', () => {
      const collapsed = tocSidebar.classList.toggle('collapsed');
      if (postGrid) postGrid.classList.toggle('toc-collapsed', collapsed);
      tocToggle.textContent = collapsed ? '›' : '‹';
      tocToggle.title = collapsed ? 'Show contents' : 'Hide contents';
      tocToggle.setAttribute('aria-label', collapsed ? 'Show contents' : 'Hide contents');
    });
  }
  function activateTocItem(sectionId) {
    document.querySelectorAll('.toc-item').forEach(item => {
      item.classList.toggle('toc-active', item.id === `toc-${sectionId}`);
    });
  }

  // Tab clicks
  document.querySelectorAll('.cs-tab').forEach(btn => {
    btn.addEventListener('click', () => activatePanel(btn.dataset.panel));
  });

  // Viz target clicks
  document.querySelectorAll('[data-target]').forEach(el => {
    el.addEventListener('click', () => {
      const [panelId] = el.dataset.target.split(':');
      activatePanel(panelId);
      // Highlight this element
      document.querySelectorAll('.vt').forEach(v => v.classList.remove('active'));
      el.classList.add('active');
    });
    el.addEventListener('keydown', e => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); el.click(); }
    });
  });

  // IntersectionObserver — auto-update sidebar on scroll
  const observer = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const panelId = SECTION_MAP[entry.target.id];
        if (panelId) activatePanel(panelId);
        activateTocItem(entry.target.id);
      }
    });
  }, { threshold: 0.35 });

  document.querySelectorAll('section[id]').forEach(s => observer.observe(s));

  // ── Generation comparison animation ──────────────────────────────
  function runGenAnimation() {
    document.querySelectorAll('.ar-col .tok, .mtp-col .tok').forEach(t => {
      t.classList.remove('show');
    });
    document.querySelectorAll('.tok').forEach(tok => {
      const delay = parseInt(tok.dataset.delay || 0);
      setTimeout(() => tok.classList.add('show'), delay + 200);
    });
  }
  runGenAnimation();
  setInterval(runGenAnimation, 5500);

  // ── Attention grid ────────────────────────────────────────────────
  const SIZE = 8, SWA_W = 3;
  function buildGrid(id, type) {
    const g = document.getElementById(id);
    if (!g) return;
    const isSWA = type === 'swa-before' || type === 'swa-after';
    const rows = isSWA ? 1 : SIZE;
    g.style.gridTemplateColumns = `repeat(${SIZE}, 1fr)`;
    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < SIZE; c++) {
        const cell = document.createElement('div');
        let cls = 'acell';
        if (type === 'causal') {
          cls += c <= r ? ' on-c' : ' off';
          if (r === SIZE - 1) cls += ' last-row';
        } else if (type === 'bidir') {
          cls += ' on-b';
          if (r === SIZE - 1) cls += ' last-row';
        } else if (type === 'swa-before') {
          cls += c < SWA_W ? ' on-swa-b' : ' off';
        } else if (type === 'swa-after') {
          cls += c >= SIZE - SWA_W ? ' on-swa-a' : ' off';
        }
        cell.className = cls;
        g.appendChild(cell);
      }
    }
  }
  buildGrid('causal-grid', 'causal');
  buildGrid('bidir-grid', 'bidir');
  buildGrid('swa-before-grid', 'swa-before');
  buildGrid('swa-after-grid', 'swa-after');

  // ── Centroid replay ────────────────────────────────────────────────
  const centroidReplay = document.getElementById('centroid-replay');
  const centroidSvg = document.getElementById('centroid-svg');
  if (centroidReplay && centroidSvg) {
    let animInterval = null;
    function runCentroidAnim() {
      if (animInterval) clearInterval(animInterval);
      const vocabHighlight = document.getElementById('vocab-highlight');
      if (!vocabHighlight) return;
      let x = 8;
      const target = 198; // random position within 644px wide bar
      animInterval = setInterval(() => {
        if (x < target) { x += 8; vocabHighlight.setAttribute('x', x); }
        else clearInterval(animInterval);
      }, 16);
    }
    centroidReplay.addEventListener('click', runCentroidAnim);
    // auto-run on load
    setTimeout(runCentroidAnim, 1500);
  }

  // ── Accept/Reject animation ────────────────────────────────────────
  const arToks = ['at0','at1','at2','at3','at4'];
  const verifyToks = ['vt0','vt1','vt2','vt3','vt4'];
  const acceptToks = ['acc0','acc1','acc2'];
  const rejectToks = ['rej3'];

  function runARAnimation() {
    // Reset
    verifyToks.forEach(id => {
      const el = document.getElementById(id);
      if (el) { el.className = 'ar-tok pending'; el.style.opacity = '1'; }
    });
    [...acceptToks, ...rejectToks].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.style.opacity = '0';
    });
    const rejNote = document.getElementById('rej-note');
    if (rejNote) rejNote.style.opacity = '0';

    // Accept first 3
    ['vt0','vt1','vt2'].forEach((id, i) => {
      setTimeout(() => {
        const el = document.getElementById(id);
        if (el) el.className = 'ar-tok accepted';
        const acc = document.getElementById(`acc${i}`);
        if (acc) {
          acc.className = 'ar-tok accepted';
          acc.style.opacity = '1';
          const badge = acc.querySelector('.badge');
          if (badge) badge.textContent = ' ✓';
        }
      }, 800 + i * 400);
    });

    // Reject 4th
    setTimeout(() => {
      const el = document.getElementById('vt3');
      if (el) el.className = 'ar-tok rejected';
      const rej = document.getElementById('rej3');
      if (rej) {
        rej.className = 'ar-tok rejected';
        rej.style.opacity = '1';
        const badge = rej.querySelector('.badge');
        if (badge) badge.textContent = ' ✗';
      }
      const rejNote = document.getElementById('rej-note');
      if (rejNote) rejNote.style.opacity = '1';
      // Dim remaining
      document.getElementById('vt4').style.opacity = '.3';
    }, 2400);
  }

  // Run animation when section is near visible
  const arSection = document.getElementById('s-loop');
  if (arSection) {
    const arObs = new IntersectionObserver(entries => {
      if (entries[0].isIntersecting) {
        runARAnimation();
        setInterval(runARAnimation, 5000);
        arObs.disconnect();
      }
    }, { threshold: 0.3 });
    arObs.observe(arSection);
  }

  // ── DCA column selector ──────────────────────────────────────────
  document.querySelectorAll('.dca-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const col = btn.dataset.col;
      document.querySelectorAll('.dca-btn').forEach(b => b.classList.toggle('active', b === btn));
      const eagle  = document.getElementById('dca-eagle3');
      const ds     = document.getElementById('dca-deepseek');
      const df     = document.getElementById('dca-dflash');
      const pe     = document.getElementById('dca-peagle');
      const da     = document.getElementById('dca-dart');
      if (eagle)  eagle.style.display  = col === 'eagle3'   ? '' : 'none';
      if (ds)     ds.style.display     = col === 'deepseek' ? '' : 'none';
      if (df)     df.style.display     = col === 'dflash'   ? '' : 'none';
      if (pe)     pe.style.display     = col === 'peagle'   ? '' : 'none';
      if (da)     da.style.display     = col === 'dart'     ? '' : 'none';
      const tbl = document.getElementById('compare-table');
      if (tbl) {
        tbl.classList.toggle('show-eagle',    col === 'eagle3');
        tbl.classList.toggle('show-deepseek', col === 'deepseek');
        tbl.classList.toggle('show-dflash',   col === 'dflash');
        tbl.classList.toggle('show-peagle',   col === 'peagle');
        tbl.classList.toggle('show-dart',     col === 'dart');
      }
    });
  });

  document.querySelectorAll('code.bonus-code').forEach(el => {
    el.innerHTML = hl(el.textContent);
  });

  // ── Design-bet animation ─────────────────────────────────────────
  (function () {
    const $ = id => document.getElementById(id);
    const setAttr = (id, k, v) => { const e = $(id); if (e) e.setAttribute(k, v); };

    function drawLine(id, dur) {
      const e = $(id); if (!e) return;
      e.style.transition = 'none';
      e.setAttribute('stroke-dashoffset', e.getAttribute('stroke-dasharray'));
      e.getBoundingClientRect(); // force reflow so reset commits before new transition
      e.style.transition = `stroke-dashoffset ${dur}ms linear`;
      e.setAttribute('stroke-dashoffset', '0');
    }
    function fadeIn(id, dur) {
      const e = $(id); if (!e) return;
      e.style.transition = `opacity ${dur}ms`;
      e.setAttribute('opacity', '1');
    }
    function reset() {
      ['bbeam-0','bbeam-1','bbeam-2','thr-01','thr-12'].forEach(id => {
        const e = $(id); if (!e) return;
        e.style.transition = 'none';
        e.setAttribute('stroke-dashoffset', e.getAttribute('stroke-dasharray'));
      });
      ['barrow-0','barrow-1','barrow-2',
       'dtok-0','dtok-1','dtok-2',
       'tarr-01','tarr-12','tlbl-01','tlbl-12',
       'ann-dom','ann-weak'].forEach(id => {
        const e = $(id); if (!e) return;
        e.style.transition = 'none';
        e.setAttribute('opacity', '0');
      });
    }
    function run() {
      reset();
      [
        [60,   () => drawLine('bbeam-0', 380)],
        [440,  () => { setAttr('barrow-0','opacity','1'); fadeIn('dtok-0', 180); }],
        [780,  () => drawLine('thr-01', 210)],
        [990,  () => { setAttr('tarr-01','opacity','1'); fadeIn('tlbl-01', 180); drawLine('bbeam-1', 380); }],
        [1370, () => { setAttr('barrow-1','opacity','1'); fadeIn('dtok-1', 180); }],
        [1710, () => drawLine('thr-12', 210)],
        [1920, () => { setAttr('tarr-12','opacity','1'); fadeIn('tlbl-12', 180); drawLine('bbeam-2', 380); }],
        [2300, () => { setAttr('barrow-2','opacity','1'); fadeIn('dtok-2', 180); }],
        [2640, () => { fadeIn('ann-dom', 350); fadeIn('ann-weak', 350); }],
        [4300, () => reset()],
      ].forEach(([ms, fn]) => setTimeout(fn, ms));
    }
    const betSvg = $('bet-svg');
    if (betSvg) {
      const obs = new IntersectionObserver(entries => {
        if (entries[0].isIntersecting) { run(); setInterval(run, 4900); obs.disconnect(); }
      }, { threshold: 0.3 });
      obs.observe(betSvg);
    }
  })();
});
</script>


);

// ── Mismatch visualization ────────────────────────────────────────────────
const SENTENCE = ['The', 'solar', 'system', 'has', 'eight', 'planets'];
// confidence scores: high=easy to predict, low=harder
const CONFIDENCE = [0.95, 0.35, 0.85, 0.92, 0.42, 0.88];
// seeded random: which positions are masked in training
function seededRand(n) {
  return ((1664525 * n + 1013904223) & 0x7fffffff) / 0x7fffffff;
}
const TRAIN_MASKED = SENTENCE.map((_, i) => seededRand(i * 3 + 7) < 0.5);

function renderTrainSeq() {
  const el = document.getElementById('train-seq');
  if (!el) return;
  el.innerHTML = SENTENCE.map((tok, i) => {
    if (TRAIN_MASKED[i]) {
      return `<span class="tok masked">[MASK]</span>`;
    } else {
      return `<span class="tok revealed">${tok}</span>`;
    }
  }).join('');
}

function setInferStep(step) {
  const el = document.getElementById('infer-seq');
  if (!el) return;
  // sort by confidence descending — reveal highest-confidence first
  const sorted = SENTENCE.map((tok, i) => ({ tok, conf: CONFIDENCE[i], i }))
    .sort((a, b) => b.conf - a.conf);
  const revealed = new Set();
  // reveal top `step * 1.5` tokens
  const toReveal = Math.ceil(step * SENTENCE.length / 4);
  sorted.slice(0, toReveal).forEach(x => revealed.add(x.i));

  el.innerHTML = SENTENCE.map((tok, i) => {
    if (revealed.has(i)) {
      const cls = CONFIDENCE[i] > 0.75 ? 'revealed' : 'lo';
      return `<span class="tok ${cls}">${tok}</span>`;
    }
    return `<span class="tok masked">[MASK]</span>`;
  }).join('');

  // update active button
  document.querySelectorAll('.step-nav-btn').forEach((btn, idx) => {
    btn.classList.toggle('active-step-btn', idx + 1 === step);
  });
}

renderTrainSeq();
setInferStep(1);

// ── Block diffusion step navigator ────────────────────────────────────────
let diffStep = 0;
const diffBoxes = document.querySelectorAll('#diff-steps .step-box');
const diffPrev  = document.getElementById('diff-prev');
const diffNext  = document.getElementById('diff-next');
const diffProg  = document.getElementById('diff-prog');

function updateDiffSteps() {
  diffBoxes.forEach((b, i) => {
    b.classList.remove('active', 'done');
    if (i === diffStep) b.classList.add('active');
    else if (i < diffStep) b.classList.add('done');
  });
  diffPrev.disabled = diffStep === 0;
  diffNext.disabled = diffStep === diffBoxes.length - 1;
  diffProg.textContent = `Step ${diffStep + 1} of ${diffBoxes.length}`;
  diffBoxes.forEach((b, i) => {
    const n = b.querySelector('.step-num');
    if (n) n.textContent = i < diffStep ? '✓' : String(i + 1);
  });
}
diffPrev?.addEventListener('click', () => { if (diffStep > 0) { diffStep--; updateDiffSteps(); } });
diffNext?.addEventListener('click', () => { if (diffStep < diffBoxes.length - 1) { diffStep++; updateDiffSteps(); } });
updateDiffSteps();

// ── Efficiency scatter chart ──────────────────────────────────────────────
const effCanvas = document.getElementById('efficiency-canvas');
if (effCanvas) {
  const ctx = effCanvas.getContext('2d');
  const W = effCanvas.clientWidth || 600;
  const H = 280;
  const DPR = window.devicePixelRatio || 1;
  effCanvas.width  = W * DPR;
  effCanvas.height = H * DPR;
  ctx.scale(DPR, DPR);

  const PAD = { l: 72, r: 24, t: 28, b: 48 };
  const cW = W - PAD.l - PAD.r;
  const cH = H - PAD.t - PAD.b;

  // Data: [name, tokens_B, aime24_acc, color, is_opdlm]
  const DATA = [
    ['LLaDA-8B',      1500,   2.1, 'rgba(107,114,128,.65)', false],
    ['Dream-7B',       580,   0.0, 'rgba(107,114,128,.65)', false],
    ['SDAR-8B',         55,  10.0, 'rgba(107,114,128,.8)', false],
    ['Fast-dLLM-v2',    1.0, 14.5, 'rgba(6,182,212,.85)', false],
    ['OPDLM-8B',       0.066, 14.7, '#8b5cf6', true],
  ];

  // Log scale: x = log10(tokens_B), range -2 to 4
  const xMin = -2, xMax = 4;
  const yMin = -1, yMax = 20;

  function toX(v) { return PAD.l + (Math.log10(v) - xMin) / (xMax - xMin) * cW; }
  function toY(v) { return PAD.t + (1 - (v - yMin) / (yMax - yMin)) * cH; }

  // grid lines
  ctx.strokeStyle = 'rgba(255,255,255,.04)';
  ctx.lineWidth = 1;
  for (let lv = -2; lv <= 4; lv++) {
    const x = toX(Math.pow(10, lv));
    ctx.beginPath(); ctx.moveTo(x, PAD.t); ctx.lineTo(x, PAD.t + cH); ctx.stroke();
  }
  for (let acc = 0; acc <= 20; acc += 5) {
    const y = toY(acc);
    ctx.beginPath(); ctx.moveTo(PAD.l, y); ctx.lineTo(PAD.l + cW, y); ctx.stroke();
  }

  // axes
  ctx.strokeStyle = 'rgba(255,255,255,.15)';
  ctx.lineWidth = 1;
  ctx.beginPath();
  ctx.moveTo(PAD.l, PAD.t); ctx.lineTo(PAD.l, PAD.t + cH);
  ctx.lineTo(PAD.l + cW, PAD.t + cH); ctx.stroke();

  // axis labels
  ctx.fillStyle = 'rgba(107,114,128,.8)';
  ctx.font = `${10 * DPR / DPR}px "JetBrains Mono",monospace`;
  ctx.textAlign = 'center';
  const tLabels = [['0.01B', -2], ['0.1B', -1], ['1B', 0], ['10B', 1], ['100B', 2], ['1,000B', 3]];
  tLabels.forEach(([lbl, lv]) => {
    ctx.fillText(lbl, toX(Math.pow(10, lv)), H - 10);
  });
  ctx.textAlign = 'right';
  [0, 5, 10, 15, 20].forEach(v => {
    ctx.fillText(v + '%', PAD.l - 8, toY(v) + 4);
  });

  // axis titles
  ctx.fillStyle = 'rgba(107,114,128,.6)';
  ctx.font = `${9 * DPR / DPR}px "JetBrains Mono",monospace`;
  ctx.textAlign = 'center';
  ctx.fillText('Training Tokens (log scale)', PAD.l + cW / 2, H - 1);
  ctx.save();
  ctx.translate(12, PAD.t + cH / 2);
  ctx.rotate(-Math.PI / 2);
  ctx.fillText('AIME-24 Accuracy (%)', 0, 0);
  ctx.restore();

  // Pareto frontier (approximate)
  const paretoFrontier = [
    [0.066, 14.7],
    [1.0,   14.5],
    [55,    10.0],
    [580,    2.1],
    [1500,   2.1],
  ];
  ctx.beginPath();
  ctx.setLineDash([4, 4]);
  ctx.strokeStyle = 'rgba(139,92,246,.35)';
  ctx.lineWidth = 1.5;
  paretoFrontier.forEach(([t, a], idx) => {
    const x = toX(t), y = toY(a);
    if (idx === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
  });
  ctx.stroke();
  ctx.setLineDash([]);

  // data points
  DATA.forEach(([name, tok, acc, color, isOpdlm]) => {
    const x = toX(tok), y = toY(acc);
    const r = isOpdlm ? 9 : 7;

    if (isOpdlm) {
      ctx.shadowColor = '#8b5cf6';
      ctx.shadowBlur  = 14;
    }
    ctx.beginPath();
    ctx.arc(x, y, r, 0, Math.PI * 2);
    ctx.fillStyle = color;
    ctx.fill();
    ctx.shadowBlur = 0;

    // label
    ctx.fillStyle = isOpdlm ? '#c4b5fd' : 'rgba(156,163,175,.85)';
    ctx.font = `${isOpdlm ? 10 : 9}px "JetBrains Mono",monospace`;
    ctx.textAlign = 'left';
    const labelX = x + r + 5;
    const labelY = name === 'SDAR-8B' ? y - 10 : (name === 'Fast-dLLM-v2' ? y + 14 : y + 4);
    ctx.fillText(name, labelX, labelY);
  });
}

// ── Animated bar charts (IntersectionObserver) ────────────────────────────
const effSection = document.getElementById('s-efficiency');
if (effSection) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('#token-bars .bar-fill[data-w]').forEach(b => {
          b.style.width = b.dataset.w + '%';
        });
      }
    });
  }, { threshold: 0.2 }).observe(effSection);
}

const resSection = document.getElementById('s-results');
if (resSection) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('#vp-results .bar-fill[data-w]').forEach(b => {
          b.style.width = (parseFloat(b.dataset.w)) + '%';
        });
      }
    });
  }, { threshold: 0.2 }).observe(resSection);
}
</script>

</BaseLayout>

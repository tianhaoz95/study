.mismatch-panel-head.purple{background:rgba(139,92,246,.12);color:var(--purple-l);border-bottom:1px solid rgba(139,92,246,.25)}
.token-seq{display:flex;flex-wrap:wrap;gap:.35rem;padding:.875rem .75rem;min-height:80px;align-content:flex-start}
.tok{display:inline-flex;align-items:center;justify-content:center;font-size:.72rem;font-family:var(--ff-mono);padding:.2rem .45rem;border-radius:4px;font-weight:500;min-width:2.2rem;text-align:center}

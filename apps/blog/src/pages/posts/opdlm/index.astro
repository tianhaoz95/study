        <tr><td>MATH-500</td><td class="mn">71.2</td><td class="mn">75.6</td><td class="mn best">+4.4</td></tr>
        <tr class="highlight-row"><td>AIME-24</td><td class="mn">14.7</td><td class="mn">18.6</td><td class="mn best">+3.9</td></tr>
        <tr class="highlight-row"><td>AIME-25</td><td class="mn">12.4</td><td class="mn">19.4</td><td class="mn best">+7.0</td></tr>
        <tr><td>LMB-Hard</td><td class="mn">20.0</td><td class="mn">17.8</td><td class="mn thr">−2.2</td></tr>
        <tr><td>ZebraLogic</td><td class="mn">12.9</td><td class="mn">17.3</td><td class="mn best">+4.4</td></tr>
      </tbody>

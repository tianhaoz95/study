.tok.masked{background:rgba(107,114,128,.12);color:var(--muted);border:1px solid var(--border);letter-spacing:.02em}
.tok.hi{background:rgba(139,92,246,.18);color:var(--purple-l);border:1px solid rgba(139,92,246,.35)}
.tok.lo{background:rgba(245,158,11,.12);color:#fbbf24;border:1px solid rgba(245,158,11,.2)}
.mask-legend{display:flex;gap:1rem;padding:.5rem .75rem;border-top:1px solid var(--border);font-size:.63rem;color:var(--muted);font-family:var(--ff-mono)}
.mask-legend span{display:flex;align-items:center;gap:.3rem}
.mask-legend span::before{content:'';width:10px;height:10px;border-radius:2px;flex-shrink:0}
.mask-legend .l-mask::before{background:rgba(107,114,128,.12);border:1px solid var(--border)}
.mask-legend .l-hi::before{background:rgba(16,185,129,.15);border:1px solid rgba(16,185,129,.3)}
.mask-legend .l-lo::before{background:rgba(245,158,11,.12);border:1px solid rgba(245,158,11,.2)}

/* ── Training viz specific ─────────────────────────────────────────────── */
.training-flow{display:flex;flex-direction:column;gap:.625rem;padding:.5rem 0}
.tf-row{display:flex;align-items:center;gap:.75rem;font-size:.78rem}
.tf-label{font-family:var(--ff-mono);font-size:.67rem;color:var(--muted);width:80px;flex-shrink:0;text-align:right}
.tf-content{flex:1;display:flex;align-items:center;gap:.4rem;flex-wrap:wrap}
.tf-arrow{color:var(--muted);font-size:.8rem;flex-shrink:0}
.tf-box{padding:.25rem .6rem;border-radius:5px;font-size:.72rem;font-family:var(--ff-mono);border:1px solid;font-weight:500}
.tf-box.student{background:rgba(139,92,246,.12);color:var(--purple-l);border-color:rgba(139,92,246,.3)}

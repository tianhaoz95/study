<span class="cs-line cmt"># Standard MDLM training</span>
<span class="cs-line cmt"># x_0: clean sequence from data</span>
<span class="cs-line cmt"># x_t: randomly masked at time t</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">mdlm_loss</span>(model, x0, t):</span>
<span class="cs-line hl-c">    <span class="cmt"># forward masking — RANDOM</span></span>
<span class="cs-line hl-c">    xt = <span class="fn">random_mask</span>(x0, t)  <span class="cmt"># ← mismatch</span></span>
<span class="cs-line">    loss = <span class="num">0</span></span>
<span class="cs-line">    <span class="kw">for</span> i <span class="kw">in</span> <span class="fn">masked_positions</span>(xt):</span>
<span class="cs-line">        <span class="cmt"># predict clean token at masked pos</span></span>
<span class="cs-line">        logits = model(xt)</span>
<span class="cs-line">        loss -= (<span class="num">1</span>/t) * <span class="fn">log</span>(logits[i, x0[i]])</span>
<span class="cs-line">    <span class="kw">return</span> loss</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># At inference: confidence-guided</span>
<span class="cs-line hl-a"><span class="kw">def</span> <span class="fn">inference_step</span>(model, xt):</span>
<span class="cs-line hl-a">    logits = model(xt)    <span class="cmt"># bidirectional</span></span>
<span class="cs-line hl-a">    conf = <span class="fn">softmax</span>(logits).max(dim=-<span class="num">1</span>)</span>
<span class="cs-line hl-a">    <span class="cmt"># reveal high-confidence tokens first</span></span>
<span class="cs-line hl-a">    unmask = conf &gt; threshold <span class="cmt"># ← DIFFERENT</span></span>
<span class="cs-line hl-a">    xt[unmask] = <span class="fn">argmax</span>(logits[unmask])</span>
<span class="cs-line hl-a">    <span class="kw">return</span> xt</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Problem: states seen at train ≠ inference</span>
<span class="cs-line cmt"># "The _ sat _ the _"  (random)</span>
<span class="cs-line cmt"># "The _ sat on the _" (confidence-guided)</span>
<span class="cs-line cmt"># → model trained on wrong distribution</span>
</pre>
    </div>

    <!-- panel-background -->
    <div class="cs-panel" id="panel-background">
      <pre class="cs-pre">
<span class="cs-line cmt"># Block Diffusion Language Model</span>
<span class="cs-line cmt"># Sequence partitioned into blocks of size B</span>
<span class="cs-line cmt"># Each block denoised given clean prefix</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">block_diffusion_loss</span>(model, x0):</span>
<span class="cs-line hl-c">    <span class="cmt"># sample time uniformly</span></span>
<span class="cs-line hl-c">    t = <span class="fn">uniform</span>(<span class="num">0</span>, <span class="num">1</span>)</span>
<span class="cs-line">    loss = <span class="num">0</span></span>
<span class="cs-line">    <span class="kw">for</span> b <span class="kw">in</span> <span class="fn">range</span>(num_blocks):</span>
<span class="cs-line">        <span class="cmt"># mask block b at time t</span></span>
<span class="cs-line">        xt_b = <span class="fn">mask_block</span>(x0[b], t)</span>
<span class="cs-line">        <span class="kw">for</span> i <span class="kw">in</span> <span class="fn">masked_positions</span>(xt_b):</span>
<span class="cs-line">            <span class="cmt"># condition on clean prefix x0[&lt;b]</span></span>
<span class="cs-line">            logits = <span class="fn">model</span>(x0[:b], xt_b)</span>
<span class="cs-line">            loss -= (<span class="num">1</span>/t) * logits[i, x0[b][i]]</span>
<span class="cs-line">    <span class="kw">return</span> loss</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Inference: confidence-guided decoding</span>
<span class="cs-line hl-g"><span class="kw">def</span> <span class="fn">decode</span>(model, prompt, T_steps=<span class="num">4</span>):</span>
<span class="cs-line hl-g">    x = <span class="fn">full_mask</span>(prompt)     <span class="cmt"># x_T</span></span>
<span class="cs-line hl-g">    <span class="kw">for</span> step <span class="kw">in</span> <span class="fn">range</span>(T_steps):</span>
<span class="cs-line hl-g">        logits = <span class="fn">model</span>(x)      <span class="cmt"># all blocks</span></span>
<span class="cs-line hl-g">        conf = <span class="fn">max_prob</span>(logits)</span>
<span class="cs-line hl-g">        <span class="cmt"># unmask if confident enough</span></span>
<span class="cs-line hl-g">        x = <span class="fn">unmask_top</span>(x, logits, conf)</span>
<span class="cs-line hl-g">    <span class="kw">return</span> x          <span class="cmt"># x_0: final answer</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># block_size=4, steps=4 → ~1 token/step</span>
<span class="cs-line cmt"># block_size=4, steps=1 → 4 tokens/step</span>
</pre>
    </div>

    <!-- panel-method -->
    <div class="cs-panel" id="panel-method">
      <pre class="cs-pre">
<span class="cs-line cmt"># Algorithm 1: OPDLM Training Step</span>
<span class="cs-line cmt"># teacher: frozen ARLM pφ (causal attn)</span>
<span class="cs-line cmt"># student: DLM pθ (block-wise bidirectional)</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">opdlm_step</span>(student, teacher, sampler):</span>
<span class="cs-line hl-p">    <span class="cmt"># 1. student generates its own trajectory</span></span>
<span class="cs-line hl-c">    traj = <span class="fn">reverse_rollout</span>(student, sampler)</span>
<span class="cs-line hl-c">    <span class="cmt">#    traj = (x_T, x_&#123;T-1&#125;, ..., x_0)</span></span>
<span class="cs-line hl-c">    x0 = traj[<span class="num">0</span>]   <span class="cmt"># terminal clean sequence</span></span>
<span class="cs-line"> </span>
<span class="cs-line hl-g">    <span class="cmt"># 2. sample one intermediate state</span></span>
<span class="cs-line hl-g">    k = <span class="fn">randint</span>(<span class="num">1</span>, <span class="fn">len</span>(traj)-<span class="num">1</span>)</span>
<span class="cs-line hl-g">    xt = traj[k]    <span class="cmt"># partially masked state</span></span>
<span class="cs-line"> </span>
<span class="cs-line">    loss = <span class="num">0</span></span>
<span class="cs-line">    <span class="kw">for</span> b <span class="kw">in</span> <span class="fn">range</span>(num_blocks):</span>
<span class="cs-line">        <span class="kw">for</span> i <span class="kw">in</span> <span class="fn">masked_positions</span>(xt[b]):</span>
<span class="cs-line hl-a">            <span class="cmt"># teacher: uses CLEAN prefix x0</span></span>
<span class="cs-line hl-a">            pT = <span class="fn">teacher</span>(x0[:b], x0[b][:i])</span>
<span class="cs-line hl-a">            <span class="cmt"># student: uses masked state xt</span></span>
<span class="cs-line hl-a">            pS = <span class="fn">student</span>(x0[:b], xt[b])</span>
<span class="cs-line hl-a">            loss += <span class="fn">KL</span>(pT, pS)</span>
<span class="cs-line">    <span class="kw">return</span> loss</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># curriculum: short → long sequences</span>
<span class="cs-line hl-p">Ls = <span class="fn">min</span>(Lmax, Lmin + (s/Swarm)*(Lmax-Lmin))</span>
<span class="cs-line cmt"># avoids incoherent early rollouts</span>
</pre>
    </div>

    <!-- panel-ablation -->
    <div class="cs-panel" id="panel-ablation">
      <pre class="cs-pre">
<span class="cs-line cmt"># Three training variants — matched data</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># 1. Off-Policy: classic knowledge distillation</span>
<span class="cs-line hl-a"><span class="kw">def</span> <span class="fn">off_policy_loss</span>(student, teacher, data):</span>
<span class="cs-line hl-a">    x0 = <span class="fn">teacher_generate</span>(data)  <span class="cmt"># offline</span></span>
<span class="cs-line hl-a">    xt = <span class="fn">random_mask</span>(x0, t)      <span class="cmt"># random mask</span></span>
<span class="cs-line hl-a">    <span class="kw">return</span> <span class="fn">KL_loss</span>(teacher(x0), student(xt))</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># 2. OPDLMoff: on-policy responses,</span>
<span class="cs-line cmt">#    but still random masking</span>
<span class="cs-line hl-c"><span class="kw">def</span> <span class="fn">opdlm_off_loss</span>(student, teacher, prompts):</span>
<span class="cs-line hl-c">    x0 = <span class="fn">student_generate</span>(prompts)  <span class="cmt"># on-policy</span></span>
<span class="cs-line hl-c">    xt = <span class="fn">random_mask</span>(x0, t)         <span class="cmt"># still random</span></span>
<span class="cs-line hl-c">    <span class="kw">return</span> <span class="fn">KL_loss</span>(teacher(x0), student(xt))</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># 3. OPDLM: fully on-policy</span>
<span class="cs-line hl-g"><span class="kw">def</span> <span class="fn">opdlm_loss</span>(student, teacher, prompts):</span>
<span class="cs-line hl-g">    traj = <span class="fn">student_trajectory</span>(prompts)</span>
<span class="cs-line hl-g">    x0 = traj[-<span class="num">1</span>]    <span class="cmt"># on-policy terminal</span></span>
<span class="cs-line hl-g">    xt = <span class="fn">pick_from_traj</span>(traj)  <span class="cmt"># trajectory mask</span></span>
<span class="cs-line hl-g">    <span class="kw">return</span> <span class="fn">KL_loss</span>(teacher(x0), student(xt))</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Key finding: on-policy RESPONSE matters most</span>
<span class="cs-line cmt"># Off-Policy → OPDLMoff: +3.6 MMLU, +4.6 MATH</span>
<span class="cs-line cmt"># OPDLMoff → OPDLM: masking type is secondary</span>
</pre>

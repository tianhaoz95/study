<span class="cs-line hl-p">  <span class="str">'Oryx-TM (mamba mode)'</span>: <span class="num">56.6</span>,  <span class="cmt"># +0.9pp</span></span>
<span class="cs-line hl-p">  <span class="str">'Oryx-TG (attn mode)'</span>:  <span class="num">56.5</span>,  <span class="cmt"># +0.9pp</span></span>
<span class="cs-line hl-p">  <span class="str">'Oryx-TG (gdn mode)'</span>:   <span class="num">57.3</span>,  <span class="cmt"># +0.7pp</span></span>
<span class="cs-line">}</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Mixed-mode retrieval (linear ctx + attn gen)</span>
<span class="cs-line">retrieval = {</span>
<span class="cs-line">  <span class="cmt"># Real-world avg (SWDE, SQuAD, FDA, TQA, NQ, DROP)</span></span>
<span class="cs-line">  <span class="str">'Mamba-2 baseline'</span>:  <span class="num">30.3</span>,</span>
<span class="cs-line">  <span class="str">'GDN baseline'</span>:      <span class="num">32.8</span>,</span>

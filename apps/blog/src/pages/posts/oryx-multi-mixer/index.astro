<span class="cs-line hl-c">  <span class="str">'Oryx-TM mixed'</span>:     <span class="num">43.9</span>,  <span class="cmt"># +13.5pp vs M2</span></span>
<span class="cs-line hl-c">  <span class="str">'Oryx-TG mixed'</span>:     <span class="num">41.4</span>,  <span class="cmt"># +8.6pp vs GDN</span></span>
<span class="cs-line">}</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># NIAH avg (synthetic needle-in-haystack)</span>
<span class="cs-line">niah_avg = {</span>
<span class="cs-line">  <span class="str">'Mamba-2 baseline'</span>:  <span class="num">46.5</span>,</span>
<span class="cs-line">  <span class="str">'GDN baseline'</span>:      <span class="num">57.2</span>,</span>
<span class="cs-line">  <span class="str">'Transformer base'</span>:  <span class="num">94.8</span>,</span>
<span class="cs-line hl-g">  <span class="str">'Oryx-TM mixed'</span>:     <span class="num">85.1</span>,  <span class="cmt"># +38.6pp vs M2</span></span>
<span class="cs-line hl-g">  <span class="str">'Oryx-TG mixed'</span>:     <span class="num">97.5</span>,  <span class="cmt"># +40.3pp vs GDN</span></span>
<span class="cs-line">}</span>
      </pre>
    </div>

  </div>
</aside>

</div><!-- /post-grid -->

<script>
// ─── TOC + sidebar toggles ────────────────────────────────────────────────
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle  = document.getElementById('toc-toggle');
const postGrid   = document.getElementById('post-grid');
tocToggle?.addEventListener('click', () => {
  const c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});
const codeSidebar = document.getElementById('code-sidebar');
const csToggle    = document.getElementById('cs-toggle');
csToggle?.addEventListener('click', () => {
  const c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

// ─── Code sidebar tab switching ──────────────────────────────────────────
const tabMeta = {
  tradeoff: { file: 'oryx/model.py',    title: 'The Speed–Recall Trade-off' },
  shared:   { file: 'oryx/kv_view.py',  title: 'KV Associative Memory' },
  block:    { file: 'oryx/block.py',    title: 'The Oryx Block' },
  training: { file: 'oryx/train.py',    title: 'Chunked Mixed-Mode Training' },
  switch:   { file: 'oryx/infer.py',    title: 'Mode Switching Inference' },
  results:  { file: 'oryx/results.py',  title: 'Benchmark Results' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  document.querySelectorAll('.cs-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m) {
    document.getElementById('cs-file-label').textContent = m.file;
    document.getElementById('cs-section-title').textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(t => t.addEventListener('click', () => activateTab(t.dataset.panel)));

// ─── IntersectionObserver — TOC sync ─────────────────────────────────────
const sectionMap = {
  's-tradeoff': 'tradeoff',
  's-shared':   'shared',
  's-block':    'block',
  's-training': 'training',
  's-switch':   'switch',
  's-results':  'results',
};
document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s)
);

// ─── Seeded PRNG ──────────────────────────────────────────────────────────
function mkrng(seed) {
  let s = seed;
  return () => { s = (s * 1664525 + 1013904223) & 0xffffffff; return (s >>> 0) / 0xffffffff; };
}

// ─── §01: NIAH bar canvas ─────────────────────────────────────────────────
{
  const canvas = document.getElementById('niah-canvas');
  if (canvas) {
    const ctx = canvas.getContext('2d');
    const DPR = window.devicePixelRatio || 1;
    function drawNiah() {
      const W = canvas.clientWidth, H = 220;
      canvas.width = W * DPR; canvas.height = H * DPR;
      ctx.scale(DPR, DPR);

      const bars = [
        { label: 'Transformer', val: 95.0, color: 'rgba(100,100,140,.55)', note: 'NIAH-3: 95.0%' },
        { label: 'Gated DeltaNet', val: 32.6, color: 'rgba(6,182,212,.45)', note: 'NIAH-3: 32.6%' },
        { label: 'Mamba-2', val: 33.2, color: 'rgba(6,182,212,.45)', note: 'NIAH-3: 33.2%' },
      ];

      const pad = { l: 140, r: 90, t: 24, b: 30 };
      const bH = 34, gap = 22;
      const maxW = W - pad.l - pad.r;

      // Title
      ctx.fillStyle = 'rgba(255,255,255,.25)';
      ctx.font = '600 11px monospace';
      ctx.textAlign = 'left';
      ctx.fillText('"What capital city is mentioned?" — find in 2K-token haystack', pad.l, 18);

      bars.forEach((b, i) => {
        const y = pad.t + 10 + i * (bH + gap);
        const bW = (b.val / 100) * maxW;

        // Label
        ctx.fillStyle = 'rgba(255,255,255,.55)';
        ctx.font = '12px monospace';
        ctx.textAlign = 'right';
        ctx.fillText(b.label, pad.l - 10, y + bH / 2 + 4);

        // Track
        ctx.fillStyle = 'rgba(255,255,255,.05)';
        ctx.beginPath();
        ctx.roundRect(pad.l, y, maxW, bH, 4);
        ctx.fill();

        // Fill
        ctx.fillStyle = b.color;
        ctx.beginPath();
        ctx.roundRect(pad.l, y, bW, bH, 4);
        ctx.fill();

        // Value label
        ctx.fillStyle = 'rgba(255,255,255,.85)';
        ctx.font = 'bold 12px monospace';
        ctx.textAlign = 'left';
        ctx.fillText(b.note, pad.l + bW + 8, y + bH / 2 + 4);
      });

      // X-axis
      ctx.strokeStyle = 'rgba(255,255,255,.08)';
      ctx.lineWidth = 1;
      [0, 25, 50, 75, 100].forEach(v => {
        const x = pad.l + (v / 100) * maxW;
        ctx.beginPath(); ctx.moveTo(x, pad.t + 8); ctx.lineTo(x, H - pad.b + 4); ctx.stroke();
        ctx.fillStyle = 'rgba(255,255,255,.25)';
        ctx.font = '10px monospace';
        ctx.textAlign = 'center';
        ctx.fillText(v + '%', x, H - pad.b + 16);
      });
    }
    drawNiah();
    window.addEventListener('resize', drawNiah);
  }
}

// ─── §04: Chunk assignment canvas ────────────────────────────────────────
{
  const canvas = document.getElementById('chunk-canvas');
  const randomizeBtn = document.getElementById('chunk-randomize');
  const attnCount = document.getElementById('attn-count');
  const linearCount = document.getElementById('linear-count');
  if (canvas) {
    const ctx = canvas.getContext('2d');
    const DPR = window.devicePixelRatio || 1;
    const N = 16;
    let rng = mkrng(42);
    let modes = Array.from({ length: N }, () => rng() < 0.25 ? 'attn' : 'linear');

    function drawChunks() {
      const W = canvas.clientWidth, H = 100;
      canvas.width = W * DPR; canvas.height = H * DPR;
      ctx.scale(DPR, DPR);

      const gap = 4;
      const bW = (W - (N - 1) * gap) / N;
      const bH = 56;
      const y0 = 20;

      // Seq label
      ctx.fillStyle = 'rgba(255,255,255,.25)';
      ctx.font = '10px monospace';
      ctx.textAlign = 'left';
      ctx.fillText('training sequence   ▸   16 chunks × 128 tokens', 0, 14);

      let nAttn = 0;
      modes.forEach((m, i) => {
        const x = i * (bW + gap);
        const isAttn = m === 'attn';
        if (isAttn) nAttn++;

        ctx.fillStyle = isAttn ? 'rgba(139,92,246,.55)' : 'rgba(6,182,212,.35)';
        ctx.beginPath();
        ctx.roundRect(x, y0, bW, bH, 3);
        ctx.fill();

        ctx.strokeStyle = isAttn ? 'rgba(139,92,246,.8)' : 'rgba(6,182,212,.55)';
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.roundRect(x, y0, bW, bH, 3);
        ctx.stroke();

        if (bW > 20) {
          ctx.fillStyle = 'rgba(255,255,255,.75)';
          ctx.font = '600 8.5px monospace';
          ctx.textAlign = 'center';
          ctx.fillText(isAttn ? 'ATTN' : 'LIN', x + bW / 2, y0 + bH / 2 + 3);
        }

        ctx.fillStyle = 'rgba(255,255,255,.3)';
        ctx.font = '8px monospace';
        ctx.textAlign = 'center';
        ctx.fillText(String(i + 1), x + bW / 2, y0 + bH + 11);
      });

      if (attnCount) attnCount.textContent = String(nAttn);
      if (linearCount) linearCount.textContent = String(N - nAttn);
    }

    function randomize() {
      rng = mkrng(Math.floor(Math.random() * 99999));
      modes = Array.from({ length: N }, () => rng() < 0.25 ? 'attn' : 'linear');
      drawChunks();
    }

    randomizeBtn?.addEventListener('click', randomize);
    drawChunks();
    window.addEventListener('resize', drawChunks);
  }
}

// ─── §05: Perplexity recovery line chart ─────────────────────────────────
{
  const canvas = document.getElementById('ppl-canvas');
  const dirBtns  = document.querySelectorAll('.ppl-dir-btn');
  const swBtns   = document.querySelectorAll('.ppl-sw-btn');

  let direction = 'attn2mamba';
  let switchAt  = '512';

  // Approximate perplexity curves from paper Figure 3
  // X: tokens 400..2000 (step 8), Y: perplexity
  function makePplCurves(dir) {
    const xs = [];
    for (let t = 400; t <= 2000; t += 16) xs.push(t);

    function gaussSmooth(arr, sigma) {
      return arr.map((_, i) => {
        let sum = 0, w = 0;
        for (let j = 0; j < arr.length; j++) {
          const d = Math.abs(i - j);
          const wj = Math.exp(-d * d / (2 * sigma * sigma));
          sum += arr[j] * wj; w += wj;
        }
        return sum / w;
      });
    }

    // base1: mode that's running without switch
    // base2: target mode (constant)
    // switchAt=512/1024/1536: spike at switch, recover
    const A2M = dir === 'attn2mamba'; // attn→mamba or mamba→attn

    const base1 = A2M ? 9.35 : 9.38;  // no-switch source mode ppl
    const base2 = A2M ? 9.38 : 9.35;  // no-switch target mode ppl

    function makeSwitchCurve(swToken, spikeMag) {
      return xs.map(t => {
        if (t < swToken) return base1 + (Math.sin(t * 0.05) * 0.005);
        const dt = t - swToken;
        const decay = Math.exp(-dt / 120);
        const spike = spikeMag * decay;
        return base2 + spike + (Math.cos(t * 0.04) * 0.004);
      });
    }

    return {
      xs,
      noswitch1: xs.map(t => base1 + Math.sin(t * 0.05) * 0.005),
      noswitch2: xs.map(t => base2 + Math.cos(t * 0.04) * 0.004),
      sw512:  gaussSmooth(makeSwitchCurve(512, A2M ? 0.18 : 0.22), 1.5),
      sw1024: gaussSmooth(makeSwitchCurve(1024, A2M ? 0.16 : 0.20), 1.5),
      sw1536: gaussSmooth(makeSwitchCurve(1536, A2M ? 0.14 : 0.18), 1.5),
    };
  }

  if (canvas) {
    const ctx = canvas.getContext('2d');
    const DPR = window.devicePixelRatio || 1;

    function drawPpl() {
      const W = canvas.clientWidth, H = 260;
      canvas.width = W * DPR; canvas.height = H * DPR;
      ctx.scale(DPR, DPR);

      const c = makePplCurves(direction);
      const pad = { l: 52, r: 20, t: 20, b: 34 };
      const cW = W - pad.l - pad.r;
      const cH = H - pad.t - pad.b;

      const allVals = [...c.noswitch1, ...c.noswitch2, ...c.sw512, ...c.sw1024, ...c.sw1536];
      const minY = Math.min(...allVals) - 0.02;
      const maxY = Math.max(...allVals) + 0.03;

      function tx(t) { return pad.l + ((t - 400) / (2000 - 400)) * cW; }
      function ty(v) { return pad.t + cH - ((v - minY) / (maxY - minY)) * cH; }

      // Grid
      ctx.strokeStyle = 'rgba(255,255,255,.05)';
      ctx.lineWidth = 1;
      [400, 600, 800, 1000, 1200, 1400, 1600, 1800, 2000].forEach(t => {
        ctx.beginPath(); ctx.moveTo(tx(t), pad.t); ctx.lineTo(tx(t), pad.t + cH); ctx.stroke();
      });

      // Y axis labels
      const pplTicks = [];
      const lo = Math.ceil(minY * 10) / 10;
      const hi = Math.floor(maxY * 10) / 10;
      for (let v = lo; v <= hi + 0.001; v += 0.1) {
        pplTicks.push(Math.round(v * 10) / 10);
      }
      ctx.fillStyle = 'rgba(255,255,255,.3)';
      ctx.font = '10px monospace';
      ctx.textAlign = 'right';
      pplTicks.forEach(v => {
        const y = ty(v);
        ctx.strokeStyle = 'rgba(255,255,255,.04)';
        ctx.beginPath(); ctx.moveTo(pad.l, y); ctx.lineTo(pad.l + cW, y); ctx.stroke();
        ctx.fillText(v.toFixed(1), pad.l - 5, y + 3.5);
      });

      // X axis labels
      ctx.textAlign = 'center';
      [500, 750, 1000, 1250, 1500, 1750, 2000].forEach(t => {
        ctx.fillText(t, tx(t), pad.t + cH + 16);
      });
      ctx.fillStyle = 'rgba(255,255,255,.2)';
      ctx.font = '9px monospace';
      ctx.textAlign = 'center';
      ctx.fillText('token position', pad.l + cW / 2, H - 4);

      // Draw a curve
      function drawCurve(ys, color, dash, lw) {
        ctx.strokeStyle = color;
        ctx.lineWidth = lw;
        ctx.setLineDash(dash);
        ctx.beginPath();
        c.xs.forEach((t, i) => {
          const x = tx(t), y = ty(ys[i]);
          i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
        });
        ctx.stroke();
        ctx.setLineDash([]);
      }

      // No-switch baselines (dashed, dim)
      const A2M = direction === 'attn2mamba';
      drawCurve(c.noswitch1, A2M ? 'rgba(139,92,246,.4)' : 'rgba(6,182,212,.4)', [5, 4], 1.5);
      drawCurve(c.noswitch2, A2M ? 'rgba(6,182,212,.4)' : 'rgba(139,92,246,.4)', [5, 4], 1.5);

      // Selected switch curve (bright)
      const swCurves = { '512': c.sw512, '1024': c.sw1024, '1536': c.sw1536, 'none': c.noswitch1 };
      const activeColor = 'rgba(245,158,11,.9)';
      if (switchAt in swCurves && switchAt !== 'none') {
        drawCurve(swCurves[switchAt], activeColor, [], 2);
        // Vertical marker at switch point
        const swT = parseInt(switchAt);
        ctx.strokeStyle = 'rgba(245,158,11,.3)';
        ctx.lineWidth = 1;
        ctx.setLineDash([4, 4]);
        ctx.beginPath(); ctx.moveTo(tx(swT), pad.t); ctx.lineTo(tx(swT), pad.t + cH); ctx.stroke();
        ctx.setLineDash([]);
        ctx.fillStyle = 'rgba(245,158,11,.7)';
        ctx.font = '9px monospace';
        ctx.textAlign = 'center';
        ctx.fillText('switch', tx(swT), pad.t + 12);
      }

      // Legend
      const legItems = A2M
        ? [['Attn (no switch)', 'rgba(139,92,246,.6)', [5,4]], ['Mamba-2 (no switch)', 'rgba(6,182,212,.6)', [5,4]], ['Switch @ ' + switchAt, activeColor, []]]
        : [['Mamba-2 (no switch)', 'rgba(6,182,212,.6)', [5,4]], ['Attn (no switch)', 'rgba(139,92,246,.6)', [5,4]], ['Switch @ ' + switchAt, activeColor, []]];
      if (switchAt === 'none') legItems.pop();

      let lx = pad.l + 10;
      legItems.forEach(([label, col, dash]) => {
        ctx.strokeStyle = col;
        ctx.lineWidth = dash.length ? 1.5 : 2;
        ctx.setLineDash(dash);
        ctx.beginPath(); ctx.moveTo(lx, pad.t + 8); ctx.lineTo(lx + 22, pad.t + 8); ctx.stroke();
        ctx.setLineDash([]);
        ctx.fillStyle = 'rgba(255,255,255,.45)';
        ctx.font = '10px monospace';
        ctx.textAlign = 'left';
        ctx.fillText(label, lx + 26, pad.t + 12);
        lx += ctx.measureText(label).width + 54;
      });
    }

    dirBtns.forEach(b => b.addEventListener('click', () => {
      dirBtns.forEach(x => x.classList.remove('active'));
      b.classList.add('active');
      direction = b.dataset.dir;
      drawPpl();
    }));
    swBtns.forEach(b => b.addEventListener('click', () => {
      swBtns.forEach(x => x.classList.remove('active'));
      b.classList.add('active');
      switchAt = b.dataset.sw;
      drawPpl();
    }));

    drawPpl();
    window.addEventListener('resize', drawPpl);
  }
}

// ─── §06: Retrieval bars animation + tab switch ───────────────────────────
{
  let barsTriggered = false;

  function triggerBars() {
    document.querySelectorAll('.bar-fill[data-w]').forEach(b => {
      const maxVal = b.closest('#ret-realworld') || b.closest('#ret-niah') ? 100 : 100;
      b.style.width = (parseFloat(b.dataset.w) / 100 * 100) + '%';
    });
  }

  const retSec = document.getElementById('s-results');
  if (retSec) {
    new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting && !barsTriggered) {
          barsTriggered = true;
          triggerBars();
        }
      });
    }, { threshold: 0.2 }).observe(retSec);
  }

  document.querySelectorAll('.ret-tab').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.ret-tab').forEach(t => t.classList.remove('active'));
      btn.classList.add('active');
      const which = btn.dataset.rt;
      document.getElementById('ret-realworld').style.display = which === 'realworld' ? '' : 'none';
      document.getElementById('ret-niah').style.display = which === 'niah' ? '' : 'none';
      if (barsTriggered) triggerBars();
    });
  });
}
</script>
</BaseLayout>

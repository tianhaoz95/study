<span class="cs-line cmt"># Memory cost comparison at sequence length T</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Softmax attention</span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">attn_memory</span>(T, d_k, n_heads):</span>
<span class="cs-line hl-p">    <span class="cmt"># KV cache stores all past keys + values</span></span>
<span class="cs-line hl-p">    kv_cache = <span class="num">2</span> * T * d_k * n_heads    <span class="cmt"># O(T)</span></span>
<span class="cs-line hl-p">    <span class="kw">return</span> kv_cache</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Linear recurrence (Mamba-2 / GDN)</span>
<span class="cs-line hl-c"><span class="kw">def</span> <span class="fn">linear_memory</span>(d_k, d_v):</span>
<span class="cs-line hl-c">    <span class="cmt"># Fixed-size state: d_k × d_v matrix</span></span>
<span class="cs-line hl-c">    state = d_k * d_v                   <span class="cmt"># O(1) w.r.t. T</span></span>
<span class="cs-line hl-c">    <span class="kw">return</span> state</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Example: T=2048, d_k=128, 16 heads, d_v=128</span>
<span class="cs-line"><span class="cmt"># attn_memory  ≈ 2*2048*128*16 = 8,388,608</span></span>
<span class="cs-line"><span class="cmt"># linear_memory ≈ 128*128 = 16,384</span></span>
<span class="cs-line"><span class="cmt"># ratio: ~512× more memory for attention!</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># NIAH-3 accuracy at 1.4B scale (from paper)</span>
<span class="cs-line">niah3 = {</span>
<span class="cs-line">    <span class="str">'transformer'</span>: <span class="num">95.0</span>,  <span class="cmt"># finds the needle</span></span>
<span class="cs-line">    <span class="str">'mamba_2'</span>:    <span class="num">33.2</span>,  <span class="cmt"># often forgets it</span></span>
<span class="cs-line">    <span class="str">'gdn'</span>:         <span class="num">32.6</span>,  <span class="cmt"># similar story</span></span>
<span class="cs-line">}</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Traditional hybrid approaches</span>
<span class="cs-line cmt"># Inter-layer: fixed attn at layers 4, 8, 12...</span>
<span class="cs-line cmt"># Intra-layer: blend attn+linear in every block</span>
<span class="cs-line cmt"># Both: mechanism is fixed per-position, not</span>
<span class="cs-line cmt">#        adaptive to what the sequence needs</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-shared">
      <pre class="cs-pre">
<span class="cs-line cmt"># Both mechanisms under the KV-associative view</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Shared projections (same weights for both modes)</span>
<span class="cs-line hl-a">q = x @ W_Q_M       <span class="cmt"># mode-specific query</span></span>
<span class="cs-line hl-a">k = x @ W_K         <span class="cmt"># SHARED key proj</span></span>
<span class="cs-line hl-a">v = x @ W_V         <span class="cmt"># SHARED value proj</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Softmax attention output</span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">attn_output</span>(q, K_cache, V_cache):</span>
<span class="cs-line hl-p">    scores = <span class="fn">softmax</span>(q @ K_cache.T)</span>
<span class="cs-line hl-p">    <span class="kw">return</span> scores @ V_cache       <span class="cmt"># explicit lookup</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Mamba-2 output</span>
<span class="cs-line hl-c"><span class="kw">def</span> <span class="fn">mamba2_output</span>(q, k, v, S_prev, alpha):</span>
<span class="cs-line hl-c">    S = alpha * S_prev + k.T @ v   <span class="cmt"># compress into S</span></span>
<span class="cs-line hl-c">    <span class="kw">return</span> q @ S                   <span class="cmt"># fast readout</span></span>
<span class="cs-line"></span>
<span class="cs-line cmt"># GDN (Gated DeltaNet) output</span>
<span class="cs-line hl-g"><span class="kw">def</span> <span class="fn">gdn_output</span>(q, k, v, S_prev, alpha, beta):</span>
<span class="cs-line hl-g">    <span class="cmt"># Delta rule: erase old entry, write new</span></span>
<span class="cs-line hl-g">    S = (alpha*I - beta*k.T@k) @ S_prev + beta*k.T@v</span>
<span class="cs-line hl-g">    <span class="kw">return</span> q @ S</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># KEY INSIGHT: all three compute output = q · M</span>
<span class="cs-line cmt"># where M is stored differently (explicit cache</span>
<span class="cs-line cmt"># vs fixed state), but derived from the SAME</span>
<span class="cs-line cmt"># k, v pairs → tied W_K, W_V enables sharing.</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Ablation: tying W_Q hurts (ppl 16.1 vs 15.9)</span>
<span class="cs-line cmt"># Tying only W_K, W_V: optimal.</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-block">
      <pre class="cs-pre">
<span class="cs-line cmt"># Oryx block pseudocode (single layer)</span>
<span class="cs-line"></span>
<span class="cs-line hl-p"><span class="kw">class</span> <span class="cls">OryxBlock</span>:</span>
<span class="cs-line hl-p">    <span class="cmt"># Shared weights (>90% of params)</span></span>
<span class="cs-line hl-p">    W_K, W_V, W_G, W_O = ...  <span class="cmt"># tied</span></span>
<span class="cs-line hl-p">    conv = <span class="cls">ShortConv1d</span>()</span>
<span class="cs-line hl-p">    <span class="cmt"># Mixer-specific weights</span></span>
<span class="cs-line hl-p">    W_Q_attn, W_Q_linear = ...  <span class="cmt"># disjoint</span></span>
<span class="cs-line"></span>
<span class="cs-line hl-c">    <span class="kw">def</span> <span class="fn">forward</span>(<span class="self">self</span>, x, mode, kv_cache, S):</span>
<span class="cs-line hl-c">        <span class="cmt"># Shared key/value projections</span></span>
<span class="cs-line hl-c">        k = <span class="self">self</span>.conv(x @ <span class="self">self</span>.W_K)</span>
<span class="cs-line hl-c">        v = <span class="self">self</span>.conv(x @ <span class="self">self</span>.W_V)</span>
<span class="cs-line"></span>
<span class="cs-line hl-a">        <span class="cmt"># Always update BOTH states</span></span>
<span class="cs-line hl-a">        kv_cache.<span class="fn">append</span>(k, v)</span>
<span class="cs-line hl-a">        S = <span class="fn">rnn_update</span>(S, k, v)</span>
<span class="cs-line"></span>
<span class="cs-line hl-g">        <span class="cmt"># Select output from chosen mode</span></span>
<span class="cs-line hl-g">        <span class="kw">if</span> mode == <span class="str">'attn'</span>:</span>
<span class="cs-line hl-g">            q = x @ <span class="self">self</span>.W_Q_attn</span>
<span class="cs-line hl-g">            o = <span class="fn">softmax_attn</span>(q, kv_cache)</span>
<span class="cs-line hl-g">        <span class="kw">else</span>:</span>
<span class="cs-line hl-g">            q = x @ <span class="self">self</span>.W_Q_linear</span>
<span class="cs-line hl-g">            o = q @ S</span>
<span class="cs-line"></span>
<span class="cs-line">        <span class="cmt"># Shared gated output projection</span></span>
<span class="cs-line">        gate = <span class="fn">silu</span>(x @ <span class="self">self</span>.W_G)</span>
<span class="cs-line">        <span class="kw">return</span> <span class="fn">GatedRMSNorm</span>(o, gate) @ <span class="self">self</span>.W_O</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-training">
      <pre class="cs-pre">
<span class="cs-line cmt"># Chunked mixed-mode training</span>
<span class="cs-line"></span>
<span class="cs-line hl-p">CHUNK_SIZE = <span class="num">128</span>      <span class="cmt"># tokens per chunk</span></span>
<span class="cs-line hl-p">ATTN_RATIO = <span class="num">0.25</span>    <span class="cmt"># 1:3 attention:linear</span></span>
<span class="cs-line"></span>
<span class="cs-line hl-c"><span class="kw">def</span> <span class="fn">make_chunk_plan</span>(seq_len):</span>
<span class="cs-line hl-c">    n_chunks = seq_len // CHUNK_SIZE</span>
<span class="cs-line hl-c">    <span class="cmt"># Each chunk independently assigned</span></span>
<span class="cs-line hl-c">    modes = [</span>
<span class="cs-line hl-c">        <span class="str">'attn'</span> <span class="kw">if</span> rand() &lt; ATTN_RATIO <span class="kw">else</span> <span class="str">'linear'</span></span>
<span class="cs-line hl-c">        <span class="kw">for</span> _ <span class="kw">in</span> <span class="fn">range</span>(n_chunks)</span>
<span class="cs-line hl-c">    ]</span>
<span class="cs-line hl-c">    <span class="kw">return</span> modes  <span class="cmt"># same for all Oryx blocks</span></span>
<span class="cs-line"></span>
<span class="cs-line hl-a"><span class="kw">def</span> <span class="fn">train_step</span>(model, batch):</span>
<span class="cs-line hl-a">    <span class="kw">for</span> seq <span class="kw">in</span> batch:</span>
<span class="cs-line hl-a">        plan = <span class="fn">make_chunk_plan</span>(<span class="fn">len</span>(seq))</span>
<span class="cs-line hl-a">        loss = model.<span class="fn">forward</span>(seq, plan)</span>
<span class="cs-line hl-a">        loss.<span class="fn">backward</span>()</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Key: ALL Oryx blocks share the same plan</span>
<span class="cs-line cmt"># chunk 3 is 'linear' in every layer at once</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Sequence-level training (worse at switching):</span>
<span class="cs-line cmt"># entire seq assigned to one mode — model never</span>
<span class="cs-line cmt"># sees a boundary between modes during training.</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Probability all 16 chunks get attention:</span>
<span class="cs-line cmt"># (0.25)^16 ≈ 2.3e-10  → essentially never seen</span>
<span class="cs-line cmt"># Yet model generalizes to full-attn mode!</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-switch">
      <pre class="cs-pre">
<span class="cs-line cmt"># Inference with mid-sequence mode switch</span>
<span class="cs-line"></span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">oryx_inference</span>(model, tokens, switch_at):</span>
<span class="cs-line hl-p">    kv_cache = <span class="cls">KVCache</span>()</span>
<span class="cs-line hl-p">    S = <span class="fn">zeros</span>(d_k, d_v)  <span class="cmt"># linear state</span></span>
<span class="cs-line"></span>
<span class="cs-line hl-a">    <span class="kw">for</span> t, x <span class="kw">in</span> <span class="fn">enumerate</span>(tokens):</span>
<span class="cs-line hl-a">        <span class="cmt"># Choose mode based on position</span></span>
<span class="cs-line hl-a">        mode = <span class="str">'linear'</span> <span class="kw">if</span> t &lt; switch_at <span class="kw">else</span> <span class="str">'attn'</span></span>
<span class="cs-line hl-a"></span>
<span class="cs-line hl-c">        <span class="cmt"># BOTH states updated every step</span></span>
<span class="cs-line hl-c">        k, v = <span class="fn">project_kv</span>(x)</span>
<span class="cs-line hl-c">        kv_cache.<span class="fn">append</span>(k, v)  <span class="cmt"># even in linear mode</span></span>
<span class="cs-line hl-c">        S = <span class="fn">rnn_update</span>(S, k, v)  <span class="cmt"># even in attn mode</span></span>
<span class="cs-line"></span>
<span class="cs-line hl-g">        o = <span class="fn">oryx_output</span>(mode, kv_cache, S, x)</span>
<span class="cs-line hl-g">        <span class="fn">yield</span> o</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Recovery after switch (Fig. 3 from paper):</span>
<span class="cs-line cmt"># Switch @ 512 → ppl spike resolves by ~700</span>
<span class="cs-line cmt"># Switch @ 1024 → resolves by ~1200</span>
<span class="cs-line cmt"># Switch @ 1536 → resolves by ~1700</span>
<span class="cs-line cmt"># ~150-200 token recovery in all cases</span>
<span class="cs-line"></span>
<span class="cs-line cmt"># Memory note: during switching, model keeps</span>
<span class="cs-line cmt"># BOTH KV cache and RNN state in memory.</span>
<span class="cs-line cmt"># At long context, KV cache dominates anyway.</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-results">
      <pre class="cs-pre">
<span class="cs-line cmt"># 1.4B model results (100B tokens, FineWeb-Edu)</span>
<span class="cs-line"></span>

.loss-eq-del{background:rgba(239,68,68,.15);color:#f87171;padding:.1rem .3rem;border-radius:3px;text-decoration:line-through}
.loss-eq-add{background:rgba(16,185,129,.15);color:#34d399;padding:.1rem .3rem;border-radius:3px}
@media(max-width:680px){.loss-diff{grid-template-columns:1fr}}

/* Results bars */
.results-bars{margin:1.5rem 0;display:flex;flex-direction:column;gap:.625rem}
.bar-row{display:flex;align-items:center;gap:.75rem}
.bar-label{font-size:.72rem;font-family:var(--ff-mono);color:var(--muted2);width:220px;flex-shrink:0;text-align:right;line-height:1.3}

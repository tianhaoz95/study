<span class="cs-line cmt"># Speculative decoding — base loop</span>
<span class="cs-line cmt"># (pseudocode, simplified)</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">speculative_decode</span>(target, drafter, prompt):</span>
<span class="cs-line">    ctx = prompt</span>
<span class="cs-line">    out = []</span>
<span class="cs-line">    <span class="kw">while</span> <span class="kw">not</span> done:</span>
<span class="cs-line cmt">        # Propose γ draft tokens</span>
<span class="cs-line hl-c">        drafts = drafter.propose(ctx, gamma=16)</span>
<span class="cs-line cmt">        # Verify all γ in ONE target pass</span>
<span class="cs-line hl-g">        accepted, bonus = target.verify(ctx, drafts)</span>
<span class="cs-line">        out += accepted + [bonus]</span>
<span class="cs-line">        ctx += out</span>
<span class="cs-line">    <span class="kw">return</span> out</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># AR drafter (EAGLE-3 style):</span>
<span class="cs-line cmt"># — Must generate tokens one-by-one</span>
<span class="cs-line cmt"># — Cost = γ × t_step (linear!)</span>
<span class="cs-line cmt"># — Limited capacity (1-layer) to stay fast</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Speedup formula (Sadhukhan et al. 2025):</span>
<span class="cs-line cmt">#   speedup = τ × T_target /</span>
<span class="cs-line cmt">#             (T_draft + T_verify)</span>
<span class="cs-line cmt">#</span>
<span class="cs-line cmt"># AR ceiling:</span>
<span class="cs-line cmt">#   T_draft = γ × t_step grows with γ</span>
<span class="cs-line cmt">#   τ saturates (limited drafter capacity)</span>
<span class="cs-line cmt">#   → EAGLE-3 hits ~2.75× on GSM8K</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># DFlash insight:</span>
<span class="cs-line cmt">#   T_draft = t_parallel (fixed, parallel)</span>
<span class="cs-line cmt">#   → DFlash hits 6.08× on GSM8K</span>
      </pre>
    </div>

    <!-- panel: dflash -->
    <div class="cs-panel" id="panel-dflash">
      <pre class="cs-pre">
<span class="cs-line cmt"># DFlash: block diffusion drafter</span>
<span class="cs-line cmt"># arXiv:2602.06036</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">class</span> <span class="cls">DFlashDrafter</span>(<span class="cls">nn.Module</span>):</span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">__init__</span>(<span class="kw">self</span>, n_layers=<span class="num">5</span>, d=<span class="num">1024</span>):</span>
<span class="cs-line">        <span class="kw">super</span>().__init__()</span>
<span class="cs-line hl-c">        <span class="kw">self</span>.head = <span class="fn">DraftHead</span>(d)    <span class="cmt"># embeds context</span></span>
<span class="cs-line hl-c">        <span class="kw">self</span>.layers = <span class="cls">nn</span>.<span class="fn">ModuleList</span>([</span>
<span class="cs-line hl-c">            <span class="fn">BidirAttnLayer</span>(d)       <span class="cmt"># bidirectional!</span></span>
<span class="cs-line hl-c">            <span class="kw">for</span> _ <span class="kw">in</span> <span class="fn">range</span>(n_layers)])</span>
<span class="cs-line hl-g">        <span class="kw">self</span>.tail = <span class="fn">LMHead</span>(d)      <span class="cmt"># token logits</span></span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">forward</span>(<span class="kw">self</span>, x_masked, h_target):</span>
<span class="cs-line cmt">        # x_masked: [MASK]*γ draft positions</span>
<span class="cs-line cmt">        # h_target: frozen target hidden states</span>
<span class="cs-line">        h = <span class="kw">self</span>.head(x_masked, h_target)</span>
<span class="cs-line">        <span class="kw">for</span> layer <span class="kw">in</span> <span class="kw">self</span>.layers:</span>
<span class="cs-line hl-p">            h = layer(h)  <span class="cmt"># all γ attend to each other</span></span>
<span class="cs-line">        <span class="kw">return</span> <span class="kw">self</span>.tail(h)  <span class="cmt"># γ token dists, parallel</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Key: one forward pass generates all γ tokens</span>
<span class="cs-line cmt"># Cost: t_parallel (fixed, GPU-parallel)</span>
<span class="cs-line cmt"># 5-layer DFlash (16 tokens) &lt; 1-layer EAGLE-3 latency</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># DFlash results on Qwen3-8B:</span>
<span class="cs-line cmt"># GSM8K:     6.08× (EAGLE-3: 2.75×)</span>
<span class="cs-line cmt"># MATH500:   5.62× (EAGLE-3: 2.23×)</span>
<span class="cs-line cmt"># HumanEval: 5.51× (EAGLE-3: 2.17×)</span>
<span class="cs-line cmt"># MBPP:      4.65× (EAGLE-3: 2.05×)</span>
      </pre>
    </div>

    <!-- panel: looping -->
    <div class="cs-panel" id="panel-looping">
      <pre class="cs-pre">
<span class="cs-line cmt"># LoopMDM: selective layer looping</span>
<span class="cs-line cmt"># arXiv:2605.26106</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">class</span> <span class="cls">LoopMDM</span>(<span class="cls">nn.Module</span>):</span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">__init__</span>(<span class="kw">self</span>, S_max=<span class="num">12</span>):</span>
<span class="cs-line hl-c">        <span class="kw">self</span>.head = <span class="fn">Head</span>()     <span class="cmt"># applied once</span></span>
<span class="cs-line hl-c">        <span class="kw">self</span>.mid  = <span class="fn">MidBlock</span>() <span class="cmt"># SHARED, loops S times</span></span>
<span class="cs-line hl-g">        <span class="kw">self</span>.tail = <span class="fn">Tail</span>()     <span class="cmt"># applied once</span></span>
<span class="cs-line">        <span class="kw">self</span>.S_max = S_max</span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">forward</span>(<span class="kw">self</span>, x_t, S=<span class="kw">None</span>):</span>
<span class="cs-line">        <span class="kw">if</span> S <span class="kw">is</span> <span class="kw">None</span>:</span>
<span class="cs-line cmt">            # Training: stochastic S</span>
<span class="cs-line">            S = <span class="fn">randint</span>(<span class="num">1</span>, <span class="kw">self</span>.S_max)</span>
<span class="cs-line hl-p">        H = <span class="kw">self</span>.head(x_t)</span>
<span class="cs-line hl-p">        <span class="kw">for</span> _ <span class="kw">in</span> <span class="fn">range</span>(S):         <span class="cmt"># shared block, S times</span></span>
<span class="cs-line hl-p">            H = <span class="kw">self</span>.mid(H)        <span class="cmt"># same weights every loop</span></span>
<span class="cs-line hl-p">        <span class="kw">return</span> <span class="kw">self</span>.tail(H)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Key results (170M params, FineWeb-Edu):</span>
<span class="cs-line cmt"># S=1:  gen PPL 116.74 (same as shallow)</span>
<span class="cs-line cmt"># S=6:  gen PPL  99.06 (-15% vs baseline)</span>
<span class="cs-line cmt"># S=12: gen PPL  84.71 (-27% vs baseline)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Training efficiency (matched FLOPs):</span>
<span class="cs-line cmt"># Reaches same NLL with 3.34× fewer steps</span>
<span class="cs-line cmt"># GSM8K: +8.5 pts at S=16 vs S=1</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Placement: loop mid-layers 1-2 (0-indexed)</span>
<span class="cs-line cmt"># Early-middle layers work best</span>
<span class="cs-line cmt"># Head + tail stay unshared (specialization)</span>
      </pre>
    </div>

    <!-- panel: proposal -->
    <div class="cs-panel" id="panel-proposal">
      <pre class="cs-pre">
<span class="cs-line cmt"># Looped DFlash Drafter — proposed combination</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p"><span class="kw">class</span> <span class="cls">LoopedDFlashDrafter</span>(<span class="cls">nn.Module</span>):</span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">__init__</span>(<span class="kw">self</span>, S_max=<span class="num">12</span>):</span>
<span class="cs-line hl-c">        <span class="kw">self</span>.head = <span class="fn">DraftHead</span>()  <span class="cmt"># embeds target features</span></span>
<span class="cs-line hl-p">        <span class="kw">self</span>.mid  = <span class="fn">BidirBlock</span>() <span class="cmt"># SHARED bidir block</span></span>
<span class="cs-line hl-g">        <span class="kw">self</span>.tail = <span class="fn">LMHead</span>()     <span class="cmt"># token distributions</span></span>
<span class="cs-line">        <span class="kw">self</span>.S_max = S_max</span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">forward</span>(<span class="kw">self</span>, x_masked, h_target, S=<span class="num">3</span>):</span>
<span class="cs-line cmt">        # Project target features into draft space</span>
<span class="cs-line">        H = <span class="kw">self</span>.head(x_masked, h_target)</span>
<span class="cs-line cmt">        # Loop shared bidir block S times</span>
<span class="cs-line">        <span class="kw">for</span> s <span class="kw">in</span> <span class="fn">range</span>(S):</span>
<span class="cs-line hl-p">            H = <span class="kw">self</span>.mid(H)  <span class="cmt"># same weights, all γ attend</span></span>
<span class="cs-line cmt">        # All γ token distributions in parallel</span>
<span class="cs-line">        <span class="kw">return</span> <span class="kw">self</span>.tail(H)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Training: stochastic S ~ U&#123;1,…,S_max&#125;</span>
<span class="cs-line cmt"># Inference: set S to match latency budget</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Why it works:</span>
<span class="cs-line cmt"># 1. Parallel: still one draft forward pass per loop</span>
<span class="cs-line cmt"># 2. Quality: loops let masked positions refine</span>
<span class="cs-line cmt"># 3. Target conditioning: reduces loops needed</span>
<span class="cs-line cmt">#    (drafter can lean on target's reasoning)</span>
<span class="cs-line cmt"># 4. No new params: shared block same size</span>
      </pre>

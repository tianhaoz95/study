      <pre class="cs-pre">
<span class="cs-line cmt"># Linear attention: fixed-size recurrent state</span>
<span class="cs-line cmt"># S ∈ R^&#123;d_k &times; d_v&#125; — constant size regardless</span>
<span class="cs-line cmt"># of sequence length</span>
<span class="cs-line"> </span>
<span class="cs-line kw">def</span> <span class="fn">linear_attn_recurrent</span>(q, k, v, S_prev):
<span class="cs-line hl-a">    <span class="cmt"># just accumulate — never remove</span></span>
<span class="cs-line hl-a">    S = S_prev + torch.outer(k, v)</span>
<span class="cs-line">    o = S.T @ q</span>
<span class="cs-line">    <span class="kw">return</span> o, S</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># The problem: after 1000 tokens, S still has</span>
<span class="cs-line cmt"># the same size. "Paris→city" at t=1 and</span>
<span class="cs-line cmt"># "Paris→fashion" at t=900 both live in S,</span>
<span class="cs-line cmt"># superposed. Query "Paris" gets both mixed.</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Chunkwise (parallel training):</span>
<span class="cs-line cmt"># S[n+1] = S[n] + K[n]^T V[n]</span>
<span class="cs-line cmt"># O[n]  = Q[n] S[n] + (Q[n] K[n]^T ⊙ M_C) V[n]</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Complexity:</span>
<span class="cs-line cmt">#   Space: O(d_k &times; d_v) — constant in L</span>
<span class="cs-line cmt">#   Time:  O(L &times; d_k &times; d_v) — linear in L</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-heritage">
      <pre class="cs-pre">
<span class="cs-line cmt"># DeltaNet: read-then-overwrite</span>
<span class="cs-line cmt"># β_t ∈ [0,1] step size (scalar)</span>
<span class="cs-line"> </span>
<span class="cs-line kw">def</span> <span class="fn">deltanet_step</span>(q, k, v, beta, S_prev):
<span class="cs-line hl-p">    <span class="cmt"># read current value at key k</span></span>
<span class="cs-line hl-p">    v_old = S_prev.T @ k  <span class="cmt"># shape: d_v</span></span>
<span class="cs-line hl-c">    <span class="cmt"># delta correction: target minus current</span></span>
<span class="cs-line hl-c">    delta = beta * (v - v_old)</span>
<span class="cs-line hl-g">    <span class="cmt"># targeted rank-1 update</span></span>
<span class="cs-line hl-g">    S = S_prev + torch.outer(k, delta)</span>
<span class="cs-line">    o = S.T @ q</span>
<span class="cs-line">    <span class="kw">return</span> o, S</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># KDA: adds channel-wise decay D_t = Diag(α_t)</span>
<span class="cs-line"> </span>
<span class="cs-line kw">def</span> <span class="fn">kda_step</span>(q, k, v, beta, alpha, S_prev):
<span class="cs-line">    S_bar = S_prev * alpha[:, <span class="kw">None</span>]  <span class="cmt"># decay</span></span>
<span class="cs-line hl-a">    <span class="cmt"># still: same scalar β for erase AND write</span></span>
<span class="cs-line hl-a">    v_old = S_bar.T @ k</span>
<span class="cs-line hl-a">    S = S_bar + torch.outer(k, beta*(v - v_old))</span>
<span class="cs-line">    o = S.T @ q</span>
<span class="cs-line">    <span class="kw">return</span> o, S</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-tie">
      <pre class="cs-pre">
<span class="cs-line cmt"># The scalar tie in KDA:</span>
<span class="cs-line cmt">#   S_t = (I − β_t k_t k_t^T) D_t S_&#123;t-1&#125;</span>
<span class="cs-line cmt">#                                + β_t k_t v_t^T</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># β_t controls TWO DIFFERENT THINGS:</span>
<span class="cs-line"> </span>
<span class="cs-line hl-a"><span class="cmt"># 1. Erase strength (key-side)</span></span>
<span class="cs-line hl-a"><span class="cmt">#    (I − β_t k_t k_t^T) erases old content</span></span>
<span class="cs-line hl-a"><span class="cmt">#    β_t=0.1 → barely touches old association</span></span>
<span class="cs-line hl-a"><span class="cmt">#    β_t=1.0 → fully overwrites it</span></span>
<span class="cs-line"> </span>
<span class="cs-line hl-c"><span class="cmt"># 2. Write strength (value-side)</span></span>
<span class="cs-line hl-c"><span class="cmt">#    β_t k_t v_t^T writes new value</span></span>
<span class="cs-line hl-c"><span class="cmt">#    β_t=0.1 → barely commits new value</span></span>
<span class="cs-line hl-c"><span class="cmt">#    β_t=1.0 → fully commits it</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Impossible with scalar β_t:</span>
<span class="cs-line cmt">#   "erase key channels 1,3,5 fully (b≈1)"</span>
<span class="cs-line cmt">#   "write only to value channels 2,4 (w≈0.3)"</span>
<span class="cs-line cmt"># → β_t must be the same for both</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Ablation result (Table 5):</span>
<span class="cs-line cmt">#   b-only channel: LM avg 52.79, NIAH 35.2%</span>
<span class="cs-line cmt">#   w-only channel: LM avg 52.45, NIAH 30.6%</span>
<span class="cs-line cmt">#   Full GDN-2:     LM avg 53.11, NIAH 37.8%</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-decouple">
      <pre class="cs-pre">
<span class="cs-line cmt"># Gated Delta Rule-2</span>
<span class="cs-line"> </span>
<span class="cs-line kw">def</span> <span class="fn">gdr2_step</span>(q, k, v, alpha, b, w, S_prev):
<span class="cs-line">    <span class="cmt"># channel-wise decay</span></span>
<span class="cs-line">    S_bar = S_prev * alpha[:, <span class="kw">None</span>]</span>
<span class="cs-line hl-p">    <span class="cmt"># erase: b_t gates which key channels</span></span>
<span class="cs-line hl-p">    <span class="cmt"># are used to read old content</span></span>
<span class="cs-line hl-p">    e_t = b * k          <span class="cmt"># ∈ R^&#123;d_k&#125;</span></span>
<span class="cs-line hl-p">    r_t = S_bar.T @ e_t  <span class="cmt"># old read</span></span>
<span class="cs-line hl-c">    <span class="cmt"># write: w_t gates which value channels</span></span>
<span class="cs-line hl-c">    <span class="cmt"># receive the new content</span></span>
<span class="cs-line hl-c">    z_t = w * v          <span class="cmt"># ∈ R^&#123;d_v&#125;</span></span>
<span class="cs-line hl-g">    <span class="cmt"># rank-1 update: erase old, write new</span></span>
<span class="cs-line hl-g">    S = S_bar + torch.outer(k, z_t - r_t)</span>
<span class="cs-line">    o = S.T @ q</span>
<span class="cs-line">    <span class="kw">return</span> o, S</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Gate projections (independent):</span>
<span class="cs-line kw">class</span> <span class="cls">GDN2Gates</span>(nn.Module):
<span class="cs-line">    <span class="kw">def</span> <span class="fn">__init__</span>(<span class="kw">self</span>, d_model, d_k, d_v):</span>
<span class="cs-line">        <span class="kw">self</span>.W_b = nn.Linear(d_model, d_k)</span>
<span class="cs-line">        <span class="kw">self</span>.W_w = nn.Linear(d_model, d_v)</span>
<span class="cs-line"> </span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">forward</span>(<span class="kw">self</span>, x):</span>
<span class="cs-line hl-p">        b = torch.sigmoid(<span class="kw">self</span>.W_b(x))</span>
<span class="cs-line hl-c">        w = torch.sigmoid(<span class="kw">self</span>.W_w(x))</span>
<span class="cs-line">        <span class="kw">return</span> b, w</span>
      </pre>
    </div>

    <div class="cs-panel" id="panel-arch">
      <pre class="cs-pre">
<span class="cs-line cmt"># Chunkwise WY algorithm (efficient training)</span>
<span class="cs-line cmt"># Absorbs channel-wise decay into erase factors</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># For chunk [n], cumulative decay: γ_r = exp(Σ g_i)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Decay-normalized key and erase vectors:</span>
<span class="cs-line hl-p">k_bar = gamma_r_inv * k_r   <span class="cmt"># k̄_r = γ_r^{-1} ⊙ k_r</span></span>
<span class="cs-line hl-p">e_bar = gamma_r * (b_r * k_r)<span class="cmt"># ē_r = γ_r ⊙ e_r</span></span>
<span class="cs-line hl-c">z     = w_r * v_r           <span class="cmt"># z_r = w_r ⊙ v_r</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Build triangular solve matrix:</span>
<span class="cs-line">T = tril(E_bar @ K_bar.T, -1)</span>
<span class="cs-line">A = inv(I + T)           <span class="cmt"># lower triangular</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># WY auxiliaries (shared inverse):</span>
<span class="cs-line hl-g">Y = A @ E_bar            <span class="cmt"># erase-side</span></span>
<span class="cs-line hl-g">U = A @ Z                <span class="cmt"># write-side</span></span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># End-of-chunk state and output:</span>
<span class="cs-line">S_next = diag(gamma_C) @ S0 + K_tail.T @ (U - Y@S0)</span>
<span class="cs-line">O = Q_gamma @ S0 + A_qk @ (U - Y@S0)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Same structure as KDA — only Y,U differ</span>
<span class="cs-line cmt"># via the gate factors B and W.</span>
<span class="cs-line cmt"># Throughput: ~36.1 Kt/s vs ~38.0 Kt/s (KDA)</span>
      </pre>
    </div>


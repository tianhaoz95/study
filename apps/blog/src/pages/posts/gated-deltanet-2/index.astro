  function resize() {
    W = canvas.clientWidth; H = canvas.clientHeight;
    DPR = window.devicePixelRatio || 1;
    canvas.width = W * DPR; canvas.height = H * DPR;
    ctx.scale(DPR, DPR);
    draw();
  }

  // State: 5 key slots for additive (left) and delta (right)
  // Each slot: { label, color, value_additive, value_delta }
  const SLOTS = 5;
  // State arrays (RGBA-ish intensity for each slot, 0..1)
  let addState = Array(SLOTS).fill(null); // null = empty
  let delState = Array(SLOTS).fill(null);
  // slot colors (hue)
  const slotHues = [210, 280, 160, 40, 350];
  let history = []; // log of events

  function addEntry(label, side, slot, val) {
    history.push({ label, side, slot, val });
    if (history.length > 5) history.shift();
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    const midX = W / 2;
    const padY = 14;
    const panelW = midX - 8;
    const panelH = H - 2*padY;

    // panel backgrounds
    ctx.fillStyle = 'rgba(0,0,0,0.18)';
    ctx.beginPath(); ctx.roundRect(4, padY, panelW, panelH, 6); ctx.fill();
    ctx.beginPath(); ctx.roundRect(midX+4, padY, panelW, panelH, 6); ctx.fill();

    // panel titles
    ctx.font = `600 10px var(--ff-mono, monospace)`;
    ctx.textAlign = 'center';
    ctx.fillStyle = 'rgba(100,116,139,.8)';
    ctx.fillText('Basic Linear Attention', midX/2, padY + 13);
    ctx.fillStyle = 'rgba(139,92,246,.8)';
    ctx.fillText('Delta Rule (DeltaNet)', midX + midX/2, padY + 13);

    const slotH = (panelH - 34) / SLOTS;
    const slotMargin = 4;

    for (let i = 0; i < SLOTS; i++) {
      const y = padY + 24 + i * slotH;
      const h = slotH - slotMargin;
      const hue = slotHues[i];

      // Additive left
      drawSlot(ctx, 8, y, panelW - 8, h, addState[i], hue, false);
      // Delta right
      drawSlot(ctx, midX + 8, y, panelW - 8, h, delState[i], hue, true);
    }

    // Separator line
    ctx.strokeStyle = 'rgba(100,116,139,.3)';
    ctx.lineWidth = 1;
    ctx.setLineDash([4, 3]);
    ctx.beginPath(); ctx.moveTo(midX, padY); ctx.lineTo(midX, H - padY); ctx.stroke();
    ctx.setLineDash([]);
  }

  function drawSlot(ctx, x, y, w, h, state, hue, isDelta) {
    const label = state ? state.label : '—';
    const intensity = state ? Math.min(1, state.intensity) : 0;
    const mixed = state ? state.mixed : false;

    // background bar
    ctx.fillStyle = `rgba(${hue > 200 && hue < 260 ? '40,80,160' : hue > 260 ? '80,40,140' : hue > 140 ? '20,120,80' : '120,80,20'}, 0.08)`;
    ctx.beginPath(); ctx.roundRect(x, y, w, h, 3); ctx.fill();

    if (state) {
      const fillColor = mixed
        ? `hsla(${hue}, 30%, 65%, ${intensity * 0.7})`
        : `hsla(${hue}, 70%, 65%, ${intensity * 0.85})`;
      ctx.fillStyle = fillColor;
      ctx.beginPath(); ctx.roundRect(x, y, w * intensity, h, 3); ctx.fill();

      if (mixed) {
        // draw two overlapping fills
        ctx.fillStyle = `hsla(${hue}, 70%, 65%, 0.4)`;
        ctx.beginPath(); ctx.roundRect(x, y, w * 0.4, h, 3); ctx.fill();
        ctx.fillStyle = `hsla(${hue + 40}, 70%, 65%, 0.4)`;
        ctx.beginPath(); ctx.roundRect(x, y + h*0.4, w * 0.85, h*0.6, [0,3,3,0]); ctx.fill();
      }

      // border
      ctx.strokeStyle = mixed
        ? `hsla(${hue}, 30%, 55%, 0.6)`
        : `hsla(${hue}, 70%, 65%, 0.7)`;
      ctx.lineWidth = 1;
      ctx.beginPath(); ctx.roundRect(x, y, w, h, 3); ctx.stroke();
    }

    // label
    ctx.font = `500 9px var(--ff-mono, monospace)`;
    ctx.textAlign = 'left';
    ctx.fillStyle = state ? 'rgba(220,220,220,.9)' : 'rgba(100,116,139,.5)';
    ctx.fillText(label, x + 7, y + h/2 + 3);

    if (mixed) {
      ctx.textAlign = 'right';
      ctx.fillStyle = 'rgba(239,68,68,.8)';
      ctx.font = `600 9px var(--ff-mono, monospace)`;
      ctx.fillText('✗ mixed', x + w - 5, y + h/2 + 3);
    } else if (state && isDelta) {
      ctx.textAlign = 'right';
      ctx.fillStyle = 'rgba(52,211,153,.8)';
      ctx.font = `600 9px var(--ff-mono, monospace)`;
      ctx.fillText('✓ clean', x + w - 5, y + h/2 + 3);
    }
  }

  // Button handlers
  document.getElementById('col-btn-paris1')?.addEventListener('click', () => {
    addState[0] = { label: '"Paris" → city (0.8)', intensity: 0.82, mixed: false };
    delState[0] = { label: '"Paris" → city (0.8)', intensity: 0.82, mixed: false };
    draw();
  });
  document.getElementById('col-btn-rome')?.addEventListener('click', () => {
    addState[1] = { label: '"Rome" → cuisine (0.5)', intensity: 0.55, mixed: false };
    delState[1] = { label: '"Rome" → cuisine (0.5)', intensity: 0.55, mixed: false };
    draw();
  });
  document.getElementById('col-btn-paris2')?.addEventListener('click', () => {
    // Additive: slot 0 becomes mixed (both associations coexist)
    if (addState[0]) {
      addState[0] = { label: '"Paris" → city + fashion', intensity: 0.95, mixed: true };
    } else {
      addState[0] = { label: '"Paris" → fashion (0.7)', intensity: 0.72, mixed: false };
    }
    // Delta: slot 0 cleanly replaced
    delState[0] = { label: '"Paris" → fashion (0.7)', intensity: 0.72, mixed: false };
    draw();
  });
  document.getElementById('col-btn-query')?.addEventListener('click', () => {
    if (!addState[0]) return;
    // Flash: show query result annotation
    addState[0].queried = true;
    delState[0].queried = true;
    draw();
  });
  document.getElementById('col-btn-reset')?.addEventListener('click', () => {
    addState = Array(SLOTS).fill(null);
    delState = Array(SLOTS).fill(null);
    draw();
  });

  resize();
  window.addEventListener('resize', resize);
})();

// ── §02: Model evolution step navigator ──
(function() {
  let step = 0;
  const boxes = document.querySelectorAll('#evo-steps .step-box');
  const prevBtn = document.getElementById('evo-prev');
  const nextBtn = document.getElementById('evo-next');
  const progEl  = document.getElementById('evo-prog');

  function updateSteps() {
    boxes.forEach((b, i) => {
      b.classList.remove('active', 'done');
      if (i === step) b.classList.add('active');
      else if (i < step) b.classList.add('done');
    });
    if (prevBtn) prevBtn.disabled = step === 0;
    if (nextBtn) nextBtn.disabled = step === boxes.length - 1;
    if (progEl) progEl.textContent = `Step ${step+1} of ${boxes.length}`;
    boxes.forEach((b, i) => {
      const n = b.querySelector('.step-num');
      if (n) n.textContent = i < step ? '✓' : String(i+1);
    });
  }

  prevBtn?.addEventListener('click', () => { if (step > 0) { step--; updateSteps(); } });
  nextBtn?.addEventListener('click', () => { if (step < boxes.length-1) { step++; updateSteps(); } });
  updateSteps();
})();

// ── §03: Scalar tie gate demo ──
(function() {
  let beta = 0.5;
  const N = 6;

  function makeBars(containerId, cls) {
    const container = document.getElementById(containerId);
    if (!container) return;
    container.innerHTML = '';
    for (let i = 0; i < N; i++) {
      const col = document.createElement('div');
      col.className = 'gate-bar-col';
      col.style.flex = '1';
      const track = document.createElement('div');
      track.className = 'gate-bar-track';
      const fill = document.createElement('div');
      fill.className = `gate-bar-fill ${cls}`;
      fill.id = `${containerId}-bar-${i}`;
      fill.style.height = `${beta * 100}%`;
      track.appendChild(fill);
      col.appendChild(track);
      container.appendChild(col);
    }
  }

  function setBeta(val) {
    beta = val;
    for (let i = 0; i < N; i++) {
      const eb = document.getElementById(`tie-erase-bars-bar-${i}`);
      const wb = document.getElementById(`tie-write-bars-bar-${i}`);
      if (eb) eb.style.height = `${beta * 100}%`;
      if (wb) wb.style.height = `${beta * 100}%`;
    }
    ['tie-btn-01','tie-btn-05','tie-btn-09'].forEach(id => {
      const btn = document.getElementById(id);
      if (btn) btn.classList.toggle('active', btn.textContent.trim() === String(beta.toFixed(1)));
    });
  }

  makeBars('tie-erase-bars', 'erase');
  makeBars('tie-write-bars', 'write');

  document.getElementById('tie-btn-01')?.addEventListener('click', () => setBeta(0.1));
  document.getElementById('tie-btn-05')?.addEventListener('click', () => setBeta(0.5));
  document.getElementById('tie-btn-09')?.addEventListener('click', () => setBeta(0.9));
})();

// ── §04: Decoupled gates demo ──
(function() {
  const N = 6;
  const presets = {
    asym:        { b: [0.9, 0.2, 0.85, 0.15, 0.8, 0.25], w: [0.2, 0.85, 0.15, 0.9, 0.25, 0.8],  caption: 'Asymmetric: b_t erases key channels 1,3,5 strongly; w_t writes to value channels 2,4,6. Impossible with a single scalar β_t.' },
    'erase-broad': { b: [0.95, 0.9, 0.88, 0.92, 0.9, 0.95], w: [0.1, 0.15, 0.08, 0.2, 0.12, 0.1], caption: 'Erase broad / Write narrow: aggressively clear old content from all key channels, but commit only a small fraction to value channels.' },
    'no-erase':  { b: [0.05, 0.08, 0.06, 0.07, 0.05, 0.08], w: [0.95, 0.9, 0.92, 0.88, 0.95, 0.9], caption: 'Skip erase / Full write: preserve all old associations in the state while fully committing new value content — useful when the current key is truly novel.' },
    tied:        { b: [0.7, 0.7, 0.7, 0.7, 0.7, 0.7], w: [0.7, 0.7, 0.7, 0.7, 0.7, 0.7], caption: 'Tied gates (= KDA): when b_t = w_t = β_t · 1, Gated DeltaNet-2 exactly recovers KDA. The scalar β = 0.7 here.' },
  };

  let current = 'asym';

  function makeBars(containerId, cls) {
    const container = document.getElementById(containerId);
    if (!container) return;
    container.innerHTML = '';
    for (let i = 0; i < N; i++) {
      const col = document.createElement('div');
      col.className = 'gate-bar-col';
      col.style.flex = '1';
      const track = document.createElement('div');
      track.className = 'gate-bar-track';
      const fill = document.createElement('div');
      fill.className = `gate-bar-fill ${cls}`;
      fill.id = `${containerId}-bar-${i}`;
      fill.style.height = '50%';
      track.appendChild(fill);
      col.appendChild(track);
      container.appendChild(col);
    }
  }

  function applyPreset(name) {
    current = name;
    const p = presets[name];
    if (!p) return;
    for (let i = 0; i < N; i++) {
      const eb = document.getElementById(`dec-erase-bars-bar-${i}`);
      const wb = document.getElementById(`dec-write-bars-bar-${i}`);
      if (eb) eb.style.height = `${p.b[i] * 100}%`;
      if (wb) wb.style.height = `${p.w[i] * 100}%`;
    }
    const cap = document.getElementById('dec-caption');
    if (cap) cap.textContent = p.caption;
    ['dec-btn-asym','dec-btn-erase-broad','dec-btn-no-erase','dec-btn-tied'].forEach(id => {
      const btn = document.getElementById(id);
      if (!btn) return;
      const bname = id.replace('dec-btn-', '');
      btn.classList.toggle('active', bname === name);
    });
  }

  makeBars('dec-erase-bars', 'erase');
  makeBars('dec-write-bars', 'write');
  applyPreset('asym');

  document.getElementById('dec-btn-asym')?.addEventListener('click', () => applyPreset('asym'));
  document.getElementById('dec-btn-erase-broad')?.addEventListener('click', () => applyPreset('erase-broad'));
  document.getElementById('dec-btn-no-erase')?.addEventListener('click', () => applyPreset('no-erase'));
  document.getElementById('dec-btn-tied')?.addEventListener('click', () => applyPreset('tied'));
})();

// ── §06: Animated bar chart trigger ──
(function() {
  const barsEl = document.getElementById('s-results-bars');
  if (!barsEl) return;
  const maxVals = { lm: 53.11, niah: 37.8 };
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          const raw = parseFloat(b.dataset.w);
          // normalize within group: find max in parent bars
          b.style.width = (raw / 60) * 100 + '%';
        });
      }
    });
  }, { threshold: 0.3 }).observe(barsEl);
})();

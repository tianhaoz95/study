// ── VIZ 1: Loss Curve Slider ────────────────────────────────
const lossCanvas = document.getElementById('loss-canvas');
if (lossCanvas) {
  const ctx = lossCanvas.getContext('2d');
  const dpr = window.devicePixelRatio || 1;
  const slider = document.getElementById('loss-size-slider');
  const gapVal = document.getElementById('loss-gap-val');

  function draw() {
    const W = lossCanvas.clientWidth;
    const H = 220;
    lossCanvas.width = W * dpr;
    lossCanvas.height = H * dpr;
    ctx.scale(dpr, dpr);

    ctx.clearRect(0, 0, W, H);
    
    // Draw grid lines
    ctx.strokeStyle = 'rgba(255,255,255,0.05)';
    ctx.lineWidth = 1;
    for (let x = 50; x < W; x += 50) {
      ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, H - 30); ctx.stroke();
    }
    for (let y = 30; y < H; y += 40) {
      ctx.beginPath(); ctx.moveTo(40, y); ctx.lineTo(W, y); ctx.stroke();
    }

    // Parameters
    const val = parseFloat(slider.value); // size from 10 to 60
    const alpha = 0.46;
    const gamma = 0.34;

    // Loss computations
    const L0 = 20; // baseline offset
    const scale = 500;
    
    // Asymptotic line: L_inf(Ns) = L0 + A / Ns^alpha
    const Ns = val;
    const Nl = 80;
    const L_inf_s = L0 + scale / Math.pow(Ns, alpha);
    const L_c_s = L0 + (scale * 1.25) / Math.pow(Ns, gamma);
    const L_c_l = L0 + (scale * 1.25) / Math.pow(Nl, gamma);

    // Render curves
    // Compute optimal curve: points from x=10 to Nl
    ctx.beginPath();
    ctx.strokeStyle = 'rgba(100, 110, 130, 0.4)';
    ctx.lineWidth = 2;
    for (let x = 10; x <= W - 40; x++) {
      const size = 5 + (x / (W - 40)) * 90;
      const y = H - 30 - (scale * 1.25 / Math.pow(size, gamma)) * 0.9;
      if (x === 10) ctx.moveTo(x + 40, y);
      else ctx.lineTo(x + 40, y);
    }
    ctx.stroke();

    // Asymptotic curve: L_inf(N)
    ctx.beginPath();
    ctx.strokeStyle = 'var(--purple)';
    ctx.lineWidth = 3;
    for (let x = 10; x <= W - 40; x++) {
      const size = 5 + (x / (W - 40)) * 90;
      const y = H - 30 - (scale / Math.pow(size, alpha)) * 0.9;
      if (x === 10) ctx.moveTo(x + 40, y);
      else ctx.lineTo(x + 40, y);
    }
    ctx.stroke();

    // Draw vertical markers for Ns and Nl
    const x_ns = 40 + ((Ns - 5) / 90) * (W - 40);
    const x_nl = 40 + ((Nl - 5) / 90) * (W - 40);

    const y_inf_s = H - 30 - (scale / Math.pow(Ns, alpha)) * 0.9;
    const y_c_l = H - 30 - (scale * 1.25 / Math.pow(Nl, gamma)) * 0.9;

    // Asymptotic Gap region (red shade)
    ctx.fillStyle = 'rgba(239, 68, 68, 0.15)';
    ctx.beginPath();
    ctx.moveTo(x_ns, y_inf_s);
    ctx.lineTo(x_ns, y_c_l);
    ctx.lineTo(x_nl, y_c_l);
    ctx.lineTo(x_ns, y_inf_s); // triangle / quad approximation
    ctx.fill();

    // Line for Ns
    ctx.strokeStyle = 'rgba(255, 255, 255, 0.3)';
    ctx.setLineDash([4, 4]);
    ctx.beginPath(); ctx.moveTo(x_ns, H - 30); ctx.lineTo(x_ns, y_inf_s); ctx.stroke();
    ctx.setLineDash([]);

    // Line for Nl
    ctx.strokeStyle = 'rgba(255, 255, 255, 0.15)';
    ctx.setLineDash([4, 4]);
    ctx.beginPath(); ctx.moveTo(x_nl, H - 30); ctx.lineTo(x_nl, y_c_l); ctx.stroke();
    ctx.setLineDash([]);

    // Dots
    ctx.fillStyle = 'var(--cyan)';
    ctx.beginPath(); ctx.arc(x_ns, y_inf_s, 5, 0, Math.PI * 2); ctx.fill();

    ctx.fillStyle = 'rgba(255,255,255,0.7)';
    ctx.beginPath(); ctx.arc(x_nl, y_c_l, 4, 0, Math.PI * 2); ctx.fill();

    // Labels
    ctx.font = '10px monospace';
    ctx.fillStyle = 'var(--text)';
    ctx.fillText('Ns (Small)', x_ns - 25, H - 15);
    ctx.fillText('Nl (Large)', x_nl - 25, H - 15);

    ctx.fillStyle = 'var(--cyan)';
    ctx.fillText(`L_inf(Ns)`, x_ns + 8, y_inf_s - 2);

    ctx.fillStyle = 'rgba(255,255,255,0.6)';
    ctx.fillText(`L_c(Nl)`, x_nl - 45, y_c_l - 6);

    // Compute gap
    const gap = Math.max(0, (y_c_l - y_inf_s) / 50).toFixed(2);
    gapVal.textContent = gap;

    // Draw axes
    ctx.strokeStyle = 'var(--border)';
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(40, 10);
    ctx.lineTo(40, H - 30);
    ctx.lineTo(W - 10, H - 30);
    ctx.stroke();

    ctx.font = '9px monospace';
    ctx.fillStyle = 'var(--muted)';
    ctx.fillText('Loss', 8, 20);
    ctx.fillText('Size (N)', W - 50, H - 38);
  }

  slider.addEventListener('input', draw);
  window.addEventListener('resize', draw);
  draw();
}

// ── VIZ 2: Neuron Grid Allocation ──────────────────────────
const neuronGrid = document.getElementById('neuron-grid');
const btnSmall = document.getElementById('btn-neuron-small');
const btnLarge = document.getElementById('btn-neuron-large');

function populateNeuronGrid(size) {
  if (!neuronGrid) return;
  neuronGrid.innerHTML = '';
  const count = size === 'small' ? 16 : 64;
  const cols = size === 'small' ? 4 : 8;
  neuronGrid.style.gridTemplateColumns = `repeat(${cols}, 1fr)`;

  for (let i = 0; i < count; i++) {
    const el = document.createElement('div');
    el.className = 'neuron-cell';
    
    if (size === 'small') {
      // 100% occupied by common features due to lack of space
      el.classList.add('common');
      el.textContent = `C${(i % 4) + 1}`;
      el.title = 'Common Task Feature';
    } else {
      // Large model: common tasks take their needed share, leaving space for rare
      if (i < 30) {
        el.classList.add('common');
        el.textContent = `C${(i % 5) + 1}`;
        el.title = 'Common Task Feature';
      } else if (i < 45) {
        el.classList.add('rare');
        el.textContent = `R${((i - 30) % 3) + 1}`;
        el.title = 'Rare Task Feature';
      } else {
        el.classList.add('empty');
        el.title = 'Free Unallocated Space';
      }
    }
    neuronGrid.appendChild(el);
  }
}

btnSmall?.addEventListener('click', () => {
  btnSmall.classList.add('active');
  btnLarge?.classList.remove('active');
  populateNeuronGrid('small');
});
btnLarge?.addEventListener('click', () => {
  btnLarge.classList.add('active');
  btnSmall?.classList.remove('active');
  populateNeuronGrid('large');
});
populateNeuronGrid('large'); // default to large to show distinction

// ── VIZ 3: Matched Frequency Retention Simulation ──────────
const retCanvas = document.getElementById('retention-canvas');
if (retCanvas) {
  const ctx = retCanvas.getContext('2d');
  const dpr = window.devicePixelRatio || 1;
  const playBtn = document.getElementById('btn-ret-play');
  const resetBtn = document.getElementById('btn-ret-reset');
  const widthSel = document.getElementById('sel-ret-width');
  const gapSel = document.getElementById('sel-ret-gap');

  let step = 0;
  let isPlaying = false;
  let animationId = null;
  const maxSteps = 400;
  let points = [];

  function initSimulation() {
    step = 0;
    points = [];
    if (animationId) cancelAnimationFrame(animationId);
    isPlaying = false;
    playBtn.textContent = 'Play';
    drawSimulation();
  }

  function simulateStep() {
    if (step >= maxSteps) {
      isPlaying = false;
      playBtn.textContent = 'Play';
      return;
    }

    const width = widthSel.value; // 'narrow' or 'wide'
    const gapType = gapSel.value; // 'short' or 'long'
    const G = gapType === 'short' ? 32 : 128;
    const decayRate = width === 'narrow' ? 0.05 : 0.01;

    let prevSignal = step === 0 ? 0 : points[points.length - 1].y;

    // Check if injection step
    let signal = prevSignal;
    if (step % G === 0 && step > 0) {
      // Accumulate rare feature signal
      signal += width === 'narrow' ? 0.4 : 0.25; // Narrow spikes higher temporarily due to lack of stable basis
      if (signal > 1.0) signal = 1.0;
    } else {
      // Natural decay from LM interference
      signal *= (1 - decayRate);
    }

    points.push({ x: step, y: signal });
    step++;
  }

  function drawSimulation() {
    const W = retCanvas.clientWidth;
    const H = 220;
    retCanvas.width = W * dpr;
    retCanvas.height = H * dpr;
    ctx.scale(dpr, dpr);

    ctx.clearRect(0, 0, W, H);

    // Draw grid
    ctx.strokeStyle = 'rgba(255,255,255,0.05)';
    ctx.lineWidth = 1;
    const gapType = gapSel.value;
    const G = gapType === 'short' ? 32 : 128;
    const stepX = (W - 50) / maxSteps;

    // Vertical dashed injection markers
    ctx.strokeStyle = 'rgba(16, 185, 129, 0.15)';
    ctx.setLineDash([4, 2]);
    for (let s = G; s < maxSteps; s += G) {
      const x = 40 + s * stepX;
      ctx.beginPath(); ctx.moveTo(x, 10); ctx.lineTo(x, H - 30); ctx.stroke();
    }
    ctx.setLineDash([]);

    // Draw main axes
    ctx.strokeStyle = 'var(--border)';
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(40, 10);
    ctx.lineTo(40, H - 30);
    ctx.lineTo(W - 10, H - 30);
    ctx.stroke();

    // Plot signal line
    if (points.length > 0) {
      ctx.beginPath();
      ctx.strokeStyle = 'var(--green)';
      ctx.lineWidth = 2.5;
      points.forEach((p, idx) => {
        const x = 40 + p.x * stepX;
        const y = H - 30 - p.y * (H - 50);
        if (idx === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      });
      ctx.stroke();

      // Current pointer
      const last = points[points.length - 1];
      const cx = 40 + last.x * stepX;
      const cy = H - 30 - last.y * (H - 50);
      ctx.fillStyle = 'var(--green)';
      ctx.beginPath(); ctx.arc(cx, cy, 4, 0, Math.PI*2); ctx.fill();
    }

    // Label markings
    ctx.font = '9px monospace';
    ctx.fillStyle = 'var(--muted)';
    ctx.fillText('Rare Signal', 6, 20);
    ctx.fillText('Steps', W - 45, H - 15);
    ctx.fillText('0.0', 20, H - 27);
    ctx.fillText('1.0', 20, 20);
  }

  function loop() {
    if (!isPlaying) return;
    simulateStep();
    drawSimulation();
    if (step < maxSteps) {
      animationId = requestAnimationFrame(loop);
    }
  }

  playBtn?.addEventListener('click', () => {
    if (isPlaying) {
      isPlaying = false;
      playBtn.textContent = 'Play';
    } else {
      if (step >= maxSteps) initSimulation();
      isPlaying = true;
      playBtn.textContent = 'Pause';
      loop();
    }
  });

  resetBtn?.addEventListener('click', initSimulation);
  widthSel?.addEventListener('change', initSimulation);
  gapSel?.addEventListener('change', initSimulation);

  initSimulation();
}

// ── VIZ 4: Gradient Vector Field Sandbox ──────────────────
const gradCanvas = document.getElementById('gradient-canvas');
if (gradCanvas) {
  const ctx = gradCanvas.getContext('2d');
  const dpr = window.devicePixelRatio || 1;
  const slider = document.getElementById('grad-res-slider');
  const normVal = document.getElementById('grad-norm-val');

  function drawVectors() {
    const W = gradCanvas.clientWidth;
    const H = 220;
    gradCanvas.width = W * dpr;
    gradCanvas.height = H * dpr;
    ctx.scale(dpr, dpr);

    ctx.clearRect(0, 0, W, H);

    const cx = W / 2;
    const cy = H / 2 + 10;

    // Draw background target marker (representing optimal task parameter update)
    ctx.strokeStyle = 'rgba(255,255,255,0.03)';
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.arc(cx, cy, 80, 0, Math.PI * 2); ctx.stroke();
    ctx.beginPath(); ctx.arc(cx, cy, 40, 0, Math.PI * 2); ctx.stroke();

    const res = parseFloat(slider.value) / 100;
    
    // Theorem 4: Frequent gradient norm shrinks with residual
    const gF_len = res * 90;
    const gR_len = 50;

    // Angle of frequent task gradient (pointing downwards/interfering)
    const angle_F = Math.PI * 0.75;
    // Angle of rare task gradient (pointing upwards/aligned with optimal)
    const angle_R = -Math.PI * 0.4;

    const fx = cx + Math.cos(angle_F) * gF_len;
    const fy = cy + Math.sin(angle_F) * gF_len;

    const rx = cx + Math.cos(angle_R) * gR_len;
    const ry = cy + Math.sin(angle_R) * gR_len;

    // Net parameter update
    const nx = cx + Math.cos(angle_F) * gF_len + Math.cos(angle_R) * gR_len;
    const ny = cy + Math.sin(angle_F) * gF_len + Math.sin(angle_R) * gR_len;

    // Helper for arrows
    function drawArrow(x1, y1, x2, y2, color, width, label) {
      ctx.strokeStyle = color;
      ctx.lineWidth = width;
      ctx.beginPath();
      ctx.moveTo(x1, y1);
      ctx.lineTo(x2, y2);
      ctx.stroke();

      // arrow head
      const angle = Math.atan2(y2 - y1, x2 - x1);
      ctx.fillStyle = color;
      ctx.beginPath();
      ctx.moveTo(x2, y2);
      ctx.lineTo(x2 - 8 * Math.cos(angle - Math.PI / 6), y2 - 8 * Math.sin(angle - Math.PI / 6));
      ctx.lineTo(x2 - 8 * Math.cos(angle + Math.PI / 6), y2 - 8 * Math.sin(angle + Math.PI / 6));
      ctx.fill();

      if (label) {
        ctx.font = '10px monospace';
        ctx.fillStyle = color;
        ctx.fillText(label, x2 + 6 * Math.cos(angle), y2 + 6 * Math.sin(angle));
      }
    }

    // Draw axes center label
    ctx.fillStyle = 'rgba(255,255,255,0.1)';
    ctx.beginPath(); ctx.arc(cx, cy, 3, 0, Math.PI*2); ctx.fill();

    // Draw individual components
    if (gF_len > 1) {
      drawArrow(cx, cy, fx, fy, 'var(--purple)', 2, 'G_Frequent');
    }
    drawArrow(cx, cy, rx, ry, 'var(--green)', 2, 'G_Rare');

    // Draw resultant sum
    drawArrow(cx, cy, nx, ny, '#fff', 3.5, 'Net Step');

    normVal.textContent = res.toFixed(2);
  }

  slider.addEventListener('input', drawVectors);
  window.addEventListener('resize', drawVectors);
  drawVectors();
}

// ── VIZ 5: OLMo Pretraining sweeps ────────────────────────
const hmBody = document.getElementById('hm-body');
const cellInfo = document.getElementById('cell-info-pane');

const hmData = {
  TCMP: [
    { freq: '7.8 × 10⁻³', vals: [0.85, 0.98, 0.99, 0.99, 0.99], desc: 'Frequent injection: All models successfully capture the order relation.' },
    { freq: '2.4 × 10⁻⁵', vals: [0.50, 0.65, 0.91, 0.96, 0.98], desc: 'Moderate frequency: 4M model is unable to learn (random 50%), while larger models align successfully.' },
    { freq: '2.4 × 10⁻⁶', vals: [0.50, 0.50, 0.61, 0.88, 0.95], desc: 'Rare frequency: Only models size 300M and larger show features, 20M is random chance.' },
    { freq: '2.4 × 10⁻⁸', vals: [0.50, 0.50, 0.50, 0.72, 0.92], desc: 'Ultra-rare frequency: The 4M, 20M, and 300M fail. Only 1B (72%) and 4B (92%) succeed in learning order.' },
  ],
  TADD: [
    { freq: '7.8 × 10⁻³', vals: [0.32, 0.78, 0.94, 0.99, 0.99], desc: 'Complex modular addition: 4M struggles, larger models grok Fourier modes.' },
    { freq: '2.4 × 10⁻⁵', vals: [0.10, 0.10, 0.52, 0.89, 0.96], desc: 'Moderate frequency: Smaller models remain at 10% (random guess), 1B/4B learn structural math.' },
    { freq: '2.4 × 10⁻⁶', vals: [0.10, 0.10, 0.10, 0.45, 0.88], desc: 'Only the 4B parameters model represents sufficient features to resolve additions.' },
    { freq: '2.4 × 10⁻⁸', vals: [0.10, 0.10, 0.10, 0.10, 0.76], desc: 'Extreme tail task: Starved completely in all models below 4B. The 4B model achieves 76% accuracy.' },
  ]
};

function renderHeatmap(task) {
  if (!hmBody) return;
  hmBody.innerHTML = '';
  const rows = hmData[task];
  const sizes = ['4M', '20M', '300M', '1B', '4B'];

  rows.forEach((r, rowIdx) => {
    const tr = document.createElement('tr');
    
    const th = document.createElement('th');
    th.textContent = r.freq;
    tr.appendChild(th);

    r.vals.forEach((v, colIdx) => {
      const td = document.createElement('td');
      td.className = 'cell-val';
      
      // Compute color scaling (yellowish to dark orange)
      const alphaVal = v;
      td.style.backgroundColor = `rgba(245, 158, 11, ${alphaVal * 0.85})`;
      td.style.color = v > 0.6 ? '#fff' : 'var(--muted)';
      td.textContent = (v * 100).toFixed(0) + '%';
      
      td.addEventListener('mouseenter', () => {
        td.classList.add('cell-active');
        cellInfo.innerHTML = `Model Size: <span>${sizes[colIdx]}</span> | Task Frequency: <span>${r.freq}</span> | Test Acc: <span>${(v * 100).toFixed(0)}%</span><br>${r.desc}`;
      });

      td.addEventListener('mouseleave', () => {
        td.classList.remove('cell-active');
      });

      tr.appendChild(td);
    });

    hmBody.appendChild(tr);
  });
}

document.getElementById('btn-hm-tcmp')?.addEventListener('click', (e) => {
  document.getElementById('btn-hm-tcmp').classList.add('active');
  document.getElementById('btn-hm-tadd').classList.remove('active');
  renderHeatmap('TCMP');
});
document.getElementById('btn-hm-tadd')?.addEventListener('click', (e) => {
  document.getElementById('btn-hm-tadd').classList.add('active');
  document.getElementById('btn-hm-tcmp').classList.remove('active');
  renderHeatmap('TADD');
});

renderHeatmap('TCMP');

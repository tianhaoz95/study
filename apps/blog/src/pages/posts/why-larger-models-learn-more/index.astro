const tabMeta = {
  intro:     { file: 'scaling.py',    title: 'Data vs Model Scaling' },
  capacity:  { file: 'capacity.py',   title: 'Resource Competition' },
  retention: { file: 'retention.py',  title: 'Update-and-Forget Loop' },

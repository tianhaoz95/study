<script>
var tocSidebar = document.getElementById('toc-sidebar');
var tocToggle  = document.getElementById('toc-toggle');
var postGrid   = document.getElementById('post-grid');
if (tocToggle) tocToggle.addEventListener('click', function() {
  var c = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', c);
  tocToggle.textContent = c ? '›' : '‹';
});
var codeSidebar = document.getElementById('code-sidebar');
var csToggle    = document.getElementById('cs-toggle');
if (csToggle) csToggle.addEventListener('click', function() {
  var c = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', c);
  csToggle.textContent = c ? '‹' : '›';
});

var tabMeta = {
  problem:   { file: 'dynamo/problem.py',   title: 'The Problem' },
  phases:    { file: 'dynamo/phases.py',    title: 'Two Phases' },
  landscape: { file: 'dynamo/landscape.py', title: 'Energy Landscape' },
  arch:      { file: 'dynamo/arch.py',      title: 'Architecture' },
  reshard:   { file: 'dynamo/reshard.py',   title: 'Smart Resharding' },
  results:   { file: 'dynamo/results.py',   title: 'Results' },
};
function activateTab(name) {
  document.querySelectorAll('.cs-tab').forEach(function(t) {
    t.classList.toggle('active', t.dataset.panel === name);
  });
  document.querySelectorAll('.cs-panel').forEach(function(p) {
    p.classList.toggle('active', p.id === 'panel-' + name);
  });
  var m = tabMeta[name];
  if (m) {
    var fl = document.getElementById('cs-file-label');
    var st = document.getElementById('cs-section-title');
    if (fl) fl.textContent = m.file;
    if (st) st.textContent = m.title;
  }
}
document.querySelectorAll('.cs-tab').forEach(function(t) {
  t.addEventListener('click', function() { activateTab(t.dataset.panel); });
});

var sectionMap = {
  's-problem': 'problem', 's-phases': 'phases',
  's-landscape': 'landscape', 's-arch': 'arch',
  's-reshard': 'reshard', 's-results': 'results',
};
document.querySelectorAll('.post-body section[id]').forEach(function(s) {
  new IntersectionObserver(function(entries) {
    entries.forEach(function(e) {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(function(li) {
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id);
        });
        var p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.3 }).observe(s);
});

// Problem canvas
(function() {
  var canvas = document.getElementById('prob-canvas');
  if (!canvas) return;
  var DPR = window.devicePixelRatio || 1;
  function resize() { canvas.width = canvas.clientWidth * DPR; canvas.height = canvas.clientHeight * DPR; }
  resize();
  var ctx = canvas.getContext('2d');
  var mode = 'before';

  function rr(x, y, w, h, r) {
    ctx.beginPath();
    ctx.moveTo(x+r,y); ctx.lineTo(x+w-r,y);
    ctx.quadraticCurveTo(x+w,y,x+w,y+r);
    ctx.lineTo(x+w,y+h-r);
    ctx.quadraticCurveTo(x+w,y+h,x+w-r,y+h);
    ctx.lineTo(x+r,y+h);
    ctx.quadraticCurveTo(x,y+h,x,y+h-r);
    ctx.lineTo(x,y+r);
    ctx.quadraticCurveTo(x,y,x+r,y);
    ctx.closePath();
  }

  var pb = document.getElementById('prob-btn-before');
  var pa = document.getElementById('prob-btn-after');
  if (pb) pb.addEventListener('click', function() { mode='before'; pb.classList.add('active'); if(pa)pa.classList.remove('active'); draw(); });
  if (pa) pa.addEventListener('click', function() { mode='after'; pa.classList.add('active'); if(pb)pb.classList.remove('active'); draw(); });

  function draw() {
    var W = canvas.clientWidth, H = canvas.clientHeight;
    ctx.clearRect(0,0,W*DPR,H*DPR);
    ctx.save(); ctx.scale(DPR,DPR);
    var reqs = [
      {label:'"Hello!"',     type:'SS', col:'#10b981'},
      {label:'"Explain AI"', type:'MS', col:'#10b981'},
      {label:'"Write story"',type:'SL', col:'#f59e0b'},
      {label:'"Code review"',type:'LL', col:'#ef4444'},
      {label:'"2+2=?"',      type:'SS', col:'#10b981'},
    ];
    if (mode === 'before') {
      ctx.fillStyle='rgba(255,255,255,.3)'; ctx.font='600 10px monospace'; ctx.textAlign='left';
      ctx.fillText('INCOMING REQUESTS', 14, 18);
      reqs.forEach(function(r,i) {
        var y=28+i*40;
        ctx.fillStyle='rgba(255,255,255,.05)'; ctx.strokeStyle=r.col+'55'; ctx.lineWidth=1;
        rr(14,y,105,28,4); ctx.fill(); ctx.stroke();
        ctx.fillStyle=r.col; ctx.font='500 10px monospace'; ctx.fillText(r.label,22,y+17);
        ctx.fillStyle='rgba(255,255,255,.25)'; ctx.font='9px monospace'; ctx.fillText(r.type,100,y+17);
      });
      var mid = W/2+10;
      ctx.fillStyle='rgba(239,68,68,.12)'; ctx.strokeStyle='rgba(239,68,68,.5)'; ctx.lineWidth=1.5;
      rr(mid-5,12,W-mid-8,H-24,8); ctx.fill(); ctx.stroke();
      ctx.fillStyle='#ef4444'; ctx.font='600 9px monospace'; ctx.textAlign='center';
      ctx.fillText('SINGLE POOL', mid+(W-mid)/2-5, 30);
      ctx.fillStyle='rgba(255,255,255,.45)'; ctx.font='8px monospace';
      ctx.fillText('TP8  ·  1980 MHz', mid+(W-mid)/2-5, 43);
      for (var g=0;g<8;g++) {
        var gx=mid+6+(g%4)*42, gy=52+Math.floor(g/4)*50;
        ctx.fillStyle='rgba(239,68,68,.22)'; ctx.strokeStyle='rgba(239,68,68,.5)'; ctx.lineWidth=1;
        rr(gx,gy,34,38,4); ctx.fill(); ctx.stroke();
        ctx.fillStyle='#ef4444'; ctx.font='700 8px monospace'; ctx.textAlign='center';
        ctx.fillText('H100',gx+17,gy+16); ctx.fillText('MAX',gx+17,gy+28);
      }
      ctx.fillStyle='rgba(239,68,68,.8)'; ctx.font='700 9px monospace'; ctx.textAlign='center';
      ctx.fillText('3.5x wasted energy for short requests',mid+(W-mid)/2-5,H-6);
    } else {
      ctx.fillStyle='rgba(255,255,255,.3)'; ctx.font='600 10px monospace'; ctx.textAlign='left';
      ctx.fillText('INCOMING REQUESTS',8,16);
      reqs.forEach(function(r,i) {
        var y=24+i*40;
        ctx.fillStyle='rgba(255,255,255,.04)'; ctx.strokeStyle=r.col+'44'; ctx.lineWidth=1;
        rr(8,y,90,28,4); ctx.fill(); ctx.stroke();
        ctx.fillStyle=r.col; ctx.font='500 9px monospace'; ctx.fillText(r.label,14,y+17);
      });
      var pools=[
        {label:'SS/SM/SL pool',cfg:'TP2 · 1.2 GHz',col:'#10b981',y:14,h:60},
        {label:'MS/MM/ML pool',cfg:'TP4 · 1.2 GHz',col:'#8b5cf6',y:88,h:60},
        {label:'LS/LM/LL pool',cfg:'TP8 · 1.6 GHz',col:'#f59e0b',y:162,h:60},
      ];
      var pidx=[0,0,1,2,0];
      var px=W/2+14;
      pools.forEach(function(pool) {
        ctx.fillStyle=pool.col+'18'; ctx.strokeStyle=pool.col+'55'; ctx.lineWidth=1.5;
        rr(px,pool.y,W-px-8,pool.h,7); ctx.fill(); ctx.stroke();
        ctx.fillStyle=pool.col; ctx.font='600 8px monospace'; ctx.textAlign='left';
        ctx.fillText(pool.label,px+8,pool.y+16);
        ctx.fillStyle='rgba(255,255,255,.4)'; ctx.font='8px monospace';
        ctx.fillText(pool.cfg,px+8,pool.y+30);
      });
      reqs.forEach(function(r,i) {
        var ry=24+i*40+14, target=pools[pidx[i]];
        var ty=target.y+target.h/2;
        ctx.strokeStyle=r.col+'55'; ctx.lineWidth=1.2; ctx.setLineDash([3,3]);
        ctx.beginPath(); ctx.moveTo(100,ry);
        ctx.bezierCurveTo(W/2-10,ry,W/2-10,ty,px-2,ty); ctx.stroke();
        ctx.setLineDash([]);
      });
      ctx.fillStyle='#10b981'; ctx.font='700 9px monospace'; ctx.textAlign='center';
      ctx.fillText('right-sized pools — 53% energy saved',W/2+50,H-5);
    }
    ctx.restore();
  }
  draw();
  window.addEventListener('resize', function() { resize(); draw(); });
})();

// Heat map
(function() {
  var canvas = document.getElementById('hm-canvas');
  if (!canvas) return;
  var DPR = window.devicePixelRatio || 1;
  function resizeHm() {
    canvas.style.height = '280px';
    canvas.width = canvas.clientWidth * DPR;
    canvas.height = 280 * DPR;
  }
  resizeHm();
  var ctx = canvas.getContext('2d');

  var DATA = {
    ss: {
      vals: [[0.82,0.97,1.03,0.94],[1.02,1.09,1.15,1.02],[1.19,1.29,1.49,1.35]],
      opt: [0,1],
      note: 'SS: TP2@1.2GHz optimal (0.97 Wh) — TP8@2GHz baseline costs 39% more',
    },
    mm: {
      vals: [[null,null,3.45,3.39],[null,3.91,4.08,3.76],[4.39,4.56,5.24,5.44]],
      opt: [1,1],
      note: 'MM: TP4@1.2GHz optimal (3.91 Wh) — TP2@low freq violates SLO',
    },
    ll: {
      vals: [[null,null,null,null],[null,null,null,null],[null,13.5,11.89,13.21]],
      opt: [2,2],
      note: 'LL: TP8@1.6GHz optimal — 1.2GHz has more energy despite lower power (slower exec)',
    },
  };

  var cur = 'ss';
  ['ss','mm','ll'].forEach(function(t) {
    var btn = document.getElementById('hm-btn-'+t);
    if (btn) btn.addEventListener('click', function() {
      cur = t;
      document.querySelectorAll('[id^="hm-btn-"]').forEach(function(b) { b.classList.remove('active'); });
      btn.classList.add('active');
      drawHm();
    });
  });

  function eColor(v, mn, mx) {
    var t = (v-mn)/(mx-mn);
    return 'rgb('+Math.round(16+t*223)+','+Math.round(185-t*117)+','+Math.round(129-t*61)+')';
  }

  function drawHm() {
    var W = canvas.clientWidth, H = 280;
    ctx.clearRect(0,0,W*DPR,H*DPR);
    ctx.save(); ctx.scale(DPR,DPR);
    var d = DATA[cur];
    var flat = [];
    d.vals.forEach(function(row) { row.forEach(function(v) { if(v!==null) flat.push(v); }); });
    var mn = Math.min.apply(null,flat), mx = Math.max.apply(null,flat);
    var freqs=['0.8 GHz','1.2 GHz','1.6 GHz','2.0 GHz'];
    var tps=['TP2','TP4','TP8'];
    var pL=52, pT=44, pR=16, pB=40;
    var gW=W-pL-pR, gH=H-pT-pB;
    var cW=gW/4, cH=gH/3;

    ctx.strokeStyle='rgba(255,255,255,.05)'; ctx.lineWidth=1;
    for (var ri=0;ri<=3;ri++) { ctx.beginPath(); ctx.moveTo(pL,pT+ri*cH); ctx.lineTo(W-pR,pT+ri*cH); ctx.stroke(); }
    for (var ci=0;ci<=4;ci++) { ctx.beginPath(); ctx.moveTo(pL+ci*cW,pT); ctx.lineTo(pL+ci*cW,H-pB); ctx.stroke(); }

    ctx.fillStyle='rgba(255,255,255,.4)'; ctx.font='600 10px monospace'; ctx.textAlign='center';
    freqs.forEach(function(f,c) { ctx.fillText(f, pL+c*cW+cW/2, pT-8); });
    tps.forEach(function(tp,r) {
      ctx.fillStyle='rgba(255,255,255,.4)'; ctx.font='600 10px monospace'; ctx.textAlign='right';
      ctx.fillText(tp, pL-6, pT+r*cH+cH/2+4);
    });

    d.vals.forEach(function(row,r) {
      row.forEach(function(val,c) {
        var cx=pL+c*cW, cy=pT+r*cH;
        var isOpt=(r===d.opt[0]&&c===d.opt[1]);
        var isBase=(r===2&&c===3);
        if (val===null) {
          ctx.fillStyle='rgba(55,65,81,.65)';
          ctx.fillRect(cx+2,cy+2,cW-4,cH-4);
          ctx.fillStyle='rgba(255,255,255,.2)'; ctx.font='9px monospace'; ctx.textAlign='center';
          ctx.fillText('SLO x', cx+cW/2, cy+cH/2+3);
        } else {
          var col = eColor(val,mn,mx);
          ctx.fillStyle = isOpt ? 'rgba(16,185,129,.3)' : isBase ? 'rgba(239,68,68,.22)' : col+'33';
          ctx.fillRect(cx+2,cy+2,cW-4,cH-4);
          ctx.strokeStyle = isOpt ? '#10b981' : isBase ? '#ef4444' : col+'66';
          ctx.lineWidth = (isOpt||isBase) ? 2 : 1;
          ctx.strokeRect(cx+2,cy+2,cW-4,cH-4);
          ctx.fillStyle = isOpt ? '#10b981' : isBase ? '#ef4444' : '#abb2bf';
          ctx.font = ((isOpt||isBase)?'700':'500')+' 12px monospace'; ctx.textAlign='center';
          ctx.fillText(val.toFixed(2), cx+cW/2, cy+cH/2+2);
          ctx.font='9px monospace'; ctx.fillStyle='rgba(255,255,255,.4)';
          ctx.fillText('Wh', cx+cW/2, cy+cH/2+14);
          if (isOpt) { ctx.fillStyle='#10b981'; ctx.font='700 13px monospace'; ctx.fillText('★',cx+cW-14,cy+18); }
          if (isBase) { ctx.fillStyle='rgba(239,68,68,.8)'; ctx.font='700 10px monospace'; ctx.fillText('BASE',cx+cW-30,cy+18); }
        }
      });
    });

    ctx.fillStyle='rgba(255,255,255,.35)'; ctx.font='italic 10px monospace'; ctx.textAlign='center';
    ctx.fillText(d.note, W/2, H-6);
    ctx.fillStyle='rgba(255,255,255,.25)'; ctx.font='9px monospace';
    ctx.fillText('GPU Frequency', W/2, pT-24);
    ctx.save(); ctx.translate(14,pT+gH/2); ctx.rotate(-Math.PI/2);
    ctx.textAlign='center'; ctx.fillText('Tensor Parallelism',0,0); ctx.restore();
    ctx.restore();
  }
  drawHm();
  window.addEventListener('resize', function() { resizeHm(); drawHm(); });
})();

// Step navigator
(function() {
  var step = 0;
  var boxes = document.querySelectorAll('#reshard-steps .step-box');
  var prev = document.getElementById('reshard-prev');
  var next = document.getElementById('reshard-next');
  var prog = document.getElementById('reshard-prog');
  function update() {
    boxes.forEach(function(b,i) {
      b.classList.remove('active','done');
      if (i===step) b.classList.add('active');
      else if (i<step) b.classList.add('done');
    });
    if (prev) prev.disabled = step===0;
    if (next) next.disabled = step===boxes.length-1;
    if (prog) prog.textContent = 'Step '+(step+1)+' of '+boxes.length;
    boxes.forEach(function(b,i) {
      var n = b.querySelector('.step-num');
      if (n) n.textContent = i<step ? '✓' : String(i+1);
    });
  }
  if (prev) prev.addEventListener('click', function() { if(step>0){step--;update();} });
  if (next) next.addEventListener('click', function() { if(step<boxes.length-1){step++;update();} });
  update();
})();

// Bar chart animation
(function() {
  var sec = document.getElementById('s-results');
  if (!sec) return;
  var fired = false;
  new IntersectionObserver(function(entries) {
    entries.forEach(function(e) {
      if (e.isIntersecting && !fired) {
        fired = true;
        document.querySelectorAll('#energy-bars .bar-fill[data-w]').forEach(function(b) {
          b.style.width = parseFloat(b.dataset.w) + '%';
        });
      }
    });
  }, { threshold: 0.3 }).observe(sec);
})();
</script>

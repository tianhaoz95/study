<span class="cs-line cmt"># Two computationally distinct phases</span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">generate</span>(prompt, max_tokens):</span>
<span class="cs-line cmt">  # Phase 1: PREFILL (compute-bound)</span>
<span class="cs-line hl-c">  kv = model.<span class="fn">forward</span>(prompt)  <span class="cmt"># parallel</span></span>
<span class="cs-line hl-c">  <span class="cmt"># bottleneck: GPU ALU</span></span>
<span class="cs-line hl-c">  <span class="cmt"># sensitive to: high frequency</span></span>
<span class="cs-line cmt">  # Phase 2: DECODE (memory-bound)</span>
<span class="cs-line hl-g">  tokens = []</span>
<span class="cs-line hl-g">  <span class="kw">for</span> _ <span class="kw">in</span> <span class="fn">range</span>(max_tokens):</span>
<span class="cs-line hl-g">    t = model.<span class="fn">step</span>(kv)  <span class="cmt"># serial!</span></span>
<span class="cs-line hl-g">    kv.<span class="fn">append</span>(t)</span>
<span class="cs-line hl-g">  <span class="cmt"># bottleneck: HBM bandwidth</span></span>
<span class="cs-line hl-g">  <span class="cmt"># less sensitive to: frequency</span></span>
<span class="cs-line cmt"># Implication:</span>
<span class="cs-line cmt"># short input + long output req</span>
<span class="cs-line cmt"># = low freq OK (memory is the wall)</span>
      </pre>
    </div>
    <div class="cs-panel" id="panel-landscape">
      <pre class="cs-pre">
<span class="cs-line cmt"># Table I: energy (Wh), Llama2-70B</span>
<span class="cs-line cmt"># medium load 2K TPS</span>
<span class="cs-line cmt"># SS: optimal = TP2@1.2GHz</span>
<span class="cs-line">ss = {</span>
<span class="cs-line hl-g">  <span class="str">'TP2@1.2'</span>: <span class="num">0.97</span>,   <span class="cmt"># optimal</span></span>
<span class="cs-line">  <span class="str">'TP2@1.6'</span>: <span class="num">1.03</span>,</span>
<span class="cs-line">  <span class="str">'TP4@1.2'</span>: <span class="num">1.09</span>,</span>
<span class="cs-line hl-a">  <span class="str">'TP8@2.0'</span>: <span class="num">1.35</span>,   <span class="cmt"># baseline +39%</span></span>
<span class="cs-line">}</span>
<span class="cs-line cmt"># MM: optimal = TP4@1.2GHz</span>
<span class="cs-line">mm = {</span>
<span class="cs-line hl-a">  <span class="str">'TP2@0.8'</span>: <span class="kw">None</span>,   <span class="cmt"># SLO violation</span></span>
<span class="cs-line hl-g">  <span class="str">'TP4@1.2'</span>: <span class="num">3.91</span>,   <span class="cmt"># optimal</span></span>
<span class="cs-line hl-a">  <span class="str">'TP8@2.0'</span>: <span class="num">5.44</span>,   <span class="cmt"># baseline +39%</span></span>
<span class="cs-line">}</span>
<span class="cs-line cmt"># LL: only TP8 feasible</span>
<span class="cs-line cmt"># 1.2GHz = MORE energy (slower exec)</span>
<span class="cs-line">ll = {</span>
<span class="cs-line">  <span class="str">'TP8@1.2'</span>: <span class="num">13.5</span>,  <span class="cmt"># meets SLO, more E</span></span>
<span class="cs-line hl-g">  <span class="str">'TP8@1.6'</span>: <span class="num">11.89</span>, <span class="cmt"># optimal</span></span>
<span class="cs-line hl-a">  <span class="str">'TP8@2.0'</span>: <span class="num">13.21</span>, <span class="cmt"># baseline +11%</span></span>
<span class="cs-line">}</span>
      </pre>
    </div>
    <div class="cs-panel" id="panel-arch">
      <pre class="cs-pre">
<span class="cs-line cmt"># Three-tier hierarchical controller</span>
<span class="cs-line hl-p"><span class="kw">class</span> <span class="cls">ClusterManager</span>:  <span class="cmt"># 30-min</span></span>
<span class="cs-line">  <span class="kw">def</span> <span class="fn">step</span>(self):</span>
<span class="cs-line">    load = self.<span class="fn">predict_load</span>()</span>
<span class="cs-line">    rt = bert_proxy.<span class="fn">classify</span>(req)</span>
<span class="cs-line hl-c">    n = ceil(peak / max_tput)</span>
<span class="cs-line hl-c">    self.pool[rt].<span class="fn">set_size</span>(n)</span>
<span class="cs-line hl-p"><span class="kw">class</span> <span class="cls">PoolManager</span>:  <span class="cmt"># 5-min</span></span>
<span class="cs-line">  <span class="kw">def</span> <span class="fn">step</span>(self):</span>
<span class="cs-line hl-c">    tp = milp_solve(</span>
<span class="cs-line hl-c">      profile=self.profile,</span>
<span class="cs-line hl-c">      load=self.load, slo=self.slo)</span>
<span class="cs-line hl-c">    self.<span class="fn">reshard_to</span>(tp)</span>
<span class="cs-line hl-p"><span class="kw">class</span> <span class="cls">InstanceManager</span>:  <span class="cmt"># 5-sec</span></span>
<span class="cs-line">  <span class="kw">def</span> <span class="fn">step</span>(self):</span>
<span class="cs-line hl-g">    ok = [f <span class="kw">for</span> f <span class="kw">in</span> FREQS</span>
<span class="cs-line hl-g">          <span class="kw">if</span> self.<span class="fn">perf_ok</span>(f)]</span>
<span class="cs-line hl-g">    nvidia_smi.<span class="fn">set_freq</span>(<span class="fn">min</span>(ok,</span>
<span class="cs-line hl-g">      key=self.<span class="fn">energy</span>))</span>
      </pre>
    </div>
    <div class="cs-panel" id="panel-reshard">
      <pre class="cs-pre">
<span class="cs-line cmt"># Graph-matched NVLink reshard</span>
<span class="cs-line hl-p"><span class="kw">def</span> <span class="fn">reshard</span>(src_tp, dst_tp):</span>
<span class="cs-line">  G = <span class="fn">bipartite_graph</span>(</span>
<span class="cs-line">    old=<span class="fn">shard_layout</span>(src_tp),</span>
<span class="cs-line">    new=<span class="fn">shard_layout</span>(dst_tp))</span>
<span class="cs-line hl-c">  plan = <span class="fn">max_weight_matching</span>(G)</span>
<span class="cs-line hl-g">  <span class="fn">parallel_nvlink</span>(plan)</span>
<span class="cs-line cmt"># TP4 to TP8 (Llama2-70B 70B params)</span>
<span class="cs-line hl-c"><span class="cmt"># 4 parallel GPU-to-GPU transfers</span></span>
<span class="cs-line hl-g"><span class="cmt"># 1/8 of model = T = 50ms</span></span>
<span class="cs-line cmt"># TP4 to TP2</span>
<span class="cs-line hl-c"><span class="cmt"># 2 parallel transfers</span></span>
<span class="cs-line hl-g"><span class="cmt"># 1/4 of model = 2T = 100ms</span></span>
<span class="cs-line cmt"># vs naive restart: 18s from CPU</span>
<span class="cs-line cmt"># vs new VM: 6-8 minutes</span>
      </pre>

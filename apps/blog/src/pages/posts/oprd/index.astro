    <div class="cs-panel active" id="panel-variance">
      <pre class="cs-pre"><span class="cs-line cmt"># Variance analysis of next-token probability log-ratios</span>
<span class="cs-line"><span class="kw">import</span> torch</span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">opd_gradient_variance</span>(p_logits, q_logits, sampled_token):</span>
<span class="cs-line cmt">    # p: student next-token prob, q: teacher next-token prob</span>
<span class="cs-line">    p = torch.softmax(p_logits, dim=-1)</span>
<span class="cs-line">    </span>
<span class="cs-line cmt">    # REINFORCE-style token advantage reward</span>
<span class="cs-line hl-p">    advantage = torch.log(p) - torch.log_softmax(q_logits, dim=-1)</span>
<span class="cs-line">    </span>
<span class="cs-line cmt">    # Variance of the sampled-token estimator at position t</span>
<span class="cs-line hl-c">    expected_val = (p * advantage).sum(dim=-1)</span>
<span class="cs-line hl-c">    estimator_variance = (p * (advantage - expected_val.unsqueeze(-1))**2).sum(dim=-1)</span>
<span class="cs-line">    </span>
<span class="cs-line hl-g">    # Variance does NOT decay to zero as p -> q</span>
<span class="cs-line">    <span class="kw">return</span> estimator_variance</span></pre>
    </div>

    <!-- Panel Bottleneck -->
    <div class="cs-panel" id="panel-bottleneck">
      <pre class="cs-pre"><span class="cs-line cmt"># SVD analysis of language model head projection W_head</span>
<span class="cs-line"><span class="kw">import</span> torch</span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">get_effective_null_space_projection</span>(W_head):</span>
<span class="cs-line cmt">    # W_head shape: [V, d], typically V >> d</span>
<span class="cs-line">    U, S, V = torch.linalg.svd(W_head, full_matrices=False)</span>
<span class="cs-line">    </span>
<span class="cs-line cmt">    # Smallest singular value determines the null space stretch</span>
<span class="cs-line hl-c">    sigma_min = S[-1]</span>
<span class="cs-line hl-c">    sigma_max = S[0]</span>
<span class="cs-line hl-a">    spectral_ratio = (sigma_max / sigma_min) ** 2</span>
<span class="cs-line">    </span>
<span class="cs-line cmt">    # Aligning along low-singular-value vectors has no output impact</span>
<span class="cs-line hl-g">    null_vector = V[-1, :] </span>
<span class="cs-line">    <span class="kw">return</span> null_vector, spectral_ratio</span></pre>
    </div>

    <!-- Panel OPRD Loss -->
    <div class="cs-panel" id="panel-oprd_loss">
      <pre class="cs-pre"><span class="cs-line cmt"># PyTorch implementation of On-Policy Representation Distillation</span>
<span class="cs-line"><span class="kw">import</span> torch.nn <span class="kw">as</span> nn</span>
<span class="cs-line"><span class="kw">class</span> <span class="cls">OPRDLoss</span>(nn.Module):</span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">__init__</span>(self, distilled_layers, student_dim, teacher_dim):</span>
<span class="cs-line">        super().__init__()</span>
<span class="cs-line">        self.layers = distilled_layers</span>
<span class="cs-line">        # Projector for size mismatch (if ds != dT)</span>
<span class="cs-line hl-p">        self.proj = nn.Linear(student_dim, teacher_dim) if student_dim != teacher_dim else nn.Identity()</span>
<span class="cs-line">        </span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">forward</span>(self, student_hiddens, teacher_hiddens, mask):</span>
<span class="cs-line cmt">        # hiddens shapes: list of length |L_layer| with [B, T, d] tensors</span>
<span class="cs-line">        total_mse = 0.0</span>
<span class="cs-line">        <span class="kw">for</span> l <span class="kw">in</span> self.layers:</span>
<span class="cs-line">            s_h = self.proj(student_hiddens[l])</span>
<span class="cs-line hl-c">            t_h = teacher_hiddens[l].detach() # Stop gradient on teacher</span>
<span class="cs-line">            </span>
<span class="cs-line cmt">            # Masked Mean Squared Error</span>
<span class="cs-line hl-g">            sq_err = ((s_h - t_h) ** 2).mean(dim=-1) # [B, T]</span>
<span class="cs-line hl-g">            total_mse += (sq_err * mask).sum() / mask.sum()</span>
<span class="cs-line">            </span>
<span class="cs-line">        <span class="kw">return</span> total_mse / len(self.layers)</span></pre>
    </div>

    <!-- Panel Suffix Mask -->
    <div class="cs-panel" id="panel-suffix_mask">
      <pre class="cs-pre"><span class="cs-line cmt"># Suffix masking construction for chain-of-thought rollouts</span>
<span class="cs-line"><span class="kw">import</span> torch</span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">get_suffix_mask</span>(input_ids, attention_mask, k_suffix):</span>
<span class="cs-line cmt">    # input_ids: [B, T] student generated tokens</span>
<span class="cs-line">    B, T = input_ids.shape</span>
<span class="cs-line">    mask = torch.zeros_like(input_ids, dtype=torch.float32)</span>
<span class="cs-line">    </span>
<span class="cs-line hl-c">    # Determine true sequence lengths</span>
<span class="cs-line">    lengths = attention_mask.sum(dim=-1)</span>
<span class="cs-line">    </span>
<span class="cs-line">    <span class="kw">for</span> i <span class="kw">in</span> range(B):</span>
<span class="cs-line">        end = lengths[i]</span>
<span class="cs-line hl-p">        start = max(0, end - k_suffix)</span>
<span class="cs-line hl-p">        mask[i, start:end] = 1.0</span>
<span class="cs-line">        </span>
<span class="cs-line">    <span class="kw">return</span> mask</span></pre>
    </div>


document.querySelectorAll('.post-body section[id]').forEach(s =>
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.toc-item').forEach(li =>
          li.classList.toggle('toc-active', li.id === 'toc-' + e.target.id));
        const p = sectionMap[e.target.id];
        if (p) activateTab(p);
      }
    });
  }, { threshold: 0.25 }).observe(s)
);

// ----------------------------------------------------
// INTERACTIVE 1: Gradient Variance Simulation
// ----------------------------------------------------
const varCanvas = document.getElementById('variance-canvas');
if (varCanvas) {
  const ctx = varCanvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  let animId = null;
  let step = 0;
  let mode = 'opd1'; // opd1, op16, oprd
  let points = [];
  
  function resizeCanvas() {
    const W = varCanvas.clientWidth;
    const H = 260;
    varCanvas.width = W * DPR;
    varCanvas.height = H * DPR;
    ctx.scale(DPR, DPR);
    drawChart();
  }

  function initSim(m) {
    mode = m;
    step = 0;
    points = [];
    if (animId) cancelAnimationFrame(animId);
    points.push({ step: 0, variance: mode === 'oprd' ? 0 : 25, accuracy: 32.9 });
    drawChart();
  }

  function simulate() {
    if (step >= 100) {
      if (animId) cancelAnimationFrame(animId);
      return;
    }
    step++;
    const prev = points[points.length - 1];
    
    let variance = 0;
    let accuracy = 32.9;
    
    if (mode === 'opd1') {
      variance = 20 + Math.random() * 15;
      accuracy = prev.accuracy + (1.2 * (100 - step) / 100) + (Math.random() - 0.5) * 1.5;
      if (accuracy > 42.3) accuracy = 42.3 + (Math.random() - 0.5) * 0.8;
    } else if (mode === 'op16') {
      variance = 12 + Math.random() * 6;
      accuracy = prev.accuracy + (1.5 * (100 - step) / 100) + (Math.random() - 0.5) * 0.8;
      if (accuracy > 47.1) accuracy = 47.1 + (Math.random() - 0.5) * 0.5;
    } else {
      variance = Math.max(0, 0.5 * (100 - step) / 100);
      accuracy = prev.accuracy + (1.8 * (100 - step) / 100) + (Math.random() - 0.2) * 0.3;
      if (accuracy > 49.8) accuracy = 49.8 + (Math.random() - 0.3) * 0.2;
    }
    
    points.push({ step, variance, accuracy });
    drawChart();
    animId = requestAnimationFrame(simulate);
  }

  function drawChart() {
    const W = varCanvas.width / DPR;
    const H = varCanvas.height / DPR;
    ctx.clearRect(0, 0, W, H);
    
    // Grid Lines
    ctx.strokeStyle = 'rgba(255,255,255,0.05)';
    ctx.lineWidth = 1;
    for (let i = 1; i < 5; i++) {
      let x = (W / 5) * i;
      ctx.beginPath(); ctx.moveTo(x, 20); ctx.lineTo(x, H - 30); ctx.stroke();
      let y = 20 + ((H - 50) / 5) * i;
      ctx.beginPath(); ctx.moveTo(40, y); ctx.lineTo(W - 40, y); ctx.stroke();
    }
    
    // Axes labels
    ctx.fillStyle = 'var(--muted)';
    ctx.font = '9px var(--ff-mono)';
    ctx.textAlign = 'center';
    ctx.fillText('Training Step', W / 2, H - 10);
    
    ctx.save();
    ctx.translate(15, H / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.fillText('Accuracy (%)', 0, 0);
    ctx.restore();

    ctx.save();
    ctx.translate(W - 15, H / 2);
    ctx.rotate(Math.PI / 2);
    ctx.fillText('Gradient Variance', 0, 0);
    ctx.restore();

    if (points.length < 2) return;
    
    // Map functions
    const mapX = (s) => 40 + (s / 100) * (W - 80);
    const mapAcc = (a) => H - 30 - ((a - 30) / 25) * (H - 50);
    const mapVar = (v) => H - 30 - (v / 40) * (H - 50);
    
    // Draw Accuracy Curve
    ctx.beginPath();
    ctx.strokeStyle = 'var(--cyan)';
    ctx.lineWidth = 2.5;
    points.forEach((p, idx) => {
      let x = mapX(p.step);
      let y = mapAcc(p.accuracy);
      if (idx === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
    });
    ctx.stroke();

    // Draw Variance Curve
    ctx.beginPath();
    ctx.strokeStyle = 'var(--purple)';
    ctx.lineWidth = 1.5;
    ctx.setLineDash([3, 3]);
    points.forEach((p, idx) => {
      let x = mapX(p.step);
      let y = mapVar(p.variance);
      if (idx === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
    });
    ctx.stroke();
    ctx.setLineDash([]);
    
    // Draw final values
    const last = points[points.length - 1];
    ctx.fillStyle = 'var(--cyan-l)';
    ctx.font = '10px var(--ff-mono)';
    ctx.textAlign = 'left';
    ctx.fillText(`Acc: ${last.accuracy.toFixed(1)}%`, mapX(last.step) - 70, mapAcc(last.accuracy) - 8);
    
    ctx.fillStyle = 'var(--purple-l)';
    ctx.fillText(`Var: ${last.variance.toFixed(1)}`, mapX(last.step) - 70, mapVar(last.variance) + 12);
  }

  document.getElementById('sim-opd1-btn')?.addEventListener('click', (e) => {
    document.querySelectorAll('#s-variance .chart-btn').forEach(b => b.classList.remove('active'));
    e.target.classList.add('active');
    initSim('opd1');
  });
  document.getElementById('sim-op16-btn')?.addEventListener('click', (e) => {
    document.querySelectorAll('#s-variance .chart-btn').forEach(b => b.classList.remove('active'));
    e.target.classList.add('active');
    initSim('op16');
  });
  document.getElementById('sim-oprd-btn')?.addEventListener('click', (e) => {
    document.querySelectorAll('#s-variance .chart-btn').forEach(b => b.classList.remove('active'));
    e.target.classList.add('active');
    initSim('oprd');
  });
  document.getElementById('run-sim-btn')?.addEventListener('click', () => {
    initSim(mode);
    simulate();
  });

  window.addEventListener('resize', resizeCanvas);
  initSim('opd1');
  setTimeout(resizeCanvas, 200);
}

// ----------------------------------------------------
// INTERACTIVE 2: LM Head Projection (Null Space)
// ----------------------------------------------------
const btnCanvas = document.getElementById('bottleneck-canvas');
const btnSlider = document.getElementById('bottleneck-slider');
if (btnCanvas && btnSlider) {
  const ctx = btnCanvas.getContext('2d');
  const DPR = window.devicePixelRatio || 1;
  
  function drawBottleneck() {
    const W = btnCanvas.clientWidth;
    const H = 240;
    btnCanvas.width = W * DPR;
    btnCanvas.height = H * DPR;
    ctx.scale(DPR, DPR);
    
    ctx.clearRect(0, 0, W, H);
    
    const offset = parseFloat(btnSlider.value); // -100 to 100
    
    // Draw 3D-like coordinate system
    const ox = 70;
    const oy = H - 60;
    
    // Draw axes
    ctx.strokeStyle = 'rgba(255,255,255,0.1)';
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(ox, oy); ctx.lineTo(ox + 180, oy); ctx.stroke(); // X
    ctx.beginPath(); ctx.moveTo(ox, oy); ctx.lineTo(ox, oy - 140); ctx.stroke(); // Y
    ctx.beginPath(); ctx.moveTo(ox, oy); ctx.lineTo(ox - 40, oy + 40); ctx.stroke(); // Z (3D depth)
    
    // Draw Softmax projection plane (a flat horizontal green plane)
    ctx.fillStyle = 'rgba(6,182,212,0.08)';
    ctx.strokeStyle = 'rgba(6,182,212,0.3)';
    ctx.beginPath();
    ctx.moveTo(ox + 40, oy - 80);
    ctx.lineTo(ox + 200, oy - 80);
    ctx.lineTo(ox + 160, oy - 40);
    ctx.lineTo(ox, oy - 40);
    ctx.closePath();
    ctx.fill(); ctx.stroke();
    
    ctx.fillStyle = 'var(--cyan)';
    ctx.font = '8px var(--ff-mono)';
    ctx.fillText('LM Head Softmax Projection Plane', ox + 15, oy - 85);
    
    // Teacher Hidden State Vector (h_T)
    const tx = ox + 100;
    const ty = oy - 90;
    ctx.strokeStyle = 'var(--purple)';
    ctx.lineWidth = 2.5;
    ctx.beginPath();
    ctx.moveTo(ox, oy);
    ctx.lineTo(tx, ty);
    ctx.stroke();
    // Arrow head
    drawArrowhead(ox, oy, tx, ty, 'var(--purple)');
    
    ctx.fillStyle = 'var(--purple-l)';
    ctx.font = '9px var(--ff-mono)';
    ctx.fillText('h_T (Teacher)', tx - 10, ty - 10);
    
    // Student Hidden State Vector (h_theta)
    // Shift is along the null space direction (which projects to the exact same spot on the plane)
    const sx = tx + (offset * 0.4);
    const sy = ty - (offset * 0.1);
    ctx.strokeStyle = '#ef4444';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(ox, oy);
    ctx.lineTo(sx, sy);
    ctx.stroke();
    drawArrowhead(ox, oy, sx, sy, '#ef4444');
    
    ctx.fillStyle = '#ef4444';
    ctx.fillText('h_θ (Student)', sx + 5, sy - 5);
    
    // Draw null space line of shift
    ctx.strokeStyle = 'rgba(255,255,255,0.15)';
    ctx.setLineDash([2, 4]);
    ctx.beginPath();
    ctx.moveTo(tx - 40, ty + 10);
    ctx.lineTo(tx + 40, ty - 10);
    ctx.stroke();
    ctx.setLineDash([]);
    
    // Draw projection lines onto the plane
    ctx.strokeStyle = 'rgba(6,182,212,0.4)';
    ctx.lineWidth = 1;
    ctx.setLineDash([1, 2]);
    // Both teacher and student project to the SAME spot on the softmax plane
    const px = tx;
    const py = oy - 60;
    
    ctx.beginPath(); ctx.moveTo(tx, ty); ctx.lineTo(px, py); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(sx, sy); ctx.lineTo(px, py); ctx.stroke();
    ctx.setLineDash([]);
    
    // Projected point on plane
    ctx.fillStyle = 'var(--cyan)';
    ctx.beginPath();
    ctx.arc(px, py, 4, 0, 2 * Math.PI);
    ctx.fill();
    
    ctx.fillText('p(v) = q(v)', px + 8, py + 3);
    
    // Update metrics
    const klError = 0.0000;
    const logitShift = Math.abs(offset * 0.05);
    const mseError = (offset * offset) / 2500;
    
    document.getElementById('logit-shift-val').textContent = logitShift.toFixed(2);
    document.getElementById('kl-error-val').textContent = klError.toFixed(4);
    const mseEl = document.getElementById('mse-error-val');
    mseEl.textContent = mseError.toFixed(4);
    
    if (mseError > 0.01) {
      mseEl.className = 'metric-box-value red';
    } else {
      mseEl.className = 'metric-box-value green';
    }
  }
  
  function drawArrowhead(fromx, fromy, tox, toy, color) {
    const angle = Math.atan2(toy - fromy, tox - fromx);
    ctx.fillStyle = color;
    ctx.beginPath();
    ctx.moveTo(tox, toy);
    ctx.lineTo(tox - 8 * Math.cos(angle - Math.PI / 6), toy - 8 * Math.sin(angle - Math.PI / 6));
    ctx.lineTo(tox - 8 * Math.cos(angle + Math.PI / 6), toy - 8 * Math.sin(angle + Math.PI / 6));
    ctx.closePath();
    ctx.fill();
  }
  
  btnSlider.addEventListener('input', drawBottleneck);
  window.addEventListener('resize', drawBottleneck);
  setTimeout(drawBottleneck, 200);
}

// ----------------------------------------------------
// INTERACTIVE 3: Layer Alignment Tracker
// ----------------------------------------------------
const layerSlider = document.getElementById('layer-slider');
const layerSliderLabel = document.getElementById('layer-slider-label');
if (layerSlider && layerSliderLabel) {
  function updateLayers() {
    const l = parseInt(layerSlider.value);
    layerSliderLabel.textContent = `Distillation Layer: ${l}`;
    
    // Dynamic cosine similarity calculations (simulated values based on layer index)
    let early = 99.2;
    let mid = 95.8;
    let late = 96.5;
    
    if (l < 9) {
      early = 98.0 + (l / 8) * 1.5;
      mid = 91.0 + (l / 8) * 2.0;
      late = 85.0 + (l / 8) * 4.0;
    } else if (l < 19) {
      early = 99.2;
      mid = 94.0 + ((l - 8) / 10) * 1.8;
      late = 89.0 + ((l - 8) / 10) * 3.0;
    } else {
      early = 99.2;
      mid = 95.8;
      late = 92.0 + ((l - 18) / 10) * 4.5;
    }
    
    document.getElementById('layer-bar-early').style.width = `${early}%`;
    document.getElementById('layer-val-early').textContent = `${early.toFixed(1)}%`;
    
    document.getElementById('layer-bar-mid').style.width = `${mid}%`;
    document.getElementById('layer-val-mid').textContent = `${mid.toFixed(1)}%`;
    
    document.getElementById('layer-bar-late').style.width = `${late}%`;
    document.getElementById('layer-val-late').textContent = `${late.toFixed(1)}%`;
  }
  layerSlider.addEventListener('input', updateLayers);
  updateLayers();
}

// ----------------------------------------------------
// INTERACTIVE 4: Suffix Masking Inspector
// ----------------------------------------------------
const suffixSlider = document.getElementById('suffix-slider');
const suffixSliderLabel = document.getElementById('suffix-slider-label');
const tokenContainer = document.getElementById('token-inspector-container');

const demoTokens = [
  "<thought>", "Let", "n^2", "+", "19n", "+", "92", "=", "k^2", "for", "some", "integer", "k.", "Then", 
  "(2n+19)^2", "-", "4k^2", "=", "-7.", "This", "factors", "as", "(2n+19-2k)", "(2n+19+2k)", "=", "-7.", 
  "The", "factors", "of", "-7", "are", "1,", "-1,", "7,", "-7.", "Solving", "gives", "n", "=", "-6", 
  "or", "-13.", "</thought>", "Solution:", "-6,", "-13."
];

if (suffixSlider && suffixSliderLabel && tokenContainer) {
  function renderTokens() {
    const k = parseInt(suffixSlider.value);
    suffixSliderLabel.textContent = `Suffix Length (k): ${k} tokens`;
    
    tokenContainer.innerHTML = '';
    const n = demoTokens.length;
    const startIndex = n - k;
    
    demoTokens.forEach((tok, idx) => {
      const span = document.createElement('span');
      span.textContent = tok;
      span.className = 'tok';
      
      if (idx >= startIndex) {
        span.className = 'tok supervised';
      } else {
        span.className = 'tok not-supervised';
      }
      tokenContainer.appendChild(span);
    });
    
    // Update labels
    const maskStatus = document.getElementById('mask-status');
    const savedComp = document.getElementById('saved-comp-val');
    
    if (k === 0) {
      maskStatus.textContent = 'Inactive';
      maskStatus.style.color = '#ef4444';
      savedComp.textContent = '100%';
    } else {
      maskStatus.textContent = 'Active';
      maskStatus.style.color = 'var(--purple-l)';
      const saved = Math.round((1 - (k / n)) * 100);
      savedComp.textContent = `${saved}%`;
    }
  }
  suffixSlider.addEventListener('input', renderTokens);
  renderTokens();
}

// ----------------------------------------------------
// INTERACTIVE 5: Peak GPU Memory Profile
// ----------------------------------------------------
const memorySlider = document.getElementById('memory-slider');
const memorySliderLabel = document.getElementById('memory-slider-label');
if (memorySlider && memorySliderLabel) {
  function updateMemory() {
    const t = parseInt(memorySlider.value);
    memorySliderLabel.textContent = `Seq Length (T): ${t}`;
    
    // Scale memory quadratically or linearly
    const factor = t / 8192;
    const op16Mem = 22.5 * factor * (1 + (factor - 1) * 0.2);
    const op1Mem = 15.1 * factor;
    const oprdMem = 10.2 * factor * 0.7; // Bypasses vocabulary dimension
    
    const barOp16 = document.getElementById('bar-op16-mem');
    const barOp1 = document.getElementById('bar-op1-mem');
    const barOprd = document.getElementById('bar-oprd-mem');
    
    barOp16.style.width = `${Math.min(100, (op16Mem / 45) * 100)}%`;
    barOp16.querySelector('span').textContent = `${op16Mem.toFixed(1)} GB`;
    
    barOp1.style.width = `${Math.min(100, (op1Mem / 45) * 100)}%`;
    barOp1.querySelector('span').textContent = `${op1Mem.toFixed(1)} GB`;
    
    barOprd.style.width = `${Math.min(100, (oprdMem / 45) * 100)}%`;
    barOprd.querySelector('span').textContent = `${oprdMem.toFixed(1)} GB`;
  }
  memorySlider.addEventListener('input', updateMemory);
  updateMemory();
}


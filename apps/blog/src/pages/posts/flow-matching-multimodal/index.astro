<script>
// ── TOC toggle ──────────────────────────────────────────────────────
const tocSidebar = document.getElementById('toc-sidebar');
const tocToggle = document.getElementById('toc-toggle');
const postGrid = document.getElementById('post-grid');

tocToggle?.addEventListener('click', () => {
  const collapsed = tocSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('toc-collapsed', collapsed);
  tocToggle.textContent = collapsed ? '›' : '‹';
  tocToggle.title = collapsed ? 'Show contents' : 'Hide contents';
});

// ── Code sidebar toggle ─────────────────────────────────────────────
const codeSidebar = document.getElementById('code-sidebar');
const csToggle = document.getElementById('cs-toggle');

csToggle?.addEventListener('click', () => {
  const collapsed = codeSidebar.classList.toggle('collapsed');
  postGrid.classList.toggle('sidebar-collapsed', collapsed);
  csToggle.textContent = collapsed ? '‹' : '›';
  csToggle.title = collapsed ? 'Show code' : 'Hide code';
});

// ── Code sidebar tabs ───────────────────────────────────────────────
const csTabs = document.querySelectorAll('.cs-tab');
const csPanels = document.querySelectorAll('.cs-panel');
const csFileLabel = document.getElementById('cs-file-label');
const csSectionTitle = document.getElementById('cs-section-title');

const tabMeta = {
  paradigm:   { file: 'flow/paradigm.py',   title: 'The Paradigm' },
  cfm_loss:   { file: 'flow/cfm_loss.py',   title: 'CFM Loss function' },
  solver:     { file: 'flow/solver.py',     title: 'ODE Euler Integrator' },
  history:    { file: 'flow/history.py',    title: 'Generative History' },
  multimodal: { file: 'flow/multimodal.py', title: 'MM-DiT Flow Matching' },
};

function activateTab(name) {
  csTabs.forEach(t => t.classList.toggle('active', t.dataset.panel === name));
  csPanels.forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  const m = tabMeta[name];
  if (m && csFileLabel) csFileLabel.textContent = m.file;
  if (m && csSectionTitle) csSectionTitle.textContent = m.title;
}

csTabs.forEach(tab => {
  tab.addEventListener('click', () => activateTab(tab.dataset.panel));
});

// ── IntersectionObserver: sync TOC + sidebar ───────────────────────
const sectionCodeMap = {
  's-paradigm':     'paradigm',
  's-cfm':          'cfm_loss',
  's-sim':          'solver',
  's-history':      'history',
  's-breakthroughs':'multimodal',
};

const observer = new IntersectionObserver((entries) => {
  let best = null, bestRatio = 0;
  entries.forEach(e => {
    if (e.isIntersecting && e.intersectionRatio > bestRatio) {
      best = e.target;
      bestRatio = e.intersectionRatio;
    }
  });
  if (!best) return;
  const id = best.id;
  // update TOC active
  document.querySelectorAll('.toc-item').forEach(li => {
    li.classList.toggle('toc-active', li.id === 'toc-' + id);
  });
  // sync sidebar tab
  const panel = sectionCodeMap[id];
  if (panel) activateTab(panel);
}, { threshold: [0.15, 0.4] });

document.querySelectorAll('.post-body section[id]').forEach(s => observer.observe(s));

// ── ODE Integrator Canvas Simulation ───────────────────────────────
const simCanvas = document.getElementById('ot-sim-canvas');
if (simCanvas) {
  const ctx = simCanvas.getContext('2d');
  const W_CSS = simCanvas.clientWidth;
  const H_CSS = 280;
  const DPR = window.devicePixelRatio || 1;
  simCanvas.width = W_CSS * DPR;
  simCanvas.height = H_CSS * DPR;
  ctx.scale(DPR, DPR);

  const W = W_CSS, H = H_CSS;
  
  // Base parameters
  let pathType = 'ot'; // 'ot', 'curved', 'sde'
  let stepsN = 10;     // 3, 10, 50
  let t = 0;
  let playing = false;
  let animId = null;

  // Define semantic targets
  const clusters = [
    { cx: 0.2, cy: 0.25, color: '#c678dd', label: 'Images' }, // Purple
    { cx: 0.8, cy: 0.25, color: '#61afef', label: 'Text' },   // Cyan
    { cx: 0.5, cy: 0.75, color: '#98c379', label: 'Audio' },  // Green
  ];

  // Particle configuration
  const particles = [];
  const rng = (seed) => {
    let s = seed;
    return () => {
      s = (s * 1664525 + 1013904223) & 0xffffffff;
      return (s >>> 0) / 0xffffffff;
    };
  };

  const rand = rng(101);
  // Box-Muller generator for SDE noise
  function gaussianRand(randFunc) {
    const u1 = randFunc() || 0.00001;
    const u2 = randFunc();
    const r = Math.sqrt(-2.0 * Math.log(u1));
    const theta = 2.0 * Math.PI * u2;
    return r * Math.cos(theta);
  }

  // Create 30 particles (10 per cluster) starting in a Gaussian circle in the center
  clusters.forEach((cl, ci) => {
    for (let i = 0; i < 10; i++) {
      // Gaussian distribution around center
      const r = rand() * 25;
      const angle = rand() * Math.PI * 2;
      const noise_x = W / 2 + r * Math.cos(angle);
      const noise_y = H / 2 + r * Math.sin(angle);
      
      // Clean target position inside cluster
      const target_r = rand() * 20;
      const target_angle = rand() * Math.PI * 2;
      const clean_x = cl.cx * W + target_r * Math.cos(target_angle);
      const clean_y = cl.cy * H + target_r * Math.sin(target_angle);

      // Normal vector direction for curving (away from center)
      const dx = clean_x - W/2;
      const dy = clean_y - H/2;
      const len = Math.sqrt(dx*dx + dy*dy) || 1;
      const nx = -dy / len;
      const ny = dx / len;

      particles.push({
        id: particles.length,
        x0: noise_x,
        y0: noise_y,
        x1: clean_x,
        y1: clean_y,
        nx: nx,
        ny: ny,
        color: cl.color,
        clusterLabel: i === 0 ? cl.label : null
      });
    }
  });

  // Mathematically simulate the discrete Euler integration paths
  function computeDiscretePoints(p, mode, N) {
    const points = [{ x: p.x0, y: p.y0 }];
    const dt = 1.0 / N;
    let x = p.x0;
    let y = p.y0;

    // Seeded random numbers per particle for reproducible SDE sampling
    const pRand = rng(p.id * 17 + N * 3);

    for (let k = 0; k < N; k++) {
      const tk = k / N;
      if (mode === 'ot') {
        // Optimal Transport constant velocity: v = x1 - x0
        const vx = p.x1 - p.x0;
        const vy = p.y1 - p.y0;
        x += vx * dt;
        y += vy * dt;
      } else if (mode === 'curved') {
        // Curved path velocity with normal displacement bowing out
        // Path formulation: x_t = (1-t)*x0 + t*x1 + A * sin(pi * t) * n
        // Velocity field: dx/dt = (x1 - x0) + A * pi * cos(pi * t) * n
        const A = 100;
        const vx = (p.x1 - p.x0) + A * Math.PI * Math.cos(Math.PI * tk) * p.nx;
        const vy = (p.y1 - p.y0) + A * Math.PI * Math.cos(Math.PI * tk) * p.ny;
        x += vx * dt;
        y += vy * dt;
      } else if (mode === 'sde') {
        // Stochastic SDE bridge: drift = (x1 - x_k)/(1-t) + random diffusion noise
        // dx_k = (x1 - x_k)/(1-t) * dt + g * sqrt(dt) * z
        const g = 18;
        const driftCoeff = (tk < 1.0) ? 1.0 / (1.0 - tk) : 0;
        const vx = (p.x1 - x) * driftCoeff;
        const vy = (p.y1 - y) * driftCoeff;
        
        const zx = gaussianRand(pRand);
        const zy = gaussianRand(pRand);

        // Limit the step drift to avoid infinite velocities at the very end
        const stepX = Math.min(vx * dt, p.x1 - x);
        const stepY = Math.min(vy * dt, p.y1 - y);

        x += stepX + g * Math.sqrt(dt) * zx;
        y += stepY + g * Math.sqrt(dt) * zy;
      }
      points.push({ x, y });
    }
    return points;
  }

  // Draw current simulation state for visual time t ∈ [0, 1]
  function drawFrame(tt) {
    ctx.clearRect(0, 0, W, H);

    // Subtle background grid
    ctx.strokeStyle = 'rgba(255,255,255,0.03)';
    ctx.lineWidth = 1;
    for (let gx = 0; gx <= W; gx += 40) { ctx.beginPath(); ctx.moveTo(gx, 0); ctx.lineTo(gx, H); ctx.stroke(); }
    for (let gy = 0; gy <= H; gy += 40) { ctx.beginPath(); ctx.moveTo(0, gy); ctx.lineTo(W, gy); ctx.stroke(); }

    // Render cluster boundaries
    clusters.forEach(cl => {
      ctx.beginPath();
      ctx.arc(cl.cx * W, cl.cy * H, 45, 0, Math.PI * 2);
      ctx.fillStyle = cl.color + '09';
      ctx.fill();
      ctx.strokeStyle = cl.color + '22';
      ctx.lineWidth = 1.5;
      ctx.setLineDash([4, 4]);
      ctx.stroke();
      ctx.setLineDash([]);

      // Label
      ctx.font = '10px monospace';
      ctx.fillStyle = cl.color + '88';
      ctx.textAlign = 'center';
      ctx.fillText(cl.label.toUpperCase(), cl.cx * W, cl.cy * H + 6);
    });

    // Draw particle paths and dots
    particles.forEach(p => {
      const pts = computeDiscretePoints(p, pathType, stepsN);
      
      // Map continuous time t to discrete segment index
      const floatIdx = tt * stepsN;
      const idx = Math.min(stepsN - 1, Math.floor(floatIdx));
      const frac = floatIdx - idx;
      
      const pCurrent = pts[idx];
      const pNext = pts[idx + 1];
      
      // Interpolate current position along current segment
      const curX = pCurrent.x + (pNext.x - pCurrent.x) * frac;
      const curY = pCurrent.y + (pNext.y - pCurrent.y) * frac;

      // Draw path up to the current segment
      ctx.beginPath();
      ctx.moveTo(p.x0, p.y0);
      for (let i = 1; i <= idx; i++) {
        ctx.lineTo(pts[i].x, pts[i].y);
      }
      ctx.lineTo(curX, curY);
      ctx.strokeStyle = p.color + '44';
      ctx.lineWidth = 1.2;
      ctx.stroke();

      // Draw discrete step points
      for (let i = 0; i <= idx; i++) {
        ctx.beginPath();
        ctx.arc(pts[i].x, pts[i].y, 2, 0, Math.PI * 2);
        ctx.fillStyle = p.color + '88';
        ctx.fill();
      }

      // Current particle dot
      ctx.beginPath();
      ctx.arc(curX, curY, 4.5, 0, Math.PI * 2);
      ctx.fillStyle = p.color;
      ctx.fill();
      ctx.strokeStyle = '#fff';
      ctx.lineWidth = 1;
      ctx.stroke();
    });

    // Label t in corner
    ctx.font = '11px monospace';
    ctx.fillStyle = 'rgba(6,182,212,0.85)';
    ctx.textAlign = 'left';
    ctx.fillText(`Integration step (t): ${tt.toFixed(2)}`, 15, 25);
    ctx.fillText(`Steps (N): ${stepsN}`, 15, 40);
  }

  // Draw initial frame
  drawFrame(0);

  // Play animation loop
  function step() {
    t = Math.min(1.0, t + 0.007);
    drawFrame(t);
    if (t < 1.0) {
      animId = requestAnimationFrame(step);
    } else {
      playing = false;
      const playBtn = document.getElementById('sim-play');
      if (playBtn) {
        playBtn.textContent = '▶ Play Simulation';
        playBtn.classList.remove('active');
      }
    }
  }

  // Hook up event listeners for path selection
  const btnOt = document.getElementById('path-ot');
  const btnCurved = document.getElementById('path-curved');
  const btnSde = document.getElementById('path-sde');

  function clearPathButtons() {
    [btnOt, btnCurved, btnSde].forEach(btn => btn?.classList.remove('active'));
  }

  btnOt?.addEventListener('click', () => {
    clearPathButtons();
    btnOt.classList.add('active');
    pathType = 'ot';
    t = 0;
    playing = false;
    cancelAnimationFrame(animId);
    drawFrame(0);
  });

  btnCurved?.addEventListener('click', () => {
    clearPathButtons();
    btnCurved.classList.add('active');
    pathType = 'curved';
    t = 0;
    playing = false;
    cancelAnimationFrame(animId);
    drawFrame(0);
  });

  btnSde?.addEventListener('click', () => {
    clearPathButtons();
    btnSde.classList.add('active');
    pathType = 'sde';
    t = 0;
    playing = false;
    cancelAnimationFrame(animId);
    drawFrame(0);
  });

  // Steps select listeners
  const btnN3 = document.getElementById('steps-3');
  const btnN10 = document.getElementById('steps-10');
  const btnN50 = document.getElementById('steps-50');

  function clearStepsButtons() {
    [btnN3, btnN10, btnN50].forEach(btn => btn?.classList.remove('active'));
  }

  btnN3?.addEventListener('click', () => {
    clearStepsButtons();
    btnN3.classList.add('active');
    stepsN = 3;
    t = 0;
    playing = false;
    cancelAnimationFrame(animId);
    drawFrame(0);
  });

  btnN10?.addEventListener('click', () => {
    clearStepsButtons();
    btnN10.classList.add('active');
    stepsN = 10;
    t = 0;
    playing = false;
    cancelAnimationFrame(animId);
    drawFrame(0);
  });

  btnN50?.addEventListener('click', () => {
    clearStepsButtons();
    btnN50.classList.add('active');
    stepsN = 50;
    t = 0;
    playing = false;
    cancelAnimationFrame(animId);
    drawFrame(0);
  });

  // Action listeners
  const playBtn = document.getElementById('sim-play');
  const resetBtn = document.getElementById('sim-reset');

  playBtn?.addEventListener('click', () => {
    if (playing) {
      playing = false;
      cancelAnimationFrame(animId);
      playBtn.textContent = '▶ Play Simulation';
      playBtn.classList.remove('active');
    } else {
      if (t >= 1.0) t = 0;
      playing = true;
      playBtn.textContent = '⏸ Pause';
      playBtn.classList.add('active');
      animId = requestAnimationFrame(step);
    }
  });

  resetBtn?.addEventListener('click', () => {
    playing = false;
    cancelAnimationFrame(animId);
    t = 0;
    drawFrame(0);
    if (playBtn) {
      playBtn.textContent = '▶ Play Simulation';
      playBtn.classList.remove('active');
    }
  });
}
</script>
</BaseLayout>

<span class="cs-line">    <span class="cmt">"""</span></span>
<span class="cs-line cmt">    Euler ODE integrator for Flow Matching inference.</span>
<span class="cs-line cmt">    Transforms noise x0 (t=0) into data x1 (t=1).</span>
<span class="cs-line cmt">    """</span>
<span class="cs-line hl-p">    xt = x0</span>
<span class="cs-line hl-p">    dt = <span class="num">1.0</span> / steps</span>
<span class="cs-line">    </span>

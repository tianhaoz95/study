<span class="cs-line kw">import</span> <span class="op">torch.nn</span> <span class="kw">as</span> <span class="op">nn</span>
<span class="cs-line"></span>
<span class="cs-line kw">class</span> <span class="cls">ConditionalFlowMatchingLoss</span>(<span class="op">nn.Module</span>):
<span class="cs-line">    <span class="cmt">"""</span></span>
<span class="cs-line cmt">    Conditional Flow Matching loss with Optimal Transport paths.</span>
<span class="cs-line cmt">    Regresses target velocities directly without ODE simulation.</span>
<span class="cs-line cmt">    """</span>
<span class="cs-line hl-p">    <span class="kw">def</span> <span class="fn">forward</span>(<span class="op">self</span>, <span class="op">model</span>, <span class="op">x1</span>):</span>
<span class="cs-line cmt">        # x1: clean target data points (e.g. images)</span>
<span class="cs-line hl-p">        batch_size = x1.shape[<span class="num">0</span>]</span>
<span class="cs-line">        </span>
<span class="cs-line cmt">        # 1. Sample timestep t uniformly ∈ [0, 1]</span>
<span class="cs-line hl-p">        t = torch.rand(batch_size, <span class="num">1</span>, device=x1.device)</span>
<span class="cs-line">        </span>
<span class="cs-line cmt">        # 2. Sample base noise x0 ~ N(0, I)</span>
<span class="cs-line hl-p">        x0 = torch.randn_like(x1)</span>
<span class="cs-line">        </span>
<span class="cs-line cmt">        # 3. Compute linear path interpolation (probability path)</span>
<span class="cs-line hl-c">        xt = t * x1 + (<span class="num">1.0</span> - t) * x0</span>
<span class="cs-line">        </span>
<span class="cs-line cmt">        # 4. Target conditional velocity vector (constant along path)</span>
<span class="cs-line hl-c">        ut = x1 - x0</span>
<span class="cs-line">        </span>
<span class="cs-line cmt">        # 5. Predict velocity vector using neural network</span>
<span class="cs-line hl-g">        vt = model(xt, t.squeeze(<span class="num">-1</span>))</span>
<span class="cs-line">        </span>
<span class="cs-line cmt">        # 6. Loss is standard MSE of predicted vs target velocity</span>
<span class="cs-line hl-g">        loss = torch.mean((vt - ut) ** <span class="num">2</span>)</span>

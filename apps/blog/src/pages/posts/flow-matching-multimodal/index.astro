<span class="cs-line hl-c">        t_val = i / steps</span>
<span class="cs-line hl-c">        t = torch.full((x0.shape[<span class="num">0</span>],), t_val, device=x0.device)</span>
<span class="cs-line">        </span>
<span class="cs-line cmt">        # Predict velocity at current state</span>
<span class="cs-line hl-g">        vt = model(xt, t)</span>
<span class="cs-line">        </span>
<span class="cs-line cmt">        # Take a linear step along the velocity vector</span>
<span class="cs-line hl-g">        xt = xt + vt * dt</span>
<span class="cs-line">        </span>
<span class="cs-line hl-p">    <span class="kw">return</span> xt  <span class="cmt"># Generated samples</span></span></pre>

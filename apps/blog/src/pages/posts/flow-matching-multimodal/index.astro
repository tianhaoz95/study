<span class="cs-line cmt"># MM-DiT encodes image and text latents. Flow velocities</span>
<span class="cs-line cmt"># are regressed jointly across both paths:</span>
<span class="cs-line"></span>
<span class="cs-line hl-p"><span class="kw">class</span> <span class="cls">MMDiTFlowMatching</span>(nn.Module):</span>
<span class="cs-line hl-p">    <span class="kw">def</span> <span class="fn">forward</span>(<span class="op">self</span>, img_latents, text_latents, t):</span>
<span class="cs-line hl-c">        # Sample noise matching the dimensions of both modalities</span>
<span class="cs-line hl-c">        img_noise = torch.randn_like(img_latents)</span>
<span class="cs-line hl-c">        text_noise = torch.randn_like(text_latents)</span>
<span class="cs-line">        </span>
<span class="cs-line cmt">        # Linearly interpolate image and text latents</span>
<span class="cs-line hl-c">        img_t = t * img_latents + (1 - t) * img_noise</span>
<span class="cs-line hl-c">        text_t = t * text_latents + (1 - t) * text_noise</span>
<span class="cs-line">        </span>
<span class="cs-line cmt">        # Target velocities (constant along linear paths)</span>
<span class="cs-line hl-g">        img_target_v = img_latents - img_noise</span>
<span class="cs-line hl-g">        text_target_v = text_latents - text_noise</span>
<span class="cs-line">        </span>
<span class="cs-line cmt">        # Predict velocities jointly via MM-DiT block</span>
<span class="cs-line hl-g">        img_pred_v, text_pred_v = self.mm_dit(img_t, text_t, t)</span>
<span class="cs-line">        </span>
<span class="cs-line cmt">        # Compute average joint loss</span>
<span class="cs-line hl-p">        loss = (torch.mean((img_pred_v - img_target_v)**2) +</span>
<span class="cs-line hl-p">                torch.mean((text_pred_v - text_target_v)**2))</span>
<span class="cs-line hl-p">        <span class="kw">return</span> loss</span></pre>

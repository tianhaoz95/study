<span class="cs-line cmt"># HRM forward pass (simplified)</span>
<span class="cs-line cmt"># H2L3: 2 outer cycles, 3 L-steps each</span>
<span class="cs-line"> </span>
<span class="cs-line"><span class="kw">class</span> <span class="cls">HRM</span>:</span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">forward</span>(<span class="kw">self</span>, tokens):</span>
<span class="cs-line">        x = <span class="kw">self</span>.<span class="fn">embed</span>(tokens)</span>
<span class="cs-line hl-c">        <span class="cmt"># init slow state from embeddings</span></span>
<span class="cs-line hl-c">        z_H = <span class="kw">self</span>.<span class="fn">h_init</span>(x)</span>
<span class="cs-line hl-g">        <span class="cmt"># fixed initial fast state</span></span>
<span class="cs-line hl-g">        z_L = <span class="kw">self</span>.<span class="fn">l_init</span>(x)</span>
<span class="cs-line"> </span>
<span class="cs-line hl-p">        <span class="kw">for</span> cycle <span class="kw">in</span> <span class="fn">range</span>(<span class="num">2</span>):  <span class="cmt"># H cycles</span></span>
<span class="cs-line hl-p">            <span class="kw">for</span> _ <span class="kw">in</span> <span class="fn">range</span>(<span class="num">3</span>):  <span class="cmt"># L steps</span></span>
<span class="cs-line hl-p">                z_L = <span class="kw">self</span>.<span class="fn">L_module</span>(z_L, z_H)</span>
<span class="cs-line hl-p">            <span class="cmt"># H integrates context after 3 L-steps</span></span>
<span class="cs-line hl-p">            z_H = <span class="kw">self</span>.<span class="fn">H_module</span>(z_H, z_L)</span>
<span class="cs-line"> </span>
<span class="cs-line">        <span class="kw">return</span> <span class="kw">self</span>.<span class="fn">lm_head</span>(z_H)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Total forward steps: 2×(3+1) = 8</span>
<span class="cs-line cmt"># Each step uses 1/2 of model params</span>
<span class="cs-line cmt"># → 4× compute of single-pass Transformer</span>
<span class="cs-line cmt"># → same parameter count</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># L-module: local fast execution</span>
<span class="cs-line cmt"># (causal self-attention + SwiGLU FFN)</span>
<span class="cs-line cmt"># H-module: slow strategic context</span>
<span class="cs-line cmt"># (PrefixLM attention across full seq)</span>
      </pre>
    </div>

    <!-- panel: magicnorm -->
    <div class="cs-panel" id="panel-magicnorm">
      <pre class="cs-pre">
<span class="cs-line cmt"># MagicNorm: PreNorm inside, PostNorm exit</span>
<span class="cs-line"> </span>
<span class="cs-line"><span class="kw">class</span> <span class="cls">MagicNormModule</span>(<span class="cls">nn.Module</span>):</span>
<span class="cs-line">    <span class="kw">def</span> <span class="fn">forward</span>(<span class="kw">self</span>, z):</span>
<span class="cs-line cmt">        # --- Internal PreNorm blocks ---</span>
<span class="cs-line hl-c">        h = z + <span class="kw">self</span>.<span class="fn">attn</span>(<span class="kw">self</span>.<span class="fn">norm1</span>(z))</span>
<span class="cs-line hl-c">        h = h + <span class="kw">self</span>.<span class="fn">ffn</span>(<span class="kw">self</span>.<span class="fn">norm2</span>(h))</span>
<span class="cs-line cmt">        # --- Exit normalization (PostNorm) ---</span>
<span class="cs-line hl-p">        <span class="kw">return</span> <span class="kw">self</span>.<span class="fn">exit_norm</span>(h)</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Forward pass (N=8 steps):</span>
<span class="cs-line cmt">#   exit_norm applied N=8 times → PostNorm</span>
<span class="cs-line cmt">#   activation variance bounded at each step</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Backward pass (TBPTT K=5 steps):</span>
<span class="cs-line cmt">#   exit_norm gradient only K=5 times</span>
<span class="cs-line cmt">#   PreNorm identity path dominates → PreNorm</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Warmup deep credit assignment:</span>
<span class="cs-line"><span class="attr">K_init</span>  = <span class="num">2</span>   <span class="cmt"># early: last 2 steps only</span></span>
<span class="cs-line"><span class="attr">K_final</span> = <span class="num">5</span>   <span class="cmt"># later: last 5 steps</span></span>
<span class="cs-line cmt"># linearly warmed up during pretraining</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># RMSNorm: parameterless (no learnable γ)</span>
<span class="cs-line cmt"># RoPE: θ=10,000, context=4096</span>
<span class="cs-line cmt"># Sigmoid-gated self-attention</span>
      </pre>
    </div>

    <!-- panel: objective -->
    <div class="cs-panel" id="panel-objective">
      <pre class="cs-pre">
<span class="cs-line cmt"># Task-completion objective</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Standard causal LM:</span>
<span class="cs-line cmt">#   loss = -log P(x)  [all tokens]</span>
<span class="cs-line cmt">#   wastes compute predicting prompts</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># HRM-Text:</span>
<span class="cs-line hl-p"><span class="cmt">#   loss = -log P(x_a | x_q)</span></span>
<span class="cs-line hl-p"><span class="cmt">#   only response tokens contribute</span></span>
<span class="cs-line"> </span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">task_completion_loss</span>(logits, labels, mask):</span>
<span class="cs-line">    <span class="cmt"># mask = 1 for response tokens only</span></span>
<span class="cs-line hl-g">    loss = <span class="fn">cross_entropy</span>(logits, labels)</span>
<span class="cs-line hl-g">    <span class="kw">return</span> (loss * mask).<span class="fn">sum</span>() / mask.<span class="fn">sum</span>()</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># PrefixLM attention mask:</span>
<span class="cs-line"><span class="kw">def</span> <span class="fn">prefixlm_mask</span>(seq_len, prefix_len):</span>
<span class="cs-line">    mask = <span class="fn">causal_mask</span>(seq_len)   <span class="cmt"># default</span></span>
<span class="cs-line hl-c">    <span class="cmt"># instruction tokens attend bidirectionally</span></span>
<span class="cs-line hl-c">    mask[:prefix_len, :prefix_len] = <span class="num">True</span></span>
<span class="cs-line">    <span class="kw">return</span> mask</span>
<span class="cs-line"> </span>
<span class="cs-line cmt"># Condition tags prepended to instructions:</span>
<span class="cs-line cmt">#   [direct]  → answer-only format</span>
<span class="cs-line cmt">#   [cot]     → chain-of-thought</span>
<span class="cs-line cmt">#   [synth]   → synthetic style</span>
<span class="cs-line cmt">#   [noisy]   → web-crawl format</span>
      </pre>
    </div>


  ctx.scale(DPR, DPR);

  const PAD = { top: 30, right: 24, bottom: 50, left: 58 };
  const pw = W - PAD.left - PAD.right;
  const ph = H - PAD.top - PAD.bottom;

  // Models: [label, tokens_B, avg_score, color, textX, textY]
  const MODELS = [
    { label: 'HRM-Text 1B',  tokens: 0.04,  score: 71.5, color: 'var(--purple)', isStar: true },

  // Log scale: 40B (0.04T) to 40T → log10(0.04)=-1.4 to log10(40000)=4.6
  const logMin = Math.log10(0.03), logMax = Math.log10(50000);
  const scoreMin = 30, scoreMax = 80;

  function xPos(tokens) {
    return PAD.left + (Math.log10(tokens) - logMin) / (logMax - logMin) * pw;
  }
  function yPos(score) {
    return PAD.top + ph - (score - scoreMin) / (scoreMax - scoreMin) * ph;
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);

    // Grid lines
    const xTicks = [0.04, 1, 10, 100, 1000, 10000, 40000];
    const yTicks = [30, 40, 50, 60, 70, 80];

    ctx.strokeStyle = 'rgba(255,255,255,0.05)';
    ctx.lineWidth = 1;
    xTicks.forEach(t => {
      const x = xPos(t);
      ctx.beginPath(); ctx.moveTo(x, PAD.top); ctx.lineTo(x, PAD.top + ph); ctx.stroke();
    });
    yTicks.forEach(t => {
      const y = yPos(t);
      ctx.beginPath(); ctx.moveTo(PAD.left, y); ctx.lineTo(PAD.left + pw, y); ctx.stroke();
    });

    // Axes
    ctx.strokeStyle = 'rgba(255,255,255,0.2)';
    ctx.lineWidth = 1.2;
    ctx.beginPath(); ctx.moveTo(PAD.left, PAD.top); ctx.lineTo(PAD.left, PAD.top + ph + 6); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(PAD.left - 6, PAD.top + ph); ctx.lineTo(PAD.left + pw, PAD.top + ph); ctx.stroke();

    // X-axis labels
    ctx.fillStyle = 'rgba(255,255,255,0.3)';
    ctx.font = `${10}px var(--ff-mono)`;
    ctx.textAlign = 'center';
    [0.04, 1, 10, 100, 1000, 10000].forEach(t => {
      const x = xPos(t);
      const lbl = t < 1 ? '40B' : t < 1000 ? t + 'B' : (t/1000) + 'T';
      ctx.fillText(lbl, x, PAD.top + ph + 18);
    });
    ctx.fillStyle = 'rgba(255,255,255,0.3)';
    ctx.font = `${9}px var(--ff-mono)`;
    ctx.textAlign = 'center';
    ctx.fillText('Training tokens (log scale)', PAD.left + pw / 2, H - 6);

    // Y-axis labels
    ctx.textAlign = 'right';
    yTicks.forEach(t => {
      ctx.fillText(t + '%', PAD.left - 8, yPos(t) + 4);
    });
    ctx.save();
    ctx.translate(12, PAD.top + ph / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.textAlign = 'center';
    ctx.fillText('Avg score', 0, 0);
    ctx.restore();

    // Dots
    MODELS.forEach(m => {
      const x = xPos(m.tokens), y = yPos(m.score);
      const r = m.isStar ? 9 : 7;

      if (m.isStar) {
        // Glow ring
        ctx.beginPath();
        ctx.arc(x, y, r + 4, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(139,92,246,0.2)';
        ctx.fill();
      }

      ctx.beginPath();
      ctx.arc(x, y, r, 0, Math.PI * 2);
      ctx.fillStyle = m.isStar ? '#8b5cf6' : 'rgba(107,114,128,0.6)';
      ctx.fill();
      ctx.strokeStyle = m.isStar ? 'rgba(167,139,250,0.9)' : 'rgba(255,255,255,0.15)';
      ctx.lineWidth = m.isStar ? 2 : 1;
      ctx.stroke();

      // Labels
      ctx.font = `${m.isStar ? '600 ' : ''}${10}px var(--ff-mono)`;
      ctx.fillStyle = m.isStar ? '#c4b5fd' : 'rgba(255,255,255,0.45)';
      ctx.textAlign = m.isStar ? 'left' : 'left';
      const lx = x + r + 6, ly = y + 4;
      ctx.fillText(m.label, lx, ly);
    });
  }

  draw();

  // Tooltip
  canvas.addEventListener('mousemove', e => {
    const rect = canvas.getBoundingClientRect();
    const mx = e.clientX - rect.left, my = e.clientY - rect.top;
    let hit = null;
    MODELS.forEach(m => {
      const x = xPos(m.tokens), y = yPos(m.score);
      const dist = Math.hypot(mx - x, my - y);
      if (dist < 14) hit = m;
    });
    if (hit) {
      const tStr = hit.tokens < 1 ? '40B' : hit.tokens < 1000 ? hit.tokens + 'B' : (hit.tokens/1000) + 'T';
      tooltip.innerHTML = `${hit.label}<br/>tokens: ${tStr} · avg score: ${hit.score}%`;
      tooltip.style.display = 'block';
      tooltip.style.left = (e.clientX - canvas.getBoundingClientRect().left + 16) + 'px';
      tooltip.style.top = (e.clientY - canvas.getBoundingClientRect().top - 12) + 'px';
      canvas.style.cursor = 'crosshair';
    } else {
      tooltip.style.display = 'none';
      canvas.style.cursor = 'default';
    }
  });
  canvas.addEventListener('mouseleave', () => { tooltip.style.display = 'none'; });
})();

// ─── MagicNorm canvas ───────────────────────────────────────────────────────
(function() {
  const canvas = document.getElementById('norm-canvas');
  if (!canvas) return;
  const DPR = window.devicePixelRatio || 1;
  const W = canvas.clientWidth, H = 220;
  canvas.width = W * DPR; canvas.height = H * DPR;
  const ctx = canvas.getContext('2d');
  ctx.scale(DPR, DPR);

  const NORM_DATA = {
    postnorm: {
      fwdLabel: 'Forward variance',
      fwdColor: 'var(--green)',
      fwdValues: [1.0, 0.85, 0.72, 0.61, 0.52, 0.43, 0.38, 0.33],
      bwdLabel: 'Gradient norm',
      bwdColor: 'var(--red, #ef4444)',
      bwdValues: [1.0, 0.72, 0.51, 0.35, 0.24, 0.16, 0.10, 0.06],
      desc: '<strong>PostNorm</strong>: normalization outside the residual branch. Forward variance decreases each step (stable activations ✓). But gradients vanish rapidly through the backward pass — deeper steps receive near-zero gradient. This compounds catastrophically over N=8 recurrent steps.',
    },
    prenorm: {
      fwdLabel: 'Forward variance',
      fwdColor: 'var(--amber)',
      fwdValues: [1.0, 1.42, 1.91, 2.50, 3.18, 3.97, 4.85, 5.82],
      bwdLabel: 'Gradient norm',
      bwdColor: 'var(--cyan)',
      bwdValues: [1.0, 0.96, 0.93, 0.91, 0.88, 0.86, 0.84, 0.82],
      desc: '<strong>PreNorm</strong>: normalization inside the residual branch. Gradients flow cleanly (stable optimization ✓). But the unnormalized residual accumulation causes forward variance to grow without bound — leading to representation collapse or reduced model expressivity in deep recurrent settings.',
    },
    magic: {
      fwdLabel: 'Forward variance (exit norm)',
      fwdColor: 'var(--green)',
      fwdValues: [1.0, 0.97, 0.95, 0.94, 0.93, 0.92, 0.91, 0.90],
      bwdLabel: 'Gradient norm (K=5 TBPTT)',
      bwdColor: 'var(--cyan)',
      bwdValues: [1.0, 0.95, 0.90, 0.86, 0.83, 0.80, 0.78, 0.76],
      desc: '<strong>MagicNorm</strong>: PreNorm inside + PostNorm exit cap. The exit norm bounds forward variance at each of the N=8 recurrent steps (PostNorm behavior). With truncated backprop (K=5 &lt; N=8), gradients only pass through K exit norms — the PreNorm identity connections dominate. Best of both worlds: stable forward pass and stable backward pass.',
    },
  };

  let activeNorm = 'postnorm';

  function drawNormViz(normKey) {
    const d = NORM_DATA[normKey];
    ctx.clearRect(0, 0, W, H);

    const PAD = { top: 22, right: 20, bottom: 40, left: 52 };
    const pw = W - PAD.left - PAD.right;
    const ph = H - PAD.top - PAD.bottom;
    const N = 8;
    const maxVal = Math.max(...d.fwdValues, ...d.bwdValues) * 1.08;
    const minVal = 0;

    function xp(i) { return PAD.left + (i / (N - 1)) * pw; }
    function yp(v) { return PAD.top + ph - ((v - minVal) / (maxVal - minVal)) * ph; }

    // Grid
    ctx.strokeStyle = 'rgba(255,255,255,0.05)';
    ctx.lineWidth = 1;
    [0, 0.25, 0.5, 0.75, 1.0].forEach(f => {
      const y = PAD.top + ph * (1 - f);
      ctx.beginPath(); ctx.moveTo(PAD.left, y); ctx.lineTo(PAD.left + pw, y); ctx.stroke();
    });

    // Axes
    ctx.strokeStyle = 'rgba(255,255,255,0.2)';
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(PAD.left, PAD.top); ctx.lineTo(PAD.left, PAD.top + ph + 4); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(PAD.left - 4, PAD.top + ph); ctx.lineTo(PAD.left + pw, PAD.top + ph); ctx.stroke();

    // X-axis labels
    ctx.fillStyle = 'rgba(255,255,255,0.3)';
    ctx.font = `10px var(--ff-mono)`;
    ctx.textAlign = 'center';
    for (let i = 0; i < N; i++) {
      ctx.fillText('step ' + (i + 1), xp(i), PAD.top + ph + 18);
    }

    // Draw lines
    function drawLine(vals, color, label) {
      ctx.beginPath();
      ctx.strokeStyle = color;
      ctx.lineWidth = 2;
      vals.forEach((v, i) => {
        if (i === 0) ctx.moveTo(xp(i), yp(v));
        else ctx.lineTo(xp(i), yp(v));
      });
      ctx.stroke();
      // dots
      vals.forEach((v, i) => {
        ctx.beginPath();
        ctx.arc(xp(i), yp(v), 3.5, 0, Math.PI * 2);
        ctx.fillStyle = color;
        ctx.fill();
      });
      // label
      const lastX = xp(N - 1) + 6, lastY = yp(vals[N - 1]);
      ctx.fillStyle = color;
      ctx.font = `600 9px var(--ff-mono)`;
      ctx.textAlign = 'left';
      ctx.fillText(label, PAD.left + 8, PAD.top + (label === d.fwdLabel ? 12 : 20));
    }

    drawLine(d.fwdValues, d.fwdColor, d.fwdLabel);
    drawLine(d.bwdValues, d.bwdColor, d.bwdLabel);

    // Ideal zone indicator for MagicNorm
    if (normKey === 'magic') {
      ctx.fillStyle = 'rgba(139,92,246,0.06)';
      ctx.fillRect(PAD.left + 1, PAD.top, pw - 1, ph);
    }

    // Update description
    const desc = document.getElementById('norm-desc');
    if (desc) desc.innerHTML = d.desc;
  }

  drawNormViz(activeNorm);

  document.querySelectorAll('.norm-tab').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.norm-tab').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeNorm = btn.dataset.norm;
      drawNormViz(activeNorm);
    });
  });
})();

// ─── Attention map canvases ─────────────────────────────────────────────────
(function() {
  // Example: "What is the capital of France?" = 6 tokens, "Paris" = 1 token
  // Simplified: 5 instruction tokens (amber) + 1 response token (white)
  const N_INSTR = 5, N_RESP = 1, N = N_INSTR + N_RESP;

  function drawAttnMap(canvasId, isCausal) {
    const canvas = document.getElementById(canvasId);
    if (!canvas) return;
    const DPR = window.devicePixelRatio || 1;
    const W = canvas.clientWidth, H = 180;
    canvas.width = W * DPR; canvas.height = H * DPR;
    const ctx = canvas.getContext('2d');
    ctx.scale(DPR, DPR);

    const PAD = 20;
    const cellSize = Math.min((W - PAD * 2) / N, (H - PAD * 2) / N);
    const startX = PAD + (W - PAD * 2 - cellSize * N) / 2;
    const startY = PAD + (H - PAD * 2 - cellSize * N) / 2;

    // Background
    ctx.fillStyle = 'var(--card2, #141414)';
    ctx.fillRect(0, 0, W, H);

    for (let row = 0; row < N; row++) {
      for (let col = 0; col < N; col++) {
        let attn = 0;
        const isInstrRow = row < N_INSTR;
        const isInstrCol = col < N_INSTR;
        const isRespRow = row >= N_INSTR;

        if (isCausal) {
          // Causal: lower triangle
          attn = col <= row ? 1.0 / (row + 1) : 0;
        } else {
          // PrefixLM: instruction rows attend to all instruction tokens fully
          if (isInstrRow && isInstrCol) {
            attn = 1.0 / N_INSTR;
          } else if (isInstrRow && !isInstrCol) {
            attn = 0; // instruction doesn't attend to response
          } else if (isRespRow) {
            // response: causal
            attn = col <= row ? 1.0 / (row + 1) : 0;
          }
        }

        const rowIsInstr = row < N_INSTR;
        const colIsInstr = col < N_INSTR;

        if (attn > 0) {
          const alpha = 0.15 + attn * 0.75;
          // Color by query (row) type
          if (rowIsInstr) {
            ctx.fillStyle = `rgba(245,158,11,${alpha})`; // amber for instruction query
          } else {
            ctx.fillStyle = `rgba(255,255,255,${alpha})`; // white for response query
          }
        } else {
          ctx.fillStyle = 'rgba(255,255,255,0.02)';
        }

        const cx = startX + col * cellSize + 1;
        const cy = startY + row * cellSize + 1;
        const cs = cellSize - 2;
        ctx.fillRect(cx, cy, cs, cs);
      }
    }

    // Draw divider between instruction and response
    const divX = startX + N_INSTR * cellSize;
    const divY = startY + N_INSTR * cellSize;
    ctx.strokeStyle = 'rgba(255,255,255,0.15)';
    ctx.lineWidth = 1;
    ctx.setLineDash([3, 3]);
    ctx.beginPath(); ctx.moveTo(divX, startY); ctx.lineTo(divX, startY + N * cellSize); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(startX, divY); ctx.lineTo(startX + N * cellSize, divY); ctx.stroke();
    ctx.setLineDash([]);

    // Labels
    ctx.fillStyle = 'rgba(245,158,11,0.7)';
    ctx.font = `9px var(--ff-mono)`;
    ctx.textAlign = 'center';
    ctx.fillText('instruction (5 tokens)', startX + N_INSTR * cellSize / 2, startY - 6);
    ctx.fillStyle = 'rgba(255,255,255,0.5)';
    ctx.fillText('resp', startX + N_INSTR * cellSize + cellSize / 2, startY - 6);
  }

  drawAttnMap('attn-causal', true);
  drawAttnMap('attn-prefix', false);
})();

// ─── Step navigator ─────────────────────────────────────────────────────────
(function() {
  let step = 0;
  const boxes   = document.querySelectorAll('#step-list .step-box');
  const prevBtn = document.getElementById('step-prev');
  const nextBtn = document.getElementById('step-next');
  const progEl  = document.getElementById('step-prog');

  function updateSteps() {
    boxes.forEach((b, i) => {
      b.classList.remove('active', 'done');
      if (i === step) b.classList.add('active');
      else if (i < step) b.classList.add('done');
    });
    if (prevBtn) prevBtn.disabled = step === 0;
    if (nextBtn) nextBtn.disabled = step === boxes.length - 1;
    if (progEl) progEl.textContent = `Step ${step + 1} of ${boxes.length}`;
    boxes.forEach((b, i) => {
      const n = b.querySelector('.step-num');
      if (n) n.textContent = i < step ? '✓' : String(i + 1);
    });
  }

  prevBtn?.addEventListener('click', () => { if (step > 0) { step--; updateSteps(); } });
  nextBtn?.addEventListener('click', () => { if (step < boxes.length - 1) { step++; updateSteps(); } });
  updateSteps();
})();

// ─── Animated bar chart ─────────────────────────────────────────────────────
const resultsSection = document.getElementById('s-results');
if (resultsSection) {
  new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        document.querySelectorAll('.bar-fill[data-w]').forEach(b => {
          b.style.width = (parseFloat(b.dataset.w) / 100 * 100) + '%';
        });
      }
    });
  }, { threshold: 0.2 }).observe(resultsSection);
}
</script>

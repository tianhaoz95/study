                const targetViz = document.getElementById(`viz-${paperId}`);
                if (targetViz) targetViz.classList.add('active');
              }
            } else {
              // Custom preset paper (paper-6 and beyond) -> Fallback to generic viz
              const targetViz = document.getElementById('viz-generic');

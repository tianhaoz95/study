  document.addEventListener('DOMContentLoaded', () => {
    const customDateInput = document.getElementById('digest-custom-date') as HTMLInputElement;
    const presetChips = document.querySelectorAll('.digest-controls .chip');
    const loadingEl = document.getElementById('digest-loading');
    
    // Pagination nodes
    const prevPageBtn = document.getElementById('prev-page-btn');
    const nextPageBtn = document.getElementById('next-page-btn');

    // State Variables
    let currentPapers = PRESET_PAPERS["2026-07-01"];
    let currentPage = 1;
    const papersPerPage = 3;
    let activePresetDate = "2026-07-01";
    let isPresetMode = true;
    let activePaper: any = null;

    // Canvas Force Topology elements
    const genericViz = document.getElementById('viz-generic');
    const genericCanvas = document.getElementById('generic-topology-canvas') as HTMLCanvasElement;
    let genericAnimationId: number | null = null;

    // Topology configuration
    interface TopologyNode {
      x: number;
      y: number;
      vx: number;
      vy: number;
      radius: number;
      labelEn: string;
      labelZh: string;
      color: string;
      excited: number;
      isCenter?: boolean;
    }
    let topologyNodes: TopologyNode[] = [];

    // Helper to initialize generic canvas nodes
    function initTopologyNodes(paper: any) {
      topologyNodes = [];
      if (!paper) return;

      const keywords = paper.keywords ?? paper.ai_keywords ?? ["ML Model", "Evaluation"];

      // Central node (the paper itself)
      topologyNodes.push({
        x: 150,
        y: 85,
        vx: 0,
        vy: 0,
        radius: 12,
        labelEn: paper.arxivId ? `arXiv:${paper.arxivId}` : "Selected Paper",
        labelZh: paper.arxivId ? `arXiv:${paper.arxivId}` : "所选论文",
        color: "var(--purple-l)",
        excited: 0.5,
        isCenter: true
      });

      // Satellite nodes (keywords)
      const radius = 55;
      keywords.forEach((kw: string, index: number) => {
        const angle = (index * 2 * Math.PI) / keywords.length;
        const x = 150 + Math.cos(angle) * radius;
        const y = 85 + Math.sin(angle) * radius;
        
        topologyNodes.push({
          x: x,
          y: y,
          vx: (Math.random() - 0.5) * 0.1,
          vy: (Math.random() - 0.5) * 0.1,
          radius: 5.5,
          labelEn: kw,
          labelZh: kw,
          color: index % 2 === 0 ? "var(--cyan-l)" : "var(--green)",
          excited: 0,
          isCenter: false
        });
      });
    }

    // Thematic visualizer frame counters and state
    let specFrame = 0;
    let diffFrame = 0;
    let cacheFrame = 0;
    const cacheBlocks = Array.from({ length: 24 }, (_, i) => ({
      x: 35 + (i % 6) * 40,
      y: 40 + Math.floor(i / 6) * 25,
      weight: Math.random()
    }));

    // Speculative Decoding timeline visualizer
    function drawSpeculativeDecoding(ctx: CanvasRenderingContext2D, isZh: boolean) {
      specFrame = (specFrame + 1) % 180;
      
      // Draw headers
      ctx.fillStyle = "rgba(255,255,255,0.7)";
      ctx.font = "bold 9px monospace";
      ctx.fillText(isZh ? "草稿模型预测 (Draft model)" : "Draft Model Prediction", 20, 25);
      ctx.fillText(isZh ? "验证模型检验 (Target model)" : "Target Model Verification", 20, 95);

      // Draw Draft line and Target line
      ctx.strokeStyle = "rgba(255,255,255,0.06)";
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(20, 48); ctx.lineTo(280, 48);
      ctx.moveTo(20, 118); ctx.lineTo(280, 118);
      ctx.stroke();

      const tokens = [
        { x: 50, spec: 1 },
        { x: 100, spec: 2 },
        { x: 150, spec: 3 },
        { x: 200, spec: 4 }
      ];

      tokens.forEach((t, index) => {
        const spawnTime = index * 25;
        if (specFrame > spawnTime) {
          // Render draft tokens
          ctx.beginPath();
          ctx.arc(t.x, 48, 10, 0, Math.PI * 2);
          ctx.fillStyle = "rgba(6, 182, 212, 0.15)";
          ctx.strokeStyle = "var(--cyan)";
          ctx.lineWidth = 1.2;
          ctx.fill();
          ctx.stroke();

          ctx.fillStyle = "var(--cyan-l)";
          ctx.font = "7.5px monospace";
          ctx.textAlign = "center";
          ctx.fillText(`T${index + 1}`, t.x, 51);

          // Verification flow
          if (specFrame > 110) {
            const verifyProgress = Math.min(1, (specFrame - 110) / 20);
            const verifiedY = 48 + (118 - 48) * verifyProgress;

            ctx.beginPath();
            ctx.arc(t.x, verifiedY, 10, 0, Math.PI * 2);

            const isAccepted = index < 3; // Let's say T4 gets rejected
            if (isAccepted) {
              ctx.fillStyle = "rgba(16, 185, 129, 0.2)";
              ctx.strokeStyle = "rgb(16, 185, 129)";
            } else {
              ctx.fillStyle = "rgba(239, 68, 68, 0.2)";
              ctx.strokeStyle = "rgb(239, 68, 68)";
            }
            ctx.fill();
            ctx.stroke();

            if (specFrame > 130) {
              ctx.fillStyle = isAccepted ? "rgb(16, 185, 129)" : "rgb(239, 68, 68)";
              ctx.fillText(isAccepted ? "✓" : "✗", t.x, verifiedY + 3);
            }
          }
        }
      });

      // Bottom info
      ctx.textAlign = "left";
      ctx.fillStyle = "var(--muted)";
      ctx.font = "7.5px monospace";
      if (specFrame < 110) {
        ctx.fillText(isZh ? "草稿模型正在高速生成候选 Token..." : "Draft model generating tokens in parallel...", 20, 150);
      } else if (specFrame < 130) {
        ctx.fillText(isZh ? "验证模型并行检验中..." : "Target model validating candidates...", 20, 150);
      } else {
        ctx.fillText(isZh ? "T1-T3 接受并写入，T4 拒绝，触发回滚修正" : "T1-T3 accepted, T4 rejected. Backtracking...", 20, 150);
      }
    }

    // Denoising Diffusion visualizer
    function drawDenoisingDiffusion(ctx: CanvasRenderingContext2D, isZh: boolean) {
      diffFrame = (diffFrame + 1) % 200;
      
      const x = 70, y = 30, w = 160, h = 95;
      ctx.strokeStyle = "var(--border)";
      ctx.strokeRect(x, y, w, h);

      ctx.fillStyle = "rgba(255,255,255,0.7)";
      ctx.font = "bold 9px monospace";
      ctx.fillText(isZh ? "降噪扩散进程 (Denoising Process)" : "Denoising Diffusion Process", 20, 20);
      
      const step = diffFrame / 200; // 0 to 1
      
      ctx.save();
      ctx.beginPath();
      ctx.rect(x + 1, y + 1, w - 2, h - 2);
      ctx.clip();

      // Draw structural content shape (e.g. a glowing neural star)
      if (step > 0.25) {
        const radius = 30 * Math.min(1, (step - 0.25) / 0.75);
        ctx.beginPath();
        ctx.arc(x + w / 2, y + h / 2, radius, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(139, 92, 246, ${Math.min(0.5, (step - 0.25) / 0.75)})`;
        ctx.shadowBlur = 15;
        ctx.shadowColor = "var(--purple)";
        ctx.fill();
        ctx.shadowBlur = 0;

        // Draw inner star connection lines
        ctx.strokeStyle = `rgba(6, 182, 212, ${Math.min(0.4, (step - 0.2) / 0.8)})`;
        ctx.lineWidth = 1;
        ctx.beginPath();
        for (let i = 0; i < 6; i++) {
          const angle = (i * 2 * Math.PI) / 6 + (Date.now() / 12000);
          ctx.moveTo(x + w / 2, y + h / 2);
          ctx.lineTo(x + w / 2 + Math.cos(angle) * radius, y + h / 2 + Math.sin(angle) * radius);
        }
        ctx.stroke();
      }

      // Render static noise overlay that fades out
      const noiseOpacity = Math.max(0, 1 - step * 1.35);
      if (noiseOpacity > 0.02) {
        const numPixels = Math.floor(noiseOpacity * 400);
        for (let i = 0; i < numPixels; i++) {
          const px = x + Math.random() * w;
          const py = y + Math.random() * h;
          const brightness = Math.floor(Math.random() * 255);
          ctx.fillStyle = `rgba(${brightness}, ${brightness}, ${brightness}, ${noiseOpacity * 0.75})`;
          ctx.fillRect(px, py, 1.5, 1.5);
        }
      }

      // Add a scan line
      ctx.strokeStyle = "rgba(6, 182, 212, 0.12)";
      ctx.lineWidth = 1;
      const scanY = y + (diffFrame % 100) * (h / 100);
      ctx.beginPath();
      ctx.moveTo(x, scanY); ctx.lineTo(x + w, scanY);
      ctx.stroke();

      ctx.restore();

      // Progress bar
      ctx.fillStyle = "var(--muted)";
      ctx.font = "7.5px monospace";
      ctx.fillText(`T = ${(1 - step).toFixed(2)} (Noise)`, 20, 148);
      
      ctx.fillStyle = "var(--border)";
      ctx.fillRect(100, 143, 100, 5);
      ctx.fillStyle = "var(--cyan)";
      ctx.fillRect(100, 143, 100 * step, 5);
    }

    // KV Cache Budget visualizer
    function drawKVCachePruning(ctx: CanvasRenderingContext2D, isZh: boolean) {
      cacheFrame = (cacheFrame + 1) % 180;
      
      ctx.fillStyle = "rgba(255,255,255,0.7)";
      ctx.font = "bold 9px monospace";
      ctx.fillText(isZh ? "自适应 KV 缓存压缩 (KV Cache Pruning)" : "KV Cache Budget Allocation", 20, 25);

      cacheBlocks.forEach((block, index) => {
        let color = "rgba(6, 182, 212, 0.05)";
        let border = "var(--border)";
        let text = (block.weight * 10).toFixed(0);

        const isPruned = block.weight < 0.45;
        
        if (cacheFrame > 60) {
          if (isPruned) {
            if (cacheFrame < 100) {
              color = "rgba(239, 68, 68, 0.15)";
              border = "rgb(239, 68, 68)";
            } else {
              const opacity = Math.max(0, 1 - (cacheFrame - 100) / 40);
              color = `rgba(239, 68, 68, ${opacity * 0.03})`;
              border = `rgba(239, 68, 68, ${opacity * 0.15})`;
              text = "";
            }
          } else {
            color = "rgba(16, 185, 129, 0.15)";
            border = "rgb(16, 185, 129)";
          }
        }

        ctx.fillStyle = color;
        ctx.strokeStyle = border;
        ctx.lineWidth = 1;
        ctx.fillRect(block.x, block.y, 25, 18);
        ctx.strokeRect(block.x, block.y, 25, 18);

        if (text) {
          ctx.fillStyle = border;
          ctx.font = "6.5px monospace";
          ctx.textAlign = "center";
          ctx.fillText(text, block.x + 12.5, block.y + 11);
        }
      });

      ctx.textAlign = "left";
      ctx.fillStyle = "var(--muted)";
      ctx.font = "7.5px monospace";
      if (cacheFrame < 60) {
        ctx.fillText(isZh ? "计算注意力分数..." : "Evaluating attention weights...", 20, 150);
      } else if (cacheFrame < 100) {
        ctx.fillText(isZh ? "标记低权重 Key-Value 缓存对..." : "Highlighting low-attention tokens...", 20, 150);
      } else {
        ctx.fillText(isZh ? "已剪裁无用缓存，释放显存并保持准确率" : "Pruned low-budget caches, compression complete.", 20, 150);
      }
    }

    // World Model state transition visualizer
    let wmFrame = 0;
    function drawWorldModelTransition(ctx: CanvasRenderingContext2D, isZh: boolean) {
      wmFrame = (wmFrame + 1) % 180;
      
      // Title
      ctx.fillStyle = "rgba(255,255,255,0.7)";
      ctx.font = "bold 9px monospace";
      ctx.fillText(isZh ? "世界模型状态迁移 (State Transition)" : "World Model Latent Transition", 20, 25);

      // Draw State s_t box
      ctx.strokeStyle = "rgba(255,255,255,0.08)";
      ctx.strokeRect(20, 48, 60, 50);
      ctx.fillStyle = "rgba(255,255,255,0.01)";
      ctx.fillRect(20, 48, 60, 50);
      ctx.fillStyle = "rgba(255,255,255,0.4)";
      ctx.font = "7px monospace";
      ctx.textAlign = "left";
      ctx.fillText("State s_t", 24, 43);

      // Draw robot arm in s_t
      ctx.strokeStyle = "var(--cyan)";
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(35, 93); ctx.lineTo(35, 73); ctx.lineTo(45, 63);
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(45, 63, 2.5, 0, Math.PI * 2);
      ctx.fillStyle = "var(--cyan)";
      ctx.fill();

      // Action arrow
      ctx.strokeStyle = "var(--green)";
      ctx.lineWidth = 1.2;
      ctx.beginPath();
      ctx.moveTo(30, 112); ctx.lineTo(70, 112);
      ctx.lineTo(65, 108); ctx.moveTo(70, 112); ctx.lineTo(65, 116);
      ctx.stroke();
      ctx.fillStyle = "var(--green)";
      ctx.font = "7px monospace";
      ctx.fillText(isZh ? "动作 a_t (向右)" : "Action a_t (Right)", 28, 126);

      // Latent space sphere
      const spherePulse = 16 + Math.sin(wmFrame * 0.1) * 1.5;
      ctx.beginPath();
      ctx.arc(150, 73, spherePulse, 0, Math.PI * 2);
      const sphereGrad = ctx.createRadialGradient(150, 73, 2, 150, 73, spherePulse);
      sphereGrad.addColorStop(0, "white");
      sphereGrad.addColorStop(0.3, "var(--purple-l)");
      sphereGrad.addColorStop(1, "rgba(139, 92, 246, 0)");
      ctx.fillStyle = sphereGrad;
      ctx.fill();
      
      ctx.fillStyle = "var(--purple-l)";
      ctx.font = "7.5px monospace";
      ctx.textAlign = "center";
      ctx.fillText("Latent Space", 150, 102);

      // Draw Predicted state s_t+1 box
      ctx.strokeStyle = "rgba(255,255,255,0.08)";
      ctx.strokeRect(220, 48, 60, 50);
      ctx.fillStyle = "rgba(255,255,255,0.01)";
      ctx.fillRect(220, 48, 60, 50);
      ctx.fillStyle = "rgba(255,255,255,0.4)";
      ctx.font = "7px monospace";
      ctx.textAlign = "left";
      ctx.fillText("Predicted s_t+1", 220, 43);

      // Animation flow
      if (wmFrame < 60) {
        const flowProg = wmFrame / 60;
        // flow from s_t to latent
        ctx.beginPath();
        ctx.arc(50 + (150 - 50) * flowProg, 73, 2.5, 0, Math.PI * 2);
        ctx.fillStyle = "var(--cyan)";
        ctx.fill();

        // flow from action to latent
        ctx.beginPath();
        ctx.arc(50 + (150 - 50) * flowProg, 112 + (73 - 112) * flowProg, 2.5, 0, Math.PI * 2);
        ctx.fillStyle = "var(--green)";
        ctx.fill();
      }

      if (wmFrame > 80) {
        const opacity = Math.min(1, (wmFrame - 80) / 40);
        ctx.strokeStyle = `rgba(16, 185, 129, ${opacity})`;
        ctx.lineWidth = 2;
        ctx.beginPath();
        // Robot arm shifted right
        ctx.moveTo(235, 93); ctx.lineTo(245, 78); ctx.lineTo(265, 73);
        ctx.stroke();
        ctx.beginPath();
        ctx.arc(265, 73, 2.5, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(16, 185, 129, ${opacity})`;
        ctx.fill();
      }

      // Description
      ctx.textAlign = "left";
      ctx.fillStyle = "var(--muted)";
      ctx.font = "7.5px monospace";
      if (wmFrame < 60) {
        ctx.fillText(isZh ? "输入状态 s_t 与动作 a_t 编码到潜空间..." : "Encoding state and action into latent representation...", 20, 150);
      } else if (wmFrame < 90) {
        ctx.fillText(isZh ? "潜空间推演下一状态中..." : "Transitioning state in latent space...", 20, 150);
      } else {
        ctx.fillText(isZh ? "成功预测下一状态，指导机器人运动规划" : "State transition predicted. Directing motor actions...", 20, 150);
      }
    }

    // Autoregressive generation visualizer
    let arFrame = 0;
    const arWords = ["The", "world", "is", "in", "your", "mind"];
    function drawAutoregressiveGeneration(ctx: CanvasRenderingContext2D, isZh: boolean) {
      arFrame = (arFrame + 1) % 180;
      
      // Title
      ctx.fillStyle = "rgba(255,255,255,0.7)";
      ctx.font = "bold 9px monospace";
      ctx.fillText(isZh ? "自回归生成与注意力 (Autoregressive Attention)" : "Autoregressive Causal Attention", 20, 25);

      const wordStep = Math.floor(arFrame / 30); // 0 to 5
      const phase = (arFrame % 30) / 30; // 0 to 1

      const startX = 35;
      const spacing = 43;

      for (let i = 0; i <= Math.min(wordStep, 5); i++) {
        const isCurrent = i === wordStep;
        const xPos = startX + i * spacing;
        
        ctx.save();
        if (isCurrent) {
          ctx.globalAlpha = phase;
        }

        ctx.fillStyle = isCurrent ? "var(--purple-l)" : "rgba(255, 255, 255, 0.7)";
        ctx.font = "bold 9.5px monospace";
        ctx.textAlign = "center";
        ctx.fillText(arWords[i], xPos, 90);
        ctx.restore();

        // Draw attention links
        if (isCurrent && i > 0) {
          for (let j = 0; j < i; j++) {
            const prevX = startX + j * spacing;
            
            // Curve links representing self-attention
            ctx.beginPath();
            ctx.moveTo(xPos, 78);
            ctx.quadraticCurveTo((xPos + prevX) / 2, 40, prevX, 78);
            
            const attn = 0.8 / (i - j); // closer words get stronger weight
            ctx.strokeStyle = `rgba(6, 182, 212, ${attn * phase * 0.75})`;
            ctx.lineWidth = 1 + attn * 1.5;
            ctx.stroke();

            // Attn particles
            const px = xPos + (prevX - xPos) * (1 - phase);
            const py = 78 + (40 - 78) * 2 * (1 - phase) * phase;
            ctx.beginPath();
            ctx.arc(px, py, 1.5, 0, Math.PI * 2);
            ctx.fillStyle = "var(--cyan)";
            ctx.fill();
          }
        }
      }

      ctx.textAlign = "left";
      ctx.fillStyle = "var(--muted)";
      ctx.font = "7.5px monospace";
      if (wordStep < 5) {
        ctx.fillText(isZh ? `自回归预测下一 Token: "${arWords[wordStep]}"` : `Predicting next token: "${arWords[wordStep]}"...`, 20, 150);
      } else {
        ctx.fillText(isZh ? "生成完成。自左向右单向因果注意力机制" : "Generation finished. Causal attention loop.", 20, 150);
      }
    }

    // Force Directed Topology visualizer
    function drawForceDirectedTopology(ctx: CanvasRenderingContext2D, isZh: boolean) {
      // Draw connections from satellites to the center
      const centerNode = topologyNodes.find((n: any) => n.isCenter);
      if (centerNode) {
        topologyNodes.forEach((node: any) => {
          if (node !== centerNode) {
            const dx = node.x - centerNode.x;
            const dy = node.y - centerNode.y;
            const dist = Math.sqrt(dx * dx + dy * dy);
            
            ctx.beginPath();
            ctx.moveTo(node.x, node.y);
            ctx.lineTo(centerNode.x, centerNode.y);
            ctx.strokeStyle = `rgba(139, 92, 246, ${Math.max(0.1, 0.4 - dist / 300)})`;
            ctx.lineWidth = node.excited > 0 ? 2 : 1;
            ctx.stroke();

            // Spawn tiny animated particles moving along the link
            const time = Date.now() / 1500;
            const progress = (time + (topologyNodes.indexOf(node) * 0.25)) % 1.0;
            const px = node.x + (centerNode.x - node.x) * progress;
            const py = node.y + (centerNode.y - node.y) * progress;

            ctx.beginPath();
            ctx.arc(px, py, 2, 0, Math.PI * 2);
            ctx.fillStyle = node.color;
            ctx.fill();
          }
        });
      }

      // Draw nodes
      topologyNodes.forEach((node: any) => {
        if (!node.isCenter) {
          // Spring physics pulling satellite towards ideal orbit
          const index = topologyNodes.indexOf(node) - 1;
          const totalSatellites = topologyNodes.length - 1;
          const angle = (index * 2 * Math.PI) / totalSatellites + (Date.now() / 25000);
          const targetX = 150 + Math.cos(angle) * 55;
          const targetY = 85 + Math.sin(angle) * 55;

          node.vx += (targetX - node.x) * 0.015;
          node.vy += (targetY - node.y) * 0.015;
          node.vx *= 0.85;
          node.vy *= 0.85;

          node.x += node.vx;
          node.y += node.vy;
        }

        // Excited decay
        if (node.excited > 0) node.excited -= 0.05;

        // Node circle
        ctx.beginPath();
        ctx.arc(node.x, node.y, node.radius + (node.excited * 4), 0, Math.PI * 2);
        ctx.fillStyle = node.excited > 0 ? "white" : node.color;
        ctx.fill();

        if (node.excited > 0) {
          ctx.shadowBlur = 10;
          ctx.shadowColor = "var(--purple)";
        }

        // Node Text (shortened for space if needed)
        ctx.fillStyle = node.excited > 0 ? "var(--purple-l)" : "rgba(255, 255, 255, 0.4)";
        ctx.font = "7.5px monospace";
        
        const text = isZh ? node.labelZh : node.labelEn;
        const displayTxt = text.length > 22 ? text.substring(0, 20) + "..." : text;
        
        if (node.isCenter) {
          ctx.textAlign = "center";
          ctx.fillText(displayTxt, node.x, node.y - 16);
        } else {
          ctx.textAlign = node.x > 150 ? "left" : "right";
          ctx.fillText(displayTxt, node.x > 150 ? node.x + 8 : node.x - 8, node.y + 3);
        }
        
        ctx.shadowBlur = 0;
      });
    }

    // Force Directed Topology animation loop
    function startTopologyAnimation() {
      if (!genericCanvas) return;
      const ctx = genericCanvas.getContext('2d')!;
      
      if (genericAnimationId) {
        cancelAnimationFrame(genericAnimationId);
      }

      function draw() {
        ctx.clearRect(0, 0, genericCanvas.width, genericCanvas.height);
        const isZh = document.documentElement.getAttribute('lang') === 'zh-CN';

        // Check active paper keywords to determine thematic visualizer
        const kws = activePaper?.keywords ?? activePaper?.ai_keywords ?? [];
        const kwsLower = kws.map((k: string) => k.toLowerCase());
        const hasKeyword = (terms: string[]) => terms.some(t => kwsLower.some(k => k.includes(t)));

        if (hasKeyword(["speculative", "decoding", "draft model", "inference", "parallel"])) {
          drawSpeculativeDecoding(ctx, isZh);
        } else if (hasKeyword(["diffusion", "synthesis", "edit", "render", "3d", "image", "video"])) {
          drawDenoisingDiffusion(ctx, isZh);
        } else if (hasKeyword(["cache", "kv", "prun", "compress"])) {
          drawKVCachePruning(ctx, isZh);
        } else if (hasKeyword(["world model", "latent", "next-state", "embodied", "agent", "robot", "vla"])) {
          drawWorldModelTransition(ctx, isZh);
        } else if (hasKeyword(["autoregressive", "attention", "llm", "token", "generation", "alignment", "post-training"])) {
          drawAutoregressiveGeneration(ctx, isZh);
        } else {
          drawForceDirectedTopology(ctx, isZh);
        }

        genericAnimationId = requestAnimationFrame(draw);
      }

      draw();
    }

    // Trigger excitement on canvas click
    if (genericCanvas) {
      genericCanvas.addEventListener('click', (e) => {
        const rect = genericCanvas.getBoundingClientRect();
        const scaleX = genericCanvas.width / rect.width;
        const scaleY = genericCanvas.height / rect.height;
        const clickX = (e.clientX - rect.left) * scaleX;
        const clickY = (e.clientY - rect.top) * scaleY;

        let closest: any = null;
        let minDist = 30;

        topologyNodes.forEach(n => {
          const dx = n.x - clickX;
          const dy = n.y - clickY;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < minDist) {
            minDist = dist;
            closest = n;
          }
        });

        if (closest) {
          closest.excited = 1.0;
          if (!closest.isCenter) {
            closest.vx += (Math.random() - 0.5) * 2;
            closest.vy += (Math.random() - 0.5) * 2;
          }
        }
      });
    }


                  const viz = document.getElementById('viz-paper-5');
                  if (viz) {
                    viz.classList.add('active');
                    const q = viz.querySelector('.edit-command-input span.lang-en');
                    const qzh = viz.querySelector('.edit-command-input span.lang-zh');
                    if (q) q.textContent = 'Instruction: "LiveEdit: streaming crop & shift target"';
                    if (qzh) qzh.textContent = '编辑指令：“LiveEdit: 实时裁剪并移动物体”';

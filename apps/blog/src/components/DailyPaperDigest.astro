    // Render paginated page
    function renderPage() {
      const papersTarget = document.getElementById('papers-content-target');
      if (!papersTarget) return;

      // Sort current papers by upvote count descending
      currentPapers.sort((a: any, b: any) => (b.upvotes ?? 0) - (a.upvotes ?? 0));

      const totalPages = Math.ceil(currentPapers.length / papersPerPage);

      if (currentPapers.length === 0) {
        papersTarget.innerHTML = `
          <div class="no-papers-found">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <p class="lang-en">No ML papers found for this date on Hugging Face.</p>
            <p class="lang-zh">未找到该日期的 Hugging Face 机器学习论文。</p>
          </div>
        `;
        const paginationControls = document.getElementById('digest-pagination-controls');
        if (paginationControls) paginationControls.style.display = 'none';
        return;
      }

      // Slice current papers
      const startIndex = (currentPage - 1) * papersPerPage;
      const endIndex = startIndex + papersPerPage;
      const paginatedPapers = currentPapers.slice(startIndex, endIndex);

      // Generate HTML
      let html = '';
      paginatedPapers.forEach((paper, idx) => {
        const isFirst = idx === 0;
        const upvotes = paper.upvotes ?? 0;
        const paperId = paper.id ?? `paper-${startIndex + idx + 1}`;
        const arxivId = paper.arxivId ?? paper.paper?.id ?? '';
        const pdfUrl = paper.pdfUrl ?? `https://arxiv.org/pdf/${arxivId}`;
        
        const titleEn = paper.titleEn ?? paper.paper?.title ?? paper.title ?? '';
        const titleZh = paper.titleZh ?? titleEn;
        const authors = paper.authors ?? (paper.paper?.authors?.map((a: any) => a.name).join(', ') ?? '');
        
        // Check if paper has custom detailed multi-block breakdown
        const hasCustomDetails = paper.problemEn && 
          paper.problemEn !== "This paper addresses core challenges in its domain. Read the full summary to explore the detailed problem formulation." &&
          !paper.problemEn.startsWith("Analyzes visual/linguistic");

        let detailsHtml = '';
        if (hasCustomDetails) {
          detailsHtml = `

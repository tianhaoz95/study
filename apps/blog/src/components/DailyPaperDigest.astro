            <h3 class="lang-zh">${titleZh}</h3>
            
            <div class="paper-expanded-details" style="${isFirst ? 'display: block;' : ''}">
              ${detailsHtml}

              <div class="hero-links" style="margin-top: 1rem;">
                <a class="hero-btn" href="${pdfUrl}" target="_blank" rel="noopener">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                    <polyline points="14 2 14 8 20 8"/>
                    <line x1="16" y1="13" x2="8" y2="13"/>
                    <line x1="16" y1="17" x2="8" y2="17"/>
                    <polyline points="10 9 9 9 8 9"/>
                  </svg>
                  <span class="lang-en">Paper PDF</span>
                  <span class="lang-zh">论文 PDF</span>
                </a>
              </div>
            </div>
          </div>
        `;
      });

      papersTarget.innerHTML = html;

      // Bind split view dropdown triggers to newly injected hero-btn links
      if (typeof (window as any).bindSplitViewLinks === 'function') {
        (window as any).bindSplitViewLinks();
      }

      // Show/hide pagination controls based on totalPages
      const paginationControls = document.getElementById('digest-pagination-controls');
      if (paginationControls) {
        if (totalPages <= 1) {
          paginationControls.style.display = 'none';
        } else {
          paginationControls.style.display = 'flex';
          
          // Update page info
          const infoEl = document.getElementById('pagination-page-info');
          if (infoEl) {
            const isZh = document.documentElement.getAttribute('lang') === 'zh-CN';
            infoEl.innerHTML = isZh 
              ? `<span class="lang-zh">第 ${currentPage} / ${totalPages} 页</span>`
              : `<span class="lang-en">Page ${currentPage} of ${totalPages}</span>`;
          }

          // Update buttons disabled status
          const prevBtn = document.getElementById('prev-page-btn') as HTMLButtonElement;
          const nextBtn = document.getElementById('next-page-btn') as HTMLButtonElement;
          if (prevBtn) prevBtn.disabled = currentPage === 1;
          if (nextBtn) nextBtn.disabled = currentPage === totalPages;
        }
      }

      // Bind click events to tab cards on this page
      bindPaperTabEvents(isPresetMode, activePresetDate);

      // Excite first visualizer of page
      const firstCard = papersTarget.querySelector('.paper-tab-card');
      if (firstCard) {
        firstCard.dispatchEvent(new Event('click'));
      }
    }

    // Load custom date dynamically
    async function loadDate(date: string) {
      currentPage = 1;

      // Check preset first
      if (date in PRESET_PAPERS) {
        isPresetMode = true;
        activePresetDate = date;
        currentPapers = (PRESET_PAPERS as any)[date];
        
        toggleExecutiveSummary(date, true);
        renderPage();
        return;
      }

      // Fallback: Fetch dynamically from Hugging Face API (limit=30 to get all major papers)
      isPresetMode = false;
      if (loadingEl) loadingEl.classList.remove('hide');
      
      // Clear current content target
      const content = document.getElementById('papers-content-target');
      if (content) content.innerHTML = '';
      const paginationControls = document.getElementById('digest-pagination-controls');
      if (paginationControls) paginationControls.style.display = 'none';

      // Deactivate all visualizations
      document.querySelectorAll('.interactive-viz').forEach(v => v.classList.remove('active'));

      try {
        const response = await fetch(`https://huggingface.co/api/daily_papers?date=${date}&limit=30`);
        if (!response.ok) throw new Error("API failed");
        
        const data = await response.json();
        
        if (loadingEl) loadingEl.classList.add('hide');
        toggleExecutiveSummary(date, false);
        
        // Render
        currentPapers = data;
        renderPage();
      } catch (err) {
        if (loadingEl) loadingEl.classList.add('hide');
        
        const target = document.getElementById('papers-content-target');
        if (target) {
          target.innerHTML = `
            <div class="no-papers-found">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color:var(--purple-l);">
                <polygon points="7.86 2 16.14 2 22 7.86 22 16.14 16.14 22 7.86 22 2 16.14 2 7.86 7.86 2"></polygon>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
              <p class="lang-en">Failed to fetch papers for ${date} from Hugging Face API. The service might be temporarily unavailable or rate-limited.</p>
              <p class="lang-zh">从 Hugging Face 接口获取 ${date} 的论文数据失败。API 可能暂时不可用或受到访问限制。</p>
            </div>
          `;
        }
      }
    }

    // Pagination Listeners
    if (prevPageBtn) {
      prevPageBtn.addEventListener('click', () => {
        if (currentPage > 1) {
          currentPage--;
          renderPage();
        }
      });
    }

    if (nextPageBtn) {
      nextPageBtn.addEventListener('click', () => {
        const totalPages = Math.ceil(currentPapers.length / papersPerPage);
        if (currentPage < totalPages) {
          currentPage++;
          renderPage();
        }
      });
    }

    // Bind custom date picker
    if (customDateInput) {
      customDateInput.addEventListener('change', () => {
        const date = customDateInput.value;
        if (!date) return;

        // Deselect preset chips
        presetChips.forEach(c => c.classList.remove('active'));

        // Check if date matches preset chips, highlight it
        presetChips.forEach(c => {
          if (c.getAttribute('data-preset-date') === date) {
            c.classList.add('active');
          }
        });

        loadDate(date);
      });
    }

    // Bind preset chips
    presetChips.forEach(chip => {
      chip.addEventListener('click', () => {
        presetChips.forEach(c => c.classList.remove('active'));
        chip.classList.add('active');

        const date = chip.getAttribute('data-preset-date');
        if (date) {
          if (customDateInput) customDateInput.value = date;
          loadDate(date);
        }
      });
    });

    // --- Initial SSR Render Page Call ---
    renderPage();

    // --- Viz 1: Math Strategy vs Phrasing ---
    const mathToggleBtns = document.querySelectorAll('#viz-paper-1 .viz-btn');
    const surfacePaths = document.querySelectorAll('#viz-paper-1 .surface-path');
    const strategyPaths = document.querySelectorAll('#viz-paper-1 .strategy-path');
    const surfaceNodes = document.querySelectorAll('#viz-paper-1 .surface-node');
    const strategyNodes = document.querySelectorAll('#viz-paper-1 .strategy-node');

    function setMathMode(mode: string) {
      mathToggleBtns.forEach(btn => {
        if (btn.getAttribute('data-mode') === mode) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });

      if (mode === 'surface') {
        surfacePaths.forEach(p => p.classList.add('active'));
        strategyPaths.forEach(p => { p.classList.remove('active'); p.classList.add('hide'); });
        surfaceNodes.forEach(n => n.classList.remove('hide'));
        strategyNodes.forEach(n => n.classList.add('hide'));
      } else {
        surfacePaths.forEach(p => p.classList.remove('active'));
        strategyPaths.forEach(p => { p.classList.add('active'); p.classList.remove('hide'); });
        surfaceNodes.forEach(n => n.classList.add('hide'));
        strategyNodes.forEach(n => n.classList.remove('hide'));
      }
    }

    // Trigger active state on load
    setMathMode('surface');

    mathToggleBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const mode = btn.getAttribute('data-mode');
        if (mode) setMathMode(mode);
      });
    });

    // --- Viz 2: VLA tabletop simulator ---
    const runVlaBtn = document.getElementById('run-vla-btn');
    const vlaArm = document.querySelector('.vla-robotic-arm');
    const vlaApple = document.querySelector('.item-apple');
    let isVlaRunning = false;

    if (runVlaBtn && vlaArm && vlaApple) {
      runVlaBtn.addEventListener('click', () => {
        if (isVlaRunning) return;
        isVlaRunning = true;
        
        // Phase 1: Arm moves to Apple position (left=110px)
        (vlaArm as HTMLElement).style.transform = 'translate(-20px, 15px) rotate(10deg)';
        
        setTimeout(() => {
          // Phase 2: Grab apple
          (vlaApple as HTMLElement).style.zIndex = '4';
          
          // Phase 3: Move arm to basket B (right-side)
          (vlaArm as HTMLElement).style.transform = 'translate(110px, -5px) rotate(-15deg)';
          (vlaApple as HTMLElement).style.transform = 'translate(130px, -20px)';
          
          setTimeout(() => {
            // Drop apple into Basket B
            (vlaApple as HTMLElement).style.transform = 'translate(130px, 15px)';
            (vlaArm as HTMLElement).style.transform = 'none';
            
            setTimeout(() => {
              // Reset tabletop
              (vlaApple as HTMLElement).style.transition = 'none';
              (vlaApple as HTMLElement).style.transform = 'none';
              setTimeout(() => {
                (vlaApple as HTMLElement).style.transition = '';
                isVlaRunning = false;
              }, 50);
            }, 1500);
          }, 1200);
        }, 1200);
      });
    }

    // --- Viz 3: Distance slider ---
    const distSlider = document.getElementById('distance-slider') as HTMLInputElement;
    const distVal = document.getElementById('dist-val');
    const clusters = document.querySelectorAll('.embed-cluster');

    if (distSlider && distVal) {
      distSlider.addEventListener('input', () => {
        const val = parseFloat(distSlider.value);
        distVal.textContent = val.toFixed(2);

        // Adjust scatter offsets based on slider
        clusters.forEach(c => {
          const isDisj = c.classList.contains('disjunctive');
          const dots = c.querySelectorAll('.dot');
          
          dots.forEach((dot, index) => {
            // Disjointed elements drift far away as threshold decreases
            const factor = isDisj ? (1.1 - val) * 80 : (1.1 - val) * 20;
            const angle = (index * 2 * Math.PI) / 3;
            const x = Math.cos(angle) * factor;
            const y = Math.sin(angle) * factor;
            (dot as HTMLElement).style.transform = `translate(${x}px, ${y}px)`;
          });
        });
      });
      // Trigger initial layout
      distSlider.dispatchEvent(new Event('input'));
    }

    // --- Viz 4: MOPD Distillation streams ---
    const mopdCanvas = document.querySelector('.mopd-canvas');
    const teacherNodes = document.querySelectorAll('.mopd-node.teacher');
    
    // Spawn floating particles representing distillation
    function spawnMopdParticles() {
      if (!mopdCanvas) return;
      const activeTeachers = document.querySelectorAll('.mopd-node.teacher.active');
      if (activeTeachers.length === 0) return;

      const randomTeacher = activeTeachers[Math.floor(Math.random() * activeTeachers.length)];
      const rect = randomTeacher.getBoundingClientRect();
      const canvasRect = mopdCanvas.getBoundingClientRect();

      const particle = document.createElement('div');
      particle.className = 'mopd-particle';
      
      // Compute relative top position
      const topOffset = (rect.top + rect.height/2) - canvasRect.top;
      particle.style.top = `${topOffset}px`;
      
      const capName = randomTeacher.getAttribute('data-cap');
      const fillEl = document.getElementById(`cap-${capName?.toLowerCase()}-fill`);

      // Color matching teachers
      if (capName === 'Math') {
        particle.style.background = 'var(--purple-l)';
        particle.style.boxShadow = '0 0 6px var(--purple-l)';
      } else if (capName === 'Code') {
        particle.style.background = 'var(--cyan-l)';
        particle.style.boxShadow = '0 0 6px var(--cyan-l)';
      } else {
        particle.style.background = 'var(--text)';
        particle.style.boxShadow = '0 0 6px var(--text)';
      }

      mopdCanvas.appendChild(particle);

      // Pulse student meter
      if (fillEl) {
        fillEl.style.transform = 'scaleY(1.1)';
        setTimeout(() => {
          fillEl.style.transform = 'none';
        }, 150);
      }

      // Remove after animation completes
      setTimeout(() => {
        particle.remove();
      }, 1500);
    }

    // Continuously spawn particles
    setInterval(spawnMopdParticles, 250);

    // Toggle teacher contributions
    teacherNodes.forEach(t => {
      t.addEventListener('click', () => {
        t.classList.toggle('active');
        const cap = t.getAttribute('data-cap');
        const fillEl = document.getElementById(`cap-${cap?.toLowerCase()}-fill`);
        
        if (fillEl) {
          if (t.classList.contains('active')) {
            fillEl.style.width = cap === 'Math' ? '95%' : cap === 'Code' ? '92%' : '94%';
          } else {
            fillEl.style.width = '0%';
          }
        }
      });
    });

    // --- Viz 5: Goku Frame Scrubber ---
    const frameScrubber = document.getElementById('frame-scrubber') as HTMLInputElement;
    const frameVal = document.getElementById('frame-val');
    const maskObject = document.querySelector('.animating-silhouette');
    const mainObject = document.querySelector('.animating-object');

    if (frameScrubber && frameVal && maskObject && mainObject) {
      frameScrubber.addEventListener('input', () => {
        const val = parseInt(frameScrubber.value);
        frameVal.textContent = val.toString();

        // Animate movement (leap forward trajectory)
        const xOffset = (val / 100) * 100; // 0 to 100px shift
        const yOffset = -Math.sin((val / 100) * Math.PI) * 45; // 0 to -45px jump

        // Structural mask moves precisely
        (maskObject as HTMLElement).style.transform = `translate(${xOffset}px, ${yOffset}px)`;
        
        // Appearance main branch follows mask exactly
        (mainObject as HTMLElement).style.transform = `translate(${xOffset}px, ${yOffset}px)`;
      });
    }
  });
</script>

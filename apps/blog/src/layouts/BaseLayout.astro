---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  crumb?: string;
}
const { title, description = 'AI/ML Deep Dives — interactive explorations of frontier models and research.', crumb } = Astro.props;
const subscribeUrl = import.meta.env.PUBLIC_SUBSCRIBE_URL ?? 'https://heji-study-subscribe.web.app';

// Generate static random stars at build time for the cosmos background
const stars = Array.from({ length: 80 }, (_, i) => ({
  id: i,
  x: Math.random() * 100,
  y: Math.random() * 100,
  size: Math.random() * 1.5 + 0.5, // 0.5px to 2.0px
  delay: Math.random() * 6,
  duration: Math.random() * 4 + 4,
  opacity: Math.random() * 0.6 + 0.4
}));
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="AI/ML Deep Dives" />
  <meta name="theme-color" content="#09090f" />
  <script is:inline>
    (function(){try{var t=localStorage.getItem('heji-theme')||'dark';document.documentElement.dataset.theme=t;}catch(e){}})();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>

<div class="bg-animation-container" aria-hidden="true">
  <div class="bg-stars">
    {stars.map(star => (
      <div
        class="bg-star"
        style={{
          left: `${star.x}%`,
          top: `${star.y}%`,
          width: `${star.size}px`,
          height: `${star.size}px`,
          animationDelay: `${star.delay}s`,
          animationDuration: `${star.duration}s`,
          opacity: String(star.opacity)
        }}
      />
    ))}
  </div>
  <div class="bg-glow bg-glow-1"></div>
  <div class="bg-glow bg-glow-2"></div>
  <div class="bg-glow bg-glow-3"></div>
</div>

<nav class="site-nav">
  <a class="nav-brand" href="/" data-i18n="nav-brand">AI/ML Deep Dives</a>
  {crumb && <>
    <span class="nav-sep">/</span>
    <span class="nav-crumb">{crumb}</span>
  </>}
  <div class="nav-actions">
    <div id="auth-container" class="auth-container"></div>
    <a class="nav-link" href="/" data-i18n="nav-posts">Posts</a>
    <a class="nav-link" href="/about" data-i18n="nav-about">About</a>
    <a class="nav-link nav-subscribe" href={subscribeUrl} target="_blank" rel="noopener noreferrer" data-i18n="nav-subscribe">Subscribe</a>
    <button class="nav-link nav-suggest" id="suggest-btn" data-i18n="nav-suggest">Suggest Topic</button>
    <button class="btn-icon" id="theme-toggle" aria-label="Toggle theme">
      <svg id="icon-sun" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
      <svg id="icon-moon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
    </button>
    <button class="btn-icon" id="lang-toggle" aria-label="Toggle language">中</button>
    <button class="btn-icon nav-menu-btn" id="menu-toggle" aria-label="Open navigation" aria-expanded="false">
      <svg id="icon-menu" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      <svg id="icon-menu-close" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display:none"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>
</nav>

<div id="mobile-menu" class="mobile-menu" aria-hidden="true">
  <a class="mobile-menu-link" href="/" data-i18n="nav-posts">Posts</a>
  <a class="mobile-menu-link" href="/about" data-i18n="nav-about">About</a>
  <a class="mobile-menu-link" href="/bookmarks" id="mobile-bookmarks-link" style="display:none" data-i18n="nav-bookmarks">Bookmarks</a>
  <a class="mobile-menu-link" href={subscribeUrl} target="_blank" rel="noopener noreferrer" data-i18n="nav-subscribe">Subscribe</a>
  <button class="mobile-menu-link mobile-menu-suggest" id="suggest-btn-mobile" data-i18n="nav-suggest">Suggest Topic</button>
</div>

<div id="read-progress"></div>

<div id="suggest-modal" class="modal-backdrop" aria-hidden="true" role="presentation">
  <div class="modal-box" role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <div class="modal-header">
      <h2 id="modal-title" data-i18n="modal-title">Suggest a Topic</h2>
      <button class="btn-icon modal-close" id="suggest-close" aria-label="Close">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <p class="modal-desc" data-i18n="modal-desc">Have an AI/ML paper or topic you'd like to see covered? Drop it here.</p>
    <form id="suggest-form" novalidate>
      <div class="form-group">
        <label for="suggest-topic" data-i18n="modal-label-topic">Topic or paper</label>
        <input type="text" id="suggest-topic" name="topic" required autocomplete="off"
          placeholder="e.g. Flash Attention 3, Mamba SSM, ..." />
      </div>
      <div class="form-group">
        <label for="suggest-email" data-i18n="modal-label-email">Your email <span class="optional" data-i18n="modal-optional">(optional)</span></label>
        <input type="email" id="suggest-email" name="email" placeholder="you@example.com" />
      </div>
      <button type="submit" class="btn btn-primary btn-full" id="suggest-submit">
        <span data-i18n="modal-submit">Submit suggestion</span>
      </button>
    </form>
    <p id="suggest-success" class="suggest-feedback suggest-success" style="display:none" data-i18n="modal-success">
      Thanks! Your suggestion has been received.
    </p>
    <p id="suggest-error" class="suggest-feedback suggest-error" style="display:none"></p>
  </div>
</div>

<slot />

<script>
  import { initAnalytics, analytics } from '../lib/firebase';
  import { logEvent } from 'firebase/analytics';
  initAnalytics();

  const bar = document.getElementById('read-progress');
  if (bar) {
    const parts = window.location.pathname.replace(/\/$/, '').split('/').filter(Boolean);
    const slug = parts[0] === 'posts' && parts[1] ? parts[1] : null;
    let saveTimer: number | null = null;

    if (slug && analytics) {
      logEvent(analytics, 'view_item', {
        item_id: slug,
        item_category: 'blog_post'
      });
    }

    // Track active reading duration (only increment when tab is visible)
    let activeTimeSeconds = 0;
    let timerInterval: number | null = null;

    const startTimer = () => {
      if (timerInterval === null && slug) {
        timerInterval = setInterval(() => {
          if (document.visibilityState === 'visible') {
            activeTimeSeconds++;
            checkTimeMilestones(activeTimeSeconds);
          }
        }, 1000) as unknown as number;
      }
    };

    const stopTimer = () => {
      if (timerInterval !== null) {
        clearInterval(timerInterval);
        timerInterval = null;
      }
    };

    // Duration milestones
    const timeMilestones = [10, 30, 60, 180, 300];
    const firedTimeMilestones = new Set<number>();

    const checkTimeMilestones = (secs: number) => {
      timeMilestones.forEach(m => {
        if (secs >= m && !firedTimeMilestones.has(m)) {
          firedTimeMilestones.add(m);
          if (analytics) {
            logEvent(analytics, 'post_read_time', {
              item_id: slug,
              seconds: m
            });
          }
        }
      });
    };

    // Track visibility state
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') {
        startTimer();
      } else {
        stopTimer();
      }
    });

    if (document.visibilityState === 'visible') {
      startTimer();
    }

    const firedMilestones = new Set<number>();
    const milestones = [25, 50, 75, 100];

    const update = () => {
      const el = document.documentElement;
      const scrollable = el.scrollHeight - el.clientHeight;
      const pct = scrollable > 0 ? Math.min((el.scrollTop / scrollable) * 100, 100) : 0;
      bar.style.width = pct + '%';
      if (slug) {
        // Track milestones
        milestones.forEach(m => {
          if (pct >= m && !firedMilestones.has(m)) {
            firedMilestones.add(m);
            if (analytics) {
              logEvent(analytics, 'post_read_progress', {
                item_id: slug,
                percentage: m,
                time_spent_seconds: activeTimeSeconds
              });
            }
          }
        });

        if (saveTimer !== null) clearTimeout(saveTimer);
        saveTimer = setTimeout(() => {
          let stored = 0;
          try {
            stored = parseInt(localStorage.getItem(`heji-read-${slug}`) ?? '0', 10);
          } catch (e) {}
          const next = Math.round(pct);
          if (next > stored) {
            try {
              localStorage.setItem(`heji-read-${slug}`, String(next));
            } catch (e) {}
          }
          saveTimer = null;
        }, 500);
      }
    };
    window.addEventListener('scroll', update, { passive: true });
  }
</script>

<script>
  import { logEvent } from 'firebase/analytics';
  import { analytics } from '../lib/firebase';

  type Theme = 'dark' | 'light';
  type Lang  = 'en' | 'zh';
  const THEME_KEY = 'heji-theme';
  const LANG_KEY  = 'heji-lang';
  const HTML = document.documentElement;

  const safeGetItem = (key: string, fallback: string = ''): string => {
    try {
      return localStorage.getItem(key) || fallback;
    } catch (e) {
      return fallback;
    }
  };

  const safeSetItem = (key: string, value: string): void => {
    try {
      localStorage.setItem(key, value);
    } catch (e) {}
  };

  const i18n: Record<Lang, Record<string, string>> = {
    en: {
      'nav-brand':    'AI/ML Deep Dives',
      'nav-posts':    'Posts',
      'nav-about':    'About',
      'nav-bookmarks': 'Bookmarks',
      'nav-subscribe': 'Subscribe',
      'nav-suggest':  'Suggest Topic',
      'hero-eyebrow': 'Personal Research Blog',
      'hero-title':   'Exploring the frontier of AI & ML',
      'hero-desc':    'Deep dives into research papers, model architectures, and open-source implementations — with interactive visualizations and annotated source code.',
      'section-latest': 'Latest Posts',
      'post-badge':   '★ Latest',
      'post-read':    '~15 min read',
      'blog-footer':  'Built with curiosity. Source on GitHub.',
      'modal-title':  'Suggest a Topic',
      'modal-desc':   'Have an AI/ML paper or topic you\'d like to see covered? Drop it here.',
      'modal-label-topic': 'Topic or paper',
      'modal-label-email': 'Your email',
      'modal-optional': '(optional)',
      'modal-submit': 'Submit suggestion',
      'modal-success': 'Thanks! Your suggestion has been received.',
    },
    zh: {
      'nav-brand':    'AI/ML 深度解析',
      'nav-posts':    '文章',
      'nav-about':    '关于',
      'nav-bookmarks': '书签',
      'nav-subscribe': '订阅',
      'nav-suggest':  '建议主题',
      'hero-eyebrow': '个人研究博客',
      'hero-title':   '探索 AI & ML 的前沿',
      'hero-desc':    '深入解析研究论文、模型架构与开源实现——配合交互式可视化和注释源码。',
      'section-latest': '最新文章',
      'post-badge':   '★ 最新',
      'post-read':    '~15 分钟阅读',
      'blog-footer':  '用好奇心构建，代码开源于 GitHub。',
      'modal-title':  '建议主题',
      'modal-desc':   '有想看的 AI/ML 论文或话题？欢迎提交建议。',
      'modal-label-topic': '主题或论文',
      'modal-label-email': '你的邮箱',
      'modal-optional': '（可选）',
      'modal-submit': '提交建议',
      'modal-success': '感谢！你的建议已收到。',
    },
  };

  function applyTheme(theme: Theme) {
    HTML.dataset.theme = theme;
    const sun  = document.getElementById('icon-sun');
    const moon = document.getElementById('icon-moon');
    if (sun)  (sun as HTMLElement).style.display  = theme === 'light' ? 'none' : '';
    if (moon) (moon as HTMLElement).style.display = theme === 'dark'  ? 'none' : '';
    safeSetItem(THEME_KEY, theme);
    if (analytics) {
      logEvent(analytics, 'theme_changed', { theme });
    }
  }

  function applyLang(lang: Lang) {
    HTML.lang = lang === 'zh' ? 'zh-CN' : 'en';
    document.querySelectorAll<HTMLElement>('[data-i18n]').forEach(el => {
      const val = i18n[lang][el.dataset.i18n!];
      if (val != null) el.textContent = val;
    });
    const btn = document.getElementById('lang-toggle');
    if (btn) btn.textContent = lang === 'zh' ? 'EN' : '中';
    safeSetItem(LANG_KEY, lang);
    if (analytics) {
      logEvent(analytics, 'language_changed', { language: lang });
    }
  }

  const savedTheme = safeGetItem(THEME_KEY, 'dark') as Theme;
  const savedLang  = safeGetItem(LANG_KEY, 'en') as Lang;
  applyTheme(savedTheme);
  applyLang(savedLang);

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    applyTheme((HTML.dataset.theme as Theme) === 'dark' ? 'light' : 'dark');
  });
  document.getElementById('lang-toggle')?.addEventListener('click', () => {
    applyLang((safeGetItem(LANG_KEY, 'en') === 'en' ? 'zh' : 'en') as Lang);
  });

  // ── Mobile hamburger menu ──────────────────────────────────
  const menuToggle  = document.getElementById('menu-toggle');
  const mobileMenu  = document.getElementById('mobile-menu');
  const iconMenu    = document.getElementById('icon-menu');
  const iconMenuClose = document.getElementById('icon-menu-close');

  function closeMobileMenu() {
    mobileMenu?.setAttribute('aria-hidden', 'true');
    mobileMenu?.classList.remove('is-open');
    menuToggle?.setAttribute('aria-expanded', 'false');
    if (iconMenu)      (iconMenu as HTMLElement).style.display = '';
    if (iconMenuClose) (iconMenuClose as HTMLElement).style.display = 'none';
  }

  menuToggle?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.contains('is-open');
    if (isOpen) {
      closeMobileMenu();
    } else {
      mobileMenu?.setAttribute('aria-hidden', 'false');
      mobileMenu?.classList.add('is-open');
      menuToggle.setAttribute('aria-expanded', 'true');
      if (iconMenu)      (iconMenu as HTMLElement).style.display = 'none';
      if (iconMenuClose) (iconMenuClose as HTMLElement).style.display = '';
    }
  });

  // Close menu on link click or when navigating away
  mobileMenu?.querySelectorAll('.mobile-menu-link').forEach(link => {
    link.addEventListener('click', closeMobileMenu);
  });
</script>

<script>
  import { db, analytics } from '../lib/firebase';
  import { collection, addDoc, serverTimestamp } from 'firebase/firestore';
  import { logEvent } from 'firebase/analytics';

  const modal    = document.getElementById('suggest-modal')!;
  const form     = document.getElementById('suggest-form') as HTMLFormElement;
  const success  = document.getElementById('suggest-success')!;
  const errorEl  = document.getElementById('suggest-error')!;
  const submitBtn = document.getElementById('suggest-submit') as HTMLButtonElement;

  function openModal() {
    modal.setAttribute('aria-hidden', 'false');
    modal.classList.add('is-open');
    document.body.style.overflow = 'hidden';
    (document.getElementById('suggest-topic') as HTMLInputElement)?.focus();
    if (analytics) {
      logEvent(analytics, 'suggest_topic_open');
    }
  }

  function closeModal() {
    modal.setAttribute('aria-hidden', 'true');
    modal.classList.remove('is-open');
    document.body.style.overflow = '';
    form.reset();
    form.style.display = '';
    success.style.display = 'none';
    errorEl.style.display = 'none';
  }

  document.getElementById('suggest-btn')?.addEventListener('click', openModal);
  document.getElementById('suggest-btn-mobile')?.addEventListener('click', openModal);
  document.getElementById('suggest-close')?.addEventListener('click', closeModal);
  modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const topic = (document.getElementById('suggest-topic') as HTMLInputElement).value.trim();
    const email = (document.getElementById('suggest-email') as HTMLInputElement).value.trim();
    if (!topic) return;

    submitBtn.disabled = true;
    errorEl.style.display = 'none';

    try {
      await addDoc(collection(db, 'topic-suggestions'), {
        topic,
        ...(email ? { email } : {}),
        createdAt: serverTimestamp(),
      });
      form.style.display = 'none';
      success.style.display = '';
      if (analytics) {
        logEvent(analytics, 'suggest_topic_submit', { topic });
      }
    } catch (err) {
      errorEl.textContent = 'Something went wrong. Please try again.';
      errorEl.style.display = '';
      if (analytics) {
        logEvent(analytics, 'suggest_topic_error', {
          error_message: err instanceof Error ? err.message : 'Unknown'
        });
      }
    } finally {
      submitBtn.disabled = false;
    }
  });
</script>

<script>
  import { auth } from '../lib/firebase';
  import {
    onAuthStateChanged,
    signInWithPopup,
    GoogleAuthProvider,
    signOut,
    type User
  } from 'firebase/auth';

  const container = document.getElementById('auth-container');
  if (container) {
    onAuthStateChanged(auth, (user: User | null) => {
      if (user) {
        const avatarUrl = user.photoURL || 'https://www.gravatar.com/avatar/00000000000000000000000000000000?d=mp&f=y';
        const name = user.displayName || 'User';
        const email = user.email || '';
        
        container.innerHTML = `
          <div class="user-profile">
            <img src="${avatarUrl}" class="user-avatar" id="auth-avatar" alt="${name}" />
            <div class="user-dropdown" id="auth-dropdown">
              <div class="dropdown-user-info">
                <span class="dropdown-user-name">${name}</span>
                <span class="dropdown-user-email">${email}</span>
              </div>
              <a href="/bookmarks" class="dropdown-bookmarks-link" id="dropdown-bookmarks-link">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
                Bookmarks
                <span class="dropdown-bookmarks-count" id="dropdown-bookmarks-count" style="display:none">0</span>
              </a>
              <button class="btn-signout" id="auth-signout-btn">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                Sign Out
              </button>
            </div>
          </div>
        `;

        const avatar = container.querySelector('#auth-avatar');
        const dropdown = container.querySelector('#auth-dropdown');
        const signoutBtn = container.querySelector('#auth-signout-btn');

        avatar?.addEventListener('click', (e) => {
          e.stopPropagation();
          dropdown?.classList.toggle('is-open');
        });

        document.addEventListener('click', () => {
          dropdown?.classList.remove('is-open');
        });

        signoutBtn?.addEventListener('click', async () => {
          try {
            await signOut(auth);
          } catch (err) {
            console.error('Sign out failed:', err);
          }
        });
      } else {
        container.innerHTML = `
          <button class="btn-signin" id="auth-signin-btn">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"/>
            </svg>
            Sign In
          </button>
        `;

        const signinBtn = container.querySelector('#auth-signin-btn');
        signinBtn?.addEventListener('click', async () => {
          const provider = new GoogleAuthProvider();
          try {
            await signInWithPopup(auth, provider);
          } catch (err) {
            console.error('Sign in failed:', err);
          }
        });
      }
    });
  }
</script>

<script>
  import { auth } from '../lib/firebase';
  import { onAuthStateChanged, type User } from 'firebase/auth';
  import { loadBookmarks, toggleBookmark } from '../lib/bookmarks';

  // Per-page post slug (null if not on a post page)
  const _pathParts = window.location.pathname.replace(/\/$/, '').split('/').filter(Boolean);
  const _pageSlug = _pathParts[0] === 'posts' && _pathParts[1] ? _pathParts[1] : null;

  let _currentUid: string | null = null;

  function _bmSvg(pressed: boolean): string {
    return `<svg width="11" height="11" viewBox="0 0 24 24" fill="${pressed ? 'currentColor' : 'none'}" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>`;
  }

  function _applyBookmarkStates(set: Set<string> | null) {
    document.querySelectorAll<HTMLButtonElement>('.post-bookmark-btn').forEach(btn => {
      const slug = btn.dataset.slug;
      if (!slug) return;
      const pressed = set != null && set.has(slug);
      btn.setAttribute('aria-pressed', String(pressed));
      const svgEl = btn.querySelector('svg');
      if (svgEl) svgEl.setAttribute('fill', pressed ? 'currentColor' : 'none');
    });
  }

  function _updateDropdownCount(n: number | null) {
    const countEl = document.getElementById('dropdown-bookmarks-count');
    if (!countEl) return;
    if (n === null || n === 0) {
      countEl.style.display = 'none';
    } else {
      countEl.textContent = String(n);
      countEl.style.display = '';
    }
  }

  function _initPostPageBmBtn(set: Set<string>) {
    if (!_pageSlug) return;
    if (document.getElementById('post-hero-bookmark')) return;
    const heroMeta = document.querySelector<HTMLElement>('.post-hero-meta');
    if (!heroMeta) return;

    const titleEl = document.querySelector<HTMLElement>('.post-hero h1');
    const tagEls  = document.querySelectorAll<HTMLElement>('.post-hero .tag');
    const dateEl  = heroMeta.querySelector<HTMLElement>('span');
    const title   = titleEl?.textContent?.trim() ?? '';
    const date    = dateEl?.textContent?.trim() ?? '';
    const href    = window.location.pathname;
    const tags: { text: string; cls: string }[] = [];
    tagEls.forEach(el => {
      const cls = Array.from(el.classList).find(c => c.startsWith('tag-')) ?? '';
      tags.push({ text: el.textContent?.trim() ?? '', cls: `tag ${cls}` });
    });

    const pressed = set.has(_pageSlug);
    const btn = document.createElement('button');
    btn.id = 'post-hero-bookmark';
    btn.className = 'post-bookmark-btn post-bookmark-hero';
    btn.setAttribute('aria-label', pressed ? 'Remove bookmark' : 'Bookmark this post');
    btn.setAttribute('aria-pressed', String(pressed));
    btn.dataset.slug  = _pageSlug;
    btn.dataset.title = title;
    btn.dataset.date  = date;
    btn.dataset.href  = href;
    btn.dataset.tags  = JSON.stringify(tags);
    btn.innerHTML = `${_bmSvg(pressed)}<span>${pressed ? 'Saved' : 'Bookmark'}</span>`;
    heroMeta.appendChild(btn);
  }

  function _removePostPageBmBtn() {
    document.getElementById('post-hero-bookmark')?.remove();
  }

  // Delegate bookmark-button clicks across the whole page.
  // Use capture phase so we intercept clicks before the parent <a> card can navigate.
  document.addEventListener('click', async (e: MouseEvent) => {
    const target = (e.target as Element).closest<HTMLButtonElement>('.post-bookmark-btn');
    if (!target) return; // not a bookmark button — let click propagate normally
    e.preventDefault();
    e.stopPropagation();

    if (!_currentUid) {
      // Not signed in — flash the button red briefly as a hint
      target.style.color = 'var(--red)';
      target.style.borderColor = 'var(--red)';
      setTimeout(() => { target.style.color = ''; target.style.borderColor = ''; }, 800);
      return;
    }

    const slug = target.dataset.slug ?? '';
    if (!slug) return;

    const set: Set<string> = (window as any).__hejiBookmarks ?? new Set();
    const wasBookmarked = set.has(slug);

    // Optimistic update
    wasBookmarked ? set.delete(slug) : set.add(slug);
    (window as any).__hejiBookmarks = set;
    _applyBookmarkStates(set);
    _updateDropdownCount(set.size);

    // Sync hero button label
    const heroBtn = document.getElementById('post-hero-bookmark') as HTMLButtonElement | null;
    if (heroBtn && heroBtn.dataset.slug === slug) {
      const newPressed = !wasBookmarked;
      heroBtn.setAttribute('aria-pressed', String(newPressed));
      heroBtn.setAttribute('aria-label', newPressed ? 'Remove bookmark' : 'Bookmark this post');
      heroBtn.innerHTML = `${_bmSvg(newPressed)}<span>${newPressed ? 'Saved' : 'Bookmark'}</span>`;
    }

    try {
      const parseTags = () => { try { return JSON.parse(target.dataset.tags ?? '[]'); } catch { return []; } };
      await toggleBookmark(_currentUid, slug, {
        slug,
        title: target.dataset.title ?? '',
        date:  target.dataset.date  ?? '',
        href:  target.dataset.href  ?? '',
        tags:  parseTags(),
      }, wasBookmarked);
    } catch (err) {
      // Revert on error
      wasBookmarked ? set.add(slug) : set.delete(slug);
      (window as any).__hejiBookmarks = set;
      _applyBookmarkStates(set);
      _updateDropdownCount(set.size);
      console.error('Bookmark toggle failed:', err);
    }
  }, true); // capture phase: fires before <a> card can follow its link

  // Called by index.astro after lazy-load or search re-render
  (window as any).__hejiApplyBookmarks = () => {
    _applyBookmarkStates((window as any).__hejiBookmarks ?? null);
  };

  function _setMobileBookmarksVisible(visible: boolean) {
    const el = document.getElementById('mobile-bookmarks-link') as HTMLElement | null;
    if (el) el.style.display = visible ? '' : 'none';
  }

  onAuthStateChanged(auth, async (user: User | null) => {
    if (user) {
      _currentUid = user.uid;
      // loadBookmarks may fail if Firestore rules aren't deployed yet — use empty
      // Set as fallback so the rest of auth initialization always completes.
      let set = new Set<string>();
      try {
        set = await loadBookmarks(user.uid);
      } catch (err) {
        console.warn('[bookmarks] loadBookmarks failed (check Firestore rules):', err);
      }
      (window as any).__hejiBookmarks = set;
      _applyBookmarkStates(set);
      _updateDropdownCount(set.size);
      _initPostPageBmBtn(set);
      _setMobileBookmarksVisible(true);
    } else {
      _currentUid = null;
      (window as any).__hejiBookmarks = null;
      _applyBookmarkStates(null);
      _updateDropdownCount(null);
      _removePostPageBmBtn();
      _setMobileBookmarksVisible(false);
    }
  });
</script>

<script>
  function initExportButtons() {
    const panels = document.querySelectorAll('.vp');
    panels.forEach(vp => {
      const canvas = vp.querySelector('canvas');
      const svg = vp.querySelector('svg');
      if (!canvas && !svg) return;
      
      let head = vp.querySelector('.vp-head');
      if (!head) {
        head = document.createElement('div');
        head.className = 'vp-head';
        vp.insertBefore(head, vp.firstChild);
      }
      
      if (head.querySelector('.vp-export-btn')) return;
      
      let rightContainer = head.querySelector('.vp-head-right') as HTMLElement | null;
      if (!rightContainer) {
        rightContainer = document.createElement('div');
        rightContainer.className = 'vp-head-right';
        
        const hint = head.querySelector('.vp-hint');
        if (hint) {
          hint.parentNode?.removeChild(hint);
          rightContainer.appendChild(hint);
        }
        
        head.appendChild(rightContainer);
      }
      
      const btn = document.createElement('button');
      btn.className = 'vp-export-btn';
      btn.setAttribute('aria-label', 'Export PNG');
      btn.title = 'Export as PNG image';
      btn.innerHTML = `
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle;margin-top:-2px;">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="7 10 12 15 17 10"/>
          <line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
        <span>Export</span>
      `;
      
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        
        const panelTitle = head.querySelector('.vp-title')?.textContent || 'visualization';
        const filename = panelTitle
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/(^-|-$)/g, '') || 'export';
          
        if (canvas) {
          exportCanvas(canvas, filename);
        } else if (svg) {
          exportSVG(svg, filename);
        }
      });
      
      rightContainer.appendChild(btn);
    });
  }

  function downloadBlob(blob: Blob, filename: string) {
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  function exportCanvas(canvas: HTMLCanvasElement, filename: string) {
    const tempCanvas = document.createElement('canvas');
    tempCanvas.width = canvas.width;
    tempCanvas.height = canvas.height;
    const tempCtx = tempCanvas.getContext('2d');
    if (!tempCtx) return;
    
    const computedStyle = window.getComputedStyle(canvas.closest('.vp') || document.body);
    let bgColor = computedStyle.backgroundColor;
    if (!bgColor || bgColor === 'transparent' || bgColor === 'rgba(0, 0, 0, 0)') {
      const isLgt = document.documentElement.dataset.theme === 'light';
      bgColor = isLgt ? '#ffffff' : '#0e0e17';
    }
    
    tempCtx.fillStyle = bgColor;
    tempCtx.fillRect(0, 0, tempCanvas.width, tempCanvas.height);
    tempCtx.drawImage(canvas, 0, 0);
    
    tempCanvas.toBlob((blob) => {
      if (blob) {
        downloadBlob(blob, `${filename}.png`);
      }
    }, 'image/png');
  }

  function exportSVG(svg: SVGSVGElement, filename: string) {
    const svgClone = svg.cloneNode(true) as SVGSVGElement;
    
    svgClone.removeAttribute('class');
    svgClone.style.width = '100%';
    svgClone.style.height = '100%';
    svgClone.style.margin = '0';
    
    let cssText = ':root {';
    const rootStyles = window.getComputedStyle(document.documentElement);
    const varNames = [
      '--bg', '--surface', '--card', '--card2', '--border', '--border-hi',
      '--purple', '--purple-l', '--purple-dim', '--cyan', '--cyan-dim',
      '--green', '--green-dim', '--amber', '--red', '--text', '--text2',
      '--muted', '--muted2', '--code-bg', '--ff-sans', '--ff-mono'
    ];
    for (const name of varNames) {
      const val = rootStyles.getPropertyValue(name);
      if (val) cssText += `${name}:${val.trim()};`;
    }
    cssText += '}';
    
    cssText += `
      text {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
      }
    `;
    
    const styleEl = document.createElementNS('http://www.w3.org/2000/svg', 'style');
    styleEl.textContent = cssText;
    svgClone.insertBefore(styleEl, svgClone.firstChild);
    
    const serializer = new XMLSerializer();
    let svgString = serializer.serializeToString(svgClone);
    
    if (!svgString.match(/^<svg[^>]+xmlns="http\:\/\/www\.w3\.org\/2000\/svg"/)) {
      svgString = svgString.replace(/^<svg/, '<svg xmlns="http://www.w3.org/2000/svg"');
    }
    
    const svgBlob = new Blob([svgString], { type: 'image/svg+xml;charset=utf-8' });
    const URLObj = window.URL || window.webkitURL || window;
    const blobURL = URLObj.createObjectURL(svgBlob);
    
    const img = new Image();
    img.onload = () => {
      const canvas = document.createElement('canvas');
      const rect = svg.getBoundingClientRect();
      const width = svg.viewBox?.baseVal?.width || rect.width || 680;
      const height = svg.viewBox?.baseVal?.height || rect.height || 320;
      
      const scale = 2;
      canvas.width = width * scale;
      canvas.height = height * scale;
      
      const ctx = canvas.getContext('2d');
      if (!ctx) return;
      
      const computedStyle = window.getComputedStyle(svg.closest('.vp') || document.body);
      let bgColor = computedStyle.backgroundColor;
      if (!bgColor || bgColor === 'transparent' || bgColor === 'rgba(0, 0, 0, 0)') {
        const isLgt = document.documentElement.dataset.theme === 'light';
        bgColor = isLgt ? '#ffffff' : '#0e0e17';
      }
      
      ctx.fillStyle = bgColor;
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      
      ctx.scale(scale, scale);
      ctx.drawImage(img, 0, 0, width, height);
      
      canvas.toBlob((blob) => {
        if (blob) {
          downloadBlob(blob, `${filename}.png`);
        }
        URLObj.revokeObjectURL(blobURL);
      }, 'image/png');
    };
    
    img.onerror = (err) => {
      console.error('Failed to export SVG', err);
      URLObj.revokeObjectURL(blobURL);
    };
    
    img.src = blobURL;
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initExportButtons);
  } else {
    initExportButtons();
  }

  const observer = new MutationObserver((mutations) => {
    let shouldInit = false;
    for (const mutation of mutations) {
      if (mutation.addedNodes.length) {
        shouldInit = true;
        break;
      }
    }
    if (shouldInit) initExportButtons();
  });
  observer.observe(document.body, { childList: true, subtree: true });
</script>

</body>

<script>
  import { auth } from '../lib/firebase';
  import { onAuthStateChanged, type User } from 'firebase/auth';
  import {
    loadBookmarks, toggleBookmark,
    loadReadingList, toggleReadingList,
  } from '../lib/bookmarks';
  import { getUpvotes, getAllUpvotes, incrementUpvotes } from '../lib/upvotes';

  // Per-page post slug (null if not on a post page)
  const _pathParts = window.location.pathname.replace(/\/$/, '').split('/').filter(Boolean);
  const _pageSlug = _pathParts[0] === 'posts' && _pathParts[1] ? _pathParts[1] : null;

  let _currentUid: string | null = null;

  // ── SVG helpers ────────────────────────────────────────────

  function _bmSvg(pressed: boolean): string {
    return `<svg width="11" height="11" viewBox="0 0 24 24" fill="${pressed ? 'currentColor' : 'none'}" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>`;
  }

  function _rlSvg(): string {
    return `<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`;
  }

  // ── Bookmarks ─────────────────────────────────────────────

  function _applyBookmarkStates(set: Set<string> | null) {
    document.querySelectorAll<HTMLButtonElement>('.post-bookmark-btn').forEach(btn => {
      const slug = btn.dataset.slug;
      if (!slug) return;
      const pressed = set != null && set.has(slug);
      btn.setAttribute('aria-pressed', String(pressed));
      const svgEl = btn.querySelector('svg');
      if (svgEl) svgEl.setAttribute('fill', pressed ? 'currentColor' : 'none');
    });
  }

  function _updateDropdownCount(n: number | null) {
    const countEl = document.getElementById('dropdown-bookmarks-count');
    if (!countEl) return;
    if (n === null || n === 0) { countEl.style.display = 'none'; }
    else { countEl.textContent = String(n); countEl.style.display = ''; }
  }

  function _initPostPageBmBtn(set: Set<string>) {
    if (!_pageSlug) return;
    if (document.getElementById('post-hero-bookmark')) return;
    const heroMeta = document.querySelector<HTMLElement>('.post-hero-meta');
    if (!heroMeta) return;

    const titleEl = document.querySelector<HTMLElement>('.post-hero h1');
    const tagEls  = document.querySelectorAll<HTMLElement>('.post-hero .tag');
    const dateEl  = heroMeta.querySelector<HTMLElement>('span');
    const title   = titleEl?.textContent?.trim() ?? '';
    const date    = dateEl?.textContent?.trim() ?? '';
    const href    = window.location.pathname;
    const tags: { text: string; cls: string }[] = [];
    tagEls.forEach(el => {
      const cls = Array.from(el.classList).find(c => c.startsWith('tag-')) ?? '';
      tags.push({ text: el.textContent?.trim() ?? '', cls: `tag ${cls}` });
    });

    const pressed = set.has(_pageSlug);
    const btn = document.createElement('button');
    btn.id = 'post-hero-bookmark';
    btn.className = 'post-bookmark-btn post-bookmark-hero';
    btn.setAttribute('aria-label', pressed ? 'Remove bookmark' : 'Bookmark this post');
    btn.setAttribute('aria-pressed', String(pressed));
    btn.dataset.slug  = _pageSlug;
    btn.dataset.title = title;
    btn.dataset.date  = date;
    btn.dataset.href  = href;
    btn.dataset.tags  = JSON.stringify(tags);
    btn.innerHTML = `${_bmSvg(pressed)}<span>${pressed ? 'Saved' : 'Bookmark'}</span>`;
    heroMeta.appendChild(btn);
  }

  function _removePostPageBmBtn() {
    document.getElementById('post-hero-bookmark')?.remove();
  }

  // ── Reading List ───────────────────────────────────────────

  function _applyRLStates(set: Set<string> | null) {
    document.querySelectorAll<HTMLButtonElement>('.post-rl-btn').forEach(btn => {
      const slug = btn.dataset.slug;
      if (!slug) return;
      const pressed = set != null && set.has(slug);
      btn.setAttribute('aria-pressed', String(pressed));
    });
  }

  function _updateRLDropdownCount(n: number | null) {
    const countEl = document.getElementById('dropdown-rl-count');
    if (!countEl) return;
    if (n === null || n === 0) { countEl.style.display = 'none'; }
    else { countEl.textContent = String(n); countEl.style.display = ''; }
  }

  function _initPostPageRLBtn(set: Set<string>) {
    if (!_pageSlug) return;
    if (document.getElementById('post-hero-rl')) return;
    const heroMeta = document.querySelector<HTMLElement>('.post-hero-meta');
    if (!heroMeta) return;

    const titleEl = document.querySelector<HTMLElement>('.post-hero h1');
    const tagEls  = document.querySelectorAll<HTMLElement>('.post-hero .tag');
    const dateEl  = heroMeta.querySelector<HTMLElement>('span');
    const title   = titleEl?.textContent?.trim() ?? '';
    const date    = dateEl?.textContent?.trim() ?? '';
    const href    = window.location.pathname;
    const tags: { text: string; cls: string }[] = [];
    tagEls.forEach(el => {
      const cls = Array.from(el.classList).find(c => c.startsWith('tag-')) ?? '';
      tags.push({ text: el.textContent?.trim() ?? '', cls: `tag ${cls}` });
    });

    const pressed = set.has(_pageSlug);
    const btn = document.createElement('button');
    btn.id = 'post-hero-rl';
    btn.className = 'post-rl-btn post-rl-hero';
    btn.setAttribute('aria-label', pressed ? 'Remove from reading list' : 'Add to reading list');
    btn.setAttribute('aria-pressed', String(pressed));
    btn.dataset.slug  = _pageSlug;
    btn.dataset.title = title;
    btn.dataset.date  = date;
    btn.dataset.href  = href;
    btn.dataset.tags  = JSON.stringify(tags);
    btn.innerHTML = `${_rlSvg()}<span>${pressed ? 'Queued' : 'Read Later'}</span>`;
    heroMeta.appendChild(btn);
  }

  function _removePostPageRLBtn() {
    document.getElementById('post-hero-rl')?.remove();
  }

  // ── Upvotes ────────────────────────────────────────────────

  let _upvoteCounts: Record<string, number> | null = null;

  async function _applyUpvoteCounts() {
    const cards = document.querySelectorAll<HTMLElement>('.post-card');
    if (cards.length === 0) return;

    if (!_upvoteCounts) {
      _upvoteCounts = await getAllUpvotes();
    }

    cards.forEach(card => {
      const slug = card.dataset.slug;
      if (!slug) return;

      const count = _upvoteCounts?.[slug] ?? 0;
      if (count <= 0) return;

      const meta = card.querySelector('.post-meta');
      if (!meta) return;

      let badge = meta.querySelector('.post-upvotes-badge') as HTMLElement | null;
      if (badge) {
        const countEl = badge.querySelector('.count');
        if (countEl) countEl.textContent = String(count);
        return;
      }

      badge = document.createElement('span');
      badge.className = 'post-upvotes-badge';
      badge.title = `${count} upvote${count === 1 ? '' : 's'}`;
      badge.innerHTML = `
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="18 15 12 9 6 15"></polyline>
        </svg>
        <span class="count">${count}</span>
      `;

      const arrow = meta.querySelector('.post-arrow');
      if (arrow) {
        meta.insertBefore(badge, arrow);
      } else {
        meta.appendChild(badge);
      }
    });
  }

  async function _initUpvotes() {
    if (!_pageSlug) return;

    const article = document.querySelector('article.post-body');
    if (!article) return;

    if (document.getElementById('post-upvote-sec')) return;

    const upvoteSec = document.createElement('div');
    upvoteSec.id = 'post-upvote-sec';
    upvoteSec.className = 'post-upvote-section';
    upvoteSec.innerHTML = `
      <p class="upvote-prompt">Enjoyed this deep dive?</p>
      <div class="post-actions-row">
        <button class="upvote-button" id="upvote-btn" aria-label="Upvote this post">
          <div class="upvote-icon-wrapper">
            <svg class="upvote-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="18 15 12 9 6 15"></polyline>
            </svg>
          </div>
          <span class="upvote-count" id="upvote-count-label">-</span>
        </button>
        <button class="share-button" id="share-btn" aria-label="Share this post">
          <div class="share-icon-wrapper">
            <svg class="share-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
              <polyline points="16 6 12 2 8 6"></polyline>
              <line x1="12" y1="2" x2="12" y2="15"></line>
            </svg>
          </div>
          <span class="share-text">Share</span>
        </button>
      </div>
    `;

    article.appendChild(upvoteSec);

    const btn = document.getElementById('upvote-btn') as HTMLButtonElement | null;
    const label = document.getElementById('upvote-count-label') as HTMLElement | null;
    const shareBtn = document.getElementById('share-btn') as HTMLButtonElement | null;

    if (btn && label) {
      let currentCount = await getUpvotes(_pageSlug);
      label.textContent = String(currentCount);

      let clickBuffer = 0;
      let upvoteTimeout: any = null;

      btn.addEventListener('click', () => {
        currentCount++;
        label.textContent = String(currentCount);
        clickBuffer++;

        btn.classList.remove('pop');
        void btn.offsetWidth;
        btn.classList.add('pop');

        const bubble = document.createElement('div');
        bubble.className = 'upvote-bubble';
        bubble.textContent = '+1';
        const dx = (Math.random() * 40 - 20) + 'px';
        bubble.style.setProperty('--dx', dx);
        bubble.style.left = '50%';
        btn.appendChild(bubble);

        setTimeout(() => {
          bubble.remove();
        }, 800);

        if (upvoteTimeout) clearTimeout(upvoteTimeout);
        upvoteTimeout = setTimeout(async () => {
          const toAdd = clickBuffer;
          clickBuffer = 0;
          try {
            await incrementUpvotes(_pageSlug, toAdd);
            if (_upvoteCounts) {
              _upvoteCounts[_pageSlug] = (_upvoteCounts[_pageSlug] ?? 0) + toAdd;
            }
          } catch (err) {
            console.error('[upvotes] Failed to sync upvotes:', err);
          }
        }, 500);
      });
    }

    if (shareBtn) {
      shareBtn.addEventListener('click', async () => {
        const shareData = {
          title: document.title,
          text: document.querySelector('.post-hero .lead')?.textContent?.trim() || '',
          url: window.location.href,
        };

        if (navigator.share && navigator.canShare && navigator.canShare(shareData)) {
          try {
            await navigator.share(shareData);
            return;
          } catch (e) {
            // Cancelled or unsupported parameters, fallback to clipboard copy
          }
        }

        // Fallback: Copy link to clipboard
        try {
          await navigator.clipboard.writeText(window.location.href);
          const textEl = shareBtn.querySelector('.share-text');
          if (textEl) {
            const originalText = textEl.textContent;
            textEl.textContent = 'Copied!';
            shareBtn.classList.add('copied');
            setTimeout(() => {
              textEl.textContent = originalText;
              shareBtn.classList.remove('copied');
            }, 2000);
          }
        } catch (err) {
          console.error('Failed to copy link:', err);
        }
      });
    }
  }

  (window as any).__hejiApplyUpvotes = _applyUpvoteCounts;

  // ── Click handler (capture phase) ─────────────────────────

  document.addEventListener('click', async (e: MouseEvent) => {
    const bmTarget = (e.target as Element).closest<HTMLButtonElement>('.post-bookmark-btn');
    const rlTarget = (e.target as Element).closest<HTMLButtonElement>('.post-rl-btn');
    const target = bmTarget ?? rlTarget;
    if (!target) return; // not our button — let click propagate
    e.preventDefault();
    e.stopPropagation();

    if (!_currentUid) {
      target.style.color = 'var(--red)';
      target.style.borderColor = 'var(--red)';
      setTimeout(() => { target.style.color = ''; target.style.borderColor = ''; }, 800);
      return;
    }

    const slug = target.dataset.slug ?? '';
    if (!slug) return;
    const isRL = !!rlTarget;

    if (isRL) {
      // ── Reading list toggle ──────────────────────────────
      const set: Set<string> = (window as any).__hejiReadingList ?? new Set();
      const wasInList = set.has(slug);
      wasInList ? set.delete(slug) : set.add(slug);
      (window as any).__hejiReadingList = set;

      // Build the full metadata object once (reused for both localStorage and Firestore)
      const rlMeta = {
        slug,
        title: target.dataset.title ?? '',
        date:  target.dataset.date  ?? '',
        href:  target.dataset.href  ?? '',
        tags:  (() => { try { return JSON.parse(target.dataset.tags ?? '[]'); } catch { return []; } })(),
      };

      // Persist slugs AND full metadata locally — the reading list page reads from here
      // when Firestore is unavailable (e.g. security rules not yet updated).
      try {
        localStorage.setItem('heji-rl', JSON.stringify([...set]));
        const items: typeof rlMeta[] = JSON.parse(localStorage.getItem('heji-rl-items') ?? '[]');
        if (wasInList) {
          localStorage.setItem('heji-rl-items', JSON.stringify(items.filter(i => i.slug !== slug)));
        } else {
          items.unshift(rlMeta);
          localStorage.setItem('heji-rl-items', JSON.stringify(items));
        }
      } catch (e) {}

      _applyRLStates(set);
      _updateRLDropdownCount(set.size);

      // Sync hero RL button label
      const heroBtn = document.getElementById('post-hero-rl') as HTMLButtonElement | null;
      if (heroBtn && heroBtn.dataset.slug === slug) {
        const np = !wasInList;
        heroBtn.setAttribute('aria-pressed', String(np));
        heroBtn.setAttribute('aria-label', np ? 'Remove from reading list' : 'Add to reading list');
        heroBtn.innerHTML = `${_rlSvg()}<span>${np ? 'Queued' : 'Read Later'}</span>`;
      }

      // Fire-and-forget Firestore sync — local state is the source of truth.
      toggleReadingList(_currentUid, slug, rlMeta, wasInList).catch(err => {
        console.warn('[readingList] Firestore sync failed (check Firestore security rules):', err);
      });
    } else {
      // ── Bookmark toggle ──────────────────────────────────
      const set: Set<string> = (window as any).__hejiBookmarks ?? new Set();
      const wasBookmarked = set.has(slug);
      wasBookmarked ? set.delete(slug) : set.add(slug);
      (window as any).__hejiBookmarks = set;
      _applyBookmarkStates(set);
      _updateDropdownCount(set.size);

      // Sync hero bookmark label
      const heroBtn = document.getElementById('post-hero-bookmark') as HTMLButtonElement | null;
      if (heroBtn && heroBtn.dataset.slug === slug) {
        const np = !wasBookmarked;
        heroBtn.setAttribute('aria-pressed', String(np));
        heroBtn.setAttribute('aria-label', np ? 'Remove bookmark' : 'Bookmark this post');
        heroBtn.innerHTML = `${_bmSvg(np)}<span>${np ? 'Saved' : 'Bookmark'}</span>`;
      }

      try {
        const parseTags = () => { try { return JSON.parse(target.dataset.tags ?? '[]'); } catch { return []; } };
        await toggleBookmark(_currentUid, slug, {
          slug,
          title: target.dataset.title ?? '',
          date:  target.dataset.date  ?? '',
          href:  target.dataset.href  ?? '',
          tags:  parseTags(),
        }, wasBookmarked);
      } catch (err) {
        wasBookmarked ? set.add(slug) : set.delete(slug);
        (window as any).__hejiBookmarks = set;
        _applyBookmarkStates(set);
        _updateDropdownCount(set.size);
        console.error('Bookmark toggle failed:', err);
      }
    }
  }, true); // capture phase: fires before <a> card can follow its link

  // Called by index.astro after lazy-load or search re-render
  (window as any).__hejiApplyBookmarks = () => {
    _applyBookmarkStates((window as any).__hejiBookmarks ?? null);
  };
  (window as any).__hejiApplyRL = () => {
    _applyRLStates((window as any).__hejiReadingList ?? null);
  };

  // ── Nav visibility ──────────────────────────────────────────

  function _setUserNavVisible(visible: boolean) {
    for (const id of ['mobile-bookmarks-link', 'nav-bookmarks-link',
                       'mobile-rl-link', 'nav-rl-link']) {
      const el = document.getElementById(id) as HTMLElement | null;
      if (el) el.style.display = visible ? '' : 'none';
    }
  }

  // ── Auth state ──────────────────────────────────────────────

  onAuthStateChanged(auth, async (user: User | null) => {
    if (user) {
      _currentUid = user.uid;
      (window as any).__hejiCurrentUid = user.uid;
      // Load both collections; fall back to empty sets if Firestore rules aren't deployed
      const [bmSet, rlSet] = await Promise.all([
        loadBookmarks(user.uid).catch(err => {
          console.warn('[bookmarks] loadBookmarks failed:', err);
          return new Set<string>();
        }),
        loadReadingList(user.uid).catch(err => {
          console.warn('[readingList] loadReadingList failed:', err);
          return new Set<string>();
        }),
      ]);
      // Merge localStorage RL state into Firestore state (localStorage wins for items
      // that Firestore doesn't have, e.g. when security rules aren't yet deployed).
      try {
        const localSlugs: string[] = JSON.parse(localStorage.getItem('heji-rl') ?? '[]');
        localSlugs.forEach(s => rlSet.add(s));
        // Also pull slugs from the full-metadata store
        const localItems: { slug: string }[] = JSON.parse(localStorage.getItem('heji-rl-items') ?? '[]');
        localItems.forEach(i => { if (i.slug) rlSet.add(i.slug); });
      } catch (e) {}
      // Write merged slug list back so subsequent sessions start warm
      try { localStorage.setItem('heji-rl', JSON.stringify([...rlSet])); } catch (e) {}
      (window as any).__hejiBookmarks   = bmSet;
      (window as any).__hejiReadingList = rlSet;
      _applyBookmarkStates(bmSet);
      _applyRLStates(rlSet);
      _updateDropdownCount(bmSet.size);
      _updateRLDropdownCount(rlSet.size);
      _initPostPageBmBtn(bmSet);
      _initPostPageRLBtn(rlSet);
      _setUserNavVisible(true);
    } else {
      _currentUid = null;
      (window as any).__hejiCurrentUid  = null;
      (window as any).__hejiBookmarks   = null;
      (window as any).__hejiReadingList = null;
      try { localStorage.removeItem('heji-rl'); localStorage.removeItem('heji-rl-items'); } catch (e) {}
      _applyBookmarkStates(null);
      _applyRLStates(null);
      _updateDropdownCount(null);
      _updateRLDropdownCount(null);
      _removePostPageBmBtn();
      _removePostPageRLBtn();
      _setUserNavVisible(false);
    }
  });

  // Initialize upvotes when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      _initUpvotes();
      _applyUpvoteCounts();
    });
  } else {
    _initUpvotes();
    _applyUpvoteCounts();
  }
</script>

<script>
  function initExportButtons() {
    const panels = document.querySelectorAll('.vp');
    panels.forEach(vp => {
      const canvas = vp.querySelector('canvas');
      const svg = vp.querySelector('svg');
      if (!canvas && !svg) return;
      
      let head = vp.querySelector('.vp-head');
      if (!head) {
        head = document.createElement('div');
        head.className = 'vp-head';
        vp.insertBefore(head, vp.firstChild);
      }
      
      if (head.querySelector('.vp-export-btn')) return;
      
      let rightContainer = head.querySelector('.vp-head-right') as HTMLElement | null;
      if (!rightContainer) {
        rightContainer = document.createElement('div');
        rightContainer.className = 'vp-head-right';
        
        const hint = head.querySelector('.vp-hint');
        if (hint) {
          hint.parentNode?.removeChild(hint);
          rightContainer.appendChild(hint);
        }
        
        head.appendChild(rightContainer);
      }
      
      const btn = document.createElement('button');
      btn.className = 'vp-export-btn';
      btn.setAttribute('aria-label', 'Export PNG');
      btn.title = 'Export as PNG image';
      btn.innerHTML = `
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle;margin-top:-2px;">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="7 10 12 15 17 10"/>
          <line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
        <span>Export</span>
      `;
      
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        
        const panelTitle = head.querySelector('.vp-title')?.textContent || 'visualization';
        const filename = panelTitle
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/(^-|-$)/g, '') || 'export';
          
        if (canvas) {
          exportCanvas(canvas, filename);
        } else if (svg) {
          exportSVG(svg, filename);
        }
      });
      
      rightContainer.appendChild(btn);
    });
  }

  function downloadBlob(blob: Blob, filename: string) {
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  function exportCanvas(canvas: HTMLCanvasElement, filename: string) {
    const tempCanvas = document.createElement('canvas');
    tempCanvas.width = canvas.width;
    tempCanvas.height = canvas.height;
    const tempCtx = tempCanvas.getContext('2d');
    if (!tempCtx) return;
    
    const computedStyle = window.getComputedStyle(canvas.closest('.vp') || document.body);
    let bgColor = computedStyle.backgroundColor;
    if (!bgColor || bgColor === 'transparent' || bgColor === 'rgba(0, 0, 0, 0)') {
      const isLgt = document.documentElement.dataset.theme === 'light';
      bgColor = isLgt ? '#ffffff' : '#0e0e17';
    }
    
    tempCtx.fillStyle = bgColor;
    tempCtx.fillRect(0, 0, tempCanvas.width, tempCanvas.height);
    tempCtx.drawImage(canvas, 0, 0);
    
    tempCanvas.toBlob((blob) => {
      if (blob) {
        downloadBlob(blob, `${filename}.png`);
      }
    }, 'image/png');
  }

  function exportSVG(svg: SVGSVGElement, filename: string) {
    const svgClone = svg.cloneNode(true) as SVGSVGElement;
    
    svgClone.removeAttribute('class');
    svgClone.style.width = '100%';
    svgClone.style.height = '100%';
    svgClone.style.margin = '0';
    
    let cssText = ':root {';
    const rootStyles = window.getComputedStyle(document.documentElement);
    const varNames = [
      '--bg', '--surface', '--card', '--card2', '--border', '--border-hi',
      '--purple', '--purple-l', '--purple-dim', '--cyan', '--cyan-dim',
      '--green', '--green-dim', '--amber', '--red', '--text', '--text2',
      '--muted', '--muted2', '--code-bg', '--ff-sans', '--ff-mono'
    ];
    for (const name of varNames) {
      const val = rootStyles.getPropertyValue(name);
      if (val) cssText += `${name}:${val.trim()};`;
    }
    cssText += '}';
    
    cssText += `
      text {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
      }
    `;
    
    const styleEl = document.createElementNS('http://www.w3.org/2000/svg', 'style');
    styleEl.textContent = cssText;
    svgClone.insertBefore(styleEl, svgClone.firstChild);
    
    const serializer = new XMLSerializer();
    let svgString = serializer.serializeToString(svgClone);
    
    if (!svgString.match(/^<svg[^>]+xmlns="http\:\/\/www\.w3\.org\/2000\/svg"/)) {
      svgString = svgString.replace(/^<svg/, '<svg xmlns="http://www.w3.org/2000/svg"');
    }
    
    const svgBlob = new Blob([svgString], { type: 'image/svg+xml;charset=utf-8' });
    const URLObj = window.URL || window.webkitURL || window;
    const blobURL = URLObj.createObjectURL(svgBlob);
    
    const img = new Image();
    img.onload = () => {
      const canvas = document.createElement('canvas');
      const rect = svg.getBoundingClientRect();
      const width = svg.viewBox?.baseVal?.width || rect.width || 680;
      const height = svg.viewBox?.baseVal?.height || rect.height || 320;
      
      const scale = 2;
      canvas.width = width * scale;
      canvas.height = height * scale;
      
      const ctx = canvas.getContext('2d');
      if (!ctx) return;
      
      const computedStyle = window.getComputedStyle(svg.closest('.vp') || document.body);
      let bgColor = computedStyle.backgroundColor;
      if (!bgColor || bgColor === 'transparent' || bgColor === 'rgba(0, 0, 0, 0)') {
        const isLgt = document.documentElement.dataset.theme === 'light';
        bgColor = isLgt ? '#ffffff' : '#0e0e17';
      }
      
      ctx.fillStyle = bgColor;
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      
      ctx.scale(scale, scale);
      ctx.drawImage(img, 0, 0, width, height);
      
      canvas.toBlob((blob) => {
        if (blob) {
          downloadBlob(blob, `${filename}.png`);
        }
        URLObj.revokeObjectURL(blobURL);
      }, 'image/png');
    };
    
    img.onerror = (err) => {
      console.error('Failed to export SVG', err);
      URLObj.revokeObjectURL(blobURL);
    };
    
    img.src = blobURL;
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initExportButtons);
  } else {
    initExportButtons();
  }

  const observer = new MutationObserver((mutations) => {
    let shouldInit = false;
    for (const mutation of mutations) {
      if (mutation.addedNodes.length) {
        shouldInit = true;
        break;
      }
    }
    if (shouldInit) initExportButtons();
  });
  observer.observe(document.body, { childList: true, subtree: true });
</script>

</body>
</html>

    </form>
    <p id="feedback-success" class="suggest-feedback suggest-success" style="display:none" data-i18n="feedback-success">
      Thank you! Your feedback has been saved.
    </p>
    <p id="feedback-error" class="suggest-feedback suggest-error" style="display:none"></p>
  </div>
</div>

<slot />

<script>
  import { initAnalytics, analytics } from '../lib/firebase';
  import { logEvent } from 'firebase/analytics';
  import { updateReadProgress, removeFromReadingList } from '../lib/bookmarks';
  initAnalytics();

  const bar = document.getElementById('read-progress');
  if (bar) {
    const parts = window.location.pathname.replace(/\/$/, '').split('/').filter(Boolean);
    const slug = parts[0] === 'posts' && parts[1] ? parts[1] : null;
    let saveTimer: number | null = null;

    if (slug && analytics) {
      logEvent(analytics, 'view_item', {
        item_id: slug,
        item_category: 'blog_post'
      });
    }

    // Track active reading duration (only increment when tab is visible)
    let activeTimeSeconds = 0;
    let timerInterval: number | null = null;

    const startTimer = () => {
      if (timerInterval === null && slug) {
        timerInterval = setInterval(() => {
          if (document.visibilityState === 'visible') {
            activeTimeSeconds++;
            checkTimeMilestones(activeTimeSeconds);
          }
        }, 1000) as unknown as number;
      }
    };

    const stopTimer = () => {
      if (timerInterval !== null) {
        clearInterval(timerInterval);
        timerInterval = null;
      }
    };

    // Duration milestones
    const timeMilestones = [10, 30, 60, 180, 300];
    const firedTimeMilestones = new Set<number>();

    const checkTimeMilestones = (secs: number) => {
      timeMilestones.forEach(m => {
        if (secs >= m && !firedTimeMilestones.has(m)) {
          firedTimeMilestones.add(m);
          if (analytics) {
            logEvent(analytics, 'post_read_time', {
              item_id: slug,
              seconds: m
            });
          }
        }
      });
    };

    // Track visibility state
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') {
        startTimer();
      } else {
        stopTimer();
      }
    });

    if (document.visibilityState === 'visible') {
      startTimer();
    }

    const firedMilestones = new Set<number>();
    const milestones = [25, 50, 75, 100];

    const update = () => {
      const el = document.documentElement;
      const scrollable = el.scrollHeight - el.clientHeight;
      const pct = scrollable > 0 ? Math.min((el.scrollTop / scrollable) * 100, 100) : 0;
      bar.style.width = pct + '%';
      if (slug) {
        // Track milestones
        milestones.forEach(m => {
          if (pct >= m && !firedMilestones.has(m)) {
            firedMilestones.add(m);
            if (analytics) {
              logEvent(analytics, 'post_read_progress', {
                item_id: slug,
                percentage: m,
                time_spent_seconds: activeTimeSeconds
              });
            }
            // Sync progress to Firestore when this post is bookmarked
            const uid: string | null = (window as any).__hejiCurrentUid ?? null;
            const bms: Set<string> | null = (window as any).__hejiBookmarks ?? null;
            if (uid && bms?.has(slug)) {
              updateReadProgress(uid, slug, m).catch(() => {});
            }
            // Auto-remove from reading list when fully read
            const rl: Set<string> | null = (window as any).__hejiReadingList ?? null;
            if (m === 100 && uid && rl?.has(slug)) {
              rl.delete(slug);
              try { localStorage.setItem('heji-rl', JSON.stringify([...rl])); } catch (e) {}
              (window as any).__hejiApplyRL?.();
              const countEl = document.getElementById('dropdown-rl-count');
              if (countEl) {
                const n = rl.size;
                if (n <= 0) { countEl.style.display = 'none'; }
                else { countEl.textContent = String(n); countEl.style.display = ''; }
              }
              removeFromReadingList(uid, slug).catch(() => {}); // fire-and-forget Firestore sync
            }
          }
        });

        if (saveTimer !== null) clearTimeout(saveTimer);
        saveTimer = setTimeout(() => {
          let stored = 0;
          try {
            stored = parseInt(localStorage.getItem(`heji-read-${slug}`) ?? '0', 10);
          } catch (e) {}
          const next = Math.round(pct);
          if (next > stored) {
            try {
              localStorage.setItem(`heji-read-${slug}`, String(next));
            } catch (e) {}
          }
          saveTimer = null;
        }, 500);
      }
    };
    window.addEventListener('scroll', update, { passive: true });
  }
</script>


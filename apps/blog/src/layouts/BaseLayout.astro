<script>
  import { db, analytics } from '../lib/firebase';
  import { collection, addDoc, serverTimestamp } from 'firebase/firestore';
  import { logEvent } from 'firebase/analytics';

  const modal    = document.getElementById('suggest-modal')!;
  const form     = document.getElementById('suggest-form') as HTMLFormElement;
  const success  = document.getElementById('suggest-success')!;
  const errorEl  = document.getElementById('suggest-error')!;
  const submitBtn = document.getElementById('suggest-submit') as HTMLButtonElement;

  function openModal() {
    modal.setAttribute('aria-hidden', 'false');
    modal.classList.add('is-open');
    document.body.style.overflow = 'hidden';
    (document.getElementById('suggest-topic') as HTMLInputElement)?.focus();
    if (analytics) {
      logEvent(analytics, 'suggest_topic_open');
    }
  }

  function closeModal() {
    modal.setAttribute('aria-hidden', 'true');
    modal.classList.remove('is-open');
    document.body.style.overflow = '';
    form.reset();
    form.style.display = '';
    success.style.display = 'none';
    errorEl.style.display = 'none';
  }

  document.getElementById('suggest-btn')?.addEventListener('click', openModal);
  document.getElementById('suggest-btn-mobile')?.addEventListener('click', openModal);
  document.getElementById('suggest-close')?.addEventListener('click', closeModal);
  modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const topic = (document.getElementById('suggest-topic') as HTMLInputElement).value.trim();
    const email = (document.getElementById('suggest-email') as HTMLInputElement).value.trim();
    if (!topic) return;

    submitBtn.disabled = true;
    errorEl.style.display = 'none';

    try {
      await addDoc(collection(db, 'topic-suggestions'), {
        topic,
        ...(email ? { email } : {}),
        createdAt: serverTimestamp(),
      });
      form.style.display = 'none';
      success.style.display = '';
      if (analytics) {
        logEvent(analytics, 'suggest_topic_submit', { topic });
      }
    } catch (err) {
      errorEl.textContent = 'Something went wrong. Please try again.';
      errorEl.style.display = '';
      if (analytics) {
        logEvent(analytics, 'suggest_topic_error', {
          error_message: err instanceof Error ? err.message : 'Unknown'
        });
      }
    } finally {
      submitBtn.disabled = false;
    }
  });

  // ── Feedback Modal interaction ─────────────────────────────
  const feedbackModal     = document.getElementById('feedback-modal')!;
  const feedbackForm      = document.getElementById('feedback-form') as HTMLFormElement;
  const feedbackSuccess   = document.getElementById('feedback-success')!;
  const feedbackErrorEl   = document.getElementById('feedback-error')!;
  const feedbackSubmitBtn = document.getElementById('feedback-submit') as HTMLButtonElement;

  const starsContainer = document.getElementById('feedback-stars')!;
  const starBtns       = starsContainer.querySelectorAll('.star-btn');
  const ratingValue    = document.getElementById('feedback-rating-value') as HTMLInputElement;

  let currentRating = 0;

  function setRating(rating: number) {
    currentRating = rating;
    ratingValue.value = String(rating);
    starBtns.forEach((btn, idx) => {
      if (idx < rating) {
        btn.classList.add('is-active');
      } else {
        btn.classList.remove('is-active');
      }
    });
  }

  function resetRating() {
    currentRating = 0;
    ratingValue.value = '';
    starBtns.forEach((btn) => {
      btn.classList.remove('is-active');
      btn.classList.remove('is-hovered');
    });
  }

  starBtns.forEach((btn) => {
    const val = parseInt(btn.getAttribute('data-value') || '0', 10);
    btn.addEventListener('click', () => {
      setRating(val);
    });

    btn.addEventListener('mouseenter', () => {
      starBtns.forEach((b, idx) => {
        if (idx < val) {
          b.classList.add('is-hovered');
        } else {
          b.classList.remove('is-hovered');
        }
      });
    });

    btn.addEventListener('mouseleave', () => {
      starBtns.forEach((b) => b.classList.remove('is-hovered'));
    });
  });

  function openFeedbackModal() {
    feedbackModal.setAttribute('aria-hidden', 'false');
    feedbackModal.classList.add('is-open');
    document.body.style.overflow = 'hidden';
    (document.getElementById('feedback-message') as HTMLTextAreaElement)?.focus();
    if (analytics) {
      logEvent(analytics, 'feedback_open');
    }
  }

  function closeFeedbackModal() {
    feedbackModal.setAttribute('aria-hidden', 'true');
    feedbackModal.classList.remove('is-open');
    document.body.style.overflow = '';
    feedbackForm.reset();
    resetRating();
    feedbackForm.style.display = '';
    feedbackSuccess.style.display = 'none';
    feedbackErrorEl.style.display = 'none';
  }

  document.getElementById('feedback-btn')?.addEventListener('click', openFeedbackModal);
  document.getElementById('feedback-btn-mobile')?.addEventListener('click', openFeedbackModal);
  document.getElementById('feedback-close')?.addEventListener('click', closeFeedbackModal);
  feedbackModal.addEventListener('click', (e) => { if (e.target === feedbackModal) closeFeedbackModal(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeFeedbackModal(); });

  feedbackForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const message = (document.getElementById('feedback-message') as HTMLTextAreaElement).value.trim();
    const email = (document.getElementById('feedback-email') as HTMLInputElement).value.trim();
    const rating = currentRating;
    const path = window.location.pathname;

    if (!message) return;

    feedbackSubmitBtn.disabled = true;
    feedbackErrorEl.style.display = 'none';

    try {
      await addDoc(collection(db, 'feedback'), {
        message,
        createdAt: serverTimestamp(),
        ...(email ? { email } : {}),
        ...(rating ? { rating } : {}),
        path,
      });
      feedbackForm.style.display = 'none';
      feedbackSuccess.style.display = '';
      if (analytics) {
        logEvent(analytics, 'feedback_submit', { rating, path });
      }
    } catch (err) {
      feedbackErrorEl.textContent = 'Something went wrong. Please try again.';
      feedbackErrorEl.style.display = '';
      if (analytics) {
        logEvent(analytics, 'feedback_error', {
          error_message: err instanceof Error ? err.message : 'Unknown'
        });
      }
    } finally {
      feedbackSubmitBtn.disabled = false;
    }
  });
</script>


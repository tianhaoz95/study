        const avatar = container.querySelector('#auth-avatar');
        const dropdown = container.querySelector('#auth-dropdown');
        const signoutBtn = container.querySelector('#auth-signout-btn');
        const dropdownAdminLink = container.querySelector('#dropdown-admin-link') as HTMLElement | null;

        avatar?.addEventListener('click', (e) => {
          e.stopPropagation();
          dropdown?.classList.toggle('is-open');
        });

        document.addEventListener('click', () => {
          dropdown?.classList.remove('is-open');
        });

        signoutBtn?.addEventListener('click', async () => {
          try {
            await signOut(auth);
          } catch (err) {
            console.error('Sign out failed:', err);
          }
        });

        // Verify if user is an admin
        getDoc(doc(db, 'admins', email.toLowerCase())).then((docSnap) => {
          if (docSnap.exists()) {
            if (navAdminLink) {
              navAdminLink.setAttribute('href', adminUrl);
              navAdminLink.style.display = '';
            }
            if (dropdownAdminLink) {
              dropdownAdminLink.style.display = 'flex';
            }
          } else {
            if (navAdminLink) navAdminLink.style.display = 'none';
          }
        }).catch((err) => {
          console.error('Error verifying admin status:', err);
          if (navAdminLink) navAdminLink.style.display = 'none';
        });

      } else {
        if (navAdminLink) {
          navAdminLink.style.display = 'none';
        }

        container.innerHTML = `
          <button class="btn-signin" id="auth-signin-btn">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"/>
            </svg>
            Sign In
          </button>
        `;

        const signinBtn = container.querySelector('#auth-signin-btn');
        signinBtn?.addEventListener('click', async () => {
          const provider = new GoogleAuthProvider();
          try {
            await signInWithPopup(auth, provider);
          } catch (err) {
            console.error('Sign in failed:', err);
          }
        });
      }
    });
  }
</script>


<script>
  import { auth, db } from '../lib/firebase';
  import { onAuthStateChanged, signInWithPopup, GoogleAuthProvider, type User } from 'firebase/auth';
  import { doc, getDoc } from 'firebase/firestore';
  import {
    loadBookmarks, toggleBookmark,
    loadReadingList, toggleReadingList,
  } from '../lib/bookmarks';
  import { getUpvotes, getAllUpvotes, incrementUpvotes } from '../lib/upvotes';
  import { getComments, addComment, deleteComment } from '../lib/comments';

  // Per-page post slug (null if not on a post page)
  const _pathParts = window.location.pathname.replace(/\/$/, '').split('/').filter(Boolean);
  const _pageSlug = _pathParts[0] === 'posts' && _pathParts[1] ? _pathParts[1] : null;

  let _currentUid: string | null = null;

  // ── SVG helpers ────────────────────────────────────────────

  function _bmSvg(pressed: boolean): string {
    return `<svg width="11" height="11" viewBox="0 0 24 24" fill="${pressed ? 'currentColor' : 'none'}" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>`;
  }

  function _rlSvg(): string {
    return `<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`;
  }

  // ── Bookmarks ─────────────────────────────────────────────

  function _applyBookmarkStates(set: Set<string> | null) {
    document.querySelectorAll<HTMLButtonElement>('.post-bookmark-btn').forEach(btn => {
      const slug = btn.dataset.slug;
      if (!slug) return;
      const pressed = set != null && set.has(slug);
      btn.setAttribute('aria-pressed', String(pressed));
      const svgEl = btn.querySelector('svg');
      if (svgEl) svgEl.setAttribute('fill', pressed ? 'currentColor' : 'none');
    });
  }

  function _updateDropdownCount(n: number | null) {
    const countEl = document.getElementById('dropdown-bookmarks-count');
    if (!countEl) return;
    if (n === null || n === 0) { countEl.style.display = 'none'; }
    else { countEl.textContent = String(n); countEl.style.display = ''; }
  }

  function _initPostPageBmBtn(set: Set<string>) {
    if (!_pageSlug) return;
    if (document.getElementById('post-hero-bookmark')) return;
    const heroMeta = document.querySelector<HTMLElement>('.post-hero-meta');
    if (!heroMeta) return;

    const titleEl = document.querySelector<HTMLElement>('.post-hero h1');
    const tagEls  = document.querySelectorAll<HTMLElement>('.post-hero .tag');
    const dateEl  = heroMeta.querySelector<HTMLElement>('span');
    const title   = titleEl?.textContent?.trim() ?? '';
    const date    = dateEl?.textContent?.trim() ?? '';
    const href    = window.location.pathname;
    const tags: { text: string; cls: string }[] = [];
    tagEls.forEach(el => {
      const cls = Array.from(el.classList).find(c => c.startsWith('tag-')) ?? '';
      tags.push({ text: el.textContent?.trim() ?? '', cls: `tag ${cls}` });
    });

    const pressed = set.has(_pageSlug);
    const btn = document.createElement('button');
    btn.id = 'post-hero-bookmark';
    btn.className = 'post-bookmark-btn post-bookmark-hero';
    btn.setAttribute('aria-label', pressed ? 'Remove bookmark' : 'Bookmark this post');
    btn.setAttribute('aria-pressed', String(pressed));
    btn.dataset.slug  = _pageSlug;
    btn.dataset.title = title;
    btn.dataset.date  = date;
    btn.dataset.href  = href;
    btn.dataset.tags  = JSON.stringify(tags);
    btn.innerHTML = `${_bmSvg(pressed)}<span>${pressed ? 'Saved' : 'Bookmark'}</span>`;
    heroMeta.appendChild(btn);
  }

  function _removePostPageBmBtn() {
    document.getElementById('post-hero-bookmark')?.remove();
  }

  // ── Reading List ───────────────────────────────────────────

  function _applyRLStates(set: Set<string> | null) {
    document.querySelectorAll<HTMLButtonElement>('.post-rl-btn').forEach(btn => {
      const slug = btn.dataset.slug;
      if (!slug) return;
      const pressed = set != null && set.has(slug);
      btn.setAttribute('aria-pressed', String(pressed));
    });
  }

  function _updateRLDropdownCount(n: number | null) {
    const countEl = document.getElementById('dropdown-rl-count');
    if (!countEl) return;
    if (n === null || n === 0) { countEl.style.display = 'none'; }
    else { countEl.textContent = String(n); countEl.style.display = ''; }
  }

  function _initPostPageRLBtn(set: Set<string>) {
    if (!_pageSlug) return;
    if (document.getElementById('post-hero-rl')) return;
    const heroMeta = document.querySelector<HTMLElement>('.post-hero-meta');
    if (!heroMeta) return;

    const titleEl = document.querySelector<HTMLElement>('.post-hero h1');
    const tagEls  = document.querySelectorAll<HTMLElement>('.post-hero .tag');
    const dateEl  = heroMeta.querySelector<HTMLElement>('span');
    const title   = titleEl?.textContent?.trim() ?? '';
    const date    = dateEl?.textContent?.trim() ?? '';
    const href    = window.location.pathname;
    const tags: { text: string; cls: string }[] = [];
    tagEls.forEach(el => {
      const cls = Array.from(el.classList).find(c => c.startsWith('tag-')) ?? '';
      tags.push({ text: el.textContent?.trim() ?? '', cls: `tag ${cls}` });
    });

    const pressed = set.has(_pageSlug);
    const btn = document.createElement('button');
    btn.id = 'post-hero-rl';
    btn.className = 'post-rl-btn post-rl-hero';
    btn.setAttribute('aria-label', pressed ? 'Remove from reading list' : 'Add to reading list');
    btn.setAttribute('aria-pressed', String(pressed));
    btn.dataset.slug  = _pageSlug;
    btn.dataset.title = title;
    btn.dataset.date  = date;
    btn.dataset.href  = href;
    btn.dataset.tags  = JSON.stringify(tags);
    btn.innerHTML = `${_rlSvg()}<span>${pressed ? 'Queued' : 'Read Later'}</span>`;
    heroMeta.appendChild(btn);
  }

  function _removePostPageRLBtn() {
    document.getElementById('post-hero-rl')?.remove();
  }

  // ── Upvotes ────────────────────────────────────────────────

  let _upvoteCounts: Record<string, number> | null = null;

  async function _applyUpvoteCounts() {
    const cards = document.querySelectorAll<HTMLElement>('.post-card');
    if (cards.length === 0) return;

    if (!_upvoteCounts) {
      _upvoteCounts = await getAllUpvotes();
    }

    cards.forEach(card => {
      const slug = card.dataset.slug;
      if (!slug) return;

      const count = _upvoteCounts?.[slug] ?? 0;
      if (count <= 0) return;

      const meta = card.querySelector('.post-meta');
      if (!meta) return;

      let badge = meta.querySelector('.post-upvotes-badge') as HTMLElement | null;
      if (badge) {
        const countEl = badge.querySelector('.count');
        if (countEl) countEl.textContent = String(count);
        return;
      }

      badge = document.createElement('span');
      badge.className = 'post-upvotes-badge';
      badge.title = `${count} upvote${count === 1 ? '' : 's'}`;
      badge.innerHTML = `
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="18 15 12 9 6 15"></polyline>
        </svg>
        <span class="count">${count}</span>
      `;

      const arrow = meta.querySelector('.post-arrow');
      if (arrow) {
        meta.insertBefore(badge, arrow);
      } else {
        meta.appendChild(badge);
      }
    });
  }

  async function _initUpvotes() {
    if (!_pageSlug) return;

    const article = document.querySelector('article.post-body');
    if (!article) return;

    if (document.getElementById('post-upvote-sec')) return;

    const upvoteSec = document.createElement('div');
    upvoteSec.id = 'post-upvote-sec';
    upvoteSec.className = 'post-upvote-section';
    upvoteSec.innerHTML = `
      <p class="upvote-prompt">Enjoyed this deep dive?</p>
      <div class="post-actions-row">
        <button class="upvote-button" id="upvote-btn" aria-label="Upvote this post">
          <div class="upvote-icon-wrapper">
            <svg class="upvote-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="18 15 12 9 6 15"></polyline>
            </svg>
          </div>
          <span class="upvote-count" id="upvote-count-label">-</span>
        </button>
        <button class="share-button" id="share-btn" aria-label="Share this post">
          <div class="share-icon-wrapper">
            <svg class="share-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
              <polyline points="16 6 12 2 8 6"></polyline>
              <line x1="12" y1="2" x2="12" y2="15"></line>
            </svg>
          </div>
          <span class="share-text">Share</span>
        </button>
      </div>
    `;

    article.appendChild(upvoteSec);

    const btn = document.getElementById('upvote-btn') as HTMLButtonElement | null;
    const label = document.getElementById('upvote-count-label') as HTMLElement | null;
    const shareBtn = document.getElementById('share-btn') as HTMLButtonElement | null;

    if (btn && label) {
      let currentCount = await getUpvotes(_pageSlug);
      label.textContent = String(currentCount);

      let clickBuffer = 0;
      let upvoteTimeout: any = null;

      btn.addEventListener('click', () => {
        currentCount++;
        label.textContent = String(currentCount);
        clickBuffer++;

        btn.classList.remove('pop');
        void btn.offsetWidth;
        btn.classList.add('pop');

        const bubble = document.createElement('div');
        bubble.className = 'upvote-bubble';
        bubble.textContent = '+1';
        const dx = (Math.random() * 40 - 20) + 'px';
        bubble.style.setProperty('--dx', dx);
        bubble.style.left = '50%';
        btn.appendChild(bubble);

        setTimeout(() => {
          bubble.remove();
        }, 800);

        if (upvoteTimeout) clearTimeout(upvoteTimeout);
        upvoteTimeout = setTimeout(async () => {
          const toAdd = clickBuffer;
          clickBuffer = 0;
          try {
            await incrementUpvotes(_pageSlug, toAdd);
            if (_upvoteCounts) {
              _upvoteCounts[_pageSlug] = (_upvoteCounts[_pageSlug] ?? 0) + toAdd;
            }
          } catch (err) {
            console.error('[upvotes] Failed to sync upvotes:', err);
          }
        }, 500);
      });
    }

    if (shareBtn) {
      shareBtn.addEventListener('click', async () => {
        const shareData = {
          title: document.title,
          text: document.querySelector('.post-hero .lead')?.textContent?.trim() || '',
          url: window.location.href,
        };

        if (navigator.share && navigator.canShare && navigator.canShare(shareData)) {
          try {
            await navigator.share(shareData);
            return;
          } catch (e) {
            // Cancelled or unsupported parameters, fallback to clipboard copy
          }
        }

        // Fallback: Copy link to clipboard
        try {
          await navigator.clipboard.writeText(window.location.href);
          const textEl = shareBtn.querySelector('.share-text');
          if (textEl) {
            const originalText = textEl.textContent;
            textEl.textContent = 'Copied!';
            shareBtn.classList.add('copied');
            setTimeout(() => {
              textEl.textContent = originalText;
              shareBtn.classList.remove('copied');
            }, 2000);
          }
        } catch (err) {
          console.error('Failed to copy link:', err);
        }
      });
    }
  }

  (window as any).__hejiApplyUpvotes = _applyUpvoteCounts;

  // ── Click handler (capture phase) ─────────────────────────

  document.addEventListener('click', async (e: MouseEvent) => {
    const bmTarget = (e.target as Element).closest<HTMLButtonElement>('.post-bookmark-btn');
    const rlTarget = (e.target as Element).closest<HTMLButtonElement>('.post-rl-btn');
    const target = bmTarget ?? rlTarget;
    if (!target) return; // not our button — let click propagate
    e.preventDefault();
    e.stopPropagation();

    if (!_currentUid) {
      target.style.color = 'var(--red)';
      target.style.borderColor = 'var(--red)';
      setTimeout(() => { target.style.color = ''; target.style.borderColor = ''; }, 800);
      return;
    }

    const slug = target.dataset.slug ?? '';
    if (!slug) return;
    const isRL = !!rlTarget;

    if (isRL) {
      // ── Reading list toggle ──────────────────────────────
      const set: Set<string> = (window as any).__hejiReadingList ?? new Set();
      const wasInList = set.has(slug);
      wasInList ? set.delete(slug) : set.add(slug);
      (window as any).__hejiReadingList = set;

      // Build the full metadata object once (reused for both localStorage and Firestore)
      const rlMeta = {
        slug,
        title: target.dataset.title ?? '',
        date:  target.dataset.date  ?? '',
        href:  target.dataset.href  ?? '',
        tags:  (() => { try { return JSON.parse(target.dataset.tags ?? '[]'); } catch { return []; } })(),
      };

      // Persist slugs AND full metadata locally — the reading list page reads from here
      // when Firestore is unavailable (e.g. security rules not yet updated).
      try {
        localStorage.setItem('heji-rl', JSON.stringify([...set]));
        const items: typeof rlMeta[] = JSON.parse(localStorage.getItem('heji-rl-items') ?? '[]');
        if (wasInList) {
          localStorage.setItem('heji-rl-items', JSON.stringify(items.filter(i => i.slug !== slug)));
        } else {
          items.unshift(rlMeta);
          localStorage.setItem('heji-rl-items', JSON.stringify(items));
        }
      } catch (e) {}

      _applyRLStates(set);
      _updateRLDropdownCount(set.size);

      // Sync hero RL button label
      const heroBtn = document.getElementById('post-hero-rl') as HTMLButtonElement | null;
      if (heroBtn && heroBtn.dataset.slug === slug) {
        const np = !wasInList;
        heroBtn.setAttribute('aria-pressed', String(np));
        heroBtn.setAttribute('aria-label', np ? 'Remove from reading list' : 'Add to reading list');
        heroBtn.innerHTML = `${_rlSvg()}<span>${np ? 'Queued' : 'Read Later'}</span>`;
      }

      // Fire-and-forget Firestore sync — local state is the source of truth.
      toggleReadingList(_currentUid, slug, rlMeta, wasInList).catch(err => {
        console.warn('[readingList] Firestore sync failed (check Firestore security rules):', err);
      });
    } else {
      // ── Bookmark toggle ──────────────────────────────────
      const set: Set<string> = (window as any).__hejiBookmarks ?? new Set();
      const wasBookmarked = set.has(slug);
      wasBookmarked ? set.delete(slug) : set.add(slug);
      (window as any).__hejiBookmarks = set;
      _applyBookmarkStates(set);
      _updateDropdownCount(set.size);

      // Sync hero bookmark label
      const heroBtn = document.getElementById('post-hero-bookmark') as HTMLButtonElement | null;
      if (heroBtn && heroBtn.dataset.slug === slug) {
        const np = !wasBookmarked;
        heroBtn.setAttribute('aria-pressed', String(np));
        heroBtn.setAttribute('aria-label', np ? 'Remove bookmark' : 'Bookmark this post');
        heroBtn.innerHTML = `${_bmSvg(np)}<span>${np ? 'Saved' : 'Bookmark'}</span>`;
      }

      try {
        const parseTags = () => { try { return JSON.parse(target.dataset.tags ?? '[]'); } catch { return []; } };
        await toggleBookmark(_currentUid, slug, {
          slug,
          title: target.dataset.title ?? '',
          date:  target.dataset.date  ?? '',
          href:  target.dataset.href  ?? '',
          tags:  parseTags(),
        }, wasBookmarked);
      } catch (err) {
        wasBookmarked ? set.add(slug) : set.delete(slug);
        (window as any).__hejiBookmarks = set;
        _applyBookmarkStates(set);
        _updateDropdownCount(set.size);
        console.error('Bookmark toggle failed:', err);
      }
    }
  }, true); // capture phase: fires before <a> card can follow its link

  // Called by index.astro after lazy-load or search re-render
  (window as any).__hejiApplyBookmarks = () => {
    _applyBookmarkStates((window as any).__hejiBookmarks ?? null);
  };
  (window as any).__hejiApplyRL = () => {
    _applyRLStates((window as any).__hejiReadingList ?? null);
  };

  // ── Nav visibility ──────────────────────────────────────────

  function _setUserNavVisible(visible: boolean) {
    for (const id of ['mobile-bookmarks-link', 'nav-bookmarks-link',
                       'mobile-rl-link', 'nav-rl-link',
                       'mobile-collections-link', 'nav-collections-link']) {
      const el = document.getElementById(id) as HTMLElement | null;
      if (el) el.style.display = visible ? '' : 'none';
    }
  }

  // ── Comments section ────────────────────────────────────────

  let _commentsCache: any[] = [];
  let _isAdminUser = false;

  function _escapeHtml(str: string): string {
    const div = document.createElement('div');
    div.innerText = str;
    return div.innerHTML;
  }

  function _formatCommentDate(dateVal: any): string {
    if (!dateVal) return 'Just now';
    let date: Date;
    if (typeof dateVal.toDate === 'function') {
      date = dateVal.toDate();
    } else if (dateVal instanceof Date) {
      date = dateVal;
    } else {
      date = new Date(dateVal);
    }
    return date.toLocaleDateString(undefined, {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit'
    });
  }

  function _renderCommentForm(user: User | null) {
    const formContainer = document.getElementById('comment-form-container');
    if (!formContainer) return;

    if (!user) {
      formContainer.innerHTML = `
        <div class="comment-signin-prompt">
          <p class="comment-signin-text">Please sign in to join the discussion.</p>
          <div class="comment-signin-btn-wrapper">
            <button class="btn-signin-prompt" id="comment-signin-btn">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/>
                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"/>
              </svg>
              <span>Sign In with Google</span>
            </button>
          </div>
        </div>
      `;

      const signInBtn = document.getElementById('comment-signin-btn');
      signInBtn?.addEventListener('click', async () => {
        const provider = new GoogleAuthProvider();
        try {
          await signInWithPopup(auth, provider);
        } catch (err) {
          console.error('[comments] Sign in failed:', err);
        }
      });
      return;
    }

    const avatarUrl = user.photoURL || '';
    const displayName = user.displayName || 'User';

    formContainer.innerHTML = `
      <div class="comment-form-box">
        <div class="comment-form-header">
          <img src="${avatarUrl || 'https://www.gravatar.com/avatar/00000000000000000000000000000000?d=mp&f=y'}" class="comment-user-avatar" id="comment-form-avatar" alt="${_escapeHtml(displayName)}" />
          <span class="comment-user-name" id="comment-form-username">${_escapeHtml(displayName)}</span>
        </div>
        <div class="comment-textarea-wrapper">
          <textarea class="comment-textarea" id="comment-input" placeholder="Join the discussion... Keep it respectful." maxlength="2000"></textarea>
        </div>
        <div class="comment-form-actions">
          <label class="comment-anonymous-label">
            <input type="checkbox" class="comment-anonymous-checkbox" id="comment-anon-check" />
            Comment anonymously
          </label>
          <button class="comment-submit-btn" id="comment-submit-btn" disabled>Post Comment</button>
        </div>
        <div class="comment-submit-error" id="comment-submit-error"></div>
      </div>
    `;

    const commentInput = document.getElementById('comment-input') as HTMLTextAreaElement | null;
    const submitBtn = document.getElementById('comment-submit-btn') as HTMLButtonElement | null;
    const anonCheck = document.getElementById('comment-anon-check') as HTMLInputElement | null;
    const formUsername = document.getElementById('comment-form-username');
    const formAvatar = document.getElementById('comment-form-avatar') as HTMLImageElement | null;
    const submitError = document.getElementById('comment-submit-error');

    if (commentInput && submitBtn) {
      commentInput.addEventListener('input', () => {
        const val = commentInput.value.trim();
        submitBtn.disabled = val.length === 0;
      });

      anonCheck?.addEventListener('change', () => {
        const isAnon = anonCheck.checked;
        if (isAnon) {
          if (formUsername) formUsername.innerText = 'Anonymous';
          if (formAvatar) {
            formAvatar.src = 'https://www.gravatar.com/avatar/00000000000000000000000000000000?d=mp&f=y';
          }
        } else {
          if (formUsername) formUsername.innerText = displayName;
          if (formAvatar) {
            formAvatar.src = avatarUrl || 'https://www.gravatar.com/avatar/00000000000000000000000000000000?d=mp&f=y';
          }
        }
      });

      submitBtn.addEventListener('click', async () => {
        const content = commentInput.value.trim();
        if (!content) return;

        submitBtn.disabled = true;
        commentInput.disabled = true;
        if (anonCheck) anonCheck.disabled = true;
        if (submitError) submitError.style.display = 'none';

        try {
          const isAnon = anonCheck ? anonCheck.checked : false;
          const newComment = await addComment(_pageSlug!, user.uid, displayName, avatarUrl, content, isAnon);
          
          _commentsCache.push(newComment);
          _renderCommentsList(_commentsCache, user);

          commentInput.value = '';
          commentInput.disabled = false;
          if (anonCheck) {
            anonCheck.checked = false;
            anonCheck.disabled = false;
          }
          if (formUsername) formUsername.innerText = displayName;
          if (formAvatar) formAvatar.src = avatarUrl || 'https://www.gravatar.com/avatar/00000000000000000000000000000000?d=mp&f=y';
        } catch (err: any) {
          console.error('[comments] Failed to add comment:', err);
          submitBtn.disabled = false;
          commentInput.disabled = false;
          if (anonCheck) anonCheck.disabled = false;
          if (submitError) {
            submitError.innerText = 'Failed to post comment. Please try again.';
            submitError.style.display = 'block';
          }
        }
      });
    }
  }

  function _renderCommentsList(comments: any[], user: User | null) {
    const badge = document.getElementById('comments-count-badge');
    if (badge) {
      badge.innerText = String(comments.length);
      badge.style.display = comments.length > 0 ? 'inline-block' : 'none';
    }

    const listContainer = document.getElementById('comments-list-container');
    if (!listContainer) return;

    if (comments.length === 0) {
      listContainer.innerHTML = `
        <div class="comments-empty">No comments yet. Be the first to start the discussion!</div>
      `;
      return;
    }

    let html = `<div class="comments-list">`;
    comments.forEach(comment => {
      const canDelete = user && (comment.authorUid === user.uid || _isAdminUser);
      const isAnon = comment.isAnonymous;
      
      html += `
        <div class="comment-card" id="comment-card-${comment.id}">
          <div class="comment-avatar-wrapper">
            ${isAnon || !comment.authorAvatar ? `
              <svg class="comment-author-avatar" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="background: var(--surface); padding: 7px; border: 1px solid var(--border-hi);"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            ` : `
               <img src="${comment.authorAvatar}" class="comment-author-avatar" alt="${_escapeHtml(comment.authorName)}" />
            `}
          </div>
          <div class="comment-content-wrapper">
            <div class="comment-meta">
              <span class="comment-author-name ${isAnon ? 'anonymous' : ''}">${_escapeHtml(comment.authorName)}</span>
              <span class="comment-date">${_formatCommentDate(comment.createdAt)}</span>
            </div>
            <div class="comment-body">${_escapeHtml(comment.content)}</div>
          </div>
          ${canDelete ? `
            <button class="comment-delete-btn" data-comment-id="${comment.id}" title="Delete comment">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
            </button>
          ` : ''}
        </div>
      `;
    });
    html += `</div>`;
    listContainer.innerHTML = html;

    listContainer.querySelectorAll('.comment-delete-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const commentId = btn.getAttribute('data-comment-id');
        if (!commentId || !_pageSlug) return;

        if (confirm('Are you sure you want to delete this comment?')) {
          try {
            (btn as HTMLButtonElement).disabled = true;
            await deleteComment(_pageSlug, commentId);
            _commentsCache = _commentsCache.filter(c => c.id !== commentId);
            _renderCommentsList(_commentsCache, user);
          } catch (err) {
            console.error('[comments] Failed to delete comment:', err);
            alert('Failed to delete comment. Please try again.');
            (btn as HTMLButtonElement).disabled = false;
          }
        }
      });
    });
  }

  async function _initComments() {
    if (!_pageSlug) return;

    const article = document.querySelector('article.post-body');
    if (!article) return;

    if (document.getElementById('post-comments-sec')) return;

    const commentsSec = document.createElement('div');
    commentsSec.id = 'post-comments-sec';
    commentsSec.className = 'post-comments-section';
    commentsSec.innerHTML = `
      <h3 class="comments-title">
        Discussion <span class="count-badge" id="comments-count-badge" style="display:none">0</span>
      </h3>
      <div id="comment-form-container"></div>
      <div id="comments-list-container">
        <div class="comments-loading">Loading comments...</div>
      </div>
    `;
    article.appendChild(commentsSec);

    _renderCommentForm(auth.currentUser);

    try {
      const comments = await getComments(_pageSlug);
      _commentsCache = comments;
      _renderCommentsList(comments, auth.currentUser);
    } catch (err) {
      console.error('[comments] Initial load failed:', err);
      const listContainer = document.getElementById('comments-list-container');
      if (listContainer) {
        listContainer.innerHTML = `<div class="comments-empty">Failed to load comments.</div>`;
      }
    }
  }

  // ── Auth state ──────────────────────────────────────────────

  onAuthStateChanged(auth, async (user: User | null) => {
    if (user) {
      _currentUid = user.uid;
      (window as any).__hejiCurrentUid = user.uid;

      // Verify admin status for comments deletion
      try {
        const adminSnap = await getDoc(doc(db, 'admins', user.email?.toLowerCase() || ''));
        _isAdminUser = adminSnap.exists();
      } catch (e) {
        _isAdminUser = false;
      }

      // Render/update comments UI
      _renderCommentForm(user);
      _renderCommentsList(_commentsCache, user);

      // Load both collections; fall back to empty sets if Firestore rules aren't deployed
      const [bmSet, rlSet] = await Promise.all([
        loadBookmarks(user.uid).catch(err => {
          console.warn('[bookmarks] loadBookmarks failed:', err);
          return new Set<string>();
        }),
        loadReadingList(user.uid).catch(err => {
          console.warn('[readingList] loadReadingList failed:', err);
          return new Set<string>();
        }),
      ]);
      // Merge localStorage RL state into Firestore state (localStorage wins for items
      // that Firestore doesn't have, e.g. when security rules aren't yet deployed).
      try {
        const localSlugs: string[] = JSON.parse(localStorage.getItem('heji-rl') ?? '[]');
        localSlugs.forEach(s => rlSet.add(s));
        // Also pull slugs from the full-metadata store
        const localItems: { slug: string }[] = JSON.parse(localStorage.getItem('heji-rl-items') ?? '[]');
        localItems.forEach(i => { if (i.slug) rlSet.add(i.slug); });
      } catch (e) {}
      // Write merged slug list back so subsequent sessions start warm
      try { localStorage.setItem('heji-rl', JSON.stringify([...rlSet])); } catch (e) {}
      (window as any).__hejiBookmarks   = bmSet;
      (window as any).__hejiReadingList = rlSet;
      _applyBookmarkStates(bmSet);
      _applyRLStates(rlSet);
      _updateDropdownCount(bmSet.size);
      _updateRLDropdownCount(rlSet.size);
      _initPostPageBmBtn(bmSet);
      _initPostPageRLBtn(rlSet);
      _setUserNavVisible(true);
    } else {
      _currentUid = null;
      _isAdminUser = false;
      (window as any).__hejiCurrentUid  = null;
      (window as any).__hejiBookmarks   = null;
      (window as any).__hejiReadingList = null;

      // Render/update comments UI for logged out
      _renderCommentForm(null);
      _renderCommentsList(_commentsCache, null);

      try { localStorage.removeItem('heji-rl'); localStorage.removeItem('heji-rl-items'); } catch (e) {}
      _applyBookmarkStates(null);
      _applyRLStates(null);
      _updateDropdownCount(null);
      _updateRLDropdownCount(null);
      _removePostPageBmBtn();
      _removePostPageRLBtn();
      _setUserNavVisible(false);
    }
  });

  // Initialize upvotes and comments when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      _initUpvotes();
      _applyUpvoteCounts();
      _initComments();
    });
  } else {
    _initUpvotes();
    _applyUpvoteCounts();
    _initComments();
  }
</script>

<script>
  // ── Collections: "Add to collection" picker ─────────────────
  import { auth } from '../lib/firebase';
  import { onAuthStateChanged, type User } from 'firebase/auth';
  import {
    listCollectionsWithMembership,
    addPostToCollection,
    removePostFromCollection,
    createCollection,
    listCollections,
    type CollectionWithMembership,
  } from '../lib/collections';
  import type { BookmarkMeta } from '../lib/bookmarks';

  const _cPathParts = window.location.pathname.replace(/\/$/, '').split('/').filter(Boolean);
  const _cPageSlug = _cPathParts[0] === 'posts' && _cPathParts[1] ? _cPathParts[1] : null;

  let _cUser: User | null = null;
  let _activeMeta: BookmarkMeta | null = null;
  let _picker: CollectionWithMembership[] = [];

  const modal      = document.getElementById('collection-modal');
  const postLabel  = document.getElementById('collection-modal-post');
  const listEl     = document.getElementById('collection-picker-list');
  const createForm = document.getElementById('collection-create-form') as HTMLFormElement | null;
  const nameInput  = document.getElementById('collection-new-name') as HTMLInputElement | null;
  const errorEl    = document.getElementById('collection-error');

  function _cSvg(): string {
    return `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>`;
  }

  function _esc(s: string): string {
    const d = document.createElement('div');
    d.innerText = s;
    return d.innerHTML;
  }

  function _metaFromBtn(btn: HTMLElement): BookmarkMeta {
    let tags: { text: string; cls: string }[] = [];
    try { tags = JSON.parse(btn.dataset.tags ?? '[]'); } catch (e) {}
    return {
      slug:  btn.dataset.slug  ?? '',
      title: btn.dataset.title ?? '',
      date:  btn.dataset.date  ?? '',
      href:  btn.dataset.href  ?? '',
      tags,
    };
  }

  function _openModal() {
    if (!modal) return;
    modal.setAttribute('aria-hidden', 'false');
    modal.classList.add('is-open');
    document.body.style.overflow = 'hidden';
    if (errorEl) errorEl.style.display = 'none';
  }

  function _closeModal() {
    if (!modal) return;
    modal.setAttribute('aria-hidden', 'true');
    modal.classList.remove('is-open');
    document.body.style.overflow = '';
    _activeMeta = null;
    if (createForm) createForm.reset();
  }

  function _renderPicker() {
    if (!listEl) return;
    if (_picker.length === 0) {
      listEl.innerHTML = `<div class="collection-picker-empty">No collections yet. Create one below to get started.</div>`;
      return;
    }
    listEl.innerHTML = _picker.map(c => `
      <button class="collection-picker-row ${c.hasPost ? 'is-member' : ''}" data-cid="${_esc(c.id)}" aria-pressed="${c.hasPost}">
        <span class="collection-picker-check" aria-hidden="true">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        </span>
        <span class="collection-picker-name">${_esc(c.name)}</span>
        <span class="collection-picker-count">${c.postCount}</span>
      </button>
    `).join('');
  }

  async function _toggleMembership(cid: string) {
    if (!_cUser || !_activeMeta) return;
    const entry = _picker.find(c => c.id === cid);
    if (!entry) return;
    const meta = _activeMeta;
    const wasMember = entry.hasPost;
    // Optimistic update
    entry.hasPost = !wasMember;
    entry.postCount = Math.max(0, entry.postCount + (wasMember ? -1 : 1));
    _renderPicker();
    try {
      if (wasMember) {
        await removePostFromCollection(_cUser.uid, cid, meta.slug);
      } else {
        await addPostToCollection(_cUser.uid, cid, meta);
      }
    } catch (err) {
      // Revert on failure
      entry.hasPost = wasMember;
      entry.postCount = Math.max(0, entry.postCount + (wasMember ? 1 : -1));
      _renderPicker();
      if (errorEl) {
        errorEl.textContent = 'Could not update collection. Please try again.';
        errorEl.style.display = '';
      }
      console.error('[collections] toggle failed:', err);
    }
  }

  async function _openPickerForButton(btn: HTMLElement) {
    if (!_cUser) {
      btn.style.color = 'var(--red)';
      btn.style.borderColor = 'var(--red)';
      setTimeout(() => { btn.style.color = ''; btn.style.borderColor = ''; }, 800);
      return;
    }
    _activeMeta = _metaFromBtn(btn);
    if (!_activeMeta.slug) return;
    if (postLabel) postLabel.textContent = _activeMeta.title || 'this post';
    _openModal();
    if (listEl) listEl.innerHTML = `<div class="collection-picker-loading">Loading…</div>`;
    try {
      _picker = await listCollectionsWithMembership(_cUser.uid, _activeMeta.slug);
      _renderPicker();
    } catch (err) {
      console.error('[collections] load failed:', err);
      if (listEl) listEl.innerHTML = `<div class="collection-picker-empty">Failed to load collections.</div>`;
    }
  }

  // Click handler (capture phase): cards are <a>, so intercept before navigation
  document.addEventListener('click', (e: MouseEvent) => {
    const btn = (e.target as Element).closest<HTMLButtonElement>('.post-collection-btn');
    if (!btn) return;
    e.preventDefault();
    e.stopPropagation();
    _openPickerForButton(btn);
  }, true);

  // Picker row toggles
  listEl?.addEventListener('click', (e: MouseEvent) => {
    const row = (e.target as Element).closest<HTMLButtonElement>('.collection-picker-row');
    if (!row) return;
    const cid = row.dataset.cid;
    if (cid) _toggleMembership(cid);
  });

  // Create-and-add
  createForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!_cUser || !_activeMeta || !nameInput) return;
    const name = nameInput.value.trim();
    if (!name) return;
    const submitBtn = document.getElementById('collection-create-submit') as HTMLButtonElement | null;
    if (submitBtn) submitBtn.disabled = true;
    if (errorEl) errorEl.style.display = 'none';
    try {
      const cid = await createCollection(_cUser.uid, name);
      await addPostToCollection(_cUser.uid, cid, _activeMeta);
      _picker.unshift({ id: cid, name, postCount: 1, hasPost: true });
      _renderPicker();
      nameInput.value = '';
      _updateCollectionsCount(_picker.length);
    } catch (err) {
      console.error('[collections] create failed:', err);
      if (errorEl) {
        errorEl.textContent = 'Could not create collection. Please try again.';
        errorEl.style.display = '';
      }
    } finally {
      if (submitBtn) submitBtn.disabled = false;
    }
  });

  document.getElementById('collection-close')?.addEventListener('click', _closeModal);
  modal?.addEventListener('click', (e) => { if (e.target === modal) _closeModal(); });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal?.classList.contains('is-open')) _closeModal();
  });

  // ── Hero "Add to collection" button (post pages) ────────────
  function _initPostPageCollectionBtn() {
    if (!_cPageSlug) return;
    if (document.getElementById('post-hero-collection')) return;
    const heroMeta = document.querySelector<HTMLElement>('.post-hero-meta');
    if (!heroMeta) return;

    const titleEl = document.querySelector<HTMLElement>('.post-hero h1');
    const tagEls  = document.querySelectorAll<HTMLElement>('.post-hero .tag');
    const dateEl  = heroMeta.querySelector<HTMLElement>('span');
    const tags: { text: string; cls: string }[] = [];
    tagEls.forEach(el => {
      const cls = Array.from(el.classList).find(c => c.startsWith('tag-')) ?? '';
      tags.push({ text: el.textContent?.trim() ?? '', cls: `tag ${cls}` });
    });

    const btn = document.createElement('button');
    btn.id = 'post-hero-collection';
    btn.className = 'post-collection-btn post-collection-hero';
    btn.setAttribute('aria-label', 'Add to collection');
    btn.dataset.slug  = _cPageSlug;
    btn.dataset.title = titleEl?.textContent?.trim() ?? '';
    btn.dataset.date  = dateEl?.textContent?.trim() ?? '';
    btn.dataset.href  = window.location.pathname;
    btn.dataset.tags  = JSON.stringify(tags);
    btn.innerHTML = `${_cSvg()}<span>Collect</span>`;
    heroMeta.appendChild(btn);
  }

  function _removePostPageCollectionBtn() {
    document.getElementById('post-hero-collection')?.remove();
  }

  function _updateCollectionsCount(n: number | null) {
    const el = document.getElementById('dropdown-collections-count');
    if (!el) return;
    if (n === null || n === 0) { el.style.display = 'none'; }
    else { el.textContent = String(n); el.style.display = ''; }
  }

  onAuthStateChanged(auth, async (user: User | null) => {
    _cUser = user;
    if (user) {
      _initPostPageCollectionBtn();
      try {
        const cols = await listCollections(user.uid);
        _updateCollectionsCount(cols.length);
      } catch (err) {
        console.warn('[collections] count load failed:', err);
      }
    } else {
      _removePostPageCollectionBtn();
      _updateCollectionsCount(null);
      if (modal?.classList.contains('is-open')) _closeModal();
    }
  });
</script>

<script>
  function initExportButtons() {
    const panels = document.querySelectorAll('.vp');
    panels.forEach(vp => {
      const canvas = vp.querySelector('canvas');
      const svg = vp.querySelector('svg');
      if (!canvas && !svg) return;
      
      let head = vp.querySelector('.vp-head');
      if (!head) {
        head = document.createElement('div');
        head.className = 'vp-head';
        vp.insertBefore(head, vp.firstChild);
      }
      
      if (head.querySelector('.vp-export-btn')) return;
      
      let rightContainer = head.querySelector('.vp-head-right') as HTMLElement | null;
      if (!rightContainer) {
        rightContainer = document.createElement('div');
        rightContainer.className = 'vp-head-right';
        
        const hint = head.querySelector('.vp-hint');
        if (hint) {
          hint.parentNode?.removeChild(hint);
          rightContainer.appendChild(hint);
        }
        
        head.appendChild(rightContainer);
      }
      
      const btn = document.createElement('button');
      btn.className = 'vp-export-btn';
      btn.setAttribute('aria-label', 'Export PNG');
      btn.title = 'Export as PNG image';
      btn.innerHTML = `
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle;margin-top:-2px;">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="7 10 12 15 17 10"/>
          <line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
        <span>Export</span>
      `;
      
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        
        const panelTitle = head.querySelector('.vp-title')?.textContent || 'visualization';
        const filename = panelTitle
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/(^-|-$)/g, '') || 'export';
          
        if (canvas) {
          exportCanvas(canvas, filename);
        } else if (svg) {
          exportSVG(svg, filename);
        }
      });
      
      rightContainer.appendChild(btn);
    });
  }

  function downloadBlob(blob: Blob, filename: string) {
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  function exportCanvas(canvas: HTMLCanvasElement, filename: string) {
    const tempCanvas = document.createElement('canvas');
    tempCanvas.width = canvas.width;
    tempCanvas.height = canvas.height;
    const tempCtx = tempCanvas.getContext('2d');
    if (!tempCtx) return;
    
    const computedStyle = window.getComputedStyle(canvas.closest('.vp') || document.body);
    let bgColor = computedStyle.backgroundColor;
    if (!bgColor || bgColor === 'transparent' || bgColor === 'rgba(0, 0, 0, 0)') {
      const isLgt = document.documentElement.dataset.theme === 'light';
      bgColor = isLgt ? '#ffffff' : '#0e0e17';
    }
    
    tempCtx.fillStyle = bgColor;
    tempCtx.fillRect(0, 0, tempCanvas.width, tempCanvas.height);
    tempCtx.drawImage(canvas, 0, 0);
    
    tempCanvas.toBlob((blob) => {
      if (blob) {
        downloadBlob(blob, `${filename}.png`);
      }
    }, 'image/png');
  }

  function exportSVG(svg: SVGSVGElement, filename: string) {
    const svgClone = svg.cloneNode(true) as SVGSVGElement;
    
    svgClone.removeAttribute('class');
    svgClone.style.width = '100%';
    svgClone.style.height = '100%';
    svgClone.style.margin = '0';
    
    let cssText = ':root {';
    const rootStyles = window.getComputedStyle(document.documentElement);
    const varNames = [
      '--bg', '--surface', '--card', '--card2', '--border', '--border-hi',
      '--purple', '--purple-l', '--purple-dim', '--cyan', '--cyan-dim',
      '--green', '--green-dim', '--amber', '--red', '--text', '--text2',
      '--muted', '--muted2', '--code-bg', '--ff-sans', '--ff-mono'
    ];
    for (const name of varNames) {
      const val = rootStyles.getPropertyValue(name);
      if (val) cssText += `${name}:${val.trim()};`;
    }
    cssText += '}';
    
    cssText += `
      text {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
      }
    `;
    
    const styleEl = document.createElementNS('http://www.w3.org/2000/svg', 'style');
    styleEl.textContent = cssText;
    svgClone.insertBefore(styleEl, svgClone.firstChild);
    
    const serializer = new XMLSerializer();
    let svgString = serializer.serializeToString(svgClone);
    
    if (!svgString.match(/^<svg[^>]+xmlns="http\:\/\/www\.w3\.org\/2000\/svg"/)) {
      svgString = svgString.replace(/^<svg/, '<svg xmlns="http://www.w3.org/2000/svg"');
    }
    
    const svgBlob = new Blob([svgString], { type: 'image/svg+xml;charset=utf-8' });
    const URLObj = window.URL || window.webkitURL || window;
    const blobURL = URLObj.createObjectURL(svgBlob);
    
    const img = new Image();
    img.onload = () => {
      const canvas = document.createElement('canvas');
      const rect = svg.getBoundingClientRect();
      const width = svg.viewBox?.baseVal?.width || rect.width || 680;
      const height = svg.viewBox?.baseVal?.height || rect.height || 320;
      
      const scale = 2;
      canvas.width = width * scale;
      canvas.height = height * scale;
      
      const ctx = canvas.getContext('2d');
      if (!ctx) return;
      
      const computedStyle = window.getComputedStyle(svg.closest('.vp') || document.body);
      let bgColor = computedStyle.backgroundColor;
      if (!bgColor || bgColor === 'transparent' || bgColor === 'rgba(0, 0, 0, 0)') {
        const isLgt = document.documentElement.dataset.theme === 'light';
        bgColor = isLgt ? '#ffffff' : '#0e0e17';
      }
      
      ctx.fillStyle = bgColor;
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      
      ctx.scale(scale, scale);
      ctx.drawImage(img, 0, 0, width, height);
      
      canvas.toBlob((blob) => {
        if (blob) {
          downloadBlob(blob, `${filename}.png`);
        }
        URLObj.revokeObjectURL(blobURL);
      }, 'image/png');
    };
    
    img.onerror = (err) => {
      console.error('Failed to export SVG', err);
      URLObj.revokeObjectURL(blobURL);
    };
    
    img.src = blobURL;
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initExportButtons);
  } else {
    initExportButtons();
  }

  const observer = new MutationObserver((mutations) => {
    let shouldInit = false;
    for (const mutation of mutations) {
      if (mutation.addedNodes.length) {
        shouldInit = true;
        break;
      }
    }
    if (shouldInit) initExportButtons();
  });
  observer.observe(document.body, { childList: true, subtree: true });
</script>

<script>
  import { auth, db, analytics } from '../lib/firebase';
  import { onAuthStateChanged, signInWithPopup, GoogleAuthProvider, type User } from 'firebase/auth';
  import { doc, setDoc, serverTimestamp } from 'firebase/firestore';
  import { logEvent } from 'firebase/analytics';

  let hasUserResolved = false;
  let currentUser: User | null = null;
  let isPromptShown = false;

  // Local storage helpers
  const checkDismissed = () => {
    try {
      return localStorage.getItem('heji-subscribe-prompt-dismissed') === 'true';
    } catch (e) {
      return false;
    }
  };

  const setDismissed = () => {
    try {
      localStorage.setItem('heji-subscribe-prompt-dismissed', 'true');
    } catch (e) {}
  };

  const checkSubscribed = () => {
    try {
      return localStorage.getItem('heji-subscribed') === 'true';
    } catch (e) {
      return false;
    }
  };

  const setSubscribed = () => {
    try {
      localStorage.setItem('heji-subscribed', 'true');
    } catch (e) {}
  };

  // DOM Elements
  const promptModal = document.getElementById('subscribe-prompt-modal');
  const closeBtn = document.getElementById('subscribe-prompt-close');
  const signInBtn = document.getElementById('subscribe-prompt-signin-btn');
  const form = document.getElementById('subscribe-prompt-form') as HTMLFormElement | null;
  const emailInput = document.getElementById('subscribe-prompt-email') as HTMLInputElement | null;
  const successEl = document.getElementById('subscribe-prompt-success');
  const errorEl = document.getElementById('subscribe-prompt-error');
  const submitBtn = document.getElementById('subscribe-prompt-submit-btn') as HTMLButtonElement | null;

  function showPrompt(triggerSource: string) {
    if (isPromptShown || currentUser || checkDismissed() || checkSubscribed()) return;
    if (!promptModal) return;

    promptModal.setAttribute('aria-hidden', 'false');
    promptModal.classList.add('is-open');
    document.body.style.overflow = 'hidden';
    isPromptShown = true;

    if (analytics) {
      logEvent(analytics, 'subscribe_prompt_open', { source: triggerSource });
    }
  }

  function hidePrompt() {
    if (!promptModal) return;
    promptModal.setAttribute('aria-hidden', 'true');
    promptModal.classList.remove('is-open');
    document.body.style.overflow = '';
    isPromptShown = false;
  }

  // Bind close buttons and outside clicks
  closeBtn?.addEventListener('click', () => {
    setDismissed();
    hidePrompt();
    if (analytics) logEvent(analytics, 'subscribe_prompt_dismiss');
  });

  promptModal?.addEventListener('click', (e) => {
    if (e.target === promptModal) {
      setDismissed();
      hidePrompt();
      if (analytics) logEvent(analytics, 'subscribe_prompt_dismiss');
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isPromptShown) {
      setDismissed();
      hidePrompt();
      if (analytics) logEvent(analytics, 'subscribe_prompt_dismiss');
    }
  });

  // Google Sign-In inside prompt
  signInBtn?.addEventListener('click', async () => {
    const provider = new GoogleAuthProvider();
    try {
      await signInWithPopup(auth, provider);
      if (analytics) logEvent(analytics, 'subscribe_prompt_signin_success');
    } catch (err) {
      console.error('Sign in failed inside subscribe prompt:', err);
    }
  });

  // Subscription form submit inside prompt
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!emailInput || !submitBtn) return;
    const email = emailInput.value.trim();
    if (!email) return;

    submitBtn.disabled = true;
    if (errorEl) errorEl.style.display = 'none';
    if (successEl) successEl.style.display = 'none';

    try {
      await setDoc(doc(db, 'subscriptions', email.toLowerCase()), {
        email: email.toLowerCase(),
        source: 'blog-popup',
        subscribedAt: serverTimestamp(),
      }, { merge: true });

      setSubscribed();
      if (successEl) successEl.style.display = 'block';
      if (analytics) logEvent(analytics, 'subscribe_prompt_submit_success', { email: email.toLowerCase() });

      setTimeout(() => {
        hidePrompt();
      }, 2000);
    } catch (err) {
      console.error('Subscription failed in prompt:', err);
      if (errorEl) {
        errorEl.textContent = 'Failed to subscribe. Please try again.';
        errorEl.style.display = 'block';
      }
      submitBtn.disabled = false;
      if (analytics) logEvent(analytics, 'subscribe_prompt_submit_error', { error: err instanceof Error ? err.message : 'Unknown' });
    }
  });

  // Listen to Auth state
  onAuthStateChanged(auth, (user: User | null) => {
    hasUserResolved = true;
    currentUser = user;
    if (user) {
      hidePrompt();
    }
  });

  // 1. Time-on-site trigger (> 1 minute = 60000ms)
  let sessionStart = '';
  try {
    sessionStart = sessionStorage.getItem('heji-session-start') || '';
    if (!sessionStart) {
      sessionStart = String(Date.now());
      sessionStorage.setItem('heji-session-start', sessionStart);
    }
  } catch (e) {
    sessionStart = String(Date.now());
  }
  const sessionStartMs = parseInt(sessionStart, 10) || Date.now();

  const checkTimer = () => {
    if (currentUser || checkDismissed() || checkSubscribed()) return;

    const elapsed = Date.now() - sessionStartMs;
    if (elapsed >= 60000) {
      showPrompt('time');
    } else {
      setTimeout(checkTimer, 1000);
    }
  };
  setTimeout(checkTimer, 1000);

  // 2. Scroll percentage trigger (80% of a post)
  const trackScrollTrigger = () => {
    if (!hasUserResolved || currentUser || checkDismissed() || checkSubscribed()) return;

    // Check if we are on a post page
    const parts = window.location.pathname.replace(/\/$/, '').split('/').filter(Boolean);
    const isPostPage = parts[0] === 'posts' && parts[1];
    if (!isPostPage) return;

    const isSplit = document.body.classList.contains('split-view-active');
    const el = isSplit ? (document.getElementById('split-view-left') || document.documentElement) : document.documentElement;
    const scrollable = el.scrollHeight - el.clientHeight;
    const pct = scrollable > 0 ? (el.scrollTop / scrollable) * 100 : 0;
    if (pct >= 80) {
      showPrompt('scroll');
    }
  };
  window.addEventListener('scroll', trackScrollTrigger, { passive: true });
  document.addEventListener('scroll', (e) => {
    if (e.target && (e.target as HTMLElement).id === 'split-view-left') {
      trackScrollTrigger();
    }
  }, { capture: true, passive: true });
</script>

<script>
  // Split View functionality for Research Papers & Code Repositories
  (function() {
    function getCleanUrlAndType(url: string, linkText: string): { cleanUrl: string; type: 'pdf' | 'code'; title: string } {
      let cleanUrl = url;
      if (cleanUrl.includes('github.com/')) {
        // Convert to github1s
        cleanUrl = cleanUrl.replace('github.com/', 'github1s.com/');
        
        // Extract repo name for title
        const pathPart = url.split('github.com/')[1] || '';
        const parts = pathPart.split('/').filter(Boolean);
        const repoName = parts[1] ? `${parts[0]}/${parts[1]}` : 'Repository';
        
        return {
          cleanUrl,
          type: 'code',
          title: `Code: ${repoName}`
        };
      }
      
      // Convert arXiv abstract URL to direct PDF URL
      if (cleanUrl.includes('arxiv.org/abs/')) {
        cleanUrl = cleanUrl.replace('/abs/', '/pdf/');
        if (!cleanUrl.endsWith('.pdf')) {
          cleanUrl += '.pdf';
        }
      }
      
      return {
        cleanUrl,
        type: 'pdf',
        title: 'Research Paper'
      };
    }

    function openSplitView(rawUrl: string, linkText: string) {
      const container = document.getElementById('split-view-container');
      const rightPane = document.getElementById('split-view-right');
      const body = document.getElementById('split-view-body');
      const extLink = document.getElementById('split-view-external') as HTMLAnchorElement;
      const titleEl = document.getElementById('split-view-title');
      
      if (!container || !rightPane || !body) return;
      
      const { cleanUrl, type, title } = getCleanUrlAndType(rawUrl, linkText);
      
      if (extLink) {
        extLink.href = rawUrl;
      }
      
      if (titleEl) {
        titleEl.textContent = title;
      }
      
      body.innerHTML = '';
      const iframe = document.createElement('iframe');
      iframe.src = cleanUrl;
      iframe.title = title;
      iframe.setAttribute('allow', 'clipboard-write');
      body.appendChild(iframe);
      
      rightPane.style.display = 'flex';
      document.body.classList.add('split-view-active');
      window.dispatchEvent(new Event('resize'));
    }

    function closeSplitView() {
      const rightPane = document.getElementById('split-view-right');
      const body = document.getElementById('split-view-body');
      
      if (rightPane) rightPane.style.display = 'none';
      if (body) body.innerHTML = '';
      
      document.body.classList.remove('split-view-active');
      
      const leftPane = document.getElementById('split-view-left');
      if (leftPane) leftPane.style.width = '';
      if (rightPane) rightPane.style.width = '';
      
      window.dispatchEvent(new Event('resize'));
    }

    // Set up resizable divider dragging
    const divider = document.getElementById('split-view-divider');
    const leftPane = document.getElementById('split-view-left');
    const rightPane = document.getElementById('split-view-right');
    const container = document.getElementById('split-view-container');

    if (divider && leftPane && rightPane && container) {
      let isDragging = false;
      
      divider.addEventListener('mousedown', (e) => {
        isDragging = true;
        divider.classList.add('dragging');
        document.body.style.cursor = 'col-resize';
        rightPane.classList.add('dragging-active');
        e.preventDefault();
      });
      
      document.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        const containerWidth = container.clientWidth;
        const percentage = (e.clientX / containerWidth) * 100;
        
        if (percentage > 20 && percentage < 80) {
          leftPane.style.width = `${percentage}%`;
          rightPane.style.width = `${100 - percentage}%`;
        }
      });
      
      document.addEventListener('mouseup', () => {
        if (isDragging) {
          isDragging = false;
          divider.classList.remove('dragging');
          document.body.style.cursor = '';
          rightPane.classList.remove('dragging-active');
        }
      });
    }

    const convertToDropdown = (link: HTMLAnchorElement) => {
      if (link.dataset.dropdownConverted) return;
      link.dataset.dropdownConverted = 'true';
      
      const href = link.getAttribute('href') || '';
      const { type, title } = getCleanUrlAndType(href, link.textContent || '');
      
      // Create wrapper
      const wrapper = document.createElement('div');
      wrapper.className = 'hero-btn-dropdown split-btn-group';
      
      // Create new main action button
      const mainBtn = document.createElement('button');
      mainBtn.className = 'hero-btn split-btn-main';
      mainBtn.setAttribute('type', 'button');
      
      // Copy original contents (SVG icon + text)
      mainBtn.innerHTML = link.innerHTML;
      
      // Create new toggle button for dropdown
      const toggleBtn = document.createElement('button');
      toggleBtn.className = 'split-btn-toggle';
      toggleBtn.setAttribute('type', 'button');
      toggleBtn.setAttribute('aria-label', 'Open options');
      toggleBtn.innerHTML = `
        <svg class="dropdown-arrow" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"/>
        </svg>
      `;
      
      // Create dropdown menu
      const menu = document.createElement('div');
      menu.className = 'hero-dropdown-menu';
      
      // Option 1: View in Split Screen
      const splitBtn = document.createElement('button');
      splitBtn.className = 'dropdown-item split-view-opt';
      splitBtn.setAttribute('type', 'button');
      splitBtn.innerHTML = `
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
          <line x1="12" y1="3" x2="12" y2="21"/>
        </svg>
        View in Split Screen
      `;
      
      // Option 2: Open in New Tab
      const tabLink = document.createElement('a');
      tabLink.className = 'dropdown-item new-tab-opt';
      tabLink.href = href;
      tabLink.target = '_blank';
      tabLink.rel = 'noopener';
      tabLink.innerHTML = `
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
          <polyline points="15 3 21 3 21 9"/>
          <line x1="10" y1="14" x2="21" y2="3"/>
        </svg>
        Open in New Tab
      `;
      
      menu.appendChild(splitBtn);
      menu.appendChild(tabLink);

      // Option 3: Share PDF (System Share, for NotebookLM migration, with clipboard copy fallback)
      let shareBtn: HTMLButtonElement | null = null;
      if (type === 'pdf') {
        shareBtn = document.createElement('button');
        shareBtn.className = 'dropdown-item share-opt';
        shareBtn.setAttribute('type', 'button');
        shareBtn.innerHTML = `
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14">
            <circle cx="18" cy="5" r="3"/>
            <circle cx="6" cy="12" r="3"/>
            <circle cx="18" cy="19" r="3"/>
            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
            <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
          </svg>
          Share PDF
        `;
        menu.appendChild(shareBtn);
      }
      
      wrapper.appendChild(mainBtn);
      wrapper.appendChild(toggleBtn);
      wrapper.appendChild(menu);
      
      // Replace original link with wrapper in the DOM
      link.parentNode?.replaceChild(wrapper, link);
      
      // Event listeners
      // Main button click: directly open split view
      mainBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        // Close dropdowns
        document.querySelectorAll('.hero-btn-dropdown.is-open').forEach(openDropdown => {
          openDropdown.classList.remove('is-open');
        });
        openSplitView(href, mainBtn.textContent?.trim() || '');
      });
      
      // Toggle button click: toggle the options dropdown menu
      toggleBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        // Close other open dropdowns first
        document.querySelectorAll('.hero-btn-dropdown.is-open').forEach(openDropdown => {
          if (openDropdown !== wrapper) {
            openDropdown.classList.remove('is-open');
          }
        });
        wrapper.classList.toggle('is-open');
      });
      
      splitBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        wrapper.classList.remove('is-open');
        openSplitView(href, mainBtn.textContent?.trim() || '');
      });
      
      tabLink.addEventListener('click', () => {
        wrapper.classList.remove('is-open');
      });

      if (shareBtn) {
        shareBtn.addEventListener('click', async (e) => {
          e.stopPropagation();
          
          const shareUrl = new URL(href, window.location.href).href;
          const shareTitle = title || 'Research Paper';
          const originalHTML = shareBtn.innerHTML;
          
          // Show downloading state
          shareBtn.disabled = true;
          shareBtn.innerHTML = `
            <svg class="hf-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14">
              <path d="M21 12a9 9 0 1 1-6.219-8.56"/>
            </svg>
            Downloading...
          `;

          const fallbackShareUrl = async () => {
            if (navigator.share) {
              try {
                await navigator.share({
                  title: shareTitle,
                  text: `Research paper PDF: ${shareTitle}`,
                  url: shareUrl
                });
              } catch (err) {
                if (err instanceof Error && err.name !== 'AbortError') {
                  console.error('Error sharing URL:', err);
                }
              }
            } else {
              // Fallback: Copy link to clipboard
              try {
                await navigator.clipboard.writeText(shareUrl);
                shareBtn.innerHTML = `
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                  Link Copied!
                `;
                // Keep dropdown open briefly so they see it, then restore and close
                setTimeout(() => {
                  if (shareBtn) {
                    shareBtn.innerHTML = originalHTML;
                    shareBtn.disabled = false;
                  }
                  wrapper.classList.remove('is-open');
                }, 2000);
                return; // Prevent immediate cleanup
              } catch (err) {
                console.error('Failed to copy link:', err);
              }
            }
            
            // For standard url share or failures, cleanup immediately
            if (shareBtn) {
              shareBtn.innerHTML = originalHTML;
              shareBtn.disabled = false;
            }
            wrapper.classList.remove('is-open');
          };

          let blob: Blob | null = null;
          let filename = shareUrl.split('/').pop() || 'paper.pdf';
          if (!filename.toLowerCase().endsWith('.pdf')) {
            filename += '.pdf';
          }

          const isLocal = new URL(shareUrl).origin === window.location.origin;

          try {
            // Attempt 1: Direct fetch
            const res = await fetch(shareUrl);
            if (!res.ok) throw new Error(`Direct fetch failed with status ${res.status}`);
            blob = await res.blob();
          } catch (err) {
            console.warn('Direct fetch failed, checking fallback...', err);
            
            if (!isLocal) {
              // Attempt 2: corsproxy.io
              try {
                const proxyUrl = `https://corsproxy.io/?url=${encodeURIComponent(shareUrl)}`;
                const res = await fetch(proxyUrl);
                if (res.ok) {
                  blob = await res.blob();
                } else {
                  throw new Error(`Proxy 1 failed with status ${res.status}`);
                }
              } catch (err2) {
                console.warn('Proxy 1 failed, checking next fallback...', err2);
                
                // Attempt 3: allorigins.win
                try {
                  const proxyUrl = `https://api.allorigins.win/raw?url=${encodeURIComponent(shareUrl)}`;
                  const res = await fetch(proxyUrl);
                  if (res.ok) {
                    blob = await res.blob();
                  } else {
                    throw new Error(`Proxy 2 failed with status ${res.status}`);
                  }
                } catch (err3) {
                  console.error('All fetch attempts failed:', err3);
                }
              }
            }
          }

          const isValidPdfBlob = blob && blob.size > 1000 && !blob.type.includes('text/html');
          let sharedSuccessfully = false;

          if (isValidPdfBlob) {
            try {
              const file = new File([blob], filename, { type: 'application/pdf' });
              
              if (navigator.canShare && navigator.canShare({ files: [file] })) {
                await navigator.share({
                  files: [file],
                  title: shareTitle,
                  text: `Research paper PDF: ${shareTitle}`
                });
                sharedSuccessfully = true;
              } else {
                console.warn('Browser does not support sharing this PDF file.');
              }
            } catch (err) {
              if (err instanceof Error && err.name === 'AbortError') {
                // User cancelled the share dialog
                sharedSuccessfully = true;
              } else {
                console.error('Failed to share PDF file:', err);
              }
            }
          }

          if (!sharedSuccessfully) {
            await fallbackShareUrl();
          } else {
            // Restore button state and close dropdown
            if (shareBtn) {
              shareBtn.innerHTML = originalHTML;
              shareBtn.disabled = false;
            }
            wrapper.classList.remove('is-open');
          }
        });
      }
    };

    // Bind event listeners to PDF & GitHub links
    const bindSplitViewLinks = () => {
      const links = document.querySelectorAll('a');
      links.forEach(link => {
        const href = link.getAttribute('href') || '';
        
        // Detect PDF
        const isPdf = href.toLowerCase().includes('.pdf') || 
                      href.toLowerCase().includes('arxiv.org/pdf') ||
                      href.toLowerCase().includes('arxiv.org/abs') ||
                      (link.classList.contains('hero-btn') && (
                        link.textContent.toLowerCase().includes('pdf') ||
                        link.textContent.toLowerCase().includes('paper')
                      ));
                      
        // Detect Github Repo (at least 2 path segments after github.com/)
        let isGithubRepo = false;
        if (href.includes('github.com/')) {
          const pathPart = href.split('github.com/')[1] || '';
          const parts = pathPart.split('/').filter(Boolean);
          const isNotRepo = ['settings', 'notifications', 'explore', 'trending', 'about', 'pricing', 'contact', 'features', 'security', 'enterprise'].includes(parts[0]);
          if (parts.length >= 2 && !isNotRepo) {
            isGithubRepo = true;
          }
        }
        
        if (isPdf || isGithubRepo) {
          if (window.innerWidth > 800) {
            convertToDropdown(link as HTMLAnchorElement);
          }
        }
      });
    };

    // Expose globally for dynamic client-side components
    (window as any).bindSplitViewLinks = bindSplitViewLinks;

    // Initial binding
    bindSplitViewLinks();

    // Close dropdowns when clicking outside
    document.addEventListener('click', () => {
      document.querySelectorAll('.hero-btn-dropdown.is-open').forEach(dropdown => {
        dropdown.classList.remove('is-open');
      });
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && document.body.classList.contains('split-view-active')) {
        closeSplitView();
      }
    });

    // Close button click
    const closeBtn = document.getElementById('split-view-close');
    if (closeBtn) {
      closeBtn.addEventListener('click', closeSplitView);
    }
  })();
</script>


---
import '../styles/global.css';
import TtsPlayer from '../components/TtsPlayer.astro';

interface Props {
  title: string;
  description?: string;
  crumb?: string;
}
const { title, description = 'Catpuccino.ai — interactive explorations of frontier models and research.', crumb } = Astro.props;
const subscribeUrl = import.meta.env.PUBLIC_SUBSCRIBE_URL ?? 'https://heji-study-subscribe.web.app';

// Generate static random stars at build time for the cosmos background
const stars = Array.from({ length: 80 }, (_, i) => ({
  id: i,
  x: Math.random() * 100,
  y: Math.random() * 100,
  size: Math.random() * 1.5 + 0.5, // 0.5px to 2.0px
  delay: Math.random() * 6,
  duration: Math.random() * 4 + 4,
  opacity: Math.random() * 0.6 + 0.4
}));
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Catpuccino.ai" />
  <meta name="color-scheme" content="dark light" />
  <meta name="theme-color" content="#09090f" />
  <script is:inline>
    (function(){try{var t=localStorage.getItem('heji-theme')||'dark';document.documentElement.dataset.theme=t;}catch(e){}})();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>

<div class="bg-animation-container" aria-hidden="true">
  <div class="bg-stars">
    {stars.map(star => (
      <div
        class="bg-star"
        style={{
          left: `${star.x}%`,
          top: `${star.y}%`,
          width: `${star.size}px`,
          height: `${star.size}px`,
          animationDelay: `${star.delay}s`,
          animationDuration: `${star.duration}s`,
          opacity: String(star.opacity)
        }}
      />
    ))}
  </div>
  <div class="bg-glow bg-glow-1"></div>
  <div class="bg-glow bg-glow-2"></div>
  <div class="bg-glow bg-glow-3"></div>
</div>

<nav class="site-nav">
  <a class="nav-brand" href="/" data-i18n="nav-brand">Catpuccino.ai</a>
  {crumb && <>
    <span class="nav-sep">/</span>
    <span class="nav-crumb">{crumb}</span>
  </>}
  <div class="nav-actions">
    <div id="auth-container" class="auth-container"></div>
    <a class="nav-link" href="/" data-i18n="nav-posts">Posts</a>
    <a class="nav-link" href="/about" data-i18n="nav-about">About</a>
    <a class="nav-link" id="nav-bookmarks-link" href="/bookmarks" style="display:none" data-i18n="nav-bookmarks">Bookmarks</a>
    <a class="nav-link" id="nav-rl-link" href="/reading-list" style="display:none" data-i18n="nav-reading-list">Reading List</a>
    <a class="nav-link" id="nav-collections-link" href="/collections" style="display:none" data-i18n="nav-collections">Collections</a>
    <a class="nav-link" id="nav-admin-link" href="#" target="_blank" rel="noopener noreferrer" style="display:none">Admin</a>
    <a class="nav-link nav-subscribe" href={subscribeUrl} target="_blank" rel="noopener noreferrer" data-i18n="nav-subscribe">Subscribe</a>

    <button class="nav-link nav-suggest" id="suggest-btn">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right:5px; opacity:0.85;">
        <path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A5 5 0 0 0 8 8c0 1 .3 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"></path>
        <line x1="9" y1="18" x2="15" y2="18"></line>
        <line x1="10" y1="22" x2="14" y2="22"></line>
      </svg>
      <span data-i18n="nav-suggest">Suggest Topic</span>
    </button>
    <button class="nav-link nav-feedback" id="feedback-btn">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right:5px; opacity:0.85;">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
      </svg>
      <span data-i18n="nav-feedback">Feedback</span>
    </button>
    <button class="btn-icon" id="theme-toggle" aria-label="Toggle theme">
      <svg id="icon-sun" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
      <svg id="icon-moon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
    </button>
    <button class="btn-icon" id="lang-toggle" aria-label="Toggle language">中</button>
    <button class="btn-icon nav-menu-btn" id="menu-toggle" aria-label="Open navigation" aria-expanded="false">
      <svg id="icon-menu" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      <svg id="icon-menu-close" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display:none"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>
</nav>

<div id="mobile-menu" class="mobile-menu" aria-hidden="true">
  <a class="mobile-menu-link" href="/" data-i18n="nav-posts">Posts</a>
  <a class="mobile-menu-link" href="/about" data-i18n="nav-about">About</a>
  <a class="mobile-menu-link" href="/bookmarks" id="mobile-bookmarks-link" style="display:none" data-i18n="nav-bookmarks">Bookmarks</a>
  <a class="mobile-menu-link" href="/reading-list" id="mobile-rl-link" style="display:none" data-i18n="nav-reading-list">Reading List</a>
  <a class="mobile-menu-link" href="/collections" id="mobile-collections-link" style="display:none" data-i18n="nav-collections">Collections</a>
  <a class="mobile-menu-link" href={subscribeUrl} target="_blank" rel="noopener noreferrer" data-i18n="nav-subscribe">Subscribe</a>
  <button class="mobile-menu-link mobile-menu-suggest" id="suggest-btn-mobile">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right:8px; opacity:0.8;">
      <path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A5 5 0 0 0 8 8c0 1 .3 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"></path>
      <line x1="9" y1="18" x2="15" y2="18"></line>
      <line x1="10" y1="22" x2="14" y2="22"></line>
    </svg>
    <span data-i18n="nav-suggest">Suggest Topic</span>
  </button>
  <button class="mobile-menu-link mobile-menu-feedback" id="feedback-btn-mobile">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right:8px; opacity:0.8;">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
    </svg>
    <span data-i18n="nav-feedback">Feedback</span>
  </button>
</div>

<script is:inline>
  // Hamburger menu — inline so it works even if Firebase/analytics fails to load
  (function() {
    var btn  = document.getElementById('menu-toggle');
    var menu = document.getElementById('mobile-menu');
    var iconOpen  = document.getElementById('icon-menu');
    var iconClose = document.getElementById('icon-menu-close');
    if (!btn || !menu) return;

    function openMenu() {
      menu.setAttribute('aria-hidden', 'false');
      menu.classList.add('is-open');
      btn.setAttribute('aria-expanded', 'true');
      if (iconOpen)  iconOpen.style.display  = 'none';
      if (iconClose) iconClose.style.display = '';
    }

    function closeMenu() {
      menu.setAttribute('aria-hidden', 'true');
      menu.classList.remove('is-open');
      btn.setAttribute('aria-expanded', 'false');
      if (iconOpen)  iconOpen.style.display  = '';
      if (iconClose) iconClose.style.display = 'none';
    }

    btn.addEventListener('click', function() {
      menu.classList.contains('is-open') ? closeMenu() : openMenu();
    });

    // Close when any menu link/button is clicked
    menu.querySelectorAll('.mobile-menu-link').forEach(function(link) {
      link.addEventListener('click', closeMenu);
    });

    // Close when clicking outside the nav / menu
    document.addEventListener('click', function(e) {
      if (menu.classList.contains('is-open') &&
          !menu.contains(e.target) &&
          !btn.contains(e.target)) {
        closeMenu();
      }
    });
  })();
</script>

<div id="read-progress"></div>

<div id="suggest-modal" class="modal-backdrop" aria-hidden="true" role="presentation">
  <div class="modal-box" role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <div class="modal-header">
      <h2 id="modal-title" data-i18n="modal-title">Suggest a Topic</h2>
      <button class="btn-icon modal-close" id="suggest-close" aria-label="Close">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <p class="modal-desc" data-i18n="modal-desc">Have an AI/ML paper or topic you'd like to see covered? Drop it here.</p>
    <form id="suggest-form" novalidate>
      <div class="form-group">
        <label for="suggest-topic" data-i18n="modal-label-topic">Topic or paper</label>
        <input type="text" id="suggest-topic" name="topic" required autocomplete="off"
          placeholder="e.g. Flash Attention 3, Mamba SSM, ..." />
      </div>
      <div class="form-group">
        <label for="suggest-email" data-i18n="modal-label-email">Your email <span class="optional" data-i18n="modal-optional">(optional)</span></label>
        <input type="email" id="suggest-email" name="email" placeholder="you@example.com" />
      </div>
      <button type="submit" class="btn btn-primary btn-full" id="suggest-submit">
        <span data-i18n="modal-submit">Submit suggestion</span>
      </button>
    </form>
    <p id="suggest-success" class="suggest-feedback suggest-success" style="display:none" data-i18n="modal-success">
      Thanks! Your suggestion has been received.
    </p>
    <p id="suggest-error" class="suggest-feedback suggest-error" style="display:none"></p>
  </div>
</div>

<div id="feedback-modal" class="modal-backdrop" aria-hidden="true" role="presentation">
  <div class="modal-box" role="dialog" aria-modal="true" aria-labelledby="feedback-modal-title">
    <div class="modal-header">
      <h2 id="feedback-modal-title" data-i18n="feedback-modal-title">Submit Feedback</h2>
      <button class="btn-icon modal-close" id="feedback-close" aria-label="Close">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <p class="modal-desc" data-i18n="feedback-modal-desc">Help us improve the site. Let us know about any bugs, feature requests, or suggestions.</p>
    <form id="feedback-form" novalidate>
      <div class="form-group feedback-rating-container">
        <label id="feedback-rating-label" data-i18n="feedback-label-rating">How would you rate your experience?</label>
        <div class="feedback-stars" id="feedback-stars">
          <button type="button" class="star-btn" data-value="1" aria-label="1 star">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          </button>
          <button type="button" class="star-btn" data-value="2" aria-label="2 stars">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          </button>
          <button type="button" class="star-btn" data-value="3" aria-label="3 stars">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          </button>
          <button type="button" class="star-btn" data-value="4" aria-label="4 stars">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          </button>
          <button type="button" class="star-btn" data-value="5" aria-label="5 stars">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          </button>
        </div>
        <input type="hidden" name="rating" id="feedback-rating-value" value="" />
      </div>
      <div class="form-group">
        <label for="feedback-message" data-i18n="feedback-label-message">Your feedback</label>
        <textarea id="feedback-message" name="message" required placeholder="What can we improve? Feedback, bugs, feature requests..." rows="4"></textarea>
      </div>
      <div class="form-group">
        <label for="feedback-email" data-i18n="feedback-label-email">Your email <span class="optional" data-i18n="modal-optional">(optional)</span></label>
        <input type="email" id="feedback-email" name="email" placeholder="you@example.com" />
      </div>
      <button type="submit" class="btn btn-primary btn-full" id="feedback-submit">
        <span data-i18n="feedback-submit">Submit feedback</span>
      </button>
    </form>
    <p id="feedback-success" class="suggest-feedback suggest-success" style="display:none" data-i18n="feedback-success">
      Thank you! Your feedback has been saved.
    </p>
    <p id="feedback-error" class="suggest-feedback suggest-error" style="display:none"></p>
  </div>
</div>

<div id="collection-modal" class="modal-backdrop" aria-hidden="true" role="presentation">
  <div class="modal-box" role="dialog" aria-modal="true" aria-labelledby="collection-modal-title">
    <div class="modal-header">
      <h2 id="collection-modal-title" data-i18n="collection-modal-title">Add to Collection</h2>
      <button class="btn-icon modal-close" id="collection-close" aria-label="Close">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <p class="modal-desc collection-modal-post" id="collection-modal-post"></p>
    <div class="collection-picker-list" id="collection-picker-list">
      <div class="collection-picker-loading">Loading…</div>
    </div>
    <form id="collection-create-form" class="collection-create-form" novalidate>
      <input type="text" id="collection-new-name" name="name" autocomplete="off" maxlength="80"
        placeholder="New collection name…" aria-label="New collection name" />
      <button type="submit" class="btn btn-primary" id="collection-create-submit" data-i18n="collection-create-btn">
        Create &amp; add
      </button>
    </form>
    <p id="collection-error" class="suggest-feedback suggest-error" style="display:none"></p>
  </div>
</div>

<div id="subscribe-prompt-modal" class="modal-backdrop" aria-hidden="true" role="presentation">
  <div class="modal-box" role="dialog" aria-modal="true" aria-labelledby="subscribe-prompt-title">
    <div class="modal-header">
      <div class="premium-badge" data-i18n="prompt-badge">⚡ Personalized Experience</div>
      <button class="btn-icon modal-close" id="subscribe-prompt-close" aria-label="Close">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    
    <h2 id="subscribe-prompt-title" class="modal-title-custom" data-i18n="prompt-title">Unlock the Full Experience</h2>
    <p class="modal-desc-custom" data-i18n="prompt-desc">
      Subscribe to get the latest updates on AI/ML frontier research, and sign in to access personalized features:
    </p>
    
    <div class="features-list">
      <div class="feature-item">
        <svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
        </svg>
        <span data-i18n="prompt-feature-bookmarks">Save posts to bookmarks</span>
      </div>
      <div class="feature-item">
        <svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <circle cx="12" cy="12" r="10"/>
          <polyline points="12 6 12 12 16 14"/>
        </svg>
        <span data-i18n="prompt-feature-readinglist">Track your Reading List progress</span>
      </div>
      <div class="feature-item">
        <svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
        <span data-i18n="prompt-feature-upvotes">Upvote posts and suggest future topics</span>
      </div>
    </div>

    <!-- Subscription Form -->
    <form id="subscribe-prompt-form" class="subscribe-prompt-form" novalidate>
      <div class="form-group">
        <input type="email" id="subscribe-prompt-email" required placeholder="Enter your email to subscribe" aria-label="Email Address" />
        <button type="submit" class="btn btn-primary" id="subscribe-prompt-submit-btn" data-i18n="prompt-subscribe-btn">
          Subscribe
        </button>
      </div>
      <p id="subscribe-prompt-success" class="prompt-feedback success-text" style="display:none" data-i18n="prompt-success">
        Thanks! You have subscribed to updates.
      </p>
      <p id="subscribe-prompt-error" class="prompt-feedback error-text" style="display:none" data-i18n="prompt-error"></p>
    </form>

    <div class="prompt-divider">
      <span data-i18n="prompt-divider-text">And</span>
    </div>

    <!-- Sign In Option -->
    <button class="btn-signin-prompt" id="subscribe-prompt-signin-btn">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/>
        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"/>
      </svg>
      <span data-i18n="prompt-signin-btn">Sign In with Google</span>
    </button>
  </div>
</div>

<div class="split-view-container" id="split-view-container">
  <div class="split-view-left" id="split-view-left">
    <slot />
  </div>
  <div class="split-view-divider" id="split-view-divider"></div>
  <div class="split-view-right" id="split-view-right">
    <div class="split-view-header">
      <span class="split-view-title" id="split-view-title">Research Paper</span>
      <div class="split-view-actions">
        <a id="split-view-external" class="split-view-action-btn" target="_blank" rel="noopener" title="Open in New Tab">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="12" height="12"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        </a>
        <button id="split-view-close" class="split-view-action-btn" aria-label="Close Split View" title="Close Split View">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
    </div>
    <div class="split-view-body" id="split-view-body"></div>
  </div>
</div>

<script is:inline>
  (function() {
    try {
      var postGrid = document.getElementById('post-grid');
      var tocSidebar = document.getElementById('toc-sidebar');
      var tocToggle = document.getElementById('toc-toggle');
      var codeSidebar = document.getElementById('code-sidebar');
      var csToggle = document.getElementById('cs-toggle');

      if (postGrid) {
        // Restore TOC state
        var isTocCollapsed = localStorage.getItem('toc-sidebar-collapsed') === 'true';
        if (tocSidebar) {
          tocSidebar.classList.toggle('collapsed', isTocCollapsed);
          postGrid.classList.toggle('toc-collapsed', isTocCollapsed);
          if (tocToggle) {
            tocToggle.textContent = isTocCollapsed ? '›' : '‹';
          }
        }

        // Restore Code sidebar state
        var isCodeCollapsed = localStorage.getItem('code-sidebar-collapsed') === 'true';
        if (codeSidebar) {
          codeSidebar.classList.toggle('collapsed', isCodeCollapsed);
          postGrid.classList.toggle('sidebar-collapsed', isCodeCollapsed);
          if (csToggle) {
            csToggle.textContent = isCodeCollapsed ? '‹' : '›';
          }
        }
      }

      // Add event listeners to save preference on click
      document.addEventListener('click', function(e) {
        var target = e.target;
        if (!target) return;
        
        var tocToggleBtn = target.closest('#toc-toggle');
        var csToggleBtn = target.closest('#cs-toggle');

        if (tocToggleBtn) {
          setTimeout(function() {
            var isCollapsed = document.getElementById('toc-sidebar')?.classList.contains('collapsed');
            localStorage.setItem('toc-sidebar-collapsed', isCollapsed ? 'true' : 'false');
          }, 0);
        } else if (csToggleBtn) {
          setTimeout(function() {
            var isCollapsed = document.getElementById('code-sidebar')?.classList.contains('collapsed');
            localStorage.setItem('code-sidebar-collapsed', isCollapsed ? 'true' : 'false');
          }, 0);
        }
      });
    } catch(e) {}
  })();
</script>

